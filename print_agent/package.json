{
  "name": "saqr-print-agent",
  "version": "1.2.3",
  "private": true,
  "description": "Local ESC/POS print bridge for Saqr POS (network & USB printers)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "install-service": "node install-service.js",
    "uninstall-service": "node uninstall-service.js",
    "build": "pkg index.js --target node18-win-x64 --output dist/SaqrPrintAgent.exe --compress GZip",
    "installer": "npm run build && iscc installer/SaqrPrintAgent.iss"
  },
  "pkg": {
    "assets": [],
    "targets": [
      "node18-win-x64"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
