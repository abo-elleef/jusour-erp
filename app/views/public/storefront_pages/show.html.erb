<% title = @page.display_title %>
<% content_for :title, "#{title} — #{@company.name}" %>
<% content_for :canonical_url, storefront_page_url(@page) %>
<% body = @page.display_body %>
<% content_for :meta_description, body.to_plain_text.squish.truncate(160) %>

<div class="max-w-3xl mx-auto px-4 py-10">
  <nav class="mb-4 text-sm text-stone-500" aria-label="<%= t("public.storefront.breadcrumb") %>">
    <%= link_to t("public.storefront.home"), storefront_home_path, class: "hover:text-(--sf-primary)" %>
  </nav>
  <h1 class="text-3xl font-semibold text-stone-900"><%= title %></h1>

  <%# Rich text is rendered through Action Text, which sanitizes it. The body's
      own language decides its direction, independent of the page chrome. %>
  <div class="storefront-prose mt-6" dir="auto"><%= body %></div>

  <% if @page.slot == "contact" && @storefront.contact_present? %>
    <div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 space-y-1.5 text-sm text-stone-600">
      <% if @storefront.address.present? %><p><%= @storefront.address %></p><% end %>
      <% if @storefront.phone_url %><p><%= link_to @storefront.phone, @storefront.phone_url, dir: "ltr", class: "hover:text-(--sf-primary) tabular-nums" %></p><% end %>
      <% if @storefront.email.present? %><p><%= mail_to @storefront.email, class: "hover:text-(--sf-primary)" %></p><% end %>
      <div class="flex flex-wrap gap-3 pt-3">
        <% if @storefront.whatsapp_url %>
          <%= link_to @storefront.whatsapp_url, target: "_blank", rel: "noopener",
                class: "inline-flex items-center gap-2 whitespace-nowrap rounded-full bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#1EBE5A]" do %>
            <%= render "public/storefronts/whatsapp_icon", css: "h-4 w-4" %>
            <%= t("public.storefront.chat_on_whatsapp") %>
          <% end %>
        <% end %>
        <% if @storefront.map_url.present? %>
          <%= link_to t("public.storefront.open_map"), @storefront.map_url, target: "_blank", rel: "noopener",
                class: "inline-flex items-center whitespace-nowrap rounded-full border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-800 hover:border-(--sf-primary) hover:text-(--sf-primary)" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
