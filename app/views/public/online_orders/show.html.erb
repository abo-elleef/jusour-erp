<% content_for :title, "#{t("public.online_order.status_title")} — #{@company.name}" %>
<%# The customer keeps this page open; it reloads itself until the branch decides. %>
<div class="min-h-screen bg-stone-50"
     <% if @request.pending? && !@request.overdue? %>data-controller="auto-refresh" data-auto-refresh-interval-value="8000"<% end %>>
  <div class="max-w-lg mx-auto px-4 py-8 space-y-5">
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.08em] text-amber-800/90"><%= @company.name %></p>
      <h1 class="text-2xl text-stone-900"><%= @location.name %></h1>
    </div>

    <% status = @request.overdue? ? "expired" : @request.status %>
    <%# Saves this order in the browser so the branch menu can link back to it. %>
    <div hidden data-controller="recent-orders"
         data-recent-orders-mode-value="remember"
         data-recent-orders-storage-key-value="<%= recent_orders_storage_key(@company, @location) %>"
         data-recent-orders-order-value="<%= { token: @request.token,
                                                url: public_online_order_path(company_slug: @company.slug, token: @request.token),
                                                placedAt: @request.created_at.iso8601,
                                                total: format_money(@request.total_cents),
                                                status: status }.to_json %>"></div>
    <section class="rounded-2xl border p-5 <%= { "pending" => "border-amber-200 bg-amber-50", "accepted" => "border-emerald-200 bg-emerald-50", "rejected" => "border-rose-200 bg-rose-50", "expired" => "border-stone-300 bg-white" }[status] %>"
             id="online-order-status" data-status="<%= status %>">
      <% case status %>
      <% when "pending" %>
        <p class="flex items-center gap-2 text-base font-semibold text-amber-900">
          <span class="inline-block h-2.5 w-2.5 animate-pulse rounded-full bg-amber-600" aria-hidden="true"></span>
          <%= t("public.online_order.status.pending") %>
        </p>
        <p class="mt-1 text-sm text-amber-900/80"><%= t("public.online_order.status.pending_hint") %></p>
      <% when "accepted" %>
        <p class="text-lg font-semibold text-emerald-900"><%= t("public.online_order.status.accepted", number: @request.order&.order_number) %></p>
        <p class="mt-1 text-sm text-emerald-900/80">
          <%= t(@request.delivery? ? "public.online_order.status.accepted_hint_delivery" : "public.online_order.status.accepted_hint_pickup") %>
        </p>
      <% when "rejected" %>
        <p class="text-base font-semibold text-rose-900"><%= t("public.online_order.status.rejected") %></p>
        <% if @request.reject_reason.present? %>
          <p class="mt-1 text-sm text-rose-900/80"><%= t("public.online_order.reject_reasons.#{@request.reject_reason}", default: "") %></p>
        <% end %>
      <% else %>
        <p class="text-base font-semibold text-stone-900"><%= t("public.online_order.status.expired") %></p>
        <p class="mt-1 text-sm text-stone-600"><%= t("public.online_order.status.expired_hint") %></p>
      <% end %>

      <% if %w[rejected expired].include?(status) && (@location.phone.present? || @location.whatsapp_url) %>
        <div class="mt-4 flex gap-2">
          <% if @location.phone.present? %>
            <%= link_to @location.phone, @location.phone_url, dir: "ltr", class: "flex-1 rounded-full border border-stone-300 bg-white px-4 py-2.5 text-center text-sm font-medium" %>
          <% end %>
          <% if @location.whatsapp_url %>
            <%= link_to "WhatsApp", @location.whatsapp_url, target: "_blank", rel: "noopener", class: "flex-1 rounded-full border border-[#B7DFC5] bg-[#E7F5EC] px-4 py-2.5 text-center text-sm font-medium text-[#146B3A]" %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="rounded-2xl border border-stone-200 bg-white p-5">
      <ul class="divide-y divide-stone-100">
        <% @request.lines.each do |line| %>
          <li class="flex justify-between gap-3 py-2.5 text-sm">
            <div>
              <p class="font-medium text-stone-900"><%= line["quantity"] %> × <%= line["name"] %></p>
              <% extra = [Array(line["modifiers"]).map { |m| m["name"] }.join("، ").presence, line["notes"]].compact %>
              <% if extra.any? %><p class="text-xs text-stone-500"><%= extra.join(" — ") %></p><% end %>
            </div>
            <span class="tabular-nums text-stone-900"><%= format_money(line["line_total_cents"].to_i - line["discount_cents"].to_i) %></span>
          </li>
        <% end %>
      </ul>
      <dl class="mt-3 space-y-1 border-t border-stone-200 pt-3 text-sm">
        <% if @request.delivery? %>
          <div class="flex justify-between"><dt class="text-stone-600"><%= t("public.online_order.delivery_fee") %> (<%= @request.delivery_area&.display_name %>)</dt><dd class="tabular-nums"><%= format_money(@request.delivery_fee_cents) %></dd></div>
        <% end %>
        <div class="flex justify-between text-base font-semibold"><dt><%= t("public.online_order.total") %></dt><dd class="tabular-nums"><%= format_money(@request.total_cents) %></dd></div>
        <% unless @request.payment_method == "cash" %>
          <div class="flex justify-between"><dt class="text-stone-600"><%= t("public.online_order.payment.title") %></dt><dd><%= t("payment.methods.#{@request.payment_method}") %> · <%= t(@request.prepaid? ? "public.online_order.payment.paid_now" : "public.online_order.payment.on_receipt") %></dd></div>
        <% end %>
      </dl>
      <% if @request.payment_method == "cash" %>
        <p class="mt-2 text-xs text-stone-500"><%= t("public.online_order.cash_note") %></p>
      <% end %>
      <%# The screenshot the customer sent, so they can see what the restaurant is checking. %>
      <% if @request.payment_proof_image.attached? %>
        <div class="mt-3 border-t border-stone-200 pt-3" data-testid="online-order-payment-proof">
          <p class="mb-2 text-sm text-stone-600"><%= t("public.online_order.payment.proof_label") %></p>
          <%= link_to rails_blob_path(@request.payment_proof_image), target: "_blank", rel: "noopener", class: "block" do %>
            <%= image_tag rails_blob_path(@request.payment_proof_image), alt: t("public.online_order.payment.proof_label"),
                  class: "max-h-64 w-full rounded-lg border border-stone-200 bg-stone-50 object-contain" %>
          <% end %>
        </div>
      <% end %>
    </section>

    <%= link_to t("public.online_order.order_again"), public_menu_path(company_slug: @company.slug, location_slug: @location.slug),
          class: "block text-center text-sm font-medium text-amber-800 hover:underline" %>
  </div>
</div>
