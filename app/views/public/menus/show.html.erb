<% content_for :title, "#{@location.name} — #{@company.name}" %>
<% content_for :meta_description, t("public.menu.meta_description", company: @company.name) %>

<div data-controller="public-menu" class="min-h-screen flex flex-col">
  <header class="border-b border-stone-200/80 bg-white">
    <div class="max-w-3xl mx-auto px-4 pt-5 pb-4">
      <div class="space-y-1">
        <p class="text-xs font-medium uppercase tracking-[0.08em] text-amber-800/90"><%= @company.name %></p>
        <h1 class="text-[1.75rem] leading-tight font-normal text-stone-900"><%= @location.name %></h1>
        <% if @location.address.present? %>
          <p class="text-sm leading-relaxed text-stone-600 pt-1"><%= @location.address %></p>
        <% end %>
      </div>

      <% if @location.phone.present? || @location.whatsapp_url %>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <% if @location.phone.present? %>
            <%= link_to @location.phone_url,
                  class: "inline-flex min-h-[3.25rem] flex-1 items-center justify-center gap-3 rounded-full border border-stone-300 bg-white px-6 py-3.5 text-sm font-medium leading-snug text-stone-900 transition-colors hover:bg-stone-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700/30",
                  dir: "ltr",
                  aria: { label: t("public.menu.call", number: @location.phone) } do %>
              <svg class="h-[1.125rem] w-[1.125rem] shrink-0 text-amber-800" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.07 21 3 13.93 3 5a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
              </svg>
              <span class="tabular-nums tracking-wide"><%= @location.phone %></span>
            <% end %>
          <% end %>
          <% if @location.whatsapp_url %>
            <%= link_to @location.whatsapp_url, target: "_blank", rel: "noopener",
                  class: "inline-flex min-h-[3.25rem] flex-1 items-center justify-center gap-3 rounded-full border border-[#B7DFC5] bg-[#E7F5EC] px-6 py-3.5 text-sm font-medium leading-snug text-[#146B3A] transition-colors hover:bg-[#D4EEDB] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#146B3A]/20",
                  dir: "ltr",
                  aria: { label: t("public.menu.whatsapp", number: @location.whatsapp_number) } do %>
              <svg class="h-[1.125rem] w-[1.125rem] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span class="tabular-nums tracking-wide"><%= @location.whatsapp_number %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%= render "public/menus/branch_switcher", branches: @branches, current_location: @location, company: @company %>
    </div>
  </header>

  <% if @categories.any? || @combos.any? %>
    <nav class="sticky top-0 z-10 border-b border-stone-200/80 bg-white/95 shadow-sm backdrop-blur-sm"
         aria-label="<%= t("public.menu.category_filters") %>">
      <div class="max-w-3xl mx-auto flex gap-2 overflow-x-auto px-4 py-3">
        <button type="button"
                class="public-menu-category-btn h-8 shrink-0 rounded-lg border px-3 text-sm font-medium transition-colors"
                data-action="public-menu#filterCategory"
                data-category="all">
          <%= t("actions.all") %>
        </button>
        <% @categories.each do |category| %>
          <button type="button"
                  class="public-menu-category-btn h-8 shrink-0 rounded-lg border px-3 text-sm font-medium transition-colors"
                  data-action="public-menu#filterCategory"
                  data-category="<%= category.id %>">
            <%= category.name %>
          </button>
        <% end %>
        <% if @combos.any? %>
          <button type="button"
                  class="public-menu-category-btn h-8 shrink-0 rounded-lg border px-3 text-sm font-medium transition-colors"
                  data-action="public-menu#filterCategory"
                  data-category="combos">
            <%= t("pos.categories.combos") %>
          </button>
        <% end %>
      </div>
    </nav>
  <% end %>

  <main class="flex-1 max-w-3xl mx-auto w-full px-4 py-6">
    <% if @menu_items.empty? && @combos.empty? %>
      <p class="text-center text-gray-500 py-20 text-sm"><%= t("public.menu.empty", branch: @location.name) %></p>
    <% else %>
      <div class="space-y-4" id="public-menu-grid">
        <% @menu_items.each do |item| %>
          <article class="public-menu-card rounded-2xl border border-stone-200 bg-white overflow-hidden shadow-sm"
                   data-category="<%= item.category_id %>">
            <div class="flex gap-4 p-4">
              <% if item.image.attached? %>
                <%= menu_item_image_tag item, variant: :public_menu, class: "w-24 h-24 sm:w-28 sm:h-28 object-cover rounded-xl shrink-0" %>
              <% else %>
                <div class="w-24 h-24 sm:w-28 sm:h-28 bg-stone-100 rounded-xl shrink-0 flex items-center justify-center text-stone-400 text-xs font-medium px-2 text-center">
                  <%= item.category.name %>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <h2 class="font-semibold text-gray-900 leading-tight"><%= item.name %></h2>
                <% if item.description.present? %>
                  <p class="text-sm text-gray-500 mt-1 line-clamp-3"><%= item.description %></p>
                <% end %>
                <% if item.modifier_groups.any? %>
                  <div class="mt-2 space-y-1">
                    <% item.modifier_groups.each do |group| %>
                      <p class="text-xs text-gray-400">
                        <span class="font-medium text-gray-500"><%= group.name %>:</span>
                        <%= group.modifiers.map(&:name).join(", ") %>
                      </p>
                    <% end %>
                  </div>
                <% end %>
                <p class="text-amber-700 font-bold mt-2 tabular-nums"><%= format_money(item.price_cents_at(@location)) %></p>
              </div>
            </div>
          </article>
        <% end %>

        <% @combos.each do |combo| %>
          <article class="public-menu-card rounded-2xl border border-amber-200 bg-amber-50/40 overflow-hidden shadow-sm"
                   data-category="combos">
            <div class="flex gap-4 p-4">
              <div class="w-24 h-24 sm:w-28 sm:h-28 bg-amber-100 rounded-xl shrink-0 flex items-center justify-center text-amber-800 font-bold text-xs tracking-wide uppercase px-2 text-center">
                <%= t("actions.combo") %>
              </div>
              <div class="flex-1 min-w-0">
                <h2 class="font-semibold text-gray-900 leading-tight"><%= combo.name %></h2>
                <% if combo.description.present? %>
                  <p class="text-sm text-gray-500 mt-1"><%= combo.description %></p>
                <% end %>
                <p class="text-amber-700 font-bold mt-2 tabular-nums"><%= format_money(combo.price_cents) %></p>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </main>

  <footer class="border-t border-stone-200 bg-white py-4 text-center text-xs text-gray-400">
    <%= t("public.menu.footer", company: @company.name) %>
  </footer>

  <%= render "public/menus/branch_drawer", branches: @branches, current_location: @location, company: @company %>
</div>
