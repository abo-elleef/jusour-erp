<%# locals: item, location, promo:, category: %>
<article class="public-menu-card rounded-2xl border <%= promo ? 'border-rose-300 bg-rose-50/30' : 'border-stone-200 bg-white' %> overflow-hidden shadow-sm"
         data-category="<%= category %>">
  <div class="flex gap-4 p-4">
    <% if item.image.attached? %>
      <%= menu_item_image_tag item, variant: :public_menu, class: "w-24 h-24 sm:w-28 sm:h-28 object-cover rounded-xl shrink-0" %>
    <% else %>
      <div class="w-24 h-24 sm:w-28 sm:h-28 bg-stone-100 rounded-xl shrink-0 flex items-center justify-center text-stone-400 text-xs font-medium px-2 text-center">
        <%= item.category.name %>
      </div>
    <% end %>
    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-2">
        <h2 class="font-semibold text-gray-900 leading-tight"><%= item.name %></h2>
        <% if promo %>
          <span class="shrink-0 rounded-full bg-rose-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">
            <%= promo.label.presence || t("promos.badge") %>
          </span>
        <% end %>
      </div>
      <% if item.description.present? %>
        <p class="text-sm text-gray-500 mt-1 line-clamp-3"><%= item.description %></p>
      <% end %>
      <% if item.modifier_groups.any? %>
        <div class="mt-2 space-y-1">
          <% item.modifier_groups.each do |group| %>
            <p class="text-xs text-gray-400">
              <span class="font-medium text-gray-500"><%= group.name %>:</span>
              <%= group.modifiers.map(&:name).join(", ") %>
            </p>
          <% end %>
        </div>
      <% end %>
      <% if promo %>
        <p class="mt-2 flex items-baseline gap-2 tabular-nums">
          <span class="text-sm text-stone-400 line-through"><%= format_money(promo.list_price_cents) %></span>
          <span class="text-rose-700 font-bold"><%= format_money(promo.promo_price_cents) %></span>
          <% if promo.modifier_name.present? %><span class="text-[11px] font-semibold text-rose-700"><%= t("promos.only_choice", choice: promo.modifier_name) %></span><% end %>
        </p>
      <% else %>
        <p class="text-amber-700 font-bold mt-2 tabular-nums"><%= format_money(item.price_cents_at(location)) %></p>
      <% end %>
    </div>
  </div>
</article>
