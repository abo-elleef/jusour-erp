<%# Self-ordering UI for the public menu: item popup, cart bar, checkout sheet.
    Driven by online_order_controller.js; prices shown in the sheet come from the
    server's quote, never from the browser. %>

<%# Item popup %>
<dialog data-online-order-target="itemDialog"
        class="w-full max-w-lg rounded-t-2xl sm:rounded-2xl p-0 m-0 mt-auto sm:m-auto backdrop:bg-black/40">
  <form method="dialog" class="flex max-h-[85vh] flex-col" data-action="submit->online-order#addToCart">
    <div class="flex items-start justify-between gap-3 border-b border-stone-200 px-5 py-4">
      <div>
        <h2 class="text-lg font-semibold text-stone-900" data-online-order-target="itemName"></h2>
        <p class="text-sm font-semibold text-amber-700 tabular-nums" data-online-order-target="itemPrice"></p>
      </div>
      <button type="button" class="text-2xl leading-none text-stone-400 hover:text-stone-700" data-action="online-order#closeItem" aria-label="<%= t("actions.close", default: "Close") %>">&times;</button>
    </div>
    <div class="flex-1 space-y-5 overflow-y-auto px-5 py-4" data-online-order-target="itemGroups"></div>
    <div class="space-y-3 border-t border-stone-200 px-5 py-4">
      <input type="text" maxlength="200" data-online-order-target="itemNote"
             placeholder="<%= t("public.online_order.item_note") %>"
             class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-amber-600 focus:ring-amber-600/20">
      <p class="hidden text-sm text-rose-700" data-online-order-target="itemError" role="alert"></p>
      <div class="flex items-center gap-3">
        <div class="flex items-center rounded-full border border-stone-300" aria-label="<%= t("public.online_order.quantity") %>">
          <button type="button" class="h-11 w-11 text-xl text-stone-700" data-action="online-order#decrement">−</button>
          <span class="w-8 text-center font-semibold tabular-nums" data-online-order-target="itemQuantity">1</span>
          <button type="button" class="h-11 w-11 text-xl text-stone-700" data-action="online-order#increment">+</button>
        </div>
        <button type="submit" class="h-11 flex-1 rounded-full bg-amber-700 px-5 text-sm font-semibold text-white hover:bg-amber-800">
          <%= t("public.online_order.add_to_cart") %>
        </button>
      </div>
    </div>
  </form>
</dialog>

<%# Sticky cart bar %>
<div class="fixed inset-x-0 bottom-0 z-20 hidden border-t border-stone-200 bg-white/95 px-4 py-3 shadow-lg backdrop-blur-sm"
     data-online-order-target="cartBar">
  <button type="button" data-action="online-order#openCheckout"
          class="mx-auto flex h-12 w-full max-w-3xl items-center justify-between rounded-full bg-amber-700 px-5 text-sm font-semibold text-white hover:bg-amber-800">
    <span><%= t("public.online_order.view_cart") %></span>
    <span class="rounded-full bg-white/20 px-2.5 py-0.5 tabular-nums" data-online-order-target="cartCount"></span>
  </button>
</div>

<%# Checkout sheet %>
<dialog data-online-order-target="checkoutDialog"
        class="w-full max-w-lg rounded-t-2xl sm:rounded-2xl p-0 m-0 mt-auto sm:m-auto backdrop:bg-black/40">
  <form class="flex max-h-[92vh] flex-col" data-action="submit->online-order#send" data-online-order-target="checkoutForm" novalidate>
    <div class="flex items-center justify-between border-b border-stone-200 px-5 py-4">
      <h2 class="text-lg font-semibold text-stone-900"><%= t("public.online_order.your_order") %></h2>
      <button type="button" class="text-2xl leading-none text-stone-400 hover:text-stone-700" data-action="online-order#closeCheckout" aria-label="<%= t("actions.close", default: "Close") %>">&times;</button>
    </div>

    <div class="flex-1 space-y-5 overflow-y-auto px-5 py-4">
      <ul class="divide-y divide-stone-100" data-online-order-target="lines"
          data-empty-text="<%= t("public.online_order.empty_cart") %>"
          data-remove-text="<%= t("public.online_order.remove") %>"></ul>

      <fieldset class="grid grid-cols-2 gap-2">
        <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-stone-300 px-3 py-3 text-sm font-medium has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50">
          <input type="radio" name="fulfillment" value="pickup" checked class="sr-only" data-action="online-order#fulfillmentChanged">
          <%= t("public.online_order.pickup") %>
        </label>
        <label class="flex items-center justify-center gap-2 rounded-xl border border-stone-300 px-3 py-3 text-sm font-medium has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50 <%= @delivery_areas.any? ? "cursor-pointer" : "opacity-50" %>">
          <input type="radio" name="fulfillment" value="delivery" class="sr-only" data-action="online-order#fulfillmentChanged" <%= "disabled" if @delivery_areas.none? %>>
          <%= t("public.online_order.delivery") %>
        </label>
      </fieldset>
      <% if @delivery_areas.none? %>
        <p class="-mt-3 text-xs text-stone-500"><%= t("public.online_order.no_areas") %></p>
      <% end %>

      <div class="space-y-3">
        <input type="text" name="customer_name" maxlength="80" autocomplete="name" required
               placeholder="<%= t("public.online_order.name") %>"
               class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm">
        <div>
          <input type="tel" name="phone" inputmode="tel" autocomplete="tel" dir="ltr" required
                 placeholder="<%= t("public.online_order.phone") %>"
                 class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm text-start">
          <p class="mt-1 text-xs text-stone-500"><%= t("public.online_order.phone_hint") %></p>
        </div>
        <div class="hidden space-y-3" data-online-order-target="deliveryFields">
          <select name="delivery_area_id" data-action="change->online-order#areaChanged input->online-order#areaChanged"
                  class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm">
            <option value=""><%= t("public.online_order.choose_area") %></option>
            <% @delivery_areas.each do |area| %>
              <option value="<%= area.id %>" data-fee="<%= format_money(area.fee_cents) %>"><%= area.display_name %> — <%= format_money(area.fee_cents) %></option>
            <% end %>
          </select>
          <textarea name="address" rows="2" maxlength="500" autocomplete="street-address"
                    placeholder="<%= t("public.online_order.address") %>"
                    class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm"></textarea>
        </div>
        <textarea name="note" rows="2" maxlength="500" placeholder="<%= t("public.online_order.note") %>"
                  class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm"></textarea>
        <%# Honeypot: hidden from people, filled in by bots. %>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        </div>
      </div>

      <dl class="space-y-1.5 rounded-xl bg-stone-50 px-4 py-3 text-sm">
        <div class="flex justify-between"><dt class="text-stone-600"><%= t("public.online_order.subtotal") %></dt><dd class="tabular-nums" data-online-order-target="subtotal">—</dd></div>
        <div class="hidden justify-between" data-online-order-target="feeRow"><dt class="text-stone-600"><%= t("public.online_order.delivery_fee") %></dt><dd class="tabular-nums" data-online-order-target="fee" data-choose-text="<%= t("public.online_order.choose_area") %>">—</dd></div>
        <div class="flex justify-between border-t border-stone-200 pt-1.5 text-base font-semibold"><dt><%= t("public.online_order.total") %></dt><dd class="tabular-nums" data-online-order-target="total">—</dd></div>
      </dl>
      <p class="text-xs text-stone-500"><%= t("public.online_order.cash_note") %></p>
    </div>

    <div class="space-y-2 border-t border-stone-200 px-5 py-4">
      <p class="hidden text-sm text-rose-700" data-online-order-target="checkoutError" role="alert"></p>
      <button type="submit" data-online-order-target="sendButton" data-sending-text="<%= t("public.online_order.sending") %>"
              class="h-12 w-full rounded-full bg-amber-700 text-sm font-semibold text-white hover:bg-amber-800 disabled:opacity-60">
        <%= t("public.online_order.send") %>
      </button>
    </div>
  </form>
</dialog>
