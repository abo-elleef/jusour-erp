<%# locals: listing:, css: %>
<% if @storefront.show_prices && listing.price_cents.positive? %>
  <p class="<%= css %> tabular-nums">
    <span class="font-bold text-amber-700"><%= format_money(listing.price_cents) %></span>
    <% if listing.unit_label.present? %>
      <span class="text-stone-500">/ <%= listing.unit_label %></span>
    <% end %>
  </p>
<% else %>
  <p class="<%= css %> font-medium text-stone-500"><%= t("public.storefront.price_on_request") %></p>
<% end %>
