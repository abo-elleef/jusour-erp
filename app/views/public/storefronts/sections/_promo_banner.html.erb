<%# locals: section: %>
<% title = section.text(:title) %>
<% subtitle = section.text(:subtitle) %>
<% label = section.text(:button_label) %>
<% link = section.setting(:link).presence %>
<% if title.present? || section.image.attached? %>
  <section class="max-w-6xl mx-auto px-4 pt-10">
    <div class="relative overflow-hidden rounded-2xl bg-(--sf-accent) text-(--sf-on-accent)">
      <% if section.image.attached? %>
        <%= image_tag section.image.variant(:wide), alt: "", loading: "lazy", class: "absolute inset-0 h-full w-full object-cover" %>
        <span class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent rtl:bg-gradient-to-l" aria-hidden="true"></span>
      <% end %>
      <div class="relative max-w-xl px-6 py-10 sm:px-10 sm:py-14 <%= 'text-white' if section.image.attached? %>">
        <% if title.present? %>
          <h2 class="text-2xl sm:text-3xl font-semibold leading-tight"><%= title %></h2>
        <% end %>
        <% if subtitle.present? %>
          <p class="mt-2 text-base opacity-90"><%= subtitle %></p>
        <% end %>
        <% if link && label.present? %>
          <%= link_to label, link, rel: (link.start_with?("/") ? nil : "noopener"),
                class: "mt-5 inline-flex rounded-full bg-(--sf-primary) px-5 py-2.5 text-sm font-semibold text-(--sf-on-primary) hover:opacity-90" %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
