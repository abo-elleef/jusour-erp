<%# locals: section: %>
<% listings = Array(@featured).first(section.setting(:limit).to_i) %>
<% if listings.any? %>
  <section class="max-w-6xl mx-auto px-4 pt-8">
    <%= render "public/storefronts/section_heading", title: section.text(:title).presence || t("public.storefront.featured") %>
    <%= render "public/storefronts/grid", listings: listings %>
  </section>
<% end %>
