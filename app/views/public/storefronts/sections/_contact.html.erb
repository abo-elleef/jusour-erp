<%# locals: section: %>
<% map_url = section.setting(:map_url).presence %>
<% if @storefront.contact_present? || map_url %>
  <section class="max-w-6xl mx-auto px-4 pt-10">
    <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:flex sm:items-start sm:justify-between sm:gap-6">
      <div class="space-y-1.5 text-sm text-stone-600">
        <h2 class="mb-2 text-lg font-semibold text-stone-900"><%= section.text(:title).presence || t("public.storefront.contact_us") %></h2>
        <% if @storefront.address.present? %><p><%= @storefront.address %></p><% end %>
        <% if @storefront.phone_url %><p><%= link_to @storefront.phone, @storefront.phone_url, dir: "ltr", class: "hover:text-(--sf-primary) tabular-nums" %></p><% end %>
        <% if @storefront.email.present? %><p><%= mail_to @storefront.email, class: "hover:text-(--sf-primary)" %></p><% end %>
      </div>
      <div class="mt-4 flex flex-wrap gap-3 sm:mt-0">
        <% if @storefront.whatsapp_url %>
          <%= link_to @storefront.whatsapp_url, target: "_blank", rel: "noopener",
                class: "inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#1EBE5A]" do %>
            <%= render "public/storefronts/whatsapp_icon", css: "h-4 w-4" %>
            <%= t("public.storefront.chat_on_whatsapp") %>
          <% end %>
        <% end %>
        <% if map_url %>
          <%= link_to t("public.storefront.open_map"), map_url, target: "_blank", rel: "noopener",
                class: "inline-flex items-center rounded-full border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-800 hover:border-(--sf-primary) hover:text-(--sf-primary)" %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
