<%# locals: section: %>
<% headline = section.text(:headline).presence || @company.name %>
<% subheadline = section.text(:subheadline).presence || @storefront.localized(:tagline) %>
<section class="relative overflow-hidden bg-(--sf-accent) text-(--sf-on-accent)">
  <% if @storefront.banner.attached? %>
    <%= image_tag @storefront.banner.variant(:hero), alt: "", class: "absolute inset-0 h-full w-full object-cover opacity-40" %>
  <% end %>
  <div class="relative max-w-6xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-semibold leading-tight"><%= headline %></h1>
    <% if subheadline.present? %>
      <p class="mt-3 max-w-2xl text-base sm:text-lg opacity-90"><%= subheadline %></p>
    <% end %>
    <% if section.setting(:show_contact_buttons) && (@storefront.whatsapp_url || @storefront.phone_url) %>
      <div class="mt-6 flex flex-wrap gap-3">
        <% if @storefront.whatsapp_url %>
          <%= link_to @storefront.whatsapp_url, target: "_blank", rel: "noopener",
                class: "inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#1EBE5A]" do %>
            <%= render "public/storefronts/whatsapp_icon", css: "h-4 w-4" %>
            <%= t("public.storefront.chat_on_whatsapp") %>
          <% end %>
        <% end %>
        <% if @storefront.phone_url %>
          <%= link_to @storefront.phone_url, dir: "ltr",
                class: "inline-flex items-center gap-2 rounded-full border border-current/40 bg-current/10 px-5 py-2.5 text-sm font-semibold hover:bg-current/20" do %>
            <span class="tabular-nums"><%= @storefront.phone %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
