<%# locals: section:
    A teaser of the "About us" page — the story is written once, there. Shows
    nothing until that page is published. %>
<% page = @live_pages&.find { |p| p.slot == "about" } %>
<% if page %>
  <% excerpt = page.display_body.to_plain_text.squish.truncate(360, separator: " ") %>
  <section class="max-w-6xl mx-auto px-4 pt-10">
    <div class="rounded-2xl border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-stone-900"><%= section.text(:title).presence || page.display_title %></h2>
      <p class="mt-3 text-sm leading-relaxed text-stone-600" dir="auto"><%= excerpt %></p>
      <%= link_to t("public.storefront.read_more"), storefront_page_path(page),
            class: "mt-4 inline-flex text-sm font-semibold text-(--sf-primary) hover:underline" %>
    </div>
  </section>
<% end %>
