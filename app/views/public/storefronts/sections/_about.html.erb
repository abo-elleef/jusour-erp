<%# locals: section: %>
<% about = @storefront.localized(:about) %>
<% if about.present? %>
  <section class="max-w-6xl mx-auto px-4 pt-10">
    <div class="rounded-2xl border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-stone-900"><%= section.text(:title).presence || t("public.storefront.about", company: @company.name) %></h2>
      <div class="mt-3 text-sm leading-relaxed text-stone-600"><%= simple_format(about) %></div>
    </div>
  </section>
<% end %>
