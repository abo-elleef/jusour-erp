<%# locals: heading: %>
<section>
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold text-stone-900"><%= heading %></h2>
    <% if @pagy.count.positive? %>
      <p class="text-sm text-stone-500 tabular-nums"><%= t("public.storefront.product_count", count: @pagy.count) %></p>
    <% end %>
  </div>

  <% if @listings.any? %>
    <%= render "public/storefronts/grid", listings: @listings %>
    <%= render "public/storefronts/pagination", pagy: @pagy %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
      <p class="font-medium text-stone-900">
        <%= @listing_mode && (@query.present? || @category) ? t("public.storefront.no_results") : t("public.storefront.empty") %>
      </p>
      <% if @listing_mode && (@query.present? || @category) %>
        <%= link_to t("public.storefront.clear_search"), storefront_home_path,
              class: "mt-3 inline-block text-sm font-semibold text-(--sf-primary) hover:underline" %>
      <% end %>
    </div>
  <% end %>
</section>
