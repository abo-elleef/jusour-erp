<% category_name = @category && storefront_category_name(@category) %>
<% category_meta = @category && storefront_category_for(@category) %>
<% content_for :title, @category ? "#{category_name} — #{@company.name}" : @company.name %>
<% if category_meta&.display_description.present? %>
  <% content_for :meta_description, category_meta.display_description.truncate(160) %>
<% end %>

<% if @listing_mode %>
  <div class="max-w-6xl mx-auto px-4 py-6">
    <%= render "public/storefronts/category_chips" %>

    <% if @category && @query.blank? && (category_meta&.image&.attached? || category_meta&.display_description.present?) %>
      <section class="mb-8 overflow-hidden rounded-2xl border border-stone-200 bg-white sm:flex">
        <% if category_meta.image.attached? %>
          <%= image_tag category_meta.image.variant(:header), alt: "", class: "h-40 w-full object-cover sm:h-auto sm:w-2/5" %>
        <% end %>
        <div class="p-6">
          <h1 class="text-2xl font-semibold text-stone-900"><%= category_name %></h1>
          <% if category_meta.display_description.present? %>
            <div class="mt-2 text-sm leading-relaxed text-stone-600"><%= simple_format(category_meta.display_description) %></div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%= render "public/storefronts/results",
          heading: (@query.present? ? t("public.storefront.results_for", query: @query) : category_name || t("public.storefront.all_products")) %>
  </div>
<% else %>
  <% @sections.each do |section| %>
    <%= render "public/storefronts/sections/#{section.section_type}", section: section %>
  <% end %>
  <div class="pb-12"></div>
<% end %>
