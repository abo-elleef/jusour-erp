<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-600/30 focus:border-teal-600 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="mb-8">
  <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900"><%= t("auth.sign_in_heading") %></h1>
  <p class="text-gray-600 text-sm mt-1.5"><%= t("auth.sign_in_subtitle") %></p>
</div>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-sm">
  <div class="px-5 py-3.5 border-b border-gray-100 bg-slate-50/80">
    <p class="text-xs text-gray-500"><%= t("auth.sign_in_hint") %></p>
  </div>

  <div class="p-5">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, t("auth.email"), class: label_class %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              required: true,
              class: input_class,
              placeholder: t("auth.email_placeholder") %>
      </div>

      <div data-controller="password-visibility"
           data-password-visibility-show-label-value="<%= t("auth.show_password") %>"
           data-password-visibility-hide-label-value="<%= t("auth.hide_password") %>">
        <%= f.label :password, t("auth.password"), class: label_class %>
        <div class="relative">
          <%= f.password_field :password,
                autocomplete: "current-password",
                required: true,
                class: "#{input_class} pe-11",
                placeholder: "••••••••",
                data: { password_visibility_target: "field" } %>
          <button type="button"
                  class="absolute inset-y-0 end-0 flex items-center px-3 text-gray-400 hover:text-gray-600 focus:outline-none focus:text-teal-700 rounded-e-xl"
                  aria-label="<%= t("auth.show_password") %>"
                  title="<%= t("auth.show_password") %>"
                  aria-pressed="false"
                  data-password-visibility-target="button"
                  data-action="password-visibility#toggle">
            <svg class="w-5 h-5" data-password-visibility-target="showIcon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            <svg class="w-5 h-5 hidden" data-password-visibility-target="hideIcon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.774 3.162 10.066 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243" />
            </svg>
          </button>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3">
          <label class="inline-flex items-center gap-3 cursor-pointer">
            <%= f.check_box :remember_me, class: "rounded border-gray-300 text-teal-700 focus:ring-teal-600/40" %>
            <span class="text-sm font-medium text-gray-900"><%= t("auth.remember_me") %></span>
          </label>
        </div>
      <% end %>

      <%= f.submit t("auth.sign_in_button"),
            class: "w-full bg-teal-700 hover:bg-teal-800 text-white text-sm font-semibold px-6 py-3 rounded-xl shadow-sm transition-colors" %>
    <% end %>
  </div>
</section>

<div class="mt-6 text-center text-sm">
  <%= render "devise/shared/links" %>
</div>
