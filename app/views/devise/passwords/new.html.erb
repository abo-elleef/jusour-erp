<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-600/30 focus:border-teal-600 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="text-center mb-8">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("auth.forgot_password_title") %></h1>
  <p class="text-gray-600 text-sm mt-1"><%= t("auth.forgot_password_subtitle") %></p>
</div>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-sm">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("auth.reset_heading") %></h2>
    <p class="text-xs text-gray-500 mt-0.5"><%= t("auth.reset_hint") %></p>
  </div>

  <div class="p-5">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, t("auth.email"), class: label_class %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              required: true,
              class: input_class,
              placeholder: t("auth.email_placeholder") %>
      </div>

      <%= f.submit t("auth.send_reset_instructions"),
            class: "w-full bg-teal-700 hover:bg-teal-800 text-white text-sm font-semibold px-6 py-3 rounded-xl shadow-sm transition-colors" %>
    <% end %>
  </div>
</section>

<div class="mt-6 text-center text-sm">
  <%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name),
        class: "font-semibold text-teal-800 hover:text-teal-900 transition-colors" %>
</div>
