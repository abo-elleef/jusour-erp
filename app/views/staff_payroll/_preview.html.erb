<%# locals: user, payroll_month, payroll_summary %>
<% return unless payroll_summary %>

<div class="space-y-4 pb-2">
  <%# Profile header %>
  <div class="flex items-center gap-3">
    <div class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-amber-100 text-amber-800 text-lg font-bold" aria-hidden="true">
      <%= user.name.first.upcase %>
    </div>
    <div class="min-w-0 flex-1">
      <h1 class="text-lg font-bold tracking-tight text-gray-900 truncate"><%= user.name %></h1>
      <p class="text-sm text-gray-600"><%= t("staff.payroll_portal.title") %></p>
      <% if payroll_summary.finalized %>
        <p class="text-xs text-emerald-700 font-medium mt-1"><%= t("staff.payroll_portal.recorded") %></p>
      <% end %>
    </div>
  </div>

  <%# Month picker — full width, touch-friendly %>
  <%= form_with url: staff_payroll_path(token: user.payroll_access_token), method: :get,
        class: "rounded-2xl border border-gray-200 bg-white p-4 shadow-sm" do %>
    <label for="payroll_month" class="block text-xs font-semibold text-gray-600 mb-2"><%= t("staff.payroll.month") %></label>
    <div class="flex flex-col sm:flex-row gap-3">
      <%= month_field_tag :payroll_month, payroll_month.strftime("%Y-%m"),
            id: "payroll_month",
            class: "flex-1 w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 text-base text-gray-900 min-h-[3rem] focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
      <%= submit_tag t("actions.apply"),
            class: "w-full sm:w-auto shrink-0 bg-gray-900 hover:bg-gray-800 active:bg-black text-white text-sm font-semibold px-6 py-3.5 rounded-xl min-h-[3rem] transition-colors" %>
    </div>
  <% end %>

  <%# This month only: what the month's pay comes to after what they already
      had during it, and whether it has been paid. The account balance (an
      advance still being repaid) is a separate box below. %>
  <% snapshot = payroll_summary.snapshot %>
  <% payout_voucher = snapshot&.payout_voucher %>
  <% net_cents = [payroll_summary.net_pay_cents, 0].max %>
  <%# Paid to them or eaten during the month; a recorded month's own payout is not part of it. %>
  <% taken_cents = if snapshot
       snapshot.advances_cents.to_i + snapshot.staff_meals_cents.to_i
     else
       payroll_summary.paid_cents.to_i + payroll_summary.staff_meals_cents.to_i
     end %>
  <% payout_cents = payroll_summary.payout_cents.to_i %>
  <% carried_cents = payout_cents - net_cents + taken_cents %>
  <div class="rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-amber-100/80 p-5 shadow-sm">
    <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide"><%= t("staff.payroll_portal.to_pay_title") %></p>
    <p class="text-3xl sm:text-4xl font-bold text-amber-950 tabular-nums mt-1"><%= format_amount(payout_cents) %></p>
    <% if payout_voucher %>
      <p class="inline-flex mt-3 text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800">
        <%= t("staff.payroll_portal.status_paid", date: l(payout_voucher.voucher_date, format: :long)) %>
      </p>
    <% elsif payout_cents.zero? %>
      <p class="inline-flex mt-3 text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-700">
        <%= t("staff.payroll_portal.status_nothing") %>
      </p>
    <% elsif payroll_summary.finalized %>
      <%# Recorded before payouts were issued as vouchers. %>
      <p class="inline-flex mt-3 text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800">
        <%= t("staff.payroll_portal.recorded") %>
      </p>
    <% else %>
      <p class="inline-flex mt-3 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-200/70 text-amber-900">
        <%= t("staff.payroll_portal.status_not_paid") %>
      </p>
    <% end %>

    <dl class="mt-4 space-y-1.5 text-sm text-amber-900/90">
      <div class="flex justify-between gap-3">
        <dt><%= t("staff.payroll_portal.breakdown_net") %></dt>
        <dd class="tabular-nums"><%= format_amount(net_cents) %></dd>
      </div>
      <% if carried_cents.positive? %>
        <div class="flex justify-between gap-3">
          <dt><%= t("staff.payroll_portal.breakdown_carried") %></dt>
          <dd class="tabular-nums">+<%= format_amount(carried_cents) %></dd>
        </div>
      <% end %>
      <% if taken_cents.positive? %>
        <div class="flex justify-between gap-3 text-red-700">
          <dt><%= t("staff.payroll_portal.breakdown_deduction") %></dt>
          <dd class="tabular-nums">−<%= format_amount(taken_cents) %></dd>
        </div>
      <% end %>
      <div class="flex justify-between gap-3 border-t border-amber-200 pt-1.5 font-semibold text-amber-950">
        <dt><%= t("staff.payroll_portal.breakdown_total") %></dt>
        <dd class="tabular-nums"><%= format_amount(payout_cents) %></dd>
      </div>
    </dl>
  </div>

  <%# What they owe the company, apart from this month's pay. %>
  <% if payroll_summary.debt_after_cents.positive? %>
    <div class="rounded-2xl border border-red-200 bg-red-50/60 p-4">
      <p class="text-xs font-semibold text-red-700 uppercase tracking-wide"><%= t("staff.payroll_portal.debt_title") %></p>
      <p class="text-2xl font-bold text-red-700 tabular-nums mt-1"><%= format_amount(payroll_summary.debt_after_cents) %></p>
    </div>
  <% end %>

  <%# Summary stats %>
  <div class="grid grid-cols-2 gap-3">
    <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
      <p class="text-[0.65rem] font-semibold text-gray-500 uppercase tracking-wide leading-tight">
        <%= payroll_summary.attendance_recorded ? t("accounting.monthly_payroll.attendance_pay") : t("staff.payroll.base_salary") %>
      </p>
      <p class="text-base sm:text-lg font-bold text-gray-900 tabular-nums mt-1.5 break-all"><%= format_amount(payroll_summary.attendance_pay_cents) %></p>
      <% if (days_label = payroll_attendance_days_label(payroll_summary)) %>
        <p class="text-[11px] font-normal text-gray-400 mt-1"><%= days_label %></p>
      <% end %>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
      <p class="text-[0.65rem] font-semibold text-gray-500 uppercase tracking-wide leading-tight"><%= t("staff.payroll.daily_rate") %></p>
      <p class="text-base sm:text-lg font-bold text-gray-900 tabular-nums mt-1.5 break-all"><%= format_amount(payroll_summary.daily_rate_cents) %></p>
    </div>
    <div class="rounded-2xl border border-red-100 bg-red-50/80 p-4 shadow-sm">
      <p class="text-[0.65rem] font-semibold text-red-600 uppercase tracking-wide leading-tight"><%= t("staff.payroll.penalties") %></p>
      <p class="text-base sm:text-lg font-bold text-red-700 tabular-nums mt-1.5 break-all">−<%= format_amount(payroll_summary.penalties_cents) %></p>
      <% if payroll_summary.penalties_waived_cents.to_i.positive? %>
        <p class="text-[11px] text-emerald-700 mt-1"><%= t("staff.payroll.waiver.waived", amount: format_amount(payroll_summary.penalties_waived_cents)) %></p>
      <% end %>
    </div>
    <div class="rounded-2xl border border-emerald-100 bg-emerald-50/80 p-4 shadow-sm">
      <p class="text-[0.65rem] font-semibold text-emerald-600 uppercase tracking-wide leading-tight"><%= t("staff.payroll.bonuses") %></p>
      <p class="text-base sm:text-lg font-bold text-emerald-700 tabular-nums mt-1.5 break-all">+<%= format_amount(payroll_summary.bonuses_cents) %></p>
    </div>
  </div>

  <%# Money paid to / received from them this month — card list %>
  <% if payroll_summary.payments.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden">
      <div class="px-4 py-3.5 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("staff.payroll_portal.advances_title") %></h2>
      </div>
      <ul class="divide-y divide-gray-100">
        <% payroll_summary.payments.each do |voucher| %>
          <li class="p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <% kind = if !voucher.payment? then :received_from_you
                          elsif payout_voucher && voucher.id == payout_voucher.id then :salary
                          else :advance
                          end %>
                <span class="inline-flex text-[0.65rem] font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full <%= { salary: 'bg-amber-100 text-amber-800', advance: 'bg-blue-100 text-blue-800', received_from_you: 'bg-emerald-100 text-emerald-800' }[kind] %>"
                      data-payment-kind="<%= kind %>">
                  <%= t("staff.payroll_portal.payment_kinds.#{kind}") %>
                </span>
                <p class="text-xs text-gray-500 mt-1.5 tabular-nums">
                  <%= t("staff.payroll.happened_at") %>: <%= l(voucher.voucher_date, format: :long) %>
                </p>
                <% if voucher.notes.present? %>
                  <p class="text-xs text-gray-500 mt-1.5 leading-relaxed"><%= voucher.notes %></p>
                <% end %>
              </div>
              <%# Signed from the employee's side: money paid to them is +, money
                  they paid back is −. %>
              <p class="shrink-0 text-base font-bold tabular-nums <%= voucher.payment? ? 'text-emerald-700' : 'text-red-700' %>" data-payment-amount>
                <%= voucher.payment? ? "+" : "−" %><%= format_amount(voucher.amount_cents) %>
              </p>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%# Adjustments — card list %>
  <section class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden">
    <div class="px-4 py-3.5 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("staff.payroll_portal.adjustments_title") %></h2>
    </div>

    <% if payroll_summary.adjustments.any? %>
      <ul class="divide-y divide-gray-100">
        <% payroll_summary.adjustments.each do |adj| %>
          <li class="p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <span class="inline-flex text-[0.65rem] font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full <%= adj.penalty? ? 'bg-red-100 text-red-800' : 'bg-emerald-100 text-emerald-800' %>">
                  <%= t("staff.payroll.kinds.#{adj.kind}") %>
                </span>
                <p class="text-xs text-gray-500 mt-1.5 tabular-nums">
                  <%= t("staff.payroll.happened_at") %>: <%= l(adj.happened_at, format: :long) %>
                </p>
                <p class="text-sm text-gray-700 mt-2 leading-snug"><%= adj.unit_label %></p>
                <% if adj.notes.present? %>
                  <p class="text-xs text-gray-500 mt-1.5 leading-relaxed"><%= adj.notes %></p>
                <% end %>
              </div>
              <p class="shrink-0 text-base font-bold tabular-nums <%= adj.penalty? ? 'text-red-700' : 'text-emerald-700' %>">
                <%= adj.penalty? ? "−" : "+" %><%= format_amount(adj.amount_cents) %>
              </p>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="p-5 text-sm text-gray-500 text-center"><%= t("staff.payroll.no_adjustments") %></p>
    <% end %>
  </section>

  <%# Lock — full-width touch target at bottom %>
  <%= button_to t("staff.payroll_portal.lock"),
        lock_staff_payroll_path(token: user.payroll_access_token),
        method: :delete,
        class: "w-full text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 active:bg-gray-100 px-4 py-4 rounded-2xl border border-gray-200 transition-colors min-h-[3rem] shadow-sm" %>
</div>
