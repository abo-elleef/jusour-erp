<% content_for :title, t("auth.change_password_title") %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-600/30 focus:border-teal-600 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="text-center mb-8">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("auth.change_password_title") %></h1>
  <p class="text-gray-600 text-sm mt-1"><%= t("auth.change_password_subtitle") %></p>
</div>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-sm">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
    <h2 class="text-sm font-semibold text-gray-900"><%= @user.name %></h2>
    <p class="text-xs text-gray-500 mt-0.5"><%= t("auth.change_password_hint", minimum: 6) %></p>
  </div>

  <div class="p-5">
    <%= form_with model: @user, url: account_password_path, method: :patch, scope: :user, class: "space-y-5" do |f| %>
      <% if @user.errors.any? %>
        <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= f.label :current_password, t("auth.current_password"), class: label_class %>
        <%= f.password_field :current_password,
              autofocus: true,
              autocomplete: "current-password",
              required: true,
              class: input_class,
              placeholder: "••••••••" %>
      </div>

      <div>
        <%= f.label :password, t("auth.new_password"), class: label_class %>
        <%= f.password_field :password,
              autocomplete: "new-password",
              required: true,
              minlength: 6,
              class: input_class,
              placeholder: "••••••••" %>
      </div>

      <div>
        <%= f.label :password_confirmation, t("auth.confirm_new_password"), class: label_class %>
        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              required: true,
              minlength: 6,
              class: input_class,
              placeholder: "••••••••" %>
      </div>

      <%= f.submit t("auth.update_password_button"),
            class: "w-full bg-teal-700 hover:bg-teal-800 text-white text-sm font-semibold px-6 py-3 rounded-xl shadow-sm transition-colors" %>
    <% end %>
  </div>
</section>

<div class="mt-6 text-center text-sm">
  <%= link_to t("actions.back"), @back_path,
        class: "font-semibold text-teal-800 hover:text-teal-900 transition-colors" %>
</div>
