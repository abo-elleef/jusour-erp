<%= form_with model: [:super_admin, company], class: "space-y-5" do |f| %>
  <% if company.errors.any? %>
    <div class="rounded-xl border border-red-800 bg-red-900/40 px-4 py-3 text-sm text-red-300">
      <ul class="list-disc list-inside space-y-1">
        <% company.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% field_class = "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500" %>
  <% label_class = "block text-xs font-semibold text-gray-400 mb-1.5" %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= f.label :name, "Company name", class: label_class %>
      <%= f.text_field :name, class: field_class, placeholder: "Acme Restaurant" %>
    </div>
    <div>
      <%= f.label :slug, "Slug (URL identifier)", class: label_class %>
      <%= f.text_field :slug, class: field_class, placeholder: "acme-restaurant" %>
    </div>
    <div>
      <%= f.label :currency, "Currency", class: label_class %>
      <%= f.select :currency, [["EGP — Egyptian Pound", "EGP"], ["USD — US Dollar", "USD"], ["SAR — Saudi Riyal", "SAR"], ["AED — UAE Dirham", "AED"]],
            {}, class: field_class %>
    </div>
    <div>
      <%= f.label :timezone, "Timezone", class: label_class %>
      <%= f.select :timezone, ActiveSupport::TimeZone.all.map { |tz| [tz.name, tz.tzinfo.name] },
            {}, class: field_class %>
    </div>
    <div>
      <%= f.label :locale, "Default locale", class: label_class %>
      <%= f.select :locale, [["Arabic (ar)", "ar"], ["English (en)", "en"]],
            {}, class: field_class %>
    </div>
    <div>
      <%= f.label :business_type, "Business type", class: label_class %>
      <%= f.select :business_type,
            [["Restaurant / Café", "restaurant"], ["Distribution / Wholesale", "distribution"]],
            {}, class: field_class %>
      <p class="text-xs text-gray-500 mt-1.5">Sets which modules the company sees — restaurants get manufacturing &amp; attendance; distributors get credit sales &amp; pricing tiers.</p>
    </div>
    <div class="flex items-center gap-3 pt-6">
      <%= f.check_box :active, class: "rounded border-gray-600 bg-gray-800 text-indigo-600 focus:ring-indigo-500/40" %>
      <%= f.label :active, "Active (company can sign in)", class: "text-sm text-gray-300" %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-700 bg-gray-800/50 p-5 space-y-3">
    <div>
      <h3 class="text-sm font-semibold text-gray-200">Feature overrides</h3>
      <p class="text-xs text-gray-500 mt-0.5">Fine-tune individual modules for this company. <span class="font-medium text-gray-400">Inherit</span> follows the business type; On/Off force a module regardless.</p>
    </div>
    <%
      feature_labels = {
        "manufacturing" => "Manufacturing", "attendance" => "Attendance",
        "kds" => "Kitchen display (KDS)", "menu" => "Menu",
        "ar_credit_sales" => "Credit sales (AR)", "price_tiers" => "Price tiers",
        "landed_cost" => "Landed cost / imports",
        "leads" => "Leads", "storefront" => "Storefront website"
      }
      overrides = company.feature_overrides || {}
    %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% Company::FEATURES.each do |feature| %>
        <%
          current = overrides.key?(feature) ? (overrides[feature] ? "on" : "off") : "inherit"
          default_on = Company::PROFILE_FEATURE_DEFAULTS.dig(company.business_type, feature) != false
        %>
        <div class="flex items-center justify-between gap-3 rounded-lg bg-gray-900/40 px-3 py-2">
          <div>
            <span class="text-sm text-gray-200"><%= feature_labels[feature] || feature.humanize %></span>
            <span class="block text-[11px] text-gray-500">default: <%= default_on ? "On" : "Off" %></span>
          </div>
          <%= select_tag "feature_overrides[#{feature}]",
                options_for_select([["Inherit", "inherit"], ["On", "on"], ["Off", "off"]], current),
                class: "bg-gray-800 border border-gray-700 rounded-lg px-2 py-1.5 text-sm text-white" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit company.persisted? ? "Save changes" : "Create company",
          class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition-colors cursor-pointer" %>
    <%= link_to "Cancel",
          company.persisted? ? super_admin_company_path(company) : super_admin_root_path,
          class: "text-sm text-gray-400 hover:text-gray-200 px-4 py-2.5" %>
  </div>
<% end %>
