<div class="mb-6">
  <%= link_to "← #{@company.name}", super_admin_company_path(@company), class: "text-sm text-gray-400 hover:text-gray-200" %>
  <h1 class="text-xl font-bold text-white mt-2">Website domain — <%= @company.name %></h1>
</div>

<div class="max-w-2xl space-y-6">
  <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6">
    <%= form_with model: @storefront, url: super_admin_company_storefront_domain_path(@company), method: :patch, class: "space-y-5" do |f| %>
      <% if @storefront.errors.any? %>
        <div class="rounded-xl border border-red-800 bg-red-900/40 px-4 py-3 text-sm text-red-300">
          <ul class="list-disc list-inside space-y-1">
            <% @storefront.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :custom_domain, "Custom domain", class: "block text-xs font-semibold text-gray-400 mb-1.5" %>
        <%= f.text_field :custom_domain, dir: "ltr", autocapitalize: "none", spellcheck: false, placeholder: "www.example.com",
              class: "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white font-mono placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500" %>
        <p class="text-xs text-gray-500 mt-1.5">
          The full host visitors type, usually with www. Leave blank to disconnect.
          Once saved, the <span class="font-mono"><%= @storefront.subdomain.presence || "subdomain" %>.<%= Storefront.base_domain.presence || "…" %></span>
          link redirects here — so save it only after the steps below are done.
        </p>
      </div>

      <div class="flex gap-3 pt-2">
        <%= f.submit "Save domain",
              class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition-colors cursor-pointer" %>
        <%= link_to "Cancel", super_admin_company_path(@company), class: "text-sm text-gray-400 hover:text-gray-200 px-4 py-2.5" %>
      </div>
    <% end %>
  </div>

  <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6 text-sm text-gray-300">
    <h2 class="text-sm font-semibold text-white mb-3">Connecting a domain</h2>
    <ol class="list-decimal list-inside space-y-2">
      <li>Add it on Heroku:
        <code class="block mt-1 bg-gray-800 rounded-lg px-3 py-2 text-xs font-mono text-gray-200" dir="ltr">heroku domains:add www.example.com -a rest-management-system</code>
      </li>
      <li>In the client's DNS, add a <span class="font-mono">CNAME</span> for <span class="font-mono">www</span> pointing at the DNS target Heroku printed.</li>
      <li>For the bare domain (<span class="font-mono">example.com</span>), forward it with a 301 to <span class="font-mono">https://www.example.com</span> — GoDaddy can't point a bare domain at Heroku. Use plain forwarding, not masking.</li>
      <li>Wait until <span class="font-mono">heroku certs:auto -a rest-management-system</span> shows <span class="font-mono">Cert issued</span> for the domain, then save it above.</li>
    </ol>
  </div>
</div>
