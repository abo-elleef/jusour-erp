<div class="text-center mb-8">
  <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-indigo-600 text-white font-bold text-lg mb-4">S</div>
  <h1 class="text-xl font-bold text-white">Super Admin</h1>
  <p class="text-gray-400 text-sm mt-1">Restricted access</p>
</div>

<div class="rounded-2xl border border-gray-800 bg-gray-900 overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-800">
    <h2 class="text-sm font-semibold text-gray-200">Sign in</h2>
  </div>
  <div class="p-5">
    <%= form_for(resource, as: resource_name, url: super_admin_user_session_path, html: { class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, "Email", class: "block text-xs font-semibold text-gray-400 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
              class: "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500",
              placeholder: "admin@example.com" %>
      </div>
      <div>
        <%= f.label :password, "Password", class: "block text-xs font-semibold text-gray-400 mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true,
              class: "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500",
              placeholder: "••••••••" %>
      </div>
      <%= f.submit "Sign in",
            class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-3 rounded-xl transition-colors cursor-pointer" %>
    <% end %>
  </div>
</div>
