<%= form_with model: [:super_admin, company, location], class: "space-y-5" do |f| %>
  <% if location.errors.any? %>
    <div class="rounded-xl border border-red-800 bg-red-900/40 px-4 py-3 text-sm text-red-300">
      <ul class="list-disc list-inside space-y-1">
        <% location.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% field_class = "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500" %>
  <% label_class = "block text-xs font-semibold text-gray-400 mb-1.5" %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= f.label :name, "Branch name", class: label_class %>
      <%= f.text_field :name, class: field_class, placeholder: "Downtown Branch" %>
    </div>
    <div>
      <%= f.label :location_type, "Type", class: label_class %>
      <%= f.select :location_type, Location::TYPES.map { |t| [t.humanize, t] }, {}, class: field_class %>
    </div>
    <div>
      <%= f.label :phone, "Phone", class: label_class %>
      <%= f.text_field :phone, class: field_class, placeholder: "+20 10 0000 0000" %>
    </div>
    <div>
      <%= f.label :whatsapp_number, "WhatsApp number", class: label_class %>
      <%= f.text_field :whatsapp_number, class: field_class, placeholder: "+20 10 0000 0000" %>
    </div>
    <div class="sm:col-span-2">
      <%= f.label :address, "Address", class: label_class %>
      <%= f.text_area :address, rows: 2, class: field_class, placeholder: "123 Main St, Cairo" %>
    </div>
    <div class="flex items-center gap-3">
      <%= f.check_box :active, class: "rounded border-gray-600 bg-gray-800 text-indigo-600 focus:ring-indigo-500/40" %>
      <%= f.label :active, "Active", class: "text-sm text-gray-300" %>
    </div>
    <div class="flex items-center gap-3">
      <%= f.check_box :public_menu_enabled, class: "rounded border-gray-600 bg-gray-800 text-indigo-600 focus:ring-indigo-500/40" %>
      <%= f.label :public_menu_enabled, "Public menu enabled", class: "text-sm text-gray-300" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit location.persisted? ? "Save changes" : "Create branch",
          class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition-colors cursor-pointer" %>
    <%= link_to "Cancel", super_admin_company_path(company), class: "text-sm text-gray-400 hover:text-gray-200 px-4 py-2.5" %>
  </div>
<% end %>
