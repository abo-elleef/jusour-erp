<%= form_with model: [:super_admin, company, user], class: "space-y-5" do |f| %>
  <% if user.errors.any? %>
    <div class="rounded-xl border border-red-800 bg-red-900/40 px-4 py-3 text-sm text-red-300">
      <ul class="list-disc list-inside space-y-1">
        <% user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% field_class = "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500" %>
  <% label_class = "block text-xs font-semibold text-gray-400 mb-1.5" %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= f.label :name, "Full name", class: label_class %>
      <%= f.text_field :name, class: field_class, placeholder: "Ahmed Ali" %>
    </div>
    <div>
      <%= f.label :email, "Email", class: label_class %>
      <%= f.email_field :email, class: field_class, placeholder: "owner@company.com" %>
    </div>
    <div>
      <%= f.label :password, "Password", class: label_class %>
      <%= f.password_field :password, class: field_class, autocomplete: "new-password" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: label_class %>
      <%= f.password_field :password_confirmation, class: field_class, autocomplete: "new-password" %>
    </div>
    <div>
      <%= f.label :role, "Role", class: label_class %>
      <%= f.select :role, User::ROLES.map { |r| [r.humanize, r] }, {}, class: field_class %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit "Create account",
          class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition-colors cursor-pointer" %>
    <%= link_to "Cancel", super_admin_company_path(company), class: "text-sm text-gray-400 hover:text-gray-200 px-4 py-2.5" %>
  </div>
<% end %>
