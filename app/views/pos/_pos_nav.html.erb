<nav class="flex flex-wrap items-center gap-2" aria-label="<%= t("nav.pos") %>">
  <%= render "shared/locale_switcher" %>
  <% if @pos_locations.many? %>
    <%= form_with url: pos_set_location_path, method: :patch,
          class: "inline-flex items-center gap-2",
          data: { turbo_frame: "_top" } do %>
      <label for="pos_location_id" class="sr-only"><%= t("pos.location.label") %></label>
      <%# A blank option whenever nothing is actually selected: without it the browser
          shows the first branch as chosen while no branch is set, and the cashier has
          to pick another branch and come back to get one. %>
      <%= select_tag :location_id,
            options_from_collection_for_select(@pos_locations, :id, :name, @pos_location&.id),
            id: "pos_location_id",
            include_blank: (@pos_location ? false : t("pos.location.select")),
            class: "border rounded-xl px-3 py-1.5 text-sm font-semibold #{@pos_location ? 'border-gray-200 text-gray-800 bg-white' : 'border-amber-300 text-amber-900 bg-amber-50'}",
            onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% elsif @pos_location %>
    <span class="text-sm font-semibold text-gray-600 px-2 py-1.5"><%= @pos_location.name %></span>
  <% else %>
    <span class="text-sm font-semibold text-amber-900 bg-amber-50 border border-amber-200 rounded-xl px-3 py-1.5">
      <%= t("pos.location.none_assigned") %>
    </span>
  <% end %>
  <% if @pos_workstations.present? && @pos_workstations.any? %>
    <%= form_with url: pos_set_workstation_path, method: :patch,
          class: "inline-flex items-center gap-2",
          data: { turbo_frame: "_top" } do %>
      <label for="pos_workstation_id" class="sr-only"><%= t("pos.workstation.label") %></label>
      <%= select_tag :workstation_id,
            options_from_collection_for_select(@pos_workstations, :id, :name, @pos_workstation&.id),
            id: "pos_workstation_id",
            include_blank: (@pos_workstations.one? ? false : t("pos.workstation.select")),
            class: "border border-amber-200 rounded-xl px-3 py-1.5 text-sm font-semibold text-amber-900 bg-amber-50",
            onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>
  <%= link_to t("nav.register"), pos_path, class: pos_nav_link_class(request.path == pos_path) %>
  <% if @pos_location&.table_service? %>
    <%= link_to t("nav.tables"), pos_tables_path, class: pos_nav_link_class(request.path == pos_tables_path) %>
  <% end %>
  <%= link_to t("nav.collect_payment"), pos_orders_path, class: pos_nav_link_class(request.path.start_with?("/pos/orders")) %>
  <%= link_to t("nav.my_shift"), pos_shift_path, class: pos_nav_link_class(request.path == pos_shift_path || request.path.start_with?("/pos/shift")) %>
  <%= link_to t("nav.kitchen"), kitchen_path, class: pos_nav_link_class(request.path == kitchen_path) %>
  <% if current_user.admin_access? %>
    <%= link_to t("nav.admin"), admin_root_path, class: pos_nav_link_class(request.path.start_with?("/admin")) %>
  <% end %>
  <%= link_to t("auth.change_password"), edit_account_password_path,
        class: pos_nav_link_class(request.path == edit_account_password_path) %>
  <%= button_to t("actions.sign_out"), destroy_user_session_path, method: :delete,
        class: "px-3 py-1.5 rounded-xl text-sm font-semibold text-gray-600 border border-transparent hover:bg-gray-100 transition-colors" %>
</nav>
