<nav class="flex flex-wrap items-center gap-2" aria-label="<%= t("nav.pos") %>">
  <%= render "shared/locale_switcher" %>
  <%= link_to t("nav.register"), pos_path, class: pos_nav_link_class(request.path == pos_path) %>
  <%= link_to t("nav.collect_payment"), pos_orders_path, class: pos_nav_link_class(request.path.start_with?("/pos/orders")) %>
  <%= link_to t("nav.my_shift"), pos_shift_path, class: pos_nav_link_class(request.path == pos_shift_path || request.path.start_with?("/pos/shift")) %>
  <%= link_to t("nav.kitchen"), kitchen_path, class: pos_nav_link_class(request.path == kitchen_path) %>
  <% if current_user.admin_access? %>
    <%= link_to t("nav.admin"), admin_root_path, class: pos_nav_link_class(request.path.start_with?("/admin")) %>
  <% end %>
  <%= button_to t("actions.sign_out"), destroy_user_session_path, method: :delete,
        class: "px-3 py-1.5 rounded-xl text-sm font-semibold text-gray-600 border border-transparent hover:bg-gray-100 transition-colors" %>
</nav>
