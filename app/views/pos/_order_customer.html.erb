<%# locals: order, customer_form_errors: nil, edit_customer_errors: nil, embedded: false %>
<% edit_customer_errors = local_assigns[:edit_customer_errors] %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% form_errors = local_assigns[:customer_form_errors] %>
<% section_class = local_assigns[:embedded] ? "px-4 pb-4" : "px-5 py-4 border-b border-stone-200/80 shrink-0 bg-white" %>

<div id="order-customer" class="<%= section_class %>">
  <% if local_assigns[:embedded] %>
    <% if order.customer %>
      <div class="flex justify-end mb-2">
        <%= button_to t("pos.customer.clear"),
              pos_attach_customer_path(clear: 1),
              method: :patch,
              form: { data: { turbo_stream: true } },
              class: "text-xs font-semibold text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  <% else %>
    <div class="flex justify-between items-center gap-2 mb-2">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("order.labels.customer") %></p>
      <% if order.customer %>
        <%= button_to t("pos.customer.clear"),
              pos_attach_customer_path(clear: 1),
              method: :patch,
              form: { data: { turbo_stream: true } },
              class: "text-xs font-semibold text-gray-600 hover:text-gray-900" %>
      <% end %>
    </div>
  <% end %>

  <% if order.customer %>
    <div class="rounded-2xl bg-amber-50 px-3.5 py-3 ring-1 ring-amber-200/60">
      <div class="flex items-start justify-between gap-2">
        <p class="font-semibold text-gray-900"><%= order.customer.display_name %></p>
        <button type="button"
                onclick="document.getElementById('edit-customer-dialog').showModal()"
                class="shrink-0 text-xs font-semibold text-amber-700 hover:text-amber-900 px-2 py-0.5 rounded-lg hover:bg-amber-100 transition-colors">
          <%= t("actions.edit") %>
        </button>
      </div>
      <p class="text-xs text-gray-600 mt-0.5">
        <% if order.customer.email.present? %><span class="block"><%= order.customer.email %></span><% end %>
        <% order.customer.contact_phones.each do |num| %>
          <span class="block"><%= num %></span>
        <% end %>
      </p>
      <%# The drawer has room for the addresses themselves, not just how many there
          are — a cashier taking a delivery needs to read one, not count them. %>
      <% if order.customer.addresses.any? %>
        <div class="mt-2 space-y-1">
          <% order.customer.addresses.ordered.each do |addr| %>
            <p class="text-xs text-gray-600 flex gap-1.5">
              <span class="shrink-0 font-semibold text-gray-500">
                <%= addr.label.presence || t("customers.addresses.address") %><%= " ★" if addr.is_default? %>
              </span>
              <span class="min-w-0"><%= addr.address %></span>
            </p>
          <% end %>
        </div>
      <% end %>
      <% if order.customer.standing_note.present? %>
        <p class="text-xs text-amber-900 bg-amber-100/70 rounded-lg px-2 py-1.5 mt-2">
          <span class="font-semibold"><%= t("pos.customer.standing_note") %>:</span>
          <%= order.customer.standing_note %>
        </p>
      <% end %>
      <% if order.customer.loyalty_points.positive? %>
        <p class="text-xs font-semibold text-amber-800 mt-1.5">
          <%= customer_loyalty_points_label(order.customer.loyalty_points) %>
        </p>
      <% end %>
    </div>

    <%# ── Edit customer stacked dialog ───────────────────────────────────── %>
    <dialog id="edit-customer-dialog"
            class="m-auto rounded-[28px] shadow-2xl border-0 p-0 w-[26rem] max-w-[95vw] max-h-[90vh] overflow-y-auto backdrop:bg-black/60 backdrop:backdrop-blur-sm"
            onclick="if(event.target===this)this.close()"
            <%= "open" if edit_customer_errors&.any? %>>
      <div class="px-6 pt-6 pb-4 border-b border-stone-100 flex items-center justify-between sticky top-0 bg-white z-10">
        <h3 class="text-base font-semibold text-stone-900"><%= t("pos.customer.edit_title") %></h3>
        <button type="button" onclick="document.getElementById('edit-customer-dialog').close()"
                class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 text-stone-500 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <%= form_with url: pos_customer_path(order.customer),
            method: :patch,
            scope: :customer,
            data: { turbo_stream: true },
            onsubmit: "document.getElementById('edit-customer-dialog').close()" do |f| %>
        <div class="px-6 py-5 space-y-5">
          <% if edit_customer_errors&.any? %>
            <p class="text-sm text-red-700 bg-red-50 rounded-xl px-3 py-2" role="alert">
              <%= edit_customer_errors.full_messages.to_sentence %>
            </p>
          <% end %>

          <%# Name %>
          <div>
            <%= f.label :name, t("customers.form.name"), class: "block text-xs font-medium text-stone-500 mb-1" %>
            <%= f.text_field :name, value: order.customer.name,
                  class: "w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400",
                  autocomplete: "off" %>
          </div>

          <%# Phones %>
          <div>
            <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-2"><%= t("pos.customer.phones_section") %></p>
            <div class="space-y-2">
              <div>
                <%= f.label :phone, t("customers.form.phone"), class: "block text-xs font-medium text-stone-500 mb-1" %>
                <%= f.telephone_field :phone, value: order.customer.phone,
                      placeholder: "+20 10 1234 5678",
                      class: "w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400",
                      autocomplete: "tel" %>
              </div>
              <div>
                <%= f.label :phone_secondary, t("customers.form.phone_secondary"), class: "block text-xs font-medium text-stone-500 mb-1" %>
                <%= f.telephone_field :phone_secondary, value: order.customer.phone_secondary,
                      placeholder: "+20 10 1234 5678",
                      class: "w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400",
                      autocomplete: "tel" %>
              </div>
            </div>
          </div>

          <%# Standing note — carried onto every order this customer is attached to %>
          <div>
            <%= f.label :standing_note, t("pos.customer.standing_note"), class: "block text-xs font-medium text-stone-500 mb-1" %>
            <%= f.text_area :standing_note, value: order.customer.standing_note,
                  rows: 2,
                  placeholder: t("pos.customer.standing_note_placeholder"),
                  class: "w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-400 resize-none" %>
            <p class="text-xs text-stone-500 mt-1"><%= t("pos.customer.standing_note_hint") %></p>
          </div>

          <%# Addresses %>
          <div>
            <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-2"><%= t("customers.addresses.title") %></p>
            <div id="edit-customer-addresses" class="space-y-3">
              <% order.customer.addresses.ordered.each do |addr| %>
                <div class="rounded-xl border border-stone-200 bg-stone-50 p-3 space-y-2" id="addr-<%= addr.id %>">
                  <%= hidden_field_tag "customer[addresses_attributes][][id]", addr.id %>
                  <div class="flex items-center gap-2">
                    <div class="flex-1">
                      <%= label_tag "customer[addresses_attributes][][label]", t("customers.addresses.label"),
                            class: "block text-xs font-medium text-stone-500 mb-1" %>
                      <%= text_field_tag "customer[addresses_attributes][][label]", addr.label,
                            class: "w-full rounded-lg border border-stone-200 bg-white px-2.5 py-1.5 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400",
                            placeholder: t("customers.addresses.label_placeholder") %>
                    </div>
                    <label class="flex items-center gap-1 mt-4 cursor-pointer text-xs text-stone-600 font-medium">
                      <%= check_box_tag "customer[addresses_attributes][][is_default]", "1",
                            addr.is_default?,
                            class: "rounded border-stone-300 text-amber-600 focus:ring-amber-500" %>
                      <%= t("customers.addresses.default") %>
                    </label>
                  </div>
                  <div>
                    <%= label_tag "customer[addresses_attributes][][address]", t("customers.addresses.address"),
                          class: "block text-xs font-medium text-stone-500 mb-1" %>
                    <%= text_area_tag "customer[addresses_attributes][][address]", addr.address,
                          rows: 2,
                          class: "w-full rounded-lg border border-stone-200 bg-white px-2.5 py-1.5 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400 resize-none" %>
                  </div>
                  <div class="flex justify-end">
                    <%= check_box_tag "customer[addresses_attributes][][_destroy]", "1", false,
                          id: "destroy-addr-#{addr.id}",
                          class: "sr-only",
                          onchange: "this.closest('[id^=addr-]').style.display=this.checked?'none':''" %>
                    <label for="destroy-addr-<%= addr.id %>"
                           class="text-xs font-semibold text-red-600 hover:text-red-800 cursor-pointer px-2 py-0.5 rounded hover:bg-red-50">
                      <%= t("actions.remove") %>
                    </label>
                  </div>
                </div>
              <% end %>
            </div>

            <%# Add new address row (hidden by default, toggled by JS) %>
            <div id="new-address-fields" class="hidden mt-3 rounded-xl border border-dashed border-stone-300 bg-stone-50/60 p-3 space-y-2">
              <div class="flex items-center gap-2">
                <div class="flex-1">
                  <%= label_tag "customer[addresses_attributes][][label]", t("customers.addresses.label"),
                        class: "block text-xs font-medium text-stone-500 mb-1" %>
                  <%= text_field_tag "customer[addresses_attributes][][label]", nil,
                        class: "w-full rounded-lg border border-stone-200 bg-white px-2.5 py-1.5 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400",
                        placeholder: t("customers.addresses.label_placeholder") %>
                </div>
                <label class="flex items-center gap-1 mt-4 cursor-pointer text-xs text-stone-600 font-medium">
                  <%= check_box_tag "customer[addresses_attributes][][is_default]", "1", false,
                        class: "rounded border-stone-300 text-amber-600 focus:ring-amber-500" %>
                  <%= t("customers.addresses.default") %>
                </label>
              </div>
              <div>
                <%= label_tag "customer[addresses_attributes][][address]", t("customers.addresses.address"),
                      class: "block text-xs font-medium text-stone-500 mb-1" %>
                <%= text_area_tag "customer[addresses_attributes][][address]", nil,
                      rows: 2,
                      class: "w-full rounded-lg border border-stone-200 bg-white px-2.5 py-1.5 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400 resize-none" %>
              </div>
            </div>

            <button type="button"
                    onclick="document.getElementById('new-address-fields').classList.toggle('hidden')"
                    class="mt-2 text-xs font-semibold text-amber-700 hover:text-amber-900">
              + <%= t("customers.addresses.add") %>
            </button>
          </div>
        </div>

        <div class="flex justify-end gap-2 px-6 pb-6">
          <button type="button" onclick="document.getElementById('edit-customer-dialog').close()"
                  class="rounded-full px-5 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 transition-colors">
            <%= t("actions.cancel") %>
          </button>
          <%= f.submit t("actions.save"),
                class: "rounded-full px-5 py-2 text-sm font-medium bg-stone-800 text-white hover:bg-stone-700 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </dialog>
  <% else %>
    <div class="space-y-3"
         data-controller="pos-customer"
         data-pos-customer-search-url-value="<%= customers_search_path %>"
         data-pos-customer-open-create-value="<%= form_errors&.any? %>">
      <div>
        <label for="customer-search-input" class="<%= label_class %>"><%= t("pos.customer.search_label") %></label>
        <input id="customer-search-input"
               type="search"
               autocomplete="off"
               placeholder="<%= t("pos.customer.search_placeholder") %>"
               class="<%= pos_input_class %>"
               data-pos-customer-target="searchInput"
               data-action="input->pos-customer#search focus->pos-customer#showResults" />
      </div>
      <div class="hidden w-full rounded-xl border border-gray-200 bg-white shadow-lg overflow-hidden max-h-56 overflow-y-auto"
           data-pos-customer-target="resultsPanel">
        <%= turbo_frame_tag "customer_search_results", data: { pos_customer_target: "resultsFrame" } %>
      </div>

      <div>
        <button type="button"
                class="text-sm font-semibold text-amber-700 hover:text-amber-800"
                data-action="pos-customer#toggleCreateForm"
                data-pos-customer-target="createToggle"
                data-open-label="<%= t("pos.customer.create_new") %>"
                data-close-label="<%= t("pos.customer.cancel_create") %>">
          <%= t("pos.customer.create_new") %>
        </button>
        <div class="hidden mt-3 rounded-xl border border-gray-200 bg-gray-50/80 p-3 space-y-3"
             data-pos-customer-target="createForm">
          <% if form_errors&.any? %>
            <p class="text-sm text-red-700" role="alert"><%= form_errors.full_messages.to_sentence %></p>
          <% end %>
          <%= form_with url: pos_attach_customer_path,
                method: :patch,
                scope: :customer,
                data: { turbo_stream: true },
                class: "space-y-3" do |f| %>
            <div>
              <%= f.label :name, t("customers.form.name"), class: label_class %>
              <%= f.text_field :name, class: pos_input_class %>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <%= f.label :phone, t("customers.form.phone"), class: label_class %>
                <%= f.telephone_field :phone, class: pos_input_class, autocomplete: "tel" %>
              </div>
              <div>
                <%= f.label :phone_secondary, t("customers.form.phone_secondary"), class: label_class %>
                <%= f.telephone_field :phone_secondary, class: pos_input_class, autocomplete: "tel" %>
              </div>
            </div>
            <div>
              <%= f.label :email, t("customers.form.email"), class: label_class %>
              <%= f.email_field :email, class: pos_input_class, autocomplete: "email" %>
            </div>
            <div>
              <%= label_tag "customer[addresses_attributes][0][label]", t("customers.addresses.label"), class: label_class %>
              <%= text_field_tag "customer[addresses_attributes][0][label]", nil,
                    class: pos_input_class, placeholder: t("customers.addresses.label_placeholder") %>
            </div>
            <div>
              <%= label_tag "customer[addresses_attributes][0][address]", t("customers.addresses.address"), class: label_class %>
              <%= text_area_tag "customer[addresses_attributes][0][address]", nil, rows: 2, class: pos_input_class %>
            </div>
            <p class="text-xs text-gray-500"><%= t("pos.customer.create_hint") %></p>
            <%= f.submit t("pos.customer.attach_new"),
                  class: "w-full bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold py-2.5 rounded-xl transition-colors" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
