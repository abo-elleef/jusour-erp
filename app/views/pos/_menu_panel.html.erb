<% offer_items = @menu_items.select { |item| @promos_by_item_id&.[](item.id).present? } %>
<% offer_combos = @combos.select(&:highlighted_now?) %>
<% has_offers = offer_items.any? || offer_combos.any? %>

<div class="flex gap-2 px-4 py-3 border-b border-gray-200 bg-white overflow-x-auto shrink-0">
  <button type="button" class="<%= pos_category_pill_class(active: true) %>" data-action="pos#filterCategory" data-category="all"><%= t("actions.all") %></button>
  <% if has_offers %>
    <button type="button" class="<%= pos_category_pill_class %> border-rose-200 text-rose-800" data-action="pos#filterCategory" data-category="offers"><%= t("pos.categories.offers") %></button>
  <% end %>
  <% @categories.each do |cat| %>
    <button type="button" class="<%= pos_category_pill_class %>" data-action="pos#filterCategory" data-category="<%= cat.id %>"><%= cat.name %></button>
  <% end %>
  <% if @combos.any? %>
    <button type="button" class="<%= pos_category_pill_class %>" data-action="pos#filterCategory" data-category="combos"><%= t("pos.categories.combos") %></button>
  <% end %>
</div>

<div class="overflow-y-auto flex-1 touch-manipulation p-4 space-y-6" id="menu-scroll">
  <% if @pos_location.blank? %>
    <p class="text-center text-gray-500 py-16 text-sm"><%= t("pos.menu.select_branch") %></p>
  <% elsif @menu_items.empty? && @combos.empty? %>
    <p class="text-center text-gray-500 py-16 text-sm"><%= t("pos.menu.empty_at_branch", branch: @pos_location.name) %></p>
  <% else %>
    <% if has_offers %>
      <section data-pos-target="offersSection">
        <div class="mb-3">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.menu.offers") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.menu.offers_hint") %></p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3">
          <% offer_items.each do |item| %>
            <%= render "pos/menu_item_card",
                  item: item,
                  location: @pos_location,
                  promo: @promos_by_item_id[item.id],
                  category: "offers" %>
          <% end %>
          <% offer_combos.each do |combo| %>
            <%= render "pos/combo_card", combo: combo, category: "offers" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <section data-pos-target="menuGrid">
      <% if has_offers %>
        <h2 class="text-sm font-semibold text-gray-900 mb-3"><%= t("pos.menu.full_menu") %></h2>
      <% end %>
      <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3" id="menu-grid">
        <% @menu_items.each do |item| %>
          <%= render "pos/menu_item_card",
                item: item,
                location: @pos_location,
                promo: @promos_by_item_id&.[](item.id),
                category: item.category_id %>
        <% end %>
        <% @combos.each do |combo| %>
          <%= render "pos/combo_card", combo: combo, category: "combos" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
