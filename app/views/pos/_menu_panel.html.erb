<% offer_items = @menu_items.select { |item| @promos_by_item_id&.[](item.id).present? } %>
<% offer_combos = @combos.select(&:highlighted_now?) %>
<% has_offers = offer_items.any? || offer_combos.any? %>

<%# Categories: a vertical rail beside the items from md up, so every category
    is visible and always in the same spot (no sideways scrolling). On phones they
    wrap above the items instead, capped in height so the items stay visible. %>
<div class="flex flex-col md:flex-row flex-1 min-h-0" data-controller="pos-menu-search">
<nav class="flex flex-wrap gap-2 px-4 py-3 border-b border-gray-200 bg-white shrink-0 max-h-36 overflow-y-auto
            md:flex-col md:flex-nowrap md:w-44 md:max-h-none md:px-2 md:py-2 md:border-b-0 md:border-e"
     aria-label="<%= t("pos.categories.label") %>">
  <button type="button" class="<%= pos_category_pill_class(active: true) %> inline-flex items-center gap-2" data-action="pos#filterCategory pos-menu-search#categoryPicked" data-category="all"><kbd class="pos-key-hint !ms-0 shrink-0">0</kbd><%= t("actions.all") %></button>
  <%# Number keys 1–9 pick these in rail order (pos_shortcuts_controller#pickCategory). %>
  <% category_key = 0 %>
  <% key_hint = ->() { (category_key += 1) <= 9 ? tag.kbd(category_key, class: "pos-key-hint !ms-0 shrink-0") : nil } %>
  <% if has_offers %>
    <button type="button" class="<%= pos_category_pill_class %> border-rose-200 text-rose-800 inline-flex items-center gap-2" data-action="pos#filterCategory pos-menu-search#categoryPicked" data-category="offers"><%= key_hint.call %><%= t("pos.categories.offers") %></button>
  <% end %>
  <% @categories.each do |cat| %>
    <button type="button" class="<%= pos_category_pill_class %> inline-flex items-center gap-2" data-action="pos#filterCategory pos-menu-search#categoryPicked" data-category="<%= cat.id %>"><%= key_hint.call %><%= cat.name %></button>
  <% end %>
  <% if @combos.any? %>
    <button type="button" class="<%= pos_category_pill_class %> inline-flex items-center gap-2" data-action="pos#filterCategory pos-menu-search#categoryPicked" data-category="combos"><%= key_hint.call %><%= t("pos.categories.combos") %></button>
  <% end %>
</nav>

<div class="overflow-y-auto flex-1 touch-manipulation p-4 space-y-6" id="menu-scroll">
  <% if @pos_location.present? && (@menu_items.any? || @combos.any?) %>
    <%# Keyboard path to an item: F2 or / focuses this box; see pos_menu_search_controller. %>
    <div class="sticky -top-4 z-10 -mx-4 -mt-4 px-4 pt-4 pb-2 bg-gray-50">
      <label class="relative block">
        <span class="sr-only"><%= t("pos.menu.search_label") %></span>
        <svg class="pointer-events-none absolute start-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.5-3.5"/></svg>
        <input type="search" autocomplete="off" spellcheck="false" enterkeyhint="go"
               placeholder="<%= t("pos.menu.search_placeholder") %>"
               class="<%= pos_input_class %> ps-9 pe-14"
               data-pos-menu-search-target="input"
               data-action="input->pos-menu-search#search keydown->pos-menu-search#keydown">
        <kbd class="pos-key-hint absolute end-3 top-1/2 -translate-y-1/2">F2</kbd>
      </label>
      <p class="hidden mt-3 text-center text-sm text-gray-500" data-pos-menu-search-target="empty"><%= t("pos.menu.search_empty") %></p>
    </div>
  <% end %>
  <% if @pos_location.blank? %>
    <p class="text-center text-gray-500 py-16 text-sm"><%= t("pos.menu.select_branch") %></p>
  <% elsif @menu_items.empty? && @combos.empty? %>
    <p class="text-center text-gray-500 py-16 text-sm"><%= t("pos.menu.empty_at_branch", branch: @pos_location.name) %></p>
  <% else %>
    <% if @top_seller_items.present? %>
      <%# Shown in "All" only (pos#filterCategory) and hidden while searching
          (pos-menu-search), since its cards repeat ones in the full menu. %>
      <section data-pos-target="topSellersSection">
        <div class="mb-3">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.menu.top_sellers") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.menu.top_sellers_hint") %></p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 2xl:grid-cols-6 gap-3">
          <% @top_seller_items.each do |item| %>
            <%= render "pos/menu_item_card",
                  item: item,
                  location: @pos_location,
                  promo: @promos_by_item_id&.[](item.id),
                  category: "top" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if has_offers %>
      <section data-pos-target="offersSection">
        <div class="mb-3">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.menu.offers") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.menu.offers_hint") %></p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 2xl:grid-cols-6 gap-3">
          <% offer_items.each do |item| %>
            <%= render "pos/menu_item_card",
                  item: item,
                  location: @pos_location,
                  promo: @promos_by_item_id[item.id],
                  category: "offers" %>
          <% end %>
          <% offer_combos.each do |combo| %>
            <%= render "pos/combo_card", combo: combo, category: "offers" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <section data-pos-target="menuGrid">
      <% if has_offers || @top_seller_items.present? %>
        <h2 class="text-sm font-semibold text-gray-900 mb-3"><%= t("pos.menu.full_menu") %></h2>
      <% end %>
      <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 2xl:grid-cols-6 gap-3" id="menu-grid">
        <% @menu_items.each do |item| %>
          <%= render "pos/menu_item_card",
                item: item,
                location: @pos_location,
                promo: @promos_by_item_id&.[](item.id),
                category: item.category_id %>
        <% end %>
        <% @combos.each do |combo| %>
          <%= render "pos/combo_card", combo: combo, category: "combos" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
</div>
