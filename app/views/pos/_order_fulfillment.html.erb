<div id="order-fulfillment" class="<%= local_assigns[:embedded] ? "px-4 pb-4" : "px-5 py-4 border-b border-stone-200/80 shrink-0 bg-white" %>" data-controller="order-type">
  <%= form_with url: pos_update_fulfillment_path, method: :patch, data: { turbo_stream: true, order_type_target: "form" } do |f| %>
    <% unless local_assigns[:embedded] %>
    <p class="text-xs font-medium uppercase tracking-wider text-stone-500 mb-2"><%= t("order.labels.order_type") %></p>
    <% end %>
    <div class="flex p-1 rounded-full bg-stone-200/70 text-sm font-medium">
      <% Order::ORDER_TYPES.each do |type| %>
        <label class="flex-1 text-center cursor-pointer min-w-0">
          <%= f.radio_button :order_type, type,
                checked: order.order_type == type,
                class: "sr-only peer",
                data: { action: "order-type#selectType" } %>
          <span class="block py-2 px-1 rounded-full transition-all duration-200 text-stone-600 hover:bg-white/80 hover:text-stone-900 peer-checked:bg-white peer-checked:shadow-sm peer-checked:text-stone-900 peer-checked:hover:bg-white peer-checked:hover:text-stone-900 <%= order.order_type == type ? 'bg-white shadow-sm text-stone-900' : '' %>">
            <%= order_type_label(type) %>
          </span>
        </label>
      <% end %>
    </div>

    <div class="mt-3 <%= 'hidden' unless order.table? %>" data-order-type-target="tableFields">
      <%= f.label :table_number, t("order.labels.table_number"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <% table_count = (order.location || @pos_location)&.table_count %>
      <%# Busy tables are greyed out with the order that holds them — table-service branches only. %>
      <% busy_tables = Order.busy_tables(order.location || @pos_location) %>
      <% if table_count.present? %>
        <%# One tap picks the table — no typing during a rush. %>
        <div class="grid grid-cols-5 gap-1.5 max-h-48 overflow-y-auto">
          <% (1..table_count).each do |n| %>
            <% holder = busy_tables[n.to_s] %>
            <% busy = holder.present? && holder.id != order.id %>
            <%= tag.label class: (busy ? "cursor-not-allowed" : "cursor-pointer"), title: (busy ? t("pos.tables.busy_hint", number: holder.order_number) : nil) do %>
              <%= f.radio_button :table_number, n, checked: order.table_number.to_s == n.to_s, disabled: busy, class: "sr-only peer",
                    data: { action: "change->order-type#submitForm" } %>
              <% if busy %>
                <span class="block text-center py-1.5 rounded-xl border border-red-200 bg-red-50 text-red-800 tabular-nums leading-tight">
                  <span class="block text-sm font-semibold"><%= n %></span>
                  <span class="block text-[10px]">#<%= holder.order_number %></span>
                </span>
              <% else %>
                <span class="block text-center py-2.5 rounded-xl border border-stone-200 bg-white text-sm font-semibold text-stone-700 tabular-nums transition peer-checked:bg-stone-900 peer-checked:text-white peer-checked:border-stone-900 hover:bg-stone-100 peer-checked:hover:bg-stone-900"><%= n %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <%= f.text_field :table_number,
              placeholder: "12",
              class: pos_input_class,
              data: { action: "blur->order-type#submitForm" } %>
      <% end %>
    </div>

    <div class="mt-3 <%= 'hidden' unless order.delivery? %>" data-order-type-target="deliveryFields">
      <% if order.customer.present? %>
        <% saved_addresses = order.customer.addresses.ordered.to_a %>
        <% if saved_addresses.any? %>
          <div class="mb-3">
            <%= label_tag :saved_delivery_address, t("pos.delivery.saved_addresses"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <%= select_tag :saved_delivery_address,
                  options_for_select(
                    [[t("pos.delivery.custom_address"), ""]] + saved_addresses.map { |a| [a.display_label, a.address] },
                    order.delivery_address.presence
                  ),
                  class: "#{pos_input_class} appearance-none",
                  data: { order_type_target: "addressSelect", action: "change->order-type#applySavedAddress" } %>
          </div>
        <% end %>
        <%= f.label :delivery_address, t("order.labels.delivery_address"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= f.text_area :delivery_address,
              value: order.delivery_address,
              rows: 2,
              class: pos_input_class,
              data: { order_type_target: "deliveryAddress", action: "blur->order-type#submitForm" } %>
      <% else %>
        <p class="text-xs text-amber-700 bg-amber-50 rounded-xl px-3 py-2">
          <%= t("pos.delivery.customer_required_for_delivery") %>
        </p>
      <% end %>
    </div>

    <% if order.errors.any? %>
      <p class="text-red-700 text-xs font-medium mt-2"><%= order.errors.full_messages.to_sentence %></p>
    <% end %>
  <% end %>
</div>
