<%# locals: order, customer_form_errors: nil, open_customer_dialog: false, edit_customer_errors: nil %>
<% customer_form_errors = local_assigns[:customer_form_errors] %>
<% edit_customer_errors = local_assigns[:edit_customer_errors] %>
<% open_customer_dialog = local_assigns[:open_customer_dialog] || customer_form_errors&.any? || edit_customer_errors&.any? %>

<div id="cart-meta-strip">
  <%# ── Compact chips row ───────────────────────────────────────────────── %>
  <div class="shrink-0 bg-white border-b border-stone-200/80 px-3 py-2 flex items-center gap-2 flex-wrap">

    <%# Customer chip %>
    <button type="button"
            onclick="document.getElementById('customer-dialog').showModal()"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors
                   <%= order.customer ? 'bg-amber-50 border-amber-200 text-amber-900 hover:bg-amber-100' : 'bg-stone-100 border-stone-200 text-stone-600 hover:bg-stone-200' %>">
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      <span class="max-w-[9rem] truncate">
        <%= order.customer ? order.customer.display_name : t("pos.cart.walk_in") %>
      </span>
      <% if order.customer&.loyalty_points.to_i.positive? %>
        <span class="text-amber-700 font-semibold">· <%= order.customer.loyalty_points %>pts</span>
      <% end %>
    </button>

    <%# Order-type chip %>
    <button type="button"
            onclick="document.getElementById('fulfillment-dialog').showModal()"
            class="flex items-center gap-1.5 rounded-full border bg-stone-100 border-stone-200 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-200 transition-colors">
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <span id="fulfillment-chip-label"><%= order.fulfillment_summary %></span>
    </button>

    <%# Order-note chip %>
    <button type="button"
            onclick="document.getElementById('order-notes-dialog').showModal()"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors
                   <%= order.notes.present? ? 'bg-amber-50 border-amber-200 text-amber-900 hover:bg-amber-100' : 'bg-stone-100 border-stone-200 text-stone-500 hover:bg-stone-200' %>">
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
      </svg>
      <span class="max-w-[8rem] truncate">
        <%= order.notes.present? ? order.notes : t("pos.cart.add_order_note") %>
      </span>
    </button>
  </div>

  <%# ── Customer dialog ───────────────────────────────────────────────────── %>
  <dialog id="customer-dialog"
          class="m-auto rounded-[28px] shadow-2xl border-0 p-0 w-[26rem] max-w-[95vw] max-h-[90vh] overflow-y-auto backdrop:bg-black/50 backdrop:backdrop-blur-sm"
          <%= "open" if open_customer_dialog %>
          onclick="if(event.target===this)this.close()">
    <div class="px-6 pt-6 pb-4 border-b border-stone-100 flex items-center justify-between sticky top-0 bg-white z-10">
      <h3 class="text-base font-semibold text-stone-900"><%= t("order.labels.customer") %></h3>
      <button type="button" onclick="document.getElementById('customer-dialog').close()"
              class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 text-stone-500 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <%= render "pos/order_customer", order: order,
          customer_form_errors: customer_form_errors,
          edit_customer_errors: edit_customer_errors,
          embedded: true %>
  </dialog>

  <%# ── Fulfillment dialog ─────────────────────────────────────────────────── %>
  <dialog id="fulfillment-dialog"
          class="m-auto rounded-[28px] shadow-2xl border-0 p-0 w-[22rem] max-w-[95vw] backdrop:bg-black/50 backdrop:backdrop-blur-sm"
          onclick="if(event.target===this)this.close()">
    <div class="px-6 pt-6 pb-4 border-b border-stone-100 flex items-center justify-between">
      <h3 class="text-base font-semibold text-stone-900"><%= t("order.labels.order_type") %></h3>
      <button type="button" onclick="document.getElementById('fulfillment-dialog').close()"
              class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 text-stone-500 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="fulfillment-dialog-body" class="px-2 py-4">
      <%= render "pos/order_fulfillment", order: order, embedded: true %>
    </div>
    <div class="flex justify-end px-6 pb-6">
      <button type="button" onclick="document.getElementById('fulfillment-dialog').close()"
              class="rounded-full px-5 py-2 text-sm font-medium bg-stone-800 text-white hover:bg-stone-700 transition-colors">
        <%= t("actions.done") %>
      </button>
    </div>
  </dialog>

  <%# ── Order notes dialog ─────────────────────────────────────────────────── %>
  <dialog id="order-notes-dialog"
          class="m-auto rounded-[28px] shadow-2xl border-0 p-0 w-[22rem] max-w-[95vw] backdrop:bg-black/50 backdrop:backdrop-blur-sm"
          onclick="if(event.target===this)this.close()">
    <div class="px-6 pt-6 pb-4 border-b border-stone-100 flex items-center justify-between">
      <div>
        <h3 class="text-base font-semibold text-stone-900"><%= t("pos.cart.order_notes") %></h3>
        <p class="text-sm text-stone-500 mt-0.5"><%= t("pos.cart.order_notes_hint") %></p>
      </div>
      <button type="button" onclick="document.getElementById('order-notes-dialog').close()"
              class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 text-stone-500 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <%= form_with url: pos_update_notes_path, method: :patch,
          data: { turbo_stream: true },
          onsubmit: "document.getElementById('order-notes-dialog').close()" do |f| %>
      <div class="px-6 py-4">
        <%= f.text_area :notes, value: order.notes,
              placeholder: t("pos.cart.notes_placeholder"),
              rows: 3,
              autofocus: true,
              class: "w-full rounded-2xl border border-stone-300 bg-stone-50 px-4 py-3 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-500 resize-none" %>
      </div>
      <div class="flex justify-end gap-2 px-6 pb-6">
        <button type="button" onclick="document.getElementById('order-notes-dialog').close()"
                class="rounded-full px-5 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 transition-colors">
          <%= t("actions.cancel") %>
        </button>
        <%= f.submit t("actions.save"),
              class: "rounded-full px-5 py-2 text-sm font-medium bg-stone-800 text-white hover:bg-stone-700 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </dialog>
</div>
