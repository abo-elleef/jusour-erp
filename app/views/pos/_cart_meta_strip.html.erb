<%# locals: order, customer_form_errors: nil, edit_customer_errors: nil %>
<% customer_form_errors = local_assigns[:customer_form_errors] %>
<% edit_customer_errors = local_assigns[:edit_customer_errors] %>

<%# One side drawer holds customer, order type and notes together, because they are
    one question — who is this for and how does it leave — not three. The <dialog>
    is rendered once and never replaced: Turbo updates the section bodies inside it,
    so it stays open, keeps its backdrop, and needs no re-open hack after an error. %>
<div id="cart-meta-strip">
  <%# ── Chips: the state at a glance, and three doors into the same drawer ── %>
  <%= render "pos/cart_chips", order: order %>

  <%# ── The drawer ───────────────────────────────────────────────────────────
      Anchored to the inline end with logical margins, so it comes from the right
      in English and the left in Arabic without a second rule. h-full + max-h-none
      overrides the UA dialog sizing. %>
  <dialog id="order-details-drawer"
          class="fixed top-0 bottom-0 ms-auto me-0 m-0 p-0 h-full max-h-none w-[30rem] max-w-[95vw]
                 rounded-none border-0 shadow-2xl bg-white
                 backdrop:bg-black/50 backdrop:backdrop-blur-sm"
          onclick="if(event.target===this)this.close()">
    <div class="flex h-full flex-col">
      <div class="px-5 py-4 border-b border-stone-200 flex items-center justify-between shrink-0">
        <h3 class="text-base font-semibold text-stone-900"><%= t("pos.cart.order_details") %></h3>
        <button type="button" onclick="document.getElementById('order-details-drawer').close()"
                class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-stone-100 text-stone-500 transition-colors"
                aria-label="<%= t('actions.close') %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain">
        <section id="drawer-customer" class="scroll-mt-2 border-b border-stone-200/80 py-4">
          <h4 class="px-4 pb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">
            <%= t("order.labels.customer") %>
          </h4>
          <div id="drawer-customer-body">
            <%= render "pos/order_customer", order: order,
                  customer_form_errors: customer_form_errors,
                  edit_customer_errors: edit_customer_errors,
                  embedded: true %>
          </div>
        </section>

        <section id="drawer-fulfillment" class="scroll-mt-2 border-b border-stone-200/80 py-4">
          <h4 class="px-4 pb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">
            <%= t("order.labels.order_type") %>
          </h4>
          <div id="drawer-fulfillment-body" class="px-2">
            <%= render "pos/order_fulfillment", order: order, embedded: true %>
          </div>
        </section>

        <section id="drawer-notes" class="scroll-mt-2 py-4">
          <h4 class="px-4 pb-1 text-xs font-semibold uppercase tracking-wide text-stone-500">
            <%= t("pos.cart.order_notes") %>
          </h4>
          <p class="px-4 pb-2 text-xs text-stone-500"><%= t("pos.cart.order_notes_hint") %></p>
          <div id="drawer-notes-body" class="px-4">
            <%= render "pos/order_notes_form", order: order %>
          </div>
        </section>
      </div>
    </div>
  </dialog>
</div>

<script>
  // Defined next to the drawer it opens. The strip is never replaced by a Turbo
  // Stream any more, so this runs once on load and keeps working.
  window.openOrderDrawer = function (sectionId) {
    var drawer = document.getElementById('order-details-drawer');
    if (!drawer) return;
    if (!drawer.open) drawer.showModal();
    var section = sectionId && document.getElementById(sectionId);
    if (section) section.scrollIntoView({ block: 'start' });
  };
</script>
