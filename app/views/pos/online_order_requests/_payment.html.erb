<%# How the customer pays, and for a prepaid request the screenshot they sent.
    Shared by the POS request page and the admin online-order page. %>
<section class="rounded-2xl border <%= request.prepaid? ? "border-emerald-300" : "border-gray-200" %> bg-white p-5">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.online_orders.payment.title") %></h2>
    <p class="text-sm">
      <span class="font-bold text-gray-900"><%= t("payment.methods.#{request.payment_method}") %></span>
      <span class="ms-1 rounded-full px-2 py-0.5 text-xs font-semibold <%= request.prepaid? ? "bg-emerald-100 text-emerald-800" : "bg-gray-100 text-gray-700" %>">
        <%= t(request.prepaid? ? "pos.online_orders.payment.prepaid" : "pos.online_orders.payment.on_receipt") %>
      </span>
    </p>
  </div>
  <% if request.prepaid? %>
    <% if request.pending? || request.accepted? %>
      <p class="mt-2 text-sm text-gray-600">
        <%= t(request.pending? ? "pos.online_orders.payment.check_proof" : "pos.online_orders.payment.recorded") %>
      </p>
    <% end %>
    <% if request.payment_proof_image.attached? %>
      <%= link_to url_for(request.payment_proof_image), target: "_blank", rel: "noopener", class: "mt-3 block" do %>
        <%= image_tag request.payment_proof_image, alt: t("public.online_order.payment.proof_label"),
              class: "max-h-[28rem] w-full rounded-xl border border-gray-200 bg-gray-50 object-contain" %>
        <span class="mt-1 block text-xs font-semibold text-amber-700"><%= t("pos.online_orders.payment.open_full") %></span>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm font-semibold text-rose-700"><%= t("pos.online_orders.payment.no_proof") %></p>
    <% end %>
  <% end %>
</section>
