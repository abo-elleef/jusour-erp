<div class="<%= pos_viewport_h_class %> bg-gray-100 flex flex-col overflow-hidden">
  <header class="flex items-center justify-between gap-3 px-5 py-3 border-b border-gray-200 bg-white shrink-0">
    <%= link_to pos_online_order_requests_path, class: "inline-flex items-center gap-1 text-sm font-semibold text-gray-700 hover:text-gray-900" do %><span aria-hidden="true" class="rtl:rotate-180">←</span><span class="truncate"><%= t("pos.online_orders.title") %></span><% end %>
    <%= render "pos/pos_nav" %>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto">
    <div class="p-5 pb-28 max-w-3xl mx-auto w-full space-y-4">
      <section class="rounded-2xl border border-gray-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-lg font-bold text-gray-900">
              <% if @customer %><%= link_to @request.customer_name, admin_customer_path(@customer), class: "hover:underline" %><% else %><%= @request.customer_name %><% end %>
            </p>
            <% if @check.name_mismatch? %>
              <p class="text-xs font-semibold text-orange-700"><%= t("pos.online_orders.check.typed_name") %></p>
            <% end %>
            <a href="tel:<%= @request.phone %>" class="text-base font-semibold text-amber-800 tabular-nums" dir="ltr"><%= @request.phone %></a>
          </div>
          <div class="text-end text-sm text-gray-600">
            <p class="font-semibold text-gray-900"><%= order_type_label(@request.fulfillment) %></p>
            <p><%= t("pos.online_orders.ago", time: time_ago_in_words(@request.created_at)) %></p>
          </div>
        </div>
        <% if @request.delivery? %>
          <p class="mt-3 rounded-lg bg-gray-50 px-3 py-2 text-sm"><span class="font-semibold"><%= @request.delivery_area&.display_name %>:</span> <%= @request.address %></p>
        <% end %>
        <% if @request.note.present? %>
          <p class="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900"><%= @request.note %></p>
        <% end %>
      </section>

      <% unless @request.pending? %>
        <%= render "pos/online_order_requests/timeline", request: @request, order_link: ->(order) { pos_order_path(order) } %>
      <% end %>

      <% if @check.is_a?(OnlineOrders::CustomerCheck::Snapshot) %>
        <%= render "pos/online_order_requests/customer_check", check: @check,
              note: t("pos.online_orders.story.check_as_decided", time: l(@check.taken_at, format: :ticket)) %>
      <% elsif !@request.pending? %>
        <%= render "pos/online_order_requests/customer_check", check: @check, note: t("pos.online_orders.story.check_now") %>
      <% else %>
        <%= render "pos/online_order_requests/customer_check", check: @check %>
      <% end %>

      <section class="rounded-2xl border border-gray-200 bg-white p-5">
        <ul class="divide-y divide-gray-100">
          <% @request.lines.each do |line| %>
            <li class="flex justify-between gap-3 py-2.5">
              <div>
                <p class="font-semibold text-gray-900"><%= line["quantity"] %> × <%= line["name"] %></p>
                <% extra = [Array(line["modifiers"]).map { |m| m["name"] }.join("، ").presence, line["notes"]].compact %>
                <% if extra.any? %><p class="text-sm text-gray-500"><%= extra.join(" — ") %></p><% end %>
              </div>
              <span class="tabular-nums"><%= format_money(line["line_total_cents"].to_i - line["discount_cents"].to_i) %></span>
            </li>
          <% end %>
        </ul>
        <dl class="mt-3 space-y-1 border-t border-gray-200 pt-3 text-sm">
          <% if @request.delivery? %>
            <div class="flex justify-between"><dt class="text-gray-600"><%= t("public.online_order.delivery_fee") %></dt><dd class="tabular-nums"><%= format_money(@request.delivery_fee_cents) %></dd></div>
          <% end %>
          <div class="flex justify-between text-lg font-bold"><dt><%= t("public.online_order.total") %></dt><dd class="tabular-nums"><%= format_money(@request.total_cents) %></dd></div>
        </dl>
      </section>

      <%= render "pos/online_order_requests/payment", request: @request %>

      <% if @request.pending? && !@request.overdue? %>
        <div class="grid gap-3 sm:grid-cols-2">
          <%= form_with url: accept_pos_online_order_request_path(@request), method: :patch, data: { controller: "submit-once" } do %>
            <% if params[:new_total].present? %>
              <p class="mb-2 rounded-xl bg-amber-100 px-3 py-2 text-sm font-semibold text-amber-900">
                <%= t("pos.online_orders.price_changed", total: format_money(params[:new_total].to_i)) %>
              </p>
              <% if @request.prepaid? %>
                <p class="mb-2 rounded-xl bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-800">
                  <%= t("pos.online_orders.payment.prepaid_price_changed", sent: format_money(@request.quote.fetch("total_cents", @request.total_cents))) %>
                </p>
              <% end %>
              <%= hidden_field_tag :confirm_price_change, "1" %>
            <% end %>
            <button type="submit" class="h-14 w-full rounded-2xl bg-emerald-600 text-base font-bold text-white hover:bg-emerald-700">
              <%= t(params[:new_total].present? ? "pos.online_orders.accept_new_total" : "pos.online_orders.accept") %>
            </button>
          <% end %>

          <details class="rounded-2xl border border-rose-200 bg-white">
            <summary class="flex h-14 cursor-pointer items-center justify-center rounded-2xl text-base font-bold text-rose-700 hover:bg-rose-50"><%= t("pos.online_orders.reject") %></summary>
            <%= form_with url: reject_pos_online_order_request_path(@request), method: :patch, class: "space-y-3 p-4" do %>
              <div class="space-y-1.5">
                <% OnlineOrderRequest::REJECT_REASONS.each_with_index do |reason, i| %>
                  <label class="flex items-center gap-2 text-sm"><%= radio_button_tag :reason, reason, i.zero? %> <%= t("pos.online_orders.reasons.#{reason}") %></label>
                <% end %>
              </div>
              <%= text_area_tag :note, nil, rows: 2, maxlength: 500, placeholder: t("pos.online_orders.reject_note_placeholder"),
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-rose-400 focus:outline-none focus:ring-2 focus:ring-rose-200" %>
              <label class="flex items-center gap-2 rounded-lg bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-800">
                <%= check_box_tag :block, "1", false %> <%= t("pos.online_orders.block_phone") %>
              </label>
              <button type="submit" class="h-11 w-full rounded-xl bg-rose-600 text-sm font-bold text-white hover:bg-rose-700"><%= t("pos.online_orders.confirm_reject") %></button>
            <% end %>
          </details>
        </div>
      <% elsif @request.order %>
        <%= link_to t("pos.online_orders.open_order", number: @request.order.order_number), pos_order_path(@request.order),
              class: "block rounded-2xl bg-gray-900 py-4 text-center font-bold text-white" %>
      <% elsif @request.pending? %>
        <p class="rounded-2xl bg-gray-200 px-4 py-3 text-center text-sm font-semibold text-gray-700"><%= t("pos.online_orders.statuses.expired") %></p>
      <% end %>
    </div>
  </div>
</div>
