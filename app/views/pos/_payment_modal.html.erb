<% total = order.total_cents || 0 %>
<% due = order.amount_due_cents %>
<div class="bg-white rounded-xl p-6 w-full max-w-md text-black max-h-[90vh] overflow-y-auto<%= ' shadow-lg' if local_assigns[:checkout] %>" data-controller="payment" data-payment-order-total-value="<%= total %>">
  <div class="flex justify-between items-center mb-4">
    <h3 class="text-xl font-bold">Payment</h3>
    <% if local_assigns[:checkout] %>
      <%= link_to "Cancel", pos_orders_path(order_type: order.order_type), class: "text-gray-500 hover:text-gray-800 text-sm" %>
    <% else %>
      <button type="button" class="text-gray-500 hover:text-gray-800 text-2xl leading-none" data-action="pos#closePayment" aria-label="Close">×</button>
    <% end %>
  </div>
  <p class="text-2xl font-bold text-green-700 mb-4"><%= format_money(due) %> due</p>

  <div class="flex gap-2 mb-4">
    <% [15, 18, 20].each do |pct| %>
      <button type="button" class="flex-1 border rounded-lg py-2 hover:bg-gray-50" data-action="payment#setTip" data-percent="<%= pct %>"><%= pct %>%</button>
    <% end %>
  </div>
  <%= number_field_tag :tip_cents, order.tip_cents, class: "w-full border rounded-lg px-3 py-2 mb-4", data: { payment_target: "tipInput" } %>

  <%= form_with url: pos_payments_path, method: :post, class: "space-y-3" do %>
    <%= hidden_field_tag :order_id, order.id %>
    <%= hidden_field_tag :tip_cents, order.tip_cents, data: { payment_target: "tipHidden" } %>
    <div class="bg-gray-50 rounded-lg p-3">
      <label class="block text-sm font-medium mb-1">Cash tendered (cents)</label>
      <%= number_field_tag :amount_cents, due, min: 0, class: "w-full border rounded-lg px-3 py-2" %>
      <%= hidden_field_tag :payment_method, "cash" %>
      <%= submit_tag "Pay Cash", class: "w-full mt-2 bg-green-600 hover:bg-green-700 text-white py-2 rounded-lg font-medium" %>
    </div>
  <% end %>

  <button type="button" class="w-full mt-3 bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg font-medium" data-action="payment#payCard">
    Pay Card (Terminal)
  </button>

  <div class="mt-4 bg-gray-50 rounded-lg p-3">
    <label class="block text-sm font-medium mb-1">Gift card code</label>
    <%= form_with url: pos_payments_path, method: :post, class: "flex gap-2" do %>
      <%= hidden_field_tag :order_id, order.id %>
      <%= text_field_tag :gift_card_code, nil, class: "flex-1 border rounded-lg px-2 py-1.5" %>
      <%= hidden_field_tag :payment_method, "gift_card" %>
      <%= hidden_field_tag :amount_cents, due %>
      <%= submit_tag "Redeem", class: "bg-purple-600 hover:bg-purple-700 text-white px-3 rounded-lg" %>
    <% end %>
  </div>

  <p class="text-xs text-gray-500 mt-4" data-payment-target="terminalStatus"></p>
</div>
