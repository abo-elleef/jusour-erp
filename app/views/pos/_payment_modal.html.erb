<% total = order.total_cents || 0 %>
<% due = order.amount_due_cents %>
<% staff_users = local_assigns.fetch(:staff_users) { User.active.order(:name) } %>
<div class="bg-white rounded-2xl border border-gray-200 p-6 w-full max-w-md max-h-[90vh] overflow-y-auto text-gray-900"
     data-controller="payment" data-payment-order-total-value="<%= total %>">
  <div class="flex justify-between items-center mb-4">
    <h3 class="text-xl font-bold tracking-tight text-gray-900"><%= t("payment.title") %></h3>
    <% if local_assigns[:checkout] %>
      <%= link_to t("actions.cancel"), pos_orders_path(order_type: order.order_type),
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-xl hover:bg-gray-100 transition-colors" %>
    <% else %>
      <button type="button" class="text-gray-500 hover:text-gray-900 text-2xl leading-none w-10 h-10 rounded-xl hover:bg-gray-100 transition-colors" data-action="pos#closePayment" aria-label="<%= t('actions.close') %>">×</button>
    <% end %>
  </div>
  <p class="text-2xl font-bold text-green-700 mb-4 tabular-nums" data-payment-due><%= t("payment.due", amount: format_money(due)) %></p>

  <%# Tips hidden — not accepted currently %>

  <%= form_with url: pos_payments_path, method: :post, class: "space-y-3",
        data: { action: "submit->payment#submitCash" } do %>
    <%= hidden_field_tag :order_id, order.id %>
    <%= hidden_field_tag :tip_cents, order.tip_cents, data: { payment_target: "tipHidden" } %>
    <section class="rounded-2xl border border-gray-200 bg-gray-50/80 p-4">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("payment.cash_tendered") %></label>
      <%= number_field_tag :amount_pounds, (due / 100.0), min: 0, step: "0.01", class: "#{pos_input_class} text-2xl text-center min-h-14" %>
      <%= hidden_field_tag :payment_method, "cash" %>
      <%= submit_tag t("payment.pay_cash"), class: "w-full mt-3 min-h-11 bg-green-700 hover:bg-green-800 text-white py-2.5 rounded-xl font-semibold transition-colors" %>
    </section>
  <% end %>

  <%= form_with url: pos_payments_path, method: :post, class: "mt-3" do %>
    <%= hidden_field_tag :order_id, order.id %>
    <%= hidden_field_tag :tip_cents, order.tip_cents, data: { payment_target: "tipHidden" } %>
    <section class="rounded-2xl border border-purple-200 bg-purple-50/60 p-4">
      <label class="block text-xs font-semibold text-purple-700 mb-1.5"><%= t("payment.instapay_amount") %></label>
      <%= number_field_tag :amount_pounds, (due / 100.0), min: 0, step: "0.01", class: "#{pos_input_class} text-2xl text-center min-h-14" %>
      <%= hidden_field_tag :payment_method, "instapay" %>
      <%= submit_tag t("payment.pay_instapay"), class: "w-full mt-3 min-h-11 bg-purple-700 hover:bg-purple-800 text-white py-2.5 rounded-xl font-semibold transition-colors" %>
    </section>
  <% end %>

  <%= form_with url: pos_payments_path, method: :post, class: "mt-3" do %>
    <%= hidden_field_tag :order_id, order.id %>
    <%= hidden_field_tag :tip_cents, order.tip_cents, data: { payment_target: "tipHidden" } %>
    <section class="rounded-2xl border border-red-200 bg-red-50/60 p-4">
      <label class="block text-xs font-semibold text-red-700 mb-1.5"><%= t("payment.vodafone_cash_amount") %></label>
      <%= number_field_tag :amount_pounds, (due / 100.0), min: 0, step: "0.01", class: "#{pos_input_class} text-2xl text-center min-h-14" %>
      <%= hidden_field_tag :payment_method, "vodafone_cash" %>
      <%= submit_tag t("payment.pay_vodafone_cash"), class: "w-full mt-3 min-h-11 bg-red-600 hover:bg-red-700 text-white py-2.5 rounded-xl font-semibold transition-colors" %>
    </section>
  <% end %>

  <% if staff_users.present? %>
    <% default_treasury = Treasury.default_treasury %>
    <%= form_with url: pos_payments_path, method: :post, class: "mt-3" do %>
      <%= hidden_field_tag :order_id, order.id %>
      <%= hidden_field_tag :payment_method, "staff_deduction" %>
      <section class="rounded-2xl border border-orange-200 bg-orange-50/60 p-4 space-y-3">
        <p class="text-xs font-semibold text-orange-700 uppercase"><%= t("payment.staff_meal") %></p>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("payment.staff_meal_member") %></label>
          <%= select_tag :staff_meal_user_id,
                options_from_collection_for_select(staff_users, :id, :name),
                include_blank: t("payment.select_staff_member"),
                class: "#{pos_input_class} appearance-none w-full", required: true %>
        </div>
        <p class="text-sm text-gray-600">
          <%= t("payment.staff_meal_amount") %>:
          <strong class="tabular-nums"><%= format_money(order.total_cents) %></strong>
        </p>
        <% if default_treasury %>
          <p class="text-xs text-orange-700">
            <%= t("payment.staff_meal_from_treasury", name: default_treasury.name) %>
          </p>
        <% end %>
        <%= submit_tag t("payment.pay_staff_meal"), class: "w-full min-h-11 bg-orange-600 hover:bg-orange-700 text-white py-2.5 rounded-xl font-semibold transition-colors" %>
      </section>
    <% end %>
  <% end %>

  <%# Card terminal and gift card hidden — not used currently %>
  <p class="text-xs text-gray-500 mt-4" data-payment-target="terminalStatus"></p>
</div>
