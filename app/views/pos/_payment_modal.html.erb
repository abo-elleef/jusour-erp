<% total = order.total_cents || 0 %>
<% due = order.amount_due_cents %>
<div class="bg-white rounded-2xl border border-gray-200 p-6 w-full max-w-md max-h-[90vh] overflow-y-auto text-gray-900"
     data-controller="payment" data-payment-order-total-value="<%= total %>">
  <div class="flex justify-between items-center mb-4">
    <h3 class="text-xl font-bold tracking-tight text-gray-900"><%= t("payment.title") %></h3>
    <% if local_assigns[:checkout] %>
      <%= link_to t("actions.cancel"), pos_orders_path(order_type: order.order_type),
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-xl hover:bg-gray-100 transition-colors" %>
    <% else %>
      <button type="button" class="text-gray-500 hover:text-gray-900 text-2xl leading-none w-10 h-10 rounded-xl hover:bg-gray-100 transition-colors" data-action="pos#closePayment" aria-label="<%= t('actions.close') %>">×</button>
    <% end %>
  </div>
  <p class="text-2xl font-bold text-green-700 mb-4 tabular-nums"><%= t("payment.due", amount: format_money(due)) %></p>

  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2"><%= t("payment.tip") %></p>
  <div class="flex gap-2 mb-3">
    <% [15, 18, 20].each do |pct| %>
      <button type="button" class="flex-1 border border-gray-200 rounded-xl py-2.5 text-sm font-semibold hover:bg-gray-50 transition-colors" data-action="payment#setTip" data-percent="<%= pct %>"><%= pct %>%</button>
    <% end %>
  </div>
  <%= number_field_tag :tip_cents, order.tip_cents, class: "#{pos_input_class} mb-4", data: { payment_target: "tipInput" } %>

  <%= form_with url: pos_payments_path, method: :post, class: "space-y-3" do %>
    <%= hidden_field_tag :order_id, order.id %>
    <%= hidden_field_tag :tip_cents, order.tip_cents, data: { payment_target: "tipHidden" } %>
    <section class="rounded-2xl border border-gray-200 bg-gray-50/80 p-4">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("payment.cash_tendered") %></label>
      <%= number_field_tag :amount_cents, due, min: 0, class: pos_input_class %>
      <%= hidden_field_tag :payment_method, "cash" %>
      <%= submit_tag t("payment.pay_cash"), class: "w-full mt-3 bg-green-700 hover:bg-green-800 text-white py-2.5 rounded-xl font-semibold transition-colors" %>
    </section>
  <% end %>

  <button type="button" class="w-full mt-3 bg-indigo-700 hover:bg-indigo-800 text-white py-2.5 rounded-xl font-semibold transition-colors" data-action="payment#payCard">
    <%= t("payment.pay_card") %>
  </button>

  <section class="mt-4 rounded-2xl border border-gray-200 bg-gray-50/80 p-4">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("payment.gift_card_code") %></label>
    <%= form_with url: pos_payments_path, method: :post, class: "flex gap-2" do %>
      <%= hidden_field_tag :order_id, order.id %>
      <%= text_field_tag :gift_card_code, nil, class: "#{pos_input_class} flex-1 min-w-0" %>
      <%= hidden_field_tag :payment_method, "gift_card" %>
      <%= hidden_field_tag :amount_cents, due %>
      <%= submit_tag t("actions.redeem"), class: "bg-purple-700 hover:bg-purple-800 text-white px-4 rounded-xl font-semibold text-sm transition-colors shrink-0" %>
    <% end %>
  </section>

  <p class="text-xs text-gray-500 mt-4" data-payment-target="terminalStatus"></p>
</div>
