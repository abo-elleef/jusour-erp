<%# locals: order

    The state of the order at a glance — customer · order type · note — as ONE
    button that opens the details drawer. The drawer holds all three sections, so
    one door is enough. Replaced on its own by Turbo so the drawer beside it is
    never disturbed. %>
<div id="cart-chips" class="shrink-0 bg-white border-b border-stone-200/80 px-3 py-2">
  <button type="button"
          onclick="openOrderDrawer('drawer-customer')"
          class="w-full min-h-[44px] flex items-center gap-2 rounded-xl border px-3 py-2 text-start text-sm transition-colors
                 <%= order.customer || order.notes.present? ? 'bg-amber-50 border-amber-200 text-amber-900 hover:bg-amber-100' : 'bg-stone-100 border-stone-200 text-stone-700 hover:bg-stone-200' %>">
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </svg>
    <span class="min-w-0 flex-1 truncate font-medium">
      <span><%= order.customer ? order.customer.display_name : t("pos.cart.walk_in") %></span>
      <% if order.customer&.loyalty_points.to_i.positive? %>
        <span class="text-amber-700 font-semibold">(<%= order.customer.loyalty_points %>pts)</span>
      <% end %>
      <span class="opacity-50">·</span>
      <span id="fulfillment-chip-label"><%= order.fulfillment_summary %></span>
      <span class="opacity-50">·</span>
      <span class="<%= order.notes.present? ? '' : 'opacity-60 font-normal' %>">
        <%= order.notes.present? ? order.notes : t("pos.cart.no_order_note") %>
      </span>
    </span>
    <svg class="w-4 h-4 shrink-0 text-stone-400 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>
  <%= render "pos/offline_handoff", order: order %>
</div>
