<%= turbo_frame_tag "modifier_modal" do %>
  <div class="fixed inset-0 bg-gray-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl border border-gray-200 p-6 max-w-md w-full text-gray-900 max-h-[90vh] overflow-y-auto">
      <h3 class="text-xl font-bold tracking-tight text-gray-900"><%= menu_item.name %></h3>
      <p class="text-amber-700 font-bold mt-1 mb-4 tabular-nums"><%= format_money(menu_item.base_price_cents) %></p>
      <%= form_with url: pos_order_items_path, method: :post, data: { turbo_stream: true, turbo_frame: "_top" } do %>
        <%= hidden_field_tag :menu_item_id, menu_item.id %>
        <% menu_item.modifier_groups.includes(:modifiers).each do |group| %>
          <fieldset class="mb-4 rounded-2xl border border-gray-200 bg-gray-50/80 p-4">
            <legend class="text-sm font-semibold text-gray-900 px-1">
              <%= group.name %>
              <% if group.required %><span class="text-red-600">*</span><% end %>
            </legend>
            <% group.modifiers.each do |mod| %>
              <label class="flex items-center gap-2 py-2 text-sm cursor-pointer hover:bg-white/60 rounded-lg px-1 -mx-1">
                <% if group.multi_select %>
                  <%= check_box_tag "modifier_ids[]", mod.id, false, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/30" %>
                <% else %>
                  <%= radio_button_tag "modifier_group_selections[#{group.id}]", mod.id, false, required: group.required, class: "border-gray-300 text-amber-600 focus:ring-amber-500/30" %>
                <% end %>
                <span class="flex-1 text-gray-900"><%= mod.name %></span>
                <% if mod.price_adjustment_cents != 0 %>
                  <span class="text-gray-500 tabular-nums"><%= format_money(mod.price_adjustment_cents) %></span>
                <% end %>
              </label>
            <% end %>
          </fieldset>
        <% end %>
        <%= text_field_tag :notes, nil, placeholder: t("pos.modifier.kitchen_notes"), class: "#{pos_input_class} mb-4" %>
        <div class="flex gap-2">
          <%= submit_tag t("pos.modifier.add_to_order"), class: "flex-1 #{pos_btn_accent_class}" %>
          <%= link_to t("actions.cancel"), pos_path, class: "flex-1 text-center border border-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl hover:bg-gray-50 transition-colors", data: { turbo_frame: "_top" } %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
