<% groups = menu_item.modifier_groups.includes(:modifiers).to_a %>
<% pricing = modifier_pricing_config(menu_item, order.location, groups) %>
<%= turbo_frame_tag "modifier_modal" do %>
  <div class="fixed inset-0 bg-gray-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl border border-gray-200 p-6 max-w-md w-full text-gray-900 max-h-[90vh] overflow-y-auto">
      <%= form_with url: pos_order_items_path, method: :post,
            data: { turbo_stream: true, turbo_frame: "_top",
                    controller: "modifier-pricing pos-quick-add",
                    modifier_pricing_config_value: pricing.to_json,
                    action: "change->modifier-pricing#refresh input->modifier-pricing#refresh keydown->pos-quick-add#keydown" } do %>
        <h3 class="text-xl font-bold tracking-tight text-gray-900"><%= menu_item.name %></h3>
        <%# Filled by modifier-pricing; the server value shows until JS runs. %>
        <p class="mt-1 mb-4 flex items-baseline gap-2 tabular-nums" data-modifier-pricing-target="total">
          <span class="text-lg font-bold text-gray-900"><%= format_amount(pricing[:base_cents]) %></span>
        </p>
        <%= hidden_field_tag :menu_item_id, menu_item.id %>
        <%# Count typed straight away: focused on open; text (not number) so Arabic-Indic digits work. %>
        <label class="mb-4 flex items-center gap-3">
          <span class="text-sm font-semibold text-gray-900"><%= t("pos.modifier.quantity") %></span>
          <%= text_field_tag :quantity, 1, inputmode: "numeric", pattern: "[0-9]*", autocomplete: "off", autofocus: true,
                class: "#{pos_input_class} w-24 text-center text-2xl font-bold tabular-nums",
                data: { controller: "arabic-numerals",
                        modifier_pricing_target: "quantity", pos_quick_add_target: "quantity",
                        action: "input->arabic-numerals#normalize input->pos-quick-add#digitsOnly focus->arabic-numerals#select" } %>
        </label>
        <% groups.each do |group| %>
          <% shows_prices = modifier_group_shows_prices?(group, pricing) %>
          <fieldset class="mb-4 rounded-2xl border border-gray-200 bg-gray-50/80 p-3 space-y-1.5">
            <legend class="text-sm font-semibold text-gray-900 px-1">
              <%= group.name %>
              <% if group.required %><span class="text-red-600">*</span><% end %>
            </legend>
            <% group.modifiers.each do |mod| %>
              <label class="flex items-center gap-3 min-h-12 px-3 text-sm cursor-pointer rounded-xl border border-transparent hover:bg-white has-[:checked]:bg-amber-50 has-[:checked]:border-amber-400">
                <% if group.multi_select %>
                  <%= check_box_tag "modifier_ids[]", mod.id, false, id: "mod_#{mod.id}", data: { modifier_option: true }, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/30" %>
                <% else %>
                  <%= radio_button_tag "modifier_group_selections[#{group.id}]", mod.id, false, required: group.required, data: { modifier_option: true }, class: "border-gray-300 text-amber-600 focus:ring-amber-500/30" %>
                <% end %>
                <span class="flex-1 font-medium text-gray-900"><%= mod.name %></span>
                <% if shows_prices %>
                  <span class="flex items-baseline gap-1.5 tabular-nums" data-modifier-price="<%= mod.id %>">
                    <span class="text-sm font-bold text-gray-900"><%= format_amount(pricing[:base_cents] + mod.price_adjustment_cents) %></span>
                  </span>
                <% end %>
              </label>
            <% end %>
          </fieldset>
        <% end %>
        <%= text_field_tag :notes, nil, placeholder: t("pos.modifier.kitchen_notes"), class: "#{pos_input_class} mb-4" %>
        <div class="flex gap-2">
          <button type="submit" class="flex-1 <%= pos_btn_accent_class %>">
            <%= t("pos.modifier.add_to_order") %>
            · <span class="tabular-nums" data-modifier-pricing-target="buttonTotal"><%= format_amount(pricing[:base_cents]) %></span>
          </button>
          <%= link_to t("actions.cancel"), pos_path, class: "flex-1 text-center border border-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl hover:bg-gray-50 transition-colors", data: { turbo_frame: "_top", pos_quick_add_target: "cancel" } %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
