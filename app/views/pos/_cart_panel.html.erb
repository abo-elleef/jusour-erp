<%= turbo_frame_tag "cart", class: "flex flex-col flex-1 min-h-0 overflow-hidden" do %>
  <details class="group border-b border-gray-200 shrink-0 bg-white" <%= "open" if order.customer.blank? || local_assigns[:customer_form_errors]&.any? %>>
    <summary class="flex items-center justify-between gap-2 px-4 py-2.5 cursor-pointer list-none marker:content-none">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("order.labels.customer") %></span>
      <span class="text-xs text-gray-400 group-open:rotate-180 transition-transform">▼</span>
    </summary>
    <%= render "pos/order_customer", order: order, customer_form_errors: local_assigns[:customer_form_errors], embedded: true %>
  </details>

  <details class="group border-b border-gray-200 shrink-0 bg-white" <%= "open" if order.table? || order.delivery? %>>
    <summary class="flex items-center justify-between gap-2 px-4 py-2.5 cursor-pointer list-none marker:content-none">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <%= t("order.labels.order_type") %> · <span class="text-gray-700 normal-case"><%= order_type_label(order.order_type) %></span>
      </span>
      <span class="text-xs text-gray-400 group-open:rotate-180 transition-transform">▼</span>
    </summary>
    <%= render "pos/order_fulfillment", order: order, embedded: true %>
  </details>

  <div class="flex flex-col flex-1 min-h-0 overflow-hidden">
    <%= render "pos/cart", order: order %>
    <%= render "pos/cart_actions", order: order %>
  </div>
<% end %>
