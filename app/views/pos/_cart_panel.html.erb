<div class="flex flex-col flex-1 min-h-0 overflow-hidden bg-stone-50">
  <details class="group shrink-0 bg-white border-b border-stone-200/80" <%= "open" if order.customer.blank? || local_assigns[:customer_form_errors]&.any? %>>
    <summary class="<%= pos_cart_expansion_summary_class %>">
      <span class="text-sm font-medium text-stone-800"><%= t("order.labels.customer") %></span>
      <%= pos_cart_chevron_icon %>
    </summary>
    <%= render "pos/order_customer", order: order, customer_form_errors: local_assigns[:customer_form_errors], embedded: true %>
  </details>

  <details class="group shrink-0 bg-white border-b border-stone-200/80" <%= "open" if order.table? || order.delivery? %>>
    <summary class="<%= pos_cart_expansion_summary_class %>">
      <div class="min-w-0">
        <span class="text-sm font-medium text-stone-800"><%= t("order.labels.order_type") %></span>
        <p id="order-type-summary" class="text-xs text-stone-500 mt-0.5"><%= order_type_label(order.order_type) %></p>
      </div>
      <%= pos_cart_chevron_icon %>
    </summary>
    <%= render "pos/order_fulfillment", order: order, embedded: true %>
  </details>

  <details class="group shrink-0 bg-white border-b border-stone-200/80" <%= "open" if order.notes.present? %>>
    <summary class="<%= pos_cart_expansion_summary_class %>">
      <div class="min-w-0">
        <span class="text-sm font-medium text-stone-800"><%= t("pos.cart.order_notes") %></span>
        <p id="order-notes-summary" class="text-xs text-stone-500 mt-0.5 truncate"><%= order.notes.present? ? order.notes : t("pos.cart.notes_placeholder") %></p>
      </div>
      <%= pos_cart_chevron_icon %>
    </summary>
    <%= form_with url: pos_update_notes_path, method: :patch,
          data: { turbo_stream: true },
          class: "px-4 pb-4 pt-2 bg-white" do |f| %>
      <%= f.text_area :notes, value: order.notes,
            placeholder: t("pos.cart.notes_placeholder"),
            rows: 3,
            class: "w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-400 resize-none" %>
      <%= f.submit t("actions.save"),
            class: "mt-2 w-full min-h-10 rounded-xl border border-stone-200 bg-stone-100 hover:bg-stone-200 text-sm font-medium text-stone-700 transition-colors" %>
    <% end %>
  </details>

  <%= render "pos/cart_body", order: order %>
</div>
