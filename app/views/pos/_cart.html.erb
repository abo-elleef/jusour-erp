<div class="flex flex-col flex-1 min-h-0 overflow-hidden">
  <div class="flex-1 overflow-y-auto px-3 py-3 space-y-2.5 min-h-0 overscroll-contain"
       data-controller="cart-scroll" data-cart-scroll-lines-value="<%= order.order_items.size %>">
    <% if order.order_items.empty? %>
      <div class="flex flex-col items-center justify-center py-10 px-4 text-center">
        <div class="w-12 h-12 rounded-full bg-stone-200/70 flex items-center justify-center mb-3">
          <svg class="w-6 h-6 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <p class="text-sm font-medium text-stone-700"><%= t("pos.cart.empty") %></p>
        <p class="text-xs text-stone-500 mt-1"><%= t("pos.cart.empty_hint") %></p>
      </div>
    <% end %>
    <%# Oldest first, like the receipt: an edited line must not change position. %>
    <% order.order_items.includes(:menu_item, :combo, :order_item_modifiers).order(:created_at, :id).each do |item| %>
      <article class="<%= pos_cart_line_item_class %>">
        <div class="flex justify-between items-start gap-2">
          <h3 class="text-sm font-medium leading-snug text-stone-900 min-w-0"><%= item.display_name %></h3>
          <span class="shrink-0 text-sm font-medium text-stone-900 tabular-nums"><%= format_money(item.line_total_cents) %></span>
        </div>
        <% if item.order_item_modifiers.any? %>
          <ul class="mt-1 space-y-0.5">
            <% item.order_item_modifiers.each do |mod| %>
              <li class="text-xs text-stone-500">
                + <%= mod.name %><% if mod.price_adjustment_cents != 0 %> · <%= format_money(mod.price_adjustment_cents) %><% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if item.notes.present? %>
          <button type="button" onclick="document.getElementById('note-dialog-<%= item.id %>').showModal()"
                  class="mt-2 w-full text-left text-xs text-amber-900 bg-amber-50 rounded-xl px-2.5 py-1.5 font-medium hover:bg-amber-100 transition-colors">
            <%= t("pos.cart.note_prefix") %> <%= item.notes %>
          </button>
        <% else %>
          <button type="button" onclick="document.getElementById('note-dialog-<%= item.id %>').showModal()"
                  class="mt-1.5 text-xs text-stone-400 hover:text-stone-600 transition-colors">
            <%= t("pos.cart.add_note") %>
          </button>
        <% end %>

        <dialog id="note-dialog-<%= item.id %>"
                class="m-auto rounded-[28px] shadow-2xl border-0 p-0 w-[21rem] max-w-[90vw] backdrop:bg-black/50 backdrop:backdrop-blur-sm"
                onclick="if(event.target===this)this.close()">
          <div class="px-6 pt-6 pb-4">
            <h3 class="text-base font-semibold text-stone-900"><%= item.display_name %></h3>
            <p class="text-sm text-stone-500 mt-0.5"><%= t("pos.cart.item_note_modal_title") %></p>
          </div>
          <%= form_with url: pos_order_item_path(item), method: :patch,
                data: { turbo_stream: true },
                onsubmit: "this.closest('dialog').close()" do |f| %>
            <div class="px-6 pb-4">
              <%= f.text_area "order_item[notes]", value: item.notes,
                    placeholder: t("pos.cart.item_note_placeholder"),
                    rows: 3,
                    autofocus: true,
                    class: "w-full rounded-2xl border border-stone-300 bg-stone-50 px-4 py-3 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-500 resize-none" %>
            </div>
            <div class="flex justify-end gap-2 px-6 pb-6">
              <button type="button" onclick="this.closest('dialog').close()"
                      class="rounded-full px-5 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 transition-colors">
                <%= t("actions.cancel") %>
              </button>
              <%= f.submit t("actions.save"),
                    class: "rounded-full px-5 py-2 text-sm font-medium bg-stone-800 text-white hover:bg-stone-700 transition-colors cursor-pointer" %>
            </div>
          <% end %>
        </dialog>
        <div class="flex items-center gap-1.5 mt-3">
          <%= button_to "−", pos_order_item_path(item), method: :patch, params: { quantity_delta: -1 }, form: pos_order_item_form_data,
                class: pos_cart_qty_minus_btn_class %>
          <%# Type an exact count (50 cafés) instead of tapping + fifty times. Text input
              rather than number so Arabic-Indic digits are accepted; 0 removes the line. %>
          <%= form_with url: pos_order_item_path(item), method: :patch, **pos_order_item_form_data,
                        class: "contents", data: { turbo_stream: true, controller: "auto-submit" } do |f| %>
            <%= f.text_field "order_item[quantity]", value: item.quantity, inputmode: "numeric", autocomplete: "off",
                  aria: { label: t("order.labels.quantity", default: "Quantity") },
                  data: { controller: "arabic-numerals",
                          action: "input->arabic-numerals#normalize change->auto-submit#submit focus->arabic-numerals#select keydown.enter->arabic-numerals#commit" },
                  class: "w-12 rounded-lg border border-stone-200 bg-white py-1 text-center text-sm font-medium text-stone-800 tabular-nums focus:outline-none focus:ring-2 focus:ring-stone-400" %>
          <% end %>
          <%= button_to "+", pos_order_item_path(item), method: :patch, params: { quantity_delta: 1 }, form: pos_order_item_form_data,
                class: pos_cart_qty_plus_btn_class %>
          <%= button_to t("actions.remove"), pos_order_item_path(item), method: :delete, form: pos_order_item_form_data,
                class: "#{pos_cart_text_btn_class} ms-auto" %>
        </div>
      </article>
    <% end %>
  </div>

  <div class="<%= pos_cart_totals_card_class %>">
    <dl class="space-y-1.5 text-sm">
      <div class="flex justify-between text-stone-600">
        <dt class="font-normal"><%= t("order.labels.subtotal") %></dt>
        <dd class="tabular-nums font-medium text-stone-800"><%= format_money(order.subtotal_cents) %></dd>
      </div>
      <% if order.discount_cents.positive? %>
        <div class="flex justify-between text-emerald-700">
          <dt class="font-normal"><%= t("order.labels.discount") %></dt>
          <dd class="tabular-nums font-medium">-<%= format_money(order.discount_cents) %></dd>
        </div>
      <% end %>
      <% if order.tax_cents.positive? %>
        <div class="flex justify-between text-stone-600">
          <dt class="font-normal"><%= t("order.labels.tax") %></dt>
          <dd class="tabular-nums font-medium text-stone-800"><%= format_money(order.tax_cents) %></dd>
        </div>
      <% end %>
      <% if order.tip_cents.positive? %>
        <div class="flex justify-between text-stone-600">
          <dt class="font-normal"><%= t("order.labels.tip") %></dt>
          <dd class="tabular-nums font-medium text-stone-800"><%= format_money(order.tip_cents) %></dd>
        </div>
      <% end %>
    </dl>
    <div class="flex justify-between items-baseline pt-3 mt-2 border-t border-stone-200">
      <span class="text-sm font-medium text-stone-700"><%= t("order.labels.total") %></span>
      <span class="text-xl font-medium text-stone-900 tabular-nums"><%= format_money(order.total_cents) %></span>
    </div>
  </div>
</div>
