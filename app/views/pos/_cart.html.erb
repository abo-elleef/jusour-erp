<div class="flex flex-col flex-1 min-h-0 overflow-hidden">
  <div class="flex-1 overflow-y-auto px-3 py-3 space-y-2.5 min-h-0">
    <% if order.order_items.empty? %>
      <div class="flex flex-col items-center justify-center py-10 px-4 text-center">
        <div class="w-12 h-12 rounded-full bg-stone-200/70 flex items-center justify-center mb-3">
          <svg class="w-6 h-6 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <p class="text-sm font-medium text-stone-700"><%= t("pos.cart.empty") %></p>
        <p class="text-xs text-stone-500 mt-1"><%= t("pos.cart.empty_hint") %></p>
      </div>
    <% end %>
    <% order.order_items.includes(:menu_item, :combo, :order_item_modifiers).each do |item| %>
      <article class="<%= pos_cart_line_item_class %>">
        <div class="flex justify-between items-start gap-2">
          <h3 class="text-sm font-medium leading-snug text-stone-900 min-w-0"><%= item.display_name %></h3>
          <span class="shrink-0 text-sm font-medium text-stone-900 tabular-nums"><%= format_money(item.line_total_cents) %></span>
        </div>
        <% if item.order_item_modifiers.any? %>
          <ul class="mt-1 space-y-0.5">
            <% item.order_item_modifiers.each do |mod| %>
              <li class="text-xs text-stone-500">
                + <%= mod.name %><% if mod.price_adjustment_cents != 0 %> · <%= format_money(mod.price_adjustment_cents) %><% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if item.notes.present? %>
          <p class="text-xs text-amber-900 bg-amber-50 rounded-xl px-2.5 py-1.5 mt-2 font-medium">
            <%= t("pos.cart.note_prefix") %> <%= item.notes %>
          </p>
        <% end %>
        <div class="flex items-center gap-1.5 mt-3">
          <%= button_to "−", pos_order_item_path(item), method: :patch, params: { quantity_delta: -1 }, form: pos_order_item_form_data,
                class: pos_cart_qty_minus_btn_class %>
          <span class="w-8 text-center text-sm font-medium text-stone-800 tabular-nums"><%= item.quantity %></span>
          <%= button_to "+", pos_order_item_path(item), method: :patch, params: { quantity_delta: 1 }, form: pos_order_item_form_data,
                class: pos_cart_qty_plus_btn_class %>
          <%= button_to t("actions.remove"), pos_order_item_path(item), method: :delete, form: pos_order_item_form_data,
                class: "#{pos_cart_text_btn_class} ms-auto" %>
        </div>
      </article>
    <% end %>
  </div>

  <div class="<%= pos_cart_totals_card_class %>">
    <dl class="space-y-1.5 text-sm">
      <div class="flex justify-between text-stone-600">
        <dt class="font-normal"><%= t("order.labels.subtotal") %></dt>
        <dd class="tabular-nums font-medium text-stone-800"><%= format_money(order.subtotal_cents) %></dd>
      </div>
      <% if order.discount_cents.positive? %>
        <div class="flex justify-between text-emerald-700">
          <dt class="font-normal"><%= t("order.labels.discount") %></dt>
          <dd class="tabular-nums font-medium">-<%= format_money(order.discount_cents) %></dd>
        </div>
      <% end %>
      <% if order.tax_cents.positive? %>
        <div class="flex justify-between text-stone-600">
          <dt class="font-normal"><%= t("order.labels.tax") %></dt>
          <dd class="tabular-nums font-medium text-stone-800"><%= format_money(order.tax_cents) %></dd>
        </div>
      <% end %>
      <% if order.tip_cents.positive? %>
        <div class="flex justify-between text-stone-600">
          <dt class="font-normal"><%= t("order.labels.tip") %></dt>
          <dd class="tabular-nums font-medium text-stone-800"><%= format_money(order.tip_cents) %></dd>
        </div>
      <% end %>
    </dl>
    <div class="flex justify-between items-baseline pt-3 mt-2 border-t border-stone-200">
      <span class="text-sm font-medium text-stone-700"><%= t("order.labels.total") %></span>
      <span class="text-xl font-medium text-stone-900 tabular-nums"><%= format_money(order.total_cents) %></span>
    </div>
  </div>
</div>
