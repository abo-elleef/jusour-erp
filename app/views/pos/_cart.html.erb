<div class="flex-1 overflow-y-auto p-4 space-y-3 min-h-0">
  <% if order.order_items.empty? %>
    <p class="text-gray-500 text-center py-8 text-sm">Tap a menu item to start the order</p>
  <% end %>
  <% order.order_items.includes(:menu_item, :combo, :order_item_modifiers).each do |item| %>
    <div class="bg-gray-800 rounded-lg p-3">
      <div class="flex justify-between gap-2">
        <span class="font-medium leading-tight"><%= item.display_name %></span>
        <span class="shrink-0"><%= format_money(item.line_total_cents) %></span>
      </div>
      <% item.order_item_modifiers.each do |mod| %>
        <p class="text-xs text-gray-400 mt-0.5">+ <%= mod.name %><% if mod.price_adjustment_cents != 0 %> (<%= format_money(mod.price_adjustment_cents) %>)<% end %></p>
      <% end %>
      <% if item.notes.present? %>
        <p class="text-xs text-yellow-400 mt-1 font-medium">📝 <%= item.notes %></p>
      <% end %>
      <div class="flex items-center gap-2 mt-2">
        <%= button_to "−", pos_order_item_path(item), method: :patch, params: { quantity_delta: -1 }, form: pos_order_item_form_data, class: "w-8 h-8 bg-gray-600 hover:bg-gray-500 rounded" %>
        <span class="w-6 text-center font-bold"><%= item.quantity %></span>
        <%= button_to "+", pos_order_item_path(item), method: :patch, params: { quantity_delta: 1 }, form: pos_order_item_form_data, class: "w-8 h-8 bg-gray-600 hover:bg-gray-500 rounded" %>
        <%= button_to "✕", pos_order_item_path(item), method: :delete, form: pos_order_item_form_data, class: "ml-auto text-red-400 hover:text-red-300 text-sm" %>
      </div>
    </div>
  <% end %>
</div>
<div class="p-4 border-t border-gray-700 text-sm space-y-1 shrink-0 bg-gray-900">
  <div class="flex justify-between text-gray-400"><span>Subtotal</span><span><%= format_money(order.subtotal_cents) %></span></div>
  <% if order.discount_cents.positive? %>
    <div class="flex justify-between text-green-400"><span>Discount</span><span>-<%= format_money(order.discount_cents) %></span></div>
  <% end %>
  <div class="flex justify-between text-gray-400"><span>Tax</span><span><%= format_money(order.tax_cents) %></span></div>
  <% if order.tip_cents.positive? %>
    <div class="flex justify-between text-gray-400"><span>Tip</span><span><%= format_money(order.tip_cents) %></span></div>
  <% end %>
  <div class="flex justify-between text-xl font-bold pt-2 border-t border-gray-700 mt-2">
    <span>Total</span>
    <span><%= format_money(order.total_cents) %></span>
  </div>
</div>
