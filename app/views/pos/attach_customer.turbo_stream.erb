<%= turbo_stream.replace "cart-meta-strip" do %>
  <%= render "pos/cart_meta_strip", order: @order,
        customer_form_errors: @customer_form_errors,
        open_customer_dialog: @customer_form_errors&.any? %>
<% end %>
<%= turbo_stream.replace "cart" do %>
  <%= render "pos/cart_body", order: @order %>
<% end %>
<%= turbo_stream.replace "order-summary" do %>
  <%= render "pos/order_summary", order: @order %>
<% end %>
<%= turbo_stream.update "payment-modal-content" do %>
  <%= render "pos/payment_modal", order: @order %>
<% end %>
