<%# Never replaces #cart-meta-strip: that would destroy the open <dialog>. The
    chips and the customer section are updated in place, so the drawer stays put
    and a validation error lands in front of the cashier instead of behind a
    closed panel. %>
<%= turbo_stream.replace "cart-chips" do %>
  <%= render "pos/cart_chips", order: @order %>
<% end %>
<%= turbo_stream.update "drawer-customer-body" do %>
  <%= render "pos/order_customer", order: @order,
        customer_form_errors: @customer_form_errors,
        edit_customer_errors: nil,
        embedded: true %>
<% end %>
<%# The delivery section depends on the customer: attaching one fills its default
    address (and unlocks the address field); clearing it removes both. %>
<%= turbo_stream.update "drawer-fulfillment-body" do %>
  <%= render "pos/order_fulfillment", order: @order, embedded: true %>
<% end %>
<%= turbo_stream.update "drawer-notes-body" do %>
  <%= render "pos/order_notes_form", order: @order %>
<% end %>
<%= turbo_stream.replace "cart" do %>
  <%= render "pos/cart_body", order: @order %>
<% end %>
<%= turbo_stream.replace "order-summary" do %>
  <%= render "pos/order_summary", order: @order %>
<% end %>
<%= turbo_stream.update "payment-modal-content" do %>
  <%= render "pos/payment_modal", order: @order %>
<% end %>
