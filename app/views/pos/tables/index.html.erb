<div class="<%= pos_viewport_h_class %> bg-gray-100 flex flex-col overflow-hidden" data-controller="auto-refresh">
  <header class="flex items-center justify-between gap-3 px-5 py-3 border-b border-gray-200 bg-white shrink-0">
    <span class="hidden sm:block text-xl font-bold tracking-tight text-gray-900 truncate min-w-0"><%= t("pos.tables.title") %></span>
    <%= render "pos/pos_nav" %>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto">
    <div class="p-5 max-w-6xl mx-auto w-full">
      <% busy_count = @table_orders.size %>
      <p class="text-sm text-gray-600 mb-4">
        <%= t("pos.tables.summary", busy: busy_count, free: [@table_count - busy_count, 0].max) %>
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
        <% (1..@table_count).each do |n| %>
          <% orders = @table_orders[n.to_s] || [] %>
          <% if orders.empty? %>
            <%= button_to pos_open_table_path(number: n), method: :post,
                  class: "w-full h-full min-h-28 rounded-2xl border border-gray-200 bg-white hover:bg-gray-50 p-4 text-start transition-colors" do %>
              <span class="block text-2xl font-bold text-gray-900 tabular-nums"><%= n %></span>
              <span class="block text-xs font-semibold text-emerald-700 mt-1"><%= t("pos.tables.free") %></span>
            <% end %>
          <% else %>
            <%# Two orders on one table only happens when an offline order synced onto a
                table someone else had taken during the outage. Both are real; show both. %>
            <% clash = orders.size > 1 %>
            <div class="rounded-2xl border <%= clash ? "border-red-300 bg-red-50/60" : "border-amber-300 bg-amber-50/70" %> p-4 flex flex-col gap-3">
            <% if clash %>
              <p class="text-xs font-semibold text-red-800"><%= t("pos.tables.clash", count: orders.size) %></p>
            <% end %>
            <% orders.each_with_index do |order, i| %>
            <% due = order.amount_due_cents %>
            <div class="flex flex-col gap-1.5 <%= "border-t border-red-200 pt-3" if i.positive? %>">
              <div class="flex items-start justify-between gap-2">
                <span class="text-2xl font-bold text-gray-900 tabular-nums"><%= n if i.zero? %></span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full border <%= due.positive? ? "border-amber-300 text-amber-900 bg-white" : "border-emerald-300 text-emerald-800 bg-white" %>">
                  <%= due.positive? ? t("pos.tables.unpaid") : t("pos.tables.paid") %>
                </span>
              </div>
              <p class="text-xs text-gray-600">
                <%= order.display_reference %><%= " (#{order.offline_number})" if order.offline_number.present? %> · <%= t("pos.tables.items", count: order.order_items.sum(&:quantity)) %> · <%= time_ago_in_words(order.created_at) %>
              </p>
              <p class="text-xs text-gray-500"><%= order.user&.name.presence || order.user&.email %></p>
              <p class="text-sm font-bold text-gray-900 tabular-nums">
                <%= format_amount(order.total_cents) %>
                <% if due.positive? && due != order.total_cents %>
                  <span class="text-xs font-medium text-amber-800">· <%= t("pos.tables.due", amount: format_amount(due)) %></span>
                <% end %>
              </p>
              <div class="mt-1 flex gap-2">
                <% if order.draft? %>
                  <%= button_to t("pos.tables.open"), pos_open_table_path(number: n), method: :post,
                        class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition-colors" %>
                <% else %>
                  <%= link_to t("actions.view"), pos_order_path(order, from: "tables"),
                        class: "inline-flex items-center bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-xl text-sm font-semibold transition-colors" %>
                  <%# Paid orders aren't edited; clearing frees the table for the next party. %>
                  <% if policy(order).complete? %>
                    <%= button_to t("pos.tables.clear"), complete_pos_order_path(order, from: "tables"), method: :post,
                          form: { data: { turbo_confirm: t("pos.tables.clear_confirm", table: n) } },
                          class: "inline-flex items-center border border-gray-300 text-gray-800 hover:bg-white px-3 py-2 rounded-xl text-sm font-semibold transition-colors" %>
                  <% end %>
                <% end %>
              </div>
            </div>
            <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
