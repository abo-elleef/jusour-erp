<div class="flex flex-col lg:flex-row h-screen min-h-0 overflow-hidden" data-controller="pos">
  <div class="flex-1 lg:w-3/5 flex flex-col bg-gray-50 min-w-0 min-h-0">
    <header class="flex items-center justify-between px-5 py-3 border-b border-gray-200 bg-white shrink-0">
      <span class="text-xl font-bold tracking-tight text-gray-900"><%= t("pos.title") %></span>
      <%= render "pos/pos_nav" %>
    </header>

    <%= turbo_frame_tag "pos_menu", class: "flex flex-col flex-1 min-h-0" do %>
      <%= render "pos/menu_panel" %>
    <% end %>
  </div>

  <aside class="fixed bottom-0 left-0 right-0 max-h-[45vh] lg:static lg:max-h-none lg:w-2/5 flex flex-col bg-white shrink-0 border-t lg:border-t-0 lg:border-s border-gray-200 z-40">
    <div class="px-5 py-4 border-b border-gray-200 flex justify-between items-start gap-3 shrink-0 bg-gray-50/80">
      <%= render "pos/order_summary", order: @order %>
      <%= button_to t("pos.cart.new_order"), pos_new_order_path, method: :post,
            class: "text-sm font-semibold text-gray-700 hover:bg-gray-100 px-3 py-2 rounded-xl border border-gray-200 transition-colors shrink-0" %>
    </div>

    <%= render "pos/cart_panel", order: @order %>
  </aside>

  <%= turbo_frame_tag "modifier_modal" %>

  <div id="payment-modal" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4" data-pos-target="paymentModal">
    <div id="payment-modal-content">
      <%= render "pos/payment_modal", order: @order %>
    </div>
  </div>
</div>
