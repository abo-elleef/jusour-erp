<div class="flex flex-col lg:flex-row <%= pos_viewport_h_class %> min-h-0 overflow-hidden" data-controller="pos">
  <section class="flex flex-col min-h-0 flex-1 lg:flex-none lg:w-3/4 lg:h-full bg-gray-50 min-w-0">
    <div data-controller="pos-queue" class="flex flex-col flex-1 min-h-0">
      <header class="flex items-center justify-between px-4 py-2.5 border-b border-gray-200 bg-white shrink-0">
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold tracking-tight text-gray-900"><%= t("pos.title") %></span>
          <span data-pos-queue-target="pendingBadge"
                class="hidden text-xs font-bold bg-amber-500 text-white rounded-full px-2 py-0.5 tabular-nums">0</span>
        </div>
        <%= render "pos/pos_nav" %>
      </header>

      <% unless @open_cash_session %>
        <%= link_to pos_shift_path(tab: "shift"), class: "flex items-center gap-3 px-4 py-2.5 bg-amber-50 border-b border-amber-200 text-amber-800 hover:bg-amber-100 transition-colors shrink-0" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
          </svg>
          <span class="text-sm font-medium"><%= t("pos.shift.no_drawer_banner") %></span>
          <span class="ms-auto text-sm font-semibold underline underline-offset-2"><%= t("pos.shift.start_shift") %> →</span>
        <% end %>
      <% end %>

      <%= turbo_frame_tag "pos_menu", class: "flex flex-col flex-1 min-h-0" do %>
        <%= render "pos/menu_panel" %>
      <% end %>
    </div>
  </section>

  <aside class="flex flex-col min-h-0 shrink-0 h-[60dvh] lg:h-full lg:flex-none lg:w-1/4 bg-stone-50 border-t lg:border-t-0 lg:border-s border-stone-200/80 z-40 shadow-[0_-4px_24px_rgba(0,0,0,0.08)] lg:shadow-[0_0_24px_rgba(0,0,0,0.06)]">
    <div class="px-4 py-3 flex justify-between items-center gap-3 shrink-0 bg-white border-b border-stone-200/80">
      <%= render "pos/order_summary", order: @order %>
      <div class="flex items-center gap-2 shrink-0">
        <%# Secondary: leaves the register for the shift's order list. %>
        <%= link_to pos_shift_path(tab: "orders"), data: { turbo_frame: "_top" },
              class: "#{pos_cart_tonal_btn_class} inline-flex items-center gap-1.5" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <%= t("pos.cart.all_orders") %>
        <% end %>
        <%# Primary: the action the cashier repeats all day. %>
        <%= button_to pos_new_order_path, method: :post,
              class: "inline-flex items-center gap-1.5 text-sm font-semibold text-white bg-stone-900 hover:bg-stone-800 active:bg-stone-950 px-4 py-2 rounded-full transition-colors shadow-sm shrink-0" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
          <%= t("pos.cart.new_order") %>
        <% end %>
      </div>
    </div>

    <%= render "pos/cart_panel", order: @order %>
  </aside>

  <%= turbo_frame_tag "modifier_modal" %>

  <div id="payment-modal" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4" data-pos-target="paymentModal">
    <div id="payment-modal-content">
      <%= render "pos/payment_modal", order: @order, staff_users: @staff_users %>
    </div>
  </div>
</div>
