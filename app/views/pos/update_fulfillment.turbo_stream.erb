<%= turbo_stream.update "fulfillment-chip-label" do %>
  <%= @order.fulfillment_summary %>
<% end %>
<%= turbo_stream.update "drawer-fulfillment-body" do %>
  <%= render "pos/order_fulfillment", order: @order, embedded: true %>
<% end %>
<%= turbo_stream.replace "order-summary" do %>
  <%= render "pos/order_summary", order: @order %>
<% end %>
