<%= turbo_stream.replace "cart-chips" do %>
  <%= render "pos/cart_chips", order: @order %>
<% end %>
<%= turbo_stream.update "drawer-fulfillment-body" do %>
  <%= render "pos/order_fulfillment", order: @order, embedded: true %>
<% end %>
<%= turbo_stream.replace "order-summary" do %>
  <%= render "pos/order_summary", order: @order %>
<% end %>
<% if @fulfillment_error.present? %>
  <%= turbo_stream.append "toast-container", partial: "shared/toast", locals: { message: @fulfillment_error, type: :alert } %>
<% end %>
