    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm min-w-[720px]">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start w-10">#</th>
            <th class="p-3 text-start"><%= t("order.labels.order_number") %></th>
            <th class="p-3 text-start"><%= t("order.labels.time") %></th>
            <th class="p-3 text-start"><%= t("order.labels.type") %></th>
            <th class="p-3 text-start"><%= t("order.labels.status") %></th>
            <th class="p-3 text-start"><%= t("order.labels.customer") %></th>
            <th class="p-3 text-start"><%= t("order.labels.payment_method") %></th>
            <th class="p-3 text-end"><%= t("order.labels.delivery_fee") %></th>
            <th class="p-3 text-end"><%= t("order.labels.total") %></th>
            <th class="p-3 pe-5 text-end"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% orders.each_with_index do |order, index| %>
          <%= render "pos/shifts/order_row", order: order, index: index + 1 %>
          <% end %>
        </tbody>
        <% if local_assigns[:total_cents] %>
          <tfoot class="border-t-2 border-gray-200 bg-gray-50">
            <tr>
              <td colspan="7" class="p-3 ps-5 font-semibold text-gray-900">
                <%= t("pos.shift.orders.total_row", count: total_count) %>
                <span class="block text-xs font-normal text-gray-500"><%= t("pos.shift.orders.total_excludes_cancelled") %></span>
              </td>
              <td class="p-3 text-end font-semibold text-gray-700 tabular-nums" data-testid="shift-orders-delivery-fee-total"><%= format_money(delivery_fee_cents) %></td>
              <td class="p-3 text-end font-bold text-gray-900 tabular-nums" data-testid="shift-orders-total"><%= format_money(total_cents) %></td>
              <td class="p-3 pe-5"></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>
