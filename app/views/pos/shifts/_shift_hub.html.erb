<% if @unpaid_orders_count.positive? %>
  <div class="rounded-2xl border border-amber-200 bg-amber-50/70 px-4 py-3 mb-4 text-sm text-amber-900" role="alert">
    <%= t("pos.shift.unpaid_orders_warning", count: @unpaid_orders_count) %>
    <%= link_to t("pos.collect_payment.title"), pos_orders_path, class: "font-semibold underline ms-1" %>
  </div>
<% end %>

<% if @has_draft_cart %>
  <div class="rounded-2xl border border-amber-200 bg-amber-50/70 px-4 py-3 mb-4 text-sm text-amber-900" role="alert">
    <%= t("pos.shift.draft_cart_warning") %>
    <%= link_to t("pos.shift.back_to_register"), pos_path, class: "font-semibold underline ms-1" %>
  </div>
<% end %>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.shift.time_tracking") %></h2>
  </div>
  <div class="p-5 flex flex-wrap items-center justify-between gap-3">
    <% if current_user.clocked_in? %>
      <p class="text-sm text-gray-700">
        <%= t("accounting.clock_widget.on_shift") %>
        · <%= t("accounting.clock_widget.since", time: l(current_user.current_shift.clocked_in_at, format: :short_time)) %>
      </p>
      <%= button_to t("accounting.clock_widget.clock_out"), clock_out_pos_shift_path, method: :patch,
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    <% else %>
      <p class="text-sm text-gray-500"><%= t("accounting.clock_widget.not_clocked_in") %></p>
      <%= button_to t("accounting.clock_widget.clock_in"), clock_in_pos_shift_path, method: :post,
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    <% end %>
  </div>
</section>

<% if @open_session %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.shift.drawer_open") %></h2>
    </div>
    <div class="p-5 space-y-2 text-sm">
      <p><%= t("accounting.cash_drawer.session_line",
            name: @open_session.user.name,
            date: l(@open_session.session_date, format: :long)) %></p>
      <p class="text-gray-600"><%= t("accounting.shared.treasury") %>: <strong><%= @open_session.treasury.name %></strong></p>
      <p class="text-gray-600">
        <%= t("accounting.cash_drawer.opening_float") %>:
        <strong class="tabular-nums"><%= number_with_precision(@open_session.opening_float_cents.to_f / 100, precision: 2, delimiter: ',') %></strong>
      </p>
    </div>
    <div class="px-5 pb-5">
      <%= link_to t("pos.shift.start_count"), count_pos_shift_path,
            class: "block w-full text-center bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-3 rounded-xl" %>
    </div>
  </section>
<% else %>
  <% if @today_session&.status == "reconciled" %>
    <section class="rounded-2xl border border-green-200 bg-green-50/60 overflow-hidden mb-6">
      <div class="p-5 space-y-2 text-sm">
        <p class="font-semibold text-green-900"><%= t("pos.shift.drawer_reconciled") %></p>
        <p class="text-green-800 tabular-nums">
          <%= t("accounting.cash_drawer.expected") %>: <%= number_with_precision(@today_session.expected_cash_cents.to_f / 100, precision: 2, delimiter: ',') %>
        </p>
        <p class="text-green-800 tabular-nums">
          <%= t("accounting.cash_drawer.counted") %>: <%= number_with_precision(@today_session.counted_cash_cents.to_f / 100, precision: 2, delimiter: ',') %>
        </p>
        <p class="text-green-800 tabular-nums">
          <%= t("accounting.cash_drawer.variance") %>: <%= number_with_precision(@today_session.variance_cents.to_f / 100, precision: 2, delimiter: ',') %>
        </p>
      </div>
    </section>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.shift.open_drawer_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.shift.open_drawer_hint") %></p>
    </div>
    <div class="p-5">
      <% if @assigned_treasury %>
        <%= form_with url: open_drawer_pos_shift_path, method: :post, class: "space-y-4" do %>
          <div>
            <p class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.treasury") %></p>
            <p class="text-sm font-medium text-gray-900"><%= @assigned_treasury.name %></p>
            <p class="text-xs text-gray-500 mt-1"><%= t("pos.shift.assigned_treasury_locked") %></p>
          </div>
          <div>
            <%= label_tag :opening_float, t("accounting.cash_drawer.opening_float"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <%= number_field_tag :opening_float, 0, step: 0.01, min: 0, class: "#{pos_input_class} w-full" %>
          </div>
          <%= submit_tag t("accounting.cash_drawer.open_drawer"), class: "w-full bg-gray-900 text-white py-3 rounded-xl font-semibold" %>
        <% end %>
      <% else %>
        <div class="rounded-xl border border-amber-200 bg-amber-50/70 px-4 py-3 text-sm text-amber-900" role="alert">
          <%= t("pos.shift.no_assigned_treasury") %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
