<% if @shift_time_range %>
  <% start_time, end_time = @shift_time_range %>
  <p class="text-sm text-gray-600 mb-4">
    <%= t("pos.shift.orders.range",
          from: l(start_time, format: :short_time),
          to: l(end_time, format: :short_time),
          date: l(start_time.to_date, format: :long)) %>
  </p>
<% else %>
  <div class="rounded-2xl border border-gray-200 bg-white p-8 text-center mb-6">
    <p class="text-gray-600 font-medium"><%= t("pos.shift.orders.no_shift") %></p>
    <p class="text-sm text-gray-500 mt-2"><%= t("pos.shift.orders.no_shift_hint") %></p>
  </div>
<% end %>

<% if @shift_orders.any? %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.shift.orders.title") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.shift.orders.count", count: @shift_orders.size) %></p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm min-w-[720px]">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("order.labels.order_number") %></th>
            <th class="p-3 text-start"><%= t("order.labels.time") %></th>
            <th class="p-3 text-start"><%= t("order.labels.type") %></th>
            <th class="p-3 text-start"><%= t("order.labels.status") %></th>
            <th class="p-3 text-start"><%= t("order.labels.customer") %></th>
            <th class="p-3 text-start"><%= t("order.labels.payment_method") %></th>
            <th class="p-3 text-end"><%= t("order.labels.total") %></th>
            <th class="p-3 pe-5 text-end"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @shift_orders.each do |order| %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5">
                <span class="font-bold text-gray-900"><%= order.order_number %></span>
              </td>
              <td class="p-3 text-gray-600 tabular-nums whitespace-nowrap">
                <%= l(order.created_at, format: :short_time) %>
              </td>
              <td class="p-3">
                <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= order_type_class(order.order_type) %> <%= order_type_border_class(order.order_type) %>">
                  <%= order.order_type_label %>
                </span>
              </td>
              <td class="p-3">
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full border <%= order_status_class(order.status) %> <%= order_status_border_class(order.status) %>">
                  <%= order_status_label(order.status) %>
                </span>
              </td>
              <td class="p-3 text-gray-600">
                <%= order.customer&.display_name || order.fulfillment_summary %>
              </td>
              <td class="p-3 text-gray-700">
                <%= order_payment_methods_label(order) %>
              </td>
              <td class="p-3 text-end font-bold text-gray-900 tabular-nums"><%= format_money(order.total_cents) %></td>
              <td class="p-3 pe-5 text-end">
                <% if order.draft? %>
                  <%= button_to t("pos.shift.orders.resume"), resume_pos_order_path(order),
                        method: :post,
                        form: { data: { turbo: false } },
                        class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition-colors" %>
                <% else %>
                  <%= link_to t("actions.view"), pos_order_path(order, from: "shift"),
                        class: "inline-flex items-center bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-xl text-sm font-semibold transition-colors" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% elsif @shift_time_range %>
  <section class="rounded-2xl border border-gray-200 bg-white p-10 text-center">
    <p class="text-gray-600 font-medium"><%= t("pos.shift.orders.empty") %></p>
  </section>
<% end %>
