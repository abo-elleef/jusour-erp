<% if @today_sales_summary %>
  <%= render "pos/shifts/expected_totals", summary: @today_sales_summary,
        unpaid_count: @unpaid_orders_count.to_i, unpaid_due_cents: @unpaid_orders_due_cents.to_i %>
<% end %>

<% if @shift_time_range %>
  <% start_time, end_time = @shift_time_range %>
  <p class="text-sm text-gray-600 mb-4">
    <%= t("pos.shift.orders.range",
          from: l(start_time, format: :long_with_time),
          to: l(end_time, format: :long_with_time)) %>
  </p>
<% else %>
  <div class="rounded-2xl border border-gray-200 bg-white p-8 text-center mb-6">
    <p class="text-gray-600 font-medium"><%= t("pos.shift.orders.no_shift") %></p>
    <p class="text-sm text-gray-500 mt-2"><%= t("pos.shift.orders.no_shift_hint") %></p>
  </div>
<% end %>

<%= turbo_frame_tag "shift_orders", target: "_top" do %>
  <% chip = ->(active) { "inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold border transition-colors #{active ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-700 border-gray-200 hover:bg-gray-50'}" } %>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div class="flex items-center gap-2">
      <%= link_to pos_shift_path(tab: "orders", filter: "open", **shift_orders_filter_params), data: { turbo_frame: "shift_orders", turbo_action: "advance" },
            class: chip.call(@filter == "open") do %>
        <%= t("pos.shift.orders.filter_open") %>
        <span class="tabular-nums text-xs px-2 py-0.5 rounded-full <%= @filter == "open" ? "bg-white/20" : "bg-green-100 text-green-800" %>"><%= @open_orders_count %></span>
      <% end %>
      <%= link_to pos_shift_path(tab: "orders", filter: "all", **shift_orders_filter_params), data: { turbo_frame: "shift_orders", turbo_action: "advance" },
            class: chip.call(@filter == "all") do %>
        <%= t("pos.shift.orders.filter_all") %>
        <span class="tabular-nums text-xs px-2 py-0.5 rounded-full <%= @filter == "all" ? "bg-white/20" : "bg-gray-100 text-gray-700" %>"><%= @all_orders_count %></span>
      <% end %>
    </div>
    <% if @filter == "open" && @open_orders_count.positive? %>
      <div class="flex flex-wrap items-center gap-2">
        <% if @paid_open_orders_count.to_i.positive? %>
          <%= button_to t("pos.shift.orders.complete_paid", count: @paid_open_orders_count), complete_paid_pos_orders_path,
                method: :post,
                form: { data: { turbo_confirm: t("pos.shift.orders.complete_paid_confirm", count: @paid_open_orders_count) } },
                class: "inline-flex items-center border border-green-700 text-green-800 hover:bg-green-50 px-5 py-2 rounded-xl text-sm font-semibold transition-colors" %>
        <% end %>
        <%= button_to t("pos.shift.orders.complete_all"), complete_all_pos_orders_path,
              method: :post,
              form: { data: { turbo_confirm: t("pos.shift.orders.complete_all_confirm", count: @open_orders_count) } },
              class: "inline-flex items-center bg-green-700 hover:bg-green-800 text-white px-5 py-2 rounded-xl text-sm font-semibold transition-colors" %>
      </div>
    <% end %>
  </div>

  <%# Narrows the list above; Open/All counts and Complete-all still cover every open order. %>
  <%= form_with url: pos_shift_path, method: :get,
        data: { controller: "auto-submit", turbo_frame: "shift_orders", turbo_action: "advance" },
        class: "flex flex-wrap items-end gap-3 mb-4" do %>
    <%= hidden_field_tag :tab, "orders", id: nil %>
    <%= hidden_field_tag :filter, @filter, id: nil %>
    <% if params[:sort].present? %>
      <%= hidden_field_tag :sort, @sort, id: nil %>
      <%= hidden_field_tag :dir, @direction, id: nil %>
    <% end %>
    <div class="min-w-[10rem]">
      <%= label_tag :order_type, t("order.labels.order_type"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= select_tag :order_type,
            options_for_select(Order::ORDER_TYPES.map { |type| [t("order.types.#{type}"), type] }, @order_type_filter),
            include_blank: t("pos.shift.orders.all_order_types"),
            class: pos_input_class,
            data: { action: "change->auto-submit#submit" } %>
    </div>
    <div class="min-w-[10rem]">
      <%= label_tag :payment_method, t("order.labels.payment_method"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <% method_options = (@payment_method_options | [@payment_method_filter].compact) %>
      <%= select_tag :payment_method,
            options_for_select(method_options.map { |method| [payment_method_label(method), method] }, @payment_method_filter),
            include_blank: t("pos.shift.orders.all_payment_methods"),
            class: pos_input_class,
            data: { action: "change->auto-submit#submit" } %>
    </div>
    <% if @order_type_filter || @payment_method_filter %>
      <%= link_to t("pos.shift.orders.clear_filters"), pos_shift_path(tab: "orders", filter: @filter, **shift_orders_filter_params.slice(:sort, :dir)),
            data: { turbo_frame: "shift_orders", turbo_action: "advance" },
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 underline py-2" %>
    <% end %>
  <% end %>

  <% if @shift_orders.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <%= render "pos/shifts/orders_table", orders: @shift_orders,
            total_cents: @shift_orders_total_cents, total_count: @shift_orders_total_count,
            delivery_fee_cents: @shift_orders_delivery_fee_cents %>
    </section>
  <% elsif @shift_time_range %>
    <section class="rounded-2xl border border-gray-200 bg-white p-10 text-center">
      <p class="text-gray-600 font-medium"><%= t(if @order_type_filter || @payment_method_filter then "pos.shift.orders.no_match" elsif @filter == "open" then "pos.shift.orders.no_open" else "pos.shift.orders.empty" end) %></p>
    </section>
  <% end %>
<% end %>
