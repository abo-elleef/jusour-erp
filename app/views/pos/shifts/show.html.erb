<div class="<%= pos_viewport_min_h_class %> bg-gray-100 flex flex-col">
  <header class="flex items-center justify-between px-5 py-3 border-b border-gray-200 bg-white shrink-0">
    <div class="flex items-center gap-3">
      <span class="text-xl font-bold tracking-tight text-gray-900"><%= t("pos.shift.title") %></span>
      <% if @open_session %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 border border-green-300 px-2.5 py-0.5 text-xs font-semibold text-green-800">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
          <%= t("pos.shift.drawer_open_badge") %>
        </span>
      <% else %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 border border-gray-300 px-2.5 py-0.5 text-xs font-semibold text-gray-500">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
          <%= t("pos.shift.drawer_closed_badge") %>
        </span>
      <% end %>
    </div>
    <%= render "pos/pos_nav" %>
  </header>

  <div class="p-5 max-w-2xl mx-auto w-full flex-1">
    <nav class="mb-6 border-b border-gray-200" aria-label="<%= t("pos.shift.tabs.label") %>">
      <div class="flex flex-wrap gap-x-1 -mb-px">
        <%= link_to t("pos.shift.tabs.orders"), pos_shift_path(tab: "orders"),
              class: admin_section_tab_class(@tab == "orders") %>
        <%= link_to t("pos.shift.tabs.shift"), pos_shift_path(tab: "shift"),
              class: admin_section_tab_class(@tab == "shift") %>
      </div>
    </nav>

    <% if @tab == "orders" %>
      <p class="text-gray-600 text-sm mb-6"><%= t("pos.shift.orders.description") %></p>
      <%= render "orders_tab" %>
    <% else %>
      <p class="text-gray-600 text-sm mb-6"><%= t("pos.shift.description") %></p>
      <%= render "shift_hub" %>
    <% end %>
  </div>
</div>
