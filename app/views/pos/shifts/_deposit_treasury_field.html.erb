<%# Where this branch's takings go at close. Not a choice made at the till — the
    branch is configured once by an admin, and the cashier is only told. %>
<% if @deposit_treasury.blank? %>
  <div class="rounded-2xl border border-red-200 bg-red-50/70 p-4 mb-4 text-start" role="alert">
    <p class="font-semibold text-red-900"><%= t("pos.shift.deposit_missing_title") %></p>
    <p class="text-sm text-red-800 mt-0.5"><%= t("pos.shift.deposit_missing_hint") %></p>
  </div>
<% else %>
  <div class="rounded-2xl border <%= @deposit_is_fallback ? "border-amber-300 bg-amber-50/80" : "border-gray-200 bg-gray-50/80" %> p-4 mb-4 text-start">
    <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide"><%= t("pos.shift.deposit_to") %></p>
    <p class="font-semibold text-gray-900 mt-0.5"><%= @deposit_treasury.name %></p>
    <% if @deposit_is_fallback %>
      <p class="text-sm text-amber-900 mt-2" role="alert">
        <span class="font-semibold"><%= t("pos.shift.deposit_fallback_title") %></span>
        <%= t("pos.shift.deposit_fallback_hint", branch: @open_session.location&.name) %>
      </p>
    <% else %>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("pos.shift.deposit_hint") %></p>
    <% end %>
  </div>
<% end %>
