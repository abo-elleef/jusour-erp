<div class="px-5 py-4 border-t border-gray-200 space-y-3 shrink-0 bg-white">
  <%= form_with url: pos_apply_coupon_path, method: :patch, class: "flex gap-2" do %>
    <%= text_field_tag :code, nil, placeholder: t("pos.cart.coupon_placeholder"), class: "#{pos_input_class} flex-1 min-w-0" %>
    <%= submit_tag t("pos.cart.apply_coupon"), class: "bg-white hover:bg-gray-50 text-gray-700 font-semibold px-4 rounded-xl border border-gray-200 text-sm transition-colors shrink-0" %>
  <% end %>

  <% if order.customer&.loyalty_points.to_i >= Setting.get_int("loyalty_redeem_threshold", 100) %>
    <%= button_to t("pos.cart.redeem_points", points: order.customer.loyalty_points), pos_redeem_points_path, method: :patch,
          class: "w-full bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 py-2.5 rounded-xl text-sm font-semibold transition-colors" %>
  <% end %>

  <%= form_with url: pos_submit_path, method: :patch, data: { turbo_frame: "_top" } do %>
    <%= submit_tag t("pos.cart.send_to_kitchen"),
          class: "w-full bg-white hover:bg-gray-50 text-gray-900 border border-gray-200 py-3 rounded-xl font-bold transition-colors",
          data: (order.order_items.empty? ? { turbo_confirm: t("pos.cart.empty") } : {}) %>
  <% end %>

  <button type="button"
        class="w-full bg-gray-900 hover:bg-gray-800 text-white py-3 rounded-xl font-bold transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
        data-action="pos#openPayment"
        <%= "disabled" if order.order_items.empty? %>>
    <%= t("pos.cart.charge", amount: format_money(order.amount_due_cents)) %>
  </button>
</div>
