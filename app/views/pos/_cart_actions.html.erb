<div class="px-3 py-3 space-y-2.5 shrink-0 bg-white border-t border-stone-200/80">
  <% if false  %>
    <%= form_with url: pos_apply_coupon_path, method: :patch, class: "flex gap-2 items-center" do %>
      <%= text_field_tag :code, nil, placeholder: t("pos.cart.coupon_placeholder"), class: "#{pos_cart_input_class} flex-1 min-w-0" %>
      <%= submit_tag t("pos.cart.apply_coupon"), class: "#{pos_cart_tonal_btn_class} !min-h-10" %>
    <% end %>

    <% if order.customer&.loyalty_points.to_i >= Setting.get_int("loyalty_redeem_threshold", 100) %>
      <%= button_to t("pos.cart.redeem_points", points: order.customer.loyalty_points), pos_redeem_points_path, method: :patch,
            class: "w-full bg-violet-50 hover:bg-violet-100 active:bg-violet-200 text-violet-900 border border-violet-200 py-2.5 rounded-full text-sm font-medium transition-colors" %>
    <% end %>
  <% end %>
  

  <div class="space-y-2 pt-0.5">
    <%# One row: Charge, and — once the order has items — two print-only buttons that
        change nothing about the order or its payments. %>
    <div class="flex items-stretch gap-2">
      <button type="button"
            class="<%= pos_cart_filled_btn_class %> flex-1 min-w-0"
            data-action="pos#openPayment"
            data-amount-cents="<%= order.amount_due_cents %>"
            data-total-cents="<%= order.total_cents %>"
            data-due-text="<%= t('payment.due', amount: format_money(order.amount_due_cents)) %>"
            <%= "disabled" if order.order_items.empty? %>>
        <%= t("pos.cart.charge", amount: format_money(order.amount_due_cents)) %>
      </button>

      <% if order.persisted? && order.order_items.any? %>
        <% icon_btn = "relative shrink-0 w-12 min-h-11 inline-flex items-center justify-center bg-transparent hover:bg-stone-100 active:bg-stone-200 text-stone-800 border border-stone-300 rounded-full transition-colors" %>
        <%= button_to print_receipt_pos_order_path(order, from: "pos"),
              method: :post,
              form: { data: { turbo_frame: "_top" }, class: "contents" },
              class: icon_btn, title: t("pos.cart.print_receipt"), "aria-label": t("pos.cart.print_receipt") do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2M6 14h12v7H6z"/></svg>
        <% end %>
        <% kitchen_title = order.kitchen_sent_at.present? ? "#{t("pos.cart.send_to_kitchen_bar")} · #{t("payment.kitchen_sent_at", time: l(order.kitchen_sent_at, format: :short_time))}" : t("pos.cart.send_to_kitchen_bar") %>
        <%= button_to send_to_kitchen_pos_order_path(order, from: "pos"),
              method: :post,
              form: { data: { turbo_frame: "_top" }, class: "contents" },
              class: icon_btn, title: kitchen_title, "aria-label": kitchen_title do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 9.18 0A4 4 0 0 1 18 13.87V21H6zM6 17h12"/></svg>
          <% if order.kitchen_sent_at.present? %>
            <span class="absolute -top-1 -end-1 w-4 h-4 rounded-full bg-emerald-600 text-white text-[10px] leading-4 text-center" aria-hidden="true">✓</span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# form_with url: pos_submit_path, method: :patch, data: { turbo_frame: "_top" } do %>
      <%# submit_tag t("pos.cart.send_to_kitchen"),
            class: pos_cart_outlined_btn_class,
            data: (order.order_items.empty? ? { turbo_confirm: t("pos.cart.empty") } : {}) %>
    <%# end %>
  </div>
</div>
