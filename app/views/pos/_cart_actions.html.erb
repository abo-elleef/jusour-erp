<div class="px-3 py-3 space-y-2.5 shrink-0 bg-white border-t border-stone-200/80">
  <% if false  %>
    <%= form_with url: pos_apply_coupon_path, method: :patch, class: "flex gap-2 items-center" do %>
      <%= text_field_tag :code, nil, placeholder: t("pos.cart.coupon_placeholder"), class: "#{pos_cart_input_class} flex-1 min-w-0" %>
      <%= submit_tag t("pos.cart.apply_coupon"), class: "#{pos_cart_tonal_btn_class} !min-h-10" %>
    <% end %>

    <% if order.customer&.loyalty_points.to_i >= Setting.get_int("loyalty_redeem_threshold", 100) %>
      <%= button_to t("pos.cart.redeem_points", points: order.customer.loyalty_points), pos_redeem_points_path, method: :patch,
            class: "w-full bg-violet-50 hover:bg-violet-100 active:bg-violet-200 text-violet-900 border border-violet-200 py-2.5 rounded-full text-sm font-medium transition-colors" %>
    <% end %>
  <% end %>
  

  <div class="space-y-2 pt-0.5">
    <% if order.editing_placed? %>
      <%# A placed order reopened with the branch PIN. It goes back to the kitchen
          (and locks again) only when placed again; until then it cannot be charged. %>
      <%= button_to pos_submit_path, method: :patch,
            form: { data: { turbo_frame: "_top", controller: "submit-once", action: "submit->submit-once#guard" } },
            data: { submit_once_target: "submit", pos_shortcut: "place-order" },
            disabled: order.order_items.empty?,
            class: pos_cart_filled_btn_class do %>
        <%= t("pos.cart.replace_order") %> <kbd class="pos-key-hint pos-key-hint--dark">F8</kbd>
      <% end %>
      <p class="text-xs text-stone-500 text-center"><%= t("pos.cart.replace_order_hint") %></p>
    <% else %>
    <%# Place order sends everything to print and locks the items; Charge takes the
        money (and places the order, if it was not placed yet). %>
    <% if order.persisted? && order.order_items.any? && order.delivery? && order.delivery_fee_cents.zero? && order.delivery_area_id.nil? && order.delivery_fee_editable? %>
      <%# A delivery order with no fee yet: Place order (F8) asks for it first, so
          the cashier never opens the payment modal just to save the fee. Enter on
          an empty field places it as free delivery. A free delivery area
          picked in Order details counts as an answer. %>
      <button type="button"
              class="<%= pos_cart_outlined_btn_class %>"
              data-pos-shortcut="place-order"
              onclick="const d=document.getElementById('place-order-fee-dialog'); if(!d.open) d.showModal()">
        <%= t("pos.cart.place_order") %> <kbd class="pos-key-hint">F8</kbd>
      </button>
      <dialog id="place-order-fee-dialog"
              class="m-auto rounded-[28px] shadow-2xl border-0 p-0 w-[21rem] max-w-[90vw] backdrop:bg-black/50 backdrop:backdrop-blur-sm"
              onclick="if(event.target===this)this.close()">
        <%# With branch delivery areas, the popup also offers the searchable area
            list: picking one fills in its fee (still editable) and is saved with
            the order. The cursor starts in the area search; Enter picks the first
            match, then Enter again places the order. %>
        <% area_options = pos_delivery_area_options(order) %>
        <%= form_with url: pos_submit_path, method: :patch,
              data: { turbo_frame: "_top", controller: "submit-once delivery-area-fee", action: "submit->submit-once#guard" } do %>
          <div class="px-6 pt-6 pb-4">
            <h3 class="text-base font-semibold text-stone-900"><%= t("pos.delivery.fee_prompt_title") %></h3>
            <p class="text-sm text-stone-500 mt-0.5"><%= t(area_options.any? ? "pos.delivery.fee_prompt_area_hint" : "pos.delivery.fee_prompt_hint") %></p>
          </div>
          <% if area_options.any? %>
            <div class="px-6 pb-3">
              <%= label_tag :place_order_delivery_area_id, t("pos.delivery.area"), for: "place_order_delivery_area_id",
                    class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
              <%= render "pos/delivery_area_picker", options: area_options, selected: nil,
                    id: "place_order_delivery_area_id", testid: "place-order-area-picker",
                    action: "change->delivery-area-fee#apply", autofocus: true %>
            </div>
          <% end %>
          <div class="px-6 pb-4">
            <% if area_options.any? %>
              <%= label_tag :place_order_delivery_fee_pounds, t("payment.delivery_fee"), for: "place_order_delivery_fee_pounds",
                    class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <% end %>
            <%= text_field_tag :delivery_fee_pounds, "",
                  id: "place_order_delivery_fee_pounds",
                  inputmode: "decimal", autocomplete: "off", placeholder: "0", autofocus: area_options.none?,
                  class: "#{pos_input_class} text-2xl text-center min-h-14 tabular-nums",
                  data: { controller: "arabic-numerals", delivery_area_fee_target: "fee",
                          action: "input->arabic-numerals#normalize" } %>
          </div>
          <div class="flex justify-end gap-2 px-6 pb-6">
            <button type="button" onclick="this.closest('dialog').close()"
                    class="rounded-full px-5 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 transition-colors">
              <%= t("actions.cancel") %>
            </button>
            <button type="submit" data-submit-once-target="submit"
                    class="rounded-full px-5 py-2 text-sm font-medium bg-stone-800 text-white hover:bg-stone-700 transition-colors cursor-pointer">
              <%= t("pos.cart.place_order") %>
            </button>
          </div>
        <% end %>
      </dialog>
    <% elsif order.persisted? && order.order_items.any? && order.needs_pickup_customer? %>
      <%# A pickup order at a branch that asks for the customer: Place order (F8)
          asks for the phone (or a skip reason) first. Charge (F9) opens the same
          popup (pos#openPayment). %>
      <button type="button"
              class="<%= pos_cart_outlined_btn_class %>"
              data-pos-shortcut="place-order"
              data-testid="place-order-pickup"
              onclick="const d=document.getElementById('pickup-customer-dialog'); window.Stimulus.getControllerForElementAndIdentifier(d, 'pickup-customer').open('place')">
        <%= t("pos.cart.place_order") %> <kbd class="pos-key-hint">F8</kbd>
      </button>
    <% elsif order.persisted? && order.order_items.any? %>
      <%= button_to pos_submit_path, method: :patch,
            form: { data: { turbo_frame: "_top", controller: "submit-once", action: "submit->submit-once#guard" } },
            data: { submit_once_target: "submit", pos_shortcut: "place-order" },
            class: pos_cart_outlined_btn_class do %>
        <%= t("pos.cart.place_order") %> <kbd class="pos-key-hint">F8</kbd>
      <% end %>
    <% end %>
    <button type="button"
          class="<%= pos_cart_filled_btn_class %>"
          data-action="pos#openPayment"
          data-pos-shortcut="charge"
          data-amount-cents="<%= order.amount_due_cents %>"
          data-total-cents="<%= order.total_cents %>"
          data-due-text="<%= t('payment.due', amount: format_money(order.amount_due_cents)) %>"
          <%= "disabled" if order.order_items.empty? %>>
      <%= t("pos.cart.charge", amount: format_money(order.amount_due_cents)) %>
      <kbd class="pos-key-hint pos-key-hint--dark">F9</kbd>
    </button>
    <% end %>
    <% if order.persisted? && order.order_items.any? && !order.editing_placed? && order.needs_pickup_customer? %>
      <%= render "pos/pickup_customer_dialog", order: order %>
    <% end %>
  </div>
</div>
