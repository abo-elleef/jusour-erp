<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%# The POS layout locks the page height, so every screen owns its own scroll
    container. Without one, a long list is simply clipped. %>
<div class="<%= pos_viewport_h_class %> bg-gray-100 flex flex-col overflow-hidden">
  <header class="flex items-center justify-between gap-3 px-5 py-3 border-b border-gray-200 bg-white shrink-0">
    <span class="hidden sm:block text-xl font-bold tracking-tight text-gray-900 truncate min-w-0"><%= t("pos.collect_payment.title") %></span>
    <%= render "pos/pos_nav" %>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto">
    <div class="p-5 max-w-6xl mx-auto w-full">
    <div class="mb-6">
      <p class="text-gray-600 text-sm"><%= t("pos.collect_payment.description") %></p>
    </div>

    <div class="flex flex-wrap gap-2 mb-6" aria-label="<%= t('order.labels.order_type') %>">
      <%= link_to t("pos.collect_payment.all_types"),
        pos_orders_path(all: 1, q: params[:q]&.to_unsafe_h),
        class: pos_category_pill_class(active: @filter_type.nil?) %>
      <%= link_to order_type_label("pickup"),
            pos_orders_path(order_type: "pickup", q: params[:q]&.to_unsafe_h),
            class: pos_category_pill_class(active: @filter_type == "pickup") %>
      <%= link_to order_type_label("table"),
            pos_orders_path(order_type: "table", q: params[:q]&.to_unsafe_h),
            class: pos_category_pill_class(active: @filter_type == "table") %>
      <%= link_to order_type_label("delivery"),
            pos_orders_path(order_type: "delivery", q: params[:q]&.to_unsafe_h),
            class: pos_category_pill_class(active: @filter_type == "delivery") %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
      <div class="rounded-2xl border border-amber-200 bg-amber-50/40 p-4 sm:col-span-1">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("pos.collect_payment.awaiting_payment") %></p>
        <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @orders.size %></p>
        <p class="text-xs text-gray-500 mt-1.5">
          <% if @filter_type.present? %>
            <%= t("pos.collect_payment.filtered_orders", type: order_type_label(@filter_type)) %>
          <% else %>
            <%= t("pos.collect_payment.all_types") %>
          <% end %>
        </p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-4 sm:col-span-2">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("pos.collect_payment.total_due") %></p>
        <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums">
          <%= format_money(@orders.sum(&:amount_due_cents)) %>
        </p>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("pos.collect_payment.across_orders") %></p>
      </div>
    </div>

    <%# Settles exactly the orders listed below — the filters apply, so the total in
        the confirmation is the total on screen. %>
    <% if @orders.any? && policy(Order).collect_all_cash? %>
      <% due_total = @orders.sum(&:amount_due_cents) %>
      <div class="rounded-2xl border border-green-200 bg-green-50/70 p-4 mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="font-semibold text-green-900"><%= t("pos.collect_payment.collect_all_title") %></p>
          <p class="text-sm text-green-800 mt-0.5"><%= t("pos.collect_payment.collect_all_hint") %></p>
        </div>
        <%= button_to t("pos.collect_payment.collect_all", amount: format_money(due_total)),
              collect_all_cash_pos_orders_path(order_type: @filter_type, q: params[:q]&.to_unsafe_h),
              method: :post,
              form: { data: { turbo_confirm: t("pos.collect_payment.collect_all_confirm",
                                               count: @orders.size,
                                               amount: format_money(due_total)) } },
              class: "inline-flex items-center bg-green-700 hover:bg-green-800 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-colors shrink-0" %>
      </div>
    <% end %>

    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.collect_payment.search_title") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.collect_payment.search_hint") %></p>
      </div>
      <div class="p-5">
        <%= search_form_for @q, url: pos_orders_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |f| %>
          <%= hidden_field_tag :order_type, @filter_type if @filter_type.present? %>
          <%= hidden_field_tag :all, 1 if @filter_type.nil? && params[:all].present? %>
          <div class="flex-1 min-w-[12rem]">
            <%= f.label :order_number_cont, t("order.labels.order_number"), class: label_class %>
            <%= f.search_field :order_number_cont, placeholder: "ORD-0001", class: pos_input_class %>
          </div>
          <%= f.submit t("actions.search"), class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shrink-0" %>
        <% end %>
      </div>
    </section>

    <% if @orders.any? %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
          <div>
            <h2 class="text-sm font-semibold text-gray-900"><%= t("pos.collect_payment.unpaid_title") %></h2>
            <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.collect_payment.unpaid_count", count: @orders.size) %></p>
          </div>
          <%= link_to t("nav.register"), pos_path,
                class: "text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl border border-gray-200 transition-colors" %>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm min-w-[640px]">
            <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 ps-5 text-start"><%= t("order.labels.order_number") %></th>
                <th class="p-3 text-start"><%= t("order.labels.type") %></th>
                <th class="p-3 text-start"><%= t("order.labels.status") %></th>
                <th class="p-3 text-start"><%= t("order.labels.customer") %></th>
                <th class="p-3 text-end"><%= t("order.labels.due") %></th>
                <th class="p-3 pe-5 text-end"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 table-zebra">
              <% @orders.each do |order| %>
                <tr class="hover:bg-gray-100 transition-colors">
                  <td class="p-3 ps-5">
                    <span class="font-bold text-gray-900"><%= order.order_number %></span>
                  </td>
                  <td class="p-3">
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= order_type_class(order.order_type) %> <%= order_type_border_class(order.order_type) %>">
                      <%= order.order_type_label %>
                    </span>
                  </td>
                  <td class="p-3">
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full border <%= order_status_class(order.status) %> <%= order_status_border_class(order.status) %>">
                      <%= order_status_label(order.status) %>
                    </span>
                  </td>
                  <td class="p-3 text-gray-600">
                    <%= order.customer&.display_name || order.fulfillment_summary %>
                  </td>
                  <td class="p-3 text-end font-bold text-green-700 tabular-nums"><%= format_money(order.amount_due_cents) %></td>
                  <td class="p-3 pe-5 text-end">
                    <div class="inline-flex items-center justify-end gap-2">
                      <%= render "pos/orders/edit_items_button", order: order %>
                      <%= link_to t("actions.pay"), pos_order_path(order),
                            class: "inline-flex items-center bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-xl text-sm font-semibold transition-colors" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% else %>
      <section class="rounded-2xl border border-gray-200 bg-white p-10 text-center">
        <p class="text-gray-600 font-medium"><%= t("pos.collect_payment.empty") %></p>
        <%= link_to t("pos.collect_payment.back_to_register"), pos_path,
              class: "inline-flex mt-4 text-sm font-semibold text-amber-700 hover:text-amber-800 px-4 py-2 rounded-xl hover:bg-amber-50 transition-colors" %>
      </section>
    <% end %>
    </div>
  </div>
</div>
