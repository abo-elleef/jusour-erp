<%# locals: order %>
<%# Read-only customer card on the order page, so a cashier opening an order from
    My Shift can call the customer or read the address without resuming the cart. %>
<% customer = order.customer %>
<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden" data-testid="order-customer-details">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("order.labels.customer") %></h2>
  </div>
  <div class="px-5 py-4 space-y-3 text-sm">
    <p class="text-base font-semibold text-gray-900"><%= customer.display_name %></p>

    <% if customer.contact_phones.any? || customer.email.present? %>
      <div class="flex flex-wrap gap-2">
        <% customer.contact_phones.each do |num| %>
          <a href="tel:<%= num %>" dir="ltr"
             class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-gray-50 px-3 py-1.5 font-semibold text-gray-800 tabular-nums hover:bg-gray-100">
            <svg class="w-4 h-4 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <%= num %>
          </a>
        <% end %>
        <% if customer.email.present? %>
          <span class="inline-flex items-center rounded-xl border border-gray-200 bg-gray-50 px-3 py-1.5 text-gray-700" dir="ltr"><%= customer.email %></span>
        <% end %>
      </div>
    <% end %>

    <% if order.delivery_address.present? %>
      <div class="rounded-xl bg-amber-50 ring-1 ring-amber-200/60 px-3 py-2">
        <p class="text-xs font-semibold text-amber-800"><%= t("order.labels.delivery_address") %></p>
        <p class="text-gray-900 whitespace-pre-line" data-testid="order-customer-delivery-address"><%= order.delivery_address %></p>
      </div>
    <% end %>

    <% other_addresses = customer.addresses.ordered.reject { |a| a.address.to_s.strip == order.delivery_address.to_s.strip } %>
    <% if other_addresses.any? %>
      <div>
        <p class="text-xs font-semibold text-gray-500 mb-1"><%= t("customers.addresses.title") %></p>
        <div class="space-y-1">
          <% other_addresses.each do |addr| %>
            <p class="text-xs text-gray-600 flex gap-1.5">
              <span class="shrink-0 font-semibold text-gray-500">
                <%= addr.label.presence || t("customers.addresses.address") %><%= " ★" if addr.is_default? %>
              </span>
              <span class="min-w-0"><%= addr.address %></span>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if customer.standing_note.present? %>
      <p class="text-xs text-amber-900 bg-amber-100/70 rounded-lg px-2 py-1.5">
        <span class="font-semibold"><%= t("pos.customer.standing_note") %>:</span>
        <%= customer.standing_note %>
      </p>
    <% end %>

    <% if customer.loyalty_points.positive? %>
      <p class="text-xs font-semibold text-amber-800"><%= customer_loyalty_points_label(customer.loyalty_points) %></p>
    <% end %>
  </div>
</section>
