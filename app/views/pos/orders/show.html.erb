<div class="min-h-screen bg-gray-100">
  <header class="flex items-center justify-between px-4 py-3 border-b bg-white">
    <div class="flex items-center gap-3">
      <%= link_to "← Orders", pos_orders_path(order_type: @order.order_type), class: "text-gray-600 hover:underline text-sm" %>
      <span class="font-bold text-gray-800 text-lg"><%= @order.order_number %></span>
      <span class="text-xs uppercase px-2 py-0.5 rounded <%= order_type_class(@order.order_type) %>">
        <%= @order.fulfillment_summary %>
      </span>
      <span class="text-sm capitalize text-gray-500"><%= @order.status %></span>
    </div>
    <%= render "pos/pos_nav" %>
  </header>

  <div class="p-4 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <h2 class="font-bold p-4 border-b bg-gray-50">Order items</h2>
      <ul class="divide-y p-4 space-y-3">
        <% @order_items.each do |item| %>
          <li>
            <div class="flex justify-between font-medium">
              <span><%= item.quantity %>× <%= item.display_name %></span>
              <span><%= format_money(item.line_total_cents) %></span>
            </div>
            <% item.order_item_modifiers.each do |mod| %>
              <p class="text-xs text-gray-500">+ <%= mod.name %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="border-t p-4 text-sm space-y-1">
        <div class="flex justify-between"><span>Subtotal</span><span><%= format_money(@order.subtotal_cents) %></span></div>
        <div class="flex justify-between"><span>Tax</span><span><%= format_money(@order.tax_cents) %></span></div>
        <% if @order.discount_cents.positive? %>
          <div class="flex justify-between text-green-600"><span>Discount</span><span>-<%= format_money(@order.discount_cents) %></span></div>
        <% end %>
        <div class="flex justify-between text-lg font-bold pt-2 border-t mt-2">
          <span>Total</span>
          <span><%= format_money(@order.total_cents) %></span>
        </div>
        <% if @order.paid_cents.positive? %>
          <div class="flex justify-between text-gray-600"><span>Paid</span><span><%= format_money(@order.paid_cents) %></span></div>
        <% end %>
      </div>

      <% if @payments.any? %>
        <div class="border-t p-4">
          <h3 class="text-sm font-medium text-gray-700 mb-2">Payments</h3>
          <ul class="text-sm space-y-1">
            <% @payments.each do |payment| %>
              <li class="flex justify-between text-gray-600">
                <span class="capitalize"><%= payment.payment_method %></span>
                <span><%= format_money(payment.amount_cents) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <div>
      <%= render "pos/payment_modal", order: @order, checkout: true %>
    </div>
  </div>
</div>
