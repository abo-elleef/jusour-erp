<div class="h-full bg-gray-100 flex flex-col overflow-hidden">
  <header class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-b border-gray-200 bg-white shrink-0">
    <div class="flex items-center gap-2 flex-wrap">
      <% print_icon = capture do %>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
        </svg>
      <% end %>
      <%= form_with url: print_receipt_pos_order_path(@order, from: params[:from]), method: :post do |f| %>
        <%= f.button type: "submit",
              class: "flex items-center gap-1.5 text-sm font-semibold text-gray-700 hover:text-gray-900 px-3 py-1.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 transition-colors" do %>
          <%= print_icon %><%= t("printing.actions.print_receipt") %>
        <% end %>
      <% end %>
      <%= form_with url: print_all_pos_order_path(@order, from: params[:from]), method: :post do |f| %>
        <%= f.button type: "submit",
              class: "flex items-center gap-1.5 text-sm font-semibold text-white bg-gray-800 hover:bg-gray-900 px-3 py-1.5 rounded-xl transition-colors" do %>
          <%= print_icon %><%= t("printing.actions.print_all") %>
        <% end %>
      <% end %>
      <%= render "pos/pos_nav" %>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <% back_path = @from_shift ? pos_shift_path(tab: "orders") : pos_orders_path(order_type: @order.order_type) %>
      <% back_label = @from_shift ? t("pos.shift.back_to_shift_orders") : t("nav.orders") %>
      <%= link_to "← #{back_label}", back_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-xl hover:bg-gray-100 transition-colors" %>
      <span class="text-xl font-bold tracking-tight text-gray-900"><%= @order.order_number %></span>
      <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= order_type_class(@order.order_type) %> <%= order_type_border_class(@order.order_type) %>">
        <%= @order.fulfillment_summary %>
      </span>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full border <%= order_status_class(@order.status) %> <%= order_status_border_class(@order.status) %>">
        <%= order_status_label(@order.status) %>
      </span>
    </div>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto">
  <div class="p-5 max-w-6xl mx-auto w-full grid grid-cols-1 <%= @order.amount_due_cents.positive? && !@from_shift ? "lg:grid-cols-2" : "" %> gap-6 pb-8">
    <section class="rounded-2xl border border-gray-200 bg-white overflow-visible">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("order.labels.items") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("pos.collect_payment.lines_count", count: @order_items.size) %></p>
      </div>
      <ul class="divide-y divide-gray-100 px-5 py-2">
        <% @order_items.each do |item| %>
          <li class="py-4">
            <div class="flex justify-between gap-2 font-semibold text-gray-900">
              <span><%= item.quantity %>× <%= item.display_name %></span>
              <span class="tabular-nums shrink-0"><%= format_money(item.line_total_cents) %></span>
            </div>
            <% item.order_item_modifiers.each do |mod| %>
              <p class="text-xs text-gray-500 mt-0.5">+ <%= mod.name %></p>
            <% end %>
            <% if item.notes.present? %>
              <p class="text-xs text-amber-700 bg-amber-50 rounded-lg px-2 py-1 mt-1.5 italic"><%= item.notes %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="border-t border-gray-200 px-5 py-4 text-sm space-y-1.5 bg-gray-50/80">
        <div class="flex justify-between text-gray-600"><span><%= t("order.labels.subtotal") %></span><span class="tabular-nums"><%= format_money(@order.subtotal_cents) %></span></div>
        <div class="flex justify-between text-gray-600"><span><%= t("order.labels.tax") %></span><span class="tabular-nums"><%= format_money(@order.tax_cents) %></span></div>
        <% if @order.discount_cents.positive? %>
          <div class="flex justify-between text-green-700 font-medium"><span><%= t("order.labels.discount") %></span><span class="tabular-nums">-<%= format_money(@order.discount_cents) %></span></div>
        <% end %>
        <div class="flex justify-between text-lg font-bold pt-2 border-t border-gray-200 mt-2 text-gray-900">
          <span><%= t("order.labels.total") %></span>
          <span class="tabular-nums"><%= format_money(@order.total_cents) %></span>
        </div>
        <% if @order.paid_cents.positive? %>
          <div class="flex justify-between text-gray-600"><span><%= t("order.labels.paid_amount") %></span><span class="tabular-nums"><%= format_money(@order.paid_cents) %></span></div>
        <% end %>
        <div class="flex justify-between font-bold text-green-700 pt-1">
          <span><%= t("order.labels.amount_due") %></span>
          <span class="tabular-nums"><%= format_money(@order.amount_due_cents) %></span>
        </div>
      </div>

      <% if @payments.any? %>
        <div class="border-t border-gray-200 px-5 py-4 bg-white">
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2"><%= t("order.labels.payments") %></h3>
          <ul class="text-sm space-y-2">
            <% @payments.each do |payment| %>
              <li class="flex justify-between text-gray-600 rounded-xl border border-gray-100 bg-gray-50/80 px-3 py-2">
                <span class="font-medium text-gray-900"><%= payment_method_label(payment.payment_method) %></span>
                <span class="tabular-nums font-semibold"><%= format_money(payment.amount_cents) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <% if @order.notes.present? %>
        <div class="border-t border-gray-200 px-5 py-4 bg-amber-50/60">
          <h3 class="text-xs font-semibold text-amber-700 uppercase tracking-wide mb-1"><%= t("pos.cart.order_notes") %></h3>
          <p class="text-sm text-amber-900 italic"><%= @order.notes %></p>
        </div>
      <% end %>
    </section>

    <% if @order.amount_due_cents.positive? && !@from_shift %>
      <div class="lg:sticky lg:top-5 lg:self-start">
        <%= render "pos/payment_modal", order: @order, checkout: true %>
      </div>
    <% end %>
  </div>
  </div>
</div>
