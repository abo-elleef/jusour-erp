<%# locals: form_url, theme (:admin or :kitchen) %>
<% admin = local_assigns.fetch(:theme, :admin).to_sym == :admin %>
<% input = admin ?
     "w-full min-w-[5.5rem] bg-white border border-gray-200 rounded-lg px-2 py-1.5 text-sm text-gray-900 tabular-nums focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" :
     "w-full min-w-[5.5rem] bg-gray-900 border border-gray-600 rounded-lg px-2 py-1.5 text-sm text-white tabular-nums" %>
<% select = "#{input} appearance-none" %>
<% th = admin ?
     "sticky top-0 z-10 bg-gray-50 py-2 px-2 text-start text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-200" :
     "sticky top-0 z-10 bg-gray-800 py-2 px-2 text-start text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-700" %>
<% td = admin ? "p-2 align-middle" : "p-2 align-middle border-b border-gray-800" %>
<% label = admin ? "block text-xs font-semibold text-gray-600 mb-1.5" : "block text-xs font-semibold text-gray-400 mb-1.5" %>
<% warn_box = admin ? "rounded-2xl border border-amber-200 bg-amber-50/70 px-5 py-4 mb-4" : "rounded-2xl border border-amber-700/60 bg-amber-950/40 px-5 py-4 mb-4" %>
<% warn_title = admin ? "text-sm font-semibold text-amber-950" : "text-sm font-semibold text-amber-200" %>
<% warn_body = admin ? "text-xs text-amber-900 mt-1" : "text-xs text-amber-100/80 mt-1" %>
<% filled = params.dig(:bulk, :location_id).presence || @default_production_location_id %>
<% filled_date = params.dig(:bulk, :occurred_on).presence || Date.current %>
<% filled_shelf = params.dig(:bulk, :default_shelf_life_days) %>

<div class="<%= warn_box %>">
  <p class="<%= warn_title %>"><%= t("production.bulk.warning_title") %></p>
  <p class="<%= warn_body %>"><%= t("production.bulk.warning_body") %></p>
</div>

<%= form_with url: form_url, method: :post,
      data: {
        controller: "bulk-manufacturing",
        action: "submit->bulk-manufacturing#submit",
        bulk_manufacturing_warning_value: t("production.bulk.confirm_warning"),
        bulk_manufacturing_none_filled_value: t("production.bulk.none_filled"),
        bulk_manufacturing_heading_value: t("production.bulk.confirm_heading")
      } do %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
    <div>
      <%= label_tag "bulk[location_id]", t("production.location_label"), class: label %>
      <%= select_tag "bulk[location_id]",
            options_for_select(@production_locations.map { |l| [l.name, l.id] }, filled),
            include_blank: t("production.select_location"),
            required: true,
            data: { bulk_location: true },
            class: select %>
    </div>
    <div>
      <%= label_tag "bulk[occurred_on]", t("production.occurred_on_label"), class: label %>
      <%= date_field_tag "bulk[occurred_on]", filled_date, max: Date.current, required: true,
            data: { bulk_date: true }, class: input %>
    </div>
    <div>
      <%= label_tag "bulk[default_shelf_life_days]", t("production.bulk.default_shelf_life"), class: label %>
      <%= number_field_tag "bulk[default_shelf_life_days]", filled_shelf, min: 1, step: 1, class: input %>
      <p class="text-xs <%= admin ? 'text-gray-500' : 'text-gray-500' %> mt-1"><%= t("production.bulk.default_shelf_life_hint") %></p>
    </div>
  </div>

  <% if @templates.any? %>
    <div class="overflow-auto max-h-[70vh] relative <%= admin ? 'border border-gray-200 rounded-2xl' : 'border border-gray-700 rounded-2xl' %>">
      <table class="w-full text-sm border-separate border-spacing-0">
        <thead>
          <tr>
            <th class="<%= th %> w-10 ps-3"><%= t("shared.row_index") %></th>
            <th class="<%= th %>"><%= t("inventory.manufacturing.templates.name") %></th>
            <th class="<%= th %>"><%= t("inventory.manufacturing.templates.output") %></th>
            <th class="<%= th %>"><%= t("production.bulk.qty") %></th>
            <th class="<%= th %>"><%= t("production.bulk.unit") %></th>
            <th class="<%= th %>"><%= t("production.shelf_life_label") %></th>
            <th class="<%= th %> pe-3"><%= t("production.notes_label") %></th>
          </tr>
        </thead>
        <tbody>
          <% @templates.each_with_index do |template, index| %>
            <% main = template.main_ingredient_controlled? %>
            <% unit_label = if main
                              ingredient_unit_label(template.main_line&.unit.presence || template.main_ingredient&.unit)
                            else
                              t("production.bulk.runs_unit")
                            end %>
            <% default_shelf = template.output_ingredient.shelf_life_days %>
            <tr class="<%= admin ? 'odd:bg-white even:table-zebra-alt' : 'odd:bg-gray-800/40' %>"
                data-bulk-manufacturing-target="row"
                data-name="<%= template.name %>"
                data-unit-label="<%= unit_label %>">
              <td class="<%= td %> ps-3 text-gray-400 tabular-nums"><%= index + 1 %></td>
              <td class="<%= td %>">
                <%= hidden_field_tag "bulk[rows][#{template.id}][template_id]", template.id %>
                <p class="<%= admin ? 'font-semibold text-gray-900' : 'font-semibold text-white' %>"><%= template.name %></p>
                <% if main && template.main_ingredient %>
                  <p class="text-xs <%= admin ? 'text-amber-800' : 'text-amber-300' %> mt-0.5">
                    <%= t("production.main_input_label", ingredient: template.main_ingredient.name) %>
                  </p>
                <% end %>
              </td>
              <td class="<%= td %> <%= admin ? 'text-gray-700' : 'text-gray-300' %>">
                <%= template.output_ingredient.name %>
                <span class="block text-xs <%= admin ? 'text-gray-500' : 'text-gray-500' %> tabular-nums">
                  <%= template.yield_quantity %> <%= ingredient_unit_label(template.yield_unit.presence || template.output_ingredient.unit) %>
                  <%= t("inventory.manufacturing.templates.per_run") %>
                </span>
              </td>
              <td class="<%= td %>">
                <% if main %>
                  <%= number_field_tag "bulk[rows][#{template.id}][main_input_quantity]",
                        bulk_row_value(template, :main_input_quantity),
                        min: 0, step: 0.0001,
                        data: { bulk_qty: true },
                        class: input %>
                <% else %>
                  <%= number_field_tag "bulk[rows][#{template.id}][runs_count]",
                        bulk_row_value(template, :runs_count),
                        min: 0, step: 0.001,
                        data: { bulk_qty: true },
                        class: input %>
                <% end %>
              </td>
              <td class="<%= td %>">
                <% if main && template.main_ingredient %>
                  <% units = template.main_ingredient.available_units %>
                  <%= select_tag "bulk[rows][#{template.id}][main_input_unit]",
                        options_for_select(units.map { |u| [ingredient_unit_label(u), u] },
                          bulk_row_value(template, :main_input_unit,
                            template.main_line&.unit.presence || template.main_ingredient.unit)),
                        data: { bulk_unit: true },
                        class: select %>
                <% else %>
                  <span class="text-xs <%= admin ? 'text-gray-500' : 'text-gray-400' %>"><%= t("production.bulk.runs_unit") %></span>
                <% end %>
              </td>
              <td class="<%= td %>">
                <%= number_field_tag "bulk[rows][#{template.id}][shelf_life_days]",
                      bulk_row_value(template, :shelf_life_days, default_shelf),
                      min: 1, step: 1, class: input %>
              </td>
              <td class="<%= td %> pe-3">
                <%= text_field_tag "bulk[rows][#{template.id}][notes]",
                      bulk_row_value(template, :notes),
                      class: input %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="flex flex-wrap items-center gap-3 mt-4">
      <%= submit_tag t("production.bulk.submit"),
            class: admin ?
              "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" :
              "bg-amber-500 hover:bg-amber-400 text-gray-950 font-bold px-5 py-3 rounded-xl text-sm" %>
      <p class="text-xs <%= admin ? 'text-gray-500' : 'text-gray-400' %>"><%= t("production.bulk.skip_hint") %></p>
    </div>
  <% else %>
    <p class="<%= admin ? 'text-sm text-gray-500 py-8 text-center' : 'text-center text-gray-400 py-16 text-lg' %>">
      <%= t("production.empty") %>
    </p>
  <% end %>
<% end %>
