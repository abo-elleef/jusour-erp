<%# locals: reconcile_url, submit_label:, extra_fields: nil

    extra_fields is rendered inside the form, above the submit — the POS count
    screen uses it to ask where the cash is going. %>
<div data-controller="cash-count">
  <div class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
    <h2 class="text-sm font-semibold mb-3"><%= t("accounting.cash_drawer.denominations") %></h2>
    <% { "200" => 20000, "100" => 10000, "50" => 5000, "20" => 2000, "10" => 1000, "5" => 500, "1" => 100 }.each do |label, cents| %>
      <div class="flex justify-between items-center gap-4 mb-2">
        <label class="text-sm"><%= label %></label>
        <input type="number" min="0" value="0" class="w-20 border rounded-lg px-2 py-1 text-end"
               data-cash-count-target="denom" data-cents="<%= cents %>" data-action="input->cash-count#recalculate">
      </div>
    <% end %>
    <p class="font-bold mt-4">
      <%= t("accounting.cash_drawer.total_counted", amount: "") %>
      <span data-cash-count-target="total">0.00</span>
    </p>
  </div>

  <%= form_with url: reconcile_url, method: :patch, data: { action: "submit->cash-count#syncHidden" } do %>
    <%= hidden_field_tag :counted_cash, 0, data: { cash_count_target: "hidden" } %>
    <%= local_assigns[:extra_fields] %>
    <%= submit_tag submit_label, class: "w-full bg-gray-900 text-white py-3 rounded-xl font-bold" %>
  <% end %>
</div>
