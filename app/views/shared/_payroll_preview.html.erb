<%# locals: user, payroll_month:, payroll_summary:, readonly: false, month_url:, payroll_sort:, payroll_direction: %>
<% return unless payroll_summary %>
<% readonly = local_assigns.fetch(:readonly, false) %>
<% payroll_sort = local_assigns.fetch(:payroll_sort, PayrollAdjustment::DEFAULT_SORT) %>
<% payroll_direction = local_assigns.fetch(:payroll_direction, PayrollAdjustment::DEFAULT_SORT_DIRECTION) %>
<% month_url = local_assigns.fetch(:month_url, admin_user_path(user, payroll_show_url_params(payroll_month))) %>
<% sortable = !readonly %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden <%= 'mt-8 max-w-7xl' unless readonly %>">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-start gap-3">
    <div>
      <h2 class="text-sm font-semibold text-gray-900"><%= t("staff.payroll.title") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("staff.payroll.subtitle", days: User::WORK_DAYS_PER_MONTH) %></p>
      <% if payroll_summary.finalized && payroll_summary.snapshot %>
        <p class="text-xs text-emerald-700 font-medium mt-1.5">
          <%= t("staff.payroll.recorded_on",
                date: l(payroll_summary.snapshot.finalized_at.to_date, format: :long),
                name: payroll_summary.snapshot.finalized_by.name) %>
        </p>
        <% if payroll_summary.snapshot.payout_required? %>
          <p class="text-xs text-gray-600 mt-0.5">
            <%= t("staff.payroll.paid_from",
                  amount: format_money(payroll_summary.snapshot.remaining_pay_cents),
                  treasury: payroll_summary.snapshot.treasury.name,
                  date: l(payroll_summary.snapshot.paid_on, format: :long)) %>
          </p>
        <% else %>
          <p class="text-xs text-gray-600 mt-0.5"><%= t("staff.payroll.fully_advanced_hint") %></p>
        <% end %>
      <% end %>
    </div>
    <div class="flex flex-wrap items-end gap-2">
    <%= form_with url: month_url, method: :get, class: "flex items-end gap-2" do %>
      <div>
        <%= label_tag :payroll_month, t("staff.payroll.month"), class: label_class %>
        <%= month_field_tag :payroll_month, payroll_month.strftime("%Y-%m"), class: input_class %>
      </div>
      <%= hidden_field_tag :payroll_sort, payroll_sort if sortable %>
      <%= hidden_field_tag :payroll_direction, payroll_direction if sortable %>
      <%= submit_tag t("actions.apply"), class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors" %>
    <% end %>
    </div>
  </div>

  <div class="p-5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 border-b border-gray-100">
    <div class="rounded-xl bg-gray-50 px-4 py-3">
      <p class="text-xs font-semibold text-gray-500 uppercase">
        <%= payroll_summary.attendance_recorded ? t("accounting.monthly_payroll.attendance_pay") : t("staff.payroll.base_salary") %>
      </p>
      <p class="text-lg font-bold text-gray-900 tabular-nums mt-1"><%= format_money(payroll_summary.attendance_pay_cents) %></p>
      <% if (days_label = payroll_attendance_days_label(payroll_summary)) %>
        <p class="text-[11px] font-normal text-gray-400 mt-0.5 whitespace-nowrap"><%= days_label %></p>
      <% end %>
      <% if payroll_summary.attendance_recorded && payroll_summary.attendance_pay_cents != payroll_summary.base_salary_cents %>
        <p class="text-[11px] text-gray-400 mt-0.5">
          <%= t("staff.payroll.base_salary") %>: <%= format_money(payroll_summary.base_salary_cents) %>
        </p>
      <% end %>
    </div>
    <%# Daily rate only makes sense with attendance-driven pay — hide it when the
        attendance module is off (e.g. distribution: fixed salary + adjustments). %>
    <% if Current.company&.feature_enabled?(:attendance) %>
      <div class="rounded-xl bg-gray-50 px-4 py-3">
        <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("staff.payroll.daily_rate") %></p>
        <p class="text-lg font-bold text-gray-900 tabular-nums mt-1"><%= format_money(payroll_summary.daily_rate_cents) %></p>
      </div>
    <% end %>
    <div class="rounded-xl bg-red-50 px-4 py-3">
      <p class="text-xs font-semibold text-red-600 uppercase"><%= t("staff.payroll.penalties") %></p>
      <p class="text-lg font-bold text-red-700 tabular-nums mt-1">−<%= format_money(payroll_summary.penalties_cents) %></p>
    </div>
    <div class="rounded-xl bg-emerald-50 px-4 py-3">
      <p class="text-xs font-semibold text-emerald-600 uppercase"><%= t("staff.payroll.bonuses") %></p>
      <p class="text-lg font-bold text-emerald-700 tabular-nums mt-1">+<%= format_money(payroll_summary.bonuses_cents) %></p>
    </div>
    <div class="rounded-xl bg-blue-50 px-4 py-3">
      <p class="text-xs font-semibold text-blue-600 uppercase"><%= t("staff.payroll.advances.title") %></p>
      <p class="text-lg font-bold text-blue-700 tabular-nums mt-1">−<%= format_money(payroll_summary.advances_cents) %></p>
    </div>
    <div class="rounded-xl bg-orange-50 px-4 py-3">
      <p class="text-xs font-semibold text-orange-600 uppercase"><%= t("staff.payroll.staff_meals") %></p>
      <p class="text-lg font-bold text-orange-700 tabular-nums mt-1">−<%= format_money(payroll_summary.staff_meals_cents) %></p>
    </div>
    <div class="rounded-xl bg-amber-50 px-4 py-3">
      <p class="text-xs font-semibold text-amber-700 uppercase"><%= t("staff.payroll.remaining_pay") %></p>
      <p class="text-lg font-bold text-amber-800 tabular-nums mt-1"><%= format_money(payroll_summary.remaining_pay_cents) %></p>
    </div>
  </div>

  <div class="px-5 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/80">
    <span class="text-sm font-semibold text-gray-900"><%= t("staff.payroll.net_pay") %></span>
    <span class="text-xl font-bold text-gray-900 tabular-nums"><%= format_money(payroll_summary.net_pay_cents) %></span>
  </div>

  <% unless readonly %>
    <% if policy(PayrollAdjustment.new(user: user)).create? && !payroll_summary.finalized %>
      <div class="p-5 border-b border-gray-100">
        <h3 class="text-sm font-semibold text-gray-900 mb-4"><%= t("staff.payroll.add_adjustment") %></h3>
        <%= form_with model: PayrollAdjustment.new(payroll_month: payroll_month, happened_at: Date.current),
              url: admin_user_payroll_adjustments_path(user),
              class: "grid sm:grid-cols-2 lg:grid-cols-3 gap-4 items-end",
              data: { controller: "payroll-adjustment" } do |f| %>
          <%= f.hidden_field :payroll_month, value: payroll_month %>
          <%= hidden_field_tag :payroll_sort, payroll_sort %>
          <%= hidden_field_tag :payroll_direction, payroll_direction %>

          <div>
            <%= f.label :kind, class: label_class %>
            <%= f.select :kind,
                  PayrollAdjustment::KINDS.map { |k| [t("staff.payroll.kinds.#{k}"), k] },
                  {}, class: "#{input_class} appearance-none",
                  data: { payroll_adjustment_target: "kind", action: "change->payroll-adjustment#kindChanged" } %>
          </div>

          <div>
            <%= f.label :unit_type, class: label_class %>
            <%= f.select :unit_type,
                  PayrollAdjustment::BONUS_UNIT_TYPES.map { |u| [t("staff.payroll.unit_types.#{u}"), u] },
                  {}, class: "#{input_class} appearance-none",
                  data: { payroll_adjustment_target: "unitType", action: "change->payroll-adjustment#unitTypeChanged" } %>
          </div>

          <div data-payroll-adjustment-target="fixedAmount" class="hidden">
            <%= f.label :amount_pounds, t("staff.payroll.fixed_amount"), class: label_class %>
            <%= f.number_field :amount_pounds, min: 0.01, step: "0.01", class: input_class, placeholder: "50.00" %>
          </div>

          <div data-payroll-adjustment-target="overtimeHours" class="hidden">
            <%= f.label :overtime_hours, t("staff.payroll.overtime_hours"), class: label_class %>
            <%= f.number_field :overtime_hours, min: 0.25, step: 0.25, class: input_class, placeholder: "4" %>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("staff.payroll.overtime_hint") %></p>
          </div>

          <div>
            <%= f.label :happened_at, t("staff.payroll.happened_at"), class: label_class %>
            <%= f.date_field :happened_at, class: input_class %>
          </div>

          <div class="sm:col-span-2 lg:col-span-3">
            <%= f.label :notes, class: label_class %>
            <%= f.text_field :notes, class: input_class, placeholder: t("staff.payroll.notes_placeholder") %>
          </div>

          <div>
            <%= f.submit t("staff.payroll.record"), class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors w-full sm:w-auto" %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if payroll_summary.adjustments.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
          <tr>
            <th class="p-3 ps-5 text-start">
              <%= payroll_adjustment_sort_link(t("staff.payroll.type"), "kind", user: user, payroll_month: payroll_month, payroll_sort: payroll_sort, payroll_direction: payroll_direction, sortable: sortable) %>
            </th>
            <th class="p-3 text-start">
              <%= payroll_adjustment_sort_link(t("staff.payroll.happened_at"), "happened_at", user: user, payroll_month: payroll_month, payroll_sort: payroll_sort, payroll_direction: payroll_direction, sortable: sortable) %>
            </th>
            <th class="p-3 text-start">
              <%= payroll_adjustment_sort_link(t("staff.payroll.unit"), "unit_type", user: user, payroll_month: payroll_month, payroll_sort: payroll_sort, payroll_direction: payroll_direction, sortable: sortable) %>
            </th>
            <th class="p-3 text-end">
              <span class="inline-flex justify-end w-full">
                <%= payroll_adjustment_sort_link(t("staff.payroll.amount"), "amount_cents", user: user, payroll_month: payroll_month, payroll_sort: payroll_sort, payroll_direction: payroll_direction, sortable: sortable) %>
              </span>
            </th>
            <th class="p-3 text-start">
              <%= payroll_adjustment_sort_link(t("staff.payroll.notes"), "notes", user: user, payroll_month: payroll_month, payroll_sort: payroll_sort, payroll_direction: payroll_direction, sortable: sortable) %>
            </th>
            <% unless readonly %>
              <th class="p-3 text-start">
                <%= payroll_adjustment_sort_link(t("staff.payroll.recorded_by"), "recorded_by", user: user, payroll_month: payroll_month, payroll_sort: payroll_sort, payroll_direction: payroll_direction, sortable: sortable) %>
              </th>
              <th class="p-3 pe-5 text-end"><%= t("staff.payroll.actions_column") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% payroll_summary.adjustments.each do |adj| %>
            <tr>
              <td class="p-3 ps-5">
                <span class="text-xs font-semibold uppercase px-2 py-1 rounded-full <%= adj.penalty? ? 'bg-red-100 text-red-800' : 'bg-emerald-100 text-emerald-800' %>">
                  <%= t("staff.payroll.kinds.#{adj.kind}") %>
                </span>
              </td>
              <td class="p-3 text-gray-600 whitespace-nowrap tabular-nums"><%= l(adj.happened_at, format: :long) %></td>
              <td class="p-3 text-gray-600"><%= adj.unit_label %></td>
              <td class="p-3 text-end font-semibold tabular-nums <%= adj.penalty? ? 'text-red-700' : 'text-emerald-700' %>">
                <%= adj.penalty? ? "−" : "+" %><%= format_money(adj.amount_cents) %>
              </td>
              <td class="p-3 text-gray-600"><%= adj.notes.presence || t("accounting.shared.em_dash") %></td>
              <% unless readonly %>
                <td class="p-3 text-gray-500 text-xs"><%= adj.recorded_by.name %></td>
                <td class="p-3 pe-5 text-end">
                  <% if policy(adj).destroy? && !payroll_summary.finalized %>
                    <%= button_to t("actions.remove"), admin_user_payroll_adjustment_path(user, adj, payroll_show_url_params(payroll_month)),
                          method: :delete,
                          form: { data: { turbo_confirm: t("staff.payroll.remove_confirm") }, class: "inline" },
                          class: "text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="p-5 text-sm text-gray-500"><%= t("staff.payroll.no_adjustments") %></p>
  <% end %>

  <%= render "admin/users/payroll_advances",
        user: user,
        payroll_month: payroll_month,
        payroll_summary: payroll_summary,
        treasuries: local_assigns[:treasuries],
        readonly: readonly,
        payroll_sort: payroll_sort,
        payroll_direction: payroll_direction %>
</section>
