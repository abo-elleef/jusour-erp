<%# theme: :dark for permanently dark chrome, :auto for a screen that toggles
    light/dark at runtime (light base + dark: variants), omitted for light. %>
<% theme = local_assigns[:theme] %>
<% name_class = case theme
                when :dark then "text-white"
                when :auto then "text-gray-900 dark:text-white"
                else "text-gray-900"
                end %>
<% email_class = case theme
                 when :dark then "text-gray-300"
                 when :auto then "text-gray-500 dark:text-gray-300"
                 else "text-gray-500"
                 end %>
<div class="flex items-center gap-3 shrink-0">
  <% if user_signed_in? %>
    <div class="text-end leading-tight min-w-0 max-w-[12rem] sm:max-w-[14rem]" title="<%= current_user.email %>">
      <p class="text-sm font-semibold truncate <%= name_class %>">
        <%= current_user.name %>
      </p>
      <p class="text-xs truncate <%= email_class %> hidden sm:block">
        <%= current_user.email %>
      </p>
    </div>
  <% end %>
  <div class="flex items-center gap-1 rounded-xl border border-gray-200 bg-white p-0.5 text-xs font-semibold shrink-0" role="group" aria-label="<%= t("locale.switcher_label") %>">
    <%= button_to t("locale.en"),
          locale_path(locale: :en),
          method: :patch,
          class: locale_button_class(:en) %>
    <%= button_to t("locale.ar"),
          locale_path(locale: :ar),
          method: :patch,
          class: locale_button_class(:ar) %>
  </div>
</div>
