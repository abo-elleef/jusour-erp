<%# Upload / remove control for a receipt logo.
    locals: attachment (ActiveStorage attachment or nil), file_name, remove_name %>
<% current = attachment if attachment&.attached? && attachment.persisted? %>
<div data-testid="receipt-logo-field">
  <% if current %>
    <div class="mb-3">
      <p class="text-xs font-semibold text-gray-600 mb-1.5"><%= t("shared.receipt_logo_field.current") %></p>
      <%= image_tag url_for(current), alt: "", class: "max-h-24 max-w-full rounded-lg border border-gray-200 bg-white p-2" %>
    </div>
  <% end %>
  <%= file_field_tag file_name, accept: "image/png,image/jpeg,image/gif,image/webp",
        class: "block w-full text-sm text-gray-600 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-semibold hover:file:bg-gray-200" %>
  <p class="text-xs text-gray-500 mt-1.5"><%= t("shared.receipt_logo_field.formats") %></p>
  <% if current %>
    <label class="mt-2 inline-flex items-center gap-2 text-sm text-gray-700">
      <%= check_box_tag remove_name, "1", false, class: "w-4 h-4 border-gray-300 rounded" %>
      <%= t("shared.receipt_logo_field.remove") %>
    </label>
  <% end %>
</div>
