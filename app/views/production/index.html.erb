<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  <% @templates.each do |template| %>
    <% output = template.output_ingredient %>
    <article class="rounded-2xl border border-gray-700 bg-gray-800/80 p-5 flex flex-col gap-4">
      <div>
        <h2 class="text-xl font-bold text-white"><%= template.name %></h2>
        <p class="text-sm text-gray-400 mt-1">
          <%= t("production.produces") %>
          <span class="text-amber-300 font-semibold">
            <%= template.yield_quantity %> <%= ingredient_unit_label(output.unit) %>
          </span>
          <%= t("inventory.manufacturing.templates.per_run") %>
          · <%= output.name %>
        </p>
      </div>

      <ul class="text-xs text-gray-400 space-y-1">
        <% template.manufacturing_template_lines.each do |line| %>
          <li>
            <%= line.quantity_used %> <%= ingredient_unit_label(line.ingredient.unit) %>
            <%= line.ingredient.name %>
          </li>
        <% end %>
      </ul>

      <%= form_with url: production_run_path(template), method: :post, class: "mt-auto space-y-3" do %>
        <div>
          <%= label_tag :runs_count, t("production.runs_label"), class: "block text-xs font-semibold text-gray-400 mb-1.5" %>
          <%= number_field_tag :runs_count, 1, min: 0.001, step: 0.001, required: true,
                class: "w-full bg-gray-900 border border-gray-600 rounded-xl px-4 py-3 text-lg font-bold text-white tabular-nums" %>
        </div>
        <div>
          <%= label_tag :notes, t("production.notes_label"), class: "block text-xs font-semibold text-gray-400 mb-1.5" %>
          <%= text_field_tag :notes, nil,
                class: "w-full bg-gray-900 border border-gray-600 rounded-xl px-4 py-2.5 text-sm text-white" %>
        </div>
        <%= submit_tag t("production.record"),
              class: "w-full bg-amber-500 hover:bg-amber-400 text-gray-950 font-bold py-3 rounded-xl text-sm transition-colors" %>
      <% end %>
    </article>
  <% end %>
</div>

<% if @templates.empty? %>
  <p class="text-center text-gray-400 py-16 text-lg"><%= t("production.empty") %></p>
<% end %>
