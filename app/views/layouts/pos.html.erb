<!DOCTYPE html>
<html lang="<%= html_lang %>" dir="<%= html_dir %>" class="h-full">
  <head>
    <title><%= t("pos.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://js.stripe.com/v3/"></script>
  </head>
  <body class="h-full overflow-hidden bg-gray-100 text-gray-900" data-turbo-cache="false">
    <% if notice || alert %>
      <div id="flash-messages" data-controller="flash" data-flash-dismiss-after-value="3000">
        <% if notice %>
          <div data-flash-message class="bg-green-50 text-green-800 border-b border-green-200 text-center text-sm font-medium py-2 px-4"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div data-flash-message class="bg-red-50 text-red-800 border-b border-red-200 text-center text-sm font-medium py-2 px-4"><%= alert %></div>
        <% end %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
