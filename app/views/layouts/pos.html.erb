<!DOCTYPE html>
<html lang="<%= html_lang %>" dir="<%= html_dir %>" class="h-full">
  <head>
    <title><%= t("pos.title") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="turbo-cache-control" content="no-cache">
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="<%= t("pos.title") %>">
    <meta name="theme-color" content="#1A1A2E">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://js.stripe.com/v3/"></script>
  </head>
  <body class="h-full overflow-hidden bg-gray-100 text-gray-900 pos-screen"
        data-turbo-cache="false"
        data-controller="connectivity offline-order"
        data-offline-order-csrf-token-value="<%= form_authenticity_token %>"
        data-offline-order-saved-message-value="<%= t("pos.offline.saved") %>"
        data-offline-message="<%= t("pos.offline.banner_offline") %>"
        data-online-message="<%= t("pos.offline.banner_online") %>"
        data-connectivity-online-value="true">
    <div data-connectivity-target="banner" class="hidden" role="status"></div>
    <% if notice || alert %>
      <div id="flash-messages" data-controller="flash" data-flash-dismiss-after-value="3000">
        <% if notice %>
          <div data-flash-message class="bg-green-50 text-green-800 border-b border-green-200 text-center text-sm font-medium py-2 px-4"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div data-flash-message class="bg-red-50 text-red-800 border-b border-red-200 text-center text-sm font-medium py-2 px-4"><%= alert %></div>
        <% end %>
      </div>
    <% end %>
    <span class="sr-only" data-connectivity-target="syncStatus"></span>
    <% if current_user&.company_id && Printing::Config.client_routing? %>
      <%= turbo_stream_from "pos_prints_#{current_user.company_id}" %>
      <div id="client-print-queue"
           data-controller="client-printer"
           data-client-printer-config-value="<%= print_agent_config_json %>"
           data-client-printer-payload-url-template-value="<%= payload_pos_print_log_path(":id") %>"
           data-client-printer-confirm-url-template-value="<%= confirm_pos_print_log_path(":id") %>">
        <div data-client-printer-target="banner"
             class="hidden bg-amber-50 text-amber-900 border-b border-amber-200 text-center text-sm font-medium py-2 px-4"
             role="alert">
          <%= t("printing.agent.banner") %>
          <span class="block text-xs mt-1 font-normal"><%= t("printing.agent.banner_hint", port: Printing::Config.agent_port) %></span>
        </div>
      </div>
    <% end %>
    <%= yield %>
    <%= render "pos/manager_pin_modal" %>
  </body>
</html>
