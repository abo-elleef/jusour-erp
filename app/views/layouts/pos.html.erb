<!DOCTYPE html>
<html lang="<%= html_lang %>" dir="<%= html_dir %>" class="h-full">
  <head>
    <title><%= t("pos.title") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="turbo-cache-control" content="no-cache">
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="<%= t("pos.title") %>">
    <meta name="theme-color" content="#0b2a4a">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://js.stripe.com/v3/"></script>
  </head>
  <body class="h-full overflow-hidden bg-gray-100 text-gray-900 pos-screen flex flex-col"
        data-turbo-cache="false"
        data-controller="connectivity connection-monitor offline-sync"
        data-connection-monitor-disconnected-message-value="<%= t("pos.connection.lost") %>"
        data-connection-monitor-reconnected-message-value="<%= t("pos.connection.restored") %>"
        data-offline-message="<%= t("pos.offline.banner_offline") %>"
        data-online-message="<%= t("pos.offline.banner_online") %>"
        data-connectivity-online-value="true"
        data-connectivity-offline-url-value="<%= current_user&.can_access_pos? ? pos_offline_path : "" %>"
        data-offline-sync-queued-message-value="<%= t("pos.offline_mode.queued", count: "%{count}") %>"
        data-offline-sync-synced-message-value="<%= t("pos.offline_mode.synced", count: "%{count}") %>">
    <div id="pos-fixed-banners" class="fixed top-0 start-0 end-0 z-[60]">
      <div data-connectivity-target="banner"
           data-controller="dismissible-banner"
           data-dismissible-banner-id-value="connectivity-offline"
           class="hidden border-b shadow-sm bg-yellow-500 text-yellow-900 border-yellow-600"
           role="alert">
        <div class="flex items-start gap-3 px-4 py-2.5 max-w-5xl mx-auto">
          <p data-connectivity-banner-message class="flex-1 min-w-0 text-sm font-medium text-center sm:text-start leading-snug"></p>
          <button type="button"
                  data-action="dismissible-banner#dismiss"
                  class="shrink-0 rounded-lg p-1.5 opacity-70 hover:opacity-100 hover:bg-black/5 transition-colors min-h-9 min-w-9 flex items-center justify-center"
                  aria-label="<%= t("actions.close") %>">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>
      <%# Orders rung up offline that the server does not have yet. Shown only while
          some are waiting; the link opens the offline register, which lists them. %>
      <div data-offline-sync-target="banner"
           class="hidden border-b shadow-sm bg-amber-100 text-amber-900 border-amber-300"
           role="alert">
        <div class="flex items-center gap-3 px-4 py-2 max-w-5xl mx-auto text-sm font-medium">
          <span data-offline-sync-target="message" class="flex-1 min-w-0"></span>
          <%= link_to t("pos.offline_mode.orders_title"), pos_offline_path, data: { turbo: false },
                class: "shrink-0 underline font-semibold" %>
        </div>
      </div>
    </div>
    <% if current_user&.company_id && Printing::Config.client_routing? %>
      <%# Floating pill, deliberately outside #pos-fixed-banners so it never covers the top nav. %>
      <%= render "pos/print_agent_alert",
            message: t("printing.agent.banner"),
            hint: t("printing.agent.banner_hint"),
            support_url: Printing::Config.support_whatsapp_url,
            support_label: t("printing.agent.banner_support_link") %>
    <% end %>
    <% if current_user&.company_id && Printing::Config.client_routing? %>
      <%# Failed prints stay on screen until someone retries them or they get printed. %>
      <div id="print-failed-pill" role="alert"
           class="hidden fixed bottom-16 start-4 z-[60] max-w-[min(22rem,calc(100vw-2rem))] flex items-center gap-3 rounded-2xl border border-red-300 bg-red-50 text-red-900 shadow-lg ps-3 pe-2 py-2">
        <span class="text-sm font-semibold"><%= t("printing.status.pill", count: "__COUNT__").sub("__COUNT__", '<span data-count>0</span>').html_safe %></span>
        <button type="button" data-retry-all
                class="shrink-0 rounded-lg bg-red-700 hover:bg-red-800 disabled:opacity-60 text-white text-xs font-semibold px-3 py-1.5 min-h-9">
          <%= t("printing.status.retry_all") %>
        </button>
      </div>
    <% end %>
    <%= render "shared/toasts" %>
    <span class="sr-only" data-connectivity-target="syncStatus"></span>
    <% if current_user&.company_id && Printing::Config.client_routing? %>
      <% pos_loc_id = session[:pos_location_id] %>
      <% pos_ws_id = session[:pos_workstation_id] %>
      <% if pos_loc_id.present? && pos_ws_id.present? %>
        <%= turbo_stream_from "pos_prints_#{current_user.company_id}_#{pos_loc_id}_#{pos_ws_id}" %>
      <% end %>
      <% if pos_loc_id.present? %>
        <%= turbo_stream_from "pos_prints_#{current_user.company_id}_#{pos_loc_id}" %>
      <% else %>
        <%= turbo_stream_from "pos_prints_#{current_user.company_id}" %>
      <% end %>
      <div id="client-print-queue"
           data-controller="client-printer"
           data-client-printer-config-value="<%= print_agent_config_json %>"
           data-client-printer-payload-url-template-value="<%= payload_pos_print_log_path(":id") %>"
           data-client-printer-confirm-url-template-value="<%= confirm_pos_print_log_path(":id") %>"
           data-client-printer-pending-url-value="<%= pending_pos_print_logs_path %>"
           data-client-printer-failed-url-value="<%= failed_pos_print_logs_path %>"
           data-client-printer-retry-url-template-value="<%= retry_pos_print_log_path(":id") %>">
      </div>
    <% end %>
    <div id="pos-main" class="pos-main overflow-hidden<%= " pos-main--with-banner" if Printing::Config.client_routing? %>">
      <%= yield %>
    </div>
    <%= render "pos/manager_pin_modal" %>
  </body>
</html>
