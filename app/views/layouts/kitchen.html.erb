<!DOCTYPE html>
<html lang="<%= html_lang %>" dir="<%= html_dir %>" class="h-full">
  <head>
    <title><%= t("kitchen.title") %> — <%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= action_cable_meta_tag %>
  </head>
  <body class="bg-gray-900 text-white min-h-screen p-3 lg:p-4 touch-manipulation" data-controller="kitchen-display">
    <header class="flex justify-between items-center mb-4 gap-3">
      <h1 class="text-2xl lg:text-3xl font-bold"><%= t("kitchen.title") %></h1>
      <%= render "shared/locale_switcher", theme: :dark %>
    </header>
    <%= turbo_stream_from "kitchen" %>
    <%= yield %>
  </body>
</html>
