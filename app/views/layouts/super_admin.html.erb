<!DOCTYPE html>
<html lang="en" dir="ltr" class="h-full">
  <head>
    <title>Super Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-950 text-gray-100 flex h-screen overflow-hidden">
    <aside class="w-56 shrink-0 bg-gray-900 flex flex-col border-r border-gray-800">
      <div class="px-5 py-4 border-b border-gray-800">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Super Admin</span>
      </div>
      <nav class="flex-1 px-3 py-4 flex flex-col gap-0.5 text-sm">
        <%= link_to "Dashboard", super_admin_root_path,
              class: "block py-2.5 px-3 rounded-lg hover:bg-gray-800 text-gray-300 hover:text-white" %>
        <%= link_to "Companies", super_admin_companies_path,
              class: "block py-2.5 px-3 rounded-lg hover:bg-gray-800 text-gray-300 hover:text-white" %>
      </nav>
      <div class="px-3 py-4 border-t border-gray-800 text-xs text-gray-500">
        <p class="mb-2 truncate"><%= current_super_admin_user.email %></p>
        <%= button_to "Sign out", destroy_super_admin_user_session_path, method: :delete,
              class: "text-sm text-gray-400 hover:text-white w-full text-start" %>
      </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
      <% if flash[:notice].present? %>
        <div class="bg-green-800 text-green-100 text-sm px-5 py-2.5"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="bg-red-900 text-red-100 text-sm px-5 py-2.5"><%= flash[:alert] %></div>
      <% end %>
      <main class="flex-1 overflow-y-auto p-6">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
