<%# The call-center workspace (CallCenter::OrdersController): a slim bar and the page. %>
<!DOCTYPE html>
<html lang="<%= html_lang %>" dir="<%= html_dir %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : t("call_center.title") %> — <%= t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%# Live list refreshes keep the agent's scroll position. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-stone-50 min-h-screen text-gray-900 antialiased">
    <header class="border-b border-stone-200 bg-white">
      <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3 px-4 py-3">
        <div class="flex items-center gap-4">
          <%= link_to t("call_center.title"), call_center_path, class: "text-lg font-semibold text-stone-900" %>
          <% if @location&.persisted? && action_name == "new" %>
            <span class="text-sm text-stone-500"><%= t("call_center.ordering_for", branch: @location.name) %></span>
          <% end %>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <% if current_user.can_access_admin? %>
            <%= link_to t("call_center.back_to_admin"), admin_root_path, class: "text-stone-600 hover:text-stone-900" %>
          <% end %>
          <span class="text-stone-500"><%= current_user.name %></span>
          <%= button_to t("actions.sign_out"), destroy_user_session_path, method: :delete,
                class: "rounded-lg border border-stone-300 px-3 py-1.5 text-stone-700 hover:bg-stone-50" %>
        </div>
      </div>
    </header>
    <%= render "shared/toasts" %>
    <%= yield %>
  </body>
</html>
