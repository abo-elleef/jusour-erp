<% page_title = content_for?(:title) ? yield(:title) : @company.name %>
<% page_description = content_for?(:meta_description) ? yield(:meta_description) : (@storefront.localized(:seo_description).presence || @storefront.localized(:tagline).presence || t("public.storefront.meta_description", company: @company.name)) %>
<% dark = storefront_header_dark? %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= html_dir %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="<%= dark ? @storefront.accent_color : '#ffffff' %>">
    <link rel="canonical" href="<%= content_for?(:canonical_url) ? yield(:canonical_url) : request.base_url + request.path %>">
    <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
    <meta property="og:site_name" content="<%= @company.name %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <% if content_for?(:og_image) %>
      <meta property="og:image" content="<%= yield(:og_image) %>">
    <% elsif @storefront.banner.attached? %>
      <meta property="og:image" content="<%= url_for(@storefront.banner.variant(:hero)) %>">
    <% end %>
    <% if @storefront.logo.attached? %>
      <link rel="icon" href="<%= url_for(@storefront.logo.variant(:header)) %>">
    <% end %>
    <% if (fonts_url = @storefront.google_fonts_url) %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="<%= fonts_url %>">
    <% end %>
    <%= storefront_theme_css(@storefront) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-stone-50 min-h-screen text-gray-900 antialiased flex flex-col">
    <% if @storefront.announcement_visible? %>
      <div class="bg-(--sf-primary) text-(--sf-on-primary) text-center text-sm font-medium px-4 py-2">
        <% if @storefront.announcement_url.present? %>
          <%= link_to @storefront.localized(:announcement_text), @storefront.announcement_url, class: "underline-offset-2 hover:underline",
                rel: (@storefront.announcement_url.start_with?("/") ? nil : "noopener") %>
        <% else %>
          <%= @storefront.localized(:announcement_text) %>
        <% end %>
      </div>
    <% end %>

    <header class="border-b <%= dark ? 'border-transparent bg-(--sf-accent) text-(--sf-on-accent)' : 'border-stone-200/80 bg-white text-stone-900' %>">
      <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center gap-x-6 gap-y-3">
        <%= link_to storefront_home_path, class: "flex flex-1 items-center gap-3 min-w-0 lg:flex-none lg:max-w-md" do %>
          <% if @storefront.logo.attached? %>
            <%= image_tag @storefront.logo.variant(:header), alt: @company.name, class: "h-10 w-auto max-w-[8rem] object-contain #{'rounded-md bg-white p-0.5' if dark}" %>
          <% end %>
          <span class="min-w-0">
            <span class="block text-lg font-semibold truncate" dir="auto"><%= @company.name %></span>
            <% if (tagline = @storefront.localized(:tagline)).present? %>
              <span class="hidden sm:block text-xs truncate <%= dark ? 'opacity-75' : 'text-stone-500' %>"><%= tagline %></span>
            <% end %>
          </span>
        <% end %>

        <%= form_with url: storefront_home_path, method: :get, class: "order-last w-full lg:order-none lg:w-auto lg:flex-1 lg:max-w-sm", role: "search" do %>
          <label for="storefront-search" class="sr-only"><%= t("public.storefront.search_label") %></label>
          <input id="storefront-search" type="search" name="q" value="<%= @query %>"
                 placeholder="<%= t("public.storefront.search_placeholder") %>"
                 class="w-full rounded-full border border-stone-300 bg-stone-50 px-4 py-2 text-sm text-stone-900 focus:border-(--sf-primary) focus:bg-white focus:outline-none focus:ring-2 focus:ring-(--sf-primary)/20">
        <% end %>

        <div class="flex items-center gap-2 text-xs font-semibold">
          <% { en: "EN", ar: "عربي" }.each do |code, label| %>
            <% if I18n.locale == code %>
              <span class="rounded-full px-2.5 py-1 <%= dark ? 'bg-(--sf-on-accent) text-(--sf-accent)' : 'bg-stone-900 text-white' %>"><%= label %></span>
            <% else %>
              <%= link_to label, "#{request.path}?#{request.query_parameters.merge("locale" => code.to_s).to_query}",
                    class: "rounded-full px-2.5 py-1 #{dark ? 'opacity-80 hover:opacity-100' : 'text-stone-600 hover:bg-stone-100'}", lang: code, hreflang: code %>
            <% end %>
          <% end %>
          <% if @storefront.whatsapp_url %>
            <%= link_to @storefront.whatsapp_url, target: "_blank", rel: "noopener",
                  class: "ms-1 inline-flex items-center gap-1.5 rounded-full border border-[#B7DFC5] bg-[#E7F5EC] px-3 py-1.5 text-[#146B3A] hover:bg-[#D4EEDB]" do %>
              <%= render "public/storefronts/whatsapp_icon", css: "h-4 w-4" %>
              <span class="sr-only sm:not-sr-only"><%= t("public.storefront.whatsapp_short") %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <%= yield %>
    </main>

    <footer class="border-t border-stone-200 bg-white">
      <div class="max-w-6xl mx-auto px-4 py-8 grid gap-6 sm:grid-cols-2 text-sm text-stone-600">
        <div>
          <p class="font-semibold text-stone-900"><%= @company.name %></p>
          <% if (about = @storefront.localized(:about)).present? %>
            <p class="mt-2 line-clamp-4 leading-relaxed"><%= about %></p>
          <% end %>
          <% if (links = @storefront.social_links).any? %>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="<%= t("public.storefront.follow_us") %>">
              <% links.each do |network, url| %>
                <li>
                  <%= link_to url, target: "_blank", rel: "noopener me",
                        class: "inline-flex items-center gap-1.5 rounded-full border border-stone-300 px-3 py-1.5 text-xs font-semibold text-stone-700 hover:border-(--sf-primary) hover:text-(--sf-primary)" do %>
                    <%= render "public/storefronts/social_icon", network: network %>
                    <%= t("public.storefront.social.#{network}") %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
        <% if @storefront.contact_present? %>
          <div class="space-y-1.5 sm:text-end">
            <p class="font-semibold text-stone-900"><%= t("public.storefront.contact_us") %></p>
            <% if @storefront.phone_url %>
              <p><%= link_to @storefront.phone, @storefront.phone_url, dir: "ltr", class: "hover:text-(--sf-primary) tabular-nums" %></p>
            <% end %>
            <% if @storefront.whatsapp_url %>
              <p><%= link_to @storefront.whatsapp_number, @storefront.whatsapp_url, target: "_blank", rel: "noopener", dir: "ltr", class: "hover:text-(--sf-primary) tabular-nums" %></p>
            <% end %>
            <% if @storefront.email.present? %>
              <p><%= mail_to @storefront.email, class: "hover:text-(--sf-primary)" %></p>
            <% end %>
            <% if @storefront.address.present? %>
              <p><%= @storefront.address %></p>
            <% end %>
          </div>
        <% end %>
      </div>
      <p class="border-t border-stone-100 py-3 text-center text-xs text-stone-400">
        © <%= Date.current.year %> <%= @company.name %>
      </p>
    </footer>
  </body>
</html>
