<!DOCTYPE html>
<html lang="<%= html_lang %>" dir="<%= html_dir %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Date filters live in the session; Turbo page cache would show stale defaults. %>
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "Chart.bundle", "chartkick" %>
    <%# Apply saved sidebar colors before paint to avoid a flash of the default theme. %>
    <script>
      (function () {
        try {
          var bg = localStorage.getItem("saqr.sidebar.bg");
          var text = localStorage.getItem("saqr.sidebar.text");
          if (bg) document.documentElement.style.setProperty("--sidebar-bg", bg);
          if (text) document.documentElement.style.setProperty("--sidebar-text", text);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-gray-50 flex h-screen overflow-hidden"
        data-controller="sidebar command-palette"
        data-command-palette-items-value="<%= command_palette_items.to_json %>"
        data-command-palette-no-results-value="<%= t("nav.command_palette.no_results") %>">
    <aside class="admin-sidebar fixed inset-y-0 start-0 z-30 w-60 flex flex-col transition-transform duration-200 ease-in-out shrink-0 sidebar-panel--closed lg:relative"
           data-sidebar-target="panel">
      <div class="px-5 py-4 border-b border-gray-800 flex items-center justify-between gap-2">
        <span class="font-bold text-lg text-white"><%= admin_brand_name %></span>
        <% if current_user.can_access_admin? %>
          <%= link_to admin_notifications_path,
                class: "relative p-1.5 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-colors",
                "aria-label": t("nav.notifications") do %>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
            </svg>
            <% unread = current_user.notifications.unread.count %>
            <% if unread.positive? %>
              <span class="absolute top-0 end-0 min-w-4 h-4 px-1 bg-red-500 text-white text-[10px] leading-4 text-center rounded-full"><%= unread %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <div class="px-4 pt-3">
        <button type="button" data-action="command-palette#open"
                class="flex items-center gap-2 w-full px-3 py-2 rounded-lg border border-gray-700 text-gray-400 hover:text-white hover:border-gray-600 text-sm transition-colors">
          <%= admin_nav_icon(:search, css: "w-4 h-4 shrink-0") %>
          <span class="flex-1 text-start truncate"><%= t("nav.command_palette.placeholder") %></span>
          <kbd class="hidden sm:inline-flex text-[10px] font-mono text-gray-500 border border-gray-700 rounded px-1 py-0.5">⌘K</kbd>
        </button>
      </div>
      <nav class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-0.5 text-sm text-white"
           data-controller="sidebar-scroll">
        <%= render "admin/nav" %>
      </nav>
      <div class="px-4 py-4 border-t border-gray-800">
        <%= render "shared/locale_switcher", theme: :dark %>
        <%= render "shared/sidebar_theme" %>
        <%= link_to t("auth.change_password"), edit_account_password_path,
              class: "mt-3 block text-sm text-gray-300 hover:text-white text-start" %>
        <%= button_to t("actions.sign_out"), destroy_user_session_path, method: :delete,
              class: "mt-3 text-sm text-gray-300 hover:text-white w-full text-start" %>
        <div class="mt-3 pt-3 border-t border-gray-800 text-xs text-gray-400 text-start">
          <%= render "shared/legal_links", css: "hover:text-white underline underline-offset-2", justify: "justify-start" %>
        </div>
      </div>
    </aside>

    <div class="fixed inset-0 bg-black/50 z-20 hidden lg:hidden"
         data-sidebar-target="overlay"
         data-action="click->sidebar#close"></div>

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <%= render "shared/subscription_banner" %>
      <header class="flex items-center h-14 px-4 border-b border-gray-200 bg-white shrink-0 gap-3 lg:hidden">
        <button type="button"
                class="p-2 rounded-lg hover:bg-gray-100 min-h-11 min-w-11"
                data-action="sidebar#toggle"
                aria-label="<%= t("nav.open_menu") %>">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <span class="font-semibold text-gray-900 truncate flex-1"><%= admin_brand_name %></span>
        <button type="button" data-action="command-palette#open"
                class="p-2 rounded-lg hover:bg-gray-100 min-h-11 min-w-11"
                aria-label="<%= t("nav.command_palette.open") %>">
          <%= admin_nav_icon(:search, css: "w-5 h-5 text-gray-700") %>
        </button>
      </header>
      <%# Pages with a section nav start flush; everything else needs breathing room up top. %>
      <main class="flex-1 overflow-y-auto px-4 pb-4 lg:px-6 lg:pb-6 <%= content_for?(:flush_top) ? "" : "pt-4 lg:pt-6" %>">
        <%= yield %>
      </main>
    </div>

    <%= turbo_stream_from "admin_#{current_user.company_id}" if current_user&.company_id %>
    <%= render "shared/toasts" %>

    <%# Global Cmd/Ctrl+K search — see ApplicationHelper#command_palette_items %>
    <div data-command-palette-target="backdrop"
         data-action="click->command-palette#closeOnBackdrop keydown->command-palette#keydown"
         class="hidden fixed inset-0 z-50 bg-black/40 flex items-start justify-center px-4 pt-20 sm:pt-28">
      <div class="w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden">
        <div class="flex items-center gap-2 px-4 border-b border-gray-100">
          <%= admin_nav_icon(:search, css: "w-4 h-4 shrink-0 text-gray-400") %>
          <input type="text"
                 data-command-palette-target="input"
                 data-action="input->command-palette#filter"
                 class="flex-1 py-3 text-sm text-gray-900 placeholder-gray-400 focus:outline-none bg-transparent"
                 placeholder="<%= t("nav.command_palette.placeholder") %>"
                 autocomplete="off" aria-label="<%= t("nav.command_palette.open") %>">
          <kbd class="text-[10px] font-mono text-gray-400 border border-gray-200 rounded px-1 py-0.5 shrink-0">Esc</kbd>
        </div>
        <ul data-command-palette-target="list" data-action="click->command-palette#click" role="listbox"
            class="max-h-80 overflow-y-auto p-2"></ul>
        <div class="hidden sm:flex items-center gap-4 px-4 py-2 border-t border-gray-100 text-xs text-gray-400">
          <span>↑↓ <%= t("nav.command_palette.hint_navigate") %></span>
          <span>↵ <%= t("nav.command_palette.hint_select") %></span>
          <span>Esc <%= t("nav.command_palette.hint_close") %></span>
        </div>
      </div>
    </div>
  </body>
</html>
