<%= render "admin/menu_nav" %>
<div class="max-w-3xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("admin.categories.description") %></p>
    </div>
    <%= link_to new_admin_category_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("admin.categories.new_button") %>
    <% end %>
  </div>

  <% if @categories.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.categories.stats_total") %></p>
        <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @categories.size %></p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.categories.stats_active") %></p>
        <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= @active_count %></p>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.categories.shown_on_pos") %></p>
      </div>
      <% if @inactive_count.positive? %>
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.categories.stats_inactive") %></p>
          <p class="text-2xl font-bold mt-1 text-gray-600 tabular-nums"><%= @inactive_count %></p>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.categories.hidden_on_pos") %></p>
        </div>
      <% end %>
    </div>

    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.categories.pos_display_order") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.categories.pos_display_order_hint") %></p>
        </div>
        <%= link_to t("admin.categories.menu_items_link"), admin_menu_items_path,
              class: "text-sm font-medium text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl transition-colors" %>
      </div>

      <ul class="divide-y divide-gray-100" data-controller="sortable-categories">
        <% @categories.each_with_index do |cat, index| %>
          <li
            class="group px-5 py-4 flex items-center gap-4 cursor-grab active:cursor-grabbing hover:bg-gray-100 transition-colors"
            data-sortable-categories-target="item"
            data-id="<%= cat.id %>"
          >
            <span
              class="flex items-center justify-center w-9 h-9 rounded-xl bg-gray-100 text-gray-400 group-hover:bg-gray-200 group-hover:text-gray-600 transition-colors select-none shrink-0"
              aria-hidden="true"
              title="<%= t("admin.categories.drag_handle") %>"
            >⠿</span>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-semibold text-gray-900"><%= cat.name %></span>
                <% if cat.active? %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200">
                    <%= t("admin.categories.active") %>
                  </span>
                <% else %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                    <%= t("admin.categories.inactive") %>
                  </span>
                <% end %>
              </div>
              <p class="text-xs text-gray-500 mt-1">
                <%= t("admin.categories.menu_item_count", count: cat.menu_items.size) %>
              </p>
            </div>
            <span class="text-xs font-semibold text-gray-500 tabular-nums px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200 shrink-0">
              #<%= index %>
            </span>
            <div class="flex gap-2 shrink-0">
              <%= link_to t("actions.edit"), edit_admin_category_path(cat),
                    class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
              <% if policy(cat).destroy? %>
                <%= button_to t("actions.delete"), admin_category_path(cat), method: :delete,
                      form: { data: { turbo_confirm: t("admin.categories.confirm_delete", name: cat.name) }, class: "inline" },
                      class: "inline-flex text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("admin.categories.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("admin.categories.empty_description") %></p>
      <%= link_to t("admin.categories.empty_cta"), new_admin_category_path,
            class: "inline-flex font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% end %>
</div>
