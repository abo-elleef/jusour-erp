<%# One live notification card, prepended into #notification-popups by
    Notifications::Broadcast.popup. An "alert" card stays until the user opens or
    closes it and rings; a "popup" card fades on its own, silently.
    locals: notification, level %>
<div data-notification-popups-target="item"
     data-notification-id="<%= notification.id %>"
     data-level="<%= local_assigns.fetch(:level, "alert") %>"
     role="alert"
     class="pointer-events-auto rounded-2xl border bg-white shadow-xl px-4 py-3 text-sm <%= notification_type_border_class(notification.notification_type) %>">
  <div class="flex items-start gap-3">
    <span class="shrink-0 mt-0.5 text-amber-600" aria-hidden="true">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
      </svg>
    </span>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full border <%= notification_type_class(notification.notification_type) %> <%= notification_type_border_class(notification.notification_type) %>">
          <%= notification_type_label(notification.notification_type) %>
        </span>
        <span class="font-semibold text-gray-900 truncate"><%= notification_message_key_label(notification) %></span>
      </div>
      <p class="text-gray-700 leading-snug"><%= notification_message(notification) %></p>
      <div class="mt-2 flex items-center gap-3">
        <%= link_to t("notifications.popup.open"), open_admin_notification_path(notification),
              data: { turbo_frame: "_top" },
              class: "text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 px-3 py-1.5 rounded-lg transition-colors" %>
        <%= link_to t("notifications.popup.all"), admin_notifications_path,
              data: { turbo_frame: "_top" },
              class: "text-xs font-medium text-gray-600 hover:text-gray-900" %>
      </div>
    </div>
    <button type="button"
            data-action="notification-popups#dismiss"
            class="shrink-0 -me-1 -mt-0.5 rounded-lg p-1 text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors"
            aria-label="<%= t("actions.close") %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
</div>
