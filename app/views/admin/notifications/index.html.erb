<% action_btn_class = "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("notifications.index.description") %></p>
    </div>
    <% if @unread_count.positive? %>
      <%= button_to t("notifications.index.mark_all_read"),
            mark_all_read_admin_notifications_path,
            method: :patch,
            class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
    <%= form_with url: admin_notifications_path, method: :get, class: "flex flex-wrap items-end gap-3" do %>
      <%= hidden_field_tag :sort, @sort unless @sort == "time" %>
      <%= hidden_field_tag :dir, @dir unless @dir == "desc" %>

      <div class="min-w-[11rem] flex-1">
        <%= label_tag :alert, t("notifications.index.filters.alert_label"), class: label_class %>
        <%= select_tag :alert,
              options_for_select(
                [[t("notifications.index.filters.all_alerts"), ""]] +
                  @alert_keys.map { |k| [t("notifications.keys.#{k}", default: k.humanize), k] },
                @alert
              ),
              class: "#{input_class} appearance-none" %>
      </div>

      <div class="min-w-[10rem]">
        <%= label_tag :type, t("notifications.index.filters.type_label"), class: label_class %>
        <%= select_tag :type,
              options_for_select(
                [[t("notifications.index.filters.all_types"), ""],
                 [t("notifications.index.filters.inventory"), "inventory"],
                 [t("notifications.index.filters.accounting"), "accounting"]],
                @type
              ),
              class: "#{input_class} appearance-none" %>
      </div>

      <div class="min-w-[9rem]">
        <%= label_tag :status, t("notifications.index.filters.status_label"), class: label_class %>
        <%= select_tag :status,
              options_for_select(
                [[t("notifications.index.filters.all"), ""],
                 [t("notifications.index.filters.unread"), "unread"],
                 [t("notifications.index.filters.read"), "read"]],
                @status
              ),
              class: "#{input_class} appearance-none" %>
      </div>

      <div class="min-w-[9rem]">
        <%= label_tag :from, t("notifications.index.filters.from"), class: label_class %>
        <%= date_field_tag :from, params[:from], max: Date.current, class: input_class %>
      </div>

      <div class="min-w-[9rem]">
        <%= label_tag :to, t("notifications.index.filters.to"), class: label_class %>
        <%= date_field_tag :to, params[:to], max: Date.current, class: input_class %>
      </div>

      <%= submit_tag t("actions.apply_filters"),
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2 rounded-xl transition-colors" %>
      <% if @filtered %>
        <%= link_to t("actions.clear"), admin_notifications_path,
              class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl transition-colors" %>
      <% end %>
    <% end %>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("notifications.index.list_title") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("notifications.index.list_hint", count: @pagy.count) %></p>
    </div>

    <% if @notifications.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[720px]">
          <% sort_opts = { sort: @sort, direction: @dir } %>
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start w-8"><span class="sr-only"><%= t("notifications.index.columns.status") %></span></th>
              <th class="p-3 text-start"><%= sort_header_link(t("notifications.index.columns.type"), :type, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("notifications.index.columns.alert"), :alert, **sort_opts) %></th>
              <th class="p-3 text-start"><%= t("notifications.index.columns.message") %></th>
              <th class="p-3 text-start whitespace-nowrap"><%= sort_header_link(t("notifications.index.columns.time"), :time, **sort_opts) %></th>
              <th class="p-3 pe-5 text-end"><%= t("notifications.index.columns.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @notifications.each do |notification| %>
              <tr class="<%= notification.unread? ? 'bg-amber-50/40' : '' %> hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5 align-top">
                  <% if notification.unread? %>
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500 mt-1.5" title="<%= t('notifications.index.unread') %>"></span>
                  <% else %>
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-gray-200 mt-1.5" title="<%= t('notifications.index.read') %>"></span>
                  <% end %>
                </td>
                <td class="p-3 align-top whitespace-nowrap">
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= notification_type_class(notification.notification_type) %> <%= notification_type_border_class(notification.notification_type) %>">
                    <%= notification_type_label(notification.notification_type) %>
                  </span>
                </td>
                <td class="p-3 align-top text-gray-900 font-medium whitespace-nowrap">
                  <%= notification_message_key_label(notification) %>
                </td>
                <td class="p-3 align-top text-gray-600">
                  <%= notification_message(notification) %>
                </td>
                <td class="p-3 align-top whitespace-nowrap text-gray-500">
                  <span class="block text-gray-900 tabular-nums"><%= l(notification.created_at, format: :short) %></span>
                  <span class="text-xs"><%= t("notifications.index.ago", time: time_ago_in_words(notification.created_at)) %></span>
                </td>
                <td class="p-3 pe-5 align-top text-end whitespace-nowrap">
                  <div class="inline-flex flex-wrap justify-end gap-2">
                    <% if notification.unread? && notification.ingredient %>
                      <%= link_to t("notifications.index.view_ingredient"),
                            admin_inventory_ingredient_path(notification.ingredient),
                            class: action_btn_class %>
                    <% end %>
                    <% if notification.unread? %>
                      <%= button_to t("notifications.index.mark_read"),
                            mark_read_admin_notification_path(notification),
                            method: :patch,
                            class: action_btn_class %>
                    <% else %>
                      <span class="inline-flex text-xs font-medium text-gray-400 px-3 py-1.5"><%= t("notifications.index.read") %></span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= render "admin/accounting/pagination", pagy: @pagy %>
    <% else %>
      <div class="p-12 text-center">
        <p class="text-gray-900 font-semibold mb-1"><%= t("notifications.index.empty_title") %></p>
        <p class="text-gray-500 text-sm"><%= t("notifications.index.empty_description") %></p>
        <% if @filtered %>
          <%= link_to t("notifications.index.show_all"), admin_notifications_path,
                class: "inline-flex mt-4 text-sm font-semibold text-amber-700 hover:text-amber-800 px-4 py-2 rounded-xl hover:bg-amber-50 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
