<h1 class="text-2xl font-bold mb-4"><%= admin_page_title %></h1>
<%= button_to "Mark all read", mark_all_read_admin_notifications_path, method: :patch, class: "text-sm text-gray-600 mb-4" %>
<ul class="bg-white shadow rounded-lg divide-y">
  <% @notifications.each do |n| %>
    <li class="p-4 <%= n.unread? ? 'bg-amber-50' : '' %>">
      <p class="text-sm"><%= n.message %></p>
      <p class="text-xs text-gray-500 mt-1"><%= time_ago_in_words(n.created_at) %> ago</p>
      <% if n.unread? && n.ingredient %>
        <%= link_to "View ingredient", admin_inventory_ingredient_path(n.ingredient), class: "text-xs text-amber-600" %>
      <% end %>
      <% if n.unread? %>
        <%= button_to "Mark read", mark_read_admin_notification_path(n), method: :patch, class: "text-xs text-blue-600 mt-1 block" %>
      <% end %>
    </li>
  <% end %>
</ul>
