<%# locals: menu_promo %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, menu_promo], class: "space-y-6",
      data: { searchable_select_options: menu_item_search_options(@menu_items) } do |f| %>
  <% if menu_promo.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= menu_promo.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.menu_promos.form_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.menu_promos.form_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("admin.menu_promos.name"), class: label_class %>
        <%= f.text_field :name, class: input_class, autofocus: true %>
      </div>
      <div>
        <%= f.label :menu_item_id, t("admin.menu_promos.menu_item"), class: label_class %>
        <%= render "shared/searchable_select", form: f, field: :menu_item_id,
              selected: menu_promo.menu_item_id,
              placeholder: t("admin.menu_promos.select_menu_item"),
              input_class: input_class %>
      </div>
      <div>
        <%= f.label :location_id, t("admin.menu_promos.location"), class: label_class %>
        <%= f.collection_select :location_id, @locations, :id, :name,
              { include_blank: t("admin.menu_promos.all_branches") },
              class: "#{input_class} appearance-none" %>
        <p class="text-xs text-gray-500 mt-1"><%= t("admin.menu_promos.location_hint") %></p>
      </div>
      <div>
        <%= f.label :promo_price_pounds, t("admin.menu_promos.price"), class: label_class %>
        <%= f.number_field :promo_price_pounds, min: 0, step: "0.01", class: input_class, required: true %>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :starts_at, t("admin.menu_promos.starts_at"), class: label_class %>
          <%= f.datetime_local_field :starts_at, class: input_class, required: true %>
        </div>
        <div>
          <%= f.label :ends_at, t("admin.menu_promos.ends_at"), class: label_class %>
          <%= f.datetime_local_field :ends_at, class: input_class, required: true %>
        </div>
      </div>
      <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3 space-y-3">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :highlight, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("admin.menu_promos.highlight_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("admin.menu_promos.highlight_hint") %></span>
          </span>
        </label>
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :active, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("admin.menu_promos.active_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("admin.menu_promos.active_hint") %></span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit menu_promo.persisted? ? t("actions.save_changes") : t("admin.menu_promos.create_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"), admin_menu_promos_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
