<%# locals: printer, menu_item_groups: [] %>
<% menu_item_groups = local_assigns.fetch(:menu_item_groups, []) %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, printer], class: "space-y-6 max-w-lg",
      data: {
        controller: "printer-form print-agent",
        print_agent_config_value: print_agent_config_json,
        printer_form_production_types_value: Printer::PRODUCTION_TYPES.to_json
      } do |f| %>
  <% if printer.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= printer.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("printers.form.identity") %></h2>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("printers.fields.name"), class: label_class %>
            <%= f.text_field :name, class: input_class, autofocus: true, required: true,
                  placeholder: t("printers.form.name_placeholder"),
                  data: { print_agent_target: "name" } %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :printer_type, t("printers.fields.type"), class: label_class %>
          <%= f.select :printer_type,
                Printer::PRINTER_TYPES.map { |tpe| [t("printers.types.#{tpe}"), tpe] },
                {}, class: input_class,
                data: {
                  printer_form_target: "printerType",
                  action: "change->printer-form#toggleMenuItems"
                } %>
        </div>
        <div>
          <%= f.label :location_id, t("printers.fields.branch"), class: label_class %>
          <%= f.collection_select :location_id, @locations, :id, :name, { prompt: t("printers.form.select_branch") },
                class: input_class, required: true %>
        </div>
      </div>

      <div>
        <%= f.label :station, t("printers.fields.station"), class: label_class %>
        <%= f.text_field :station, class: input_class, placeholder: t("printers.form.station_placeholder") %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("printers.form.station_hint") %></p>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("printers.form.connection") %></h2>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :connection_type, t("printers.fields.connection"), class: label_class %>
        <%= f.select :connection_type,
              Printer::CONNECTION_TYPES.map { |ct| [t("printers.connection_types.#{ct}"), ct] },
              {}, class: input_class, data: { printer_form_target: "connectionType", action: "change->printer-form#toggleNetwork" } %>
      </div>

      <div data-printer-form-target="networkFields" class="space-y-5 <%= "hidden" unless printer.network? %>">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div class="sm:col-span-2">
            <%= f.label :host, t("printers.fields.host"), class: label_class %>
            <%= f.text_field :host, class: input_class, placeholder: "192.168.1.50",
                  data: { print_agent_target: "host" } %>
          </div>
          <div>
            <%= f.label :port, t("printers.fields.port"), class: label_class %>
            <%= f.number_field :port, min: 1, max: 65535, class: input_class,
                  data: { print_agent_target: "port" } %>
          </div>
        </div>
        <% if Printing::Config.client_routing? %>
          <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3 space-y-3">
            <p class="text-xs text-gray-600"><%= t("printing.agent.discover_hint") %></p>
            <div class="flex flex-wrap gap-2 items-center">
              <button type="button"
                      data-print-agent-target="discoverButton"
                      data-action="click->print-agent#discover"
                      data-scanning-text="<%= t("printing.agent.scanning") %>"
                      class="inline-flex text-sm font-semibold text-indigo-700 hover:bg-indigo-50 px-4 py-2 rounded-xl border border-indigo-200 transition-colors">
                <%= t("printing.agent.discover_button") %>
              </button>
              <select data-print-agent-target="discoverSelect"
                      data-action="change->print-agent#applyDiscovery"
                      data-empty-text="<%= t("printing.agent.discover_empty") %>"
                      data-placeholder-text="<%= t("printing.agent.discover_placeholder") %>"
                      class="hidden flex-1 min-w-[12rem] <%= input_class %> appearance-none">
              </select>
            </div>
            <p class="text-xs text-red-700" data-print-agent-target="discoverStatus"></p>
          </div>
        <% end %>
        <p class="text-xs text-gray-500"><%= t("printers.form.network_hint") %></p>
      </div>

      <div data-printer-form-target="usbFields" class="space-y-3 <%= "hidden" unless printer.usb? %>">
        <div>
          <%= f.label :host, t("printers.fields.usb_device"), class: label_class %>
          <%= f.text_field :host, class: input_class, placeholder: "USB001",
                data: { printer_form_target: "usbDevice" } %>
        </div>
        <p class="text-xs text-gray-500"><%= t("printers.form.usb_hint") %></p>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("printers.form.options") %></h2>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :paper_width, t("printers.fields.paper_width"), class: label_class %>
        <%= f.select :paper_width, Printer::PAPER_WIDTHS, {}, class: input_class %>
      </div>

      <div>
        <%= f.label :notes, t("printers.fields.notes"), class: label_class %>
        <%= f.text_area :notes, rows: 3, class: "#{input_class} resize-y min-h-[4rem]" %>
      </div>

      <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3 space-y-3">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :active, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("printers.form.active_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("printers.form.active_hint") %></span>
          </span>
        </label>
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :is_default, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("printers.form.default_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("printers.form.default_hint") %></span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("printers.form.menu_items") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("printers.form.menu_items_hint") %></p>
    </div>
    <div class="p-5 <%= "hidden" unless printer.production_station? %>"
         data-printer-form-target="menuItemsSection">
      <% if menu_item_groups.any? %>
        <% selected_ids = printer.menu_item_ids.to_set %>
        <div data-controller="printer-menu-items"
             data-printer-menu-items-count-template-value="<%= t("printers.form.menu_items_selected", count: "%{count}") %>">
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <input type="search"
                   data-printer-menu-items-target="search"
                   data-action="input->printer-menu-items#filter keydown.enter->printer-menu-items#ignoreEnter"
                   placeholder="<%= t("printers.form.menu_items_search") %>"
                   autocomplete="off"
                   class="flex-1 min-w-[12rem] <%= input_class %>">
            <span class="text-xs font-semibold text-gray-600" data-printer-menu-items-target="count"></span>
          </div>

          <div class="max-h-[28rem] overflow-y-auto rounded-xl border border-gray-200">
            <% menu_item_groups.each do |category, items| %>
              <div data-printer-menu-items-target="group" data-category-name="<%= category.name %>"
                   class="border-b border-gray-100 last:border-b-0">
                <label class="sticky top-0 z-10 flex items-center gap-3 px-4 py-2 bg-gray-100/95 backdrop-blur cursor-pointer">
                  <input type="checkbox"
                         data-printer-menu-items-target="groupToggle"
                         data-action="change->printer-menu-items#toggleGroup"
                         title="<%= t("printers.form.menu_items_select_all") %>"
                         class="rounded border-gray-300 text-amber-600 focus:ring-amber-500/40">
                  <span class="flex-1 text-xs font-bold uppercase tracking-wide text-gray-700"><%= category.name %></span>
                  <span class="text-xs font-semibold text-gray-500 tabular-nums" data-group-count></span>
                </label>
                <div class="divide-y divide-gray-100">
                  <% items.each do |item| %>
                    <label data-printer-menu-items-target="item" data-item-name="<%= item.name %>"
                           class="flex items-center gap-3 ps-10 pe-4 py-2 hover:bg-gray-50 cursor-pointer">
                      <%= check_box_tag "printer[menu_item_ids][]", item.id, selected_ids.include?(item.id),
                            id: "printer_menu_item_#{item.id}",
                            data: { action: "change->printer-menu-items#refresh" },
                            class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
                      <span class="text-sm font-medium text-gray-900"><%= item.name %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
            <p class="hidden px-4 py-6 text-sm text-center text-gray-500" data-printer-menu-items-target="empty">
              <%= t("printers.form.menu_items_no_match") %>
            </p>
          </div>
        </div>
        <%= hidden_field_tag "printer[menu_item_ids][]", "" %>
      <% else %>
        <p class="text-sm text-gray-500"><%= t("printers.form.menu_items_empty") %></p>
      <% end %>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit printer.persisted? ? t("actions.save_changes") : t("printers.actions.create"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"),
          printer.persisted? ? admin_printer_path(printer) : admin_printers_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
