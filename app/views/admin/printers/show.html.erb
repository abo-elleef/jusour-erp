<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-3xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @printer.name %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("printers.types.#{@printer.printer_type}") %> · <%= @printer.connection_summary %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @printer.network? && policy(@printer).test_print? %>
        <%= button_to t("printing.test.button"), test_print_admin_printer_path(@printer), method: :post,
              class: "inline-flex text-sm font-semibold text-indigo-700 hover:bg-indigo-50 px-4 py-2.5 rounded-xl border border-indigo-200 transition-colors" %>
      <% end %>
      <% if policy(@printer).update? %>
        <%= link_to t("actions.edit"), edit_admin_printer_path(@printer),
              class: "inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
      <% end %>
      <% if policy(@printer).destroy? %>
        <%= button_to t("actions.delete"), admin_printer_path(@printer), method: :delete,
              class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors",
              form: { data: { turbo_confirm: t("printers.confirm_delete") } } %>
      <% end %>
    </div>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <dl class="divide-y divide-gray-100 text-sm">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-4">
        <dt class="text-gray-500 font-medium"><%= t("printers.fields.type") %></dt>
        <dd class="sm:col-span-2 text-gray-900"><%= t("printers.types.#{@printer.printer_type}") %></dd>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-4">
        <dt class="text-gray-500 font-medium"><%= t("printers.fields.connection") %></dt>
        <dd class="sm:col-span-2 text-gray-900"><%= t("printers.connection_types.#{@printer.connection_type}") %></dd>
      </div>
      <% if @printer.network? %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-4">
          <dt class="text-gray-500 font-medium"><%= t("printers.fields.host") %></dt>
          <dd class="sm:col-span-2 text-gray-900 font-mono"><%= @printer.host %>:<%= @printer.port %></dd>
        </div>
      <% end %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-4">
        <dt class="text-gray-500 font-medium"><%= t("printers.fields.location") %></dt>
        <dd class="sm:col-span-2 text-gray-900"><%= @printer.location.presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-4">
        <dt class="text-gray-500 font-medium"><%= t("printers.fields.paper_width") %></dt>
        <dd class="sm:col-span-2 text-gray-900"><%= @printer.paper_width %></dd>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-4">
        <dt class="text-gray-500 font-medium"><%= t("printers.fields.status") %></dt>
        <dd class="sm:col-span-2">
          <% if @printer.active? %>
            <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200">
              <%= t("printers.status.active") %>
            </span>
          <% else %>
            <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
              <%= t("printers.status.inactive") %>
            </span>
          <% end %>
          <% if @printer.is_default? %>
            <span class="ms-2 text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-200">
              <%= t("printers.labels.default") %>
            </span>
          <% end %>
        </dd>
      </div>
      <% if @printer.notes.present? %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-4">
          <dt class="text-gray-500 font-medium"><%= t("printers.fields.notes") %></dt>
          <dd class="sm:col-span-2 text-gray-900 whitespace-pre-wrap"><%= @printer.notes %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <% if @printer.network? && @connection_check %>
    <section class="rounded-2xl border <%= @connection_check[:ok] ? 'border-green-200 bg-green-50/50' : 'border-red-200 bg-red-50/50' %> overflow-hidden mt-6">
      <div class="px-5 py-4 border-b <%= @connection_check[:ok] ? 'border-green-100' : 'border-red-100' %>">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("printing.connection.title") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("printing.connection.hint") %></p>
      </div>
      <div class="px-5 py-4 text-sm">
        <% if @connection_check[:ok] %>
          <p class="font-semibold text-green-800"><%= t("printing.connection.ok", ms: @connection_check[:latency_ms]) %></p>
          <p class="text-green-700 mt-1"><%= t("printing.connection.ok_detail", host: @printer.host, port: @printer.port) %></p>
        <% else %>
          <p class="font-semibold text-red-800"><%= t("printing.connection.failed") %></p>
          <p class="text-red-700 mt-2"><%= @connection_check[:error] %></p>
          <p class="text-gray-600 mt-3 font-mono text-xs bg-white/80 border border-red-100 rounded-xl px-3 py-2">
            nc -zv <%= @printer.host %> <%= @printer.port %>
          </p>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @recent_print_logs&.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mt-6">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("printing.logs.title") %></h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[480px]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5"><%= t("printing.logs.time") %></th>
              <th class="p-3"><%= t("printing.logs.order") %></th>
              <th class="p-3"><%= t("printing.logs.status") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @recent_print_logs.each do |log| %>
              <tr>
                <td class="p-3 ps-5 text-gray-600 whitespace-nowrap"><%= l(log.created_at, format: :short) %></td>
                <td class="p-3 font-medium"><%= log.order&.order_number || "—" %></td>
                <td class="p-3">
                  <% badge = case log.status
                             when "sent" then "bg-green-100 text-green-800 border-green-200"
                             when "failed" then "bg-red-100 text-red-800 border-red-200"
                             else "bg-gray-100 text-gray-700 border-gray-200"
                             end %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= badge %>"
                        title="<%= log.error_message %>">
                    <%= t("printing.logs.statuses.#{log.status}") %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <div class="mt-6">
    <%= link_to t("printers.actions.back"), admin_printers_path,
          class: "text-sm font-semibold text-amber-700 hover:text-amber-800" %>
  </div>
</div>
