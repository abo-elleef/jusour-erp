<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("printers.index.description") %></p>
    </div>
    <% if policy(Printer).create? %>
      <%= link_to new_admin_printer_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
        <span aria-hidden="true">+</span> <%= t("printers.actions.new") %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
    <%= link_to admin_printers_path,
          class: orders_stat_card_class(@q.active_eq.blank? && !@filtered) do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("printers.stats.total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @total_count %></p>
    <% end %>

    <%= link_to admin_printers_path(q: { active_eq: true }),
          class: orders_stat_card_class(@q.active_eq == true || @q.active_eq == "true") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("printers.stats.active") %></p>
      <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= @active_count %></p>
    <% end %>

    <% if @inactive_count.positive? %>
      <%= link_to admin_printers_path(q: { active_eq: false }),
            class: orders_stat_card_class(@q.active_eq == false || @q.active_eq == "false") do %>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("printers.stats.inactive") %></p>
        <p class="text-2xl font-bold mt-1 text-gray-600 tabular-nums"><%= @inactive_count %></p>
      <% end %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("printers.filters.title") %></h2>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_printers_path, method: :get, class: "flex flex-wrap items-end gap-4" do |f| %>
        <div class="flex-1 min-w-[12rem]">
          <%= f.label :name_cont, t("printers.fields.name"), class: label_class %>
          <%= f.search_field :name_cont, placeholder: t("printers.filters.name_placeholder"), class: input_class %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :printer_type_eq, t("printers.fields.type"), class: label_class %>
          <%= f.select :printer_type_eq,
                options_for_select([[t("printers.filters.all_types"), ""]] + Printer::PRINTER_TYPES.map { |tpe| [t("printers.types.#{tpe}"), tpe] }, @q.printer_type_eq),
                {}, class: input_class %>
        </div>
        <%= f.submit t("actions.apply_search"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
        <% if @filtered %>
          <%= link_to t("actions.clear"), admin_printers_path,
                class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
      <% end %>
    </div>
  </section>

  <% if @printers.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[720px]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5"><%= t("printers.fields.name") %></th>
              <th class="p-3"><%= t("printers.fields.type") %></th>
              <th class="p-3 hidden md:table-cell"><%= t("printers.fields.connection") %></th>
              <th class="p-3 hidden lg:table-cell"><%= t("printers.fields.branch") %></th>
              <th class="p-3 hidden xl:table-cell"><%= t("printers.fields.station") %></th>
              <th class="p-3"><%= t("printers.fields.status") %></th>
              <th class="p-3 pe-5 text-end"><%= t("printers.fields.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @printers.each do |printer| %>
              <tr class="hover:bg-gray-50/60 transition-colors">
                <td class="p-3 ps-5">
                  <%= link_to printer.name, admin_printer_path(printer),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                  <% if printer.is_default? %>
                    <span class="ms-2 text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200">
                      <%= t("printers.labels.default") %>
                    </span>
                  <% end %>
                </td>
                <td class="p-3 text-gray-700"><%= t("printers.types.#{printer.printer_type}") %></td>
                <td class="p-3 hidden md:table-cell text-gray-600 font-mono text-xs"><%= printer.connection_summary %></td>
                <td class="p-3 hidden lg:table-cell text-gray-600"><%= printer.location&.name || "—" %></td>
                <td class="p-3 hidden xl:table-cell text-gray-600"><%= printer.station.presence || "—" %></td>
                <td class="p-3">
                  <% if printer.active? %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200">
                      <%= t("printers.status.active") %>
                    </span>
                  <% else %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                      <%= t("printers.status.inactive") %>
                    </span>
                  <% end %>
                </td>
                <td class="p-3 pe-5 text-end whitespace-nowrap">
                  <div class="inline-flex gap-2">
                    <%= link_to t("actions.view"), admin_printer_path(printer),
                          class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                    <% if policy(printer).update? %>
                      <%= link_to t("actions.edit"), edit_admin_printer_path(printer),
                            class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("printers.empty.title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("printers.empty.description") %></p>
      <% if policy(Printer).create? %>
        <%= link_to t("printers.actions.new"), new_admin_printer_path,
              class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </section>
  <% end %>
</div>
