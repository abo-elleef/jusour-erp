<% content_for :title, t("accounting.chart_of_accounts.title") %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.chart_of_accounts.title") %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= t("accounting.chart_of_accounts.description") %></p>
    </div>
  </div>

  <%= render "admin/accounting/date_range_form" %>

  <%# ── Balance Sheet Summary ─────────────────────────────────────── %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-5">
      <p class="text-xs font-semibold text-blue-700 uppercase tracking-wide"><%= t("accounting.chart_of_accounts.total_assets") %></p>
      <p class="text-3xl font-bold text-blue-900 tabular-nums mt-2"><%= format_money(@coa.total_assets_cents) %></p>
      <p class="text-xs text-blue-600 mt-1"><%= t("accounting.chart_of_accounts.assets_hint") %></p>
    </div>
    <div class="rounded-2xl border border-red-200 bg-red-50/60 p-5">
      <p class="text-xs font-semibold text-red-700 uppercase tracking-wide"><%= t("accounting.chart_of_accounts.total_liabilities") %></p>
      <p class="text-3xl font-bold text-red-900 tabular-nums mt-2"><%= format_money(@coa.total_liabilities_cents) %></p>
      <p class="text-xs text-red-600 mt-1"><%= t("accounting.chart_of_accounts.liabilities_hint") %></p>
    </div>
    <div class="rounded-2xl border <%= @coa.total_equity_cents >= 0 ? 'border-emerald-200 bg-emerald-50/60' : 'border-orange-200 bg-orange-50/60' %> p-5">
      <p class="text-xs font-semibold <%= @coa.total_equity_cents >= 0 ? 'text-emerald-700' : 'text-orange-700' %> uppercase tracking-wide"><%= t("accounting.chart_of_accounts.total_equity") %></p>
      <p class="text-3xl font-bold <%= @coa.total_equity_cents >= 0 ? 'text-emerald-900' : 'text-orange-900' %> tabular-nums mt-2"><%= format_money(@coa.total_equity_cents) %></p>
      <p class="text-xs <%= @coa.total_equity_cents >= 0 ? 'text-emerald-600' : 'text-orange-600' %> mt-1"><%= t("accounting.chart_of_accounts.equity_hint") %></p>
    </div>
  </div>

  <%# ── P&L Summary ────────────────────────────────────────────────── %>
  <div class="flex items-center gap-2 mb-3">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.chart_of_accounts.pl_period") %></p>
    <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200 font-medium tabular-nums">
      <%= l(@start_date, format: :long) %> → <%= l(@end_date, format: :long) %>
    </span>
  </div>
  <%# Note: Revenue/Expense totals are all-time P&L figures computed independently from treasury cash flows.
      Some auto-generated costs (COGS, labor) do not move treasury balances, so Net Income and Equity
      are intentionally computed on different bases — this is normal before formal closing entries. %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.chart_of_accounts.total_revenue") %></p>
      <p class="text-2xl font-bold text-gray-900 tabular-nums mt-2"><%= format_money(@coa.total_revenue_cents) %></p>
      <p class="text-xs text-gray-500 mt-1 tabular-nums"><%= l(@start_date, format: :short) %> – <%= l(@end_date, format: :short) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.chart_of_accounts.total_expenses") %></p>
      <p class="text-2xl font-bold text-gray-900 tabular-nums mt-2"><%= format_money(@coa.total_expenses_cents) %></p>
      <p class="text-xs text-gray-500 mt-1 tabular-nums"><%= l(@start_date, format: :short) %> – <%= l(@end_date, format: :short) %></p>
    </div>
    <div class="rounded-2xl border <%= @coa.net_income_cents >= 0 ? 'border-emerald-200 bg-emerald-50/40' : 'border-red-200 bg-red-50/40' %> p-5">
      <p class="text-xs font-semibold <%= @coa.net_income_cents >= 0 ? 'text-emerald-700' : 'text-red-700' %> uppercase tracking-wide"><%= t("accounting.chart_of_accounts.net_income") %></p>
      <p class="text-2xl font-bold <%= @coa.net_income_cents >= 0 ? 'text-emerald-800' : 'text-red-800' %> tabular-nums mt-2"><%= format_money(@coa.net_income_cents) %></p>
      <p class="text-xs text-gray-500 mt-1 tabular-nums"><%= l(@start_date, format: :short) %> – <%= l(@end_date, format: :short) %></p>
    </div>
  </div>

  <%# ── Account Ledger ─────────────────────────────────────────────── %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.chart_of_accounts.ledger_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("accounting.chart_of_accounts.ledger_hint") %></p>
    </div>

    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5 text-start w-20"><%= t("accounting.chart_of_accounts.col_code") %></th>
          <th class="p-3 text-start"><%= t("accounting.chart_of_accounts.col_account") %></th>
          <th class="p-3 text-start"><%= t("accounting.chart_of_accounts.col_type") %></th>
          <th class="p-3 pe-5 text-end"><%= t("accounting.chart_of_accounts.col_balance") %></th>
        </tr>
      </thead>

      <%# ── ASSETS ────────────────────────────────────────────────────── %>
      <tbody data-controller="collapsible-section" class="divide-y divide-gray-100 table-zebra">
        <tr class="bg-blue-50/40 cursor-pointer select-none hover:bg-blue-100/40 transition-colors"
            data-action="click->collapsible-section#toggle">
          <td colspan="4" class="px-5 py-2.5">
            <span class="inline-flex items-center gap-2 text-xs font-bold text-blue-700 uppercase tracking-widest">
              <svg data-collapsible-section-target="chevron"
                   class="w-3.5 h-3.5 transition-transform duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
              <%= t("accounting.chart_of_accounts.group_assets") %>
              <span class="font-normal normal-case tracking-normal text-blue-500 ms-1"><%= format_money(@coa.total_assets_cents) %></span>
            </span>
          </td>
        </tr>

        <tr class="bg-blue-50/20" data-collapsible-section-target="content">
          <td colspan="4" class="px-8 py-1.5 text-xs font-semibold text-blue-600 italic">
            <%= t("accounting.chart_of_accounts.group_current_assets") %>
          </td>
        </tr>
        <% @coa.current_asset_lines.each do |line| %>
          <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
            <td class="p-3 ps-8 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
            <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
            <td class="p-3">
              <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                <%= t("accounting.chart_of_accounts.subtypes.#{line.subtype}", default: line.subtype.humanize) %>
              </span>
            </td>
            <td class="p-3 pe-5 text-end font-semibold tabular-nums text-blue-800"><%= format_money(line.balance_cents) %></td>
          </tr>
        <% end %>
        <tr class="bg-blue-50/30" data-collapsible-section-target="content">
          <td colspan="3" class="p-2 ps-8 text-xs font-semibold text-blue-700 text-end"><%= t("accounting.chart_of_accounts.subtotal_current_assets") %></td>
          <td class="p-2 pe-5 text-end font-semibold tabular-nums text-blue-800"><%= format_money(@coa.total_current_assets_cents) %></td>
        </tr>

        <tr class="bg-blue-50/20" data-collapsible-section-target="content">
          <td colspan="4" class="px-8 py-1.5 text-xs font-semibold text-blue-600 italic">
            <%= t("accounting.chart_of_accounts.group_non_current_assets") %>
          </td>
        </tr>
        <% if @coa.non_current_asset_lines.any? %>
          <% @coa.non_current_asset_lines.each do |line| %>
            <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
              <td class="p-3 ps-8 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
              <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
              <td class="p-3">
                <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                  <%= t("accounting.chart_of_accounts.subtypes.#{line.subtype}", default: line.subtype.humanize) %>
                </span>
              </td>
              <td class="p-3 pe-5 text-end font-semibold tabular-nums text-blue-800"><%= format_money(line.balance_cents) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr data-collapsible-section-target="content">
            <td colspan="4" class="p-3 ps-8 text-xs text-gray-400 italic"><%= t("accounting.chart_of_accounts.no_non_current_assets") %></td>
          </tr>
        <% end %>
        <tr class="bg-blue-50/30" data-collapsible-section-target="content">
          <td colspan="3" class="p-2 ps-8 text-xs font-semibold text-blue-700 text-end"><%= t("accounting.chart_of_accounts.subtotal_non_current_assets") %></td>
          <td class="p-2 pe-5 text-end font-semibold tabular-nums text-blue-800"><%= format_money(@coa.total_non_current_assets_cents) %></td>
        </tr>

        <tr class="bg-blue-50/60 border-t border-blue-100" data-collapsible-section-target="content">
          <td colspan="3" class="p-3 ps-5 text-xs font-bold text-blue-800 text-end"><%= t("accounting.chart_of_accounts.total_assets") %></td>
          <td class="p-3 pe-5 text-end font-bold tabular-nums text-blue-900"><%= format_money(@coa.total_assets_cents) %></td>
        </tr>
      </tbody>

      <%# ── LIABILITIES ────────────────────────────────────────────────── %>
      <tbody data-controller="collapsible-section" class="divide-y divide-gray-100 table-zebra">
        <tr class="bg-red-50/40 cursor-pointer select-none hover:bg-red-100/40 transition-colors"
            data-action="click->collapsible-section#toggle">
          <td colspan="4" class="px-5 py-2.5">
            <span class="inline-flex items-center gap-2 text-xs font-bold text-red-700 uppercase tracking-widest">
              <svg data-collapsible-section-target="chevron"
                   class="w-3.5 h-3.5 transition-transform duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
              <%= t("accounting.chart_of_accounts.group_liabilities") %>
              <span class="font-normal normal-case tracking-normal text-red-400 ms-1"><%= format_money(@coa.total_liabilities_cents) %></span>
            </span>
          </td>
        </tr>

        <tr class="bg-red-50/20" data-collapsible-section-target="content">
          <td colspan="4" class="px-8 py-1.5 text-xs font-semibold text-red-600 italic">
            <%= t("accounting.chart_of_accounts.group_accounts_payable") %>
          </td>
        </tr>
        <% if @coa.ap_liability_lines.any? %>
          <% @coa.ap_liability_lines.each do |line| %>
            <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
              <td class="p-3 ps-8 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
              <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
              <td class="p-3">
                <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-red-100 text-red-800 border border-red-200">
                  <%= t("accounting.chart_of_accounts.subtypes.accounts_payable") %>
                </span>
              </td>
              <td class="p-3 pe-5 text-end font-semibold tabular-nums text-red-800"><%= format_money(line.balance_cents) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr data-collapsible-section-target="content">
            <td colspan="4" class="p-3 ps-8 text-xs text-gray-400 italic"><%= t("accounting.chart_of_accounts.no_liabilities") %></td>
          </tr>
        <% end %>

        <tr class="bg-red-50/20" data-collapsible-section-target="content">
          <td colspan="4" class="px-8 py-1.5 text-xs font-semibold text-red-600 italic">
            <%= t("accounting.chart_of_accounts.group_loans") %>
          </td>
        </tr>
        <% if @coa.loan_liability_lines.any? %>
          <% @coa.loan_liability_lines.each do |line| %>
            <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
              <td class="p-3 ps-8 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
              <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
              <td class="p-3">
                <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-red-100 text-red-800 border border-red-200">
                  <%= t("accounting.loans.types.#{line.subtype}", default: line.subtype.humanize) %>
                </span>
              </td>
              <td class="p-3 pe-5 text-end font-semibold tabular-nums text-red-800"><%= format_money(line.balance_cents) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr data-collapsible-section-target="content">
            <td colspan="4" class="p-3 ps-8 text-xs text-gray-400 italic"><%= t("accounting.chart_of_accounts.no_loans") %></td>
          </tr>
        <% end %>

        <% if @coa.other_liability_lines.any? %>
          <tr class="bg-red-50/20" data-collapsible-section-target="content">
            <td colspan="4" class="px-8 py-1.5 text-xs font-semibold text-red-600 italic">
              <%= t("accounting.chart_of_accounts.group_other_liabilities") %>
            </td>
          </tr>
          <% @coa.other_liability_lines.each do |line| %>
            <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
              <td class="p-3 ps-8 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
              <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
              <td class="p-3">
                <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-red-100 text-red-800 border border-red-200">
                  <%= t("accounting.chart_of_accounts.subtypes.other_payable") %>
                </span>
              </td>
              <td class="p-3 pe-5 text-end font-semibold tabular-nums text-red-800"><%= format_money(line.balance_cents) %></td>
            </tr>
          <% end %>
        <% end %>

        <tr class="bg-red-50/60 border-t border-red-100" data-collapsible-section-target="content">
          <td colspan="3" class="p-3 ps-5 text-xs font-bold text-red-800 text-end"><%= t("accounting.chart_of_accounts.total_liabilities") %></td>
          <td class="p-3 pe-5 text-end font-bold tabular-nums text-red-900"><%= format_money(@coa.total_liabilities_cents) %></td>
        </tr>
      </tbody>

      <%# ── EQUITY ────────────────────────────────────────────────────── %>
      <% retained = @coa.equity_lines.first %>
      <tbody data-controller="collapsible-section" class="divide-y divide-gray-100 table-zebra">
        <tr class="bg-emerald-50/40 cursor-pointer select-none hover:bg-emerald-100/40 transition-colors"
            data-action="click->collapsible-section#toggle">
          <td colspan="4" class="px-5 py-2.5">
            <span class="inline-flex items-center gap-2 text-xs font-bold text-emerald-700 uppercase tracking-widest">
              <svg data-collapsible-section-target="chevron"
                   class="w-3.5 h-3.5 transition-transform duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
              <%= t("accounting.chart_of_accounts.group_equity") %>
              <span class="font-normal normal-case tracking-normal <%= @coa.total_equity_cents >= 0 ? 'text-emerald-500' : 'text-red-400' %> ms-1"><%= format_money(@coa.total_equity_cents) %></span>
            </span>
          </td>
        </tr>

        <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
          <td class="p-3 ps-5 text-gray-400 tabular-nums font-mono text-xs"><%= retained.code %></td>
          <td class="p-3 font-medium text-gray-900"><%= retained.name %></td>
          <td class="p-3">
            <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
              <%= t("accounting.chart_of_accounts.subtypes.retained_earnings") %>
            </span>
          </td>
          <td class="p-3 pe-5 text-end font-semibold tabular-nums <%= retained.balance_cents >= 0 ? 'text-emerald-800' : 'text-red-700' %>">
            <%= format_money(retained.balance_cents) %>
          </td>
        </tr>

        <% if @coa.partner_equity_lines.any? %>
          <tr class="bg-emerald-50/20" data-collapsible-section-target="content">
            <td colspan="4" class="px-8 py-1.5 text-xs font-semibold text-emerald-600 italic">
              <%= t("accounting.chart_of_accounts.group_partner_accounts") %>
            </td>
          </tr>
          <% @coa.partner_equity_lines.each do |line| %>
            <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
              <td class="p-3 ps-8 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
              <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
              <td class="p-3">
                <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                  <%= t("accounting.chart_of_accounts.subtypes.partner_account") %>
                </span>
              </td>
              <td class="p-3 pe-5 text-end font-semibold tabular-nums <%= line.balance_cents >= 0 ? 'text-emerald-800' : 'text-red-700' %>">
                <%= format_money(line.balance_cents) %>
              </td>
            </tr>
          <% end %>
        <% end %>

        <tr class="bg-emerald-50/60 border-t border-emerald-100" data-collapsible-section-target="content">
          <td colspan="3" class="p-3 ps-5 text-xs font-bold text-emerald-800 text-end"><%= t("accounting.chart_of_accounts.total_equity") %></td>
          <td class="p-3 pe-5 text-end font-bold tabular-nums <%= @coa.total_equity_cents >= 0 ? 'text-emerald-900' : 'text-red-800' %>">
            <%= format_money(@coa.total_equity_cents) %>
          </td>
        </tr>
      </tbody>

      <%# ── REVENUE ────────────────────────────────────────────────────── %>
      <tbody data-controller="collapsible-section" class="divide-y divide-gray-100 table-zebra">
        <tr class="bg-gray-100/60 cursor-pointer select-none hover:bg-gray-200/40 transition-colors"
            data-action="click->collapsible-section#toggle">
          <td colspan="4" class="px-5 py-2.5">
            <span class="inline-flex items-center gap-2 text-xs font-bold text-gray-600 uppercase tracking-widest">
              <svg data-collapsible-section-target="chevron"
                   class="w-3.5 h-3.5 transition-transform duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
              <%= t("accounting.chart_of_accounts.group_revenue") %>
              <span class="font-normal normal-case tracking-normal text-gray-400 ms-1"><%= format_money(@coa.total_revenue_cents) %></span>
            </span>
          </td>
        </tr>
        <% @coa.revenue_lines.each do |line| %>
          <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
            <td class="p-3 ps-5 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
            <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
            <td class="p-3">
              <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                <%= t("accounting.chart_of_accounts.subtypes.income") %>
              </span>
            </td>
            <td class="p-3 pe-5 text-end font-semibold tabular-nums text-gray-800"><%= format_money(line.balance_cents) %></td>
          </tr>
        <% end %>
        <tr class="bg-gray-100/80 border-t border-gray-200" data-collapsible-section-target="content">
          <td colspan="3" class="p-3 ps-5 text-xs font-bold text-gray-700 text-end"><%= t("accounting.chart_of_accounts.total_revenue") %></td>
          <td class="p-3 pe-5 text-end font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_revenue_cents) %></td>
        </tr>
      </tbody>

      <%# ── EXPENSES ────────────────────────────────────────────────────── %>
      <tbody data-controller="collapsible-section" class="divide-y divide-gray-100 table-zebra">
        <tr class="bg-gray-100/60 cursor-pointer select-none hover:bg-gray-200/40 transition-colors"
            data-action="click->collapsible-section#toggle">
          <td colspan="4" class="px-5 py-2.5">
            <span class="inline-flex items-center gap-2 text-xs font-bold text-gray-600 uppercase tracking-widest">
              <svg data-collapsible-section-target="chevron"
                   class="w-3.5 h-3.5 transition-transform duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
              <%= t("accounting.chart_of_accounts.group_expenses") %>
              <span class="font-normal normal-case tracking-normal text-gray-400 ms-1"><%= format_money(@coa.total_expenses_cents) %></span>
            </span>
          </td>
        </tr>
        <% @coa.expense_lines.each do |line| %>
          <tr class="hover:bg-gray-50 transition-colors" data-collapsible-section-target="content">
            <td class="p-3 ps-5 text-gray-400 tabular-nums font-mono text-xs"><%= line.code %></td>
            <td class="p-3 font-medium text-gray-900"><%= line.name %></td>
            <td class="p-3">
              <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                <%= t("accounting.chart_of_accounts.subtypes.#{line.subtype}", default: line.subtype.humanize) %>
              </span>
            </td>
            <td class="p-3 pe-5 text-end font-semibold tabular-nums text-gray-800"><%= format_money(line.balance_cents) %></td>
          </tr>
        <% end %>
        <tr class="bg-gray-100/80 border-t border-gray-200" data-collapsible-section-target="content">
          <td colspan="3" class="p-3 ps-5 text-xs font-bold text-gray-700 text-end"><%= t("accounting.chart_of_accounts.total_expenses") %></td>
          <td class="p-3 pe-5 text-end font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_expenses_cents) %></td>
        </tr>
      </tbody>

      <%# ── NET INCOME (always visible) ─────────────────────────────────── %>
      <tbody>
        <tr class="border-t-2 border-gray-300 <%= @coa.net_income_cents >= 0 ? 'bg-emerald-50/60' : 'bg-red-50/60' %>">
          <td colspan="3" class="p-4 ps-5 text-sm font-bold <%= @coa.net_income_cents >= 0 ? 'text-emerald-800' : 'text-red-800' %> text-end">
            <%= t("accounting.chart_of_accounts.net_income") %>
          </td>
          <td class="p-4 pe-5 text-end text-lg font-bold tabular-nums <%= @coa.net_income_cents >= 0 ? 'text-emerald-900' : 'text-red-900' %>">
            <%= format_money(@coa.net_income_cents) %>
          </td>
        </tr>
      </tbody>
    </table>
  </section>
</div>
