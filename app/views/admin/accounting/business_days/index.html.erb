
<div class="max-w-full">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.business_days.title") %></h1>
      <p class="text-sm text-gray-600 mt-1"><%= t("accounting.business_days.description") %></p>
    </div>
    <% if @any_manual %>
      <%= button_to t("accounting.business_days.advance_all"),
            advance_all_admin_accounting_business_days_path,
            method: :post,
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl",
            data: { turbo_confirm: t("accounting.business_days.advance_all_confirm") } %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.business_days.company_defaults") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("accounting.business_days.company_defaults_hint") %></p>
    </div>
    <div class="p-5">
      <% if @can_configure_company %>
        <%= form_with url: update_defaults_admin_accounting_business_days_path, method: :patch, class: "flex flex-wrap items-end gap-3" do %>
          <div>
            <%= label_tag :business_day_start_hour, t("accounting.business_days.company_start_hour"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <div class="flex items-center gap-2">
              <%= number_field_tag :business_day_start_hour, @company_start_hour, min: 0, max: 23, class: "#{pos_input_class} max-w-28" %>
              <span class="text-sm text-gray-500"><%= t("settings.operations.oclock") %></span>
            </div>
          </div>
          <%= submit_tag t("actions.save"), class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-700">
          <%= t("accounting.business_days.start_hour_value", hour: @company_start_hour) %>
          <span class="text-xs text-gray-500 ms-2"><%= t("accounting.business_days.owner_configure_hint") %></span>
        </p>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm min-w-[48rem]">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("accounting.business_days.branch") %></th>
            <th class="p-3 text-start"><%= t("accounting.business_days.mode") %></th>
            <th class="p-3 text-start"><%= t("accounting.business_days.start_hour") %></th>
            <th class="p-3 text-start"><%= t("accounting.business_days.current_day") %></th>
            <th class="p-3 text-start"><%= t("accounting.business_days.open_drawers") %></th>
            <th class="p-3 pe-5 text-end"><%= t("accounting.business_days.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @rows.each do |row| %>
            <% location = row[:location] %>
            <tr>
              <td class="p-3 ps-5 font-medium text-gray-900 align-middle"><%= location.name %></td>
              <% if @can_configure %>
                <td class="p-3 align-middle" colspan="2">
                  <%= form_with url: admin_accounting_business_day_path(location.id),
                        method: :patch,
                        class: "flex flex-wrap items-center gap-2",
                        data: { turbo: true } do %>
                    <%= select_tag :business_day_mode,
                          options_for_select(
                            [
                              [t("accounting.business_days.mode_automatic"), "automatic"],
                              [t("accounting.business_days.mode_manual"), "manual"]
                            ],
                            BusinessDay.mode(location: location)
                          ),
                          class: "#{pos_input_class} min-w-[9.5rem]",
                          onchange: "this.form.requestSubmit()" %>
                    <div class="flex items-center gap-1">
                      <%= number_field_tag :business_day_start_hour, location.business_day_start_hour,
                            min: 0, max: 23,
                            class: "#{pos_input_class} w-20",
                            placeholder: @company_start_hour %>
                      <span class="text-xs text-gray-500"><%= t("settings.operations.oclock") %></span>
                    </div>
                    <%= submit_tag t("actions.save"),
                          class: "bg-gray-900 hover:bg-gray-800 text-white text-xs font-semibold px-3 py-2 rounded-lg" %>
                  <% end %>
                  <% unless row[:start_hour_overridden] %>
                    <p class="text-xs text-gray-400 mt-1"><%= t("accounting.business_days.uses_company_default", hour: @company_start_hour) %></p>
                  <% end %>
                </td>
              <% else %>
                <td class="p-3 align-middle">
                  <%= row[:manual?] ? t("accounting.business_days.mode_manual") : t("accounting.business_days.mode_automatic") %>
                </td>
                <td class="p-3 tabular-nums text-gray-700 align-middle">
                  <%= t("accounting.business_days.start_hour_value", hour: row[:start_hour]) %>
                  <% unless row[:start_hour_overridden] %>
                    <span class="text-xs text-gray-400 block"><%= t("accounting.business_days.company_default") %></span>
                  <% end %>
                </td>
              <% end %>
              <td class="p-3 tabular-nums align-middle"><%= l(row[:business_date], format: :long) %></td>
              <td class="p-3 align-middle">
                <% if row[:open_drawer_count].positive? %>
                  <span class="text-amber-800 font-medium"><%= row[:open_drawer_count] %></span>
                  <span class="text-xs text-gray-500 block"><%= row[:open_drawer_names].join(", ") %></span>
                <% else %>
                  <span class="text-green-700"><%= t("accounting.business_days.clear") %></span>
                <% end %>
              </td>
              <td class="p-3 pe-5 text-end align-middle">
                <% if row[:manual?] %>
                  <%= button_to t("accounting.business_days.advance"),
                        advance_admin_accounting_business_days_path(location_id: location.id),
                        method: :post,
                        class: "text-amber-700 text-xs font-semibold hover:underline disabled:opacity-40",
                        disabled: !row[:clear?],
                        data: { turbo_confirm: t("accounting.business_days.advance_confirm",
                          branch: location.name,
                          date: l(row[:business_date] + 1.day, format: :long)) } %>
                <% else %>
                  <span class="text-gray-400 text-xs"><%= t("accounting.business_days.automatic_flip") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
