<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= render "admin/accounting/nav" %>
<div class="max-w-7xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2"><%= t("accounting.audit_log.title") %></h1>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.audit_log.filters") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("accounting.audit_log.filters_hint") %></p>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_accounting_audit_log_index_path, method: :get,
            class: "flex flex-wrap items-end gap-4" do |f| %>
        <div class="min-w-[10rem]">
          <%= f.label :logged_on_eq, t("accounting.shared.day"), class: label_class %>
          <%= f.date_field :logged_on_eq, class: input_class %>
        </div>
        <div class="min-w-[12rem]">
          <%= f.label :user_id_eq, t("accounting.audit_log.user"), class: label_class %>
          <%= f.select :user_id_eq,
                options_from_collection_for_select(@users, :id, :name, @q.user_id_eq),
                { include_blank: t("accounting.audit_log.all_users") },
                class: "#{input_class} appearance-none" %>
        </div>
        <div class="min-w-[14rem]">
          <%= f.label :action_eq, t("accounting.audit_log.action"), class: label_class %>
          <%= f.select :action_eq,
                options_for_select(@actions, @q.action_eq),
                { include_blank: t("accounting.audit_log.all_actions") },
                class: "#{input_class} appearance-none font-mono text-xs" %>
        </div>
        <%= f.submit t("actions.apply_filters"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
        <% if @filtered %>
          <%= link_to t("actions.clear"), admin_accounting_audit_log_index_path,
                class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
        <span class="text-sm text-gray-500 ms-auto tabular-nums">
          <strong class="text-gray-900"><%= @pagy.count %></strong>
          <%= t("accounting.shared.entries_count", count: @pagy.count) %>
        </span>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-x-auto">
    <table class="w-full text-sm table-fixed min-w-[48rem]">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("accounting.audit_log.time") %></th>
          <th class="p-3 text-start"><%= t("accounting.audit_log.user") %></th>
          <th class="p-3 text-start"><%= t("accounting.audit_log.action") %></th>
          <th class="p-3 text-start"><%= t("accounting.audit_log.record") %></th>
          <th class="p-3 pe-5 text-start w-[38%]"><%= t("accounting.audit_log.changes") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% if @entries.empty? %>
          <tr>
            <td colspan="5" class="p-8 text-center text-sm text-gray-500"><%= t("accounting.audit_log.empty") %></td>
          </tr>
        <% end %>
        <% @entries.each do |entry| %>
          <tr>
            <td class="p-3 ps-5 whitespace-nowrap"><%= l(entry.created_at, format: :short) %></td>
            <td class="p-3"><%= entry.user&.name || t("accounting.shared.em_dash") %></td>
            <td class="p-3 font-mono text-xs"><%= entry.action %></td>
            <td class="p-3 font-mono text-xs"><%= entry.record_type %> #<%= entry.record_id.to_s.first(8) %></td>
            <td class="p-3 pe-5 text-xs text-gray-600 align-top whitespace-normal break-words">
              <% if entry.changes_snapshot.present? %>
                <pre class="font-mono whitespace-pre-wrap break-words m-0 leading-relaxed"><%= JSON.pretty_generate(entry.changes_snapshot) %></pre>
              <% else %>
                <%= t("accounting.shared.em_dash") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <% if @pagy.pages > 1 %>
    <div class="mt-4 flex gap-4 text-sm">
      <% if @pagy.previous %>
        <%= link_to t("actions.previous"), url_for(request.query_parameters.merge(page: @pagy.previous)), class: "text-amber-700 font-semibold" %>
      <% end %>
      <span class="text-gray-600"><%= t("accounting.shared.pagination", page: @pagy.page, pages: @pagy.pages) %></span>
      <% if @pagy.next %>
        <%= link_to t("actions.next"), url_for(request.query_parameters.merge(page: @pagy.next)), class: "text-amber-700 font-semibold" %>
      <% end %>
    </div>
  <% end %>
</div>
