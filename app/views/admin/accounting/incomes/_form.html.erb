<%= form_with model: income,
      url: income.persisted? ? admin_accounting_income_path(income) : admin_accounting_incomes_path,
      class: "space-y-4 max-w-lg" do |f| %>
  <% if income.errors.any? %>
    <p class="text-red-700 text-sm"><%= income.errors.full_messages.to_sentence %></p>
  <% end %>
  <div>
    <%= f.label :income_category_id, t("accounting.shared.category"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
    <%= f.collection_select :income_category_id, @categories, :id, :name, {}, class: pos_input_class %>
  </div>
  <div>
    <%= f.label :treasury_id, t("accounting.shared.treasury"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
    <%#
      Leaving this blank is what "on account" means: nothing has moved yet, and
      the income waits for a voucher. Naming a treasury says the money moved
      now, and raises the voucher for it.
    %>
    <%= f.collection_select :treasury_id, @treasuries, :id, :name,
          { include_blank: t("accounting.incomes.on_account_option") }, class: pos_input_class %>
    <p class="text-xs text-gray-500 mt-1.5"><%= t("accounting.incomes.treasury_hint") %></p>
  </div>
  <div>
    <%= f.label :description, t("accounting.shared.description"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
    <%= f.text_field :description, class: pos_input_class %>
  </div>
  <div>
    <%= f.label :amount_pounds, t("accounting.shared.amount"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
    <%= f.number_field :amount_pounds, min: 0.01, step: "0.01", class: pos_input_class %>
  </div>
  <div>
    <%= f.label :income_date, t("accounting.shared.day"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
    <%= f.date_field :income_date, class: pos_input_class %>
  </div>
  <div>
    <%= f.label :reference_number, t("accounting.shared.reference_number"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
    <%= f.text_field :reference_number, class: pos_input_class %>
  </div>
  <div>
    <%= f.label :receipt_image, t("accounting.shared.receipt"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
    <%= f.file_field :receipt_image, class: "text-sm" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "bg-gray-900 text-white px-5 py-2.5 rounded-xl font-semibold text-sm" %>
    <%= link_to t("actions.cancel"), admin_accounting_incomes_path, class: "border border-gray-200 px-5 py-2.5 rounded-xl text-sm font-semibold" %>
  </div>
<% end %>
