<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.incomes.title") %></h1>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to t("accounting.nav.income_categories"), admin_accounting_income_categories_path,
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50" %>
      <%# Carries whatever narrowed the page — the date range, a category from a
          report drill-down, the search — so the file matches what is on screen. %>
      <%= link_to t("actions.export_csv"),
            admin_accounting_incomes_path(**request.query_parameters.symbolize_keys, format: :csv),
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("accounting.incomes.new_button"), new_admin_accounting_income_path,
            class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </div>
  </div>
  <%= render "admin/accounting/date_range_form" %>

  <div class="mb-4">
    <%= render "admin/accounting/treasury_filter" %>
  </div>

  <%# Search bar %>
  <%= search_form_for @q, url: admin_accounting_incomes_path, method: :get,
        html: { class: "mb-4" } do |f| %>
    <% (params.to_unsafe_h.except("q", "page", "action", "controller")).each do |k, v| %>
      <input type="hidden" name="<%= k %>" value="<%= v %>">
    <% end %>
    <div class="flex gap-2">
      <div class="relative flex-1">
        <span class="absolute inset-y-0 start-3 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
        </span>
        <%= f.search_field :description_or_income_category_name_cont,
              placeholder: t("accounting.shared.search_placeholder"),
              class: "w-full border border-gray-200 rounded-xl ps-9 pe-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400",
              value: params.dig(:q, :description_or_income_category_name_cont) %>
      </div>
      <%= f.submit t("actions.search"), class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl cursor-pointer" %>
      <% if params[:q].present? %>
        <%= link_to t("actions.clear"), admin_accounting_incomes_path(params.to_unsafe_h.except("q", "page")),
              class: "border border-gray-200 text-gray-600 text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-gray-50" %>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
    <% @totals_by_category.each do |(id, name), cents| %>
      <% active = @active_category_id == id.to_s %>
      <% filter_params = active ? params.to_unsafe_h.except("category_id") : params.to_unsafe_h.merge("category_id" => id) %>
      <%= link_to admin_accounting_incomes_path(filter_params),
            class: "rounded-2xl border p-3 transition-colors #{ active ? 'border-emerald-400 bg-emerald-100 ring-1 ring-emerald-300' : 'border-emerald-100 bg-emerald-50/50 hover:bg-emerald-100/70' }" do %>
        <p class="text-xs text-gray-600 truncate"><%= name %><%= " ✕" if active %></p>
        <p class="font-bold tabular-nums text-emerald-800"><%= format_amount(cents) %></p>
      <% end %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.day") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.category") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.treasury") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.description") %></th>
          <th class="p-3 text-end"><%= t("order.labels.total") %></th>
          <th class="p-3 pe-5 text-end"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% @incomes.each_with_index do |income, index| %>
          <tr class="cursor-pointer hover:bg-amber-50/40 transition-colors"
              data-href="<%= admin_accounting_income_path(income) %>"
              onclick="if(!event.target.closest('a,button,form'))Turbo.visit(this.dataset.href)">
            <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= table_row_number(index, pagy: @pagy) %></td>
            <td class="p-3"><%= l(income.income_date, format: :long) %></td>
            <td class="p-3"><%= income.income_category.name %></td>
            <td class="p-3 text-gray-600"><%= income.treasury&.name || t("accounting.shared.em_dash") %></td>
            <td class="p-3">
              <%= income.description %>
              <% if income.is_auto_generated? %><span class="text-xs text-gray-400"><%= t("accounting.shared.auto") %></span><% end %>
            </td>
            <td class="p-3 text-end font-semibold tabular-nums text-emerald-700"><%= format_amount(income.amount_cents) %></td>
            <td class="p-3 pe-5 text-end" onclick="event.stopPropagation()">
              <% unless income.is_auto_generated? %>
                <%= link_to t("actions.edit"), edit_admin_accounting_income_path(income), class: "text-amber-700 text-xs font-semibold" %>
                <%= button_to t("actions.delete"),
                      admin_accounting_income_path(income),
                      method: :delete,
                      class: "text-red-700 text-xs font-semibold ms-2 cursor-pointer",
                      form: { style: "display:inline" },
                      data: { turbo_confirm: t("accounting.records.confirm_delete") } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/accounting/pagination", pagy: @pagy %>
  </section>
</div>
