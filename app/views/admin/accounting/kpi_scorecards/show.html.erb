<% content_for :title, t("accounting.kpi.title") %>
<% export_params = request.query_parameters.except("print") %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-7xl print:max-w-none" <%= tag.attributes(data: { controller: "auto-print" }) if print_mode? %>>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6 print:mb-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 print:text-xl"><%= t("accounting.kpi.title") %></h1>
      <p class="text-gray-600 text-sm mt-1 max-w-3xl print-hide"><%= t("accounting.kpi.description") %></p>
      <p class="print-only text-xs text-gray-600 mt-1">
        <%= Current.company&.name %> · <%= t("inventory.reports.shared.printed_at", time: l(Time.current, format: :short)) %>
      </p>
    </div>
    <div class="flex flex-wrap items-end gap-2 shrink-0 print-hide">
      <%= form_with url: request.path, method: :get, class: "flex items-end gap-2" do %>
        <div>
          <%= label_tag :month, t("accounting.kpi.ending"), class: label_class %>
          <%= month_field_tag :month, @end_month.strftime("%Y-%m"), class: pos_input_class, onchange: "this.form.requestSubmit()" %>
        </div>
        <noscript><%= submit_tag t("actions.apply") %></noscript>
      <% end %>
      <%= link_to url_for(export_params.merge(format: :csv)),
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <span aria-hidden="true">&darr;</span> <%= t("actions.export_csv") %>
      <% end %>
      <%= link_to url_for(export_params.merge(print: 1)), target: "_blank", rel: "noopener", data: { turbo: false },
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <%= t("inventory.reports.shared.print") %>
      <% end %>
    </div>
  </div>

  <section class="print-flow rounded-2xl border border-gray-200 bg-white overflow-hidden print:rounded-none">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start min-w-[14rem]"><%= t("accounting.kpi.kpi") %></th>
            <% @months.each do |month| %>
              <th class="p-3 text-end whitespace-nowrap last:pe-5">
                <%= link_to l(month.month, format: "%b %Y"),
                      profit_loss_admin_accounting_financial_statements_path(start_date: month.month, end_date: month.month.end_of_month, transient_range: 1),
                      class: "hover:text-amber-700 hover:underline", title: t("accounting.kpi.open_pnl") %>
              </th>
            <% end %>
          </tr>
        </thead>
        <% @rows.chunk_while { |a, b| a.last == b.last }.each do |group_rows| %>
          <tbody class="divide-y divide-gray-100 border-b border-gray-200">
            <tr class="bg-gray-50">
              <td class="p-2 ps-5 text-xs font-bold text-gray-700 uppercase tracking-wide" colspan="<%= @months.size + 1 %>">
                <%= t("accounting.kpi.groups.#{group_rows.first.last}") %>
              </td>
            </tr>
            <% group_rows.each do |key, unit, _| %>
              <tr>
                <td class="p-3 ps-5 font-medium text-gray-900">
                  <%= t("accounting.kpi.rows.#{key}") %>
                  <%= info_tooltip_icon(t("accounting.kpi.hints.#{key}")) %>
                </td>
                <% @months.each_with_index do |month, index| %>
                  <% value = month.public_send(key) %>
                  <% previous = @months[index + 1]&.public_send(key) %>
                  <td class="p-3 text-end whitespace-nowrap tabular-nums text-gray-800 last:pe-5">
                    <%= kpi_trend(key, value, previous) %>
                    <%= kpi_value(value, unit) %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
    <div class="px-5 py-3 border-t border-gray-100 bg-gray-50/80 text-xs text-gray-500">
      <%= t("accounting.kpi.footnote") %>
    </div>
  </section>
</div>
