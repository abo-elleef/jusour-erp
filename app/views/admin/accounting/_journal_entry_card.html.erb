<%# Renders a compact JE card with lines table.
    locals: je (JournalEntry), label (String), link_path (String, optional) %>
<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="px-4 py-3 bg-gray-50/80 border-b border-gray-100 flex items-center justify-between gap-3">
    <div>
      <span class="text-xs font-semibold text-gray-700"><%= label %></span>
      <span class="ms-2 text-xs text-gray-400 tabular-nums">#<%= je.entry_number %> · <%= l(je.date, format: :long) %></span>
    </div>
    <% if defined?(link_path) && link_path %>
      <%= link_to t("accounting.shared.view_entry"), link_path,
            class: "text-xs font-semibold text-amber-700 hover:text-amber-800 shrink-0" %>
    <% end %>
  </div>
  <table class="w-full text-xs">
    <thead class="border-b border-gray-100 text-gray-400 uppercase tracking-wide">
      <tr>
        <th class="px-4 py-2 ps-5 text-start w-20"><%= t("accounting.journal_entries.col.code") %></th>
        <th class="px-4 py-2 text-start"><%= t("accounting.journal_entries.col.account") %></th>
        <th class="px-4 py-2 text-end w-32"><%= t("accounting.journal_entries.col.debit") %></th>
        <th class="px-4 py-2 pe-5 text-end w-32"><%= t("accounting.journal_entries.col.credit") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% je.lines.each do |line| %>
        <tr class="<%= line.debit_cents.positive? ? 'bg-white' : 'table-zebra-alt' %>">
          <td class="px-4 py-2 ps-5 font-mono text-gray-300"><%= line.account_code %></td>
          <td class="px-4 py-2 font-medium text-gray-800 <%= line.credit_cents.positive? ? 'ps-8' : '' %>">
            <%= ledger_line_account_name(line) %>
          </td>
          <td class="px-4 py-2 text-end tabular-nums <%= line.debit_cents.positive? ? 'font-semibold text-gray-900' : 'text-gray-200' %>">
            <%= line.debit_cents.positive? ? format_money(line.debit_cents) : "—" %>
          </td>
          <td class="px-4 py-2 pe-5 text-end tabular-nums <%= line.credit_cents.positive? ? 'font-semibold text-gray-900' : 'text-gray-200' %>">
            <%= line.credit_cents.positive? ? format_money(line.credit_cents) : "—" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
