<%= render "admin/accounting/nav" %>
<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.payroll.title") %></h1>
    <%= link_to t("accounting.payroll.export_csv"), admin_accounting_payroll_export_path(week_start: @week_start),
          class: "text-sm font-semibold border border-gray-200 px-4 py-2 rounded-xl hover:bg-gray-50" %>
  </div>

  <%= form_with url: admin_accounting_payroll_path, method: :get, class: "flex gap-4 items-end mb-6" do %>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.week_starting") %></label>
      <%= date_field_tag :week_start, @week_start, class: pos_input_class %>
    </div>
    <%= submit_tag t("actions.apply"), class: "bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-semibold" %>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("accounting.shift_logs.employee") %></th>
          <th class="p-3 text-end"><%= t("accounting.payroll.shifts") %></th>
          <th class="p-3 text-end"><%= t("accounting.shift_logs.hours") %></th>
          <th class="p-3 text-end"><%= t("accounting.payroll.reg_ot") %></th>
          <th class="p-3 text-end"><%= t("accounting.payroll.gross_pay") %></th>
          <th class="p-3 pe-5 text-end"><%= t("accounting.shift_logs.tips") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @rows.each do |row| %>
          <tr>
            <td class="p-3 ps-5 font-medium"><%= row[:user].name %></td>
            <td class="p-3 text-end"><%= row[:shifts] %></td>
            <td class="p-3 text-end tabular-nums"><%= row[:total_hours] %></td>
            <td class="p-3 text-end tabular-nums text-xs"><%= row[:regular_hours] %> / <%= row[:ot_hours] %></td>
            <td class="p-3 text-end font-semibold tabular-nums"><%= format_money(row[:gross_pay_cents]) %></td>
            <td class="p-3 pe-5 text-end tabular-nums"><%= format_money(row[:tips_cents]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
