<% if current_user.admin_access? || current_user.cashier? %>
  <div class="fixed bottom-4 end-4 z-40 rounded-2xl border border-gray-200 bg-white shadow-lg p-4 min-w-[12rem] print-hide">
    <% if current_user.clocked_in? && current_user.current_shift %>
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("accounting.clock_widget.on_shift") %></p>
      <p class="text-sm font-bold text-gray-900 mt-1">
        <%= t("accounting.clock_widget.since", time: l(current_user.current_shift.clocked_in_at, format: :short_time)) %>
      </p>
      <%= button_to t("accounting.clock_widget.clock_out"), clock_out_admin_accounting_shift_log_path(current_user.current_shift), method: :patch,
            class: "mt-2 w-full bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold py-2 rounded-xl" %>
    <% else %>
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("accounting.clock_widget.not_clocked_in") %></p>
      <%= button_to t("accounting.clock_widget.clock_in"), clock_in_admin_accounting_shift_logs_path, method: :post,
            class: "mt-2 w-full bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold py-2 rounded-xl" %>
    <% end %>
  </div>
<% end %>
