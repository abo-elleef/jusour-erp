<%= render "admin/settings/nav" %>
<div class="max-w-3xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("admin.accounting.payment_method_treasuries.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("admin.accounting.payment_method_treasuries.description") %></p>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden divide-y divide-gray-100">
    <% @mappings.each do |method, mapping| %>
      <div class="p-5 flex flex-wrap items-center gap-4">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-900"><%= t("payment.methods.#{method}") %></p>
          <p class="text-xs text-gray-500 mt-0.5">
            <% if mapping %>
              <%= t("admin.accounting.payment_method_treasuries.mapped_to", treasury: mapping.treasury.name) %>
            <% else %>
              <span class="text-amber-600 font-medium"><%= t("admin.accounting.payment_method_treasuries.not_configured") %></span>
            <% end %>
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <%= form_tag admin_accounting_payment_method_treasuries_path,
                method: :post,
                class: "flex items-center gap-2" do %>
            <%= hidden_field_tag "payment_method_treasury[payment_method]", method %>
            <%= select_tag "payment_method_treasury[treasury_id]",
                  options_from_collection_for_select(@treasuries, :id, :name, mapping&.treasury_id),
                  include_blank: t("admin.accounting.payment_method_treasuries.select_treasury"),
                  class: "bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
            <%= submit_tag t("actions.save"),
                  class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>
          <% end %>

          <% if mapping && policy(mapping).destroy? %>
            <%= button_to t("actions.remove"),
                  admin_accounting_payment_method_treasury_path(method),
                  method: :delete,
                  form: { data: { turbo_confirm: t("admin.accounting.payment_method_treasuries.remove_confirm") }, class: "inline" },
                  class: "text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-2 rounded-xl border border-red-200 transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 rounded-xl bg-blue-50 border border-blue-200 px-4 py-3">
    <p class="text-xs text-blue-800"><%= t("admin.accounting.payment_method_treasuries.hint") %></p>
  </div>
</div>
