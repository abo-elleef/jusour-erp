<% visible_groups = accounting_visible_groups %>
<% current_group = accounting_current_group %>
<% if visible_groups.any? %>
  <nav class="mb-6 border-b border-gray-200" aria-label="<%= t("accounting.nav_label") %>">

    <%# ── Primary group pills (only groups with an accessible tab) ── %>
    <div class="flex flex-wrap gap-x-1 -mb-px">
      <% visible_groups.each do |group| %>
        <%= link_to accounting_group_landing_path(group), class: accounting_group_pill_class(current_group == group) do %>
          <%= admin_nav_icon(group[:icon], css: "w-4 h-4 shrink-0") %>
          <%= t(group[:label]) %>
          <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        <% end %>
      <% end %>
    </div>

    <%# ── Sub-tab row for the current group (accessible tabs only) ── %>
    <% if current_group && accounting_visible_tabs(current_group).any? %>
      <div class="flex flex-wrap gap-x-1 bg-gray-50 border-b border-gray-200 -mb-px ps-2">
        <% accounting_visible_tabs(current_group).each do |tab| %>
          <%= link_to t(tab[:label]), public_send(tab[:path]), class: admin_section_tab_class(accounting_tab_active?(tab)) %>
        <% end %>
      </div>
    <% end %>

  </nav>
<% end %>
