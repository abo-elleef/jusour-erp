<% content_for :title, t("accounting.financial_statements.balance_sheet_title") %>
<%= render "admin/accounting/nav" %>

<div class="max-w-3xl print:max-w-none">

  <%# ── Header ──────────────────────────────────────────────────── %>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= t("accounting.financial_statements.balance_sheet_title") %>
      </h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= t("accounting.financial_statements.balance_sheet_description") %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("accounting.financial_statements.download_pdf"),
            balance_sheet_admin_accounting_financial_statements_path(as_of: @as_of, format: :pdf),
            target: "_blank",
            class: "inline-flex items-center gap-1.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 px-4 py-2 rounded-xl transition-colors" %>
      <button onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-xl transition-colors">
        <%= t("accounting.financial_statements.print") %>
      </button>
    </div>
  </div>

  <%# ── As-of date filter ───────────────────────────────────────── %>
  <div class="print:hidden mb-6">
    <%= form_with url: balance_sheet_admin_accounting_financial_statements_path, method: :get,
                  class: "flex items-center gap-3" do |f| %>
      <label class="text-sm font-medium text-gray-700"><%= t("accounting.financial_statements.as_of") %></label>
      <%= f.date_field :as_of, value: @as_of,
            class: "text-sm border border-gray-300 rounded-xl px-3 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
      <%= f.submit t("actions.apply"),
            class: "text-sm font-medium bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl cursor-pointer transition-colors" %>
    <% end %>
  </div>

  <%# ── Print header ───────────────────────────────────────────── %>
  <div class="hidden print:block mb-6">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-base font-semibold text-gray-700"><%= t("accounting.financial_statements.balance_sheet_title") %></p>
    <p class="text-sm text-gray-500"><%= t("accounting.financial_statements.as_of") %> <%= l(@as_of, format: :long) %></p>
  </div>

  <%# ── Summary cards ──────────────────────────────────────────── %>
  <div class="grid grid-cols-3 gap-4 mb-6 print:mb-4">
    <div class="rounded-2xl border border-blue-200 bg-blue-50 px-5 py-4 print:rounded-lg print:border print:border-gray-300 print:bg-white">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_assets") %></p>
      <p class="text-xl font-bold text-blue-800"><%= format_money(@coa.total_assets_cents) %></p>
    </div>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 print:rounded-lg print:border print:border-gray-300 print:bg-white">
      <p class="text-xs font-semibold text-red-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_liabilities") %></p>
      <p class="text-xl font-bold text-red-800"><%= format_money(@coa.total_liabilities_cents) %></p>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 print:rounded-lg print:border print:border-gray-300 print:bg-white">
      <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_equity") %></p>
      <p class="text-xl font-bold text-emerald-800"><%= format_money(@coa.total_equity_cents) %></p>
    </div>
  </div>

  <%# ── Assets ─────────────────────────────────────────────────── %>
  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-4 print:rounded-none print:border print:border-gray-300">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.assets") %></h2>
    </div>

    <%# Current assets %>
    <div class="border-b border-gray-100">
      <div class="px-5 py-2 bg-gray-50/40">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.financial_statements.current_assets") %></p>
      </div>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-gray-50">
          <% @coa.current_asset_lines.each do |line| %>
            <tr class="hover:bg-gray-50/60">
              <td class="px-5 py-2.5 text-gray-500 font-mono text-xs w-16"><%= line.code %></td>
              <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
              <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900"><%= format_money(line.balance_cents) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t border-gray-200">
          <tr>
            <td colspan="2" class="px-5 py-2.5 text-xs font-semibold text-gray-500 text-end"><%= t("accounting.financial_statements.total_current_assets") %></td>
            <td class="px-5 py-2.5 text-end tabular-nums font-semibold text-gray-700"><%= format_money(@coa.total_current_assets_cents) %></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <%# Non-current assets (fixed assets) — only if any %>
    <% if @coa.non_current_asset_lines.any? %>
      <div class="border-b border-gray-100">
        <div class="px-5 py-2 bg-gray-50/40">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.financial_statements.non_current_assets") %></p>
        </div>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-50">
            <% @coa.non_current_asset_lines.each do |line| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-5 py-2.5 text-gray-500 font-mono text-xs w-16"><%= line.code %></td>
                <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
                <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900"><%= format_money(line.balance_cents) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="border-t border-gray-200">
            <tr>
              <td colspan="2" class="px-5 py-2.5 text-xs font-semibold text-gray-500 text-end"><%= t("accounting.financial_statements.total_non_current_assets") %></td>
              <td class="px-5 py-2.5 text-end tabular-nums font-semibold text-gray-700"><%= format_money(@coa.total_non_current_assets_cents) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>

    <%# Total assets footer %>
    <div class="px-5 py-3 bg-gray-50 border-t-2 border-gray-200 flex justify-between items-center">
      <span class="text-sm font-bold text-gray-900"><%= t("accounting.financial_statements.total_assets") %></span>
      <span class="text-sm font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_assets_cents) %></span>
    </div>
  </div>

  <%# ── Liabilities ─────────────────────────────────────────────── %>
  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-4 print:rounded-none print:border print:border-gray-300">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.liabilities") %></h2>
    </div>

    <% if @coa.liability_lines.any? %>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-gray-50">
          <% @coa.liability_lines.each do |line| %>
            <tr class="hover:bg-gray-50/60">
              <td class="px-5 py-2.5 text-gray-500 font-mono text-xs w-16"><%= line.code %></td>
              <td class="px-3 py-2.5 text-gray-800">
                <%= line.name %>
                <span class="ml-1 text-xs text-gray-400 font-normal"><%= t("accounting.financial_statements.subtypes.#{line.subtype}", default: "") %></span>
              </td>
              <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900"><%= format_money(line.balance_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-5 py-6 text-sm text-gray-400 text-center"><%= t("accounting.financial_statements.no_liabilities") %></p>
    <% end %>

    <div class="px-5 py-3 bg-gray-50 border-t-2 border-gray-200 flex justify-between items-center">
      <span class="text-sm font-bold text-gray-900"><%= t("accounting.financial_statements.total_liabilities") %></span>
      <span class="text-sm font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_liabilities_cents) %></span>
    </div>
  </div>

  <%# ── Equity ──────────────────────────────────────────────────── %>
  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6 print:rounded-none print:border print:border-gray-300">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.equity") %></h2>
    </div>

    <table class="w-full text-sm">
      <tbody class="divide-y divide-gray-50">
        <% @coa.equity_lines.each do |line| %>
          <tr class="hover:bg-gray-50/60">
            <td class="px-5 py-2.5 text-gray-500 font-mono text-xs w-16"><%= line.code %></td>
            <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
            <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900"><%= format_money(line.balance_cents) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="px-5 py-3 bg-gray-50 border-t-2 border-gray-200 flex justify-between items-center">
      <span class="text-sm font-bold text-gray-900"><%= t("accounting.financial_statements.total_equity") %></span>
      <span class="text-sm font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_equity_cents) %></span>
    </div>
  </div>

  <%# ── Balance check ───────────────────────────────────────────── %>
  <% balanced = @coa.total_assets_cents == (@coa.total_liabilities_cents + @coa.total_equity_cents) %>
  <div class="rounded-2xl border-2 <%= balanced ? 'border-emerald-400 bg-emerald-50' : 'border-red-400 bg-red-50' %> px-5 py-4 flex items-center justify-between print:rounded-none">
    <span class="text-base font-bold <%= balanced ? 'text-emerald-900' : 'text-red-900' %>">
      <%= t("accounting.financial_statements.liabilities_plus_equity") %>
      <% unless balanced %>
        <span class="ms-2 text-sm font-normal text-red-600">⚠ <%= t("accounting.financial_statements.balance_mismatch") %></span>
      <% end %>
    </span>
    <span class="text-lg font-bold tabular-nums <%= balanced ? 'text-emerald-700' : 'text-red-700' %>">
      <%= format_money(@coa.total_liabilities_cents + @coa.total_equity_cents) %>
    </span>
  </div>

</div>
