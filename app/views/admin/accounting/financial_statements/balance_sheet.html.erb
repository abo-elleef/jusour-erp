<% content_for :title, t("accounting.financial_statements.balance_sheet_title") %>

<div class="max-w-7xl print:max-w-none">

  <%# ── Header ── %>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= t("accounting.financial_statements.balance_sheet_title") %>
      </h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= t("accounting.financial_statements.balance_sheet_description") %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("accounting.financial_statements.download_pdf"),
            balance_sheet_admin_accounting_financial_statements_path(as_of: @as_of, format: :pdf),
            target: "_blank",
            class: "inline-flex items-center gap-1.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 px-4 py-2 rounded-xl transition-colors" %>
      <button onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-xl transition-colors">
        <%= t("accounting.financial_statements.print") %>
      </button>
    </div>
  </div>

  <%# ── Date filter ── %>
  <div class="print:hidden mb-6">
    <%= form_with url: balance_sheet_admin_accounting_financial_statements_path, method: :get,
                  class: "flex items-center gap-3" do |f| %>
      <label class="text-sm font-medium text-gray-700"><%= t("accounting.financial_statements.as_of") %></label>
      <%= f.date_field :as_of, value: @as_of,
            class: "text-sm border border-gray-300 rounded-xl px-3 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
      <%= f.submit t("actions.apply"),
            class: "text-sm font-medium bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl cursor-pointer transition-colors" %>
    <% end %>
  </div>

  <%# ── Print header ── %>
  <div class="hidden print:block mb-6">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-base font-semibold text-gray-700"><%= t("accounting.financial_statements.balance_sheet_title") %></p>
    <p class="text-sm text-gray-500"><%= t("accounting.financial_statements.as_of") %> <%= l(@as_of, format: :long) %></p>
  </div>

  <%# ── Summary cards ── %>
  <div class="grid grid-cols-3 gap-4 mb-6 print:mb-4">
    <div class="rounded-2xl border border-blue-200 bg-blue-50 px-5 py-4">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_assets") %></p>
      <p class="text-xl font-bold text-blue-800"><%= format_money(@coa.total_assets_cents) %></p>
    </div>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4">
      <p class="text-xs font-semibold text-red-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_liabilities") %></p>
      <p class="text-xl font-bold text-red-800"><%= format_money(@coa.total_liabilities_cents) %></p>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4">
      <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_equity") %></p>
      <p class="text-xl font-bold text-emerald-800"><%= format_money(@coa.total_equity_cents) %></p>
    </div>
  </div>

  <%# ── Two-column layout ── %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-start print:grid-cols-2 print:gap-3">

    <%# ════ LEFT COLUMN — Assets ════ %>
    <div class="space-y-3">

      <%# Current Assets — collapsible %>
      <details class="rounded-2xl border border-gray-200 bg-white overflow-hidden group" open>
        <summary class="flex items-center justify-between px-5 py-3 bg-gray-50 border-b border-gray-100 cursor-pointer select-none list-none">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
            <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.current_assets") %></h2>
          </div>
          <span class="text-sm font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_current_assets_cents) %></span>
        </summary>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-50">
            <% @coa.current_asset_lines.each do |line| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-5 py-2.5 text-gray-400 font-mono text-xs w-14"><%= line.code %></td>
                <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
                <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900">
                  <%= link_to format_money(line.balance_cents),
                        balance_sheet_lines_admin_accounting_financial_statements_path(
                          account_code: line.code, account_name: line.name, as_of: @as_of),
                        class: "hover:underline hover:text-amber-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="border-t border-gray-200 bg-gray-50/40">
            <tr>
              <td colspan="2" class="px-5 py-2 text-xs font-semibold text-gray-500 text-end"><%= t("accounting.financial_statements.total_current_assets") %></td>
              <td class="px-5 py-2 text-end tabular-nums font-semibold text-gray-700"><%= format_money(@coa.total_current_assets_cents) %></td>
            </tr>
          </tfoot>
        </table>
      </details>

      <%# Non-current Assets — collapsible (only if any) %>
      <% if @coa.non_current_asset_lines.any? %>
        <details class="rounded-2xl border border-gray-200 bg-white overflow-hidden group" open>
          <summary class="flex items-center justify-between px-5 py-3 bg-gray-50 border-b border-gray-100 cursor-pointer select-none list-none">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
              <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.non_current_assets") %></h2>
            </div>
            <span class="text-sm font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_non_current_assets_cents) %></span>
          </summary>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-50">
              <% @coa.non_current_asset_lines.each do |line| %>
                <tr class="hover:bg-gray-50/60">
                  <td class="px-5 py-2.5 text-gray-400 font-mono text-xs w-14"><%= line.code %></td>
                  <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
                  <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900">
                    <%= link_to format_money(line.balance_cents),
                          balance_sheet_lines_admin_accounting_financial_statements_path(
                            account_code: line.code, account_name: line.name, as_of: @as_of),
                          class: "hover:underline hover:text-amber-700" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="border-t border-gray-200 bg-gray-50/40">
              <tr>
                <td colspan="2" class="px-5 py-2 text-xs font-semibold text-gray-500 text-end"><%= t("accounting.financial_statements.total_non_current_assets") %></td>
                <td class="px-5 py-2 text-end tabular-nums font-semibold text-gray-700"><%= format_money(@coa.total_non_current_assets_cents) %></td>
              </tr>
            </tfoot>
          </table>
        </details>
      <% end %>

      <%# Total Assets footer %>
      <div class="rounded-2xl border-2 border-blue-300 bg-blue-50 px-5 py-3 flex justify-between items-center">
        <span class="text-sm font-bold text-blue-900"><%= t("accounting.financial_statements.total_assets") %></span>
        <span class="text-sm font-bold tabular-nums text-blue-800"><%= format_money(@coa.total_assets_cents) %></span>
      </div>
    </div>

    <%# ════ RIGHT COLUMN — Liabilities + Equity ════ %>
    <div class="space-y-3">

      <%# Liabilities — collapsible %>
      <details class="rounded-2xl border border-gray-200 bg-white overflow-hidden group" open>
        <summary class="flex items-center justify-between px-5 py-3 bg-gray-50 border-b border-gray-100 cursor-pointer select-none list-none">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
            <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.liabilities") %></h2>
          </div>
          <span class="text-sm font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_liabilities_cents) %></span>
        </summary>
        <% if @coa.liability_lines.any? %>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-50">
              <% @coa.liability_lines.each do |line| %>
                <tr class="hover:bg-gray-50/60">
                  <td class="px-5 py-2.5 text-gray-400 font-mono text-xs w-14"><%= line.code %></td>
                  <td class="px-3 py-2.5 text-gray-800">
                    <%= line.name %>
                    <span class="ms-1 text-xs text-gray-400 font-normal"><%= t("accounting.financial_statements.subtypes.#{line.subtype}", default: "") %></span>
                  </td>
                  <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900">
                    <%= link_to format_money(line.balance_cents),
                          balance_sheet_lines_admin_accounting_financial_statements_path(
                            account_code: line.code, account_name: line.name, as_of: @as_of),
                          class: "hover:underline hover:text-amber-700" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="border-t border-gray-200 bg-gray-50/40">
              <tr>
                <td colspan="2" class="px-5 py-2 text-xs font-semibold text-gray-500 text-end"><%= t("accounting.financial_statements.total_liabilities") %></td>
                <td class="px-5 py-2 text-end tabular-nums font-semibold text-gray-700"><%= format_money(@coa.total_liabilities_cents) %></td>
              </tr>
            </tfoot>
          </table>
        <% else %>
          <p class="px-5 py-6 text-sm text-gray-400 text-center"><%= t("accounting.financial_statements.no_liabilities") %></p>
        <% end %>
      </details>

      <%# Equity — collapsible %>
      <details class="rounded-2xl border border-gray-200 bg-white overflow-hidden group" open>
        <summary class="flex items-center justify-between px-5 py-3 bg-gray-50 border-b border-gray-100 cursor-pointer select-none list-none">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
            <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.equity") %></h2>
          </div>
          <span class="text-sm font-bold tabular-nums text-gray-900"><%= format_money(@coa.total_equity_cents) %></span>
        </summary>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-50">
            <% @coa.equity_lines.each do |line| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-5 py-2.5 text-gray-400 font-mono text-xs w-14"><%= line.code %></td>
                <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
                <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900">
                  <% if line.code.present? %>
                    <%= link_to format_money(line.balance_cents),
                          balance_sheet_lines_admin_accounting_financial_statements_path(
                            account_code: line.code, account_name: line.name, as_of: @as_of),
                          class: "hover:underline hover:text-amber-700" %>
                  <% else %>
                    <%= format_money(line.balance_cents) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="border-t border-gray-200 bg-gray-50/40">
            <tr>
              <td colspan="2" class="px-5 py-2 text-xs font-semibold text-gray-500 text-end"><%= t("accounting.financial_statements.total_equity") %></td>
              <td class="px-5 py-2 text-end tabular-nums font-semibold text-gray-700"><%= format_money(@coa.total_equity_cents) %></td>
            </tr>
          </tfoot>
        </table>
      </details>

      <%# Balance check ── %>
      <% balanced = @coa.total_assets_cents == (@coa.total_liabilities_cents + @coa.total_equity_cents) %>
      <div class="rounded-2xl border-2 <%= balanced ? 'border-emerald-400 bg-emerald-50' : 'border-red-400 bg-red-50' %> px-5 py-3 flex items-center justify-between">
        <span class="text-sm font-bold <%= balanced ? 'text-emerald-900' : 'text-red-900' %>">
          <%= t("accounting.financial_statements.liabilities_plus_equity") %>
          <% unless balanced %>
            <span class="ms-2 text-xs font-normal text-red-600">⚠ <%= t("accounting.financial_statements.balance_mismatch") %></span>
          <% end %>
        </span>
        <span class="text-sm font-bold tabular-nums <%= balanced ? 'text-emerald-700' : 'text-red-700' %>">
          <%= format_money(@coa.total_liabilities_cents + @coa.total_equity_cents) %>
        </span>
      </div>
    </div>

  </div><%# end grid %>
</div>

<style>
  details > summary { marker: none; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] > summary svg { transform: rotate(90deg); }
</style>
