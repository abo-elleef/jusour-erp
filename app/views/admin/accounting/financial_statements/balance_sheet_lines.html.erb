<% content_for :title, t("accounting.financial_statements.balance_sheet_title") %>
<%= render "admin/accounting/nav" %>

<div class="max-w-4xl">
  <p class="text-sm text-gray-500 mb-1">
    <%= link_to t("accounting.financial_statements.balance_sheet_title"),
          balance_sheet_admin_accounting_financial_statements_path(as_of: @as_of),
          class: "hover:underline" %> /
    <span class="text-gray-700 font-medium"><%= @account_name %></span>
  </p>

  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @account_name %></h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= t("accounting.financial_statements.as_of") %> <%= l(@as_of, format: :long) %>
        · <%= t("accounting.financial_statements.account_code", default: "Account") %> <%= @account_code %>
      </p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-3 text-right">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-0.5"><%= t("shared.total") %></p>
      <p class="text-xl font-bold text-gray-900"><%= format_money(@balance_cents.abs) %></p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
    <% if @je_lines.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="px-5 py-3 text-start"><%= t("shared.date") %></th>
              <th class="px-5 py-3 text-start"><%= t("accounting.cash_flow.journal_entry") %></th>
                      <th class="px-5 py-3 text-start"><%= t("shared.notes") %></th>
              <th class="px-5 py-3 text-end"><%= t("accounting.financial_statements.debit", default: "Debit") %></th>
              <th class="px-5 py-3 text-end"><%= t("accounting.financial_statements.credit", default: "Credit") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @je_lines.each do |jel| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-5 py-2.5 text-gray-600 whitespace-nowrap tabular-nums"><%= l(jel.journal_entry.date, format: :short) %></td>
                <td class="px-5 py-2.5 font-medium">
                  <%= link_to "##{jel.journal_entry.entry_number}", admin_accounting_journal_entry_path(jel.journal_entry),
                        class: "text-blue-600 hover:underline" %>
                  <p class="text-xs text-gray-400 mt-0.5 font-normal"><%= jel.journal_entry.description.truncate(60) %></p>
                </td>
                <td class="px-5 py-2.5 text-gray-500 max-w-[200px] truncate"><%= jel.notes.presence || "—" %></td>
                <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900">
                  <%= jel.debit_cents > 0 ? format_money(jel.debit_cents) : "—" %>
                </td>
                <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900">
                  <%= jel.credit_cents > 0 ? format_money(jel.credit_cents) : "—" %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50 border-t-2 border-gray-200">
            <tr>
              <td colspan="3" class="px-5 py-3 font-bold text-gray-900"><%= t("shared.total") %></td>
              <td class="px-5 py-3 text-end tabular-nums font-bold text-gray-900">
                <%= format_money(@je_lines.sum(:debit_cents)) %>
              </td>
              <td class="px-5 py-3 text-end tabular-nums font-bold text-gray-900">
                <%= format_money(@je_lines.sum(:credit_cents)) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-12 text-center text-sm text-gray-400"><%= t("accounting.cash_flow.no_activity") %></p>
    <% end %>
  </div>
</div>
