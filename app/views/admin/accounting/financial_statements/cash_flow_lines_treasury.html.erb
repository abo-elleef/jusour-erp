<% content_for :title, t("accounting.cash_flow.title") %>

<div class="max-w-4xl">
  <%# ── Breadcrumb ── %>
  <p class="text-sm text-gray-500 mb-1">
    <%= link_to t("accounting.cash_flow.title"),
          cash_flow_admin_accounting_financial_statements_path(start_date: @start_date, end_date: @end_date),
          class: "hover:underline" %> /
    <span class="text-gray-700 font-medium"><%= t("accounting.cash_flow.kinds.#{@kind}") %></span>
  </p>

  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= t("accounting.cash_flow.kinds.#{@kind}") %>
      </h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= l(@start_date, format: :long) %> – <%= l(@end_date, format: :long) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to t("actions.export_csv"),
            cash_flow_lines_admin_accounting_financial_statements_path(
              start_date: @start_date, end_date: @end_date, kind: @kind, format: :csv
            ),
            class: "inline-flex items-center border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50 transition-colors" %>
      <div class="rounded-2xl border border-gray-200 bg-white px-5 py-3 text-right">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-0.5"><%= t("accounting.cash_flow.total") %></p>
        <% total = @transactions.sum(:amount_cents) %>
        <p class="text-xl font-bold <%= total >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
          <%= total >= 0 ? format_amount(total) : "(#{format_amount(total.abs)})" %>
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
    <% if @transactions.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="px-5 py-3 text-start"><%= t("shared.date") %></th>
              <th class="px-5 py-3 text-start"><%= t("accounting.cash_flow.treasury") %></th>
              <th class="px-5 py-3 text-start"><%= t("shared.notes") %></th>
              <th class="px-5 py-3 text-end"><%= t("shared.amount") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @transactions.each do |tx| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-5 py-2.5 text-gray-600 whitespace-nowrap tabular-nums"><%= l(tx.occurred_on, format: :short) %></td>
                <td class="px-5 py-2.5 text-gray-800 font-medium"><%= tx.treasury.name %></td>
                <td class="px-5 py-2.5 text-gray-500 max-w-xs truncate">
                  <%# The row is a treasury movement, but what the reader wants is the
                      expense or income it came from. Movements with no record behind
                      them (a manual entry, a drawer reconcile) stay plain text. %>
                  <% if (source_path = treasury_source_path(tx)) %>
                    <%= link_to tx.description.presence || "—", source_path,
                          class: "text-gray-700 hover:text-blue-700 hover:underline" %>
                  <% else %>
                    <%= tx.description.presence || "—" %>
                  <% end %>
                </td>
                <td class="px-5 py-2.5 text-end tabular-nums font-medium <%= tx.amount_cents >= 0 ? 'text-gray-900' : 'text-red-700' %>">
                  <% if tx.amount_cents >= 0 %>
                    <%= format_amount(tx.amount_cents) %>
                  <% else %>
                    (<%= format_amount(tx.amount_cents.abs) %>)
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50 border-t-2 border-gray-200">
            <tr>
              <td colspan="3" class="px-5 py-3 font-bold text-gray-900"><%= t("shared.total") %></td>
              <td class="px-5 py-3 text-end tabular-nums font-bold <%= total >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
                <%= total >= 0 ? format_amount(total) : "(#{format_amount(total.abs)})" %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-12 text-center text-sm text-gray-400"><%= t("accounting.cash_flow.no_activity") %></p>
    <% end %>
  </div>
</div>
