<% content_for :title, t("accounting.profit_vs_cash.title") %>

<%
  net_profit = @bridge.net_profit_cents
  cash_change = @bridge.cash_change_cents
  gap = net_profit - cash_change

  # Each bridge line reads "effect on cash relative to profit", so a few keys
  # flip their label when the movement runs the other way — "stock bought" and
  # "stock sold down" are the same number with opposite meaning. The natural
  # sign differs per key: building stock costs cash (negative), while an unpaid
  # invoice saves it (positive), so the alternate label is keyed by sign.
  alternate_labels = {
    inventory_build:      { positive: :inventory_release },
    unpaid_purchases:     { negative: :overpaid_purchases },
    # Both directions are real: a period can charge more than it pays, or pay
    # off what earlier periods charged.
    unpaid_expenses:      { negative: :settled_prior_expenses },
    uncollected_income:   { positive: :collected_prior_income },
    ledger_only_expenses: { negative: :ledger_only_expenses_reverse },
    staff_balances:       { negative: :staff_balances_reverse }
  }

  range = { start_date: @start_date, end_date: @end_date }

  # Every line lands on the page that already itemises it, so the bridge is a
  # map rather than a dead end — the same drill-down the P&L and cash flow give.
  detail_path_for = lambda do |key|
    case key
    when :inventory_build
      profit_loss_admin_accounting_financial_statements_path(**range)
    when :unpaid_purchases
      admin_accounting_journal_entries_path(account_code: 5100, **range)
    when :financing, :investing
      cash_flow_admin_accounting_financial_statements_path(**range)
    when :equity_adjustments
      cash_flow_lines_admin_accounting_financial_statements_path(kind: "adjustment", **range)
    when :staff_balances
      cash_flow_lines_admin_accounting_financial_statements_path(kind: "staff_payment", **range)
    when :digital_payments
      cash_flow_lines_admin_accounting_financial_statements_path(kind: "online_payment", **range)
    when :ledger_only_expenses
      admin_accounting_expenses_path(tab: "ledger", **range)
    when :unpaid_expenses
      admin_accounting_journal_entries_path(
        account_code: ::Accounting::JournalEntryService::ACCRUED_EXPENSES_CODE, **range)
    when :uncollected_income
      admin_accounting_journal_entries_path(
        account_code: ::Accounting::JournalEntryService::OTHER_RECEIVABLES_CODE, **range)
    end
  end

  # Equations read better with a signed number than with accounting parentheses.
  signed = ->(cents) { "#{cents.negative? ? "−" : ""}#{format_amount(cents.abs)}" }
%>

<div class="max-w-3xl print:max-w-none">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.profit_vs_cash.title") %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= t("accounting.profit_vs_cash.description") %></p>
    </div>
    <button onclick="window.print()"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-xl transition-colors print:hidden">
      <%= t("accounting.financial_statements.print") %>
    </button>
  </div>

  <div class="print:hidden">
    <%= render "admin/accounting/date_range_form" %>
  </div>

  <div class="hidden print:block mb-6">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-base font-semibold text-gray-700"><%= t("accounting.profit_vs_cash.title") %></p>
    <p class="text-sm text-gray-500"><%= l(@start_date, format: :long) %> – <%= l(@end_date, format: :long) %></p>
  </div>

  <%# ── The two ends, and the gap between them ──────────────────── %>
  <%
    profit_formula = t("accounting.profit_vs_cash.net_profit_formula",
                       revenue: format_amount(@bridge.coa.total_revenue_cents),
                       cogs:    format_amount(@bridge.cogs_cents),
                       opex:    format_amount(@bridge.coa.total_operating_expenses_cents),
                       result:  signed.call(net_profit))
    cash_formula = t("accounting.profit_vs_cash.cash_change_formula", result: signed.call(cash_change))
    gap_formula  = t("accounting.profit_vs_cash.gap_formula",
                     profit: signed.call(net_profit), cash: signed.call(cash_change),
                     result: signed.call(gap))
  %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <%= link_to profit_loss_admin_accounting_financial_statements_path(start_date: @start_date, end_date: @end_date),
          title: profit_formula,
          class: "rounded-2xl border border-gray-200 bg-white p-4 hover:border-gray-300 transition-colors" do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.profit_vs_cash.net_profit") %></p>
      <p class="text-xl font-black tabular-nums <%= net_profit >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
        <%= net_profit >= 0 ? format_amount(net_profit) : "(#{format_amount(net_profit.abs)})" %>
      </p>
    <% end %>

    <div class="rounded-2xl border-2 <%= gap.zero? ? 'border-gray-200' : 'border-amber-300 bg-amber-50' %> p-4"
         title="<%= gap_formula %>">
      <p class="text-xs font-semibold <%= gap.zero? ? 'text-gray-500' : 'text-amber-700' %> uppercase tracking-wide mb-1">
        <%= t("accounting.profit_vs_cash.gap") %>
      </p>
      <p class="text-xl font-black tabular-nums <%= gap.zero? ? 'text-gray-700' : 'text-amber-900' %>">
        <%= gap >= 0 ? format_amount(gap) : "(#{format_amount(gap.abs)})" %>
      </p>
    </div>

    <%= link_to cash_flow_admin_accounting_financial_statements_path(start_date: @start_date, end_date: @end_date),
          title: cash_formula,
          class: "rounded-2xl border border-gray-200 bg-white p-4 hover:border-gray-300 transition-colors" do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.profit_vs_cash.cash_change") %></p>
      <p class="text-xl font-black tabular-nums <%= cash_change >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
        <%= cash_change >= 0 ? format_amount(cash_change) : "(#{format_amount(cash_change.abs)})" %>
      </p>
    <% end %>
  </div>

  <%# ── The bridge, walked from profit down to cash ─────────────── %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.profit_vs_cash.bridge_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("accounting.profit_vs_cash.bridge_hint") %></p>
    </div>

    <table class="w-full text-sm">
      <tbody class="divide-y divide-gray-100">
        <tr class="bg-gray-50/60" title="<%= profit_formula %>">
          <td class="px-5 py-3 font-bold text-gray-900"><%= t("accounting.profit_vs_cash.net_profit") %></td>
          <td class="px-5 py-3 text-end tabular-nums font-bold text-gray-900">
            <span class="group/copy inline-flex items-center whitespace-nowrap"><%= link_to net_profit >= 0 ? format_amount(net_profit) : "(#{format_amount(net_profit.abs)})",
                  profit_loss_admin_accounting_financial_statements_path(**range),
                  class: "hover:underline hover:text-blue-700",
                  title: t("accounting.profit_vs_cash.drill_down_hint") %><%= copy_amount_button(net_profit) %></span>
          </td>
        </tr>

        <% if @bridge.lines.empty? && @bridge.balanced? %>
          <tr><td colspan="2" class="px-5 py-10 text-center text-sm text-gray-400"><%= t("accounting.profit_vs_cash.no_gap") %></td></tr>
        <% end %>

        <% @bridge.lines.each do |line| %>
          <% sign = line.amount_cents.negative? ? :negative : :positive %>
          <% key = alternate_labels.dig(line.key, sign) || line.key %>
          <% values = (line.hint_values || {}).transform_values { |v| format_amount(v) } %>
          <% hint = t("accounting.profit_vs_cash.lines.#{line.key}_hint", **values, default: "") %>
          <% formula = t("accounting.profit_vs_cash.lines.#{line.key}_formula",
                         **values, result: signed.call(line.amount_cents), default: "") %>
          <% href = detail_path_for.call(line.key) %>
          <% amount_text = line.amount_cents.negative? ? "(#{format_amount(line.amount_cents.abs)})" : "+ #{format_amount(line.amount_cents)}" %>
          <tr class="hover:bg-gray-50/60" title="<%= formula %>">
            <td class="px-5 py-2.5">
              <span class="text-gray-800 <%= "border-b border-dotted border-gray-300 cursor-help" if formula.present? %>">
                <%= t("accounting.profit_vs_cash.lines.#{key}") %>
              </span>
              <% if hint.present? %>
                <p class="text-xs text-gray-400 mt-0.5"><%= hint %></p>
              <% end %>
            </td>
            <td class="px-5 py-2.5 text-end tabular-nums font-medium whitespace-nowrap <%= line.amount_cents.negative? ? 'text-red-700' : 'text-emerald-700' %>">
              <span class="group/copy inline-flex items-center whitespace-nowrap">
                <% if href %>
                  <%= link_to amount_text, href, class: "hover:underline hover:text-blue-700",
                        title: t("accounting.profit_vs_cash.drill_down_hint") %>
                <% else %>
                  <%= amount_text %>
                <% end %>
                <%= copy_amount_button(line.amount_cents) %>
              </span>
            </td>
          </tr>
        <% end %>

        <% unless @bridge.balanced? %>
          <tr class="bg-amber-50/60">
            <td class="px-5 py-2.5">
              <span class="font-semibold text-amber-800"><%= t("accounting.profit_vs_cash.residual") %></span>
              <p class="text-xs text-amber-600 mt-0.5"><%= t("accounting.profit_vs_cash.residual_hint") %></p>
            </td>
            <td class="px-5 py-2.5 text-end tabular-nums font-semibold text-amber-800 whitespace-nowrap">
              <% r = @bridge.residual_cents %>
              <span class="group/copy inline-flex items-center whitespace-nowrap"><%= link_to r.negative? ? "(#{format_amount(r.abs)})" : "+ #{format_amount(r)}",
                    admin_accounting_journal_entries_path(**range),
                    class: "hover:underline",
                    title: t("accounting.profit_vs_cash.drill_down_hint") %><%= copy_amount_button(r) %></span>
            </td>
          </tr>
        <% end %>
      </tbody>

      <tfoot>
        <tr class="border-t-2 border-gray-900 <%= cash_change >= 0 ? 'bg-emerald-50' : 'bg-orange-50' %>"
            title="<%= cash_formula %>">
          <td class="px-5 py-4 text-base font-black <%= cash_change >= 0 ? 'text-emerald-900' : 'text-orange-900' %>">
            <%= t("accounting.profit_vs_cash.cash_change") %>
          </td>
          <td class="px-5 py-4 text-end tabular-nums text-lg font-black <%= cash_change >= 0 ? 'text-emerald-700' : 'text-orange-700' %>">
            <span class="group/copy inline-flex items-center whitespace-nowrap"><%= link_to cash_change >= 0 ? format_amount(cash_change) : "(#{format_amount(cash_change.abs)})",
                  cash_flow_admin_accounting_financial_statements_path(**range),
                  class: "hover:underline hover:text-blue-700",
                  title: t("accounting.profit_vs_cash.drill_down_hint") %><%= copy_amount_button(cash_change) %></span>
          </td>
        </tr>
      </tfoot>
    </table>

    <% if @bridge.balanced? && @bridge.lines.any? %>
      <p class="px-5 py-3 text-xs text-gray-400 border-t border-gray-100"><%= t("accounting.profit_vs_cash.balanced_note") %></p>
    <% end %>
  </section>
</div>
