<% content_for :title, t("accounting.financial_statements.profit_loss_title") %>
<%= render "admin/accounting/nav" %>

<div class="max-w-3xl print:max-w-none">

  <%# ── Header ──────────────────────────────────────────────────── %>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= t("accounting.financial_statements.profit_loss_title") %>
      </h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= t("accounting.financial_statements.profit_loss_description") %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("accounting.financial_statements.download_pdf"),
            profit_loss_admin_accounting_financial_statements_path(
              start_date: @start_date, end_date: @end_date, format: :pdf
            ),
            target: "_blank",
            class: "inline-flex items-center gap-1.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 px-4 py-2 rounded-xl transition-colors" %>
      <button onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-xl transition-colors">
        <%= t("accounting.financial_statements.print") %>
      </button>
    </div>
  </div>

  <%# ── Date range filter ──────────────────────────────────────── %>
  <div class="print:hidden">
    <%= render "admin/accounting/date_range_form" %>
  </div>

  <%# ── Print header (visible only when printing) ─────────────── %>
  <div class="hidden print:block mb-6">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-base font-semibold text-gray-700"><%= t("accounting.financial_statements.profit_loss_title") %></p>
    <p class="text-sm text-gray-500">
      <%= l(@start_date, format: :long) %> – <%= l(@end_date, format: :long) %>
    </p>
  </div>

  <%# ── Summary cards ──────────────────────────────────────────── %>
  <div class="grid grid-cols-3 gap-4 mb-6 print:mb-4">
    <div class="rounded-2xl border border-blue-200 bg-blue-50 px-5 py-4 print:rounded-lg print:border print:border-gray-300 print:bg-white">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_revenue") %></p>
      <p class="text-xl font-bold text-blue-800"><%= format_money(@coa.total_revenue_cents) %></p>
    </div>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 print:rounded-lg print:border print:border-gray-300 print:bg-white">
      <p class="text-xs font-semibold text-red-600 uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.total_expenses") %></p>
      <p class="text-xl font-bold text-red-800"><%= format_money(@coa.total_expenses_cents) %></p>
    </div>
    <% net = @coa.net_income_cents %>
    <div class="rounded-2xl border <%= net >= 0 ? 'border-emerald-200 bg-emerald-50' : 'border-orange-200 bg-orange-50' %> px-5 py-4 print:rounded-lg print:border print:border-gray-300 print:bg-white">
      <p class="text-xs font-semibold <%= net >= 0 ? 'text-emerald-600' : 'text-orange-600' %> uppercase tracking-wide mb-1"><%= t("accounting.financial_statements.net_income") %></p>
      <p class="text-xl font-bold <%= net >= 0 ? 'text-emerald-800' : 'text-orange-800' %>"><%= format_money(net.abs) %> <%= net < 0 ? "(#{t('accounting.financial_statements.loss')})" : "" %></p>
    </div>
  </div>

  <%# ── Revenue section ────────────────────────────────────────── %>
  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-4 print:rounded-none print:border print:border-gray-300">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.revenue") %></h2>
    </div>

    <% if @coa.revenue_lines.any? %>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-gray-50">
          <% @coa.revenue_lines.each do |line| %>
            <tr class="hover:bg-gray-50/60 print:hover:bg-white">
              <td class="px-5 py-2.5 text-gray-500 font-mono text-xs w-16"><%= line.code %></td>
              <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
              <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900 print:text-gray-900">
                <%= link_to format_money(line.balance_cents),
                      admin_accounting_journal_entries_path(
                        account_code: line.code,
                        start_date: @start_date, end_date: @end_date
                      ),
                      class: "hover:text-blue-700 hover:underline print:no-underline print:text-gray-900",
                      title: t("accounting.financial_statements.drill_down_hint") %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50">
          <tr>
            <td colspan="2" class="px-5 py-3 text-sm font-bold text-gray-700 text-end"><%= t("accounting.financial_statements.total_revenue") %></td>
            <td class="px-5 py-3 text-end tabular-nums font-bold text-gray-900"><%= format_money(@coa.total_revenue_cents) %></td>
          </tr>
        </tfoot>
      </table>
    <% else %>
      <p class="px-5 py-6 text-sm text-gray-400 text-center"><%= t("accounting.financial_statements.no_revenue") %></p>
    <% end %>
  </div>

  <%# ── Expenses section ───────────────────────────────────────── %>
  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6 print:rounded-none print:border print:border-gray-300">
    <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide"><%= t("accounting.financial_statements.expenses") %></h2>
    </div>

    <% if @coa.expense_lines.any? %>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-gray-50">
          <% @coa.expense_lines.each do |line| %>
            <tr class="hover:bg-gray-50/60 print:hover:bg-white">
              <td class="px-5 py-2.5 text-gray-500 font-mono text-xs w-16"><%= line.code %></td>
              <td class="px-3 py-2.5 text-gray-800"><%= line.name %></td>
              <td class="px-5 py-2.5 text-end tabular-nums font-medium text-gray-900 print:text-gray-900">
                <%= link_to format_money(line.balance_cents),
                      admin_accounting_journal_entries_path(
                        account_code: line.code,
                        start_date: @start_date, end_date: @end_date
                      ),
                      class: "hover:text-blue-700 hover:underline print:no-underline print:text-gray-900",
                      title: t("accounting.financial_statements.drill_down_hint") %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50">
          <tr>
            <td colspan="2" class="px-5 py-3 text-sm font-bold text-gray-700 text-end"><%= t("accounting.financial_statements.total_expenses") %></td>
            <td class="px-5 py-3 text-end tabular-nums font-bold text-gray-900"><%= format_money(@coa.total_expenses_cents) %></td>
          </tr>
        </tfoot>
      </table>
    <% else %>
      <p class="px-5 py-6 text-sm text-gray-400 text-center"><%= t("accounting.financial_statements.no_expenses") %></p>
    <% end %>
  </div>

  <%# ── Net Income row ─────────────────────────────────────────── %>
  <div class="rounded-2xl border-2 <%= @coa.net_income_cents >= 0 ? 'border-emerald-400 bg-emerald-50' : 'border-orange-400 bg-orange-50' %> px-5 py-4 flex items-center justify-between print:rounded-none">
    <span class="text-base font-bold <%= @coa.net_income_cents >= 0 ? 'text-emerald-900' : 'text-orange-900' %>">
      <%= t("accounting.financial_statements.net_income") %>
    </span>
    <span class="text-lg font-bold tabular-nums <%= @coa.net_income_cents >= 0 ? 'text-emerald-700' : 'text-orange-700' %>">
      <%= @coa.net_income_cents < 0 ? "(" : "" %><%= format_money(@coa.net_income_cents.abs) %><%= @coa.net_income_cents < 0 ? ")" : "" %>
    </span>
  </div>

</div>
