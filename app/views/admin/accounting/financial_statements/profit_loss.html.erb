<% content_for :title, t("accounting.financial_statements.profit_loss_title") %>

<% cogs_cents = @opening_cents + @coa.purchases_cents - @closing_cents %>
<% gross_profit_cents = @coa.total_revenue_cents - cogs_cents %>
<% net_profit_cents   = gross_profit_cents - @coa.total_operating_expenses_cents %>

<div class="max-w-3xl print:max-w-none">

  <%# ── Header ──────────────────────────────────────────────────── %>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= t("accounting.financial_statements.profit_loss_title") %>
      </h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= t("accounting.financial_statements.profit_loss_description") %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("accounting.financial_statements.download_pdf"),
            profit_loss_admin_accounting_financial_statements_path(
              start_date: @start_date, end_date: @end_date, format: :pdf
            ),
            target: "_blank",
            class: "inline-flex items-center gap-1.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 px-4 py-2 rounded-xl transition-colors" %>
      <button onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-xl transition-colors">
        <%= t("accounting.financial_statements.print") %>
      </button>
    </div>
  </div>

  <%# ── Date range filter ──────────────────────────────────────── %>
  <div class="print:hidden">
    <%= render "admin/accounting/date_range_form" %>
  </div>

  <%# ── Print header ───────────────────────────────────────────── %>
  <div class="hidden print:block mb-6">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-base font-semibold text-gray-700"><%= t("accounting.financial_statements.profit_loss_title") %></p>
    <p class="text-sm text-gray-500">
      <%= l(@start_date, format: :long) %> – <%= l(@end_date, format: :long) %>
    </p>
  </div>

  <%# ── Trading Account ─────────────────────────────────────────── %>
  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-4 print:rounded-none">

    <%# ── REVENUE ── %>
    <div class="px-5 py-3 bg-blue-50 border-b border-blue-100">
      <h2 class="text-xs font-bold text-blue-700 uppercase tracking-wide"><%= t("accounting.financial_statements.trading.revenue_section") %></h2>
    </div>

    <details class="group" open>
      <summary class="flex items-center justify-between px-5 py-3 cursor-pointer hover:bg-gray-50 border-b border-gray-100 select-none list-none [&::-webkit-details-marker]:hidden">
        <span class="text-sm font-semibold text-gray-700"><%= t("accounting.financial_statements.trading.net_sales") %></span>
        <div class="flex items-center gap-3">
          <span class="text-sm font-bold text-gray-900 tabular-nums"><%= copyable_amount(@coa.total_revenue_cents) %></span>
          <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </summary>
      <% if @coa.revenue_lines.any? %>
        <table class="w-full text-sm border-b border-gray-100">
          <tbody class="divide-y divide-gray-50">
            <% @coa.revenue_lines.each do |line| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-8 py-2 text-gray-400 font-mono text-xs w-16"><%= line.code %></td>
                <td class="px-3 py-2 text-gray-600"><%= line.name %></td>
                <td class="px-5 py-2 text-end tabular-nums text-gray-700">
                  <span class="group/copy inline-flex items-center whitespace-nowrap"><%= link_to format_amount(line.balance_cents),
                        pnl_drill_down_path(line.code, start_date: @start_date, end_date: @end_date),
                        class: "hover:text-blue-700 hover:underline",
                        title: pnl_drill_down_hint(line.code) %><%= copy_amount_button(line.balance_cents) %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <%# A period with no revenue must say so. An empty section reads as a
            rendering fault, which on a financial statement is worse than a zero. %>
        <p class="px-5 py-6 text-sm text-gray-400 text-center"><%= t("accounting.financial_statements.no_revenue") %></p>
      <% end %>
    </details>

    <%# ── COST OF GOODS SOLD ── %>
    <div class="px-5 py-3 bg-red-50 border-b border-red-100 border-t border-t-gray-200">
      <h2 class="text-xs font-bold text-red-700 uppercase tracking-wide"><%= t("accounting.financial_statements.trading.cogs_section") %></h2>
    </div>

    <details class="group" open>
      <summary class="flex items-center justify-between px-5 py-3 cursor-pointer hover:bg-gray-50 border-b border-gray-100 select-none list-none [&::-webkit-details-marker]:hidden">
        <span class="text-sm font-semibold text-gray-700"><%= t("accounting.financial_statements.trading.cost_of_goods_sold") %></span>
        <div class="flex items-center gap-3">
          <span class="text-sm font-bold text-red-700 tabular-nums">(<%= copyable_amount(cogs_cents) %>)</span>
          <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </summary>

      <div class="border-b border-gray-100">
        <%# Opening stock row with inline edit %>
        <div class="flex items-center justify-between px-8 py-2.5 text-sm border-b border-gray-50 hover:bg-gray-50/60">
          <span class="text-gray-600"><%= t("accounting.financial_statements.trading.opening_stock") %>
            <% if @opening_snapshot %>
              <span class="ms-2 text-xs text-gray-400"><%= l(@opening_snapshot.snapshot_date, format: :short) %></span>
            <% end %>
          </span>
          <div class="flex items-center gap-2">
            <span class="tabular-nums text-gray-700"><%= copyable_amount(@opening_cents) %></span>
            <button type="button"
                    class="print:hidden text-xs text-blue-600 hover:underline"
                    onclick="document.getElementById('opening-stock-form').classList.toggle('hidden')">
              <%= t("actions.edit") %>
            </button>
          </div>
        </div>
        <div id="opening-stock-form" class="hidden px-8 py-3 bg-blue-50/40 border-b border-blue-100">
          <%= form_with url: update_inventory_snapshot_admin_accounting_financial_statements_path, method: :post, class: "flex flex-wrap items-end gap-3" do |f| %>
            <%= hidden_field_tag :start_date, @start_date %>
            <%= hidden_field_tag :end_date, @end_date %>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("accounting.financial_statements.trading.snapshot_date") %></label>
              <%= date_field_tag :snapshot_date, @opening_snapshot&.snapshot_date || @start_date, class: pos_input_class %>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("accounting.financial_statements.trading.stock_value") %></label>
              <%= text_field_tag :value_cents_input,
                    @opening_cents.zero? ? nil : (@opening_cents.to_d / 100).round(2),
                    placeholder: "0.00", step: 0.01, class: pos_input_class %>
            </div>
            <%= submit_tag t("actions.save"), class: "bg-blue-600 text-white text-xs font-semibold px-4 py-2.5 rounded-xl hover:bg-blue-700 transition-colors" %>
          <% end %>
        </div>

        <%# Purchases row %>
        <div class="flex items-center justify-between px-8 py-2.5 text-sm border-b border-gray-50 hover:bg-gray-50/60">
          <span class="text-gray-600"><%= t("accounting.financial_statements.trading.purchases") %></span>
          <span class="tabular-nums text-gray-700">
            <span class="group/copy inline-flex items-center whitespace-nowrap"><%= link_to format_amount(@coa.purchases_cents),
                  pnl_drill_down_path(5100, start_date: @start_date, end_date: @end_date),
                  class: "hover:text-blue-700 hover:underline",
                  title: t("accounting.financial_statements.drill_down_hint") %><%= copy_amount_button(@coa.purchases_cents) %></span>
          </span>
        </div>

        <%# Closing stock row with inline edit %>
        <div class="flex items-center justify-between px-8 py-2.5 text-sm border-b border-gray-50 hover:bg-gray-50/60">
          <span class="text-gray-600"><%= t("accounting.financial_statements.trading.closing_stock") %>
            <% if @closing_snapshot %>
              <span class="ms-2 text-xs text-gray-400"><%= l(@closing_snapshot.snapshot_date, format: :short) %></span>
            <% end %>
          </span>
          <div class="flex items-center gap-2">
            <span class="tabular-nums text-gray-700">(<%= copyable_amount(@closing_cents) %>)</span>
            <button type="button"
                    class="print:hidden text-xs text-blue-600 hover:underline"
                    onclick="document.getElementById('closing-stock-form').classList.toggle('hidden')">
              <%= t("actions.edit") %>
            </button>
          </div>
        </div>
        <div id="closing-stock-form" class="hidden px-8 py-3 bg-blue-50/40 border-b border-blue-100">
          <%= form_with url: update_inventory_snapshot_admin_accounting_financial_statements_path, method: :post, class: "flex flex-wrap items-end gap-3" do |f| %>
            <%= hidden_field_tag :start_date, @start_date %>
            <%= hidden_field_tag :end_date, @end_date %>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("accounting.financial_statements.trading.snapshot_date") %></label>
              <%= date_field_tag :snapshot_date, @closing_snapshot&.snapshot_date || @end_date, class: pos_input_class %>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("accounting.financial_statements.trading.stock_value") %></label>
              <%= text_field_tag :value_cents_input,
                    @closing_cents.zero? ? nil : (@closing_cents.to_d / 100).round(2),
                    placeholder: "0.00", step: 0.01, class: pos_input_class %>
            </div>
            <%= submit_tag t("actions.save"), class: "bg-blue-600 text-white text-xs font-semibold px-4 py-2.5 rounded-xl hover:bg-blue-700 transition-colors" %>
          <% end %>
        </div>

      </div>
    </details>

    <%# ── GROSS PROFIT ── %>
    <div class="flex items-center justify-between px-5 py-4 border-t-2 border-gray-300 <%= gross_profit_cents >= 0 ? 'bg-emerald-50' : 'bg-orange-50' %>">
      <span class="text-base font-bold <%= gross_profit_cents >= 0 ? 'text-emerald-800' : 'text-orange-800' %>">
        <%= t("accounting.financial_statements.trading.gross_profit") %>
      </span>
      <span class="text-lg font-bold tabular-nums <%= gross_profit_cents >= 0 ? 'text-emerald-700' : 'text-orange-700' %>">
        <%= gross_profit_cents < 0 ? "(" : "" %><%= copyable_amount(gross_profit_cents, text: format_amount(gross_profit_cents.abs)) %><%= gross_profit_cents < 0 ? ")" : "" %>
      </span>
    </div>

    <%# ── OPERATING EXPENSES ── %>
    <details class="group" open>
      <summary class="flex items-center justify-between px-5 py-3 cursor-pointer hover:bg-gray-50 border-b border-gray-100 border-t-2 border-t-gray-200 bg-red-50/60 select-none list-none [&::-webkit-details-marker]:hidden">
        <span class="text-sm font-semibold text-gray-700"><%= t("accounting.financial_statements.trading.operating_expenses") %></span>
        <div class="flex items-center gap-3">
          <span class="text-sm font-bold text-red-700 tabular-nums">(<%= copyable_amount(@coa.total_operating_expenses_cents) %>)</span>
          <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </summary>

    <%# Sub-section 1: Payroll %>
    <% if @coa.payroll_expense_lines.any? %>
      <details class="group" open>
        <summary class="flex items-center justify-between px-5 py-2.5 cursor-pointer hover:bg-gray-50 border-b border-gray-100 bg-gray-50/40 select-none list-none [&::-webkit-details-marker]:hidden">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-wide"><%= t("accounting.financial_statements.trading.payroll_expenses") %></span>
          <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-red-700 tabular-nums">(<%= copyable_amount(@coa.total_payroll_expense_cents) %>)</span>
            <svg class="w-3.5 h-3.5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </summary>
        <table class="w-full text-sm border-b border-gray-100">
          <tbody class="divide-y divide-gray-50">
            <% @coa.payroll_expense_lines.each do |line| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-8 py-2 text-gray-400 font-mono text-xs w-16"><%= line.code %></td>
                <td class="px-3 py-2 text-gray-600"><%= line.name %></td>
                <td class="px-5 py-2 text-end tabular-nums text-gray-700">
                  <span class="group/copy inline-flex items-center whitespace-nowrap"><%= link_to format_amount(line.balance_cents),
                        pnl_drill_down_path(line.code, start_date: @start_date, end_date: @end_date),
                        class: "hover:text-blue-700 hover:underline",
                        title: pnl_drill_down_hint(line.code) %><%= copy_amount_button(line.balance_cents) %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </details>
    <% end %>

    <%# Sub-section 2: Other operating expenses %>
    <% if @coa.other_expense_lines.any? %>
      <details class="group" open>
        <summary class="flex items-center justify-between px-5 py-2.5 cursor-pointer hover:bg-gray-50 border-b border-gray-100 bg-gray-50/40 select-none list-none [&::-webkit-details-marker]:hidden">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-wide"><%= t("accounting.financial_statements.trading.other_expenses") %></span>
          <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-red-700 tabular-nums">(<%= copyable_amount(@coa.total_other_expense_cents) %>)</span>
            <svg class="w-3.5 h-3.5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </summary>
        <table class="w-full text-sm border-b border-gray-100">
          <tbody class="divide-y divide-gray-50">
            <% @coa.other_expense_lines.each do |line| %>
              <tr class="hover:bg-gray-50/60">
                <td class="px-8 py-2 text-gray-400 font-mono text-xs w-16"><%= line.code %></td>
                <td class="px-3 py-2 text-gray-600"><%= line.name %></td>
                <td class="px-5 py-2 text-end tabular-nums text-gray-700">
                  <span class="group/copy inline-flex items-center whitespace-nowrap"><%= link_to format_amount(line.balance_cents),
                        pnl_drill_down_path(line.code, start_date: @start_date, end_date: @end_date),
                        class: "hover:text-blue-700 hover:underline",
                        title: pnl_drill_down_hint(line.code) %><%= copy_amount_button(line.balance_cents) %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </details>
    <% end %>

    <%# Both sub-sections above are conditional, so an expense-free period leaves
        this card blank unless it says otherwise. %>
    <% if @coa.payroll_expense_lines.none? && @coa.other_expense_lines.none? %>
      <p class="px-5 py-6 text-sm text-gray-400 text-center"><%= t("accounting.financial_statements.no_expenses") %></p>
    <% end %>

    </details><%# end outer operating expenses details %>

    <%# ── NET PROFIT ── %>
    <div class="flex items-center justify-between px-5 py-5 border-t-2 border-gray-900 <%= net_profit_cents >= 0 ? 'bg-emerald-50' : 'bg-orange-50' %>">
      <span class="text-lg font-black <%= net_profit_cents >= 0 ? 'text-emerald-900' : 'text-orange-900' %>">
        <%= t("accounting.financial_statements.trading.net_profit") %>
      </span>
      <span class="text-xl font-black tabular-nums <%= net_profit_cents >= 0 ? 'text-emerald-700' : 'text-orange-700' %>">
        <%= net_profit_cents < 0 ? "(" : "" %><%= copyable_amount(net_profit_cents, text: format_amount(net_profit_cents.abs)) %><%= net_profit_cents < 0 ? ")" : "" %>
      </span>
    </div>

  </div><%# end trading account card %>

  <%# ── Stock value notice if missing ─────────────────────────── %>
  <% if @opening_cents.zero? || @closing_cents.zero? %>
    <div class="print:hidden rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-800 mb-4">
      <%= t("accounting.financial_statements.trading.snapshot_hint") %>
    </div>
  <% end %>

</div>
