<% content_for :title, t("accounting.cash_flow.title") %>
<%= render "admin/accounting/nav" %>

<div class="max-w-3xl print:max-w-none">

  <%# ── Header ──────────────────────────────────────────────────── %>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= t("accounting.cash_flow.title") %>
      </h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= t("accounting.cash_flow.description") %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("accounting.financial_statements.download_pdf"),
            cash_flow_admin_accounting_financial_statements_path(
              start_date: @start_date, end_date: @end_date, format: :pdf
            ),
            target: "_blank",
            class: "inline-flex items-center gap-1.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 px-4 py-2 rounded-xl transition-colors" %>
      <button onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-xl transition-colors">
        <%= t("accounting.financial_statements.print") %>
      </button>
    </div>
  </div>

  <%# ── Date range filter ──────────────────────────────────────── %>
  <div class="print:hidden">
    <%= render "admin/accounting/date_range_form" %>
  </div>

  <%# ── Print header ───────────────────────────────────────────── %>
  <div class="hidden print:block mb-6">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-base font-semibold text-gray-700"><%= t("accounting.cash_flow.title") %></p>
    <p class="text-sm text-gray-500">
      <%= l(@start_date, format: :long) %> – <%= l(@end_date, format: :long) %>
    </p>
  </div>

  <%# ── Summary bar ────────────────────────────────────────────── %>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">
        <%= t("accounting.cash_flow.beginning_balance") %>
      </p>
      <p class="text-xl font-bold text-gray-900"><%= format_money(@cf.beginning_balance_cents) %></p>
    </div>
    <% net = @cf.net_change_cents %>
    <div class="rounded-2xl border <%= net >= 0 ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50' %> px-5 py-4">
      <p class="text-xs font-semibold <%= net >= 0 ? 'text-emerald-600' : 'text-red-600' %> uppercase tracking-wide mb-1">
        <%= t("accounting.cash_flow.net_change") %>
      </p>
      <p class="text-xl font-bold <%= net >= 0 ? 'text-emerald-800' : 'text-red-800' %>">
        <%= net >= 0 ? "+" : "−" %> <%= format_money(net.abs) %>
      </p>
    </div>
    <div class="rounded-2xl border border-blue-200 bg-blue-50 px-5 py-4">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1">
        <%= t("accounting.cash_flow.ending_balance") %>
      </p>
      <p class="text-xl font-bold text-blue-800"><%= format_money(@cf.ending_balance_cents) %></p>
    </div>
  </div>

  <%# ── Operating Activities ────────────────────────────────────── %>
  <%= render "cash_flow_section",
             section: @cf.operating,
             heading: t("accounting.cash_flow.operating_activities"),
             total_label: t("accounting.cash_flow.net_operating") %>

  <%# ── Investing Activities ────────────────────────────────────── %>
  <%= render "cash_flow_section",
             section: @cf.investing,
             heading: t("accounting.cash_flow.investing_activities"),
             total_label: t("accounting.cash_flow.net_investing") %>

  <%# ── Financing Activities ────────────────────────────────────── %>
  <%= render "cash_flow_section",
             section: @cf.financing,
             heading: t("accounting.cash_flow.financing_activities"),
             total_label: t("accounting.cash_flow.net_financing") %>

  <%# ── Net change reconciliation ───────────────────────────────── %>
  <div class="rounded-2xl border-2 <%= @cf.net_change_cents >= 0 ? 'border-emerald-400 bg-emerald-50' : 'border-orange-400 bg-orange-50' %> overflow-hidden mt-2 print:rounded-none">
    <table class="w-full text-sm">
      <tbody>
        <tr class="border-b border-gray-100">
          <td class="px-5 py-3 font-medium text-gray-700"><%= t("accounting.cash_flow.beginning_balance") %></td>
          <td class="px-5 py-3 text-end tabular-nums font-medium text-gray-900"><%= format_money(@cf.beginning_balance_cents) %></td>
        </tr>
        <tr class="border-b border-gray-100">
          <td class="px-5 py-3 font-medium text-gray-700"><%= t("accounting.cash_flow.net_change") %></td>
          <td class="px-5 py-3 text-end tabular-nums font-medium <%= @cf.net_change_cents >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
            <%= @cf.net_change_cents >= 0 ? "+" : "−" %> <%= format_money(@cf.net_change_cents.abs) %>
          </td>
        </tr>
        <tr>
          <td class="px-5 py-3 text-base font-bold text-gray-900"><%= t("accounting.cash_flow.ending_balance") %></td>
          <td class="px-5 py-3 text-end tabular-nums text-base font-bold text-gray-900"><%= format_money(@cf.ending_balance_cents) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs text-gray-400 print:hidden">
    <%= t("accounting.cash_flow.note") %>
  </p>

</div>
