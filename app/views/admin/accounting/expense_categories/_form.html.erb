<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% form_hint = category.persisted? ? t("accounting.expense_categories.form_hint_edit") : t("accounting.expense_categories.form_hint_new") %>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden max-w-lg">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.expense_categories.form_heading") %></h2>
    <p class="text-xs text-gray-500 mt-0.5"><%= form_hint %></p>
  </div>
  <div class="p-5">
    <%= form_with model: category,
          url: category.persisted? ? admin_accounting_expense_category_path(category) : admin_accounting_expense_categories_path,
          class: "space-y-4" do |f| %>
      <% if category.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50/80 px-4 py-3 text-sm text-red-800" role="alert">
          <%= category.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <div>
        <%= f.label :name, t("accounting.expense_categories.name"), class: label_class %>
        <%= f.text_field :name, class: pos_input_class, autocomplete: "off" %>
      </div>
      <div>
        <%= f.label :category_type, t("accounting.expense_categories.category_type"), class: label_class %>
        <%= f.select :category_type,
              ExpenseCategory::CATEGORY_TYPES.map { |type| [accounting_expense_category_type(type), type] },
              {}, class: "#{pos_input_class} appearance-none" %>
      </div>
      <div>
        <%= f.label :position, t("accounting.expense_categories.position"), class: label_class %>
        <%= f.number_field :position, min: 0, class: pos_input_class %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("accounting.expense_categories.position_hint") %></p>
      </div>
      <div class="flex flex-wrap gap-2 pt-2">
        <%= f.submit class: "bg-gray-900 hover:bg-gray-800 text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-colors" %>
        <%= link_to t("actions.cancel"), admin_accounting_expense_categories_path,
              class: "border border-gray-200 text-gray-700 hover:bg-gray-50 px-5 py-2.5 rounded-xl text-sm font-semibold transition-colors" %>
      </div>
    <% end %>
  </div>
</section>
