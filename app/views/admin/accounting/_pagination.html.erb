<%# Footer pagination bar. Renders whenever there are records; page links show only when there is more than one page. %>
<% if pagy.count.positive? %>
  <div class="flex items-center justify-between gap-4 px-5 py-3 border-t border-gray-100 bg-gray-50/60 text-sm">
    <span class="text-gray-500 tabular-nums">
      <%= t("accounting.shared.pagination_showing", from: pagy.from, to: pagy.to, count: pagy.count) %>
    </span>
    <% if pagy.pages > 1 %>
      <div class="flex items-center gap-4">
        <% if pagy.previous %>
          <%= link_to t("actions.previous"), url_for(request.query_parameters.merge(page: pagy.previous)), class: "text-amber-700 font-semibold hover:text-amber-800" %>
        <% else %>
          <span class="text-gray-300"><%= t("actions.previous") %></span>
        <% end %>
        <span class="text-gray-600"><%= t("accounting.shared.pagination", page: pagy.page, pages: pagy.pages) %></span>
        <% if pagy.next %>
          <%= link_to t("actions.next"), url_for(request.query_parameters.merge(page: pagy.next)), class: "text-amber-700 font-semibold hover:text-amber-800" %>
        <% else %>
          <span class="text-gray-300"><%= t("actions.next") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
