<% content_for :title, t("accounting.fixed_assets.title") %>
<%= render "admin/accounting/nav" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.fixed_assets.title") %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= t("accounting.fixed_assets.description") %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to params[:show_disposed] == "1" ? t("accounting.fixed_assets.hide_disposed") : t("accounting.fixed_assets.show_disposed"),
            admin_accounting_fixed_assets_path(show_disposed: params[:show_disposed] == "1" ? nil : "1"),
            class: "border border-gray-200 text-gray-600 text-sm font-medium px-4 py-2 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("accounting.fixed_assets.new_button"), new_admin_accounting_fixed_asset_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </div>
  </div>

  <%# Summary cards %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-4">
      <p class="text-xs font-semibold text-blue-700 uppercase tracking-wide"><%= t("accounting.fixed_assets.stats.total_cost") %></p>
      <p class="text-2xl font-bold text-blue-900 tabular-nums mt-1"><%= format_money(@total_purchase_cents) %></p>
      <p class="text-xs text-blue-600 mt-1"><%= t("accounting.fixed_assets.stats.original_purchase") %></p>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4">
      <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wide"><%= t("accounting.fixed_assets.stats.book_value") %></p>
      <p class="text-2xl font-bold text-emerald-900 tabular-nums mt-1"><%= format_money(@total_current_value_cents) %></p>
      <p class="text-xs text-emerald-600 mt-1"><%= t("accounting.fixed_assets.stats.current_book_value") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.fixed_assets.stats.asset_count") %></p>
      <p class="text-2xl font-bold text-gray-900 tabular-nums mt-1"><%= @fixed_assets.size %></p>
      <p class="text-xs text-gray-500 mt-1"><%= t("accounting.fixed_assets.stats.active_assets") %></p>
    </div>
  </div>

  <% if @fixed_assets.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("accounting.fixed_assets.col.name") %></th>
            <th class="p-3 text-start"><%= t("accounting.fixed_assets.col.type") %></th>
            <th class="p-3 text-start"><%= t("accounting.fixed_assets.col.location") %></th>
            <th class="p-3 text-end"><%= t("accounting.fixed_assets.col.purchase_price") %></th>
            <th class="p-3 text-end"><%= t("accounting.fixed_assets.col.book_value") %></th>
            <th class="p-3 text-end"><%= t("accounting.fixed_assets.col.depreciation") %></th>
            <th class="p-3 pe-5 text-start"><%= t("accounting.fixed_assets.col.purchase_date") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @fixed_assets.each do |asset| %>
            <tr class="hover:bg-gray-50/60 transition-colors <%= asset.disposed? ? 'opacity-50' : '' %>">
              <td class="p-3 ps-5">
                <%= link_to asset.name, admin_accounting_fixed_asset_path(asset),
                      class: "font-semibold text-blue-700 hover:text-blue-800" %>
                <% if asset.disposed? %>
                  <span class="ms-1 text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 border border-gray-200">
                    <%= t("accounting.fixed_assets.disposed_badge") %>
                  </span>
                <% end %>
                <% if asset.serial_number.present? %>
                  <p class="text-xs text-gray-400 mt-0.5"><%= asset.serial_number %></p>
                <% end %>
              </td>
              <td class="p-3">
                <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                  <%= t("accounting.fixed_assets.types.#{asset.asset_type}") %>
                </span>
              </td>
              <td class="p-3 text-gray-600"><%= asset.location&.name || t("accounting.shared.em_dash") %></td>
              <td class="p-3 text-end tabular-nums text-gray-700"><%= format_money(asset.purchase_price_cents) %></td>
              <td class="p-3 text-end tabular-nums font-semibold text-emerald-700"><%= format_money(asset.current_value_cents) %></td>
              <td class="p-3 text-end tabular-nums text-gray-500">
                <%= asset.depreciation_rate %>%
              </td>
              <td class="p-3 pe-5 text-gray-500 tabular-nums"><%= l(asset.purchase_date, format: :long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% else %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-500 text-sm"><%= t("accounting.fixed_assets.empty") %></p>
      <%= link_to t("accounting.fixed_assets.new_button"), new_admin_accounting_fixed_asset_path,
            class: "mt-4 inline-block bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </div>
  <% end %>
</div>
