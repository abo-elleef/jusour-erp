<% content_for :title, @fixed_asset.name %>
<%= render "admin/accounting/nav" %>

<div class="max-w-3xl">
  <div class="mb-4">
    <%= link_to t("accounting.fixed_assets.back"), admin_accounting_fixed_assets_path,
          class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-6">
    <%= t("accounting.fixed_assets.edit_title", name: @fixed_asset.name) %>
  </h1>

  <section class="rounded-2xl border border-gray-200 bg-white p-6">
    <%= render "form", fixed_asset: @fixed_asset %>
  </section>
</div>
