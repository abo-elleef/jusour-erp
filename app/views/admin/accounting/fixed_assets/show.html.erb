<% content_for :title, @fixed_asset.name %>

<div class="max-w-3xl">
  <div class="mb-4">
    <%= link_to t("accounting.fixed_assets.back"), admin_accounting_fixed_assets_path,
          class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @fixed_asset.name %></h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= t("accounting.fixed_assets.types.#{@fixed_asset.asset_type}") %>
        <% if @fixed_asset.location %>
          · <%= @fixed_asset.location.name %>
        <% end %>
      </p>
    </div>
    <div class="flex gap-2 shrink-0">
      <% if @fixed_asset.disposed? %>
        <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-600 border border-gray-200">
          <%= t("accounting.fixed_assets.disposed_badge") %>
        </span>
      <% else %>
        <%= link_to t("actions.edit"), edit_admin_accounting_fixed_asset_path(@fixed_asset),
              class: "text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl border border-gray-200" %>
        <%= button_to t("accounting.fixed_assets.dispose_button"), dispose_admin_accounting_fixed_asset_path(@fixed_asset),
              method: :patch,
              form: { data: { turbo_confirm: t("accounting.fixed_assets.dispose_confirm", name: @fixed_asset.name) } },
              class: "text-sm font-semibold text-orange-700 hover:bg-orange-50 px-4 py-2 rounded-xl border border-orange-200" %>
      <% end %>
      <%= button_to t("actions.delete"), admin_accounting_fixed_asset_path(@fixed_asset),
            method: :delete,
            form: { data: { turbo_confirm: t("accounting.fixed_assets.delete_confirm", name: @fixed_asset.name) } },
            class: "text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2 rounded-xl border border-red-200" %>
    </div>
  </div>

  <%# Value summary %>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-4">
      <p class="text-xs font-semibold text-blue-700 uppercase tracking-wide"><%= t("accounting.fixed_assets.form.purchase_price") %></p>
      <p class="text-xl font-bold text-blue-900 tabular-nums mt-1"><%= format_money(@fixed_asset.purchase_price_cents) %></p>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4">
      <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wide"><%= t("accounting.fixed_assets.form.current_value") %></p>
      <p class="text-xl font-bold text-emerald-900 tabular-nums mt-1"><%= format_money(@fixed_asset.current_value_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.fixed_assets.depreciation") %></p>
      <p class="text-xl font-bold text-gray-900 tabular-nums mt-1">
        <%= format_money(@fixed_asset.depreciation_cents) %>
        <span class="text-sm font-normal text-gray-400">(<%= @fixed_asset.depreciation_rate %>%)</span>
      </p>
    </div>
  </div>

  <%# Details %>
  <section class="rounded-2xl border border-gray-200 bg-white divide-y divide-gray-100">
    <div class="px-5 py-3 flex justify-between text-sm">
      <span class="text-gray-500"><%= t("accounting.fixed_assets.col.purchase_date") %></span>
      <span class="font-medium text-gray-900"><%= l(@fixed_asset.purchase_date, format: :long) %></span>
    </div>
    <% if @fixed_asset.useful_life_years %>
      <div class="px-5 py-3 flex justify-between text-sm">
        <span class="text-gray-500"><%= t("accounting.fixed_assets.form.useful_life") %></span>
        <span class="font-medium text-gray-900"><%= t("accounting.fixed_assets.years", count: @fixed_asset.useful_life_years) %></span>
      </div>
    <% end %>
    <% if @fixed_asset.serial_number.present? %>
      <div class="px-5 py-3 flex justify-between text-sm">
        <span class="text-gray-500"><%= t("accounting.fixed_assets.form.serial_number") %></span>
        <span class="font-mono text-gray-900"><%= @fixed_asset.serial_number %></span>
      </div>
    <% end %>
    <div class="px-5 py-3 flex justify-between text-sm">
      <span class="text-gray-500"><%= t("accounting.fixed_assets.recorded_by") %></span>
      <span class="text-gray-900"><%= @fixed_asset.recorded_by.name %></span>
    </div>
    <% if @fixed_asset.notes.present? %>
      <div class="px-5 py-4 text-sm">
        <p class="text-gray-500 mb-1"><%= t("accounting.fixed_assets.form.notes") %></p>
        <p class="text-gray-900 whitespace-pre-wrap"><%= @fixed_asset.notes %></p>
      </div>
    <% end %>
  </section>

  <%# Installments only exist for a machine taken on credit; paid outright, the cash
      already left at acquisition and there is nothing to settle. %>
  <% if @fixed_asset.on_credit? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mt-6">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.fixed_assets.payments_heading") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("accounting.fixed_assets.payments_hint") %></p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <span class="text-gray-500"><%= t("accounting.fixed_assets.amount_paid") %></span>
          <span class="font-semibold text-gray-900 tabular-nums"><%= format_money(@fixed_asset.amount_paid_cents) %></span>
          <span class="text-gray-300">·</span>
          <span class="text-gray-500"><%= t("accounting.fixed_assets.balance_due") %></span>
          <span class="font-bold tabular-nums <%= @fixed_asset.settled? ? "text-emerald-700" : "text-amber-800" %>">
            <%= format_money(@fixed_asset.balance_due_cents) %>
          </span>
          <% if @fixed_asset.settled? %>
            <span class="text-xs font-semibold px-2 py-1 rounded-full bg-emerald-100 text-emerald-800">
              <%= t("accounting.fixed_assets.settled") %>
            </span>
          <% end %>
        </div>
      </div>

      <% unless @fixed_asset.settled? %>
        <div class="p-5 border-b border-gray-100 bg-amber-50/30">
          <%= form_with model: @payment, url: record_payment_admin_accounting_fixed_asset_path(@fixed_asset),
                method: :post, class: "flex flex-wrap items-end gap-3" do |f| %>
            <div class="min-w-[9rem]">
              <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.fixed_assets.payment_amount") %></label>
              <%= f.number_field :amount_pounds, step: "0.01", min: "0.01",
                    value: nil, class: pos_input_class, required: true %>
            </div>
            <div class="min-w-[9rem]">
              <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.fixed_assets.payment_date") %></label>
              <%= f.date_field :payment_date, value: Date.current, max: Date.current,
                    class: pos_input_class, required: true %>
            </div>
            <div class="min-w-[11rem]">
              <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.fixed_assets.payment_treasury") %></label>
              <%= f.select :treasury_id,
                    options_from_collection_for_select(@treasuries, :id, :name),
                    { include_blank: t("accounting.fixed_assets.select_treasury") },
                    class: "#{pos_input_class} appearance-none", required: true %>
            </div>
            <div class="flex-1 min-w-[10rem]">
              <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.fixed_assets.payment_notes") %></label>
              <%= f.text_field :notes, class: pos_input_class %>
            </div>
            <%= f.submit t("accounting.fixed_assets.record_payment"),
                  class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors cursor-pointer" %>
          <% end %>
        </div>
      <% end %>

      <% if @payments.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 ps-5 text-start w-12"><%= t("shared.row_index") %></th>
                <th class="p-3 text-start"><%= t("accounting.fixed_assets.payment_date") %></th>
                <th class="p-3 text-start"><%= t("accounting.fixed_assets.payment_treasury") %></th>
                <th class="p-3 text-end"><%= t("accounting.fixed_assets.payment_amount") %></th>
                <th class="p-3 pe-5 text-start"><%= t("accounting.fixed_assets.payment_notes") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 table-zebra">
              <% @payments.each_with_index do |payment, index| %>
                <tr>
                  <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= index + 1 %></td>
                  <td class="p-3 text-gray-700 tabular-nums"><%= l(payment.payment_date) %></td>
                  <td class="p-3 text-gray-700"><%= payment.treasury.name %></td>
                  <td class="p-3 text-end font-semibold text-gray-900 tabular-nums"><%= format_money(payment.amount_cents) %></td>
                  <td class="p-3 pe-5 text-gray-600"><%= payment.notes.presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="p-5 text-sm text-gray-500"><%= t("accounting.fixed_assets.payments_empty") %></p>
      <% end %>
    </section>
  <% end %>
</div>
