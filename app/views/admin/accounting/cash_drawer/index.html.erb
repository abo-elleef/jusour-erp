<%= render "admin/accounting/nav" %>
<div class="max-w-7xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2"><%= t("accounting.cash_drawer.title") %></h1>

  <%= form_with url: admin_accounting_cash_drawer_index_path, method: :get, class: "flex gap-4 items-end mb-6" do %>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.day") %></label>
      <%= date_field_tag :date, @date, class: pos_input_class %>
    </div>
    <%= submit_tag t("actions.view"), class: "bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-semibold" %>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
    <h2 class="text-sm font-semibold text-gray-900 mb-3"><%= t("accounting.cash_drawer.open_drawer") %></h2>
    <%= form_with url: open_session_admin_accounting_cash_drawer_index_path, method: :post, class: "flex flex-wrap gap-4 items-end" do %>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.cash_drawer.shift") %></label>
        <%= select_tag :shift,
              options_for_select(CashDrawerSession::SHIFTS.map { |s| [accounting_shift_label(s), s] }),
              class: pos_input_class %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.cash_drawer.opening_float") %></label>
        <%= number_field_tag :opening_float, 100, step: 0.01, class: pos_input_class %>
      </div>
      <%= submit_tag t("actions.open"), class: "bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-semibold" %>
    <% end %>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("accounting.cash_drawer.cashier") %></th>
          <th class="p-3 text-start"><%= t("accounting.cash_drawer.shift") %></th>
          <th class="p-3 text-start"><%= t("accounting.cash_drawer.status") %></th>
          <th class="p-3 text-end"><%= t("accounting.cash_drawer.expected") %></th>
          <th class="p-3 text-end"><%= t("accounting.cash_drawer.counted") %></th>
          <th class="p-3 text-end"><%= t("accounting.cash_drawer.variance") %></th>
          <th class="p-3 pe-5 text-end"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @sessions.each do |session| %>
          <tr>
            <td class="p-3 ps-5"><%= session.user.name %></td>
            <td class="p-3"><%= accounting_shift_label(session.shift) %></td>
            <td class="p-3"><%= accounting_drawer_status(session.status) %></td>
            <td class="p-3 text-end tabular-nums"><%= session.expected_cash_cents ? format_money(session.expected_cash_cents) : t("accounting.shared.em_dash") %></td>
            <td class="p-3 text-end tabular-nums"><%= session.counted_cash_cents ? format_money(session.counted_cash_cents) : t("accounting.shared.em_dash") %></td>
            <td class="p-3 text-end tabular-nums <%= session.variance_cents.to_i.negative? ? 'text-red-700' : 'text-green-700' %>">
              <%= session.variance_cents ? format_money(session.variance_cents) : t("accounting.shared.em_dash") %>
            </td>
            <td class="p-3 pe-5 text-end">
              <%= link_to t("actions.count"), count_admin_accounting_cash_drawer_path(session), class: "text-amber-700 text-xs font-semibold" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
