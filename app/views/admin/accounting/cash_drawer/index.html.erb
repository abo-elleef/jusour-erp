<% export_params = request.query_parameters.except("print") %>
<% if print_mode? %>
  <%# Twelve columns do not fit an A4 portrait sheet even at 10px. %>
  <style>
    @page { size: A4 landscape; margin: 10mm; }
    @media print { .drawer-day-table th, .drawer-day-table td { padding: 4px 6px !important; } }
  </style>
<% end %>
<div class="max-w-full" <%= tag.attributes(data: { controller: "auto-print" }) if print_mode? %>>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-2 print:mb-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 print:text-xl"><%= t("accounting.cash_drawer.title") %></h1>
      <p class="print-only text-xs text-gray-600 mt-1">
        <%= Current.company&.name %>
        · <%= @location&.name || t("accounting.cash_drawer.all_locations") %>
        · <%= l(@date, format: :long) %>
        <%= "· #{@treasury.name}" if @treasury %>
        · <%= t("inventory.reports.shared.printed_at", time: l(Time.current, format: :short)) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0 print-hide">
      <%= link_to url_for(export_params.merge(format: :csv)),
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <span aria-hidden="true">&darr;</span> <%= t("actions.export_csv") %>
      <% end %>
      <%= link_to url_for(export_params.merge(print: 1)), target: "_blank", rel: "noopener", data: { turbo: false },
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <%= t("inventory.reports.shared.print") %>
      <% end %>
      <%# Receipt-size day totals, only once every drawer of the shown day is closed. %>
      <% if @totals.shifts.positive? %>
        <% if @totals.fully_closed? %>
          <%= link_to t("accounting.cash_drawer.print_receipt"), url_for(export_params.merge(print: "receipt")),
                target: "_blank", rel: "noopener", data: { turbo: false },
                class: "inline-flex items-center gap-2 text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 px-4 py-2.5 rounded-xl transition-colors" %>
        <% else %>
          <span title="<%= t("accounting.cash_drawer.print_receipt_closed_only") %>"
                class="inline-flex items-center gap-2 text-sm font-semibold text-gray-400 px-4 py-2.5 rounded-xl border border-gray-200 cursor-not-allowed">
            <%= t("accounting.cash_drawer.print_receipt") %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= form_with url: admin_accounting_cash_drawer_index_path, method: :get, class: "flex flex-wrap gap-4 items-end mb-6 print-hide" do %>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.day") %></label>
      <%= date_field_tag :date, @date, class: pos_input_class %>
    </div>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("admin.locations.type_branch") %></label>
      <%= select_tag :location_id,
            options_from_collection_for_select(@locations, :id, :name, @location&.id),
            class: pos_input_class, include_blank: t("accounting.cash_drawer.all_locations") %>
    </div>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.cash_drawer.drawer_filter") %></label>
      <%= select_tag :treasury_id,
            options_from_collection_for_select(@drawer_treasuries, :id, :name, @treasury&.id),
            class: pos_input_class, include_blank: t("accounting.cash_drawer.all_drawers") %>
    </div>
    <%= submit_tag t("actions.view"), class: "bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-semibold" %>
  <% end %>

  <%# The day at a glance, before the shift-by-shift detail below it. %>
  <% if @totals.shifts.positive? %>
    <section class="rounded-2xl border border-gray-200 bg-white p-5 mb-6 print:p-0 print:border-0 print:mb-3 break-inside-avoid">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4 print:mb-1.5">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.cash_drawer.day_summary") %></h2>
          <%# The print header above already names the branch and the day. %>
          <p class="text-xs text-gray-500 mt-0.5 print-hide">
            <%= @location&.name || t("accounting.cash_drawer.all_locations") %>
            · <%= l(@date, format: :long) %>
            <%= "· #{@treasury.name}" if @treasury %>
          </p>
        </div>
        <% if @totals.fully_closed? %>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full border border-green-300 bg-green-50 text-green-800">
            <%= t("accounting.cash_drawer.all_closed") %>
          </span>
        <% else %>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full border border-amber-300 bg-amber-50 text-amber-900">
            <%= t("accounting.cash_drawer.still_open", count: @totals.open_shifts) %>
          </span>
        <% end %>
      </div>

      <%# On paper the eight cards become one tight row, so the shifts table starts on page one. %>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 print:grid-cols-8 print:gap-1">
        <% [
             [t("accounting.cash_drawer.shifts"), @totals.shifts, :plain],
             [t("payment.methods.cash"), @totals.cash_cents, :money],
             [t("payment.methods.instapay"), @totals.instapay_cents, :money],
             [t("payment.methods.vodafone_cash"), @totals.vodafone_cash_cents, :money],
             [t("accounting.cash_drawer.opening_float"), @totals.opening_float_cents, :money],
             [t("accounting.cash_drawer.expected"), @totals.expected_cents, :money],
             [t("accounting.cash_drawer.counted"), @totals.counted_cents, :money],
             [t("accounting.cash_drawer.banked"), @totals.deposited_cents, :money]
           ].each do |label, value, kind| %>
          <div class="rounded-xl border border-gray-200 bg-gray-50/70 p-3 print:rounded print:px-1.5 print:py-1">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide print:text-[8px] print:leading-tight print:tracking-normal"><%= label %></p>
            <p class="text-lg font-bold text-gray-900 mt-0.5 tabular-nums print:text-[11px] print:mt-0">
              <%= kind == :money ? format_money(value) : value %>
            </p>
          </div>
        <% end %>
      </div>

      <div class="mt-4 flex flex-wrap gap-6 border-t border-gray-100 pt-4 print:grid print:grid-cols-5 print:gap-1 print:mt-1 print:pt-0 print:border-0">
        <div class="print:rounded print:border print:border-gray-200 print:px-1.5 print:py-1">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide print:text-[8px] print:leading-tight print:tracking-normal"><%= t("accounting.cash_drawer.total_sales") %></p>
          <p class="print:text-[11px] print:mt-0 text-xl font-bold text-green-700 mt-0.5 tabular-nums"><%= format_money(@totals.total_sales_cents) %></p>
        </div>
        <div class="print:rounded print:border print:border-gray-200 print:px-1.5 print:py-1">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide print:text-[8px] print:leading-tight print:tracking-normal"><%= t("accounting.cash_drawer.driver_payouts") %></p>
          <p class="print:text-[11px] print:mt-0 text-xl font-bold text-gray-900 mt-0.5 tabular-nums"><%= format_money(-@totals.driver_payout_cents) %></p>
        </div>
        <div class="print:rounded print:border print:border-gray-200 print:px-1.5 print:py-1">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide print:text-[8px] print:leading-tight print:tracking-normal"><%= t("accounting.cash_drawer.net_takings") %></p>
          <p class="print:text-[11px] print:mt-0 text-xl font-bold text-green-700 mt-0.5 tabular-nums"><%= format_money(@totals.net_takings_cents) %></p>
          <p class="text-xs text-gray-500 mt-0.5 print-hide"><%= t("accounting.cash_drawer.net_takings_hint") %></p>
        </div>
        <div class="print:rounded print:border print:border-gray-200 print:px-1.5 print:py-1">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide print:text-[8px] print:leading-tight print:tracking-normal"><%= t("accounting.cash_drawer.actual_takings") %></p>
          <p class="print:text-[11px] print:mt-0 text-xl font-bold text-gray-900 mt-0.5 tabular-nums"><%= format_money(@totals.actual_takings_cents) %></p>
          <p class="text-xs text-gray-500 mt-0.5 print-hide"><%= t("accounting.cash_drawer.actual_takings_hint") %></p>
        </div>
        <div class="print:rounded print:border print:border-gray-200 print:px-1.5 print:py-1">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide print:text-[8px] print:leading-tight print:tracking-normal"><%= t("accounting.cash_drawer.variance") %></p>
          <p class="print:text-[11px] print:mt-0 text-xl font-bold mt-0.5 tabular-nums <%= @totals.variance_cents.negative? ? "text-red-700" : "text-gray-900" %>">
            <%= format_money(@totals.variance_cents) %>
          </p>
        </div>
      </div>
    </section>
  <% end %>

  <section class="print-flow rounded-2xl border border-gray-200 bg-white overflow-x-auto print:overflow-visible print:rounded-none">
    <table class="drawer-day-table w-full min-w-max whitespace-nowrap text-sm print:min-w-0 print:text-[10px]">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <% if @location.nil? %>
            <th class="p-3 ps-5 text-start"><%= t("admin.locations.type_branch") %></th>
          <% end %>
          <th class="p-3 <%= "ps-5" if @location %> text-start"><%= t("accounting.cash_drawer.cashier") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.treasury") %></th>
          <th class="p-3 text-start"><%= t("accounting.cash_drawer.opened_at") %></th>
          <th class="p-3 text-start"><%= t("accounting.cash_drawer.status") %></th>
          <th class="p-3 text-end"><%= t("payment.methods.cash") %></th>
          <th class="p-3 text-end"><%= t("payment.methods.instapay") %></th>
          <th class="p-3 text-end"><%= t("payment.methods.vodafone_cash") %></th>
          <th class="p-3 text-end"><%= t("accounting.cash_drawer.expected") %></th>
          <th class="p-3 text-end"><%= t("accounting.cash_drawer.counted") %></th>
          <th class="p-3 text-end"><%= t("accounting.cash_drawer.variance") %></th>
          <th class="p-3 text-start"><%= t("accounting.cash_drawer.banked_to") %></th>
          <th class="p-3 pe-5 text-end print-hide"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% @rows.each do |row| %>
          <% session = row.session %>
          <tr>
            <% if @location.nil? %>
              <td class="p-3 ps-5 font-medium text-gray-900"><%= session.location&.name %></td>
            <% end %>
            <td class="p-3 <%= "ps-5" if @location %>">
              <%= link_to session.user.name, admin_accounting_cash_drawer_path(session), class: "font-medium text-amber-700 hover:text-amber-800" %>
            </td>
            <td class="p-3 text-gray-600"><%= session.treasury.name %></td>
            <td class="p-3 tabular-nums"><%= l(session.created_at, format: :short_time) %></td>
            <td class="p-3"><%= accounting_drawer_status(session.status) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(row.cash_cents) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(row.instapay_cents) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(row.vodafone_cash_cents) %></td>
            <td class="p-3 text-end tabular-nums"><%= session.expected_cash_cents ? format_money(session.expected_cash_cents) : t("accounting.shared.em_dash") %></td>
            <td class="p-3 text-end tabular-nums"><%= session.counted_cash_cents ? format_money(session.counted_cash_cents) : t("accounting.shared.em_dash") %></td>
            <td class="p-3 text-end tabular-nums <%= session.variance_cents.to_i.negative? ? 'text-red-700' : 'text-green-700' %>">
              <%= session.variance_cents ? format_money(session.variance_cents) : t("accounting.shared.em_dash") %>
            </td>
            <td class="p-3 text-gray-600">
              <% if row.deposit_treasury && row.deposited_cents.positive? %>
                <%= row.deposit_treasury.name %>
                <span class="text-xs text-gray-400 tabular-nums">· <%= format_money(row.deposited_cents) %></span>
              <% else %>
                <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
              <% end %>
            </td>
            <td class="p-3 pe-5 text-end whitespace-nowrap print-hide">
              <%= link_to t("accounting.cash_drawer.details"), admin_accounting_cash_drawer_path(session), class: "text-gray-700 text-xs font-semibold me-3" %>
              <% if session.status == "open" %>
                <%= link_to t("accounting.cash_drawer.attach_payments"), payments_admin_accounting_cash_drawer_path(session), class: "text-gray-700 text-xs font-semibold me-3" %>
              <% end %>
              <%= link_to t("actions.count"), count_admin_accounting_cash_drawer_path(session), class: "text-amber-700 text-xs font-semibold" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <%# Sums of the rows above, so they follow the branch / drawer filters. %>
      <% if @rows.any? %>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50/80 font-semibold text-gray-900">
          <tr>
            <td class="p-3 ps-5" colspan="<%= @location.nil? ? 5 : 4 %>">
              <%= t("accounting.cash_drawer.table_total") %>
              <span class="text-xs font-normal text-gray-500">(<%= t("accounting.cash_drawer.shifts") %>: <%= @totals.shifts %>)</span>
            </td>
            <td class="p-3 text-end tabular-nums"><%= format_money(@totals.cash_cents) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(@totals.instapay_cents) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(@totals.vodafone_cash_cents) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(@totals.expected_cents) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(@totals.counted_cents) %></td>
            <td class="p-3 text-end tabular-nums <%= @totals.variance_cents.negative? ? 'text-red-700' : 'text-green-700' %>">
              <%= format_money(@totals.variance_cents) %>
            </td>
            <td class="p-3 tabular-nums"><%= format_money(@totals.deposited_cents) %></td>
            <td class="p-3 pe-5 print-hide"></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </section>
</div>
