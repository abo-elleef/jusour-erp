<div class="max-w-3xl">
  <h1 class="text-2xl font-bold mb-2"><%= t("accounting.cash_drawer.attach_title") %></h1>

  <div class="rounded-2xl border border-gray-200 bg-gray-50/80 p-4 mb-4 text-sm">
    <p class="font-semibold text-gray-900">
      <%= t("accounting.cash_drawer.session_line",
            name: @session.user.name,
            date: l(@session.session_date, format: :long)) %>
    </p>
    <p class="text-xs text-gray-500 mt-1"><%= t("accounting.cash_drawer.attach_hint") %></p>
  </div>

  <% if !@attacher.attachable? %>
    <p class="rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
      <%= t("accounting.cash_drawer.attach_closed") %>
    </p>
  <% elsif @payments.empty? %>
    <p class="rounded-2xl border border-gray-200 bg-white p-4 text-sm text-gray-600">
      <%= t("accounting.cash_drawer.attach_none") %>
    </p>
  <% else %>
    <%= form_with url: attach_payments_admin_accounting_cash_drawer_path(@session), method: :patch do %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-4">
        <table class="w-full text-sm">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
            <tr>
              <th class="p-3 ps-5 w-8"></th>
              <th class="p-3 text-start"><%= t("accounting.cash_drawer.attach_order") %></th>
              <th class="p-3 text-start"><%= t("accounting.cash_drawer.cashier") %></th>
              <th class="p-3 text-start"><%= t("accounting.cash_drawer.attach_method") %></th>
              <th class="p-3 text-start"><%= t("accounting.cash_drawer.attach_taken_at") %></th>
              <th class="p-3 pe-5 text-end"><%= t("accounting.cash_drawer.attach_amount") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @payments.each do |payment| %>
              <% taker = payment.processed_by_user || payment.order.user %>
              <tr>
                <td class="p-3 ps-5">
                  <%= check_box_tag "payment_ids[]", payment.id, taker&.id == @session.user_id,
                        id: "payment_#{payment.id}" %>
                </td>
                <td class="p-3 font-medium">
                  <%= link_to "##{payment.order.order_number}", admin_order_path(payment.order), class: "text-amber-700" %>
                </td>
                <td class="p-3 text-gray-600"><%= taker&.name || t("accounting.shared.em_dash") %></td>
                <td class="p-3 text-gray-600"><%= payment_method_label(payment.payment_method) %></td>
                <td class="p-3 tabular-nums"><%= l(payment.created_at, format: :short_time) %></td>
                <td class="p-3 pe-5 text-end tabular-nums"><%= format_money(payment.amount_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>

      <%= submit_tag t("accounting.cash_drawer.attach_submit"),
            class: "bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-semibold",
            data: { turbo_confirm: t("accounting.cash_drawer.attach_confirm") } %>
    <% end %>
  <% end %>

  <p class="mt-4">
    <%= link_to t("actions.back"), admin_accounting_cash_drawer_index_path(date: @session.session_date, location_id: @session.location_id),
          class: "text-sm text-gray-600" %>
  </p>
</div>
