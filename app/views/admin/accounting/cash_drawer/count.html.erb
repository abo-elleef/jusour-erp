<div class="max-w-lg">
  <h1 class="text-2xl font-bold mb-2"><%= t("accounting.cash_drawer.count_title") %></h1>

  <div class="rounded-2xl border border-gray-200 bg-gray-50/80 p-4 mb-4 text-sm">
    <p class="font-semibold text-gray-900">
      <%= t("accounting.cash_drawer.session_line",
            name: @session.user.name,
            date: l(@session.session_date, format: :long)) %>
    </p>
  </div>

  <%= render "shared/session_sales_summary", summary: @sales_summary %>

  <% if @blocking_orders.any? %>
    <%# Same rule as the POS close: these must be finished, collected or voided first. %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
      <h2 class="text-sm font-semibold text-red-800 mb-1"><%= t("accounting.cash_drawer.blocking_orders_title", count: @blocking_orders.size) %></h2>
      <p class="text-xs text-red-700 mb-3"><%= t("accounting.cash_drawer.blocking_orders_hint") %></p>
      <table class="w-full text-sm">
        <thead class="text-xs font-semibold uppercase tracking-wide text-red-700/80">
          <tr>
            <th class="py-1.5 text-start"><%= t("accounting.cash_drawer.order") %></th>
            <th class="py-1.5 text-start"><%= t("admin.orders.status") %></th>
            <th class="py-1.5 text-end"><%= t("accounting.cash_drawer.amount_due") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-red-100">
          <% @blocking_orders.each do |order| %>
            <tr>
              <td class="py-1.5"><%= link_to "##{order.display_number}", admin_order_path(order), class: "font-semibold text-red-900 underline" %></td>
              <td class="py-1.5"><%= order_status_label(order.status) %></td>
              <td class="py-1.5 text-end tabular-nums"><%= format_amount(order.amount_due_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
  <div class="rounded-2xl border border-gray-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-gray-900 mb-1"><%= t("pos.shift.count_cash_heading") %></h2>
    <p class="text-xs text-gray-500 mb-4"><%= t("pos.shift.count_cash_hint") %></p>
    <%= render "shared/cash_denomination_count",
          reconcile_url: reconcile_admin_accounting_cash_drawer_path(@session),
          submit_label: t("accounting.cash_drawer.reconcile_drawer") %>
  </div>
  <% end %>
</div>
