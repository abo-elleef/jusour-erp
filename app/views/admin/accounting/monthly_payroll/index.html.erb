<%= render "admin/accounting/nav" %>
<%= render "admin/accounting/payroll_nav" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.monthly_payroll.title") %></h1>
      <p class="text-sm text-gray-600 mt-1"><%= t("accounting.monthly_payroll.hint", days: User::WORK_DAYS_PER_MONTH) %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <% if policy(PayrollSnapshot).create? && @pending_count.positive? %>
        <% pending_payout_cents = @rows.reject(&:finalized).sum(&:remaining_pay_cents) %>
        <%= form_with url: admin_accounting_monthly_payroll_finalize_all_path(
              payroll_month: @payroll_month.strftime("%Y-%m"),
              location_id: @location_filter.presence
            ),
              method: :post,
              class: "flex flex-wrap items-end gap-2" do %>
          <% if pending_payout_cents.positive? %>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("staff.payroll.advances.treasury") %></label>
              <%= select_tag "payroll_snapshot[treasury_id]",
                    options_from_collection_for_select(@treasuries, :id, :name, @default_treasury&.id),
                    class: "#{pos_input_class} text-sm",
                    required: true %>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("staff.payroll.happened_at") %></label>
              <% default_paid_on = [[Date.current, @payroll_month.end_of_month].min, @payroll_month.beginning_of_month].max %>
              <%= date_field_tag "payroll_snapshot[paid_on]",
                    default_paid_on,
                    min: @payroll_month.beginning_of_month,
                    max: @payroll_month.end_of_month,
                    class: "#{pos_input_class} text-sm",
                    required: true %>
            </div>
          <% end %>
          <%= submit_tag t("accounting.monthly_payroll.record_all"),
                class: "text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl transition-colors",
                data: { turbo_confirm: t("accounting.monthly_payroll.record_all_confirm", count: @pending_count) } %>
        <% end %>
      <% end %>
      <%= link_to t("accounting.monthly_payroll.export_csv"),
            admin_accounting_monthly_payroll_export_path(
              payroll_month: @payroll_month.strftime("%Y-%m"),
              sort: @sort,
              direction: @sort_direction,
              location_id: @location_filter.presence
            ),
            class: "text-sm font-semibold border border-gray-200 px-4 py-2 rounded-xl hover:bg-gray-50" %>
    </div>
  </div>

  <%= form_with url: admin_accounting_monthly_payroll_path, method: :get, class: "flex flex-wrap gap-4 items-end mb-6" do %>
    <%= hidden_field_tag :sort, @sort %>
    <%= hidden_field_tag :direction, @sort_direction %>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("staff.payroll.month") %></label>
      <%= month_field_tag :payroll_month, @payroll_month.strftime("%Y-%m"), class: pos_input_class %>
    </div>
    <% if @filter_locations.size > 1 %>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5" for="location_id"><%= t("accounting.attendance.location") %></label>
        <%= select_tag :location_id,
              options_for_select(
                [
                  [t("accounting.attendance.all_locations"), ""],
                  [t("accounting.attendance.company_wide_staff"), StaffLocationFilter::COMPANY_WIDE_FILTER]
                ] + @filter_locations.map { |l| [l.name, l.id] },
                @location_filter
              ),
              class: "#{pos_input_class} appearance-none min-w-[12rem]",
              id: "location_id" %>
      </div>
    <% end %>
    <%= submit_tag t("actions.apply"), class: "bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-semibold" %>
  <% end %>

  <% if @rows.any? %>
    <% still_to_pay_cents = @rows.reject(&:finalized).sum(&:remaining_pay_cents) %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.monthly_payroll.total_obligation") %></p>
        <p class="text-2xl font-bold text-gray-900 tabular-nums mt-1"><%= format_money(@rows.sum(&:net_pay_cents)) %></p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.monthly_payroll.advances") %></p>
        <p class="text-2xl font-bold text-blue-700 tabular-nums mt-1"><%= format_money(@rows.sum(&:advances_cents)) %></p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.monthly_payroll.total_to_pay") %></p>
        <p class="text-2xl font-bold text-amber-800 tabular-nums mt-1"><%= format_money(@rows.sum(&:remaining_pay_cents)) %></p>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/40 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.monthly_payroll.recorded_count") %></p>
        <p class="text-2xl font-bold text-emerald-700 tabular-nums mt-1"><%= @finalized_count %></p>
        <p class="text-xs text-gray-500 mt-1.5"><%= format_money(@rows.select(&:finalized).sum(&:remaining_pay_cents)) %> <%= t("accounting.monthly_payroll.already_paid_hint") %></p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.monthly_payroll.pending_count") %></p>
        <p class="text-2xl font-bold text-gray-900 tabular-nums mt-1"><%= @pending_count %></p>
      </div>
      <div class="rounded-2xl border border-amber-300 bg-amber-50/60 p-4">
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide"><%= t("accounting.monthly_payroll.still_to_pay") %></p>
        <p class="text-2xl font-bold text-amber-800 tabular-nums mt-1"><%= format_money(still_to_pay_cents) %></p>
        <p class="text-xs text-amber-700 mt-1.5"><%= t("accounting.monthly_payroll.still_to_pay_hint", count: @pending_count) %></p>
      </div>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full text-sm min-w-[1100px]">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
          <th class="p-3 text-start">
            <%= monthly_payroll_sort_link(t("accounting.shift_logs.employee"), "name", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
          </th>
          <th class="p-3 text-end">
            <div class="flex justify-end">
              <%= monthly_payroll_sort_link(t("accounting.monthly_payroll.base_salary"), "base_salary_cents", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
            </div>
          </th>
          <th class="p-3 text-end">
            <div class="flex justify-end">
              <%= monthly_payroll_sort_link(t("accounting.monthly_payroll.attendance_pay"), "attendance_pay_cents", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
            </div>
          </th>
          <th class="p-3 text-end">
            <div class="flex justify-end">
              <%= monthly_payroll_sort_link(t("accounting.monthly_payroll.penalties"), "penalties_cents", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
            </div>
          </th>
          <th class="p-3 text-end">
            <div class="flex justify-end">
              <%= monthly_payroll_sort_link(t("accounting.monthly_payroll.bonuses"), "bonuses_cents", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
            </div>
          </th>
          <th class="p-3 text-end">
            <div class="flex justify-end">
              <%= monthly_payroll_sort_link(t("accounting.monthly_payroll.advances"), "advances_cents", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
            </div>
          </th>
          <th class="p-3 text-end">
            <div class="flex justify-end">
              <%= monthly_payroll_sort_link(t("accounting.monthly_payroll.remaining_pay"), "remaining_pay_cents", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
            </div>
          </th>
          <th class="p-3 text-center">
            <%= monthly_payroll_sort_link(t("accounting.monthly_payroll.status"), "status", sort: @sort, direction: @sort_direction, payroll_month: @payroll_month) %>
          </th>
          <th class="p-3 text-start"><%= t("accounting.monthly_payroll.salary_link") %></th>
          <th class="p-3 pe-5 text-end"><%= t("staff.index.table.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% if @rows.any? %>
          <% month_param = @payroll_month.strftime("%Y-%m") %>
          <% @rows.each_with_index do |row, index| %>
            <tr class="hover:bg-gray-100">
              <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= table_row_number(index) %></td>
              <td class="p-3 font-medium w-48">
                <%= row.user.name %>
              </td>
              <td class="p-3 text-end tabular-nums text-gray-700">
                <%= format_money(row.base_salary_cents) %>
              </td>
              <td class="p-3 text-end tabular-nums">
                <%= format_money(row.attendance_pay_cents) %>
                <% if (days_label = payroll_attendance_days_label(row)) %>
                  <div class="text-[11px] font-normal text-gray-400 whitespace-nowrap"><%= days_label %></div>
                <% end %>
              </td>
              <td class="p-3 text-end tabular-nums text-red-700">−<%= format_money(row.penalties_cents) %></td>
              <td class="p-3 text-end tabular-nums text-emerald-700">+<%= format_money(row.bonuses_cents) %></td>
              <td class="p-3 text-end tabular-nums text-blue-700">−<%= format_money(row.advances_cents) %></td>
              <td class="p-3 text-end font-semibold tabular-nums text-amber-800"><%= format_money(row.remaining_pay_cents) %></td>
              <td class="p-3 text-center">
                <% if row.finalized %>
                  <span class="text-xs font-semibold uppercase px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800"><%= t("accounting.monthly_payroll.status_recorded") %></span>
                <% else %>
                  <span class="text-xs font-semibold uppercase px-2.5 py-1 rounded-full bg-amber-100 text-amber-800"><%= t("accounting.monthly_payroll.status_draft") %></span>
                <% end %>
              </td>
              <td class="p-3 align-middle">
                <% if row.user.payroll_access_token.present? %>
                  <% portal_url = staff_payroll_url(token: row.user.payroll_access_token, payroll_month: month_param) %>
                  <div class="flex items-center gap-1.5 max-w-[16rem]"
                       data-controller="clipboard"
                       data-clipboard-text-value="<%= portal_url %>"
                       data-clipboard-copied-label-value="<%= t("staff.payroll_portal.copied") %>">
                    <input type="text"
                           readonly
                           value="<%= portal_url %>"
                           class="min-w-0 flex-1 bg-gray-50 border border-gray-200 rounded-lg px-2 py-1 text-[11px] text-gray-600 font-mono truncate"
                           data-clipboard-target="source"
                           data-action="click->clipboard#copy"
                           onclick="this.select()"
                           aria-label="<%= t("accounting.monthly_payroll.salary_link") %>">
                    <button type="button"
                            data-action="clipboard#copy"
                            data-clipboard-target="button"
                            class="shrink-0 text-xs font-semibold text-amber-700 hover:bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200 transition-colors">
                      <%= t("staff.payroll_portal.copy_link") %>
                    </button>
                  </div>
                <% else %>
                  <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                <% end %>
              </td>
              <td class="p-3 pe-5 text-end whitespace-nowrap">
                <div class="inline-flex gap-2">
                    <%= render "admin/users/payroll_finalize_button",
                          user: row.user,
                          payroll_month: @payroll_month,
                          payroll_summary: row,
                          return_to: "monthly_payroll",
                          compact: true,
                          treasuries: @treasuries,
                          default_treasury: @default_treasury %>
                  <%= link_to t("staff.payroll.manage"), admin_user_path(row.user, payroll_month: month_param),
                        class: "inline-flex text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-200 transition-colors" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="10" class="p-8 text-center text-gray-500"><%= t("accounting.monthly_payroll.empty") %></td>
          </tr>
        <% end %>
      </tbody>
      <% if @rows.any? %>
        <tfoot class="border-t border-gray-200 bg-gray-50/80 font-semibold">
          <tr>
            <td class="p-3 ps-5"></td>
            <td class="p-3"><%= t("accounting.monthly_payroll.totals") %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(@rows.sum(&:base_salary_cents)) %></td>
            <td class="p-3 text-end tabular-nums"><%= format_money(@rows.sum(&:attendance_pay_cents)) %></td>
            <td class="p-3 text-end tabular-nums text-red-700">−<%= format_money(@rows.sum(&:penalties_cents)) %></td>
            <td class="p-3 text-end tabular-nums text-emerald-700">+<%= format_money(@rows.sum(&:bonuses_cents)) %></td>
            <td class="p-3 text-end tabular-nums text-blue-700">−<%= format_money(@rows.sum(&:advances_cents)) %></td>
            <td class="p-3 text-end tabular-nums text-amber-800"><%= format_money(@rows.sum(&:remaining_pay_cents)) %></td>
            <td class="p-3 text-center text-xs text-gray-500"><%= t("accounting.monthly_payroll.recorded_summary", recorded: @finalized_count, total: @rows.size) %></td>
            <td class="p-3"></td>
            <td class="p-3 pe-5"></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
    </div>
  </section>
</div>
