<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% if @locations.size > 1 %>
  <div class="min-w-[12rem]">
    <%= label_tag :location_id, t("accounting.menu_engineering.branch"), class: label_class %>
    <%= select_tag :location_id,
          options_for_select([[t("accounting.menu_engineering.all_branches"), ""]] + @locations.map { |l| [l.name, l.id] }, @location&.id),
          class: pos_input_class %>
  </div>
<% end %>
<div class="min-w-[12rem]">
  <%= label_tag :category_id, t("accounting.menu_engineering.category"), class: label_class %>
  <%= select_tag :category_id,
        options_for_select([[t("accounting.menu_engineering.all_categories"), ""]] + @categories.map { |c| [c.name, c.id] }, @category&.id),
        class: pos_input_class %>
</div>
