<% content_for :title, @partner.name %>
<%= render "admin/accounting/nav" %>

<div class="max-w-5xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @partner.name %></h1>
      <p class="text-sm text-gray-500 mt-0.5 font-mono"><%= @partner.account_name %> · <%= @partner.account_code %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to t("accounting.partners.record_advance"), new_advance_admin_accounting_partner_path(@partner),
            class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <%= link_to t("actions.edit"), edit_admin_accounting_partner_path(@partner),
            class: "text-sm text-gray-600 hover:text-gray-900 border border-gray-200 px-4 py-2.5 rounded-xl hover:bg-gray-50" %>
    </div>
  </div>

  <%# Balance card %>
  <div class="grid sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border bg-white p-5 <%= @balance_cents >= 0 ? 'border-green-200' : 'border-red-200' %>">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.partners.current_balance") %></p>
      <p class="text-2xl font-bold <%= @balance_cents >= 0 ? 'text-green-700' : 'text-red-600' %>">
        <%= format_money(@balance_cents.abs) %>
        <span class="text-sm font-normal ms-1"><%= @balance_cents >= 0 ? t("accounting.partners.cr") : t("accounting.partners.dr") %></span>
      </p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.partners.col.ownership") %></p>
      <p class="text-2xl font-bold text-gray-900"><%= @partner.ownership_percentage %>%</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.partners.total_movements") %></p>
      <p class="text-2xl font-bold text-gray-900"><%= @lines.size %></p>
    </div>
  </div>

  <%# Ledger %>
  <% if @lines.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-400 text-sm"><%= t("accounting.partners.no_movements") %></p>
    </div>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.partners.ledger_heading") %></h2>
      </div>
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start w-28"><%= t("accounting.journal_entries.col.date") %></th>
            <th class="p-3 text-start w-32"><%= t("accounting.journal_entries.col.number") %></th>
            <th class="p-3 text-start"><%= t("accounting.journal_entries.col.description") %></th>
            <th class="p-3 text-end w-32"><%= t("accounting.journal_entries.col.debit") %></th>
            <th class="p-3 pe-5 text-end w-32"><%= t("accounting.journal_entries.col.credit") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @lines.each do |line| %>
            <tr class="hover:bg-blue-50/30 transition-colors cursor-pointer"
                onclick="window.location='<%= admin_accounting_journal_entry_path(line.journal_entry) %>'">
              <td class="p-3 ps-5 text-gray-500 tabular-nums"><%= l(line.journal_entry.date, format: :short) %></td>
              <td class="p-3 font-mono text-xs text-blue-700 font-semibold"><%= line.journal_entry.entry_number %></td>
              <td class="p-3 text-gray-900"><%= line.journal_entry.description %></td>
              <td class="p-3 text-end tabular-nums <%= line.debit_cents > 0 ? 'text-red-700 font-semibold' : 'text-gray-300' %>">
                <%= line.debit_cents > 0 ? format_money(line.debit_cents) : "—" %>
              </td>
              <td class="p-3 pe-5 text-end tabular-nums <%= line.credit_cents > 0 ? 'text-green-700 font-semibold' : 'text-gray-300' %>">
                <%= line.credit_cents > 0 ? format_money(line.credit_cents) : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50/80">
          <tr>
            <td colspan="3" class="p-3 ps-5 text-xs font-bold text-gray-600 text-end"><%= t("accounting.journal_entries.totals") %></td>
            <td class="p-3 text-end font-bold tabular-nums text-red-700"><%= format_money(@lines.sum(&:debit_cents)) %></td>
            <td class="p-3 pe-5 text-end font-bold tabular-nums text-green-700"><%= format_money(@lines.sum(&:credit_cents)) %></td>
          </tr>
        </tfoot>
      </table>
    </section>
  <% end %>
</div>
