<% content_for :title, @journal_entry.entry_number %>
<div class="print:hidden">
  <%= render "admin/accounting/nav" %>
</div>

<div class="max-w-4xl print:max-w-none">
  <%# Print-only letterhead (visible only when printing) %>
  <div class="hidden print:block mb-6">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-base font-semibold text-gray-700"><%= t("accounting.journal_entries.title") %> — <%= @journal_entry.entry_number %></p>
    <p class="text-sm text-gray-500"><%= l(@journal_entry.date, format: :long) %></p>
    <p class="text-sm text-gray-600 mt-1"><%= @journal_entry.description %></p>
  </div>

  <%# Header %>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6 print:hidden">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 font-mono"><%= @journal_entry.entry_number %></h1>
        <% if @journal_entry.auto? %>
          <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-blue-100 text-blue-700 border border-blue-200">
            <%= t("accounting.journal_entries.type.auto") %>
          </span>
        <% else %>
          <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-amber-100 text-amber-700 border border-amber-200">
            <%= t("accounting.journal_entries.type.manual") %>
          </span>
        <% end %>
        <% unless @journal_entry.balanced? %>
          <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-red-100 text-red-700 border border-red-200">
            ⚠ <%= t("accounting.journal_entries.unbalanced") %>
          </span>
        <% end %>
      </div>
      <p class="text-sm text-gray-600"><%= @journal_entry.description %></p>
      <p class="text-xs text-gray-400 mt-1">
        <%= l(@journal_entry.date, format: :long) %> &middot;
        <%= t("accounting.journal_entries.recorded_by", name: @journal_entry.created_by.name) %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-xl transition-colors cursor-pointer">
        <%= t("accounting.journal_entries.actions.print") %>
      </button>
      <%= link_to t("actions.back"), admin_accounting_journal_entries_path,
            class: "text-sm text-gray-500 hover:text-gray-800 border border-gray-200 px-4 py-2 rounded-xl hover:bg-gray-50" %>
    </div>
  </div>

  <%# Lines table %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.journal_entries.lines_heading") %></h2>
    </div>
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5 text-start w-20"><%= t("accounting.journal_entries.col.code") %></th>
          <th class="p-3 text-start"><%= t("accounting.journal_entries.col.account") %></th>
          <th class="p-3 text-start w-28"><%= t("accounting.journal_entries.col.account_type") %></th>
          <th class="p-3 text-start"><%= t("accounting.journal_entries.col.notes") %></th>
          <th class="p-3 text-end w-36"><%= t("accounting.journal_entries.col.debit") %></th>
          <th class="p-3 pe-5 text-end w-36"><%= t("accounting.journal_entries.col.credit") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% @journal_entry.lines.each do |line| %>
          <tr class="<%= line.debit_cents.positive? ? 'bg-white' : 'table-zebra-alt' %>">
            <td class="p-3 ps-5 font-mono text-xs text-gray-400"><%= line.account_code %></td>
            <td class="p-3 font-medium text-gray-900 <%= line.credit_cents.positive? ? 'ps-10' : '' %>">
              <%= ledger_line_account_name(line) %>
            </td>
            <td class="p-3">
              <span class="text-xs px-2 py-0.5 rounded-full <%= account_type_classes(line.account_type) %>">
                <%= t("accounting.journal_entries.account_types.#{line.account_type}", default: line.account_type.humanize) %>
              </span>
            </td>
            <td class="p-3 text-gray-600"><%= line.notes.presence || "—" %></td>
            <td class="p-3 text-end tabular-nums <%= line.debit_cents.positive? ? 'font-semibold text-gray-900' : 'text-gray-300' %>">
              <%= line.debit_cents.positive? ? format_money(line.debit_cents) : "—" %>
            </td>
            <td class="p-3 pe-5 text-end tabular-nums <%= line.credit_cents.positive? ? 'font-semibold text-gray-900' : 'text-gray-300' %>">
              <%= line.credit_cents.positive? ? format_money(line.credit_cents) : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-gray-200 bg-gray-50/80">
        <tr>
          <td colspan="4" class="p-3 ps-5 text-xs font-bold text-gray-600 text-end"><%= t("accounting.journal_entries.totals") %></td>
          <td class="p-3 text-end font-bold tabular-nums <%= @journal_entry.balanced? ? 'text-emerald-700' : 'text-red-600' %>">
            <%= format_money(@journal_entry.total_debits_cents) %>
          </td>
          <td class="p-3 pe-5 text-end font-bold tabular-nums <%= @journal_entry.balanced? ? 'text-emerald-700' : 'text-red-600' %>">
            <%= format_money(@journal_entry.total_credits_cents) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </section>

  <%# Source reference %>
  <% if @journal_entry.source_record_type.present? %>
    <% source_path  = journal_entry_source_path(@journal_entry) %>
    <% source_label = journal_entry_source_label(@journal_entry) %>
    <div class="rounded-xl border border-gray-200 bg-gray-50/60 px-5 py-4">
      <p class="text-xs text-gray-500">
        <%= t("accounting.journal_entries.source_record") %>:
        <% if source_path %>
          <%= link_to source_label, source_path,
                class: "font-medium text-amber-700 hover:text-amber-800 hover:underline" %>
        <% else %>
          <span class="font-medium text-gray-700"><%= source_label %></span>
        <% end %>
      </p>
    </div>
  <% end %>

  <%# Audit trail %>
  <% if @audit_entries.any? %>
    <div class="rounded-xl border border-gray-200 bg-white overflow-hidden print:hidden">
      <div class="px-5 py-3 border-b border-gray-100 bg-gray-50/80">
        <h3 class="text-sm font-semibold text-gray-700"><%= t("accounting.journal_entries.audit_log_heading") %></h3>
      </div>
      <ol class="divide-y divide-gray-50">
        <% @audit_entries.each do |entry| %>
          <li class="flex gap-4 px-5 py-3.5">
            <div class="mt-0.5 shrink-0 w-2 h-2 rounded-full bg-amber-400 ring-4 ring-amber-50 self-start mt-2"></div>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="text-xs font-semibold text-gray-900"><%= entry.user&.name || t("accounting.shared.em_dash") %></span>
                <span class="font-mono text-xs text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded"><%= t("accounting.journal_entries.audit.#{entry.action.split('.').last}", default: entry.action) %></span>
                <span class="text-xs text-gray-400 ms-auto tabular-nums"><%= l(entry.created_at, format: :short) %></span>
              </div>
              <% if entry.changes_snapshot.present? %>
                <dl class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-0.5 text-xs text-gray-600">
                  <% entry.changes_snapshot.each do |key, value| %>
                    <% next if value.is_a?(Array) %>
                    <div class="flex gap-1.5">
                      <dt class="text-gray-400 shrink-0"><%= key.to_s.humanize %>:</dt>
                      <dd class="font-medium text-gray-700 truncate"><%= value %></dd>
                    </div>
                  <% end %>
                  <% if entry.changes_snapshot["lines"].is_a?(Array) %>
                    <div class="col-span-2 mt-1">
                      <dt class="text-gray-400 mb-0.5"><%= t("accounting.journal_entries.lines_heading") %>:</dt>
                      <% entry.changes_snapshot["lines"].each do |line| %>
                        <dd class="font-medium text-gray-700 tabular-nums">
                          <%= line["account"] %>
                          <% if line["debit_cents"].to_i > 0 %>— Dr <%= format_money(line["debit_cents"]) %><% end %>
                          <% if line["credit_cents"].to_i > 0 %>— Cr <%= format_money(line["credit_cents"]) %><% end %>
                        </dd>
                      <% end %>
                    </div>
                  <% end %>
                </dl>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>
</div>
