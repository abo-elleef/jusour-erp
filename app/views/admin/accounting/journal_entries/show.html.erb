<% content_for :title, @journal_entry.entry_number %>
<%= render "admin/accounting/nav" %>

<div class="max-w-4xl">
  <%# Header %>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 font-mono"><%= @journal_entry.entry_number %></h1>
        <% if @journal_entry.auto? %>
          <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-blue-100 text-blue-700 border border-blue-200">
            <%= t("accounting.journal_entries.type.auto") %>
          </span>
        <% else %>
          <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-amber-100 text-amber-700 border border-amber-200">
            <%= t("accounting.journal_entries.type.manual") %>
          </span>
        <% end %>
        <% unless @journal_entry.balanced? %>
          <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-red-100 text-red-700 border border-red-200">
            ⚠ <%= t("accounting.journal_entries.unbalanced") %>
          </span>
        <% end %>
      </div>
      <p class="text-sm text-gray-600"><%= @journal_entry.description %></p>
      <p class="text-xs text-gray-400 mt-1">
        <%= l(@journal_entry.date, format: :long) %> &middot;
        <%= t("accounting.journal_entries.recorded_by", name: @journal_entry.created_by.name) %>
      </p>
    </div>
    <%= link_to t("actions.back"), admin_accounting_journal_entries_path,
          class: "text-sm text-gray-500 hover:text-gray-800 border border-gray-200 px-4 py-2 rounded-xl hover:bg-gray-50" %>
  </div>

  <%# Lines table %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.journal_entries.lines_heading") %></h2>
    </div>
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5 text-start w-20"><%= t("accounting.journal_entries.col.code") %></th>
          <th class="p-3 text-start"><%= t("accounting.journal_entries.col.account") %></th>
          <th class="p-3 text-start w-28"><%= t("accounting.journal_entries.col.account_type") %></th>
          <th class="p-3 text-end w-36"><%= t("accounting.journal_entries.col.debit") %></th>
          <th class="p-3 pe-5 text-end w-36"><%= t("accounting.journal_entries.col.credit") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @journal_entry.lines.each do |line| %>
          <tr class="<%= line.debit_cents.positive? ? 'bg-white' : 'bg-gray-50/40' %>">
            <td class="p-3 ps-5 font-mono text-xs text-gray-400"><%= line.account_code %></td>
            <td class="p-3 font-medium text-gray-900 <%= line.credit_cents.positive? ? 'ps-10' : '' %>">
              <%= line.account_name %>
            </td>
            <td class="p-3">
              <span class="text-xs px-2 py-0.5 rounded-full <%= account_type_classes(line.account_type) %>">
                <%= t("accounting.journal_entries.account_types.#{line.account_type}", default: line.account_type.humanize) %>
              </span>
            </td>
            <td class="p-3 text-end tabular-nums <%= line.debit_cents.positive? ? 'font-semibold text-gray-900' : 'text-gray-300' %>">
              <%= line.debit_cents.positive? ? format_money(line.debit_cents) : "—" %>
            </td>
            <td class="p-3 pe-5 text-end tabular-nums <%= line.credit_cents.positive? ? 'font-semibold text-gray-900' : 'text-gray-300' %>">
              <%= line.credit_cents.positive? ? format_money(line.credit_cents) : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-gray-200 bg-gray-50/80">
        <tr>
          <td colspan="3" class="p-3 ps-5 text-xs font-bold text-gray-600 text-end"><%= t("accounting.journal_entries.totals") %></td>
          <td class="p-3 text-end font-bold tabular-nums <%= @journal_entry.balanced? ? 'text-emerald-700' : 'text-red-600' %>">
            <%= format_money(@journal_entry.total_debits_cents) %>
          </td>
          <td class="p-3 pe-5 text-end font-bold tabular-nums <%= @journal_entry.balanced? ? 'text-emerald-700' : 'text-red-600' %>">
            <%= format_money(@journal_entry.total_credits_cents) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </section>

  <%# Source reference %>
  <% if @journal_entry.source_record_type.present? %>
    <div class="rounded-xl border border-gray-200 bg-gray-50/60 px-5 py-4">
      <p class="text-xs text-gray-500">
        <%= t("accounting.journal_entries.source_record") %>:
        <span class="font-medium text-gray-700"><%= @journal_entry.source_record_type %> #<%= @journal_entry.source_record_id %></span>
      </p>
    </div>
  <% end %>
</div>
