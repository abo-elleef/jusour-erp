<% content_for :title, t("accounting.journal_entries.title") %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.journal_entries.title") %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= t("accounting.journal_entries.description") %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("accounting.journal_entries.export_csv"),
            admin_accounting_journal_entries_path(
              format: :csv,
              start_date: @start_date, end_date: @end_date,
              entry_type: @entry_type, account_code: @account_code
            ),
            class: "inline-flex items-center gap-1.5 text-sm font-semibold text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2.5 rounded-xl transition-colors" %>
      <%= link_to t("accounting.journal_entries.new_button"), new_admin_accounting_journal_entry_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </div>
  </div>

  <%= render "admin/accounting/date_range_form" %>

  <%# Account code filter badge — shown when arriving from P&L drill-down %>
  <% if @account_code %>
    <div class="flex items-center gap-3 mb-4 -mt-2 p-3 rounded-xl bg-blue-50 border border-blue-200">
      <span class="text-xs font-semibold text-blue-700 uppercase tracking-wide"><%= t("accounting.journal_entries.filter.account_code_label") %></span>
      <span class="font-mono text-sm font-bold text-blue-900"><%= @account_code %></span>
      <span class="text-sm text-blue-700"><%= t("accounting.journal_entries.filter.account_code_hint") %></span>
      <%= link_to t("actions.clear"),
            admin_accounting_journal_entries_path(start_date: params[:start_date], end_date: params[:end_date], entry_type: @entry_type),
            class: "ms-auto text-xs font-semibold text-blue-700 hover:text-blue-900 underline" %>
    </div>
  <% end %>

  <%# Entry type filter %>
  <div class="flex gap-2 mb-6 -mt-2">
    <%= link_to t("accounting.journal_entries.filter.all"),
          admin_accounting_journal_entries_path(start_date: params[:start_date], end_date: params[:end_date]),
          class: "text-sm px-4 py-2 rounded-xl border font-medium #{@entry_type.blank? ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'}" %>
    <%= link_to t("accounting.journal_entries.filter.auto"),
          admin_accounting_journal_entries_path(start_date: params[:start_date], end_date: params[:end_date], entry_type: "auto"),
          class: "text-sm px-4 py-2 rounded-xl border font-medium #{@entry_type == 'auto' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'}" %>
    <%= link_to t("accounting.journal_entries.filter.manual"),
          admin_accounting_journal_entries_path(start_date: params[:start_date], end_date: params[:end_date], entry_type: "manual"),
          class: "text-sm px-4 py-2 rounded-xl border font-medium #{@entry_type == 'manual' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'}" %>
  </div>

  <%# Sorting swaps the table inside this frame, so the reader stays where they
      clicked instead of being thrown back to the top of the page. The filters
      above stay outside it: those change the counts, so they reload in full. %>
  <%= turbo_frame_tag "journal_entries_table", data: { turbo_action: "advance" } do %>
  <% if @journal_entries.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-400 text-sm"><%= t("accounting.journal_entries.empty") %></p>
    </div>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <% sort_opts = { sort: @sort, direction: @direction } %>
          <tr>
            <th class="p-3 ps-5 text-end w-12 text-gray-400">#</th>
            <th class="p-3 text-start w-36"><%= t("accounting.journal_entries.col.number") %></th>
            <th class="p-3 text-start w-28"><%= sort_header_link(t("accounting.journal_entries.col.date"), :date, **sort_opts) %></th>
            <th class="p-3 text-start"><%= t("accounting.journal_entries.col.description") %></th>
            <th class="p-3 text-start w-24"><%= t("accounting.journal_entries.col.type") %></th>
            <th class="p-3 text-end w-32"><%= sort_header_link(t("accounting.journal_entries.col.debits"), :debits, **sort_opts) %></th>
            <th class="p-3 pe-5 text-end w-32"><%= sort_header_link(t("accounting.journal_entries.col.credits"), :credits, **sort_opts) %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @journal_entries.each_with_index do |entry, row_number| %>
            <tr class="hover:bg-blue-50/30 transition-colors cursor-pointer"
                onclick="window.location='<%= admin_accounting_journal_entry_path(entry) %>'">
              <td class="p-3 ps-5 text-end tabular-nums text-xs text-gray-400"><%= row_number + 1 %></td>
              <td class="p-3" onclick="event.stopPropagation()">
                <%# A real link, not just a blue-looking cell: the row's onclick cannot
                    be opened in a new tab or reached from the keyboard, and this is
                    the entry's name — the same rule every other index follows. %>
                <%= link_to entry.entry_number, admin_accounting_journal_entry_path(entry),
                      class: "font-mono text-xs text-blue-700 font-semibold hover:underline" %>
              </td>
              <td class="p-3 text-gray-500 tabular-nums"><%= l(entry.date, format: :short) %></td>
              <td class="p-3 text-gray-900 font-medium"><%= entry.description %></td>
              <td class="p-3">
                <% if entry.auto? %>
                  <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-blue-100 text-blue-700 border border-blue-200">
                    <%= t("accounting.journal_entries.type.auto") %>
                  </span>
                <% else %>
                  <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-amber-100 text-amber-700 border border-amber-200">
                    <%= t("accounting.journal_entries.type.manual") %>
                  </span>
                <% end %>
              </td>
              <td class="p-3 text-end tabular-nums text-gray-900"><%= format_amount(entry.total_debits_cents) %></td>
              <td class="p-3 pe-5 text-end tabular-nums text-gray-900"><%= format_amount(entry.total_credits_cents) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50/80">
          <tr>
            <td colspan="5" class="p-3 ps-5 text-xs font-bold text-gray-600 text-end">
              <%= t("accounting.journal_entries.total_entries", count: @journal_entries.size) %>
            </td>
            <td class="p-3 text-end font-bold tabular-nums text-gray-900">
              <%= format_amount(@journal_entries.sum { |e| e.total_debits_cents }) %>
            </td>
            <td class="p-3 pe-5 text-end font-bold tabular-nums text-gray-900">
              <%= format_amount(@journal_entries.sum { |e| e.total_credits_cents }) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </section>
  <% end %>
  <% end %>
</div>
