<% if loan.errors.any? %>
  <div class="mb-6 rounded-xl bg-red-50 border border-red-200 px-4 py-3">
    <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
      <% loan.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="grid sm:grid-cols-2 gap-5">
  <div class="sm:col-span-2">
    <%= form.label :name, t("accounting.loans.form.name"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :name, required: true,
          class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :loan_type, t("accounting.loans.form.loan_type"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.select :loan_type,
          Loan::LOAN_TYPES.map { |t| [I18n.t("accounting.loans.types.#{t}"), t] },
          {},
          class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :interest_rate, t("accounting.loans.form.interest_rate"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <div class="relative">
      <%= form.number_field :interest_rate, step: 0.01, min: 0, max: 100,
            class: "w-full rounded-xl border border-gray-300 ps-3 pe-10 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <span class="absolute end-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">%</span>
    </div>
  </div>

  <div>
    <%= form.label :principal_cents, t("accounting.loans.form.principal"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <p class="text-xs text-gray-400 mb-1"><%= t("accounting.loans.form.principal_hint") %></p>
    <div class="relative">
      <input type="number" name="loan[principal_cents]" id="loan_principal_cents" step="1" min="0"
             value="<%= loan.principal_cents %>"
             class="w-full rounded-xl border border-gray-300 ps-3 pe-14 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      <span class="absolute end-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"><%= t("currency.piastres_abbr", default: "pt") %></span>
    </div>
  </div>

  <div>
    <%= form.label :disbursement_date, t("accounting.loans.form.disbursement_date"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.date_field :disbursement_date,
          class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :due_date, t("accounting.loans.form.due_date"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.date_field :due_date,
          class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="sm:col-span-2">
    <%= form.label :notes, t("accounting.loans.form.notes"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_area :notes, rows: 3,
          class: "w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <% if loan.persisted? %>
    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-blue-600" %>
      <%= form.label :active, t("accounting.loans.form.active"), class: "text-sm font-semibold text-gray-700" %>
    </div>
  <% end %>
</div>
