<% content_for :title, @loan.name %>
<%= render "admin/accounting/nav" %>

<div class="max-w-5xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @loan.name %></h1>
      <p class="text-sm text-gray-500 mt-0.5 font-mono"><%= @loan.account_name %> · <%= @loan.account_code %> · <%= t("accounting.loans.types.#{@loan.loan_type}") %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("accounting.loans.record_disbursement"), new_disbursement_admin_accounting_loan_path(@loan),
            class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <% if @loan.ledger_untouched? %>
        <%= link_to t("accounting.loans.record_opening_balance"), new_opening_balance_admin_accounting_loan_path(@loan),
              class: "bg-gray-800 hover:bg-gray-900 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <% end %>
      <%= link_to t("accounting.loans.record_repayment"), new_repayment_admin_accounting_loan_path(@loan),
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <%= link_to t("accounting.loans.record_interest"), new_interest_admin_accounting_loan_path(@loan),
            class: "bg-gray-600 hover:bg-gray-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <%= link_to t("actions.edit"), edit_admin_accounting_loan_path(@loan),
            class: "text-sm text-gray-600 hover:text-gray-900 border border-gray-200 px-4 py-2.5 rounded-xl hover:bg-gray-50" %>
    </div>
  </div>

  <%# Stat cards %>
  <div class="grid sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-6">
    <div class="rounded-2xl border bg-white p-5 <%= @outstanding_cents > 0 ? 'border-red-200' : 'border-green-200' %>">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.loans.outstanding_balance") %></p>
      <p class="text-2xl font-bold <%= @outstanding_cents > 0 ? 'text-red-700' : 'text-green-700' %>">
        <%= format_money(@outstanding_cents.abs) %>
        <span class="text-sm font-normal ms-1"><%= @outstanding_cents > 0 ? t("accounting.loans.liability") : t("accounting.loans.settled") %></span>
      </p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.loans.col.principal") %></p>
      <p class="text-2xl font-bold text-gray-900"><%= format_money(@loan.principal_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.loans.col.interest_rate") %></p>
      <p class="text-2xl font-bold text-gray-900"><%= @loan.interest_rate %>%</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.loans.payments_progress") %></p>
      <p class="text-2xl font-bold text-gray-900">
        <% if @loan.installments_total.present? %>
          <%= @loan.payments_made_count %><span class="text-gray-400 text-lg">/<%= @loan.installments_total %></span>
        <% else %>
          <%= @loan.payments_made_count %>
        <% end %>
      </p>
      <p class="text-xs text-gray-500 mt-0.5">
        <% if @loan.payments_remaining_count %>
          <%= t("accounting.loans.payments_remaining", count: @loan.payments_remaining_count) %>
        <% else %>
          <%= t("accounting.loans.payments_made") %>
        <% end %>
      </p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= t("accounting.loans.col.due_date") %></p>
      <p class="text-xl font-bold <%= @loan.due_date && @loan.due_date < Date.current && @outstanding_cents > 0 ? 'text-red-600' : 'text-gray-900' %>">
        <%= @loan.due_date.present? ? l(@loan.due_date, format: :long) : "—" %>
      </p>
    </div>
  </div>

  <% if @loan.notes.present? %>
    <div class="mb-6 rounded-xl bg-amber-50 border border-amber-200 px-4 py-3">
      <p class="text-sm text-amber-800"><%= @loan.notes %></p>
    </div>
  <% end %>

  <%# Ledger %>
  <% if @lines.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-400 text-sm"><%= t("accounting.loans.no_movements") %></p>
      <p class="text-xs text-gray-400 mt-1"><%= t("accounting.loans.no_movements_hint") %></p>
    </div>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.loans.ledger_heading") %></h2>
      </div>
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start w-28"><%= t("accounting.journal_entries.col.date") %></th>
            <th class="p-3 text-start w-32"><%= t("accounting.journal_entries.col.number") %></th>
            <th class="p-3 text-start"><%= t("accounting.journal_entries.col.description") %></th>
            <th class="p-3 text-end w-32"><%= t("accounting.journal_entries.col.debit") %></th>
            <th class="p-3 pe-5 text-end w-32"><%= t("accounting.journal_entries.col.credit") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @lines.each do |line| %>
            <% voucher_path = journal_entry_source_path(line.journal_entry) if line.journal_entry.source_record_type == "Voucher" %>
            <tr class="hover:bg-blue-50/30 transition-colors cursor-pointer"
                onclick="window.location='<%= admin_accounting_journal_entry_path(line.journal_entry) %>'">
              <td class="p-3 ps-5 text-gray-500 tabular-nums"><%= l(line.journal_entry.date, format: :short) %></td>
              <td class="p-3 font-mono text-xs text-blue-700 font-semibold"><%= line.journal_entry.entry_number %></td>
              <td class="p-3 text-gray-900">
                <% if voucher_path %>
                  <%# Breaks out of the row's own click-through to the journal entry. %>
                  <%= link_to line.journal_entry.description, voucher_path,
                        onclick: "event.stopPropagation()",
                        class: "text-amber-700 hover:text-amber-900 hover:underline underline-offset-2" %>
                <% else %>
                  <%= line.journal_entry.description %>
                <% end %>
              </td>
              <td class="p-3 text-end tabular-nums <%= line.debit_cents > 0 ? 'text-red-700 font-semibold' : 'text-gray-300' %>">
                <%= line.debit_cents > 0 ? format_money(line.debit_cents) : "—" %>
              </td>
              <td class="p-3 pe-5 text-end tabular-nums <%= line.credit_cents > 0 ? 'text-green-700 font-semibold' : 'text-gray-300' %>">
                <%= line.credit_cents > 0 ? format_money(line.credit_cents) : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50/80">
          <tr>
            <td colspan="3" class="p-3 ps-5 text-xs font-bold text-gray-600 text-end"><%= t("accounting.journal_entries.totals") %></td>
            <td class="p-3 text-end font-bold tabular-nums text-red-700"><%= format_money(@lines.sum(&:debit_cents)) %></td>
            <td class="p-3 pe-5 text-end font-bold tabular-nums text-green-700"><%= format_money(@lines.sum(&:credit_cents)) %></td>
          </tr>
        </tfoot>
      </table>
    </section>
  <% end %>
</div>
