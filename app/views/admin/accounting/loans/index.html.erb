<% content_for :title, t("accounting.loans.title") %>

<div class="max-w-full">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.loans.title") %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= t("accounting.loans.description") %></p>
    </div>
    <%= link_to t("accounting.loans.new_button"), new_admin_accounting_loan_path,
          class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
  </div>

  <% if @loans.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-400 text-sm"><%= t("accounting.loans.empty") %></p>
    </div>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("accounting.loans.col.name") %></th>
            <th class="p-3 text-start w-28"><%= t("accounting.loans.col.type") %></th>
            <th class="p-3 text-end w-32"><%= t("accounting.loans.col.principal") %></th>
            <th class="p-3 text-end w-32"><%= t("accounting.loans.col.outstanding") %></th>
            <th class="p-3 text-start w-28"><%= t("accounting.loans.col.due_date") %></th>
            <th class="p-3 pe-5 text-start w-20"><%= t("accounting.loans.col.status") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @loans.each do |loan| %>
            <% outstanding = loan.outstanding_balance_cents %>
            <% overdue = loan.due_date.present? && loan.due_date < Date.current && outstanding > 0 %>
            <tr class="hover:bg-blue-50/30 transition-colors cursor-pointer"
                onclick="window.location='<%= admin_accounting_loan_path(loan) %>'">
              <td class="p-3 ps-5">
                <p class="font-semibold text-gray-900"><%= loan.name %></p>
                <p class="text-xs text-gray-400 font-mono"><%= loan.account_code %> · <%= loan.interest_rate %>%</p>
              </td>
              <td class="p-3 text-gray-500"><%= t("accounting.loans.types.#{loan.loan_type}") %></td>
              <td class="p-3 text-end tabular-nums text-gray-700"><%= format_money(loan.principal_cents) %></td>
              <td class="p-3 text-end tabular-nums font-semibold <%= outstanding > 0 ? 'text-red-700' : 'text-green-700' %>">
                <%= format_money(outstanding.abs) %>
                <span class="text-xs font-normal text-gray-400 ms-1"><%= outstanding > 0 ? t("accounting.loans.cr") : t("accounting.loans.settled") %></span>
              </td>
              <td class="p-3 <%= overdue ? 'text-red-600 font-semibold' : 'text-gray-500' %>">
                <%= loan.due_date.present? ? l(loan.due_date, format: :long) : "—" %>
              </td>
              <td class="p-3 pe-5">
                <% if loan.active? %>
                  <span class="text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-semibold"><%= t("accounting.loans.active") %></span>
                <% else %>
                  <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 font-semibold"><%= t("accounting.loans.inactive") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>
