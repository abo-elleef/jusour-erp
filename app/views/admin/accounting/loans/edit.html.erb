<% content_for :title, t("accounting.loans.edit_title", name: @loan.name) %>

<div class="max-w-2xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.loans.edit_title", name: @loan.name) %></h1>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-6">
    <%= form_with model: [:admin, :accounting, @loan] do |f| %>
      <%= render "form", form: f, loan: @loan %>
      <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
        <%= link_to t("actions.cancel"), admin_accounting_loan_path(@loan),
              class: "text-sm text-gray-600 hover:text-gray-900 px-4 py-2.5" %>
        <%= f.submit t("actions.save"),
              class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
