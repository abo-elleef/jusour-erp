<% content_for :title, t("accounting.loans.new_title") %>
<%= render "admin/accounting/nav" %>

<div class="max-w-2xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.loans.new_title") %></h1>
    <p class="text-sm text-gray-500 mt-0.5"><%= t("accounting.loans.new_subtitle") %></p>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-6">
    <%= form_with model: [:admin, :accounting, @loan], url: admin_accounting_loans_path do |f| %>
      <%= render "form", form: f, loan: @loan %>
      <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
        <%= link_to t("actions.cancel"), admin_accounting_loans_path,
              class: "text-sm text-gray-600 hover:text-gray-900 px-4 py-2.5" %>
        <%= f.submit t("accounting.loans.create_button"),
              class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
