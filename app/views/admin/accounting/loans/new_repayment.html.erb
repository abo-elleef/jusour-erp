<% content_for :title, t("accounting.loans.repayment.title", name: @loan.name) %>

<div class="max-w-2xl">
  <div class="mb-6">
    <p class="text-sm text-gray-500 mb-1">
      <%= link_to @loan.name, admin_accounting_loan_path(@loan), class: "text-blue-600 hover:underline" %>
    </p>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.loans.repayment.title", name: @loan.name) %></h1>
    <p class="text-sm text-gray-500 mt-0.5"><%= t("accounting.loans.repayment.subtitle") %></p>
  </div>

  <% if @error %>
    <div class="mb-4 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700"><%= @error %></div>
  <% end %>

  <div class="rounded-2xl border border-gray-200 bg-white p-6">
    <%= form_with url: create_repayment_admin_accounting_loan_path(@loan), method: :post do |f| %>
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t("accounting.loans.form.date") %></label>
          <input type="date" name="date" value="<%= Date.current %>" required
                 class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t("accounting.loans.form.amount") %></label>
          <div class="relative">
            <input type="number" name="amount" step="0.01" min="0.01" required
                   class="w-full rounded-xl border border-gray-300 ps-3 pe-14 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="0.00" />
            <span class="absolute end-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"><%= t("currency.symbol", default: "ج.م.") %></span>
          </div>
        </div>

        <div class="sm:col-span-2">
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t("accounting.loans.form.treasury") %></label>
          <select name="treasury_id" required
                  class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <% @treasuries.each do |treasury| %>
              <option value="<%= treasury.id %>"><%= treasury.name %></option>
            <% end %>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t("accounting.loans.form.description") %></label>
          <input type="text" name="description"
                 class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                 placeholder="<%= t("accounting.loans.repayment.default_description", name: @loan.name) %>" />
        </div>
      </div>

      <%# JE preview %>
      <div class="mt-5 rounded-xl bg-amber-50 border border-amber-100 p-4">
        <p class="text-xs font-semibold text-amber-700 uppercase tracking-wide mb-2"><%= t("accounting.loans.je_preview") %></p>
        <div class="text-xs text-amber-800 space-y-1">
          <div class="flex justify-between">
            <span><%= t("accounting.journal_entries.col.debit") %> — <%= @loan.account_name %> (<%= @loan.account_code %>)</span>
            <span class="text-green-600">← <%= t("accounting.loans.repayment.liability_decreases") %></span>
          </div>
          <div class="flex justify-between">
            <span><%= t("accounting.journal_entries.col.credit") %> — <%= t("accounting.loans.treasury_account") %></span>
            <span class="text-red-600">← <%= t("accounting.loans.repayment.money_out") %></span>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
        <%= link_to t("actions.cancel"), admin_accounting_loan_path(@loan),
              class: "text-sm text-gray-600 hover:text-gray-900 px-4 py-2.5" %>
        <%= f.submit t("accounting.loans.repayment.submit"),
              class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
