<%= render "admin/accounting/nav" %>

<div class="max-w-5xl">
  <div class="flex flex-wrap justify-between items-start gap-3 mb-2">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.late_penalties.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("accounting.late_penalties.hint") %></p>
    </div>
    <%= link_to t("accounting.late_penalties.back_to_attendance"),
          admin_accounting_attendance_path(payroll_month: @payroll_month.strftime("%Y-%m"), location_id: @location_filter.presence),
          class: "text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
  </div>

  <%= form_with url: admin_accounting_late_penalties_path, method: :get, class: "flex flex-wrap gap-4 items-end mb-6" do %>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("staff.payroll.month") %></label>
      <%= month_field_tag :payroll_month, @payroll_month.strftime("%Y-%m"), class: pos_input_class, onchange: "this.form.requestSubmit()" %>
    </div>
    <% if @filter_locations.size > 1 %>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.attendance.location") %></label>
        <%= select_tag :location_id,
              options_for_select(
                [
                  [t("accounting.attendance.all_locations"), ""],
                  [t("accounting.attendance.company_wide_staff"), StaffLocationFilter::COMPANY_WIDE_FILTER]
                ] + @filter_locations.map { |l| [l.name, l.id] },
                @location_filter
              ),
              class: "#{pos_input_class} appearance-none min-w-[12rem]",
              onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>
  <% end %>

  <% if @groups.any? %>
    <% total_count = @groups.values.sum(&:size) %>
    <% total_days = @groups.values.flatten.sum(&:day_units) %>
    <% total_cents = @groups.values.flatten.sum(&:amount_cents) %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.late_penalties.staff_count") %></p>
        <p class="text-2xl font-bold text-gray-900 tabular-nums mt-1"><%= @groups.size %></p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.late_penalties.penalty_count") %></p>
        <p class="text-2xl font-bold text-gray-900 tabular-nums mt-1"><%= total_count %>
          <span class="text-sm font-semibold text-gray-500">(<%= number_with_precision(total_days, precision: 2, strip_insignificant_zeros: true) %> <%= t("accounting.late_penalties.days") %>)</span>
        </p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("accounting.late_penalties.total") %></p>
        <p class="text-2xl font-bold text-red-700 tabular-nums mt-1">−<%= format_money(total_cents) %></p>
      </div>
    </div>

    <div class="space-y-4">
      <% @groups.each do |user, adjustments| %>
        <% days = adjustments.sum(&:day_units) %>
        <% amount = adjustments.sum(&:amount_cents) %>
        <% finalized = @finalized_user_ids.include?(user.id) %>
        <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-gray-100 bg-gray-50/80">
            <div>
              <%= link_to user.name, admin_user_path(user, payroll_month: @payroll_month.strftime("%Y-%m")),
                    class: "text-sm font-semibold text-gray-900 hover:text-amber-800" %>
              <p class="text-xs text-gray-500 mt-0.5">
                <%= t("accounting.late_penalties.group_summary",
                      count: adjustments.size,
                      days: number_with_precision(days, precision: 2, strip_insignificant_zeros: true)) %>
              </p>
            </div>
            <p class="text-sm font-bold text-red-700 tabular-nums">−<%= format_money(amount) %></p>
          </div>

          <% if finalized %>
            <p class="px-5 py-2 text-xs text-amber-800 bg-amber-50 border-b border-amber-100"><%= t("accounting.late_penalties.payroll_recorded") %></p>
          <% end %>

          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase">
                <tr>
                  <th class="p-3 ps-5 text-start"><%= t("staff.payroll.happened_at") %></th>
                  <th class="p-3 text-start"><%= t("staff.payroll.unit") %></th>
                  <th class="p-3 text-end"><%= t("staff.payroll.amount") %></th>
                  <th class="p-3 text-start"><%= t("staff.payroll.recorded_by") %></th>
                  <th class="p-3 pe-5 text-end"><%= t("staff.payroll.actions_column") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% adjustments.each do |adj| %>
                  <tr>
                    <td class="p-3 ps-5 text-gray-700 whitespace-nowrap tabular-nums"><%= l(adj.happened_at, format: :long) %></td>
                    <td class="p-3 text-gray-700"><%= adj.unit_label %></td>
                    <td class="p-3 text-end font-semibold tabular-nums text-red-700">−<%= format_money(adj.amount_cents) %></td>
                    <td class="p-3 text-gray-500 text-xs"><%= adj.recorded_by.name %></td>
                    <td class="p-3 pe-5 text-end">
                      <% if policy(adj).destroy? && !finalized %>
                        <%= button_to t("actions.remove"),
                              admin_accounting_late_penalty_path(adj, payroll_month: @payroll_month.strftime("%Y-%m"), location_id: @location_filter.presence),
                              method: :delete,
                              form: { data: { turbo_confirm: t("staff.payroll.remove_confirm") }, class: "inline" },
                              class: "text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-2xl border border-gray-200 bg-white px-5 py-10 text-center text-sm text-gray-500"><%= t("accounting.late_penalties.empty") %></p>
  <% end %>
</div>
