<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden max-w-lg">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.treasuries.form_heading") %></h2>
  </div>
  <div class="p-5">
    <%= form_with model: treasury,
          url: treasury.persisted? ? admin_accounting_treasury_path(treasury) : admin_accounting_treasuries_path,
          class: "space-y-4" do |f| %>
      <% if treasury.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50/80 px-4 py-3 text-sm text-red-800" role="alert">
          <%= treasury.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <div>
        <%= f.label :name, t("accounting.treasuries.name"), class: label_class %>
        <%= f.text_field :name, class: pos_input_class, required: true %>
      </div>
      <div>
        <%= f.label :treasury_type, t("accounting.treasuries.treasury_type"), class: label_class %>
        <%= f.select :treasury_type,
              (Treasury::TYPES - ["supplier_ap"]).map { |type| [accounting_treasury_type(type), type] },
              {}, class: "#{pos_input_class} appearance-none" %>
      </div>
      <% if treasury.new_record? %>
        <div>
          <%= f.label :opening_balance_pounds, t("accounting.treasuries.opening_balance"), class: label_class %>
          <%= f.number_field :opening_balance_pounds, min: 0, step: "0.01", class: pos_input_class %>
        </div>
      <% end %>
      <div>
        <%= f.label :position, t("accounting.treasuries.position"), class: label_class %>
        <%= f.number_field :position, min: 0, class: pos_input_class %>
      </div>
      <div>
        <%= f.label :notes, t("accounting.treasuries.notes"), class: label_class %>
        <%= f.text_area :notes, rows: 3, class: pos_input_class %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :active, class: "rounded border-gray-300" %>
        <%= f.label :active, t("accounting.treasuries.active"), class: "text-sm text-gray-700" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :is_default, class: "rounded border-gray-300" %>
        <%= f.label :is_default, t("accounting.treasuries.default"), class: "text-sm text-gray-700" %>
      </div>
      <div class="flex flex-wrap gap-2 pt-2">
        <%= f.submit class: "bg-gray-900 hover:bg-gray-800 text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-colors" %>
        <%= link_to t("actions.cancel"), treasury.persisted? ? admin_accounting_treasury_path(treasury) : admin_accounting_treasuries_path,
              class: "border border-gray-200 text-gray-700 hover:bg-gray-50 px-5 py-2.5 rounded-xl text-sm font-semibold transition-colors" %>
      </div>
    <% end %>
  </div>
</section>
