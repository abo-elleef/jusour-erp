<%= render "admin/accounting/nav" %>
<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @treasury.name %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= accounting_treasury_type(@treasury.treasury_type) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("accounting.treasury_transfers.new_button"),
            new_admin_accounting_treasury_transfer_path(from_treasury_id: @treasury.id),
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-xl" %>
      <%= link_to t("actions.edit"), edit_admin_accounting_treasury_path(@treasury),
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-4 py-2 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("accounting.treasuries.back"), admin_accounting_treasuries_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5">
      <p class="text-xs font-semibold text-amber-800 uppercase"><%= t("accounting.treasuries.balance") %></p>
      <p class="text-3xl font-bold text-amber-950 tabular-nums mt-1"><%= format_money(@treasury.balance_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 sm:col-span-2">
      <% if @treasury.notes.present? %>
        <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("accounting.treasuries.notes") %></p>
        <p class="text-sm text-gray-700 mt-1"><%= @treasury.notes %></p>
      <% else %>
        <p class="text-sm text-gray-500"><%= t("accounting.treasuries.no_notes") %></p>
      <% end %>
    </div>
  </div>

  <%# Supplier AP ledgers are derived from their invoices, so they get no
      free-hand adjustment — see TreasuriesController#adjust. %>
  <% if @treasury.supplier_ap? %>
    <section class="rounded-2xl border border-gray-200 bg-gray-50 p-5 mb-6">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.treasuries.manual_adjustment") %></h2>
      <p class="text-sm text-gray-600 mt-1"><%= t("accounting.treasuries.ap_adjustment_blocked_hint") %></p>
    </section>
  <% else %>
  <section class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
    <h2 class="text-sm font-semibold text-gray-900 mb-4"><%= t("accounting.treasuries.manual_adjustment") %></h2>
    <%= form_with url: adjust_admin_accounting_treasury_path(@treasury), method: :post, class: "flex flex-wrap items-end gap-4" do %>
      <div class="min-w-[10rem]">
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.amount") %></label>
        <%= number_field_tag :amount_pounds, nil, step: "0.01", class: pos_input_class, placeholder: "50.00 or -50.00", required: true %>
      </div>
      <div class="min-w-[10rem]">
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.day") %></label>
        <%= date_field_tag :occurred_on, Date.current, class: pos_input_class %>
      </div>
      <div class="flex-1 min-w-[12rem]">
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.description") %></label>
        <%= text_field_tag :description, nil, class: pos_input_class, placeholder: t("accounting.treasuries.adjustment_placeholder") %>
      </div>
      <%= submit_tag t("accounting.treasuries.record_adjustment"), class: "bg-gray-900 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shrink-0" %>
    <% end %>
    <p class="text-xs text-gray-400 mt-2"><%= t("accounting.treasuries.adjustment_hint") %></p>
  </section>
  <% end %>

  <%= render "admin/accounting/date_range_form" %>

  <%# The transaction list lives in a frame so switching grouping or stepping a
      week re-renders only the table — the admin shell scrolls an inner <main>,
      and a full navigation would throw the reader back to the top. The date
      range form above stays outside it: its state is session-backed, so it
      keeps `data: { turbo: false }` and reloads in full. %>
  <%= turbo_frame_tag "treasury_transactions", data: { turbo_action: "advance" } do %>
  <% grouping_params = request.query_parameters.except("page", "week", "group_by") %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.treasuries.transactions_title") %></h2>
      <div class="flex flex-wrap items-center gap-2">
        <%# Grouping toggle. Flat mode keeps the plain 100-rows-a-page list;
            day mode paginates a whole business week at a time instead. %>
        <div class="inline-flex rounded-lg border border-gray-200 overflow-hidden text-xs font-semibold">
          <%= link_to t("accounting.treasuries.group_flat"),
                url_for(grouping_params),
                class: "px-3 py-1.5 #{@group_by_day ? 'text-gray-600 hover:bg-gray-50' : 'bg-amber-600 text-white'}" %>
          <%= link_to t("accounting.treasuries.group_by_day"),
                url_for(grouping_params.merge(group_by: "day")),
                class: "px-3 py-1.5 border-s border-gray-200 #{@group_by_day ? 'bg-amber-600 text-white' : 'text-gray-600 hover:bg-gray-50'}" %>
        </div>
        <%# A file download can't land inside a frame. %>
        <%= link_to t("accounting.treasuries.export_csv"),
              admin_accounting_treasury_path(@treasury, format: :csv, start_date: @start_date, end_date: @end_date),
              data: { turbo_frame: "_top" },
              class: "text-xs font-semibold text-gray-600 hover:text-gray-900 border border-gray-200 hover:bg-gray-50 px-3 py-1.5 rounded-lg transition-colors" %>
      </div>
    </div>
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <%# Grouped mode moves the date into the day header above each block,
              so the first column is left carrying only when the row was entered. %>
          <th class="p-3 ps-5 text-start"><%= @group_by_day ? t("accounting.treasuries.entered_at") : t("accounting.shared.day") %></th>
          <th class="p-3 text-start"><%= t("accounting.treasuries.transaction_kind") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.description") %></th>
          <th class="p-3 text-end"><%= t("accounting.treasuries.amount") %></th>
          <th class="p-3 text-end"><%= t("accounting.treasuries.balance_after") %></th>
          <th class="p-3 pe-5 text-start"><%= t("accounting.treasuries.recorded_by") %></th>
        </tr>
      </thead>
      <% if @group_by_day %>
        <%# One <tbody> per day, opened by a header row carrying that day's
            in/out/net — the number the reader actually came for. No zebra here:
            the day headers already break the table up. %>
        <% @day_groups.each do |group| %>
          <tbody class="divide-y divide-gray-100 border-t border-gray-100">
            <tr class="bg-gray-100/70">
              <td colspan="6" class="px-5 py-2.5">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="text-sm font-semibold text-gray-900"><%= l(group[:day], format: :day_header) %></span>
                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class="inline-flex items-baseline gap-1.5 px-2 py-0.5 rounded-lg border bg-emerald-50 border-emerald-200 text-emerald-900">
                      <span class="font-bold tabular-nums"><%= format_amount(group[:in_cents]) %></span>
                      <span class="opacity-80"><%= t("accounting.treasuries.stats_in_amount") %></span>
                    </span>
                    <span class="inline-flex items-baseline gap-1.5 px-2 py-0.5 rounded-lg border bg-red-50 border-red-200 text-red-900">
                      <span class="font-bold tabular-nums"><%= format_amount(group[:out_cents]) %></span>
                      <span class="opacity-80"><%= t("accounting.treasuries.stats_out_amount") %></span>
                    </span>
                    <span class="inline-flex items-baseline gap-1.5 px-2 py-0.5 rounded-lg border <%= group[:net_cents].negative? ? "bg-white border-red-200 text-red-800" : "bg-white border-gray-200 text-gray-800" %>">
                      <span class="font-bold tabular-nums"><%= format_amount(group[:net_cents]) %></span>
                      <span class="opacity-80"><%= t("accounting.treasuries.day_net") %></span>
                    </span>
                    <span class="text-gray-400 tabular-nums"><%= t("accounting.treasuries.day_count", count: group[:rows].size) %></span>
                  </div>
                </div>
              </td>
            </tr>
            <%= render partial: "admin/accounting/treasuries/transaction_row",
                  collection: group[:rows], as: :tx, locals: { grouped: true } %>
          </tbody>
        <% end %>
      <% else %>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <%= render partial: "admin/accounting/treasuries/transaction_row",
                collection: @transactions, as: :tx, locals: { grouped: false } %>
        </tbody>
      <% end %>
    </table>
    <% if @group_by_day %>
      <% if @day_groups.empty? %>
        <p class="p-8 text-center text-sm text-gray-500"><%= t("accounting.treasuries.no_transactions_week") %></p>
      <% end %>
      <%= render "admin/accounting/treasuries/week_pagination" %>
    <% else %>
      <% if @transactions.empty? %>
        <p class="p-8 text-center text-sm text-gray-500"><%= t("accounting.treasuries.no_transactions") %></p>
      <% end %>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    <% end %>
  </section>
  <% end %>
</div>
