<%# locals: entries, title %>
<div class="p-3 w-64">
  <p class="text-xs font-semibold text-gray-700 mb-2 truncate"><%= title %></p>
  <% if entries.empty? %>
    <p class="text-xs text-gray-500"><%= t("accounting.attendance.history_empty") %></p>
  <% else %>
    <ul class="space-y-2 max-h-64 overflow-y-auto">
      <% entries.each do |entry| %>
        <% old_id, new_id = entry.changes_snapshot["attendance_status_id"] %>
        <% old_status = old_id && AttendanceStatus.unscoped.find_by(id: old_id) %>
        <% new_status = new_id && AttendanceStatus.unscoped.find_by(id: new_id) %>
        <li class="text-xs border-b border-gray-100 pb-2 last:border-0 last:pb-0">
          <div class="flex items-center justify-between gap-2">
            <span class="font-medium text-gray-900"><%= entry.user&.name || t("accounting.shared.em_dash") %></span>
            <span class="text-gray-400 whitespace-nowrap tabular-nums"><%= l(entry.created_at, format: :short) %></span>
          </div>
          <div class="mt-1 text-gray-600 flex flex-wrap items-center gap-x-1.5 gap-y-1">
            <%= attendance_status_chip(old_status) %>
            <span class="text-gray-400" aria-hidden="true">&rarr;</span>
            <%= attendance_status_chip(new_status) %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
