<%= render "admin/accounting/nav" %>

<div class="max-w-full"
     data-controller="attendance-grid"
     data-attendance-grid-url-value="<%= admin_accounting_attendance_path %>"
     data-attendance-grid-adjustment-url-value="<%= admin_accounting_attendance_adjustment_path %>"
     data-attendance-grid-symbols-value="<%= @statuses.map(&:symbol).to_json %>"
     data-attendance-grid-colors-value="<%= @statuses.to_h { |s| [s.symbol, attendance_color_classes(s.color)] }.to_json %>"
     data-attendance-grid-saving-value="<%= t('accounting.attendance.saving') %>"
     data-attendance-grid-saved-value="<%= t('accounting.attendance.saved') %>"
     data-attendance-grid-error-value="<%= t('accounting.attendance.save_error') %>">

  <div class="flex flex-wrap justify-between items-start gap-3 mb-2">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.attendance.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("accounting.attendance.hint") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to t("accounting.nav.late_penalties"),
            admin_accounting_late_penalties_path(payroll_month: @payroll_month.strftime("%Y-%m"), location_id: @location_filter.presence),
            class: "text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
      <span data-attendance-grid-target="status" class="text-xs text-gray-400"></span>
    </div>
  </div>

  <%= form_with url: admin_accounting_attendance_path, method: :get, class: "flex flex-wrap gap-4 items-end mb-4" do %>
    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("staff.payroll.month") %></label>
      <%= month_field_tag :payroll_month, @payroll_month.strftime("%Y-%m"), class: pos_input_class, onchange: "this.form.requestSubmit()" %>
    </div>
    <% if @filter_locations.size > 1 %>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.attendance.location") %></label>
        <%= select_tag :location_id,
              options_for_select(
                [
                  [t("accounting.attendance.all_locations"), ""],
                  [t("accounting.attendance.company_wide_staff"), StaffLocationFilter::COMPANY_WIDE_FILTER]
                ] + @filter_locations.map { |l| [l.name, l.id] },
                @location_filter
              ),
              class: "#{pos_input_class} appearance-none min-w-[12rem]",
              onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>
  <% end %>

  <%# Legend (also guarantees Tailwind compiles every status color used below) %>
  <div class="flex flex-wrap gap-x-4 gap-y-2 mb-4 text-xs text-gray-600">
    <% @statuses.each do |status| %>
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded font-semibold <%= attendance_color_classes(status.color) %>"><%= status.symbol %></span>
        <%= status.label %>
        <span class="text-gray-400">
          (<%= status.paid? ? t("accounting.attendance.paid") : t("accounting.attendance.unpaid") %><%= status.penalty_days.to_d.positive? ? ", +#{number_with_precision(status.penalty_days, precision: 2, strip_insignificant_zeros: true)} #{t('accounting.attendance.penalty')}" : "" %>)
        </span>
      </span>
    <% end %>
    <span class="text-gray-400"><%= t("accounting.attendance.blank_hint") %></span>
  </div>

  <% if @staff.any? %>
    <div class="overflow-auto border border-gray-200 rounded-2xl max-h-[72vh] relative">
      <table class="attendance-grid-table text-sm border-collapse" data-attendance-grid-target="table">
        <thead>
          <tr class="bg-gray-50">
            <th class="sticky start-0 top-0 z-20 bg-gray-50 text-start text-xs font-semibold text-gray-500 uppercase p-3 min-w-[10rem] border-b border-e border-gray-200"><%= t("accounting.shift_logs.employee") %></th>
            <% @days.each do |day| %>
              <% weekend = day.friday? || day.saturday? %>
              <th class="sticky top-0 z-10 <%= weekend ? 'bg-gray-100' : 'bg-gray-50' %> text-center px-0 py-2 border-b border-e border-gray-200 min-w-[2.25rem]"
                  data-attendance-day
                  data-attendance-col="<%= day.iso8601 %>"
                  data-date="<%= day.iso8601 %>"
                  data-action="click->attendance-grid#pinColumn"
                  title="<%= t('accounting.attendance.highlight_day') %>">
                <div class="text-xs font-semibold text-gray-700 tabular-nums"><%= day.day %></div>
                <div class="text-[10px] text-gray-400"><%= l(day, format: "%a") %></div>
              </th>
            <% end %>
            <th class="sticky top-0 z-10 bg-gray-50 text-end text-xs font-semibold text-gray-500 uppercase px-2 py-2 border-b border-s border-e border-gray-200 min-w-[3rem]"><%= t("accounting.attendance.payable") %></th>
            <th class="sticky top-0 z-10 bg-gray-50 text-end text-xs font-semibold text-gray-500 uppercase px-2 py-2 border-b border-e border-gray-200 min-w-[3rem]"><%= t("accounting.attendance.bonus") %></th>
            <th class="sticky top-0 z-10 bg-gray-50 text-end text-xs font-semibold text-gray-500 uppercase px-2 py-2 border-b border-e border-gray-200 min-w-[3rem]"><%= t("accounting.attendance.penalty") %></th>
            <% @statuses.each do |status| %>
              <th class="sticky top-0 z-10 bg-gray-50 text-center text-xs font-semibold uppercase px-1.5 py-2 border-b border-e border-gray-200 min-w-[2rem] <%= attendance_color_classes(status.color) %>"
                  title="<%= status.label %>"><%= status.symbol %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @staff.each do |user| %>
            <% summary = @summaries[user] %>
            <% counts = @status_counts[user] %>
            <tr data-user-id="<%= user.id %>">
              <th class="sticky start-0 z-10 bg-white text-start p-3 min-w-[10rem] border-e border-gray-200"
                  data-attendance-row-label
                  data-action="click->attendance-grid#pinRow"
                  title="<%= t('accounting.attendance.highlight_staff') %>">
                <div class="flex items-center justify-between gap-2">
                  <% if policy(user).show? %>
                    <%= link_to user.name, admin_user_path(user, payroll_month: @payroll_month.strftime("%Y-%m")),
                          data: { staff_name: true },
                          class: "font-medium text-gray-900 whitespace-nowrap hover:text-amber-700 hover:underline underline-offset-2 transition-colors" %>
                  <% else %>
                    <span data-staff-name class="font-medium text-gray-900 whitespace-nowrap"><%= user.name %></span>
                  <% end %>
                  <button type="button" data-action="attendance-grid#fillRowPresent" data-user-id="<%= user.id %>"
                          class="text-[11px] font-semibold text-amber-700 hover:text-amber-800 border border-amber-200 rounded px-1.5 py-0.5 shrink-0"
                          title="<%= t('accounting.attendance.mark_present') %>">P</button>
                </div>
              </th>
              <% @days.each do |day| %>
                <% status = @cells[[user.id, day]] %>
                <% adj = @day_adjustments[[user.id, day]] || {} %>
                <% weekend = day.friday? || day.saturday? %>
                <td class="p-0.5 text-center border-e border-gray-200 <%= 'bg-gray-50/50' if weekend %>"
                    data-attendance-col="<%= day.iso8601 %>">
                  <div tabindex="0"
                       data-attendance-grid-target="cell"
                       data-user-id="<%= user.id %>"
                       data-date="<%= day.iso8601 %>"
                       data-symbol="<%= status&.symbol %>"
                       data-ot-hours="<%= adj[:overtime_hours] %>"
                       data-penalty-unit="<%= adj[:penalty_unit] %>"
                       class="attendance-cell relative w-8 h-8 mx-auto flex items-center justify-center rounded cursor-pointer select-none font-semibold text-gray-800 hover:ring-1 hover:ring-gray-300 focus:outline-none focus:ring-2 focus:ring-amber-500 <%= attendance_color_classes(status.color) if status %>"><%= status&.symbol %></div>
                </td>
              <% end %>
              <td class="text-end px-2 tabular-nums text-gray-700 border-s border-e border-gray-200" data-attendance-grid-target="summary" data-user-id="<%= user.id %>" data-field="payable"><%= number_with_precision(summary.payable_days, precision: 2, strip_insignificant_zeros: true) %></td>
              <td class="text-end px-2 tabular-nums text-teal-700 border-e border-gray-200" data-attendance-grid-target="summary" data-user-id="<%= user.id %>" data-field="bonus"><%= number_with_precision(summary.bonus_days, precision: 2, strip_insignificant_zeros: true) %></td>
              <td class="text-end px-2 tabular-nums text-red-700 border-e border-gray-200" data-attendance-grid-target="summary" data-user-id="<%= user.id %>" data-field="penalty"><%= number_with_precision(summary.penalty_days, precision: 2, strip_insignificant_zeros: true) %></td>
              <% @statuses.each do |status| %>
                <td class="text-center px-1.5 tabular-nums text-gray-700 border-e border-gray-200 font-medium"
                    data-attendance-grid-target="count"
                    data-user-id="<%= user.id %>"
                    data-symbol="<%= status.symbol %>"
                    title="<%= status.label %>"><%= counts[status.symbol].to_i %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-gray-400 mt-3"><%= t("accounting.attendance.keyboard_hint") %></p>
    <p class="text-xs text-gray-400 mt-1"><%= t("accounting.attendance.crosshair_hint") %></p>
  <% else %>
    <p class="rounded-2xl border border-gray-200 bg-white px-5 py-10 text-center text-sm text-gray-500"><%= t("accounting.attendance.no_staff") %></p>
  <% end %>

  <%# Right-click / long-press a day cell → per-day extra hours + penalty (feeds payroll) %>
  <div data-attendance-grid-target="popover"
       class="hidden fixed z-50 w-60 rounded-xl border border-gray-200 bg-white shadow-lg p-3 text-sm">
    <p class="text-xs font-semibold text-gray-700 mb-2" data-attendance-grid-target="popoverTitle"></p>

    <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("accounting.attendance.extra_hours") %></label>
    <input type="number" min="0" step="0.5" inputmode="decimal"
           data-attendance-grid-target="otInput"
           class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-sm mb-3 focus:outline-none focus:ring-2 focus:ring-amber-500/40">

    <p class="block text-xs font-semibold text-gray-600 mb-1"><%= t("accounting.attendance.penalty") %></p>
    <div class="grid grid-cols-4 gap-1" data-attendance-grid-target="penaltyGroup">
      <% [["", t("accounting.attendance.penalty_none")], ["quarter_day", "¼"], ["half_day", "½"], ["full_day", t("accounting.attendance.penalty_full")]].each do |val, label| %>
        <button type="button" data-penalty="<%= val %>" data-action="attendance-grid#selectPenalty"
                class="attendance-penalty-btn text-xs font-semibold border border-gray-200 rounded-lg py-1.5 hover:bg-gray-50"><%= label %></button>
      <% end %>
    </div>

    <div class="flex items-center gap-2 mt-3">
      <button type="button" data-action="attendance-grid#saveAdjustment"
              class="flex-1 bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-4 py-2 rounded-lg"><%= t("actions.save") %></button>
      <button type="button" data-action="attendance-grid#closePopover"
              class="text-sm font-medium text-gray-600 hover:bg-gray-100 px-3 py-2 rounded-lg"><%= t("actions.cancel") %></button>
    </div>
    <p class="text-[11px] text-gray-400 mt-2"><%= t("accounting.attendance.adjustment_hint") %></p>
  </div>
</div>
