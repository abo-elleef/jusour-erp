<% content_for :title, t("accounting.expenses.title") %>
<%= render "admin/accounting/nav" %>
<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.expenses.title") %></h1>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to t("accounting.nav.expense_categories"), admin_accounting_expense_categories_path,
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50" %>
      <%# Carries whatever narrowed the page — the date range, a category from a
          report drill-down, the search — so the file matches what is on screen. %>
      <%= link_to t("actions.export_csv"),
            admin_accounting_expenses_path(**request.query_parameters.symbolize_keys, format: :csv),
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("accounting.expenses.new_button"), new_admin_accounting_expense_path,
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </div>
  </div>
  <%= render "admin/accounting/date_range_form" %>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
    <% @totals_by_category.each do |(category_id, category_name), cents| %>
      <% active = @active_category_id == category_id.to_s %>
      <% filter_params = { start_date: @start_date, end_date: @end_date } %>
      <% filter_params[:category_id] = category_id unless active %>
      <%= link_to admin_accounting_expenses_path(filter_params),
            class: "rounded-2xl border p-3 transition-colors #{active ? 'border-amber-400 bg-amber-50 ring-1 ring-amber-400' : 'border-gray-200 bg-white hover:border-amber-300 hover:bg-amber-50/50'}" do %>
        <p class="text-xs <%= active ? 'text-amber-700 font-semibold' : 'text-gray-500' %>"><%= category_name %></p>
        <p class="font-bold tabular-nums <%= active ? 'text-amber-900' : '' %>"><%= format_money(cents) %></p>
        <% if active %>
          <p class="text-xs text-amber-600 mt-1">✕ <%= t("actions.clear") %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.day") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.category") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.treasury") %></th>
          <th class="p-3 text-start"><%= t("accounting.shared.description") %></th>
          <th class="p-3 text-end"><%= t("order.labels.total") %></th>
          <th class="p-3 pe-5 text-end"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% @expenses.each_with_index do |expense, index| %>
          <tr class="cursor-pointer hover:bg-amber-50/40 transition-colors"
              data-href="<%= admin_accounting_expense_path(expense) %>"
              onclick="if(!event.target.closest('a,button,form'))Turbo.visit(this.dataset.href)">
            <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= table_row_number(index, pagy: @pagy) %></td>
            <td class="p-3"><%= l(expense.expense_date, format: :long) %></td>
            <td class="p-3"><%= expense.expense_category.name %></td>
            <td class="p-3 text-gray-600"><%= expense.treasury&.name || t("accounting.shared.em_dash") %></td>
            <td class="p-3">
              <%= expense.description %>
              <% if expense.is_auto_generated? %><span class="text-xs text-gray-400"><%= t("accounting.shared.auto") %></span><% end %>
            </td>
            <td class="p-3 text-end font-semibold tabular-nums"><%= format_money(expense.amount_cents) %></td>
            <td class="p-3 pe-5 text-end" onclick="event.stopPropagation()">
              <% unless expense.is_auto_generated? %>
                <% unless expense.reversed_at.present? %>
                  <%= link_to t("actions.edit"), edit_admin_accounting_expense_path(expense), class: "text-amber-700 text-xs font-semibold" %>
                <% end %>
                <% if expense.reversed_at.present? %>
                  <span class="ms-2 text-xs font-semibold text-gray-400 border border-gray-200 px-2 py-0.5 rounded-lg">
                    <%= t("accounting.reversal.reversed_badge") %>
                  </span>
                <% else %>
                  <%= button_to t("accounting.reversal.reverse_entry"),
                        reverse_admin_accounting_expense_path(expense),
                        class: "text-red-700 text-xs font-semibold ms-2 cursor-pointer",
                        form: { style: "display:inline" },
                        data: { turbo_confirm: t("accounting.reversal.confirm") } %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-gray-200 bg-gray-50/80 text-sm">
        <% if @system_cents > 0 %>
          <tr class="border-t border-gray-100">
            <td colspan="5" class="p-3 ps-5 text-xs text-gray-500">
              <%= t("accounting.expenses.totals.system_controlled") %>
            </td>
            <td class="p-3 text-end tabular-nums text-gray-600 font-medium">
              <%= format_money(@system_cents) %>
            </td>
            <td></td>
          </tr>
        <% end %>
        <% if @custom_cents > 0 %>
          <tr class="border-t border-gray-100">
            <td colspan="5" class="p-3 ps-5 text-xs text-gray-500">
              <%= t("accounting.expenses.totals.custom_controlled") %>
            </td>
            <td class="p-3 text-end tabular-nums text-gray-600 font-medium">
              <%= format_money(@custom_cents) %>
            </td>
            <td></td>
          </tr>
        <% end %>
        <tr class="border-t border-gray-200">
          <td colspan="5" class="p-3 ps-5 text-xs font-bold text-gray-700 uppercase tracking-wide">
            <%= t("accounting.expenses.totals.grand_total") %>
          </td>
          <td class="p-3 text-end tabular-nums font-black text-gray-900">
            <%= format_money(@total_active_cents) %>
          </td>
          <td></td>
        </tr>
      </tfoot>
    </table>
    <%= render "admin/accounting/pagination", pagy: @pagy %>
  </section>
</div>
