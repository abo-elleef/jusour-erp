<% content_for :title, t("accounting.expenses.title") %>
<div class="max-w-full">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.expenses.title") %></h1>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to t("accounting.nav.expense_categories"), admin_accounting_expense_categories_path,
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("actions.export_csv"),
            admin_accounting_expenses_path(**request.query_parameters.symbolize_keys, format: :csv),
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("accounting.expenses.new_button"), new_admin_accounting_expense_path,
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </div>
  </div>
  <%= render "admin/accounting/date_range_form" %>

  <div class="mb-4">
    <%= render "admin/accounting/treasury_filter" %>
  </div>

  <%# Search bar %>
  <%= search_form_for @q, url: admin_accounting_expenses_path, method: :get,
        html: { class: "mb-4" } do |f| %>
    <% (params.to_unsafe_h.except("q", "page", "action", "controller")).each do |k, v| %>
      <input type="hidden" name="<%= k %>" value="<%= v %>">
    <% end %>
    <div class="flex gap-2">
      <div class="relative flex-1">
        <span class="absolute inset-y-0 start-3 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
        </span>
        <%= f.search_field :description_or_expense_category_name_cont,
              placeholder: t("accounting.shared.search_placeholder"),
              class: "w-full border border-gray-200 rounded-xl ps-9 pe-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" %>
      </div>
      <%= f.submit t("actions.search"), class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl cursor-pointer" %>
      <% if params[:q].present? %>
        <%= link_to t("actions.clear"), admin_accounting_expenses_path(params.to_unsafe_h.except("q", "page")),
              class: "border border-gray-200 text-gray-600 text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-gray-50" %>
      <% end %>
    </div>
  <% end %>

  <%# Tab switcher %>
  <% base_params = { start_date: @start_date, end_date: @end_date, category_id: params[:category_id], treasury_id: params[:treasury_id] }.compact_blank %>
  <div class="flex gap-1 mb-6 border-b border-gray-200">
    <%= link_to t("accounting.expenses.tabs.transactions"),
          admin_accounting_expenses_path(base_params.merge(tab: "transactions")),
          class: "px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors #{!@ledger_tab ? 'border-amber-500 text-amber-700' : 'border-transparent text-gray-500 hover:text-gray-700'}" %>
    <%= link_to t("accounting.expenses.tabs.ledger"),
          admin_accounting_expenses_path(base_params.merge(tab: "ledger")),
          class: "px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors #{@ledger_tab ? 'border-amber-500 text-amber-700' : 'border-transparent text-gray-500 hover:text-gray-700'}" %>
  </div>

  <% if @ledger_tab %>
    <%# ── LEDGER SUMMARY TAB — matches P&L exactly ─────────────────── %>
    <div class="mb-4 p-4 rounded-2xl bg-blue-50 border border-blue-200 text-sm text-blue-800">
      <%= t("accounting.expenses.ledger_note") %>
    </div>

    <%# Summary cards %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
        <p class="text-xs font-semibold text-red-600 uppercase tracking-wide mb-1"><%= t("accounting.expenses.ledger.purchases") %></p>
        <p class="text-2xl font-black tabular-nums text-red-900"><%= format_amount(@ledger_summary[:purchases_cents]) %></p>
        <p class="text-xs text-red-500 mt-1"><%= t("accounting.expenses.ledger.purchases_hint") %></p>
        <%= link_to t("accounting.expenses.ledger.view_in_pl"),
              profit_loss_admin_accounting_financial_statements_path(start_date: @start_date, end_date: @end_date),
              class: "text-xs font-semibold text-red-700 underline mt-2 inline-block" %>
      </div>
      <div class="rounded-2xl border border-purple-200 bg-purple-50 p-4">
        <p class="text-xs font-semibold text-purple-600 uppercase tracking-wide mb-1"><%= t("accounting.expenses.ledger.payroll") %></p>
        <p class="text-2xl font-black tabular-nums text-purple-900"><%= format_amount(@ledger_summary[:payroll_cents]) %></p>
        <p class="text-xs text-purple-500 mt-1"><%= t("accounting.expenses.ledger.payroll_hint") %></p>
      </div>
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
        <p class="text-xs font-semibold text-amber-700 uppercase tracking-wide mb-1"><%= t("accounting.expenses.ledger.operations") %></p>
        <p class="text-2xl font-black tabular-nums text-amber-900"><%= format_amount(@ledger_summary[:operations_cents]) %></p>
        <p class="text-xs text-amber-600 mt-1"><%= t("accounting.expenses.ledger.operations_hint") %></p>
      </div>
    </div>

    <%# Operations breakdown table %>
    <% if @ledger_summary[:operations_lines].any? %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
        <div class="px-5 py-3 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-700"><%= t("accounting.expenses.ledger.operations_breakdown") %></h2>
        </div>
        <table class="w-full text-sm">
          <thead class="text-xs font-semibold text-gray-500 uppercase bg-gray-50/60 border-b border-gray-100">
            <tr>
              <th class="p-3 ps-5 text-start w-24"><%= t("accounting.journal_entries.col.code") %></th>
              <th class="p-3 text-start"><%= t("accounting.journal_entries.col.account") %></th>
              <th class="p-3 pe-5 text-end"><%= t("order.labels.total") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @ledger_summary[:operations_lines].each do |line| %>
              <tr class="hover:bg-amber-50/30 transition-colors cursor-pointer"
                  onclick="window.location='<%= admin_accounting_journal_entries_path(start_date: @start_date, end_date: @end_date, account_code: line[:code]) %>'">
                <td class="p-3 ps-5 font-mono text-xs text-blue-700 font-semibold"><%= line[:code] %></td>
                <td class="p-3 text-gray-900"><%= line[:name] %></td>
                <td class="p-3 pe-5 text-end tabular-nums font-semibold text-gray-900"><%= format_amount(line[:cents]) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="border-t-2 border-gray-200 bg-gray-50/80">
            <tr>
              <td colspan="2" class="p-3 ps-5 text-xs font-bold text-gray-700 uppercase tracking-wide">
                <%= t("accounting.expenses.ledger.operations_total") %>
              </td>
              <td class="p-3 pe-5 text-end tabular-nums font-black text-gray-900">
                <%= format_amount(@ledger_summary[:operations_cents]) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </section>
    <% end %>

    <%# Grand total banner %>
    <div class="rounded-2xl border-2 border-gray-300 bg-white p-4 flex justify-between items-center">
      <span class="text-sm font-bold text-gray-700 uppercase tracking-wide"><%= t("accounting.expenses.ledger.total") %></span>
      <span class="text-2xl font-black tabular-nums text-gray-900"><%= format_amount(@ledger_summary[:total_cents]) %></span>
    </div>

  <% else %>
    <%# ── TRANSACTIONS TAB — expense records ────────────────────────── %>
    <details class="mb-6 group" <%= @active_category_id.present? ? "open" : "" %>>
      <summary class="flex items-center justify-between cursor-pointer select-none rounded-2xl border border-gray-200 bg-white px-4 py-3 hover:bg-gray-50 transition-colors list-none">
        <span class="text-sm font-semibold text-gray-700"><%= t("accounting.expenses.categories_summary") %></span>
        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </summary>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-3">
        <% @totals_by_category.each do |(category_id, category_name), cents| %>
          <% active = @active_category_id == category_id.to_s %>
          <% filter_params = { start_date: @start_date, end_date: @end_date, treasury_id: params[:treasury_id] }.compact_blank %>
          <% filter_params[:category_id] = category_id unless active %>
          <%= link_to admin_accounting_expenses_path(filter_params),
                class: "rounded-2xl border p-3 transition-colors #{active ? 'border-amber-400 bg-amber-50 ring-1 ring-amber-400' : 'border-gray-200 bg-white hover:border-amber-300 hover:bg-amber-50/50'}" do %>
            <p class="text-xs <%= active ? 'text-amber-700 font-semibold' : 'text-gray-500' %>"><%= category_name %></p>
            <p class="font-bold tabular-nums <%= active ? 'text-amber-900' : '' %>"><%= format_amount(cents) %></p>
            <% if active %>
              <p class="text-xs text-amber-600 mt-1">✕ <%= t("actions.clear") %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </details>

    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
          <tr>
            <th class="p-3 ps-5 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
            <th class="p-3 text-start"><%= t("accounting.shared.day") %></th>
            <th class="p-3 text-start"><%= t("accounting.shared.category") %></th>
            <th class="p-3 text-start"><%= t("accounting.shared.treasury") %></th>
            <th class="p-3 text-start"><%= t("accounting.shared.description") %></th>
            <th class="p-3 text-end"><%= t("order.labels.total") %></th>
            <th class="p-3 pe-5 text-end"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @expenses.each_with_index do |expense, index| %>
            <tr class="cursor-pointer hover:bg-amber-50/40 transition-colors"
                data-href="<%= admin_accounting_expense_path(expense) %>"
                onclick="if(!event.target.closest('a,button,form'))Turbo.visit(this.dataset.href)">
              <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= table_row_number(index, pagy: @pagy) %></td>
              <td class="p-3"><%= l(expense.expense_date, format: :long) %></td>
              <td class="p-3"><%= expense.expense_category.name %></td>
              <td class="p-3 text-gray-600"><%= expense.treasury&.name || t("accounting.shared.em_dash") %></td>
              <td class="p-3">
                <%= expense.description %>
                <% if expense.is_auto_generated? %><span class="text-xs text-gray-400"><%= t("accounting.shared.auto") %></span><% end %>
              </td>
              <td class="p-3 text-end font-semibold tabular-nums"><%= format_amount(expense.amount_cents) %></td>
              <td class="p-3 pe-5 text-end" onclick="event.stopPropagation()">
                <% unless expense.is_auto_generated? %>
                  <%= link_to t("actions.edit"), edit_admin_accounting_expense_path(expense), class: "text-amber-700 text-xs font-semibold" %>
                  <%= button_to t("actions.delete"),
                        admin_accounting_expense_path(expense),
                        method: :delete,
                        class: "text-red-700 text-xs font-semibold ms-2 cursor-pointer",
                        form: { style: "display:inline" },
                        data: { turbo_confirm: t("accounting.records.confirm_delete") } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50/80 text-sm">
          <% if @system_cents > 0 %>
            <tr class="border-t border-gray-100">
              <td colspan="5" class="p-3 ps-5 text-xs text-gray-500">
                <%= t("accounting.expenses.totals.system_controlled") %>
              </td>
              <td class="p-3 text-end tabular-nums text-gray-600 font-medium">
                <%= format_amount(@system_cents) %>
              </td>
              <td></td>
            </tr>
          <% end %>
          <% if @custom_cents > 0 %>
            <tr class="border-t border-gray-100">
              <td colspan="5" class="p-3 ps-5 text-xs text-gray-500">
                <%= t("accounting.expenses.totals.custom_controlled") %>
              </td>
              <td class="p-3 text-end tabular-nums text-gray-600 font-medium">
                <%= format_amount(@custom_cents) %>
              </td>
              <td></td>
            </tr>
          <% end %>
          <tr class="border-t border-gray-200">
            <td colspan="5" class="p-3 ps-5 text-xs font-bold text-gray-700 uppercase tracking-wide">
              <%= t("accounting.expenses.totals.grand_total") %>
            </td>
            <td class="p-3 text-end tabular-nums font-black text-gray-900">
              <%= format_amount(@total_active_cents) %>
            </td>
            <td></td>
          </tr>
        </tfoot>
      </table>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </section>
  <% end %>
</div>
