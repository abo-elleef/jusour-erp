<%# Title, description, period, CSV + Print, and an optional switch beside
    them. locals: title, description, subtitle (optional), switch (optional:
    { on:, param:, label: }). %>
<% export_params = request.query_parameters.except("print", "page") %>
<% period = t("accounting.shared.date_range_value", start: l(@start_date, format: :long), end: l(@end_date, format: :long)) %>
<div class="flex flex-wrap justify-between items-start gap-4 mb-6 print:mb-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900 print:text-xl"><%= title %></h1>
    <% if local_assigns[:subtitle] %><p class="text-base font-semibold text-gray-800 mt-1"><%= subtitle %></p><% end %>
    <p class="text-gray-600 text-sm mt-1 max-w-3xl print-hide"><%= description %></p>
    <p class="text-xs text-gray-500 mt-1"><%= period %></p>
    <p class="print-only text-xs text-gray-600 mt-1">
      <%= Current.company&.name %>
      <% if local_assigns[:switch] && switch[:on] %> · <%= switch[:label] %><% end %>
      · <%= t("inventory.reports.shared.printed_at", time: l(Time.current, format: :short)) %>
    </p>
  </div>
  <div class="flex flex-wrap items-center gap-2 shrink-0 print-hide">
    <% if local_assigns[:switch] %>
      <%# A GET link styled as a switch, like the vendors index balance toggle:
          the state lives in the URL, so CSV and Print carry it along. %>
      <% on = switch[:on] %>
      <%= link_to url_for(export_params.except(switch[:param]).merge(on ? {} : { switch[:param] => "1" })),
            role: "switch", aria: { checked: on },
            class: "inline-flex items-center gap-2 text-sm font-semibold px-4 py-2.5 rounded-xl border transition-colors #{on ? 'border-amber-300 bg-amber-50 text-amber-900' : 'text-gray-700 border-gray-200 hover:bg-gray-100'}" do %>
        <%# Knob placed by flex, not absolute offsets, so it mirrors in RTL. %>
        <span class="inline-flex items-center h-4 w-7 p-0.5 shrink-0 rounded-full transition-colors <%= on ? 'justify-end bg-amber-600' : 'bg-gray-300' %>">
          <span class="h-3 w-3 rounded-full bg-white shadow"></span>
        </span>
        <%= switch[:label] %>
      <% end %>
    <% end %>
    <% if local_assigns.fetch(:exports, true) %>
      <%= link_to url_for(export_params.merge(format: :csv)),
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <span aria-hidden="true">&darr;</span> <%= t("actions.export_csv") %>
      <% end %>
      <%= link_to url_for(export_params.merge(print: 1)), target: "_blank", rel: "noopener", data: { turbo: false },
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <%= t("inventory.reports.shared.print") %>
      <% end %>
    <% end %>
  </div>
</div>
