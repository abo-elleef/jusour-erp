<% content_for :title, t("accounting.ledger.trial_balance.title") %>
<% cell = "p-3 whitespace-nowrap text-end tabular-nums" %>
<% split = ->(rows, attr) { [rows.sum { |r| [r.public_send(attr), 0].max }, rows.sum { |r| [-r.public_send(attr), 0].max }] } %>

<div class="max-w-7xl print:max-w-none" <%= tag.attributes(data: { controller: "auto-print" }) if print_mode? %>>
  <%= render "header", title: t("accounting.ledger.trial_balance.title"),
        description: t("accounting.ledger.trial_balance.description"),
        switch: { on: @differences_only, param: "differences_only", label: t("accounting.ledger.trial_balance.differences_only") } %>

  <%= render layout: "filters", locals: { keep: %w[differences_only] } do %><% end %>

  <%# Summary over every account, even when the table is filtered. %>
  <% summary = @result.summary %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6 print:grid-cols-4 print:gap-2 print:mb-3">
    <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.trial_balance.stats.debits"),
          value: format_amount(summary.debit_cents), hint: t("accounting.ledger.trial_balance.stats.period_hint") %>
    <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.trial_balance.stats.credits"),
          value: format_amount(summary.credit_cents), hint: t("accounting.ledger.trial_balance.stats.period_hint") %>
    <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.trial_balance.stats.status"),
          tone: summary.balanced? ? :good : :bad,
          value: summary.balanced? ? t("accounting.ledger.trial_balance.stats.balanced") : t("accounting.ledger.trial_balance.stats.unbalanced"),
          hint: t("accounting.ledger.trial_balance.stats.account_count", count: summary.rows.size) %>
    <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.trial_balance.stats.differences"),
          tone: summary.difference_count.positive? ? :warn : :good, value: summary.difference_count,
          hint: t("accounting.ledger.trial_balance.stats.differences_hint") %>
  </div>

  <% if @result.rows.empty? %>
    <section class="rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center">
      <p class="text-gray-900 font-semibold"><%= t(@differences_only ? "accounting.ledger.trial_balance.empty_differences" : "accounting.ledger.trial_balance.empty") %></p>
    </section>
  <% else %>
    <section class="print-flow rounded-2xl border border-gray-200 bg-white overflow-hidden print:rounded-none">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <p class="text-xs text-gray-500"><%= t("accounting.ledger.trial_balance.table_hint") %></p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr class="border-b border-gray-100">
              <th class="p-3 ps-5 text-start" rowspan="2"><%= t("accounting.ledger.table.code") %></th>
              <th class="p-3 text-start" rowspan="2"><%= t("accounting.ledger.table.account") %></th>
              <% %w[opening period closing].each do |part| %>
                <th class="p-2 text-center border-s border-gray-100" colspan="2"><%= t("accounting.ledger.table.#{part}") %></th>
              <% end %>
              <th class="p-3 pe-5 text-end border-s border-gray-100" rowspan="2">
                <%= t("accounting.ledger.table.treasury_difference") %>
                <%= info_tooltip_icon(t("accounting.ledger.trial_balance.difference_tooltip")) %>
              </th>
            </tr>
            <tr class="border-b border-gray-100">
              <% 3.times do %>
                <th class="p-2 text-end border-s border-gray-100"><%= t("accounting.ledger.debit") %></th>
                <th class="p-2 text-end"><%= t("accounting.ledger.credit") %></th>
              <% end %>
            </tr>
          </thead>
          <% @result.groups.each do |type, rows| %>
            <tbody class="divide-y divide-gray-100 border-b border-gray-200">
              <tr class="bg-gray-50">
                <td class="p-2 ps-5 text-xs font-bold text-gray-700 uppercase tracking-wide" colspan="9"><%= t("accounting.journal_entries.account_types.#{type}") %></td>
              </tr>
              <% rows.each do |row| %>
                <% ledger_path = general_ledger_admin_accounting_ledger_reports_path(account: row.account.key, start_date: @start_date, end_date: @end_date) %>
                <tr>
                  <td class="p-3 ps-5 whitespace-nowrap tabular-nums text-gray-500"><%= link_to row.account.code, ledger_path, class: "hover:text-amber-700 hover:underline" %></td>
                  <td class="p-3 font-medium text-gray-900"><%= link_to row.account.name, ledger_path, class: "hover:text-amber-700 hover:underline" %></td>
                  <td class="<%= cell %> border-s border-gray-100 text-gray-600"><%= ledger_side_amount(row.opening_cents, :debit) %></td>
                  <td class="<%= cell %> text-gray-600"><%= ledger_side_amount(row.opening_cents, :credit) %></td>
                  <td class="<%= cell %> border-s border-gray-100 text-gray-700"><%= ledger_side_amount(row.debit_cents, :debit) %></td>
                  <td class="<%= cell %> text-gray-700"><%= ledger_side_amount(-row.credit_cents, :credit) %></td>
                  <td class="<%= cell %> border-s border-gray-100 font-semibold text-gray-900"><%= ledger_side_amount(row.closing_cents, :debit) %></td>
                  <td class="<%= cell %> font-semibold text-gray-900"><%= ledger_side_amount(row.closing_cents, :credit) %></td>
                  <td class="<%= cell %> pe-5 border-s border-gray-100">
                    <% if row.difference? %>
                      <span class="text-amber-700 font-semibold"><%= copyable_amount(row.treasury_difference_cents) %></span>
                    <% elsif row.treasury_cents %>
                      <span class="text-green-600" title="<%= t('accounting.ledger.trial_balance.matches_treasury') %>">✓</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
              <% opening_dr, opening_cr = split.(rows, :opening_cents) %>
              <% closing_dr, closing_cr = split.(rows, :closing_cents) %>
              <tr class="bg-gray-50/60 font-semibold text-gray-800">
                <td class="p-3 ps-5" colspan="2"><%= t("accounting.ledger.table.subtotal", type: t("accounting.journal_entries.account_types.#{type}")) %></td>
                <td class="<%= cell %> border-s border-gray-100"><%= copyable_amount(opening_dr) %></td>
                <td class="<%= cell %>"><%= copyable_amount(opening_cr) %></td>
                <td class="<%= cell %> border-s border-gray-100"><%= copyable_amount(rows.sum(&:debit_cents)) %></td>
                <td class="<%= cell %>"><%= copyable_amount(rows.sum(&:credit_cents)) %></td>
                <td class="<%= cell %> border-s border-gray-100"><%= copyable_amount(closing_dr) %></td>
                <td class="<%= cell %>"><%= copyable_amount(closing_cr) %></td>
                <td class="<%= cell %> pe-5 border-s border-gray-100"></td>
              </tr>
            </tbody>
          <% end %>
          <tfoot class="border-t-2 border-gray-300 font-bold text-gray-900">
            <tr>
              <td class="p-3 ps-5" colspan="2"><%= t("accounting.ledger.table.total") %></td>
              <td class="<%= cell %> border-s border-gray-100"><%= copyable_amount(@result.opening_debit_cents) %></td>
              <td class="<%= cell %>"><%= copyable_amount(@result.opening_credit_cents) %></td>
              <td class="<%= cell %> border-s border-gray-100"><%= copyable_amount(@result.debit_cents) %></td>
              <td class="<%= cell %>"><%= copyable_amount(@result.credit_cents) %></td>
              <td class="<%= cell %> border-s border-gray-100"><%= copyable_amount(@result.closing_debit_cents) %></td>
              <td class="<%= cell %>"><%= copyable_amount(@result.closing_credit_cents) %></td>
              <td class="<%= cell %> pe-5 border-s border-gray-100"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  <% end %>
</div>
