<% content_for :title, t("accounting.ledger.general_ledger.title") %>
<% cell = "p-3 whitespace-nowrap" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% account_options = @accounts.group_by(&:account_type).map do |type, accounts|
     [t("accounting.journal_entries.account_types.#{type}"), accounts.map { |a| ["#{a.code} — #{a.name}", a.key] }]
   end %>

<div class="max-w-7xl print:max-w-none" <%= tag.attributes(data: { controller: "auto-print" }) if print_mode? %>>
  <%= render "header", title: t("accounting.ledger.general_ledger.title"),
        subtitle: (@account && "#{@account.code} — #{@account.name}"),
        description: t("accounting.ledger.general_ledger.description"), exports: @account.present? %>

  <%= render layout: "filters" do %>
    <div class="min-w-[16rem] flex-1 max-w-md">
      <%= label_tag :account, t("accounting.ledger.table.account"), class: label_class %>
      <%= select_tag :account, grouped_options_for_select(account_options, @account&.key),
            include_blank: t("accounting.ledger.general_ledger.pick_account"), class: pos_input_class %>
    </div>
  <% end %>

  <% if @account.nil? %>
    <section class="rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("accounting.ledger.general_ledger.pick_account") %></p>
      <p class="text-gray-500 text-sm"><%= t("accounting.ledger.general_ledger.pick_hint") %></p>
    </section>
  <% else %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6 print:grid-cols-4 print:gap-2 print:mb-3">
      <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.general_ledger.opening_balance"), value: ledger_balance(@ledger.opening_cents) %>
      <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.trial_balance.stats.debits"), value: format_amount(@ledger.debit_cents) %>
      <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.trial_balance.stats.credits"), value: format_amount(@ledger.credit_cents) %>
      <%= render "admin/inventory/reports/valued/stat", label: t("accounting.ledger.general_ledger.closing_balance"), value: ledger_balance(@ledger.closing_cents),
            hint: t("accounting.ledger.general_ledger.line_count", count: @ledger.line_count) %>
    </div>

    <section class="print-flow rounded-2xl border border-gray-200 bg-white overflow-hidden print:rounded-none">
      <% if @account.treasury %>
        <div class="px-5 py-3 border-b border-gray-100 bg-gray-50/80 text-xs text-gray-500 print-hide">
          <%= t("accounting.ledger.general_ledger.treasury_hint") %>
        </div>
      <% end %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("accounting.ledger.table.date") %></th>
              <th class="p-3 text-start"><%= t("accounting.ledger.table.entry") %></th>
              <th class="p-3 text-start"><%= t("accounting.ledger.table.description") %></th>
              <th class="p-3 text-end"><%= t("accounting.ledger.debit") %></th>
              <th class="p-3 text-end"><%= t("accounting.ledger.credit") %></th>
              <th class="p-3 pe-5 text-end"><%= t("accounting.ledger.table.balance") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if @pagy.nil? || @pagy.page == 1 %>
              <tr class="bg-gray-50/60 text-gray-700">
                <td class="<%= cell %> ps-5 tabular-nums"><%= l(@start_date, format: :long) %></td>
                <td class="<%= cell %>"></td>
                <td class="p-3 font-semibold"><%= t("accounting.ledger.general_ledger.opening_balance") %></td>
                <td class="<%= cell %>"></td>
                <td class="<%= cell %>"></td>
                <td class="<%= cell %> pe-5 text-end tabular-nums font-semibold"><%= ledger_balance(@ledger.opening_cents) %></td>
              </tr>
            <% end %>
            <% @lines.each do |line| %>
              <tr>
                <td class="<%= cell %> ps-5 tabular-nums text-gray-600"><%= l(line.entry_date.to_date, format: :long) %></td>
                <td class="<%= cell %>">
                  <%= link_to line.entry_number, admin_accounting_journal_entry_path(line.journal_entry_id),
                        class: "text-gray-700 hover:text-amber-700 hover:underline tabular-nums" %>
                </td>
                <td class="p-3 text-gray-900 min-w-[16rem]">
                  <%= line.entry_description %>
                  <% if line.notes.present? %><span class="text-gray-500"> — <%= line.notes %></span><% end %>
                  <% if line.account_code != @account.code %>
                    <span class="block text-xs text-gray-400"><%= t("accounting.ledger.general_ledger.posted_as", code: line.account_code) %></span>
                  <% end %>
                </td>
                <td class="<%= cell %> text-end tabular-nums text-gray-700"><%= line.debit_cents.positive? ? format_amount(line.debit_cents) : tag.span("–", class: "text-gray-300") %></td>
                <td class="<%= cell %> text-end tabular-nums text-gray-700"><%= line.credit_cents.positive? ? format_amount(line.credit_cents) : tag.span("–", class: "text-gray-300") %></td>
                <td class="<%= cell %> pe-5 text-end tabular-nums text-gray-900"><%= ledger_balance(line.balance_cents.to_i) %></td>
              </tr>
            <% end %>
            <% if @lines.empty? %>
              <tr><td class="p-6 text-center text-gray-500" colspan="6"><%= t("accounting.ledger.general_ledger.no_lines") %></td></tr>
            <% end %>
          </tbody>
          <% if @pagy.nil? || @pagy.last == @pagy.page %>
            <tfoot class="border-t-2 border-gray-300 font-bold text-gray-900">
              <tr>
                <td class="<%= cell %> ps-5 tabular-nums"><%= l(@end_date, format: :long) %></td>
                <td class="<%= cell %>"></td>
                <td class="p-3"><%= t("accounting.ledger.general_ledger.closing_balance") %></td>
                <td class="<%= cell %> text-end tabular-nums"><%= format_amount(@ledger.debit_cents) %></td>
                <td class="<%= cell %> text-end tabular-nums"><%= format_amount(@ledger.credit_cents) %></td>
                <td class="<%= cell %> pe-5 text-end tabular-nums"><%= ledger_balance(@ledger.closing_cents) %></td>
              </tr>
            </tfoot>
          <% end %>
        </table>
      </div>
      <% if @pagy %><div class="print-hide"><%= render "admin/accounting/pagination", pagy: @pagy %></div><% end %>
    </section>
  <% end %>
</div>
