<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% budget_input_class = "w-[4.5rem] text-center bg-gray-50 border border-gray-200 rounded-lg px-2 py-1.5 text-xs text-gray-900 tabular-nums " \
  "focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% save_btn_class = "inline-flex items-center justify-center w-8 h-8 rounded-lg bg-gray-900 hover:bg-gray-800 " \
  "text-white text-xs font-semibold transition-colors shrink-0" %>

<%= render "admin/accounting/nav" %>
<div class="max-w-7xl">
  <div class="mb-4">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("accounting.budgets.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("accounting.budgets.description") %></p>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.shared.year") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("accounting.budgets.viewing_year", year: @year) %></p>
    </div>
    <div class="p-5">
      <%= form_with url: admin_accounting_budgets_path, method: :get, class: "flex flex-wrap items-end gap-4" do %>
        <div class="w-32">
          <%= label_tag :year, t("accounting.shared.year"), class: label_class %>
          <%= number_field_tag :year, @year, class: pos_input_class, min: 2020, max: 2100 %>
        </div>
        <%= submit_tag t("actions.view"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-4 mb-4 text-xs text-gray-600">
    <span class="inline-flex items-center gap-2">
      <span class="font-semibold text-gray-900"><%= t("accounting.budgets.legend_actual") %></span>
      <span class="text-gray-400">/</span>
      <span class="font-semibold text-gray-500"><%= t("accounting.budgets.legend_budget") %></span>
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="w-3 h-3 rounded border border-red-200 bg-red-50/80" aria-hidden="true"></span>
      <%= t("accounting.budgets.legend_over") %>
    </span>
    <span class="text-gray-400"><%= t("accounting.budgets.legend_edit_hint") %></span>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-xs min-w-[56rem]">
        <thead class="border-b border-gray-100 bg-gray-50/80">
          <tr>
            <th class="p-3 ps-5 text-start text-xs font-semibold text-gray-500 uppercase tracking-wide sticky start-0 z-10 bg-gray-50/95 backdrop-blur-sm min-w-[7rem]">
              <%= t("accounting.shared.category") %>
            </th>
            <% @months.each do |m| %>
              <th class="p-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wide min-w-[5.5rem]">
                <%= accounting_month_abbr(m) %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @categories.each do |cat| %>
            <tr class="group hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5 font-semibold text-gray-900 sticky start-0 z-10 bg-white group-hover:bg-gray-100 min-w-[7rem] border-e border-gray-100">
                <%= cat.name %>
              </td>
              <% @months.each do |month| %>
                <% budget = @budgets[[cat.id, month]] %>
                <% actual = @actuals[[cat.id, month]] %>
                <% budget_cents = budget&.amount_cents.to_i %>
                <% over = actual > budget_cents && budget_cents.positive? %>
                <td class="p-2.5 text-center align-top <%= over ? 'bg-red-50/60' : '' %>">
                  <div class="space-y-0.5 mb-2">
                    <div class="font-semibold tabular-nums text-gray-900"><%= format_money(actual) %></div>
                    <div class="tabular-nums text-gray-400">/ <%= format_money(budget_cents) %></div>
                  </div>
                  <%= form_with url: admin_accounting_budgets_path, method: :patch,
                        class: "flex gap-1.5 items-center justify-center" do %>
                    <%= hidden_field_tag :year, @year %>
                    <%= hidden_field_tag :month, month %>
                    <%= hidden_field_tag :expense_category_id, cat.id %>
                    <%= number_field_tag :amount_dollars, (budget_cents / 100.0).round(2),
                          step: 0.01, min: 0, class: budget_input_class,
                          aria: { label: t("accounting.budgets.budget_for", category: cat.name, month: accounting_month_abbr(month)) } %>
                    <%= button_tag type: "submit", class: save_btn_class, title: t("accounting.budgets.save_budget") do %>
                      <span aria-hidden="true">✓</span>
                    <% end %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @categories.empty? %>
      <p class="p-8 text-center text-sm text-gray-500"><%= t("accounting.budgets.no_categories") %></p>
    <% end %>
  </section>
</div>
