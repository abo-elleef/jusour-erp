<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% if @locations.size > 1 %>
  <div>
    <%= label_tag :location_id, t("accounting.shortage_moves_report.branch"), class: label_class %>
    <%= select_tag :location_id,
          options_for_select([[t("accounting.cash_drawer.all_locations"), ""]] + @locations.map { |l| [l.name, l.id] }, params[:location_id]),
          class: "#{pos_input_class} appearance-none min-w-[12rem]" %>
  </div>
<% end %>
<div>
  <%= label_tag :user_id, t("accounting.shortage_moves_report.staff"), class: label_class %>
  <%= select_tag :user_id,
        options_for_select([[t("accounting.shortage_moves_report.all_staff"), ""]] + @staff.map { |u| [u.name, u.id] }, params[:user_id]),
        class: "#{pos_input_class} appearance-none min-w-[12rem]" %>
</div>
