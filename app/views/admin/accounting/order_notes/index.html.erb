<% content_for :title, t("accounting.order_notes.title") %>
<% export_btn_class = "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<%# What every link on this page keeps: the range, branch and open-orders switch. %>
<% range_params = { start_date: @start_date, end_date: @end_date, location_id: @location&.id, include_open: (@include_open ? "1" : nil) }.compact %>
<% filter_params = { category: @category, item: @item, modifier_group: @modifier_group, modifier_choice: @modifier_choice, kind: @kind, q: @query }.compact %>

<div class="max-w-full">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
    <div>
      <%= link_to "← #{t('accounting.order_notes.back_to_sales')}", admin_accounting_sales_reports_path(range_params),
            class: "text-sm font-semibold text-amber-700 hover:text-amber-800" %>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 mt-1"><%= t("accounting.order_notes.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("accounting.order_notes.description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to t("actions.export_csv"), admin_accounting_order_notes_path(request.query_parameters.merge(format: :csv)),
            class: export_btn_class %>
    </div>
  </div>

  <%= render "admin/accounting/date_range_form",
        extra_fields: ("admin/accounting/sales_reports/branch_field" if @locations.size > 1), extra_keys: [:location_id] %>

  <% toggle_params = request.query_parameters.except("include_open", "page").merge(@include_open ? {} : { include_open: "1" }) %>
  <div class="flex flex-wrap items-center gap-3 mb-4 -mt-2">
    <%= link_to admin_accounting_order_notes_path(toggle_params), role: "switch", "aria-checked": @include_open.to_s,
          class: "inline-flex items-center gap-2 text-sm font-medium text-gray-700", data: { turbo_action: "replace" } do %>
      <span class="relative inline-flex h-5 w-9 shrink-0 rounded-full transition-colors <%= @include_open ? 'bg-indigo-600' : 'bg-gray-300' %>">
        <span class="absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-all <%= @include_open ? 'start-[1.125rem]' : 'start-0.5' %>"></span>
      </span>
      <%= t("accounting.sales_reports.include_open") %>
    <% end %>
    <span class="text-xs <%= @include_open ? 'text-amber-700' : 'text-gray-500' %>">
      <%= t(@include_open ? "accounting.sales_reports.include_open_on_hint" : "accounting.sales_reports.include_open_off_hint") %>
    </span>
  </div>

  <%# Filters by what was sold. Category narrows the item list; an item opens its
      modifier choices. Picking from a list applies at once. %>
  <section class="rounded-2xl border border-gray-200 bg-white p-5 mb-4">
    <%= form_with url: admin_accounting_order_notes_path, method: :get, class: "flex flex-wrap items-end gap-4",
          data: { searchable_select_options: @item_options.map { |name, key| { value: key, label: name } }.to_json } do |f| %>
      <% range_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <div class="min-w-[10rem]">
        <%= label_tag :kind, t("accounting.order_notes.kind"), class: label_class %>
        <%= select_tag :kind,
              options_for_select([[t("accounting.order_notes.kinds.all"), ""],
                                  [t("accounting.order_notes.kinds.item"), "item"],
                                  [t("accounting.order_notes.kinds.order"), "order"]], @kind),
              class: pos_input_class, onchange: "this.form.requestSubmit()" %>
      </div>
      <div class="min-w-[12rem]">
        <%= label_tag :category, t("accounting.shared.category"), class: label_class %>
        <%= select_tag :category,
              options_for_select([[t("accounting.sales_reports.all_categories"), ""]] +
                                 @categories.map { |c| [c.name, c.id] } +
                                 [[t("accounting.sales_reports.combos_category"), ::Accounting::OrderNotesService::COMBOS]], @category),
              class: pos_input_class, onchange: "this.form.requestSubmit()" %>
      </div>
      <div class="min-w-[14rem]" onchange="if (event.target.type === 'hidden') this.closest('form').requestSubmit()">
        <%= label_tag :item, t("accounting.sales_reports.item"), class: label_class %>
        <%= render "shared/searchable_select", form: f, field: :item, selected: @item,
              placeholder: t("accounting.order_notes.all_items"), input_class: pos_input_class %>
      </div>
      <% if @item && @choice_options.any? %>
        <div class="min-w-[12rem]">
          <%= label_tag :choice, t("accounting.order_notes.choice"), class: label_class %>
          <%# One select for group + choice; the hidden fields carry the pair. %>
          <% selected_choice = @modifier_group ? [@modifier_group, @modifier_choice].to_json : "" %>
          <%= select_tag :choice,
                options_for_select([[t("accounting.order_notes.all_choices"), ""]] +
                                   @choice_options.map { |g, c| ["#{g} › #{c}", [g, c].to_json] }, selected_choice),
                class: pos_input_class, name: nil,
                onchange: "const v = this.value ? JSON.parse(this.value) : ['', '']; this.form.modifier_group.value = v[0]; this.form.modifier_choice.value = v[1]; this.form.requestSubmit()" %>
          <%= hidden_field_tag :modifier_group, @modifier_group, id: nil %>
          <%= hidden_field_tag :modifier_choice, @modifier_choice, id: nil %>
        </div>
      <% end %>
      <div class="min-w-[12rem] flex-1">
        <%= label_tag :q, t("accounting.order_notes.search"), class: label_class %>
        <%= search_field_tag :q, @query, placeholder: t("accounting.order_notes.search_placeholder"), class: pos_input_class, dir: "auto" %>
      </div>
      <%= submit_tag t("actions.apply"), name: nil,
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% if filter_params.any? %>
        <%= link_to t("accounting.order_notes.clear_filters"), admin_accounting_order_notes_path(range_params),
              class: "text-sm font-semibold text-gray-600 hover:text-gray-900 py-2.5" %>
      <% end %>
    <% end %>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.order_notes.list_title") %></h2>
      <span class="text-xs text-gray-500 tabular-nums"><%= t("accounting.order_notes.count", count: @notes.size) %></span>
    </div>
    <% if @page_notes.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-gray-100 text-xs font-semibold uppercase tracking-wide text-gray-500">
            <tr>
              <th class="p-3 ps-5 text-start whitespace-nowrap"><%= t("accounting.order_notes.when") %></th>
              <th class="p-3 text-start"><%= t("accounting.order_notes.order") %></th>
              <% if @location.nil? && @locations.size > 1 %><th class="p-3 text-start"><%= t("accounting.sales_reports.branch") %></th><% end %>
              <th class="p-3 text-start"><%= t("accounting.order_notes.cashier") %></th>
              <th class="p-3 text-start"><%= t("accounting.order_notes.line") %></th>
              <th class="p-3 pe-5 text-start w-1/3"><%= t("accounting.order_notes.note") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @page_notes.each do |n| %>
              <% order = n[:order] %>
              <tr class="align-top">
                <td class="p-3 ps-5 whitespace-nowrap tabular-nums text-gray-600">
                  <div><%= l(order.business_date, format: :long) if order.business_date %></div>
                  <div class="text-xs text-gray-400"><%= l(order.ticket_time, format: "%H:%M") %></div>
                </td>
                <td class="p-3 whitespace-nowrap">
                  <%= link_to order.display_reference, admin_order_path(order), class: "font-semibold text-amber-700 hover:text-amber-800", data: { turbo_frame: "_top" } %>
                </td>
                <% if @location.nil? && @locations.size > 1 %>
                  <td class="p-3 text-gray-600">
                    <%= order.location ? link_to(order.location.name, admin_location_path(order.location), class: "hover:text-gray-900 hover:underline") : "—" %>
                  </td>
                <% end %>
                <td class="p-3 text-gray-600">
                  <%= order.user ? link_to(order.user.name, admin_user_path(order.user), class: "hover:text-gray-900 hover:underline") : "—" %>
                </td>
                <td class="p-3">
                  <% if n[:kind] == :order %>
                    <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700"><%= t("accounting.order_notes.whole_order") %></span>
                  <% else %>
                    <div class="font-medium text-gray-900">
                      <% if n[:quantity].to_i > 1 %><span class="tabular-nums text-gray-500"><%= n[:quantity] %>×</span><% end %>
                      <%= n[:item_name] %>
                    </div>
                    <% if n[:modifiers].any? %><div class="text-xs text-gray-500"><%= n[:modifiers].join(" · ") %></div><% end %>
                    <% if n[:category] %><div class="text-xs text-gray-400"><%= n[:category] %></div><% end %>
                  <% end %>
                </td>
                <td class="p-3 pe-5">
                  <p class="whitespace-pre-line text-gray-900 font-medium leading-relaxed" dir="auto"><%= n[:text] %></p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    <% else %>
      <p class="p-8 text-center text-sm text-gray-500"><%= t("accounting.order_notes.empty") %></p>
    <% end %>
  </section>
</div>
