<% receipt = @voucher.direction == Voucher::RECEIPT %>
<% content_for :title, receipt ? t("accounting.vouchers.new_receipt") : t("accounting.vouchers.new_payment") %>
<div class="max-w-3xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-1">
    <%= receipt ? t("accounting.vouchers.new_receipt") : t("accounting.vouchers.new_payment") %>
  </h1>
  <p class="text-sm text-gray-500 mb-6"><%= t("accounting.vouchers.new_hint") %></p>
  <%= render "form", voucher: @voucher %>
</div>
