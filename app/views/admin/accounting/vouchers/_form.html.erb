<%
  receipt = voucher.direction == Voucher::RECEIPT
  # Written out rather than interpolated: Tailwind scans for whole class names
  # and would purge a class assembled at runtime.
  submit_class = receipt ? "bg-emerald-600 hover:bg-emerald-700" : "bg-rose-600 hover:bg-rose-700"
  treasury_options_json = @treasuries.map { |t| { value: t.id, label: t.name } }.to_json
  date_field = receipt ? :income_date : :expense_date
%>
<%= form_with model: voucher, url: admin_accounting_vouchers_path,
      class: "space-y-5 max-w-2xl",
      data: { searchable_select_options: treasury_options_json } do |f| %>

  <% if voucher.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <%= voucher.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.hidden_field :direction %>

  <% if @over_cap %>
    <div class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 space-y-2">
      <p class="font-semibold">
        <%= t("accounting.vouchers.staff_cap.title", name: @over_cap[:employee].name,
              excess: format_amount(@over_cap[:excess_cents])) %>
      </p>
      <p>
        <% if @over_cap[:owed_cents].negative? %>
          <%= t("accounting.vouchers.staff_cap.detail_in_debt",
                debt: format_amount(-@over_cap[:owed_cents]),
                salary: format_amount(@over_cap[:salary_cents])) %>
        <% else %>
          <%= t("accounting.vouchers.staff_cap.detail",
                owed: format_amount(@over_cap[:owed_cents]),
                salary: format_amount(@over_cap[:salary_cents])) %>
        <% end %>
      </p>
      <label class="inline-flex items-center gap-2 font-semibold">
        <%= check_box_tag :confirm_over_cap, "1", false, class: "rounded border-amber-400" %>
        <%= t("accounting.vouchers.staff_cap.confirm") %>
      </label>
    </div>
  <% end %>

  <div class="rounded-2xl border border-gray-200 bg-white p-5 space-y-5">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :voucher_date, t("accounting.shared.day"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= f.date_field :voucher_date, class: pos_input_class %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("accounting.vouchers.date_hint") %></p>
      </div>
      <div>
        <%= f.label :amount_pounds, t("accounting.shared.amount"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%# type="text", not "number": a native number input silently rejects Arabic-Indic
            digits. arabic-numerals converts them to ASCII as the user types. %>
        <%= f.text_field :amount_pounds, inputmode: "decimal", autocomplete: "off", required: true,
              data: { controller: "arabic-numerals", action: "input->arabic-numerals#normalize" },
              class: pos_input_class %>
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-gray-600 mb-1.5">
        <%= receipt ? t("accounting.vouchers.into_treasury") : t("accounting.vouchers.from_treasury") %>
      </label>
      <%= render "shared/searchable_select",
            form: f, field: :treasury_id, selected: voucher.treasury_id,
            placeholder: t("accounting.treasury_transfers.select_treasury"),
            input_class: pos_input_class %>
    </div>

    <div>
      <%= f.label :party_selection, receipt ? t("accounting.vouchers.received_from") : t("accounting.vouchers.paid_to"),
            class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= render "shared/party_picker", form: f, field: :party_selection,
            options: @party_options, selected: voucher.party_selection,
            other_field: :counterparty, other_selected: voucher.counterparty %>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("accounting.vouchers.party_hint") %></p>
    </div>

    <div>
      <%= f.label :notes, t("accounting.vouchers.notes"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= f.text_area :notes, rows: 2, class: pos_input_class %>
    </div>
  </div>

  <%# ── What this voucher settles ─────────────────────────────────── %>
  <div class="rounded-2xl border border-gray-200 bg-white p-5 space-y-4">
    <div>
      <h2 class="text-sm font-bold text-gray-900"><%= t("accounting.vouchers.settles") %></h2>
      <p class="text-xs text-gray-500 mt-1"><%= t("accounting.vouchers.settles_hint") %></p>
    </div>

    <% if @outstanding.any? || @outstanding_invoices.any? || @selected_settles == Admin::Accounting::VouchersController::OLDEST_FIRST %>
      <div>
        <label for="settles" class="block text-xs font-semibold text-gray-600 mb-1.5">
          <%= t("accounting.vouchers.settles") %>
        </label>
        <select name="settles" id="settles" class="<%= pos_input_class %>">
          <option value=""><%= t("accounting.vouchers.on_account_option") %></option>
          <% oldest_first = Admin::Accounting::VouchersController::OLDEST_FIRST %>
          <option value="<%= oldest_first %>" <%= "selected" if @selected_settles == oldest_first %>>
            <%= receipt ? t("accounting.vouchers.oldest_first_option_receipt") : t("accounting.vouchers.oldest_first_option_payment") %>
          </option>
          <% if @outstanding_invoices.any? %>
            <optgroup label="<%= receipt ? t("accounting.vouchers.open_customer_invoices") : t("accounting.vouchers.open_vendor_invoices") %>">
              <% @outstanding_invoices.each do |invoice| %>
                <% value = "#{invoice.class.name}:#{invoice.id}" %>
                <option value="<%= value %>" <%= "selected" if value == @selected_settles %>>
                  <%= invoice.invoice_number %> —
                  <%= receipt ? invoice.customer&.display_name : invoice.supplier&.name %> —
                  <%= t("accounting.vouchers.outstanding_of", amount: format_amount(invoice.balance_due_cents)) %>
                </option>
              <% end %>
            </optgroup>
          <% end %>
          <% if @outstanding.any? %>
            <optgroup label="<%= receipt ? t("accounting.vouchers.uncollected_income") : t("accounting.vouchers.unpaid_expense") %>">
              <% @outstanding.each do |record| %>
                <% value = "#{record.class.name}:#{record.id}" %>
                <option value="<%= value %>" <%= "selected" if value == @selected_settles %>>
                  <%= l(record.public_send(date_field), format: :short) %> —
                  <%= record.description %> —
                  <%= t("accounting.vouchers.outstanding_of", amount: format_amount(record.outstanding_cents)) %>
                </option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
      </div>
      <div class="max-w-xs">
        <label for="allocation_amount_pounds" class="block text-xs font-semibold text-gray-600 mb-1.5">
          <%= t("accounting.vouchers.settle_amount") %>
        </label>
        <input type="text" name="allocation_amount_pounds" id="allocation_amount_pounds"
               inputmode="decimal" autocomplete="off" class="<%= pos_input_class %>"
               data-controller="arabic-numerals" data-action="input->arabic-numerals#normalize"
               placeholder="<%= t("accounting.vouchers.settle_amount_placeholder") %>">
        <p class="text-xs text-gray-500 mt-1.5"><%= t("accounting.vouchers.settle_amount_hint") %></p>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 italic">
        <%= receipt ? t("accounting.vouchers.nothing_uncollected") : t("accounting.vouchers.nothing_unpaid") %>
      </p>
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= f.submit t("accounting.vouchers.issue_#{voucher.direction}"),
          class: "#{submit_class} text-white px-5 py-2.5 rounded-xl font-semibold text-sm cursor-pointer" %>
    <%= link_to t("actions.cancel"), admin_accounting_vouchers_path,
          class: "border border-gray-200 px-5 py-2.5 rounded-xl text-sm font-semibold" %>
  </div>
<% end %>
