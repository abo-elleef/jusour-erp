<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex items-center justify-between gap-4">
    <div>
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.shared.date_range") %></h2>
      <% if defined?(@start_date) && defined?(@end_date) && @start_date && @end_date %>
        <p class="text-xs text-gray-500 mt-0.5">
          <%= t("accounting.shared.date_range_value",
                start: l(@start_date, format: :long),
                end: l(@end_date, format: :long)) %>
        </p>
      <% end %>
    </div>
    <% if defined?(@total_count) && @total_count %>
      <% labels = defined?(@count_labels) && @count_labels ||
                  { total: t("accounting.records.stats_total") } %>
      <div class="flex flex-col items-stretch sm:items-end gap-2 shrink-0">
        <div class="flex flex-wrap items-center justify-end gap-2 text-xs">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white border border-gray-200 text-gray-600 font-medium">
            <span class="font-bold text-gray-800 tabular-nums"><%= @total_count %></span>
            <%= labels[:total] %>
          </span>
          <%# Only pages that still split their rows into two states set these.
              Expenses and incomes no longer do: with reversal gone every row is
              active, and an "active" chip equal to the total says nothing. %>
          <% if defined?(@active_count) && @active_count %>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white border border-amber-200 text-amber-700 font-medium">
              <span class="font-bold tabular-nums"><%= @active_count %></span>
              <%= labels[:active] %>
            </span>
          <% end %>
          <% if defined?(@reversed_count) && @reversed_count %>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white border border-red-200 text-red-600 font-medium">
              <span class="font-bold tabular-nums"><%= @reversed_count %></span>
              <%= labels[:reversed] %>
            </span>
          <% end %>
        </div>
        <% if defined?(@range_sums) && @range_sums.present? %>
          <div class="flex flex-wrap items-center justify-end gap-2">
            <% @range_sums.each do |sum| %>
              <% tone = case sum[:tone].to_s
                        when "success" then "bg-emerald-50 border-emerald-200 text-emerald-900"
                        when "danger"  then "bg-red-50 border-red-200 text-red-900"
                        else "bg-white border-gray-200 text-gray-900"
                        end %>
              <span class="inline-flex items-baseline gap-1.5 px-2.5 py-1.5 rounded-lg border <%= tone %>">
                <span class="text-sm font-bold tabular-nums"><%= format_amount(sum[:cents]) %></span>
                <span class="text-xs font-medium opacity-80"><%= sum[:label] %></span>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="p-5">
    <%= form_with url: request.path, method: :get, class: "flex flex-wrap items-end gap-4",
                  data: { turbo: false } do %>
      <% params.except(:start_date, :end_date, :controller, :action, :format).each do |key, value| %>
        <% if value.is_a?(Hash) %>
          <% value.each do |k, v| %>
            <%= hidden_field_tag "q[#{k}]", v %>
          <% end %>
        <% else %>
          <%= hidden_field_tag key, value %>
        <% end %>
      <% end %>
      <div class="min-w-[10rem]">
        <%= label_tag :start_date, t("accounting.shared.start"), class: label_class %>
        <%= date_field_tag :start_date, @start_date, class: pos_input_class %>
      </div>
      <div class="min-w-[10rem]">
        <%= label_tag :end_date, t("accounting.shared.end"), class: label_class %>
        <%= date_field_tag :end_date, @end_date, class: pos_input_class %>
      </div>
      <%= submit_tag t("actions.apply_range"),
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
    <% end %>
  </div>
</section>
