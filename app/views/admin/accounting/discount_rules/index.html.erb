<%= render "admin/accounting/nav" %>
<div class="max-w-5xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("discounts.rules.index_description") %></p>
    </div>
    <%= link_to new_admin_accounting_discount_rule_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("discounts.rules.new_button") %>
    <% end %>
  </div>

  <% if @discount_rules.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("discounts.rules.list_heading") %></h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[32rem]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("discounts.rules.name") %></th>
              <th class="p-3 text-start"><%= t("discounts.rules.code") %></th>
              <th class="p-3 text-start"><%= t("discounts.rules.discount_type") %></th>
              <th class="p-3 text-start"><%= t("discounts.rules.applies_to") %></th>
              <th class="p-3 text-start"><%= t("discounts.rules.status") %></th>
              <th class="p-3 pe-5 text-end"><%= t("customers.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @discount_rules.each do |rule| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5 font-semibold text-gray-900"><%= rule.name %></td>
                <td class="p-3 text-gray-700 font-mono text-xs"><%= rule.code.presence || "—" %></td>
                <td class="p-3 text-gray-700">
                  <% if rule.discount_type == "percentage" %>
                    <%= rule.discount_value %>% <%= t("discounts.rules.types.percentage").downcase %>
                  <% else %>
                    <%= format_money(rule.discount_value.to_i) %>
                  <% end %>
                </td>
                <td class="p-3 text-gray-700"><%= t("discounts.rules.scopes.#{rule.applies_to}") %></td>
                <td class="p-3">
                  <% if rule.usable? %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200">
                      <%= t("discounts.rules.active") %>
                    </span>
                  <% else %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                      <%= t("discounts.rules.inactive") %>
                    </span>
                  <% end %>
                </td>
                <td class="p-3 pe-5 text-end">
                  <%= link_to t("actions.edit"), edit_admin_accounting_discount_rule_path(rule),
                        class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("discounts.rules.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("discounts.rules.empty_description") %></p>
      <%= link_to t("discounts.rules.new_button"), new_admin_accounting_discount_rule_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% end %>
</div>
