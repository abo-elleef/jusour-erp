<%= render "admin/accounting/nav" %>
<div class="max-w-3xl">
  <div class="mb-4">
    <%= link_to t("discounts.rules.back_to_list"), admin_accounting_discount_rules_path,
          class: "text-sm font-semibold text-amber-700 hover:text-amber-800 transition-colors" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title("edit") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= @discount_rule.name %></p>
    </div>
    <% if @discount_rule.active? %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
        <%= t("discounts.rules.active") %>
      </span>
    <% else %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
        <%= t("discounts.rules.inactive") %>
      </span>
    <% end %>
  </div>

  <%= render "form", discount_rule: @discount_rule %>
</div>
