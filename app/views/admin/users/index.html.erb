<% content_for :title, admin_page_title %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= render "admin/settings/nav" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("staff.index.description") %></p>
    </div>
    <% if policy(User).create? %>
      <%= link_to new_admin_user_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
        <span aria-hidden="true">+</span> <%= t("staff.index.new_button") %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
    <% location_params = { location_id: @location_filter.presence }.compact %>
    <%= link_to admin_users_path(**location_params),
          class: orders_stat_card_class(@q.role_eq.blank? && @q.active_eq.blank? && @q.name_or_email_cont.blank?) do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("staff.index.stats_total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @total_count %></p>
    <% end %>

    <%= link_to admin_users_path(**location_params, q: { role_eq: "owner" }),
          class: orders_stat_card_class(@q.role_eq == "owner") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("staff.index.stats_owners") %></p>
      <p class="text-2xl font-bold mt-1 text-purple-700 tabular-nums"><%= @owner_count %></p>
    <% end %>

    <%= link_to admin_users_path(**location_params, q: { role_eq: "manager" }),
          class: orders_stat_card_class(@q.role_eq == "manager") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("staff.index.stats_managers") %></p>
      <p class="text-2xl font-bold mt-1 text-blue-700 tabular-nums"><%= @manager_count %></p>
    <% end %>

    <%= link_to admin_users_path(**location_params, q: { role_eq: "accountant" }),
          class: orders_stat_card_class(@q.role_eq == "accountant") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("staff.index.stats_accountants") %></p>
      <p class="text-2xl font-bold mt-1 text-teal-700 tabular-nums"><%= @accountant_count %></p>
    <% end %>

    <%= link_to admin_users_path(**location_params, q: { role_eq: "cashier" }),
          class: orders_stat_card_class(@q.role_eq == "cashier") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("staff.index.stats_cashiers") %></p>
      <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= @cashier_count %></p>
    <% end %>

    <%= link_to admin_users_path(**location_params, q: { role_eq: "kitchen" }),
          class: orders_stat_card_class(@q.role_eq == "kitchen") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("staff.index.stats_kitchen") %></p>
      <p class="text-2xl font-bold mt-1 text-amber-700 tabular-nums"><%= @kitchen_count %></p>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("staff.index.filters") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("staff.index.filters_hint") %></p>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_users_path, method: :get, class: "flex flex-wrap items-end gap-4" do |f| %>
        <%= hidden_field_tag :sort, @sort %>
        <%= hidden_field_tag :direction, @sort_direction %>
        <div class="flex-1 min-w-[12rem]">
          <%= f.label :name_or_email_cont, t("staff.index.search"), class: label_class %>
          <%= f.search_field :name_or_email_cont, placeholder: t("staff.index.search_placeholder"), class: input_class %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :role_eq, t("staff.index.role"), class: label_class %>
          <%= f.select :role_eq,
                options_for_select(User::ROLES.map { |r| [user_role_label(r), r] }, @q.role_eq),
                { include_blank: t("staff.index.all_roles") },
                class: "#{input_class} appearance-none" %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :active_eq, t("staff.index.status"), class: label_class %>
          <%= f.select :active_eq,
                options_for_select([
                  [t("staff.index.all_statuses"), ""],
                  [t("staff.show.active"), true],
                  [t("staff.show.inactive"), false]
                ], @q.active_eq),
                {},
                class: "#{input_class} appearance-none" %>
        </div>
        <% if @filter_locations.size > 1 %>
          <div class="min-w-[12rem]">
            <label class="<%= label_class %>" for="location_id"><%= t("staff.index.location") %></label>
            <%= select_tag :location_id,
                  options_for_select(
                    [
                      [t("staff.index.all_locations"), ""],
                      [t("staff.index.company_wide_staff"), StaffLocationFilter::COMPANY_WIDE_FILTER]
                    ] + @filter_locations.map { |l| [l.name, l.id] },
                    @location_filter
                  ),
                  class: "#{input_class} appearance-none",
                  id: "location_id" %>
          </div>
        <% end %>
        <%= f.submit t("actions.apply_filters"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
        <% if @filtered %>
          <%= link_to t("actions.clear"), admin_users_path,
                class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
        <span class="text-sm text-gray-500 ml-auto tabular-nums">
          <%= t("staff.index.showing_members", count: @pagy.count) %>
        </span>
      <% end %>
    </div>
  </section>

  <% if @users.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[760px]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 pl-5"><%= staff_index_sort_link(t("staff.index.table.name"), "name", sort: @sort, direction: @sort_direction) %></th>
              <th class="p-3"><%= staff_index_sort_link(t("staff.index.table.email"), "email", sort: @sort, direction: @sort_direction) %></th>
              <th class="p-3"><%= staff_index_sort_link(t("staff.index.table.role"), "role", sort: @sort, direction: @sort_direction) %></th>
              <th class="p-3 text-end">
                <div class="flex justify-end">
                  <%= staff_index_sort_link(t("staff.index.table.monthly_salary"), "monthly_salary_cents", sort: @sort, direction: @sort_direction) %>
                </div>
              </th>
              <th class="p-3"><%= staff_index_sort_link(t("staff.index.table.joined"), "created_at", sort: @sort, direction: @sort_direction) %></th>
              <th class="p-3"><%= t("staff.index.table.status") %></th>
              <th class="p-3 pr-5 text-right"><%= t("staff.index.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @users.each do |staff| %>
              <tr class="hover:bg-gray-100 transition-colors<%= " opacity-60" unless staff.active? %>">
                <td class="p-3 pl-5">
                  <% if policy(staff).show? %>
                    <%= link_to staff.name, admin_user_path(staff), class: "font-semibold text-gray-900 hover:text-amber-700 transition-colors" %>
                  <% else %>
                    <span class="font-semibold text-gray-900"><%= staff.name %></span>
                  <% end %>
                  <% if staff == current_user %>
                    <span class="text-xs font-semibold text-amber-700 ml-1.5"><%= t("staff.index.you_badge") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-gray-600"><%= staff.email %></td>
                <td class="p-3">
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= user_role_class(staff.role) %> <%= user_role_border_class(staff.role) %>">
                    <%= staff.role_label %>
                  </span>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700">
                  <% if staff.monthly_salary_cents.positive? %>
                    <%= format_money(staff.monthly_salary_cents) %>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-gray-500 whitespace-nowrap tabular-nums">
                  <%= l(staff.created_at.to_date, format: :long) %>
                </td>
                <td class="p-3">
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= user_active_status_class(staff.active?) %>">
                    <%= staff.active? ? t("staff.show.active") : t("staff.show.inactive") %>
                  </span>
                </td>
                <td class="p-3 pr-5 text-right whitespace-nowrap">
                  <div class="inline-flex gap-2">
                    <% if policy(staff).show? %>
                      <%= link_to t("actions.view"), admin_user_path(staff),
                            class: "inline-flex text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-200 transition-colors" %>
                    <% end %>
                    <% if policy(staff).update? %>
                      <%= link_to t("actions.edit"), edit_admin_user_path(staff),
                            class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                    <% end %>
                    <% if policy(staff).activate? %>
                      <%= button_to t("actions.activate"), activate_admin_user_path(staff), method: :patch,
                            form: { data: { turbo_confirm: t("staff.show.activate_confirm", name: staff.name) }, class: "inline" },
                            class: "inline-flex text-xs font-semibold text-emerald-700 hover:bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-200 transition-colors" %>
                    <% end %>
                    <% if policy(staff).destroy? && staff.active? %>
                      <%= button_to t("actions.deactivate"), admin_user_path(staff), method: :delete,
                            form: { data: { turbo_confirm: t("staff.show.deactivate_confirm", name: staff.name) }, class: "inline" },
                            class: "inline-flex text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <% if @pagy.pages > 1 %>
      <nav class="mt-5 flex flex-wrap gap-2 text-sm items-center" aria-label="<%= t("staff.index.pagination_aria") %>">
        <% if @pagy.previous %>
          <%= link_to t("actions.previous"), url_for(request.query_parameters.merge(page: @pagy.previous)),
                class: "px-4 py-2 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 font-medium text-gray-700 transition-colors" %>
        <% end %>
        <span class="text-gray-600 px-2 tabular-nums"><%= t("accounting.shared.pagination", page: @pagy.page, pages: @pagy.pages) %></span>
        <% if @pagy.next %>
          <%= link_to t("actions.next"), url_for(request.query_parameters.merge(page: @pagy.next)),
                class: "px-4 py-2 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 font-medium text-gray-700 transition-colors" %>
        <% end %>
      </nav>
    <% end %>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("staff.index.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5">
        <% if @filtered %>
          <%= t("staff.index.empty_description_filtered") %>
        <% else %>
          <%= t("staff.index.empty_description") %>
        <% end %>
      </p>
      <div class="flex flex-wrap justify-center gap-3 text-sm">
        <% if @filtered %>
          <%= link_to t("staff.index.clear_filters"), admin_users_path,
                class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
        <% if policy(User).create? %>
          <%= link_to t("staff.index.new_button"), new_admin_user_path,
                class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
