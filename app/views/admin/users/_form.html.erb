<%# locals: user %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, user], class: "space-y-6 max-w-lg" do |f| %>
  <% if user.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("staff.form.account_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("staff.form.account_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("staff.form.name"), class: label_class %>
        <%= f.text_field :name, class: input_class, required: true, autofocus: true %>
      </div>

      <div>
        <%= f.label :email, t("staff.form.email"), class: label_class %>
        <%= f.email_field :email, class: input_class, required: true, autocomplete: "off" %>
      </div>

      <% if policy(user).can_edit_role_and_salary? %>
        <div>
          <%= f.label :monthly_salary_pounds, t("staff.payroll.monthly_salary"), class: label_class %>
          <%= f.number_field :monthly_salary_pounds, min: 0, step: "0.01", class: input_class %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("staff.payroll.salary_hint", days: User::WORK_DAYS_PER_MONTH) %></p>
          <% if user.monthly_salary_cents.to_i.positive? %>
            <p class="text-xs text-gray-600 mt-2">
              <%= t("staff.payroll.hourly_rate_auto", rate: format_money(user.hourly_rate_cents), hours: User::WORK_HOURS_PER_MONTH) %>
            </p>
          <% end %>
        </div>

        <div>
          <%= f.label :balance_deduction_pounds, t("staff.payroll.deduction.plan_field"), class: label_class %>
          <%# text_field, not number_field: arabic-numerals turns Arabic-Indic digits into ASCII. %>
          <%= f.text_field :balance_deduction_pounds, inputmode: "decimal", autocomplete: "off",
                data: { controller: "arabic-numerals", action: "input->arabic-numerals#normalize" },
                class: input_class %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("staff.payroll.deduction.plan_field_hint") %></p>
        </div>

        <div>
          <%= f.label :role_id, t("staff.index.role"), class: label_class %>
          <% if current_user.owner? %>
            <%= f.select :role_id, Role.ordered.map { |r| [r.name, r.id] },
                  { selected: user.role_id || Role.find_by(key: user.role)&.id },
                  class: "#{input_class} appearance-none" %>
          <% else %>
            <%= f.select :role, %w[cashier kitchen].map { |r| [user_role_label(r), r] }, {},
                  class: "#{input_class} appearance-none" %>
          <% end %>
          <p class="text-xs text-gray-500 mt-1.5">
            <%= t("staff.form.role_hint") %>
          </p>
        </div>

        <% if current_user.owner? %>
          <div>
            <%= f.label :all_locations, t("staff.form.locations_label"), class: label_class %>
            <label class="flex items-center gap-2.5 text-sm text-gray-800 mt-1">
              <%= f.check_box :all_locations, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
              <%= t("staff.form.all_locations") %>
            </label>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("staff.form.all_locations_hint") %></p>

            <%= hidden_field_tag "user[location_ids][]", "" %>
            <div class="grid grid-cols-2 gap-2 mt-3">
              <% Location.active.ordered.each do |loc| %>
                <label class="flex items-center gap-2.5 text-sm text-gray-800">
                  <%= check_box_tag "user[location_ids][]", loc.id, user.location_ids.include?(loc.id),
                        class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
                  <%= loc.name %>
                </label>
              <% end %>
            </div>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("staff.form.locations_hint") %></p>
          </div>
        <% end %>
      <% else %>
        <div>
          <p class="<%= label_class %>"><%= t("staff.index.role") %></p>
          <p class="text-sm text-gray-700 font-medium"><%= user_role_label(user.role) %></p>
        </div>
        <% if user.monthly_salary_cents.to_i.positive? %>
          <div>
            <p class="<%= label_class %>"><%= t("staff.payroll.monthly_salary") %></p>
            <p class="text-sm text-gray-700 font-medium"><%= format_money(user.monthly_salary_cents) %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <% if current_user.owner? || current_user.accountant? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("staff.form.assigned_treasury_heading") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("staff.form.assigned_treasury_hint") %></p>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <%= f.label :assigned_treasury_id, t("staff.form.assigned_treasury"), class: label_class %>
          <% treasury_select_options = {} %>
          <% treasury_select_options[:include_blank] = t("staff.form.assigned_treasury_auto") if user.assigned_treasury_id.blank? %>
          <%= f.collection_select :assigned_treasury_id,
                @drawer_treasuries || [], :id, :name,
                treasury_select_options,
                class: "#{input_class} appearance-none",
                required: user.assigned_treasury_id.present? %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("staff.form.assigned_treasury_required_hint") %></p>
        </div>
        <% if user.persisted? && user.assigned_treasury_id.blank? %>
          <div class="flex flex-wrap items-center gap-3">
            <%= link_to t("staff.form.create_assigned_treasury"),
                  create_assigned_treasury_admin_user_path(user),
                  data: { turbo_method: :post },
                  class: "text-sm font-semibold text-amber-700 hover:text-amber-800 underline underline-offset-2" %>
            <span class="text-xs text-gray-500"><%= t("staff.form.create_assigned_treasury_hint") %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("user.pin") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("user.pin_hint") %></p>
    </div>
    <div class="p-5">
      <%= f.password_field :pin, class: input_class, maxlength: 4, pattern: "[0-9]{4}",
            inputmode: "numeric", autocomplete: "off", placeholder: "••••" %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("staff.form.password_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5">
        <% if user.persisted? %>
          <%= t("staff.form.password_hint_blank") %>
        <% else %>
          <%= t("staff.form.password_hint_new") %>
        <% end %>
      </p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :password, user.persisted? ? t("staff.form.new_password") : t("staff.form.password"), class: label_class %>
        <%= f.password_field :password, class: input_class, autocomplete: "new-password", required: !user.persisted? %>
      </div>

      <div>
        <%= f.label :password_confirmation, t("staff.form.confirm_password"), class: label_class %>
        <%= f.password_field :password_confirmation, class: input_class, autocomplete: "new-password", required: !user.persisted? %>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit user.persisted? ? t("actions.save_changes") : t("staff.form.create_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to user.persisted? ? t("actions.cancel") : t("staff.show.back_to_list"),
          user.persisted? ? admin_user_path(user) : admin_users_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
