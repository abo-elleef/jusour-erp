<%= form_with model: [:admin, user], class: "bg-white rounded-lg shadow p-6 space-y-4 max-w-md" do |f| %>
  <% if user.errors.any? %>
    <div class="text-red-700 bg-red-50 border border-red-200 rounded-lg p-3 text-sm">
      <%= user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2", required: true %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2", required: true, autocomplete: "off" %>
  </div>

  <div>
    <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <% roles = policy(user).create? && current_user.owner? ? User::ROLES : User::ROLES - ["owner"] %>
    <% roles = ["cashier", "kitchen"] if current_user.manager? && !current_user.owner? %>
    <%= f.select :role, roles.map { |r| [r.humanize, r] }, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    <p class="text-xs text-gray-500 mt-1">
      Owner — full access · Manager — admin + POS · Cashier — POS · Kitchen — KDS only
    </p>
  </div>

  <div class="border-t pt-4">
    <%= f.label :password, user.persisted? ? "New password (leave blank to keep)" : "Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password, class: "w-full border border-gray-300 rounded-lg px-3 py-2", autocomplete: "new-password", required: !user.persisted? %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-lg px-3 py-2", autocomplete: "new-password", required: !user.persisted? %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg font-medium" %>
    <%= link_to "Cancel", admin_users_path, class: "px-4 py-2 text-gray-600 hover:underline" %>
  </div>
<% end %>
