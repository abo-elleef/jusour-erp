<%# locals: user, payroll_month:, payroll_summary:, readonly: false %>
<%# Every voucher to or from this employee dated in the month. There is no
    separate "advance": paying someone before the month is finalized is just a
    payment voucher, and it reduces what they're owed the same way. %>
<% readonly = local_assigns.fetch(:readonly, false) %>
<% payments = payroll_summary.payments %>

<div class="border-t border-gray-100">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-start gap-3">
    <div>
      <h3 class="text-sm font-semibold text-gray-900"><%= t("staff.payroll.payments.heading") %></h3>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("staff.payroll.payments.hint") %></p>
    </div>
    <% if !readonly && policy(Voucher).create? %>
      <% party = "User:#{user.id}" %>
      <div class="flex flex-wrap gap-2">
        <%= link_to t("staff.payroll.payments.pay"),
              new_admin_accounting_voucher_path(direction: Voucher::PAYMENT, party: party),
              class: "bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>
        <%= link_to t("staff.payroll.payments.receive"),
              new_admin_accounting_voucher_path(direction: Voucher::RECEIPT, party: party),
              class: "border border-emerald-300 text-emerald-800 hover:bg-emerald-50 text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>
      </div>
    <% end %>
  </div>

  <% if payments.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("staff.payroll.happened_at") %></th>
            <th class="p-3 text-start"><%= t("staff.payroll.payments.number") %></th>
            <th class="p-3 text-end"><%= t("staff.payroll.amount") %></th>
            <th class="p-3 text-start"><%= t("staff.payroll.payments.treasury") %></th>
            <th class="p-3 pe-5 text-start"><%= t("staff.payroll.notes") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% payments.each do |voucher| %>
            <tr>
              <td class="p-3 ps-5 text-gray-600 whitespace-nowrap tabular-nums"><%= l(voucher.voucher_date, format: :long) %></td>
              <td class="p-3 font-mono text-xs">
                <% if readonly %>
                  <%= voucher.number %>
                <% else %>
                  <%= link_to voucher.number, admin_accounting_voucher_path(voucher), class: "text-blue-700 hover:underline" %>
                <% end %>
              </td>
              <td class="p-3 text-end font-semibold tabular-nums <%= voucher.payment? ? 'text-blue-700' : 'text-emerald-700' %>">
                <%= voucher.payment? ? "−" : "+" %><%= format_amount(voucher.amount_cents) %>
              </td>
              <td class="p-3 text-gray-600">
                <% if readonly %>
                  <%= voucher.treasury.name %>
                <% else %>
                  <%= link_to voucher.treasury.name, admin_accounting_treasury_path(voucher.treasury), class: "hover:underline" %>
                <% end %>
              </td>
              <td class="p-3 pe-5 text-gray-600"><%= voucher.notes.presence || t("accounting.shared.em_dash") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="p-5 text-sm text-gray-500"><%= t("staff.payroll.payments.empty") %></p>
  <% end %>
</div>
