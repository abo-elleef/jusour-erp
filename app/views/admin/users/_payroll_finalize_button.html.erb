<%# locals: user, payroll_month:, payroll_summary: nil, snapshot: nil, return_to: nil, compact: false, treasuries: nil, default_treasury: nil %>
<% payroll_month ||= Date.current.beginning_of_month %>
<% payroll_summary = local_assigns[:payroll_summary] %>
<% snapshot = local_assigns[:snapshot] || payroll_summary&.snapshot %>
<% finalized = payroll_summary&.finalized || snapshot.present? %>
<% compact = local_assigns.fetch(:compact, false) %>
<% return_to = local_assigns[:return_to] %>
<% remaining_pay_cents = if local_assigns.key?(:remaining_pay_cents)
     local_assigns[:remaining_pay_cents].to_i
   else
     payroll_summary&.remaining_pay_cents || snapshot&.remaining_pay_cents.to_i
   end %>
<% payout_cents = payroll_summary&.payout_cents || remaining_pay_cents %>
<% debt_cents = payroll_summary&.debt_cents.to_i %>
<%# Owing the company means part of this month's pay can be kept back —
    the form is needed then even when the default deduction leaves nothing to pay. %>
<% payout_required = payout_cents.positive? || debt_cents.positive? %>
<% treasuries = local_assigns[:treasuries] || Treasury.active.payable.visible_to(current_user).ordered %>
<% default_treasury = local_assigns[:default_treasury] || Treasury.default_treasury %>
<% btn_class = compact ? "inline-flex text-xs font-semibold px-3 py-1.5 rounded-xl border transition-colors" : "inline-flex text-sm font-semibold px-4 py-2 rounded-xl border transition-colors" %>
<% input_class = compact ? "bg-gray-50 border border-gray-200 rounded-lg px-2 py-1.5 text-xs text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" : "bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
<% snapshot_params = { payroll_month: payroll_month.strftime("%Y-%m"), return_to: return_to }.compact %>
<% default_paid_on = [Date.current, payroll_month.end_of_month].min %>
<% default_paid_on = [default_paid_on, payroll_month.beginning_of_month].max %>

<% if policy(PayrollSnapshot).create? %>
  <% if finalized %>
    <% recorded_meta = t("staff.payroll.recorded_on", date: l(snapshot.finalized_at.to_date, format: :long), name: snapshot.finalized_by.name) %>
    <% if return_to == "monthly_payroll" %>
      <span class="inline-flex flex-col items-start gap-1">
        <span class="<%= btn_class %> bg-emerald-50 text-emerald-800 border-emerald-200"><%= t("staff.payroll.recorded") %></span>
        <span class="text-[0.65rem] leading-tight text-gray-500 normal-case"><%= recorded_meta %></span>
      </span>
    <% else %>
      <span class="<%= btn_class %> bg-emerald-50 text-emerald-800 border-emerald-200" title="<%= recorded_meta %>">
        <%= t("staff.payroll.recorded") %>
      </span>
    <% end %>
    <% if policy(snapshot).destroy? %>
      <%= button_to t("staff.payroll.undo_record"),
            admin_user_payroll_snapshot_path(user, **snapshot_params),
            method: :delete,
            form: {
              data: {
                turbo_confirm: t(
                  "staff.payroll.undo_record_confirm",
                  name: user.name,
                  month: l(payroll_month, format: "%B %Y")
                )
              },
              class: "inline"
            },
            class: "#{btn_class} text-red-700 hover:bg-red-50 border-red-200" %>
    <% end %>
  <% elsif payout_required %>
    <%= form_with url: admin_user_payroll_snapshot_path(user, **snapshot_params),
          method: :post,
          class: compact ? "inline-flex flex-wrap items-center gap-1.5 max-w-xs" : "flex flex-wrap items-end gap-2" do %>
      <div>
        <% unless compact %>
          <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("staff.payroll.pay_from_treasury") %></label>
        <% end %>
        <%= select_tag "payroll_snapshot[treasury_id]",
              options_for_select([[t("staff.payroll.record_only"), ""]]) +
                    options_from_collection_for_select(treasuries, :id, :name, default_treasury&.id),
              class: "#{input_class} appearance-none",
              title: t("staff.payroll.pay_from_treasury") %>
      </div>
      <% if debt_cents.positive? %>
        <div>
          <% unless compact %>
            <label class="block text-xs font-semibold text-gray-600 mb-1" for="deduction_<%= user.id %>"><%= t("staff.payroll.deduction.field") %></label>
          <% end %>
          <%= text_field_tag "payroll_snapshot[deduction_pounds]",
                format("%.2f", payroll_summary.deduction_cents / 100.0),
                id: "deduction_#{user.id}",
                inputmode: "decimal", autocomplete: "off",
                title: t("staff.payroll.deduction.field_hint", debt: format_amount(debt_cents)),
                data: { controller: "arabic-numerals", action: "input->arabic-numerals#normalize" },
                class: "#{input_class} #{compact ? 'w-24' : 'w-36'} tabular-nums" %>
          <% unless compact %>
            <p class="text-[11px] text-gray-500 mt-1"><%= t("staff.payroll.deduction.field_hint", debt: format_amount(debt_cents)) %></p>
          <% end %>
        </div>
      <% end %>
      <% unless compact %>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1"><%= t("staff.payroll.happened_at") %></label>
          <%= date_field_tag "payroll_snapshot[paid_on]",
                default_paid_on,
                min: payroll_month.beginning_of_month,
                max: payroll_month.end_of_month,
                class: input_class %>
        </div>
      <% else %>
        <%= hidden_field_tag "payroll_snapshot[paid_on]", default_paid_on %>
      <% end %>
      <%= submit_tag t("staff.payroll.record_payroll"),
            class: "#{btn_class} bg-amber-600 hover:bg-amber-700 text-white border-amber-600 cursor-pointer" %>
    <% end %>
  <% else %>
    <%= button_to t("staff.payroll.record_payroll"),
          admin_user_payroll_snapshot_path(user, **snapshot_params),
          method: :post,
          form: { class: "inline", data: { turbo_confirm: t("staff.payroll.record_fully_advanced_confirm") } },
          class: "#{btn_class} bg-amber-600 hover:bg-amber-700 text-white border-amber-600",
          title: t("staff.payroll.fully_advanced_hint") %>
  <% end %>
<% end %>
