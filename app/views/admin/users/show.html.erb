<% content_for :title, @user.name %>
<% action_btn_class = "text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>

<div class="max-w-7xl">
  <div class="mb-4">
    <%= link_to t("staff.show.back_to_list"), admin_users_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @user.name %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= @user.email %></p>
      <% if @user == current_user %>
        <span class="inline-block text-xs font-semibold text-amber-700 mt-1"><%= t("staff.show.you") %></span>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full border <%= user_role_class(@user.role) %> <%= user_role_border_class(@user.role) %>">
        <%= @user.role_label %>
      </span>
      <% if policy(@user).update? %>
        <%= link_to t("actions.edit"), edit_admin_user_path(@user),
              class: "#{action_btn_class} bg-gray-900 hover:bg-gray-800 text-white" %>
      <% end %>
      <% if policy(@user).activate? %>
        <%= button_to t("actions.activate"), activate_admin_user_path(@user), method: :patch,
              form: { data: { turbo_confirm: t("staff.show.activate_confirm", name: @user.name) } },
              class: "#{action_btn_class} bg-emerald-600 hover:bg-emerald-700 text-white" %>
      <% end %>
      <% if policy(@user).destroy? && @user.active? %>
        <%= button_to t("actions.deactivate"), admin_user_path(@user), method: :delete,
              form: { data: { turbo_confirm: t("staff.show.deactivate_confirm", name: @user.name) } },
              class: "#{action_btn_class} bg-red-600 hover:bg-red-700 text-white" %>
      <% end %>
    </div>
  </div>

  <%= render "stats" %>

  <%# The active tab loads lazily into this frame from the same URL — see
      UsersController#show. Until it arrives, the placeholder holds the space
      so the page doesn't jump. %>
  <%= turbo_frame_tag Admin::UsersController::TAB_FRAME,
        src: admin_user_path(@user, request.query_parameters),
        data: { turbo_action: "advance" } do %>
    <%= render "tab_nav", user: @user, tabs: @tabs, active_tab: @tab %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-12 mt-6 text-center text-sm text-gray-500 animate-pulse">
      <%= t("staff.show.tabs.loading") %>
    </div>
  <% end %>
</div>
