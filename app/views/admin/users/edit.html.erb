<div class="max-w-lg">
  <div class="mb-4">
    <%= link_to t("staff.show.back_to_profile", name: @user.name), admin_user_path(@user),
          class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("staff.show.edit_title", name: @user.name) %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= @user.email %></p>
  </div>

  <%= render "form", user: @user %>
</div>
