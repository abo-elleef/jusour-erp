<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% card = "rounded-2xl border border-gray-200 bg-white px-5 py-4" %>
<% food_cost_pct = @sales_revenue_cents.positive? ? (@sales_cost_cents.to_f / @sales_revenue_cents * 100).round(1) : nil %>
<% sort_params = { sort: @sales_sort, direction: @sales_dir, base_params: request.query_parameters.except("page", "sort", "dir"),
                   path: admin_menu_item_path(@menu_item) } %>

<%# Submits inside the tab frame, so the page keeps its scroll. %>
<%= form_with url: admin_menu_item_path(@menu_item), method: :get,
      class: "rounded-2xl border border-gray-200 bg-white p-5 flex flex-wrap items-end gap-3" do %>
  <%= hidden_field_tag :tab, "sales", id: nil %>
  <div>
    <%= label_tag :from, t("admin.menu_items.show.sales_from"), class: label_class %>
    <%= date_field_tag :from, @sales_from, class: "#{pos_input_class} w-44" %>
  </div>
  <div>
    <%= label_tag :to, t("admin.menu_items.show.sales_to"), class: label_class %>
    <%= date_field_tag :to, @sales_to, class: "#{pos_input_class} w-44" %>
  </div>
  <%= submit_tag t("actions.apply"),
        class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
<% end %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-6">
  <div class="<%= card %>">
    <p class="text-xs font-semibold text-gray-500"><%= t("admin.menu_items.show.units_sold") %></p>
    <p class="text-xl font-bold text-gray-900 tabular-nums mt-1"><%= number_with_precision(@sales_units, precision: 2, strip_insignificant_zeros: true) %></p>
  </div>
  <div class="<%= card %>">
    <p class="text-xs font-semibold text-gray-500"><%= t("admin.menu_items.show.revenue") %></p>
    <p class="text-xl font-bold text-gray-900 tabular-nums mt-1"><%= format_amount(@sales_revenue_cents) %></p>
  </div>
  <div class="<%= card %>">
    <p class="text-xs font-semibold text-gray-500"><%= t("admin.menu_items.show.food_cost") %></p>
    <p class="text-xl font-bold text-gray-900 tabular-nums mt-1"><%= format_amount(@sales_cost_cents) %></p>
  </div>
  <div class="<%= card %>">
    <p class="text-xs font-semibold text-gray-500"><%= t("admin.menu_items.show.food_cost_pct") %></p>
    <p class="text-xl font-bold text-gray-900 tabular-nums mt-1"><%= food_cost_pct ? "#{food_cost_pct}%" : "—" %></p>
  </div>
</div>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mt-6">
  <% if @sales_lines.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm min-w-[40rem]">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("order.labels.order_number") %></th>
            <th class="p-3 text-start"><%= sort_header_link(t("admin.menu_items.show.business_date"), "date", **sort_params) %></th>
            <th class="p-3 text-start"><%= t("admin.menu_items.show.options") %></th>
            <th class="p-3 text-end"><%= sort_header_link(t("admin.menu_items.show.quantity"), "quantity", **sort_params) %></th>
            <th class="p-3 pe-5 text-end"><%= sort_header_link(t("admin.menu_items.show.amount"), "amount", **sort_params) %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @sales_lines.each do |line| %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5">
                <%= link_to (line.order.order_number.presence || t("admin.menu_items.show.order_fallback")), admin_order_path(line.order),
                      class: "font-medium text-amber-700 hover:text-amber-800", data: { turbo_frame: "_top" } %>
              </td>
              <td class="p-3 text-gray-600 whitespace-nowrap"><%= l(line.order.business_date) if line.order.business_date %></td>
              <td class="p-3 text-gray-600"><%= line.order_item_modifiers.map(&:name).join(" · ").presence || "—" %></td>
              <td class="p-3 text-end tabular-nums"><%= number_with_precision(line.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
              <td class="p-3 pe-5 text-end tabular-nums"><%= format_amount(line.line_revenue_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "admin/accounting/pagination", pagy: @sales_pagy %>
  <% else %>
    <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("admin.menu_items.show.no_sales") %></p>
  <% end %>
</section>
