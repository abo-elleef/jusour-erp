<% content_for :title, @menu_item.name %>
<% action_btn_class = "text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <%# The way back sits in the title line as a breadcrumb, so it costs no row. %>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= render "admin/title_crumbs", crumbs: [[t("admin.menu_nav.menu_items"), admin_menu_items_path]] %>
        <%= @menu_item.name %>
        <% if @menu_item.available? %>
          <span class="ms-2 align-middle text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200"><%= t("admin.menu_items.available") %></span>
        <% else %>
          <span class="ms-2 align-middle text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200"><%= t("admin.menu_items.unavailable") %></span>
        <% end %>
      </h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= @menu_item.category.name %>
        <% if @menu_item.code.present? %> · <span class="font-mono"><%= @menu_item.code %></span><% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <% if policy(@menu_item).update? %>
        <%= link_to t("actions.edit"), edit_admin_menu_item_path(@menu_item),
              class: "#{action_btn_class} bg-gray-900 hover:bg-gray-800 text-white" %>
      <% end %>
      <% if policy(@menu_item).destroy? %>
        <%= button_to t("actions.delete"), admin_menu_item_path(@menu_item), method: :delete,
              form: { data: { turbo_confirm: t("admin.menu_items.confirm_delete", name: @menu_item.name) } },
              class: "#{action_btn_class} bg-red-600 hover:bg-red-700 text-white" %>
      <% end %>
    </div>
  </div>

  <%# The active tab loads lazily into this frame from the same URL — see
      MenuItemsController#show. The placeholder holds the space until then. %>
  <%= turbo_frame_tag Admin::MenuItemsController::TAB_FRAME,
        src: admin_menu_item_path(@menu_item, request.query_parameters),
        data: { turbo_action: "advance" } do %>
    <%= render "tab_nav", menu_item: @menu_item, tabs: @tabs, active_tab: @tab %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-12 mt-6 text-center text-sm text-gray-500 animate-pulse">
      <%= t("admin.menu_items.show.loading") %>
    </div>
  <% end %>
</div>
