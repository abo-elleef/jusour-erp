<div class="flex gap-2 items-center" data-nested-modifiers-target="modifier">
  <%= mod.hidden_field :_destroy, value: false, data: { nested_modifiers_target: "destroy" } %>
  <%= mod.text_field :name, placeholder: "Modifier name",
        class: "flex-1 bg-white border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
  <%= mod.number_field :price_adjustment_cents, placeholder: "¢ adj", min: 0,
        class: "w-28 bg-white border border-gray-200 rounded-xl px-3 py-2 text-sm tabular-nums focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
  <button type="button"
        class="text-xs font-semibold text-red-700 hover:bg-red-50 w-8 h-8 rounded-xl border border-red-200 transition-colors shrink-0"
        data-action="nested-modifiers#removeModifier"
        title="Remove"
        aria-label="Remove modifier">✕</button>
</div>
