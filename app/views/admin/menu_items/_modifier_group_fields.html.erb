<div class="border border-gray-200 rounded-lg p-4 mb-3 bg-gray-50" data-nested-modifiers-target="group">
  <%= mg.hidden_field :_destroy, value: false, data: { nested_modifiers_target: "destroy" } %>
  <div class="flex justify-between items-start gap-2 mb-3">
    <%= mg.text_field :name, placeholder: "Group name (e.g. Spice Level)", class: "flex-1 border border-gray-300 rounded-lg px-3 py-2 font-medium" %>
    <button type="button" class="text-red-600 text-sm hover:underline shrink-0" data-action="nested-modifiers#removeGroup">Remove</button>
  </div>
  <div class="flex gap-4 text-sm mb-3">
    <label class="flex items-center gap-1">
      <%= mg.check_box :required, class: "rounded" %> Required
    </label>
    <label class="flex items-center gap-1">
      <%= mg.check_box :multi_select, class: "rounded" %> Multi-select
    </label>
  </div>
  <div class="space-y-2" data-nested-modifiers-target="modifiers">
    <%= mg.fields_for :modifiers do |mod| %>
      <%= render "modifier_fields", mod: mod %>
    <% end %>
  </div>
  <button type="button" class="text-sm text-blue-600 hover:underline mt-2" data-action="nested-modifiers#addModifier">+ Add modifier</button>
  <template data-nested-modifiers-target="modifierTemplate">
    <%= mg.fields_for :modifiers, Modifier.new, child_index: "NEW_MOD" do |mod| %>
      <%= render "modifier_fields", mod: mod %>
    <% end %>
  </template>
</div>
