<%# locals: menu_item %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, menu_item], class: "space-y-6 max-w-3xl" do |f| %>
  <% if menu_item.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= menu_item.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.menu_items.form_details_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.menu_items.form_details_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <%= f.label :category_id, t("admin.menu_items.category"), class: label_class %>
          <%= f.collection_select :category_id, @categories, :id, :name,
                { prompt: t("admin.menu_items.select_category") },
                class: "#{input_class} appearance-none", required: true %>
        </div>
        <div>
          <%= f.label :name, t("admin.menu_items.table.name"), class: label_class %>
          <%= f.text_field :name, class: input_class, autofocus: true %>
        </div>
        <div>
          <%= f.label :code, t("admin.menu_items.table.code"), class: label_class %>
          <%= f.text_field :code, class: "#{input_class} font-mono",
                placeholder: t("admin.menu_items.code_placeholder") %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.menu_items.code_hint") %></p>
        </div>
      </div>

      <div>
        <%= f.label :description, t("admin.menu_items.field_description"), class: label_class %>
        <%= f.text_area :description, rows: 2, class: "#{input_class} resize-y min-h-[4rem]" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div>
          <%= f.label :base_price_pounds, t("admin.menu_items.price"), class: label_class %>
          <%= f.number_field :base_price_pounds, min: 0, step: "0.01", class: input_class %>
        </div>
        <div>
          <%= f.label :tax_category, t("admin.menu_items.tax_category"), class: label_class %>
          <%= f.select :tax_category,
                MenuItem::TAX_CATEGORIES.map { |cat| [menu_item_tax_category(cat), cat] },
                {},
                class: "#{input_class} appearance-none" %>
        </div>
        <div>
          <%= f.label :position, t("admin.menu_items.display_position"), class: label_class %>
          <%= f.number_field :position, min: 0, class: input_class %>
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.menu_items.form_pos_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.menu_items.form_pos_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :available, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("admin.menu_items.available_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("admin.menu_items.available_hint") %></span>
          </span>
        </label>
      </div>
      <div>
        <%= f.label :image, t("admin.menu_items.image"), class: label_class %>
        <%= f.file_field :image, accept: "image/*",
              class: "text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200" %>
        <% if menu_item.image.attached? %>
          <div class="mt-3">
            <%= image_tag menu_item.image, class: "h-20 rounded-xl border border-gray-200 object-cover" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("menu.menu_items.assign_modifier_groups") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("menu.menu_items.assign_modifier_groups_hint") %></p>
      </div>
      <%= link_to t("menu.modifier_groups.manage_link"), admin_modifier_groups_path,
            class: "text-sm font-semibold text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl transition-colors" %>
    </div>
    <div class="p-5">
      <% if @all_modifier_groups.any? %>
        <div class="space-y-2">
          <% @all_modifier_groups.each do |group| %>
            <label class="flex items-start gap-3 rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-3 cursor-pointer hover:bg-gray-50 transition-colors">
              <%= check_box_tag "menu_item[modifier_group_ids][]",
                    group.id,
                    @assigned_modifier_group_ids.include?(group.id),
                    class: "mt-1 rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold text-gray-900"><%= group.name %></span>
                <span class="block text-xs text-gray-500 mt-0.5">
                  <%= t("menu.modifier_groups.modifier_count", count: group.modifiers.size) %>
                  <% badges = [] %>
                  <% badges << t("menu.modifier_groups.required") if group.required? %>
                  <% badges << t("menu.modifier_groups.multi_select") if group.multi_select? %>
                  <% if badges.any? %> · <%= badges.join(" · ") %><% end %>
                </span>
              </span>
            </label>
          <% end %>
        </div>
        <%= hidden_field_tag "menu_item[modifier_group_ids][]", "" %>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-4">
          <%= t("menu.menu_items.no_modifier_groups") %>
          <%= link_to t("menu.modifier_groups.new_button"), new_admin_modifier_group_path,
                class: "font-semibold text-amber-700 hover:text-amber-800" %>.
        </p>
      <% end %>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit menu_item.persisted? ? t("actions.save_changes") : t("admin.menu_items.create_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"), admin_menu_items_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
