<div class="max-w-3xl">
  <div class="mb-4">
    <%= link_to t("admin.menu_items.back_to_list"), admin_menu_items_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title("edit") %>: <%= @menu_item.name %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= @menu_item.category.name %> · <%= format_money(@menu_item.base_price_cents) %></p>
    </div>
    <% if @menu_item.available? %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
        <%= t("admin.menu_items.available") %>
      </span>
    <% else %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
        <%= t("admin.menu_items.unavailable") %>
      </span>
    <% end %>
  </div>

  <%= render "admin/menu_nav", flush: false %>
  <%= render "form", menu_item: @menu_item %>
  <%= render "recipes", menu_item: @menu_item, recipes: @recipes, recipe_ingredients: @recipe_ingredients %>
  <%= render "shared/audit_history", audits: @audits %>
</div>
