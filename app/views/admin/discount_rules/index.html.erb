<h1 class="text-2xl font-bold mb-4"><%= admin_page_title %></h1>
<%= link_to "New Rule", new_admin_discount_rule_path, class: "mb-4 inline-block bg-amber-500 text-white px-4 py-2 rounded" %>
<table class="w-full bg-white rounded-lg shadow">
  <% @discount_rules.each do |rule| %>
    <tr class="border-b">
      <td class="p-3"><%= rule.name %></td>
      <td class="p-3"><%= rule.code %></td>
      <td class="p-3"><%= link_to "Edit", edit_admin_discount_rule_path(rule) %></td>
    </tr>
  <% end %>
</table>
