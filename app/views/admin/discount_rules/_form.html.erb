<%# locals: discount_rule %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, discount_rule],
      class: "space-y-6 max-w-2xl",
      data: { controller: "discount-rule-scope" } do |f| %>
  <% if discount_rule.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= discount_rule.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("discounts.rules.basics_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("discounts.rules.basics_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("discounts.rules.name"), class: label_class %>
        <%= f.text_field :name, class: input_class, autofocus: true, required: true %>
      </div>
      <div>
        <%= f.label :code, t("discounts.rules.code"), class: label_class %>
        <%= f.text_field :code, class: input_class, placeholder: t("discounts.rules.code_placeholder") %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("discounts.rules.code_hint") %></p>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("discounts.rules.discount_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("discounts.rules.discount_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :discount_type, t("discounts.rules.discount_type"), class: label_class %>
          <%= f.select :discount_type,
                options_for_select(
                  DiscountRule::DISCOUNT_TYPES.map { |type| [t("discounts.rules.types.#{type}"), type] },
                  discount_rule.discount_type
                ),
                {},
                class: "#{input_class} appearance-none" %>
        </div>
        <div>
          <%= f.label :discount_value, t("discounts.rules.discount_value"), class: label_class %>
          <%= f.number_field :discount_value, step: 0.01, min: 0, class: input_class, required: true %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("discounts.rules.discount_value_hint") %></p>
        </div>
      </div>
      <div>
        <%= f.label :minimum_order_cents, t("discounts.rules.minimum_order"), class: label_class %>
        <%= f.number_field :minimum_order_cents, min: 0, class: input_class %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("discounts.rules.minimum_order_hint") %></p>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("discounts.rules.scope_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("discounts.rules.scope_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :applies_to, t("discounts.rules.applies_to"), class: label_class %>
        <%= f.select :applies_to,
              options_for_select(
                DiscountRule::APPLIES_TO.map { |scope| [t("discounts.rules.scopes.#{scope}"), scope] },
                discount_rule.applies_to
              ),
              {},
              class: "#{input_class} appearance-none",
              data: {
                discount_rule_scope_target: "appliesTo",
                action: "change->discount-rule-scope#update"
              } %>
      </div>
      <div data-discount-rule-scope-target="itemScope" class="<%= "hidden" unless discount_rule.applies_to == "item" %>">
        <%= f.label :applies_to_id, t("discounts.rules.menu_item"), class: label_class %>
        <%= f.collection_select :applies_to_id,
              @menu_items,
              :id,
              :name,
              { include_blank: t("discounts.rules.select_menu_item") },
              class: "#{input_class} appearance-none" %>
      </div>
      <div data-discount-rule-scope-target="categoryScope" class="<%= "hidden" unless discount_rule.applies_to == "category" %>">
        <%= f.label :applies_to_id, t("discounts.rules.category"), class: label_class %>
        <%= f.collection_select :applies_to_id,
              @categories,
              :id,
              :name,
              { include_blank: t("discounts.rules.select_category") },
              class: "#{input_class} appearance-none" %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("discounts.rules.limits_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("discounts.rules.limits_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :expires_at, t("discounts.rules.expires_at"), class: label_class %>
          <%= f.datetime_local_field :expires_at,
                value: discount_rule.expires_at&.strftime("%Y-%m-%dT%H:%M"),
                class: input_class %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("discounts.rules.expires_at_hint") %></p>
        </div>
        <div>
          <%= f.label :uses_remaining, t("discounts.rules.uses_remaining"), class: label_class %>
          <%= f.number_field :uses_remaining, min: 0, class: input_class %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("discounts.rules.uses_remaining_hint") %></p>
        </div>
      </div>
      <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :active, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("discounts.rules.active_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("discounts.rules.active_hint") %></span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit discount_rule.persisted? ? t("actions.save_changes") : t("discounts.rules.create_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"), admin_discount_rules_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
