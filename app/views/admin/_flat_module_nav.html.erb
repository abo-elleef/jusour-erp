<%# locals: module_key:, label:, icon:, active:, items:, item_active_proc:, item_label_proc:, item_path_proc:
    A module with no natural sub-groups (or whose groups have been merged on
    purpose — Inventory and Accounting flatten Reports out to the dedicated
    Reports hub and merge what's left into one list): expand the module, then
    pick a page directly. Shared by Inventory, Accounting and Settings. %>
<div class="flex flex-col gap-0.5"
     data-controller="nested-nav"
     data-nested-nav-key-value="<%= module_key %>"
     data-nested-nav-open-value="<%= active %>">
  <button type="button"
          data-nested-nav-module-button
          data-action="nested-nav#toggleModule"
          aria-expanded="<%= active %>"
          class="<%= admin_nav_link_class(active) %> w-full text-start">
    <%= admin_nav_icon(icon) %>
    <span class="flex-1"><%= label %></span>
    <svg data-nested-nav-target="moduleChevron"
         class="w-3.5 h-3.5 shrink-0 opacity-60 transition-transform <%= active ? "rotate-90" : (rtl? ? "rotate-180" : nil) %>"
         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <div data-nested-nav-target="modulePanel" class="<%= "hidden" unless active %> ms-2 flex flex-col gap-0.5 rounded-lg bg-black/35 ring-1 ring-black/20 p-1">
    <% items.each do |item| %>
      <% item_active = item_active_proc.call(item) %>
      <%= link_to item_label_proc.call(item), item_path_proc.call(item),
            class: "block py-1.5 px-2 rounded-lg text-sm transition-colors #{item_active ? "bg-gray-700 text-white" : "text-gray-300 hover:bg-gray-800 hover:text-white"}" %>
    <% end %>
  </div>
</div>
