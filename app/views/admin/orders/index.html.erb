<% content_for :title, t("admin.orders.title") %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("admin.orders.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("admin.orders.description") %></p>
    </div>
    <% if current_user.can_access_pos? %>
      <%= link_to t("admin.orders.open_pos"), pos_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <%= link_to admin_orders_filter_url(date: business_today, focus: nil),
          class: orders_stat_card_class(@filter_date == business_today.to_s && @focus.blank?) do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_today") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @today_count %></p>
      <p class="text-xs text-amber-700 mt-1.5 font-medium"><%= t("admin.hints.click_to_filter") %></p>
    <% end %>

    <%= link_to admin_orders_filter_url(date: business_today, focus: nil, q: { status_eq: "completed" }),
          class: orders_stat_card_class(@filter_date == business_today.to_s && params.dig(:q, :status_eq) == "completed" && @focus.blank?) do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_revenue_today") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@today_revenue_cents) %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.orders.stats_completed_orders") %></p>
    <% end %>

    <%= link_to admin_orders_filter_url(focus: "open", date: @filter_date, q: params[:q]&.to_unsafe_h),
          class: orders_stat_card_class(@focus == "open") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_open") %></p>
      <p class="text-2xl font-bold mt-1 text-indigo-600 tabular-nums"><%= @open_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.orders.stats_open_hint") %></p>
    <% end %>

    <%= link_to admin_orders_filter_url(focus: "unpaid", date: @filter_date, q: params[:q]&.to_unsafe_h),
          class: orders_stat_card_class(@focus == "unpaid") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_unpaid") %></p>
      <p class="text-2xl font-bold mt-1 text-amber-700 tabular-nums"><%= @unpaid_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.orders.stats_balance_due") %></p>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.orders.filters") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.orders.filters_hint") %></p>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_orders_path, method: :get, class: "space-y-4" do |f| %>
        <%= hidden_field_tag :date, @filter_date if @filter_date.present? %>
        <%= hidden_field_tag :focus, @focus if @focus.present? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          <div>
            <%= label_tag :date, t("admin.orders.day"), class: label_class %>
            <%= date_field_tag :date, @filter_date, class: input_class %>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.orders.day_hint") %></p>
          </div>
          <div>
            <%= f.label :user_id_eq, t("admin.orders.cashier"), class: label_class %>
            <%= f.select :user_id_eq,
                  options_from_collection_for_select(@cashiers, :id, :name, @q.user_id_eq),
                  { include_blank: t("admin.orders.all_cashiers") },
                  class: "#{input_class} appearance-none" %>
          </div>
          <div>
            <%= f.label :customer_id_eq, t("admin.orders.customer"), class: label_class %>
            <%= f.select :customer_id_eq,
                  options_from_collection_for_select(@customers, :id, :display_name, @q.customer_id_eq),
                  { include_blank: t("admin.orders.all_customers") },
                  class: "#{input_class} appearance-none" %>
          </div>
          <div>
            <%= f.label :status_eq, t("admin.orders.status"), class: label_class %>
            <%= f.select :status_eq,
                  options_for_select(Order::STATUSES.map { |s| [order_status_label(s), s] }, @q.status_eq),
                  { include_blank: t("admin.orders.all_statuses") },
                  class: "#{input_class} appearance-none" %>
          </div>
          <div>
            <%= f.label :order_type_eq, t("admin.orders.type"), class: label_class %>
            <%= f.select :order_type_eq,
                  options_for_select(Order::ORDER_TYPES.map { |type| [order_type_label(type), type] }, @q.order_type_eq),
                  { include_blank: t("admin.orders.all_types") },
                  class: "#{input_class} appearance-none" %>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <%= f.submit t("actions.apply_filters"),
                class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
          <%= link_to t("actions.clear"), admin_orders_path,
                class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
          <%= link_to t("admin.orders.today_link"), admin_orders_filter_url(date: business_today, focus: nil, q: params[:q]&.to_unsafe_h),
                class: "text-sm font-medium text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
          <% if @filtered %>
            <%= link_to t("admin.orders.all_orders"), admin_orders_path,
                  class: "text-sm font-medium text-gray-600 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
          <% end %>
          <% if @focus == "open" %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-indigo-100 text-indigo-900 border border-indigo-200 text-xs font-semibold">
              <%= t("admin.orders.focus_open") %>
              <%= link_to "×", admin_orders_filter_url(focus: nil, date: @filter_date, q: params[:q]&.to_unsafe_h),
                    class: "hover:text-indigo-950 ml-0.5", aria: { label: t("admin.orders.remove_open_filter") } %>
            </span>
          <% elsif @focus == "unpaid" %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-100 text-amber-900 border border-amber-200 text-xs font-semibold">
              <%= t("admin.orders.focus_unpaid") %>
              <%= link_to "×", admin_orders_filter_url(focus: nil, date: @filter_date, q: params[:q]&.to_unsafe_h),
                    class: "hover:text-amber-950 ml-0.5", aria: { label: t("admin.orders.remove_unpaid_filter") } %>
            </span>
          <% end %>
          <% if @filter_date.present? %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gray-100 text-gray-800 border border-gray-200 text-xs font-semibold">
              <%= l(Date.parse(@filter_date), format: :long) rescue @filter_date %>
              <%= link_to "×", admin_orders_filter_url(date: nil, focus: @focus, q: params[:q]&.to_unsafe_h),
                    class: "hover:text-gray-900 ml-0.5", aria: { label: t("admin.orders.remove_date_filter") } %>
            </span>
          <% end %>
          <span class="text-sm text-gray-500 ml-auto tabular-nums">
            <%= t("admin.orders.showing_orders", count: @pagy.count) %>
          </span>
        </div>
      <% end %>
    </div>
  </section>

  <% if @orders.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[960px]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 pl-5"><%= t("admin.orders.table.order") %></th>
              <th class="p-3"><%= t("admin.orders.table.date_time") %></th>
              <th class="p-3"><%= t("admin.orders.table.cashier") %></th>
              <th class="p-3"><%= t("admin.orders.table.customer") %></th>
              <th class="p-3"><%= t("admin.orders.table.type") %></th>
              <th class="p-3"><%= t("admin.orders.table.status") %></th>
              <th class="p-3 text-right"><%= t("admin.orders.table.items") %></th>
              <th class="p-3 text-right"><%= t("admin.orders.table.total") %></th>
              <th class="p-3"><%= t("admin.orders.table.payment") %></th>
              <th class="p-3 pr-5 text-right"><%= t("admin.orders.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 pl-5 font-medium">
                  <%= link_to order.order_number, admin_order_path(order, admin_orders_filter_params),
                        class: "text-amber-700 hover:text-amber-800 font-semibold" %>
                </td>
                <td class="p-3 text-gray-600 whitespace-nowrap">
                  <%= l(order.created_at.to_date, format: :long) %>
                  <span class="text-gray-400 block text-xs"><%= l(order.created_at, format: :short_time) %></span>
                </td>
                <td class="p-3 text-gray-900"><%= order.user.name %></td>
                <td class="p-3 text-gray-600">
                  <% if order.customer %>
                    <%= link_to order.customer.display_name, admin_customer_path(order.customer),
                          class: "text-amber-700 hover:text-amber-800 font-medium" %>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3">
                  <span class="text-xs uppercase font-semibold px-2.5 py-1 rounded-full <%= order_type_class(order.order_type) %>">
                    <%= order.order_type_label %>
                  </span>
                  <span class="text-xs text-gray-500 block mt-1"><%= order.fulfillment_summary %></span>
                </td>
                <td class="p-3">
                  <span class="text-xs uppercase font-semibold px-2.5 py-1 rounded-full <%= order_status_class(order.status) %>">
                    <%= order_status_label(order.status) %>
                  </span>
                </td>
                <td class="p-3 text-right text-gray-600 tabular-nums"><%= order.order_items.size %></td>
                <td class="p-3 text-right font-semibold text-gray-900 whitespace-nowrap tabular-nums"><%= format_money(order.total_cents) %></td>
                <td class="p-3"><%= order_payment_summary(order) %></td>
                <td class="p-3 pr-5 text-right whitespace-nowrap">
                  <%= link_to t("actions.view"), admin_order_path(order, admin_orders_filter_params),
                        class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <% if @pagy.pages > 1 %>
      <nav class="mt-5 flex flex-wrap gap-2 text-sm items-center" aria-label="<%= t("admin.orders.pagination_aria") %>">
        <% if @pagy.previous %>
          <%= link_to t("actions.previous"), url_for(request.query_parameters.merge(page: @pagy.previous)),
                class: "px-4 py-2 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 font-medium text-gray-700 transition-colors" %>
        <% end %>
        <span class="text-gray-600 px-2 tabular-nums"><%= t("accounting.shared.pagination", page: @pagy.page, pages: @pagy.pages) %></span>
        <% if @pagy.next %>
          <%= link_to t("actions.next"), url_for(request.query_parameters.merge(page: @pagy.next)),
                class: "px-4 py-2 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 font-medium text-gray-700 transition-colors" %>
        <% end %>
      </nav>
    <% end %>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("admin.orders.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5">
        <% if @filtered %>
          <%= t("admin.orders.empty_description_filtered") %>
        <% else %>
          <%= t("admin.orders.empty_description") %>
        <% end %>
      </p>
      <div class="flex flex-wrap justify-center gap-3 text-sm">
        <% if @filtered %>
          <%= link_to t("admin.orders.clear_filters"), admin_orders_path,
                class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
        <% if current_user.can_access_pos? %>
          <%= link_to t("admin.orders.open_pos"), pos_path,
                class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
