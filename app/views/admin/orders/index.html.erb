<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Orders</h1>
</div>

<div class="bg-white rounded-lg shadow p-4 mb-6">
  <%= search_form_for @q, url: admin_orders_path, method: :get, class: "space-y-4" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Day</label>
        <%= date_field_tag :date, @filter_date, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :user_id_eq, "Cashier", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :user_id_eq,
              options_from_collection_for_select(@cashiers, :id, :name, @q.user_id_eq),
              { include_blank: "All cashiers" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :customer_id_eq, "Customer", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :customer_id_eq,
              options_from_collection_for_select(@customers, :id, :display_name, @q.customer_id_eq),
              { include_blank: "All customers" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :status_eq, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq,
              options_for_select(Order::STATUSES.map { |s| [s.humanize, s] }, @q.status_eq),
              { include_blank: "All statuses" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :order_type_eq, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :order_type_eq,
              options_for_select(Order::ORDER_TYPES.map { |t| [t.humanize, t] }, @q.order_type_eq),
              { include_blank: "All types" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
    </div>
    <div class="flex flex-wrap gap-2 items-center">
      <%= f.submit "Filter", class: "bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-lg" %>
      <%= link_to "Clear", admin_orders_path, class: "text-gray-600 hover:underline px-2" %>
      <%= link_to "Today", admin_orders_path(date: Date.current), class: "text-amber-600 hover:underline px-2" %>
    </div>
  <% end %>
</div>

<% if @orders.any? %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 border-b text-gray-600">
        <tr>
          <th class="p-3 font-medium">Order</th>
          <th class="p-3 font-medium">Date / Time</th>
          <th class="p-3 font-medium">Cashier</th>
          <th class="p-3 font-medium">Customer</th>
          <th class="p-3 font-medium">Type</th>
          <th class="p-3 font-medium">Status</th>
          <th class="p-3 font-medium text-right">Total</th>
          <th class="p-3 font-medium"></th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @orders.each do |order| %>
          <tr class="hover:bg-gray-50">
            <td class="p-3 font-medium"><%= order.order_number %></td>
            <td class="p-3 text-gray-600"><%= order.created_at.strftime("%b %d, %Y %l:%M %p") %></td>
            <td class="p-3"><%= order.user.name %></td>
            <td class="p-3 text-gray-600">
              <% if order.customer %>
                <%= link_to order.customer.display_name, admin_customer_path(order.customer), class: "text-blue-600 hover:underline" %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="p-3">
              <span class="text-xs uppercase px-2 py-0.5 rounded <%= order_type_class(order.order_type) %>">
                <%= order.order_type_label %>
              </span>
            </td>
            <td class="p-3">
              <span class="text-xs uppercase px-2 py-0.5 rounded <%= order_status_class(order.status) %>">
                <%= order.status %>
              </span>
            </td>
            <td class="p-3 text-right font-medium"><%= format_money(order.total_cents) %></td>
            <td class="p-3 text-right">
              <%= link_to "View", admin_order_path(order, admin_orders_filter_params), class: "text-blue-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy.pages > 1 %>
    <nav class="mt-4 flex gap-2 text-sm items-center" aria-label="Pagination">
      <% if @pagy.previous %>
        <%= link_to "← Previous", url_for(request.query_parameters.merge(page: @pagy.previous)), class: "px-3 py-1 border rounded hover:bg-gray-100" %>
      <% end %>
      <span class="text-gray-600">Page <%= @pagy.page %> of <%= @pagy.pages %> (<%= @pagy.count %> orders)</span>
      <% if @pagy.next %>
        <%= link_to "Next →", url_for(request.query_parameters.merge(page: @pagy.next)), class: "px-3 py-1 border rounded hover:bg-gray-100" %>
      <% end %>
    </nav>
  <% else %>
    <p class="text-gray-500 text-sm mt-2"><%= @pagy.count %> order<%= @pagy.count == 1 ? "" : "s" %> found</p>
  <% end %>
<% else %>
  <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
    <p>No orders match these filters.</p>
    <%= link_to "Clear filters", admin_orders_path, class: "text-amber-600 hover:underline mt-2 inline-block" %>
  </div>
<% end %>
