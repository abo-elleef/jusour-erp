<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-6xl">
  <div class="mb-4">
    <%= link_to t("admin.orders.back_to_list"), admin_orders_path(admin_orders_filter_params), class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= @order.order_number %>
        <% if ENV["PRINT_DEBUG"] == "true" %>
          <%= link_to "🖨 Preview Print",
                admin_print_debug_path(order_id: @order.id),
                target: "_blank",
                class: "ml-3 text-sm font-medium text-blue-600 hover:text-blue-800 border border-blue-300 rounded-lg px-3 py-1 align-middle" %>
        <% end %>
      </h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("admin.orders.meta_line",
              datetime: "#{l(@order.created_at.to_date, format: :long)} #{l(@order.created_at, format: :short_time)}",
              cashier: @order.user.name) %>
        <% if @order.customer %>
          · <%= link_to @order.customer.display_name, admin_customer_path(@order.customer),
                class: "text-amber-700 hover:text-amber-800 font-medium" %>
        <% end %>
      </p>
    </div>
    <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full border <%= order_status_class(@order.status) %> <%= order_status_border_class(@order.status) %>">
      <%= order_status_label(@order.status) %>
    </span>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@order.total_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_items") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @order_items.size %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_paid") %></p>
      <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= format_money(@order.paid_cents) %></p>
    </div>
    <% if @order.amount_due_cents.positive? %>
      <div class="rounded-2xl border border-amber-200 bg-amber-50/40 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("admin.orders.stats_due") %></p>
        <p class="text-2xl font-bold mt-1 text-amber-700 tabular-nums"><%= format_money(@order.amount_due_cents) %></p>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.orders.line_items") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.orders.item_count", count: @order_items.size) %></p>
        </div>
        <div class="divide-y divide-gray-100">
          <% @order_items.each do |item| %>
            <div class="px-5 py-4 flex justify-between gap-4 hover:bg-gray-50/60 transition-colors">
              <div class="min-w-0">
                <p class="font-semibold text-gray-900">
                  <%= item.quantity %>× <%= item.display_name %>
                </p>
                <% item.order_item_modifiers.each do |mod| %>
                  <p class="text-xs text-gray-500 mt-0.5">+ <%= mod.name %></p>
                <% end %>
                <% if item.notes.present? %>
                  <p class="text-xs text-amber-800 mt-1.5 bg-amber-50 border border-amber-100 rounded-lg px-2 py-1 inline-block">
                    <%= t("admin.orders.item_note") %> <%= item.notes %>
                  </p>
                <% end %>
              </div>
              <p class="font-semibold text-gray-900 tabular-nums shrink-0"><%= format_money(item.line_total_cents) %></p>
            </div>
          <% end %>
        </div>
      </section>

      <% if @payments.any? %>
        <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
            <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.orders.payments_heading") %></h2>
            <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.orders.transaction_count", count: @payments.size) %></p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                <tr>
                  <th class="p-3 pl-5"><%= t("admin.orders.payment_method") %></th>
                  <th class="p-3"><%= t("admin.orders.payment_status") %></th>
                  <th class="p-3"><%= t("admin.orders.processed_by") %></th>
                  <th class="p-3 pr-5 text-right"><%= t("admin.orders.amount") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @payments.each do |payment| %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="p-3 pl-5 font-medium text-gray-900"><%= payment_method_label(payment.payment_method) %></td>
                    <td class="p-3">
                      <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= payment_status_class(payment.status) %> <%= payment_status_border_class(payment.status) %>">
                        <%= payment_status_label(payment.status) %>
                      </span>
                    </td>
                    <td class="p-3 text-gray-600 text-sm">
                      <%= payment.processed_by_user&.name || t("accounting.shared.em_dash") %>
                    </td>
                    <td class="p-3 pr-5 text-right font-semibold tabular-nums"><%= format_money(payment.amount_cents) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>

    <div class="space-y-6">
      <%# ── Order details ──────────────────────────────────────────────── %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.orders.order_details") %></h2>
        </div>
        <dl class="p-5 space-y-3 text-sm">
          <div class="flex justify-between gap-2">
            <dt class="text-gray-500 shrink-0"><%= t("order.labels.order_type") %></dt>
            <dd class="font-medium text-gray-900 text-right">
              <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= order_type_class(@order.order_type) %> <%= order_type_border_class(@order.order_type) %>">
                <%= @order.order_type_label %>
              </span>
            </dd>
          </div>
          <% if @order.table? && @order.table_number.present? %>
            <div class="flex justify-between gap-2">
              <dt class="text-gray-500 shrink-0"><%= t("order.labels.table_number") %></dt>
              <dd class="font-medium text-gray-900"><%= @order.table_number %></dd>
            </div>
          <% end %>
          <% if @order.delivery? %>
            <div class="flex flex-col gap-1">
              <dt class="text-gray-500"><%= t("order.labels.delivery_address") %></dt>
              <dd class="font-medium text-gray-900 bg-gray-50 rounded-xl px-3 py-2 text-xs leading-relaxed">
                <%= @order.delivery_address.present? ? @order.delivery_address : tag.span("—", class: "text-gray-400") %>
              </dd>
            </div>
          <% end %>
          <% if @order.notes.present? %>
            <div class="flex flex-col gap-1">
              <dt class="text-gray-500"><%= t("admin.orders.order_note") %></dt>
              <dd class="text-amber-900 bg-amber-50 border border-amber-100 rounded-xl px-3 py-2 text-xs leading-relaxed italic">
                <%= @order.notes %>
              </dd>
            </div>
          <% end %>
          <div class="flex justify-between gap-2">
            <dt class="text-gray-500 shrink-0"><%= t("admin.orders.cashier") %></dt>
            <dd class="font-medium text-gray-900"><%= @order.user.name %></dd>
          </div>
          <% if @order.location.present? %>
            <div class="flex justify-between gap-2">
              <dt class="text-gray-500 shrink-0"><%= t("order.labels.location") %></dt>
              <dd class="font-medium text-gray-900"><%= @order.location.name %></dd>
            </div>
          <% end %>
        </dl>
      </section>

      <%# ── Customer ───────────────────────────────────────────────────── %>
      <% if @order.customer %>
        <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-gray-900"><%= t("order.labels.customer") %></h2>
            <%= link_to t("actions.view"), admin_customer_path(@order.customer),
                  class: "text-xs font-medium text-amber-700 hover:text-amber-800" %>
          </div>
          <div class="p-5 space-y-2 text-sm">
            <p class="font-semibold text-gray-900"><%= @order.customer.display_name %></p>
            <% @order.customer.contact_phones.each do |phone| %>
              <p class="text-gray-600 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <%= phone %>
              </p>
            <% end %>
            <% if @order.customer.email.present? %>
              <p class="text-gray-600 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <%= @order.customer.email %>
              </p>
            <% end %>
            <% if @order.customer.loyalty_points.positive? %>
              <p class="text-xs font-semibold text-amber-700 mt-1">
                <%= customer_loyalty_points_label(@order.customer.loyalty_points) %>
              </p>
            <% end %>
            <% saved = @order.customer.addresses.ordered.to_a %>
            <% if saved.any? %>
              <div class="pt-2 border-t border-gray-100 mt-2 space-y-1.5">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("customers.addresses.title") %></p>
                <% saved.each do |addr| %>
                  <div class="text-xs text-gray-600 bg-gray-50 rounded-xl px-3 py-2 leading-relaxed">
                    <% if addr.label.present? %>
                      <span class="font-medium text-gray-800"><%= addr.label %> · </span>
                    <% end %>
                    <%= addr.address %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# ── Order total ─────────────────────────────────────────────────── %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.orders.order_total") %></h2>
        </div>
        <div class="p-5 space-y-3 text-sm">
          <div class="flex justify-between text-gray-600">
            <span><%= t("order.labels.subtotal") %></span>
            <span class="tabular-nums"><%= format_money(@order.subtotal_cents) %></span>
          </div>
          <% if @order.discount_cents.positive? %>
            <div class="flex justify-between text-green-700">
              <span><%= t("order.labels.discount") %></span>
              <span class="tabular-nums">-<%= format_money(@order.discount_cents) %></span>
            </div>
          <% end %>
          <div class="flex justify-between text-gray-600">
            <span><%= t("order.labels.tax") %></span>
            <span class="tabular-nums"><%= format_money(@order.tax_cents) %></span>
          </div>
          <% if @order.tip_cents.positive? %>
            <div class="flex justify-between text-gray-600">
              <span><%= t("order.labels.tip") %></span>
              <span class="tabular-nums"><%= format_money(@order.tip_cents) %></span>
            </div>
          <% end %>
          <div class="flex justify-between font-bold text-lg text-gray-900 pt-3 border-t border-gray-100">
            <span><%= t("order.labels.total") %></span>
            <span class="tabular-nums"><%= format_money(@order.total_cents) %></span>
          </div>
          <div class="pt-2 border-t border-gray-100">
            <%= order_payment_summary(@order) %>
          </div>
        </div>
      </section>

      <% if policy(@order).void? %>
        <section class="rounded-2xl border border-red-200 bg-red-50/30 overflow-hidden">
          <div class="px-5 py-4 border-b border-red-100 bg-red-50/80">
            <h2 class="text-sm font-semibold text-red-900"><%= t("admin.orders.void_heading") %></h2>
            <p class="text-xs text-red-800/80 mt-0.5"><%= t("admin.orders.void_hint") %></p>
          </div>
          <div class="p-5">
            <%= form_with url: void_admin_order_path(@order), method: :post, class: "space-y-4" do %>
              <div>
                <%= label_tag :reason, t("admin.orders.void_reason"), class: label_class %>
                <%= text_field_tag :reason, nil, placeholder: t("admin.orders.void_reason_placeholder"), class: input_class %>
              </div>
              <%= submit_tag t("admin.orders.void_submit"),
                    class: "w-full bg-red-700 hover:bg-red-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors",
                    data: { turbo_confirm: t("admin.orders.void_confirm") } %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if policy(@order).refund? %>
        <section class="rounded-2xl border border-amber-200 bg-amber-50/30 overflow-hidden">
          <div class="px-5 py-4 border-b border-amber-100 bg-amber-50/80">
            <h2 class="text-sm font-semibold text-amber-900"><%= t("admin.orders.refund_heading") %></h2>
            <p class="text-xs text-amber-800/80 mt-0.5"><%= t("admin.orders.refund_hint") %></p>
          </div>
          <div class="p-5">
            <%= form_with url: refund_admin_order_path(@order), method: :post, class: "space-y-4" do %>
              <div>
                <%= label_tag :amount_pounds, t("admin.orders.refund_amount"), class: label_class %>
                <%= number_field_tag :amount_pounds, (@order.total_cents / 100.0), min: 0, step: "0.01", class: input_class %>
                <p class="text-xs text-gray-500 mt-1.5"><%= t("admin.orders.refund_total_hint", amount: format_money(@order.total_cents)) %></p>
              </div>
              <div>
                <%= label_tag :reason, t("admin.orders.refund_reason"), class: label_class %>
                <%= text_field_tag :reason, nil, placeholder: t("admin.orders.refund_reason_placeholder"), class: input_class %>
              </div>
              <%= submit_tag t("admin.orders.refund_submit"),
                    class: "w-full bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors",
                    data: { turbo_confirm: t("admin.orders.refund_confirm") } %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @order_events.any? %>
        <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
            <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.orders.activity") %></h2>
            <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.orders.activity_hint") %></p>
          </div>
          <ul class="divide-y divide-gray-100">
            <% @order_events.each do |event| %>
              <li class="px-5 py-3 text-sm">
                <div class="flex justify-between gap-2">
                  <span class="font-semibold text-gray-900"><%= order_event_type_label(event.event_type) %></span>
                  <span class="text-xs text-gray-500 shrink-0"><%= l(event.created_at.to_date, format: :short) %> · <%= l(event.created_at, format: :short_time) %></span>
                </div>
                <% if event.user %>
                  <p class="text-xs text-gray-500 mt-0.5"><%= event.user.name %></p>
                <% end %>
                <% if event.description.present? %>
                  <p class="text-gray-600 mt-1"><%= event.description %></p>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>
</div>
