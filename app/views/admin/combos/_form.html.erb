<%# locals: combo %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, combo], class: "space-y-6 max-w-3xl" do |f| %>
  <% if combo.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= combo.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.combos.form_details_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.combos.form_details_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("admin.combos.name"), class: label_class %>
        <%= f.text_field :name, class: input_class, autofocus: true %>
      </div>
      <div>
        <%= f.label :description, t("admin.combos.field_description"), class: label_class %>
        <%= f.text_area :description, rows: 2, class: "#{input_class} resize-y min-h-[4rem]" %>
      </div>
      <div>
        <%= f.label :price_pounds, t("admin.combos.price"), class: label_class %>
        <%= f.number_field :price_pounds, min: 0, step: "0.01", class: input_class %>
      </div>
      <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :active, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("admin.combos.active_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("admin.combos.active_hint") %></span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("admin.combos.included_items_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.combos.included_items_hint") %></p>
    </div>
    <div class="divide-y divide-gray-100">
      <div class="hidden md:grid md:grid-cols-12 gap-3 px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide bg-white">
        <div class="md:col-span-8"><%= t("admin.combos.menu_item") %></div>
        <div class="md:col-span-2"><%= t("admin.combos.quantity") %></div>
        <div class="md:col-span-2"></div>
      </div>
      <%= f.fields_for :combo_items do |ci| %>
        <div class="px-5 py-4 md:py-3 md:grid md:grid-cols-12 md:gap-3 md:items-end space-y-3 md:space-y-0">
          <div class="md:col-span-8">
            <span class="md:hidden text-xs font-semibold text-gray-600 mb-1.5 block"><%= t("admin.combos.menu_item") %></span>
            <%= ci.collection_select :menu_item_id, @menu_items, :id, :name,
                  { prompt: t("admin.combos.select_menu_item") },
                  class: "#{input_class} appearance-none" %>
          </div>
          <div class="md:col-span-2">
            <span class="md:hidden text-xs font-semibold text-gray-600 mb-1.5 block"><%= t("admin.combos.quantity") %></span>
            <%= ci.number_field :quantity, min: 1, value: ci.object.quantity.presence || 1,
                  class: input_class %>
          </div>
          <div class="md:col-span-2 flex md:justify-end">
            <% unless ci.object.new_record? %>
              <label class="inline-flex items-center gap-2 text-xs font-medium text-red-700 hover:bg-red-50 rounded-xl px-3 py-2 cursor-pointer transition-colors">
                <%= ci.check_box :_destroy, class: "rounded border-gray-300 text-red-600 focus:ring-red-500/40" %>
                <span><%= t("admin.combos.remove") %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit combo.persisted? ? t("actions.save_changes") : t("admin.combos.create_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"), admin_combos_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
