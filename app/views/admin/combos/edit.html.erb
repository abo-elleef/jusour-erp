<div class="max-w-3xl">
  <div class="mb-4">
    <%= link_to t("admin.combos.back_to_list"), admin_combos_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title("edit") %>: <%= @combo.name %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("admin.combos.items_in_combo", count: @combo.combo_items.size) %> · <%= format_money(@combo.price_cents) %>
      </p>
    </div>
    <% if @combo.active? %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
        <%= t("admin.combos.active") %>
      </span>
    <% else %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
        <%= t("admin.combos.inactive") %>
      </span>
    <% end %>
  </div>

  <%= render "admin/menu_nav", flush: false %>
  <%= render "form", combo: @combo %>
</div>
