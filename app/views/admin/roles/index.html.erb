<%= render "admin/settings/nav" %>

<div class="max-w-4xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("roles.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("roles.description") %></p>
    </div>
    <%= link_to new_admin_role_path,
          class: "inline-flex items-center gap-2 bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("roles.new_button") %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("roles.name") %></th>
            <th class="p-3 text-end"><%= t("roles.permissions") %></th>
            <th class="p-3 text-end"><%= t("roles.staff") %></th>
            <th class="p-3 pe-5 text-end"><%= t("customers.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @roles.each do |role| %>
            <% user_count = @user_counts[role.id].to_i %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5">
                <span class="font-semibold text-gray-900"><%= role.name %></span>
                <% if role.built_in? %>
                  <span class="ms-2 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full"><%= t("roles.built_in") %></span>
                <% end %>
              </td>
              <td class="p-3 text-end tabular-nums text-gray-600"><%= role.permission_keys.size %></td>
              <td class="p-3 text-end tabular-nums text-gray-600"><%= user_count %></td>
              <td class="p-3 pe-5 text-end whitespace-nowrap">
                <%= link_to t("actions.edit"), edit_admin_role_path(role),
                      class: "text-xs font-semibold text-amber-700 hover:text-amber-800 me-3" %>
                <% if !role.built_in? && user_count.zero? %>
                  <%= button_to t("actions.delete"), admin_role_path(role), method: :delete,
                        class: "text-xs font-semibold text-red-700 hover:text-red-800 inline",
                        form: { data: { turbo_confirm: t("roles.delete_confirm") }, class: "inline" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
