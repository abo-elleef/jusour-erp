<%# locals: f (address fields builder) %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="rounded-xl border border-gray-200 bg-gray-50/80 p-4 mb-3 last:mb-0"
     data-customer-addresses-target="row">
  <%= f.hidden_field :_destroy, value: false, data: { customer_addresses_target: "destroy" } %>
  <%= f.hidden_field :id %>
  <div class="flex justify-between items-start gap-2 mb-3">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("customers.addresses.entry") %></p>
    <button type="button"
            class="text-xs font-semibold text-red-700 hover:text-red-800"
            data-action="customer-addresses#remove">
      <%= t("actions.remove") %>
    </button>
  </div>
  <div class="space-y-3">
    <div>
      <%= f.label :label, t("customers.addresses.label"), class: label_class %>
      <%= f.text_field :label, class: pos_input_class, placeholder: t("customers.addresses.label_placeholder") %>
    </div>
    <div>
      <%= f.label :address, t("customers.addresses.address"), class: label_class %>
      <%= f.text_area :address, rows: 2, class: pos_input_class, required: true %>
    </div>
    <label class="inline-flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
      <%= f.check_box :is_default, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/30" %>
      <%= t("customers.addresses.default") %>
    </label>
  </div>
</div>
