<% if @orders.any? %>
  <%# Sorting keeps the tab (and any other params) but starts again at page 1. %>
  <% sort_opts = { sort: @orders_sort, direction: @orders_direction,
                   base_params: request.query_parameters.except("page", "sort", "dir") } %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[1080px]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("order.labels.order_number") %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("customers.show.order_date"), :date, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("customers.show.order_location"), :location, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("customers.show.order_type"), :order_type, **sort_opts) %></th>
              <th class="p-3 text-end"><%= sort_header_link(t("customers.show.order_items"), :items, **sort_opts) %></th>
              <th class="p-3 text-end"><%= sort_header_link(t("customers.show.order_discount"), :discount, **sort_opts) %></th>
              <th class="p-3 text-end"><%= sort_header_link(t("order.labels.total"), :total, **sort_opts) %></th>
              <th class="p-3 text-start"><%= t("customers.show.order_payment") %></th>
              <th class="p-3 pe-5 text-start"><%= sort_header_link(t("order.labels.status"), :status, **sort_opts) %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @orders.each do |o| %>
              <% at = o.placed_at || o.created_at %>
              <tr class="hover:bg-gray-100 transition-colors align-top">
                <td class="p-3 ps-5 font-medium whitespace-nowrap">
                  <% if policy(o).show? %>
                    <%= link_to o.display_number, admin_order_path(o), data: { turbo_frame: "_top" },
                          class: "font-semibold text-amber-700 hover:text-amber-800" %>
                  <% else %>
                    <%= o.display_number %>
                  <% end %>
                </td>
                <td class="p-3 text-gray-600 whitespace-nowrap">
                  <%= l(at.to_date, format: :long) %>
                  <span class="text-gray-400 block text-xs"><%= l(at, format: :short_time) %></span>
                </td>
                <td class="p-3 text-gray-700 whitespace-nowrap">
                  <% if o.location %>
                    <%= link_to o.location.name, admin_location_path(o.location), data: { turbo_frame: "_top" },
                          class: "hover:text-gray-900 hover:underline" %>
                  <% else %>
                    <span class="text-gray-400"><%= t("customers.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3 max-w-xs">
                  <span class="text-xs uppercase font-semibold px-2.5 py-1 rounded-full <%= order_type_class(o.order_type) %>">
                    <%= o.order_type_label %>
                  </span>
                  <% if o.source.in?(%w[online call_center]) %>
                    <span class="ms-1 text-xs uppercase font-semibold px-2.5 py-1 rounded-full bg-sky-100 text-sky-800"><%= t("order.sources.#{o.source}") %></span>
                  <% end %>
                  <div class="text-xs text-gray-600 mt-1.5 space-y-0.5">
                    <% if o.order_type == "table" && o.table_number.present? %>
                      <div><%= t("customers.show.order_table", number: o.table_number) %></div>
                    <% end %>
                    <% if o.order_type == "delivery" %>
                      <% if o.delivery_address.present? %>
                        <div class="whitespace-pre-line"><%= o.delivery_address %></div>
                      <% end %>
                      <div class="text-gray-500">
                        <%= [o.delivery_area&.display_name,
                             (t("customers.show.order_delivery_fee", amount: format_amount(o.delivery_fee_cents)) if o.delivery_fee_cents.to_i.positive?)]
                              .compact.join(" · ") %>
                      </div>
                    <% end %>
                    <% if o.notes.present? %>
                      <div class="text-gray-500 italic">“<%= o.notes %>”</div>
                    <% end %>
                  </div>
                </td>
                <td class="p-3 text-end text-gray-600 tabular-nums"><%= o.order_items.size %></td>
                <td class="p-3 text-end tabular-nums">
                  <% if o.discount_cents.to_i.positive? %>
                    <span class="font-semibold text-green-700 whitespace-nowrap">-<%= format_amount(o.discount_cents) %></span>
                    <% names = o.order_discounts.map(&:description).compact_blank.uniq %>
                    <% if names.any? %>
                      <span class="block text-xs text-gray-500"><%= names.join(", ") %></span>
                    <% end %>
                  <% else %>
                    <span class="text-gray-400"><%= t("customers.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-end font-semibold text-gray-900 tabular-nums whitespace-nowrap"><%= format_amount(o.total_cents.to_i) %></td>
                <td class="p-3 text-xs">
                  <div class="text-gray-700"><%= order_payment_methods_label(o) %></div>
                  <%= order_payment_summary(o) %>
                </td>
                <td class="p-3 pe-5">
                  <span class="text-xs font-semibold px-2 py-1 rounded-lg <%= order_status_class(o.status) %>">
                    <%= order_status_label(o.status) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <%= render "admin/accounting/pagination", pagy: @orders_pagy %>
  </section>
<% else %>
  <p class="text-gray-500"><%= t("customers.show.no_orders") %></p>
<% end %>
