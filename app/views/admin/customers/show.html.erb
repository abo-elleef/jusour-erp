<% content_for :title, @customer.name.presence || t("customers.default_name") %>
<% stat_card_class = "rounded-2xl border border-gray-200 bg-white p-4" %>
<% action_btn_class = "text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= @customer.name.presence || t("customers.default_name") %>
      </h1>
      <p class="text-gray-600 mt-1 space-y-0.5">
        <% if @customer.legacy_code.present? %>
          <span class="block text-sm text-gray-500"><%= t("customers.show.legacy_code") %>: <span class="tabular-nums"><%= @customer.legacy_code %></span></span>
        <% end %>
        <% if ::Sales::OwnershipScope.applies_to?(Current.company) %>
          <span class="block text-sm text-gray-500"><%= t("customers.salesperson.label") %>:
            <% if @customer.assigned_user && policy(@customer.assigned_user).show? %>
              <%= link_to @customer.assigned_user.name, admin_user_path(@customer.assigned_user), class: "text-amber-700 hover:text-amber-800 font-medium" %>
            <% else %>
              <%= @customer.assigned_user&.name || t("customers.salesperson.none") %>
            <% end %>
          </span>
        <% end %>
        <% if @customer.email.present? %><span class="block"><%= @customer.email %></span><% end %>
        <% @customer.contact_phones.each do |num| %>
          <span class="block"><%= num %></span>
        <% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <%= link_to t("customers.back_to_list"), admin_customers_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
      <% if policy(@customer).update? %>
        <%= link_to t("actions.edit"), edit_admin_customer_path(@customer),
              class: "#{action_btn_class} bg-gray-900 hover:bg-gray-800 text-white" %>
      <% end %>
      <% if policy(@customer).destroy? %>
        <%= button_to t("actions.delete"), admin_customer_path(@customer), method: :delete,
              form: { data: { turbo_confirm: t("customers.delete_confirm_permanent") } },
              class: "#{action_btn_class} bg-red-600 hover:bg-red-700 text-white" %>
      <% end %>
    </div>
  </div>

  <% if @customer.blocked? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 mb-6 flex flex-wrap items-start justify-between gap-4">
      <div class="text-sm text-red-900">
        <p class="font-bold"><%= t("customers.block.blocked_heading") %></p>
        <p class="mt-1 whitespace-pre-wrap"><%= @customer.blocked_reason %></p>
        <p class="mt-1 text-xs text-red-700">
          <%= t("customers.block.blocked_by", name: @customer.blocked_by&.name || t("customers.shared.em_dash"),
                time: l(@customer.blocked_at, format: :short)) %>
        </p>
      </div>
      <% if policy(@customer).unblock? %>
        <%= button_to t("customers.block.unblock"), unblock_admin_customer_path(@customer), method: :post,
              form: { data: { turbo_confirm: t("customers.block.unblock_confirm") } },
              class: "#{action_btn_class} bg-white border border-red-300 text-red-800 hover:bg-red-100" %>
      <% end %>
    </div>
  <% elsif policy(@customer).block? %>
    <details class="rounded-2xl border border-gray-200 bg-white p-4 mb-6">
      <summary class="cursor-pointer text-sm font-semibold text-gray-700"><%= t("customers.block.block") %></summary>
      <p class="text-xs text-gray-500 mt-2"><%= t("customers.block.hint") %></p>
      <%= form_with url: block_admin_customer_path(@customer), method: :post, class: "mt-3 flex flex-wrap items-end gap-3",
            data: { turbo_confirm: t("customers.block.block_confirm") } do %>
        <div class="flex-1 min-w-[14rem]">
          <%= label_tag :blocked_reason, t("customers.block.reason"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= text_field_tag :blocked_reason, nil, required: true, maxlength: 500,
                class: "w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none" %>
        </div>
        <%= submit_tag t("customers.block.block"), name: nil,
              class: "#{action_btn_class} bg-red-600 hover:bg-red-700 text-white cursor-pointer" %>
      <% end %>
    </details>
  <% end %>

  <% if @online_request_counts.present? %>
    <div class="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 mb-6 flex flex-wrap items-center justify-between gap-3 text-sm text-sky-900">
      <p>
        <span class="font-semibold"><%= t("customers.online_orders.summary", count: @online_request_counts.values.sum) %></span>
        <% OnlineOrderRequest::STATUSES.each do |status| %>
          <% next unless @online_request_counts[status].to_i.positive? %>
          · <%= t("pos.online_orders.statuses.#{status}") %> <span class="tabular-nums"><%= @online_request_counts[status] %></span>
        <% end %>
      </p>
      <%= link_to t("customers.online_orders.view"), admin_online_order_requests_path(q: { customer_id_eq: @customer.id }),
            class: "font-semibold text-sky-800 hover:underline" %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <div class="<%= stat_card_class %>">
      <p class="text-sm text-gray-500"><%= t("customers.show.loyalty_balance") %></p>
      <p class="text-2xl font-bold text-amber-600 mt-1 tabular-nums"><%= customer_loyalty_points_label(@customer.loyalty_points) %></p>
    </div>
    <div class="<%= stat_card_class %>">
      <p class="text-sm text-gray-500"><%= t("customers.show.lifetime_spend") %></p>
      <p class="text-2xl font-bold mt-1 tabular-nums"><%= format_money(@customer.total_spent_cents) %></p>
    </div>
  </div>

  <%# The active tab loads lazily into this frame from the same URL — see
      CustomersController#show. Until it arrives, the placeholder holds the
      space so the page doesn't jump. %>
  <%= turbo_frame_tag Admin::CustomersController::TAB_FRAME,
        src: admin_customer_path(@customer, request.query_parameters),
        data: { turbo_action: "advance" } do %>
    <%= render "tab_nav", customer: @customer, tabs: @tabs, tab_counts: @tab_counts, active_tab: @tab %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-12 mt-6 text-center text-sm text-gray-500 animate-pulse">
      <%= t("customers.show.tabs.loading") %>
    </div>
  <% end %>
</div>
