<% content_for :title, @customer.name.presence || t("customers.default_name") %>
<% action_btn_class = "text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= @customer.name.presence || t("customers.default_name") %>
        <% if @customer.blocked? %>
          <span class="ms-2 align-middle text-xs font-semibold text-red-800 bg-red-50 border border-red-200 rounded-lg px-2 py-0.5">
            <%= t("customers.block.blocked_badge") %>
          </span>
        <% end %>
      </h1>
      <p class="text-gray-600 mt-1 space-y-0.5">
        <% if @customer.legacy_code.present? %>
          <span class="block text-sm text-gray-500"><%= t("customers.show.legacy_code") %>: <span class="tabular-nums"><%= @customer.legacy_code %></span></span>
        <% end %>
        <% if ::Sales::OwnershipScope.applies_to?(Current.company) %>
          <span class="block text-sm text-gray-500"><%= t("customers.salesperson.label") %>:
            <% if @customer.assigned_user && policy(@customer.assigned_user).show? %>
              <%= link_to @customer.assigned_user.name, admin_user_path(@customer.assigned_user), class: "text-amber-700 hover:text-amber-800 font-medium" %>
            <% else %>
              <%= @customer.assigned_user&.name || t("customers.salesperson.none") %>
            <% end %>
          </span>
        <% end %>
        <% if @customer.email.present? %><span class="block"><%= @customer.email %></span><% end %>
        <% @customer.contact_phones.each do |num| %>
          <span class="block"><%= num %></span>
        <% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <%= link_to t("customers.back_to_list"), admin_customers_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
      <% if policy(@customer).update? %>
        <%= link_to t("actions.edit"), edit_admin_customer_path(@customer),
              class: "#{action_btn_class} bg-gray-900 hover:bg-gray-800 text-white" %>
      <% end %>
      <% if policy(@customer).destroy? %>
        <%= button_to t("actions.delete"), admin_customer_path(@customer), method: :delete,
              form: { data: { turbo_confirm: t("customers.delete_confirm_permanent") } },
              class: "#{action_btn_class} bg-red-600 hover:bg-red-700 text-white" %>
      <% end %>
    </div>
  </div>

  <%# The active tab loads lazily into this frame from the same URL — see
      CustomersController#show. Until it arrives, the placeholder holds the
      space so the page doesn't jump. %>
  <%= turbo_frame_tag Admin::CustomersController::TAB_FRAME,
        src: admin_customer_path(@customer, request.query_parameters),
        data: { turbo_action: "advance" } do %>
    <%= render "tab_nav", customer: @customer, tabs: @tabs, tab_counts: @tab_counts, active_tab: @tab %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-12 mt-6 text-center text-sm text-gray-500 animate-pulse">
      <%= t("customers.show.tabs.loading") %>
    </div>
  <% end %>
</div>
