<%# Bazzar slice F: the customer's full history — where it came from (its lead),
    what was done with that lead, and what has happened since it became a customer.
    Only rendered where the distribution sales area exists. %>
<% card_head = "px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap items-baseline justify-between gap-2" %>
<% more_link = "text-sm font-semibold text-amber-700 hover:text-amber-800 hover:underline" %>

<% if @lead %>
  <section class="rounded-2xl border border-green-200 bg-green-50 p-4 mb-6" data-testid="customer-origin">
    <h2 class="text-sm font-semibold text-green-900"><%= t("customers.activities.origin.heading") %></h2>
    <dl class="mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-sm">
      <div>
        <dt class="text-xs text-green-700"><%= t("customers.activities.origin.lead") %></dt>
        <dd class="font-semibold text-gray-900">
          <% if @lead_linkable %>
            <%= link_to @lead.name, admin_sales_lead_path(@lead), class: "text-amber-700 hover:text-amber-800 hover:underline" %>
          <% else %>
            <%= @lead.name %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-green-700"><%= t("customers.activities.origin.created") %></dt>
        <dd class="text-gray-900"><%= l(@lead.created_at.to_date, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-xs text-green-700"><%= t("customers.activities.origin.converted") %></dt>
        <dd class="text-gray-900"><%= @lead.converted_at ? l(@lead.converted_at.to_date, format: :long) : t("customers.shared.em_dash") %></dd>
      </div>
      <div>
        <dt class="text-xs text-green-700"><%= t("customers.activities.origin.rep") %></dt>
        <dd class="text-gray-900">
          <% if @lead.assigned_user && policy(@lead.assigned_user).show? %>
            <%= link_to @lead.assigned_user.name, admin_user_path(@lead.assigned_user), class: "text-amber-700 hover:text-amber-800 hover:underline" %>
          <% else %>
            <%= @lead.assigned_user&.name || t("customers.shared.em_dash") %>
          <% end %>
        </dd>
      </div>
    </dl>
  </section>
<% end %>

<div class="grid grid-cols-1 <%= 'lg:grid-cols-2' if @lead %> gap-6 mb-8 items-start">
  <% if @lead %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden" id="lead-activities">
      <div class="<%= card_head %>">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("customers.activities.lead_heading") %></h2>
        <span class="text-xs text-gray-500"><%= t("customers.activities.read_only") %></span>
      </div>
      <%= turbo_frame_tag "lead-activities-list" do %>
        <ul class="divide-y divide-gray-100" data-testid="lead-activities">
          <% if @lead_activities.empty? %>
            <li class="p-8 text-center text-sm text-gray-500"><%= t("sales.leads.show.no_activity") %></li>
          <% else %>
            <%= render partial: "admin/sales/leads/activity", collection: @lead_activities, as: :activity, locals: { compact: true } %>
          <% end %>
        </ul>
        <% if @lead_activities_more %>
          <div class="px-5 py-3 border-t border-gray-100 text-center">
            <%= link_to t("customers.activities.show_all"),
                  admin_customer_path(@customer, lead_activities: "all", customer_activities: params[:customer_activities]),
                  class: more_link %>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden" id="customer-activities">
    <div class="<%= card_head %>">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("customers.activities.customer_heading") %></h2>
    </div>

    <% if @can_log_activity %>
      <div class="p-5 border-b border-gray-100 bg-gray-50/40">
        <%= form_with model: @activity, url: admin_customer_customer_activities_path(@customer),
              class: "flex flex-wrap items-start gap-2", data: { testid: "customer-activity-form" } do |f| %>
          <%= f.select :activity_type, CustomerActivity::LOGGABLE_TYPES.map { |t_| [t("sales.leads.activity_types.#{t_}"), t_] },
                {}, class: "rounded-xl border border-gray-200 px-3 py-2 text-sm" %>
          <%= f.text_field :note, placeholder: t("sales.leads.show.log_placeholder"), required: true,
                class: "flex-1 min-w-[12rem] rounded-xl border border-gray-200 px-3.5 py-2 text-sm" %>
          <%= f.submit t("sales.leads.show.log"),
                class: "px-4 py-2 text-sm font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-xl transition-colors cursor-pointer" %>
        <% end %>
      </div>
    <% end %>

    <%= turbo_frame_tag "customer-activities-list" do %>
      <ul class="divide-y divide-gray-100" data-testid="customer-activities">
        <% if @customer_activities.empty? %>
          <li class="p-8 text-center text-sm text-gray-500"><%= t("customers.activities.none") %></li>
        <% else %>
          <%= render partial: "admin/sales/leads/activity", collection: @customer_activities, as: :activity, locals: { compact: true } %>
        <% end %>
      </ul>
      <% if @customer_activities_more %>
        <div class="px-5 py-3 border-t border-gray-100 text-center">
          <%= link_to t("customers.activities.show_all"),
                admin_customer_path(@customer, customer_activities: "all", lead_activities: params[:lead_activities]),
                class: more_link %>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
