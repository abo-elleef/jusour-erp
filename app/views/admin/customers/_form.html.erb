<%# locals: customer %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, customer], class: "space-y-6 max-w-lg" do |f| %>
  <% if customer.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= customer.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("customers.form.contact_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("customers.form.contact_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("customers.form.name"), class: label_class %>
        <%= f.text_field :name, class: pos_input_class, autofocus: true %>
      </div>
      <div>
        <%= f.label :email, t("customers.form.email"), class: label_class %>
        <%= f.email_field :email, class: pos_input_class, autocomplete: "email" %>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :phone, t("customers.form.phone"), class: label_class %>
          <%= f.telephone_field :phone, class: pos_input_class, autocomplete: "tel" %>
        </div>
        <div>
          <%= f.label :phone_secondary, t("customers.form.phone_secondary"), class: label_class %>
          <%= f.telephone_field :phone_secondary, class: pos_input_class, autocomplete: "tel" %>
          <p class="text-xs text-gray-500 mt-1"><%= t("customers.form.phone_secondary_hint") %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden"
           data-controller="customer-addresses">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex justify-between items-center gap-2">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("customers.addresses.heading") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("customers.addresses.hint") %></p>
      </div>
      <button type="button"
              class="text-xs font-semibold text-amber-700 hover:text-amber-800 shrink-0"
              data-action="customer-addresses#add">
        <%= t("customers.addresses.add") %>
      </button>
    </div>
    <div class="p-5" data-customer-addresses-target="list">
      <%= f.fields_for :addresses do |af| %>
        <%= render "address_fields", f: af %>
      <% end %>
    </div>
    <template data-customer-addresses-target="template">
      <%= f.fields_for :addresses, CustomerAddress.new, child_index: "NEW_RECORD" do |af| %>
        <%= render "address_fields", f: af %>
      <% end %>
    </template>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit customer.persisted? ? t("customers.form.save") : t("customers.form.create"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"), customer.persisted? ? admin_customer_path(customer) : admin_customers_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
