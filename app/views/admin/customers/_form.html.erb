<%= form_with model: [:admin, customer], class: "bg-white rounded-lg shadow p-6 space-y-4 max-w-md" do |f| %>
  <% if customer.errors.any? %>
    <div class="text-red-700 bg-red-50 border border-red-200 rounded-lg p-3 text-sm">
      <%= customer.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
  </div>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
  </div>
  <div>
    <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
  </div>
  <div class="flex gap-3 pt-2">
    <%= f.submit class: "bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg font-medium" %>
    <%= link_to "Cancel", admin_customers_path, class: "px-4 py-2 text-gray-600 hover:underline" %>
  </div>
<% end %>
