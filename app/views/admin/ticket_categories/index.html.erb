<% content_for :title, t("tickets.categories.title") %>
<div class="max-w-4xl">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-4">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-gray-900"><%= t("tickets.categories.title") %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= t("tickets.categories.hint") %></p>
    </div>
    <%= link_to new_admin_ticket_category_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" do %>
      <span aria-hidden="true">+</span> <%= t("tickets.categories.new") %>
    <% end %>
  </div>

  <%# A handful of rows per company — no paging or filters needed. %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("tickets.categories.name_ar") %></th>
          <th class="p-3 text-start"><%= t("tickets.categories.name") %></th>
          <th class="p-3 text-start"><%= t("tickets.categories.default_handler") %></th>
          <th class="p-3 text-end"><%= t("tickets.categories.tickets") %></th>
          <th class="p-3 text-start"><%= t("tickets.categories.status") %></th>
          <th class="p-3 pe-5"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @categories.each do |category| %>
          <tr class="hover:bg-gray-100 transition-colors <%= 'text-gray-400' unless category.active? %>">
            <td class="p-3 ps-5 font-medium"><%= category.name_ar.presence || t("sales.shared.em_dash") %></td>
            <td class="p-3"><%= category.name %></td>
            <td class="p-3">
              <% if category.default_handler %>
                <%= link_to category.default_handler.name, admin_user_path(category.default_handler), class: "text-amber-700 hover:underline" %>
              <% else %>
                <span class="text-gray-400"><%= t("tickets.categories.no_handler") %></span>
              <% end %>
            </td>
            <td class="p-3 text-end tabular-nums">
              <%= link_to @ticket_counts[category.id].to_i, admin_sales_tickets_path(category_id: category.id), class: "hover:underline" %>
            </td>
            <td class="p-3"><%= category.active? ? t("tickets.categories.active") : t("tickets.categories.inactive") %></td>
            <td class="p-3 pe-5 text-end whitespace-nowrap">
              <%= link_to t("actions.edit"), edit_admin_ticket_category_path(category), class: "text-sm font-semibold text-gray-700 hover:text-gray-900" %>
              <% if @ticket_counts[category.id].to_i.zero? %>
                <%= button_to t("actions.delete"), admin_ticket_category_path(category), method: :delete,
                      form: { class: "inline", data: { turbo_confirm: t("tickets.categories.delete_confirm") } },
                      class: "ms-3 text-sm font-semibold text-red-600 hover:text-red-700" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
