<%# Settings has no natural sub-groups (unlike Inventory/Accounting), so this
    is a flat module: expand, then pick a page directly — reuses the same
    module-level toggle as nested-nav, just with no group targets in the DOM. %>
<% items = settings_nav_items %>
<div class="flex flex-col gap-0.5"
     data-controller="nested-nav"
     data-nested-nav-key-value="settings"
     data-nested-nav-open-value="<%= in_settings_section? %>">
  <button type="button"
          data-nested-nav-module-button
          data-action="nested-nav#toggleModule"
          aria-expanded="<%= in_settings_section? %>"
          class="<%= admin_nav_link_class(in_settings_section?) %> w-full text-start">
    <%= admin_nav_icon(:settings) %>
    <span class="flex-1"><%= t("nav.settings") %></span>
    <svg data-nested-nav-target="moduleChevron"
         class="w-3.5 h-3.5 shrink-0 opacity-60 transition-transform <%= in_settings_section? ? "rotate-90" : (rtl? ? "rotate-180" : nil) %>"
         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <div data-nested-nav-target="modulePanel" class="<%= "hidden" unless in_settings_section? %> ms-2 border-s border-gray-700 ps-2 flex flex-col gap-0.5">
    <% items.each do |item| %>
      <% item_active = settings_nav_item_active?(item) %>
      <%= link_to item[:label], item[:path],
            class: "block py-1.5 px-2 rounded-lg text-sm transition-colors #{item_active ? "bg-gray-700 text-white" : "text-gray-300 hover:bg-gray-800 hover:text-white"}" %>
    <% end %>
  </div>
</div>
