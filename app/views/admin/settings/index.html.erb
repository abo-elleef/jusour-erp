<div class="max-w-2xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2"><%= t("settings.title") %></h1>
  <p class="text-gray-600 text-sm mb-6"><%= t("settings.description") %></p>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.loyalty") %></h2>
    </div>
    <div class="p-5">
      <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <%= label_tag :loyalty_redeem_threshold, t("settings.redeem_threshold"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= number_field_tag :loyalty_redeem_threshold, @loyalty_redeem_threshold, min: 1, class: pos_input_class %>
        </div>
        <%= submit_tag t("actions.save"), class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex justify-between items-center">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.tax_rates") %></h2>
    </div>
    <ul class="divide-y divide-gray-100">
      <% @tax_rates.each do |rate| %>
        <li class="px-5 py-3 flex justify-between text-sm">
          <span class="font-medium"><%= rate.name %></span>
          <span class="text-gray-600 tabular-nums"><%= rate.rate %>%</span>
        </li>
      <% end %>
      <% if @tax_rates.empty? %>
        <li class="px-5 py-6 text-sm text-gray-500"><%= t("settings.no_tax_rates") %></li>
      <% end %>
    </ul>
  </section>

  <section class="rounded-2xl border border-amber-200 bg-amber-50/40 p-5">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.quick_links") %></h2>
    <ul class="mt-2 space-y-1 text-sm">
      <li><%= link_to t("nav.printers"), admin_printers_path, class: "text-amber-700 font-semibold" %></li>
      <li><%= link_to t("accounting.expense_categories.title"), admin_accounting_expense_categories_path, class: "text-amber-700 font-semibold" %></li>
      <li><%= link_to t("nav.staff"), admin_users_path, class: "text-amber-700 font-semibold" %></li>
    </ul>
  </section>
</div>
