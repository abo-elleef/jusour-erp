
<div class="max-w-2xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2"><%= t("settings.title") %></h1>
  <p class="text-gray-600 text-sm mb-6"><%= t("settings.description") %></p>

  <% if current_user.owner? %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.operations.title") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("settings.operations.hint") %></p>
    </div>
    <div class="p-5 text-sm text-gray-700">
      <p><%= t("settings.operations.moved_to_business_days") %></p>
      <%= link_to t("accounting.nav.business_days"), admin_accounting_business_days_path,
            class: "inline-flex mt-3 text-sm font-semibold text-amber-700 hover:underline" %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.inventory.title") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("settings.inventory.hint") %></p>
    </div>
    <div class="p-5">
      <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do %>
        <label class="flex items-start gap-3">
          <%= hidden_field_tag :restrict_stock_transfers_to_source, "0" %>
          <%= check_box_tag :restrict_stock_transfers_to_source, "1", @restrict_stock_transfers_to_source,
                class: "mt-0.5 rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("settings.inventory.restrict_transfers") %></span>
            <span class="block text-xs text-gray-500 mt-1"><%= t("settings.inventory.restrict_transfers_hint") %></span>
          </span>
        </label>
        <%= submit_tag t("actions.save"), class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.loyalty") %></h2>
    </div>
    <div class="p-5">
      <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <%= label_tag :loyalty_redeem_threshold, t("settings.redeem_threshold"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= number_field_tag :loyalty_redeem_threshold, @loyalty_redeem_threshold, min: 1, class: pos_input_class %>
        </div>
        <%= submit_tag t("actions.save"), class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.printing.title") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("settings.printing.hint") %></p>
    </div>
    <div class="p-5">
      <%= form_with url: admin_settings_path, method: :patch, multipart: true, class: "space-y-4" do %>
        <div>
          <%= label_tag :print_routing, t("settings.printing.routing"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= select_tag :print_routing,
                options_for_select([
                  [t("settings.printing.routing_client"), Printing::Config::ROUTING_CLIENT],
                  [t("settings.printing.routing_server"), Printing::Config::ROUTING_SERVER]
                ], @print_routing),
                class: pos_input_class %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("settings.printing.routing_hint") %></p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= label_tag :print_agent_port, t("settings.printing.agent_port"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <%= number_field_tag :print_agent_port, @print_agent_port, min: 1, max: 65535, class: pos_input_class %>
          </div>
          <div>
            <%= label_tag :print_agent_token, t("settings.printing.agent_token"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <%= text_field_tag :print_agent_token, @print_agent_token, class: pos_input_class, autocomplete: "off" %>
          </div>
        </div>
        <p class="text-xs text-gray-500"><%= t("settings.printing.agent_install", port: @print_agent_port) %></p>
        <div>
          <%= label_tag :receipt_logo, t("settings.printing.receipt_logo"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= render "shared/receipt_logo_field", attachment: @receipt_logo,
                file_name: "receipt_logo", remove_name: "remove_receipt_logo" %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("settings.printing.receipt_logo_hint") %></p>
        </div>
        <div>
          <%= label_tag :receipt_footer_text, t("settings.printing.receipt_footer"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= text_area_tag :receipt_footer_text, @receipt_footer_text,
                rows: 3,
                placeholder: t("printing.receipt.thank_you"),
                class: pos_input_class + " resize-none" %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("settings.printing.receipt_footer_hint") %></p>
        </div>
        <%= submit_tag t("actions.save"), class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
      <% end %>
    </div>
  </section>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-3">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.tax_rates") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("settings.tax_rates_hint") %></p>
      </div>
      <% if current_user.owner? %>
        <%= link_to new_admin_tax_rate_path,
              class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-xl shadow-sm transition-colors shrink-0" do %>
          <span aria-hidden="true">+</span> <%= t("settings.add_tax_rate") %>
        <% end %>
      <% end %>
    </div>
    <% if @tax_rates.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("settings.tax_rate_form.name") %></th>
              <th class="p-3 text-start"><%= t("settings.tax_rate_form.category") %></th>
              <th class="p-3 text-end"><%= t("settings.tax_rate_form.rate_percent") %></th>
              <th class="p-3 text-start"><%= t("settings.tax_rate_form.active") %></th>
              <% if current_user.owner? %>
                <th class="p-3 pe-5 text-end"><%= t("customers.table.actions") %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @tax_rates.each do |rate| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5 font-semibold text-gray-900"><%= rate.name %></td>
                <td class="p-3 text-gray-600"><%= menu_item_tax_category(rate.tax_category) %></td>
                <td class="p-3 text-end tabular-nums font-semibold text-gray-900"><%= format_tax_rate_percent(rate) %>%</td>
                <td class="p-3">
                  <span class="text-xs font-semibold <%= rate.active? ? 'text-emerald-700' : 'text-gray-500' %>">
                    <%= rate.active? ? t("settings.tax_rate_form.active_yes") : t("settings.tax_rate_form.active_no") %>
                  </span>
                </td>
                <% if current_user.owner? %>
                  <td class="p-3 pe-5 text-end whitespace-nowrap">
                    <%= link_to t("actions.edit"), edit_admin_tax_rate_path(rate),
                          class: "text-xs font-semibold text-amber-700 hover:text-amber-800 me-3" %>
                    <%= button_to t("actions.delete"), admin_tax_rate_path(rate), method: :delete,
                          class: "text-xs font-semibold text-red-700 hover:text-red-800 inline",
                          form: { data: { turbo_confirm: t("settings.tax_rate_form.delete_confirm") }, class: "inline" } %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("settings.no_tax_rates") %></p>
    <% end %>
  </section>

  <section class="rounded-2xl border border-amber-200 bg-amber-50/40 p-5">
    <h2 class="text-sm font-semibold text-gray-900"><%= t("settings.quick_links") %></h2>
    <ul class="mt-2 space-y-1 text-sm">
      <li><%= link_to t("nav.printers"), admin_printers_path, class: "text-amber-700 font-semibold" %></li>
      <li><%= link_to t("accounting.expense_categories.title"), admin_accounting_expense_categories_path, class: "text-amber-700 font-semibold" %></li>
      <li><%= link_to t("nav.staff"), admin_users_path, class: "text-amber-700 font-semibold" %></li>
    </ul>
  </section>
</div>
