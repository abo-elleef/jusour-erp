<%# Sits flush against the top of <main>, so the layout drops its top padding.
    Pass flush: false where this nav renders below a page header. %>
<% content_for :flush_top, "1" unless local_assigns[:flush] == false %>
<nav class="mb-6 border-b border-gray-200" aria-label="<%= t("settings.title") %>">
  <div class="flex flex-wrap gap-x-1 -mb-px">
    <% if current_user.owner? || current_user.accountant? %>
      <%= link_to t("settings.nav.general"), admin_settings_path, class: admin_section_tab_class(controller_name == "settings") %>
      <%= link_to t("nav.staff"), admin_users_path, class: admin_section_tab_class(controller_name == "users") %>
    <% end %>
    <% if current_user.can_access_admin? %>
      <%= link_to t("nav.locations"), admin_locations_path, class: admin_section_tab_class(controller_name == "locations") %>
      <%= link_to t("nav.printers"), admin_printers_path, class: admin_section_tab_class(controller_name == "printers") %>
      <%= link_to t("nav.workstations"), admin_workstations_path, class: admin_section_tab_class(controller_name == "workstations") %>
    <% end %>
    <% if current_user.owner? %>
      <%= link_to t("settings.nav.roles"), admin_roles_path, class: admin_section_tab_class(controller_name == "roles") %>
      <%= link_to t("settings.nav.integrations"), admin_accounting_integrations_path, class: admin_section_tab_class(controller_name == "integrations") %>
      <%= link_to t("settings.nav.online_payments"), admin_accounting_payment_method_treasuries_path, class: admin_section_tab_class(controller_name == "payment_method_treasuries") %>
    <% end %>
  </div>
</nav>
