<%# locals: crumbs — [[label, path], ...], the pages above this one, outermost first.
    Rendered at the start of the page's <h1>: the way back costs no row of its own. %>
<% crumbs.each do |label, path| %>
  <%= link_to label, path, class: "text-base font-semibold text-gray-500 hover:text-amber-700 align-middle", data: { turbo_frame: "_top" } %>
  <span class="text-base font-normal text-gray-300 mx-1.5 align-middle" aria-hidden="true">/</span>
<% end %>
