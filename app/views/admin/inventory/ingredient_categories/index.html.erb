<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= render "admin/inventory/tools_nav" %>

<div class="max-w-3xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.ingredient_categories.description") %></p>
    </div>
    <%= link_to new_admin_inventory_ingredient_category_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("inventory.ingredient_categories.new_button") %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredient_categories.filters") %></h2>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_inventory_ingredient_categories_path, method: :get,
            class: "flex flex-wrap items-end gap-4" do |f| %>
        <div class="flex-1 min-w-[12rem]">
          <%= f.label :name_cont, t("inventory.ingredient_categories.name"), class: label_class %>
          <%= f.search_field :name_cont,
                placeholder: t("inventory.ingredient_categories.search_placeholder"),
                class: pos_input_class %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :active_eq, t("inventory.ingredient_categories.status"), class: label_class %>
          <%= f.select :active_eq,
                options_for_select(
                  [[t("inventory.ingredient_categories.all_statuses"), ""],
                   [t("inventory.ingredient_categories.active"), true],
                   [t("inventory.ingredient_categories.inactive"), false]],
                  @q.active_eq
                ),
                {},
                class: "#{pos_input_class} appearance-none" %>
        </div>
        <%= f.submit t("actions.apply_filters"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
        <% if @filtered %>
          <%= link_to t("actions.clear"), admin_inventory_ingredient_categories_path,
                class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
      <% end %>
    </div>
  </section>

  <% if @categories.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredient_categories.list_heading") %></h2>
        <p class="text-xs text-gray-500 mt-0.5">
          <% if @sortable %>
            <%= t("inventory.ingredient_categories.reorder_hint") %>
          <% else %>
            <%= t("inventory.ingredient_categories.reorder_disabled") %>
          <% end %>
        </p>
      </div>

      <ul class="divide-y divide-gray-100"
          <% if @sortable %>
            data-controller="sortable-list"
            data-sortable-list-url-value="<%= reorder_admin_inventory_ingredient_categories_path %>"
          <% end %>>
        <% @categories.each_with_index do |cat, index| %>
          <li class="group px-5 py-4 flex items-center gap-4 <%= "cursor-grab active:cursor-grabbing hover:bg-gray-50/60 transition-colors" if @sortable %>"
              <% if @sortable %>
                data-sortable-list-target="item"
                data-id="<%= cat.id %>"
              <% end %>>
            <% if @sortable %>
              <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-gray-100 text-gray-400 group-hover:bg-gray-200 group-hover:text-gray-600 transition-colors select-none shrink-0"
                    aria-hidden="true" title="<%= t("inventory.ingredient_categories.drag_handle") %>">⠿</span>
            <% end %>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-semibold text-gray-900"><%= cat.name %></span>
                <% if cat.active? %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200">
                    <%= t("inventory.ingredient_categories.active") %>
                  </span>
                <% else %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                    <%= t("inventory.ingredient_categories.inactive") %>
                  </span>
                <% end %>
              </div>
              <p class="text-xs text-gray-500 mt-1">
                <%= t("inventory.ingredient_categories.ingredient_count", count: cat.ingredients.size) %>
              </p>
            </div>
            <% if @sortable %>
              <span data-sortable-list-target="position"
                    class="text-xs font-semibold text-gray-500 tabular-nums px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200 shrink-0">
                #<%= index %>
              </span>
            <% end %>
            <div class="flex gap-2 shrink-0">
              <%= link_to t("actions.edit"), edit_admin_inventory_ingredient_category_path(cat),
                    class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
              <% if policy(cat).destroy? && cat.ingredients.none? %>
                <%= button_to t("actions.delete"), admin_inventory_ingredient_category_path(cat), method: :delete,
                      form: { data: { turbo_confirm: t("inventory.ingredient_categories.confirm_delete", name: cat.name) }, class: "inline" },
                      class: "inline-flex text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.ingredient_categories.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("inventory.ingredient_categories.empty_description") %></p>
      <%= link_to t("inventory.ingredient_categories.new_button"), new_admin_inventory_ingredient_category_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% end %>
</div>
