<%# locals: category %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: category,
      url: category.persisted? ? admin_inventory_ingredient_category_path(category) : admin_inventory_ingredient_categories_path,
      class: "space-y-6" do |f| %>
  <% if category.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= category.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden max-w-lg">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredient_categories.form_heading") %></h2>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("inventory.ingredient_categories.name"), class: label_class %>
        <%= f.text_field :name, class: input_class, autofocus: true, required: true %>
      </div>

      <div>
        <%= f.label :position, t("inventory.ingredient_categories.position"), class: label_class %>
        <%= f.number_field :position, min: 0, class: input_class %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredient_categories.position_hint") %></p>
      </div>

      <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :active, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("inventory.ingredient_categories.active_label") %></span>
            <span class="block text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredient_categories.active_hint") %></span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3 max-w-lg">
    <%= f.submit category.persisted? ? t("actions.save_changes") : t("inventory.ingredient_categories.create_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"), admin_inventory_ingredient_categories_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
