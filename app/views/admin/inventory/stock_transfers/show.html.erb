<% content_for :title, @stock_transfer.transfer_number %>
<%= render "admin/inventory/tools_nav" %>

<% status_label, status_class = stock_transfer_status_badge(@stock_transfer.status) %>

<div class="max-w-5xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6 print-hide">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @stock_transfer.transfer_number %></h1>
        <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= status_class %>"><%= status_label %></span>
      </div>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("inventory.stock_transfers.from_location") %>
        <%= link_to @stock_transfer.from_location.name, admin_location_path(@stock_transfer.from_location), class: "font-medium text-amber-700 hover:text-amber-800" %>
        →
        <%= t("inventory.stock_transfers.to_location") %>
        <%= link_to @stock_transfer.to_location.name, admin_location_path(@stock_transfer.to_location), class: "font-medium text-amber-700 hover:text-amber-800" %>
        ·
        <%= t("inventory.stock_transfers.transferred_on") %>
        <%= l(@stock_transfer.transferred_on, format: :long) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 print-hide">
      <button type="button" onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0 1 18 8.653v4.097A2.25 2.25 0 0 1 15.75 15h-.241l.305 1.984A1.75 1.75 0 0 1 14.084 19H5.916a1.75 1.75 0 0 1-1.73-2.016L4.491 15H4.25A2.25 2.25 0 0 1 2 12.75V8.653c0-1.082.775-2.034 1.874-2.198.374-.056.75-.107 1.126-.153V2.75Zm8.5 3.397a41.533 41.533 0 0 0-7 0V2.75a.25.25 0 0 1 .25-.25h6.5a.25.25 0 0 1 .25.25v3.397ZM6.608 12.5a.25.25 0 0 0-.247.212l-.693 4.5a.25.25 0 0 0 .247.288h8.168a.25.25 0 0 0 .247-.288l-.693-4.5a.25.25 0 0 0-.247-.212H6.608Z" clip-rule="evenodd" />
        </svg>
        <%= t("inventory.stock_transfers.print") %>
      </button>
      <% if @stock_transfer.editable? %>
        <%= link_to t("actions.edit"), edit_admin_inventory_stock_transfer_path(@stock_transfer),
              class: "inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
      <% end %>
      <% if @stock_transfer.can_submit? %>
        <%= button_to t("inventory.stock_transfers.submit_request"),
              submit_admin_inventory_stock_transfer_path(@stock_transfer),
              method: :post,
              class: "inline-flex bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors" %>
      <% end %>
      <% if @stock_transfer.discardable? %>
        <%# Drafts are destroyed outright; submitted transfers are cancelled so
            the audit trail survives. %>
        <%= button_to t("inventory.stock_transfers.discard_draft"),
              admin_inventory_stock_transfer_path(@stock_transfer),
              method: :delete,
              form: { data: { turbo_confirm: t("inventory.stock_transfers.discard_draft_confirm") } },
              class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors" %>
      <% elsif @stock_transfer.requested? %>
        <%= button_to t("inventory.stock_transfers.cancel"),
              cancel_admin_inventory_stock_transfer_path(@stock_transfer),
              method: :post,
              form: { data: { turbo_confirm: t("inventory.stock_transfers.cancel_confirm") } },
              class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors" %>
      <% end %>
    </div>
  </div>

  <% if @stock_transfer.notes.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4 mb-6 text-sm text-gray-700 print-hide">
      <%= simple_format(@stock_transfer.notes) %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6 print-hide">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_transfers.transferred_on") %></p>
      <p class="text-sm font-semibold mt-1 text-gray-900"><%= l(@stock_transfer.transferred_on, format: :long) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_transfers.requested_at") %></p>
      <p class="text-sm font-semibold mt-1 text-gray-900"><%= l(@stock_transfer.requested_at, format: :short) %></p>
      <p class="text-xs text-gray-500 mt-0.5"><%= @stock_transfer.requested_by.name %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_transfers.last_sent_at") %></p>
      <% if @stock_transfer.sent_at %>
        <p class="text-sm font-semibold mt-1 text-gray-900"><%= l(@stock_transfer.sent_at, format: :short) %></p>
        <p class="text-xs text-gray-500 mt-0.5"><%= @stock_transfer.sent_by&.name %></p>
      <% else %>
        <p class="text-sm text-gray-400 mt-1">—</p>
      <% end %>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_transfers.last_received_at") %></p>
      <% if @stock_transfer.received_at %>
        <p class="text-sm font-semibold mt-1 text-gray-900"><%= l(@stock_transfer.received_at, format: :short) %></p>
        <p class="text-xs text-gray-500 mt-0.5"><%= @stock_transfer.received_by&.name %></p>
      <% else %>
        <p class="text-sm text-gray-400 mt-1">—</p>
      <% end %>
    </div>
  </div>

  <% if @stock_transfer.can_send? %>
    <section class="rounded-2xl border border-amber-200 bg-amber-50/40 overflow-hidden mb-6 print-hide">
      <div class="px-5 py-4 border-b border-amber-100">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.send_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5">
          <%= @restrict_stock_transfers_to_source ? t("inventory.stock_transfers.send_partial_hint") : t("inventory.stock_transfers.send_unrestricted_hint") %>
        </p>
      </div>
      <%= form_with url: send_transfer_admin_inventory_stock_transfer_path(@stock_transfer), method: :post, class: "p-0" do %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-amber-100 bg-white/60 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
                <th class="p-3 text-start"><%= t("inventory.stock_transfers.ingredient") %></th>
                <th class="p-3 text-start"><%= t("inventory.stock_transfers.unit") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.quantity_requested") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.quantity_sent_total") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.quantity_received_total") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.quantity_pending_send") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.available_at_source") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.send_now") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-amber-100/80">
              <% pending_send_lines = @lines.reject { |l| l.quantity_pending_send.zero? } %>
              <% send_row_number = 0 %>
              <% group_records_by_ingredient_category(pending_send_lines).each do |category_name, lines| %>
                <%= render "category_header", name: category_name, count: lines.size, tag: :tr, colspan: 9 %>
                <% lines.each do |line| %>
                  <% send_row_number += 1 %>
                  <% short_at_source = line.short_at_source? %>
                  <tr class="<%= 'bg-red-50' if short_at_source %>" data-short-at-source="<%= short_at_source %>">
                    <% send_now_base = if @restrict_stock_transfers_to_source
                                         [line.quantity_pending_send, line.transferable_quantity_at_source].min
                                       else
                                         line.quantity_pending_send
                                       end %>
                    <td class="p-3 text-gray-400 tabular-nums"><%= send_row_number %></td>
                    <td class="p-3 font-medium text-gray-900">
                      <%= render "ingredient_name", ingredient: line.ingredient, category_name: category_name, link: true %>
                      <% if short_at_source %>
                        <span class="mt-1 inline-block text-xs font-semibold text-red-700"><%= t("inventory.stock_transfers.short_at_source") %></span>
                      <% end %>
                    </td>
                    <td class="p-3 text-gray-700"><%= transfer_line_unit_label(line) %></td>
                    <td class="p-3 text-end tabular-nums text-gray-700"><%= transfer_line_amount(line, line.quantity_requested) %></td>
                    <td class="p-3 text-end tabular-nums text-gray-600"><%= transfer_line_amount(line, line.quantity_sent) %></td>
                    <td class="p-3 text-end tabular-nums text-gray-600"><%= transfer_line_amount(line, line.quantity_received) %></td>
                    <td class="p-3 text-end tabular-nums font-semibold text-amber-800"><%= transfer_line_amount(line, line.quantity_pending_send) %></td>
                    <td class="p-3 text-end tabular-nums <%= short_at_source ? 'font-semibold text-red-700' : 'text-gray-600' %>"><%= transfer_line_amount(line, line.transferable_quantity_at_source) %></td>
                    <td class="p-3 text-end">
                      <%= number_field_tag "lines[#{line.id}]",
                            number_with_precision(line.in_line_unit(send_now_base), precision: 3, strip_insignificant_zeros: true),
                            step: 0.001, min: 0,
                            **(@restrict_stock_transfers_to_source ? { max: line.in_line_unit(send_now_base) } : {}),
                            class: "#{pos_input_class} w-28 text-end ms-auto" %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="px-5 py-4 border-t border-amber-100">
          <%= submit_tag t("inventory.stock_transfers.mark_sent"), class: "bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-xl text-sm font-semibold" %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @stock_transfer.can_confirm_receipt? && @current_shipment %>
    <section class="rounded-2xl border border-emerald-200 bg-emerald-50/40 overflow-hidden mb-6 print-hide">
      <div class="px-5 py-4 border-b border-emerald-100">
        <h2 class="text-sm font-semibold text-gray-900">
          <%= t("inventory.stock_transfers.confirm_heading") %>
          <span class="text-gray-500 font-normal">— <%= t("inventory.stock_transfers.shipment_number", number: @current_shipment.sequence) %></span>
        </h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.stock_transfers.confirm_partial_hint") %></p>
      </div>
      <%= form_with url: confirm_receipt_admin_inventory_stock_transfer_path(@stock_transfer), method: :post, class: "p-0" do %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-emerald-100 bg-white/60 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
                <th class="p-3 text-start"><%= t("inventory.stock_transfers.ingredient") %></th>
                <th class="p-3 text-start"><%= t("inventory.stock_transfers.unit") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.quantity_sent_this_shipment") %></th>
                <th class="p-3 text-end"><%= t("inventory.stock_transfers.quantity_received") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-emerald-100/80">
              <% confirm_row_number = 0 %>
              <% group_records_by_ingredient_category(@current_shipment.stock_transfer_shipment_lines).each do |category_name, shipment_lines| %>
                <%= render "category_header", name: category_name, count: shipment_lines.size, tag: :tr, colspan: 5 %>
                <% shipment_lines.each do |shipment_line| %>
                  <% confirm_row_number += 1 %>
                  <% line = shipment_line.stock_transfer_line %>
                  <tr>
                    <td class="p-3 text-gray-400 tabular-nums"><%= confirm_row_number %></td>
                    <td class="p-3 font-medium text-gray-900">
                      <%= render "ingredient_name", ingredient: line.ingredient, category_name: category_name, link: true %>
                    </td>
                    <td class="p-3 text-gray-700"><%= transfer_line_unit_label(line) %></td>
                    <td class="p-3 text-end tabular-nums text-gray-700"><%= transfer_line_amount(line, shipment_line.quantity_sent) %></td>
                    <td class="p-3 text-end">
                      <%= number_field_tag "lines[#{line.id}]",
                            number_with_precision(line.in_line_unit(shipment_line.quantity_sent), precision: 3, strip_insignificant_zeros: true),
                            step: 0.001, min: 0,
                            max: line.in_line_unit(shipment_line.quantity_sent),
                            class: "#{pos_input_class} w-28 text-end ms-auto" %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="px-5 py-4 border-t border-emerald-100 flex flex-wrap items-center gap-3">
          <%= submit_tag t("inventory.stock_transfers.confirm_receipt"), class: "bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl text-sm font-semibold" %>
          <%= button_to t("inventory.stock_transfers.void_shipment"),
                void_shipment_admin_inventory_stock_transfer_path(@stock_transfer),
                method: :post,
                form: { data: { turbo_confirm: t("inventory.stock_transfers.void_shipment_confirm", number: @current_shipment.sequence) }, class: "inline" },
                class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-5 py-2.5 rounded-xl border border-red-200 transition-colors" %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @shipments.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6 print-hide">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.shipment_history") %></h2>
      </div>
      <div class="divide-y divide-gray-100">
        <% @shipments.each do |shipment| %>
          <div class="px-5 py-4">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.shipment_number", number: shipment.sequence) %></span>
              <% ship_label, ship_class = stock_transfer_shipment_status_badge(shipment.status) %>
              <span class="text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full border <%= ship_class %>"><%= ship_label %></span>
              <span class="text-xs text-gray-500">
                <%= t("inventory.stock_transfers.shipment_sent_by", name: shipment.sent_by.name, at: l(shipment.sent_at, format: :short)) %>
                <% if shipment.received_at %>
                  · <%= t("inventory.stock_transfers.shipment_received_by", name: shipment.received_by.name, at: l(shipment.received_at, format: :short)) %>
                <% elsif shipment.voided_at %>
                  · <%= t("inventory.stock_transfers.shipment_voided_by", name: shipment.voided_by.name, at: l(shipment.voided_at, format: :short)) %>
                <% end %>
              </span>
            </div>
            <div class="overflow-auto max-h-[60vh] relative -mx-1">
              <table class="w-full text-sm">
                <thead class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
                  <tr>
                    <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm py-2 px-1 text-start w-12 text-gray-400 border-b border-gray-200"><%= t("shared.row_index") %></th>
                    <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm py-2 px-1 text-start border-b border-gray-200"><%= t("inventory.stock_transfers.ingredient") %></th>
                    <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm py-2 px-1 text-start border-b border-gray-200"><%= t("inventory.stock_transfers.unit") %></th>
                    <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm py-2 px-1 text-end border-b border-gray-200"><%= t("inventory.stock_transfers.quantity_sent") %></th>
                    <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm py-2 px-1 text-end border-b border-gray-200"><%= t("inventory.stock_transfers.quantity_received") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% history_row_number = 0 %>
                  <% group_records_by_ingredient_category(shipment.stock_transfer_shipment_lines).each do |category_name, shipment_lines| %>
                    <%= render "category_header", name: category_name, count: shipment_lines.size, tag: :tr, colspan: 5 %>
                    <% shipment_lines.each do |shipment_line| %>
                      <% history_row_number += 1 %>
                      <% ship_line = shipment_line.stock_transfer_line %>
                      <tr>
                        <td class="py-1 px-1 text-gray-400 tabular-nums"><%= history_row_number %></td>
                        <td class="py-1 px-1 text-gray-900">
                          <%= render "ingredient_name", ingredient: shipment_line.ingredient, category_name: category_name, link: true %>
                        </td>
                        <td class="py-1 px-1 text-gray-700"><%= transfer_line_unit_label(ship_line) %></td>
                        <td class="py-1 px-1 text-end tabular-nums"><%= transfer_line_amount(ship_line, shipment_line.quantity_sent) %></td>
                        <td class="py-1 px-1 text-end tabular-nums text-gray-600">
                          <%= shipment_line.quantity_received ? transfer_line_amount(ship_line, shipment_line.quantity_received) : "—" %>
                        </td>
                      </tr>
                    <% end %>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% grouped_view = params[:grouped] == "1" %>
  <% display_lines = grouped_view ? group_records_by_ingredient_category(@lines) : [[nil, @lines.sort_by(&:position)]] %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden print-hide">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.line_items") %></h2>
      <div class="flex items-center gap-1 print-hide">
        <%= link_to t("inventory.stock_transfers.flat_list"),
              admin_inventory_stock_transfer_path(@stock_transfer),
              class: "text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors #{grouped_view ? 'border-gray-200 text-gray-600 hover:bg-gray-50' : 'border-amber-500 bg-amber-50 text-amber-800'}" %>
        <%= link_to t("inventory.stock_transfers.group_by_category"),
              admin_inventory_stock_transfer_path(@stock_transfer, grouped: 1),
              class: "text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors #{grouped_view ? 'border-amber-500 bg-amber-50 text-amber-800' : 'border-gray-200 text-gray-600 hover:bg-gray-50'}" %>
      </div>
    </div>
    <div class="overflow-auto max-h-[60vh] relative">
      <table class="w-full text-sm">
        <thead class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-start w-12 text-gray-400 border-b border-gray-200"><%= t("shared.row_index") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-start border-b border-gray-200"><%= t("inventory.stock_transfers.ingredient") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-start border-b border-gray-200"><%= t("inventory.stock_transfers.unit") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-end border-b border-gray-200"><%= t("inventory.stock_transfers.order_limit") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-end border-b border-gray-200"><%= t("inventory.stock_transfers.counted_quantity") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-end border-b border-gray-200"><%= t("inventory.stock_transfers.quantity_requested") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-end print-hide border-b border-gray-200"><%= t("inventory.stock_transfers.quantity_sent_total") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-end print-hide border-b border-gray-200"><%= t("inventory.stock_transfers.quantity_received_total") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-end print-hide border-b border-gray-200"><%= t("inventory.stock_transfers.quantity_in_transit") %></th>
            <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-end print-hide border-b border-gray-200"><%= t("inventory.stock_transfers.quantity_pending_send") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% progress_row_number = 0 %>
          <% display_lines.each do |category_name, lines| %>
            <%= render "category_header", name: category_name, count: lines.size, tag: :tr, colspan: 10 if category_name %>
            <% lines.each do |line| %>
              <% progress_row_number += 1 %>
              <% short_at_source = line.short_at_source? %>
              <tr class="<%= 'bg-red-50 print:bg-transparent' if short_at_source %>" data-short-at-source="<%= short_at_source %>">
                <td class="p-3 text-gray-400 tabular-nums"><%= progress_row_number %></td>
                <td class="p-3 font-medium text-gray-900">
                  <%= render "ingredient_name", ingredient: line.ingredient, category_name: category_name, link: true %>
                  <% if short_at_source %>
                    <span class="mt-1 inline-block text-xs font-semibold text-red-700 print-hide"><%= t("inventory.stock_transfers.short_at_source") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-gray-700"><%= transfer_line_unit_label(line) %></td>
                <td class="p-3 text-end tabular-nums text-gray-700">
                  <%= number_with_precision(line.order_limit, precision: 3, strip_insignificant_zeros: true).presence || "—" %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700">
                  <%= number_with_precision(line.counted_quantity, precision: 3, strip_insignificant_zeros: true).presence || "—" %>
                </td>
                <td class="p-3 text-end tabular-nums"><%= transfer_line_amount(line, line.quantity_requested) %></td>
                <td class="p-3 text-end tabular-nums text-gray-600 print-hide"><%= transfer_line_amount(line, line.quantity_sent) %></td>
                <td class="p-3 text-end tabular-nums text-gray-600 print-hide"><%= transfer_line_amount(line, line.quantity_received) %></td>
                <td class="p-3 text-end tabular-nums text-blue-700 print-hide"><%= transfer_line_amount(line, line.quantity_in_transit) %></td>
                <td class="p-3 text-end tabular-nums text-amber-700 print-hide"><%= transfer_line_amount(line, line.quantity_pending_send) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%# Print-only color-coded grid (same visual language as the daily manufacturing card). %>
  <% print_cell = "border border-gray-800 print:border-black p-2.5 align-middle" %>
  <% print_th_item = "#{print_cell} bg-emerald-100 text-emerald-950 font-bold text-sm text-start" %>
  <% print_th_unit = "#{print_cell} bg-amber-100 text-amber-950 font-bold text-sm text-start" %>
  <% print_th_limit = "#{print_cell} bg-sky-100 text-sky-950 font-bold text-sm text-end" %>
  <% print_th_counted = "#{print_cell} bg-orange-100 text-orange-950 font-bold text-sm text-end" %>
  <% print_th_qty = "#{print_cell} bg-rose-100 text-rose-950 font-bold text-sm text-end" %>
  <section class="print-only stock-transfer-print overflow-hidden border border-gray-800 print:border-black bg-white">
    <div class="border-b border-gray-800 print:border-black bg-sky-200 px-4 py-3 text-center">
      <p class="text-lg font-bold text-sky-950"><%= Current.company.name %></p>
      <h2 class="text-base font-bold text-sky-950 tracking-wide mt-0.5">
        <%= t("inventory.stock_transfers.print_document_title") %>
        · <%= @stock_transfer.transfer_number %>
      </h2>
      <p class="text-xs text-sky-900 mt-0.5">
        <%= @stock_transfer.from_location.name %> → <%= @stock_transfer.to_location.name %>
        · <%= l(@stock_transfer.transferred_on, format: :long) %>
      </p>
      <% if @stock_transfer.notes.present? %>
        <p class="text-xs text-sky-900 mt-1"><%= @stock_transfer.notes %></p>
      <% end %>
      <p class="text-xs text-sky-800/80 mt-1"><%= t("inventory.stock_transfers.printed_at", at: l(Time.current, format: :short)) %></p>
    </div>
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr>
          <th class="<%= print_cell %> bg-gray-100 text-gray-800 font-bold text-sm w-12"><%= t("shared.row_index") %></th>
          <th class="<%= print_th_item %>"><%= t("inventory.stock_transfers.ingredient") %></th>
          <th class="<%= print_th_unit %> w-[14%]"><%= t("inventory.stock_transfers.unit") %></th>
          <th class="<%= print_th_limit %> w-[14%]"><%= t("inventory.stock_transfers.order_limit") %></th>
          <th class="<%= print_th_counted %> w-[14%]"><%= t("inventory.stock_transfers.counted_quantity") %></th>
          <th class="<%= print_th_qty %> w-[16%]"><%= t("inventory.stock_transfers.quantity_requested") %></th>
        </tr>
      </thead>
      <tbody>
        <% print_row_number = 0 %>
        <% display_lines.each do |category_name, lines| %>
          <% if category_name %>
            <tr>
              <td colspan="6" class="<%= print_cell %> bg-gray-200 text-gray-800 text-xs font-bold uppercase tracking-wide text-start">
                <%= category_name %>
                <span class="font-normal normal-case tracking-normal">(<%= lines.size %>)</span>
              </td>
            </tr>
          <% end %>
          <% lines.each do |line| %>
            <% print_row_number += 1 %>
            <tr>
              <td class="<%= print_cell %> bg-gray-50 text-gray-600 tabular-nums text-center"><%= print_row_number %></td>
              <td class="<%= print_cell %> bg-emerald-50/80 text-gray-900 font-semibold">
                <%= render "ingredient_name", ingredient: line.ingredient, category_name: category_name, subtitle_class: "text-emerald-800" %>
              </td>
              <td class="<%= print_cell %> bg-amber-50/60 text-gray-800"><%= transfer_line_unit_label(line) %></td>
              <td class="<%= print_cell %> bg-sky-50/70 text-sky-950 tabular-nums text-end font-semibold">
                <%= number_with_precision(line.order_limit, precision: 3, strip_insignificant_zeros: true).presence || "—" %>
              </td>
              <td class="<%= print_cell %> bg-orange-50/70 text-orange-950 tabular-nums text-end font-semibold">
                <%= number_with_precision(line.counted_quantity, precision: 3, strip_insignificant_zeros: true).presence || "—" %>
              </td>
              <td class="<%= print_cell %> bg-rose-50/50 text-gray-900 tabular-nums text-end font-bold text-base">
                <%= transfer_line_amount(line, line.quantity_requested) %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </section>

  <% if @stock_transfer.completed? && @source_shortage_lines.any? %>
    <section class="rounded-2xl border border-red-200 bg-red-50/40 overflow-hidden mt-6 print-hide" data-source-shortage-report>
      <div class="px-5 py-4 border-b border-red-100">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.source_shortage_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.stock_transfers.source_shortage_hint", location: @stock_transfer.from_location.name) %></p>
      </div>
      <div class="overflow-auto max-h-[60vh] relative">
        <table class="w-full text-sm">
          <thead class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="sticky top-0 z-10 bg-red-50 py-2 px-3 text-start w-12 text-gray-400 border-b border-red-100"><%= t("shared.row_index") %></th>
              <th class="sticky top-0 z-10 bg-red-50 py-2 px-3 text-start border-b border-red-100"><%= t("inventory.stock_transfers.ingredient") %></th>
              <th class="sticky top-0 z-10 bg-red-50 py-2 px-3 text-start border-b border-red-100"><%= t("inventory.stock_transfers.unit") %></th>
              <th class="sticky top-0 z-10 bg-red-50 py-2 px-3 text-end border-b border-red-100"><%= t("inventory.stock_transfers.quantity_received_total") %></th>
              <th class="sticky top-0 z-10 bg-red-50 py-2 px-3 text-end border-b border-red-100"><%= t("inventory.stock_transfers.source_on_hand") %></th>
              <th class="sticky top-0 z-10 bg-red-50 py-2 px-3 text-end border-b border-red-100 print-hide"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-red-100/80 bg-white/60">
            <% shortage_row_number = 0 %>
            <% group_records_by_ingredient_category(@source_shortage_lines).each do |category_name, lines| %>
              <%= render "category_header", name: category_name, count: lines.size, tag: :tr, colspan: 6 %>
              <% lines.each do |line| %>
                <% shortage_row_number += 1 %>
                <tr data-source-shortage="true">
                  <td class="p-3 text-gray-400 tabular-nums"><%= shortage_row_number %></td>
                  <td class="p-3 font-medium text-gray-900">
                    <%= render "ingredient_name", ingredient: line.ingredient, category_name: category_name, link: true %>
                  </td>
                  <td class="p-3 text-gray-700"><%= transfer_line_unit_label(line) %></td>
                  <td class="p-3 text-end tabular-nums text-gray-700"><%= transfer_line_amount(line, line.quantity_received) %></td>
                  <td class="p-3 text-end tabular-nums font-semibold text-red-700"><%= transfer_line_amount(line, line.available_at_source) %></td>
                  <td class="p-3 text-end print-hide">
                    <%= link_to t("inventory.stock_transfers.adjust_source"),
                          admin_inventory_ingredient_path(line.ingredient, anchor: "adjust"),
                          class: "inline-flex text-xs font-semibold text-amber-800 hover:bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200 transition-colors" %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
