<% content_for :title, t("inventory.stock_transfers.title") %>
<% sort_opts = { sort: @sort, direction: @direction } %>
<% tab_params = { location_id: params[:location_id].presence } %>
<%= render "admin/inventory/tools_nav" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.stock_transfers.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.stock_transfers.index_description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to t("inventory.stock_transfer_templates.title"), admin_inventory_stock_transfer_templates_path,
            class: "inline-flex items-center border border-gray-200 text-gray-700 text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-gray-50 transition-colors" %>
      <%= link_to t("inventory.stock_transfers.new"), new_admin_inventory_stock_transfer_path,
            class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors" %>
    </div>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-4 mb-6 border-b border-gray-200">
    <div class="flex flex-wrap gap-1">
      <%= link_to admin_inventory_stock_transfers_path(**tab_params),
            class: admin_section_tab_class(@scope_name == "open") do %>
        <%= t("inventory.stock_transfers.filters.open") %><%= admin_tab_count(@open_count, active: @scope_name == "open") %>
      <% end %>
      <%= link_to admin_inventory_stock_transfers_path(**tab_params, scope: "today"),
            class: admin_section_tab_class(@scope_name == "today") do %>
        <%= t("inventory.stock_transfers.filters.today") %><%= admin_tab_count(@today_count, active: @scope_name == "today") %>
      <% end %>
      <% StockTransfer::STATUSES.each do |status| %>
        <%= link_to admin_inventory_stock_transfers_path(**tab_params, status: status),
              class: admin_section_tab_class(@status == status) do %>
          <%= t("inventory.stock_transfers.statuses.#{status}") %><%= admin_tab_count(@status_counts[status], active: @status == status) %>
        <% end %>
      <% end %>
      <%= link_to admin_inventory_stock_transfers_path(**tab_params, scope: "all"),
            class: admin_section_tab_class(@scope_name == "all") do %>
        <%= t("inventory.stock_transfers.filters.all") %><%= admin_tab_count(@all_count, active: @scope_name == "all") %>
      <% end %>
    </div>

    <%# A work queue that is quietly filtered reads as missing data, so say what
        narrowed it and offer one click back to the full list. %>
    <% if drilled_down? %>
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50/70 px-4 py-3 mb-4">
        <div class="text-sm text-amber-900">
          <span class="font-semibold"><%= t("inventory.stock_transfers.drill.heading") %></span>
          <span class="text-amber-800">
            <% parts = [] %>
            <% parts << @drill_ingredient.name if @drill_ingredient %>
            <% if params[:from_location_id].present? || params[:to_location_id].present? %>
              <% from = @locations.find { |l| l.id == params[:from_location_id] } %>
              <% to = @locations.find { |l| l.id == params[:to_location_id] } %>
              <% parts << "#{from&.name || "…"} → #{to&.name || "…"}" %>
            <% end %>
            <% if params[:start_date].present? || params[:end_date].present? %>
              <% parts << [params[:start_date], params[:end_date]].compact_blank.join(" – ") %>
            <% end %>
            <%= parts.join(" · ") %>
          </span>
        </div>
        <%= link_to t("inventory.stock_transfers.drill.clear"),
              admin_inventory_stock_transfers_path,
              class: "shrink-0 text-sm font-semibold text-amber-900 hover:bg-amber-100 px-3 py-1.5 rounded-lg border border-amber-300" %>
      </div>
    <% end %>

    <%= form_with url: admin_inventory_stock_transfers_path, method: :get,
                  class: "flex items-end gap-2 pb-2", data: { turbo: false } do %>
      <%= hidden_field_tag :scope, @scope_name if @scope_name %>
      <%= hidden_field_tag :status, @status if @status %>
      <%# Drill-down filters ride along: changing location must not silently drop
          the narrowing the user arrived with. %>
      <% %i[ingredient_id from_location_id to_location_id start_date end_date].each do |key| %>
        <%= hidden_field_tag key, params[key] if params[key].present? %>
      <% end %>
      <%= hidden_field_tag :sort, @sort if @sort %>
      <%= hidden_field_tag :dir, @direction if @sort %>
      <div class="min-w-[12rem]">
        <%= label_tag :location_id, t("inventory.stock_transfers.filter_location"),
              class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= select_tag :location_id,
              options_from_collection_for_select(@locations, :id, :name, params[:location_id]),
              include_blank: t("inventory.stock_transfers.all_locations"),
              onchange: "this.form.requestSubmit()",
              class: "#{pos_input_class} appearance-none" %>
      </div>
      <noscript>
        <%= submit_tag t("actions.apply"),
              class: "bg-gray-900 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      </noscript>
    <% end %>
  </div>

  <% if @stock_transfers.any? %>
    <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[48rem]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("inventory.stock_transfers.transfer_number"), :transfer_number, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("inventory.stock_transfers.from_location"), :from_location, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("inventory.stock_transfers.to_location"), :to_location, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("inventory.stock_transfers.status"), :status, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("inventory.stock_transfers.transferred_on"), :transferred_on, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("inventory.stock_transfers.requested_by"), :requested_by, **sort_opts) %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @stock_transfers.each_with_index do |transfer, index| %>
              <% status_label, status_class = stock_transfer_status_badge(transfer.status) %>
              <% aging = transfer.stale_awaiting_receipt? %>
              <tr class="<%= aging ? "bg-red-50/70 hover:bg-red-50" : "hover:bg-gray-100" %>">
                <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= table_row_number(index, pagy: @pagy) %></td>
                <td class="p-3">
                  <%= link_to transfer.transfer_number, admin_inventory_stock_transfer_path(transfer),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                </td>
                <td class="p-3 text-gray-700"><%= transfer.from_location.name %></td>
                <td class="p-3 text-gray-700"><%= transfer.to_location.name %></td>
                <td class="p-3">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= status_class %>"><%= status_label %></span>
                    <% if aging %>
                      <span class="text-xs font-semibold px-2 py-1 rounded-full bg-red-100 text-red-800 border border-red-200"
                            title="<%= t("inventory.stock_transfers.aging_hint", days: StockTransfer::AGING_RECEIPT_DAYS) %>">
                        <%= t("inventory.stock_transfers.aging_badge", count: (Date.current - transfer.transferred_on).to_i) %>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="p-3 text-gray-600"><%= l(transfer.transferred_on, format: :long) %></td>
                <td class="p-3 text-gray-600"><%= transfer.requested_by.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-gray-200 bg-white p-10 text-center">
      <p class="text-gray-600">
        <% if @status == "draft" %>
          <%= t("inventory.stock_transfers.empty_draft") %>
        <% elsif @scope_name == "open" %>
          <%= t("inventory.stock_transfers.empty_open") %>
        <% elsif @scope_name == "today" %>
          <%= t("inventory.stock_transfers.empty_today") %>
        <% else %>
          <%= t("inventory.stock_transfers.empty") %>
        <% end %>
      </p>
      <%= link_to t("inventory.stock_transfers.new"), new_admin_inventory_stock_transfer_path,
            class: "inline-flex mt-4 text-sm font-semibold text-amber-700 hover:text-amber-800" %>
    </div>
  <% end %>

  <% if @completed_today.present? %>
    <section class="mt-8">
      <div class="flex flex-wrap items-baseline gap-2 mb-3">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.completed_today") %></h2>
        <span class="text-xs text-gray-500"><%= t("inventory.stock_transfers.completed_today_hint") %></span>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm min-w-[40rem]">
            <tbody class="divide-y divide-gray-100">
              <% @completed_today.each do |transfer| %>
                <tr class="hover:bg-gray-50">
                  <td class="p-3 ps-5">
                    <%= link_to transfer.transfer_number, admin_inventory_stock_transfer_path(transfer),
                          class: "font-semibold text-emerald-700 hover:text-emerald-800" %>
                  </td>
                  <td class="p-3 text-gray-700"><%= transfer.from_location.name %> → <%= transfer.to_location.name %></td>
                  <td class="p-3 text-gray-500"><%= transfer.requested_by.name %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  <% end %>
</div>
