<%# locals: stock_transfer %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, :inventory, stock_transfer], class: "space-y-6" do |f| %>
  <% if stock_transfer.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= stock_transfer.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.form.details") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.stock_transfers.form.details_hint") %></p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :from_location_id, t("inventory.stock_transfers.from_location"), class: label_class %>
        <%= f.collection_select :from_location_id, @locations, :id, :name,
              { prompt: t("inventory.stock_transfers.select_location") },
              class: "#{input_class} appearance-none", required: true %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_transfers.from_location_hint") %></p>
      </div>
      <div>
        <%= f.label :to_location_id, t("inventory.stock_transfers.to_location"), class: label_class %>
        <%= f.collection_select :to_location_id, @locations, :id, :name,
              { prompt: t("inventory.stock_transfers.select_location") },
              class: "#{input_class} appearance-none", required: true %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_transfers.to_location_hint") %></p>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :notes, t("inventory.stock_transfers.notes"), class: label_class %>
        <%= f.text_area :notes, rows: 2, class: "#{input_class} resize-y min-h-[4rem]" %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden"
           data-controller="stock-transfer-lines"
           data-searchable-select-options="<%= ingredient_search_options(@ingredients) %>"
           data-stock-transfer-lines-available-units-value="<%= @ingredient_available_units.to_json %>">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfers.form.line_items") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.stock_transfers.form.line_items_hint") %></p>
      </div>
      <button type="button"
              class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-2 rounded-xl border border-amber-200 transition-colors shrink-0"
              data-action="stock-transfer-lines#add">
        <span aria-hidden="true">+</span> <%= t("inventory.stock_transfers.form.add_line") %>
      </button>
    </div>
    <div class="hidden sm:grid sm:grid-cols-[1fr_10rem_auto] gap-4 px-5 py-3 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-100">
      <div><%= t("inventory.stock_transfers.ingredient") %></div>
      <div><%= t("inventory.stock_transfers.quantity_requested") %></div>
      <div></div>
    </div>
    <div class="divide-y divide-gray-100" data-stock-transfer-lines-target="list">
      <%= f.fields_for :stock_transfer_lines do |line_form| %>
        <%= render "line_fields", f: line_form %>
      <% end %>
    </div>
    <template data-stock-transfer-lines-target="template">
      <%= f.fields_for :stock_transfer_lines, StockTransferLine.new, child_index: "NEW_RECORD" do |line_form| %>
        <%= render "line_fields", f: line_form %>
      <% end %>
    </template>
  </section>

  <div class="flex flex-wrap gap-3">
    <%= f.submit stock_transfer.persisted? ? t("actions.save") : t("inventory.stock_transfers.submit_request"),
          class: "bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-xl text-sm font-semibold" %>
    <%= link_to t("actions.cancel"), stock_transfer.persisted? ? admin_inventory_stock_transfer_path(stock_transfer) : admin_inventory_stock_transfers_path,
          class: "inline-flex items-center text-sm font-semibold text-gray-700 hover:bg-gray-100 px-5 py-2.5 rounded-xl border border-gray-200" %>
  </div>
<% end %>
