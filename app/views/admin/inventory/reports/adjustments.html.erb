<% cell = "p-3" %>
<% period = t("accounting.shared.date_range_value", start: l(@start_date, format: :long), end: l(@end_date, format: :long)) %>
<div class="max-w-7xl print:max-w-none" <%= tag.attributes(data: { controller: "auto-print" }) if print_mode? %>>
  <%= render "admin/inventory/reports/valued/header",
        description: t("inventory.reports.adjustments.description"), period: period %>

  <%= render layout: "admin/inventory/reports/valued/filters", locals: { dates: true } do %>
    <fieldset class="basis-full">
      <legend class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.reports.adjustments.types") %></legend>
      <div class="flex flex-wrap gap-2">
        <% Inventory::Reports::AdjustmentsService::AVAILABLE_TYPES.each do |type| %>
          <label class="inline-flex items-center gap-2 text-sm px-3 py-1.5 rounded-full border border-gray-200 cursor-pointer has-[:checked]:bg-amber-50 has-[:checked]:border-amber-400">
            <%= check_box_tag "types[]", type, @types.include?(type), id: "type_#{type}", class: "rounded" %>
            <%= inventory_adjustment_type_label(type) %>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <p class="print-only text-xs text-gray-600 mb-3">
    <%= t("inventory.reports.adjustments.types") %>: <%= @types.map { |type| inventory_adjustment_type_label(type) }.join("، ") %>
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 print:grid-cols-3 print:gap-2 print:mb-3">
    <%= render "admin/inventory/reports/valued/stat", label: t("inventory.reports.adjustments.surplus"), tone: :good,
          value: format_amount(@result.surplus_cents), hint: t("inventory.reports.shared.item_count", count: @result.surplus.size) %>
    <%= render "admin/inventory/reports/valued/stat", label: t("inventory.reports.adjustments.deficit"), tone: :bad,
          value: format_amount(@result.deficit_cents), hint: t("inventory.reports.shared.item_count", count: @result.deficit.size) %>
    <%= render "admin/inventory/reports/valued/stat", label: t("inventory.reports.adjustments.net"),
          tone: @result.net_cents.negative? ? :bad : :good, value: format_amount(@result.net_cents) %>
  </div>

  <% if @result.empty? %>
    <p class="rounded-2xl border border-gray-200 bg-white px-5 py-10 text-center text-sm text-gray-500"><%= t("inventory.reports.shared.empty") %></p>
  <% else %>
    <% [[:surplus, @result.surplus, @result.surplus_cents, "text-green-700"],
        [:deficit, @result.deficit, @result.deficit_cents, "text-red-700"]].each do |kind, rows, total, tone| %>
      <section class="print-flow rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6 print:rounded-none">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
          <h2 class="text-sm font-semibold <%= tone %>"><%= t("inventory.reports.adjustments.#{kind}") %></h2>
          <p class="text-xs text-gray-500 mt-0.5 print-hide"><%= t("inventory.reports.adjustments.#{kind}_hint") %></p>
        </div>
        <% if rows.empty? %>
          <p class="px-5 py-6 text-center text-sm text-gray-500"><%= t("inventory.reports.shared.empty") %></p>
        <% else %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[640px] print:min-w-0 print:text-xs" data-controller="sortable-table"
                   data-sortable-table-storage-key-value="adjustments-<%= kind %>">
              <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                <tr>
                  <%= sortable_report_th t("inventory.reports.shared.item"), "item", align: :start %>
                  <%= sortable_report_th t("inventory.reports.shared.category"), "category", align: :start %>
                  <%= sortable_report_th t("inventory.reports.shared.quantity"), "qty", type: :number %>
                  <%= sortable_report_th t("inventory.reports.adjustments.movements"), "count", type: :number %>
                  <%= sortable_report_th t("inventory.reports.shared.value"), "value", type: :number, pe: true %>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100" data-sortable-table-target="body">
                <% rows.each do |row| %>
                  <tr class="hover:bg-gray-50">
                    <td class="<%= cell %> ps-5" data-sort-key="item">
                      <%= link_to row.ingredient.name,
                            admin_inventory_reports_movements_path({ ingredient_id: row.ingredient.id, location_id: @location&.id,
                              start_date: @start_date, end_date: @end_date }.compact),
                            class: "font-medium text-amber-700 hover:text-amber-900 hover:underline" %>
                    </td>
                    <td class="<%= cell %> text-gray-600" data-sort-key="category"><%= row.ingredient.ingredient_category&.name %></td>
                    <td class="<%= cell %> text-end tabular-nums" data-sort-key="qty" data-sort-value="<%= row.quantity %>">
                      <%= report_qty(row.quantity) %> <span class="text-xs text-gray-400"><%= ingredient_unit_label(row.ingredient.unit) %></span>
                    </td>
                    <td class="<%= cell %> text-end tabular-nums text-gray-600" data-sort-key="count" data-sort-value="<%= row.count %>"><%= row.count %></td>
                    <td class="<%= cell %> pe-5 text-end tabular-nums font-semibold <%= tone %>" data-sort-key="value" data-sort-value="<%= row.value_cents %>">
                      <%= format_amount(row.value_cents) %><%= estimated_cost_mark(row.estimated) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="border-t-2 border-gray-200 font-bold text-gray-900">
                <tr>
                  <td class="<%= cell %> ps-5" colspan="4"><%= t("inventory.reports.shared.total") %></td>
                  <td class="<%= cell %> pe-5 text-end tabular-nums <%= tone %>"><%= format_amount(total) %></td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% end %>
      </section>
    <% end %>
  <% end %>
  <%= render "admin/inventory/reports/valued/footnote", estimated: @result.estimated_count %>
</div>
