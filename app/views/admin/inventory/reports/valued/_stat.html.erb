<%# locals: label, value, tone (:neutral | :good | :bad | :warn) %>
<% tone = local_assigns[:tone] || :neutral %>
<% box = { neutral: "border-gray-200 bg-white", good: "border-green-200 bg-green-50/40",
           bad: "border-red-200 bg-red-50/40", warn: "border-amber-200 bg-amber-50/40" }[tone] %>
<% text = { neutral: "text-gray-900", good: "text-green-700", bad: "text-red-700", warn: "text-amber-700" }[tone] %>
<div class="rounded-2xl border <%= box %> p-4 print:p-2">
  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= label %></p>
  <p class="text-2xl font-bold mt-1 tabular-nums <%= text %> print:text-base"><%= value %></p>
  <% if local_assigns[:hint] %><p class="text-xs text-gray-500 mt-1"><%= hint %></p><% end %>
</div>
