<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1">On-hand stock valued at ingredient cost per unit.</p>
    </div>
    <%= link_to admin_inventory_reports_valuation_path(format: :csv),
          class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors shrink-0" do %>
      <%= t("actions.export_csv") %>
    <% end %>
  </div>

  <%= render "admin/inventory/tools_nav" %>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-amber-200 bg-amber-50/40 p-4 sm:col-span-1">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Total stock value</p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@total_cost_value) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Ingredients</p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @ingredient_count %></p>
      <p class="text-xs text-gray-500 mt-1.5">Active items</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Categories</p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @category_count %></p>
    </div>
  </div>

  <% if @by_category.any? %>
    <div class="space-y-6">
      <% @by_category.each do |category, items| %>
        <% category_total = items.sum(&:stock_value_cents) %>
        <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
            <div>
              <h2 class="text-sm font-semibold text-gray-900"><%= category.name %></h2>
              <p class="text-xs text-gray-500 mt-0.5"><%= pluralize(items.size, "ingredient") %></p>
            </div>
            <p class="text-sm font-semibold text-gray-900 tabular-nums">
              <%= format_money(category_total) %>
            </p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm min-w-[480px]">
              <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                <tr>
                  <th class="p-3 pl-5 text-left">Ingredient</th>
                  <th class="p-3 text-right">On hand</th>
                  <th class="p-3 text-right">Unit cost</th>
                  <th class="p-3 pr-5 text-right">Stock value</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% items.each do |ingredient| %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="p-3 pl-5">
                      <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                            class: "font-semibold text-amber-700 hover:text-amber-800" %>
                    </td>
                    <td class="p-3 text-right text-gray-600 tabular-nums whitespace-nowrap">
                      <%= ingredient.quantity_on_hand %> <%= ingredient.unit %>
                    </td>
                    <td class="p-3 text-right text-gray-600 tabular-nums whitespace-nowrap">
                      <%= format_money(ingredient.cost_per_unit_cents) %>
                    </td>
                    <td class="p-3 pr-5 text-right font-semibold text-gray-900 tabular-nums whitespace-nowrap">
                      <%= format_money(ingredient.stock_value_cents) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="border-t border-gray-100 bg-gray-50/50">
                <tr>
                  <td class="p-3 pl-5 font-semibold text-gray-700" colspan="3">Category subtotal</td>
                  <td class="p-3 pr-5 text-right font-bold text-gray-900 tabular-nums">
                    <%= format_money(category_total) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </section>
      <% end %>
    </div>

    <section class="rounded-2xl border border-gray-200 bg-gray-900 text-white overflow-hidden mt-6">
      <div class="px-5 py-4 flex flex-wrap justify-between items-center gap-2">
        <span class="text-sm font-semibold uppercase tracking-wide text-gray-300">Grand total</span>
        <span class="text-2xl font-bold tabular-nums"><%= format_money(@total_cost_value) %></span>
      </div>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1">No active ingredients</p>
      <p class="text-gray-500 text-sm mb-5">Add ingredients with costs to see valuation here.</p>
      <%= link_to "View inventory", admin_inventory_ingredients_path,
            class: "inline-flex font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% end %>
</div>
