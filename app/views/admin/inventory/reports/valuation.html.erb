<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.reports.valuation.description") %></p>
    </div>
    <%= link_to admin_inventory_reports_valuation_path(format: :csv, group_by: @group_by),
          class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors shrink-0" do %>
      <%= t("actions.export_csv") %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-amber-200 bg-amber-50/40 p-4 sm:col-span-1">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.reports.valuation.stats.total_stock_value") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@total_cost_value) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.reports.valuation.stats.ingredients") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @ingredient_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.reports.valuation.stats.active_items") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <% vendor_view = @group_by == "vendor" %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <%= t(vendor_view ? "inventory.reports.valuation.stats.vendors" : "inventory.reports.valuation.stats.categories") %>
      </p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= vendor_view ? @vendor_count : @category_count %></p>
    </div>
  </div>

  <% if @cost_issue_ingredients.any? %>
    <div class="rounded-2xl border border-amber-300 bg-amber-50/70 px-5 py-4 mb-6 flex items-start gap-3" role="status">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
           class="w-5 h-5 shrink-0 text-amber-600 mt-0.5">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
      </svg>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-amber-950">
          <%= t("inventory.reports.valuation.cost_issue_count", count: @cost_issue_ingredients.size) %>
        </p>
        <p class="text-xs text-amber-900 mt-0.5"><%= t("inventory.reports.valuation.cost_issue_hint") %></p>
        <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2">
          <% @cost_issue_ingredients.each do |ingredient| %>
            <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                  class: "text-xs font-semibold text-amber-900 underline underline-offset-2 hover:text-amber-950" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div data-controller="details-group">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-6 border-b border-gray-200">
      <div class="flex flex-wrap gap-1">
        <%= link_to t("inventory.reports.valuation.group_by.category"),
              admin_inventory_reports_valuation_path,
              class: admin_section_tab_class(@group_by == "category") %>
        <%= link_to t("inventory.reports.valuation.group_by.vendor"),
              admin_inventory_reports_valuation_path(group_by: "vendor"),
              class: admin_section_tab_class(@group_by == "vendor") %>
      </div>
      <% if @ingredients.any? %>
        <div class="flex flex-wrap gap-2 pb-2">
          <% bulk_button = "text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-lg border border-gray-200 transition-colors" %>
          <button type="button" data-action="details-group#expandAll" class="<%= bulk_button %>">
            <%= t("inventory.reports.valuation.expand_all") %>
          </button>
          <button type="button" data-action="details-group#collapseAll" class="<%= bulk_button %>">
            <%= t("inventory.reports.valuation.collapse_all") %>
          </button>
        </div>
      <% end %>
    </div>

  <% if @ingredients.any? %>
    <div class="space-y-6">
      <% if @group_by == "vendor" %>
        <% @by_vendor.each do |key, items| %>
          <%= render "valuation_group",
                title: vendor_group_label(key),
                count: items.size,
                subtotal: items.sum(&:stock_value_cents),
                items: items,
                last_invoice_costs: @last_invoice_costs,
                note: (key == Admin::Inventory::ReportsController::VENDOR_GROUP_MULTIPLE ?
                        t("inventory.reports.valuation.multiple_vendors_hint") : nil) %>
        <% end %>
      <% else %>
        <% @by_category.each do |category, items| %>
          <%= render "valuation_group",
                title: category.name,
                count: items.size,
                subtotal: items.sum(&:stock_value_cents),
                items: items,
                last_invoice_costs: @last_invoice_costs %>
        <% end %>
      <% end %>
    </div>

    <section class="rounded-2xl border border-gray-200 bg-gray-900 text-white overflow-hidden mt-6">
      <div class="px-5 py-4 flex flex-wrap justify-between items-center gap-2">
        <span class="text-sm font-semibold uppercase tracking-wide text-gray-300"><%= t("inventory.reports.valuation.grand_total") %></span>
        <span class="text-2xl font-bold tabular-nums"><%= format_money(@total_cost_value) %></span>
      </div>
    </section>
  </div>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.reports.valuation.empty.title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("inventory.reports.valuation.empty.description") %></p>
      <%= link_to t("inventory.reports.valuation.empty.view_inventory"), admin_inventory_ingredients_path,
            class: "inline-flex font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% end %>
</div>
