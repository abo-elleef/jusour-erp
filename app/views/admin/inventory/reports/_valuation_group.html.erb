<%# locals: title, count, subtotal, items, note: nil

    Native <details>, matching the balance-history section on the ingredient show
    page: individual expand/collapse needs no JS at all. Open by default so the
    report still shows everything on arrival; the bulk controls above collapse it.
    The header carries the subtotal, so a collapsed group is still the number you
    came to read. %>
<details open class="group rounded-2xl border border-gray-200 bg-white overflow-hidden"
         data-details-group-target="section">
  <summary class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex cursor-pointer list-none flex-wrap justify-between items-center gap-2 hover:bg-gray-100 transition-colors [&::-webkit-details-marker]:hidden">
    <div class="flex items-center gap-2.5 min-w-0">
      <%# Rotating a down-chevron by 180° stays correct in RTL, unlike -rotate-90. %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
           class="w-4 h-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180">
        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
      </svg>
      <div class="min-w-0">
        <h2 class="text-sm font-semibold text-gray-900"><%= title %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.reports.valuation.ingredients_count", count: count) %></p>
        <% if local_assigns[:note].present? %>
          <p class="text-xs text-amber-700 mt-1"><%= note %></p>
        <% end %>
      </div>
    </div>
    <p class="text-sm font-semibold text-gray-900 tabular-nums"><%= format_money(subtotal) %></p>
  </summary>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm min-w-[480px]">
      <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 pl-5 text-left"><%= t("inventory.reports.valuation.table.ingredient") %></th>
          <th class="p-3 text-right"><%= t("inventory.reports.valuation.table.on_hand") %></th>
          <th class="p-3 text-right"><%= t("inventory.reports.valuation.table.unit_cost") %></th>
          <th class="p-3 pr-5 text-right"><%= t("inventory.reports.valuation.table.stock_value") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% items.each do |ingredient| %>
          <% negative = ingredient.quantity_on_hand.to_d.negative? %>
          <tr class="hover:bg-gray-100 transition-colors">
            <td class="p-3 pl-5">
              <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                    class: "font-semibold text-amber-700 hover:text-amber-800" %>
            </td>
            <td class="p-3 text-right tabular-nums whitespace-nowrap <%= negative ? "text-red-700 font-semibold" : "text-gray-600" %>">
              <%= ingredient.quantity_on_hand %> <%= ingredient_unit_label(ingredient.unit) %>
            </td>
            <td class="p-3 text-right text-gray-600 tabular-nums whitespace-nowrap">
              <%= format_money(ingredient.cost_per_unit_cents) %>
            </td>
            <td class="p-3 pr-5 text-right font-semibold text-gray-900 tabular-nums whitespace-nowrap">
              <%= format_money(ingredient.stock_value_cents) %>
              <% if negative %>
                <%# Value is floored at zero; the red quantity is the thing to fix. %>
                <span class="block text-xs font-normal text-red-700"><%= t("inventory.reports.valuation.negative_on_hand") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t border-gray-100 bg-gray-50/50">
        <tr>
          <td class="p-3 pl-5 font-semibold text-gray-700" colspan="3"><%= t("inventory.reports.valuation.category_subtotal") %></td>
          <td class="p-3 pr-5 text-right font-bold text-gray-900 tabular-nums"><%= format_money(subtotal) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</details>
