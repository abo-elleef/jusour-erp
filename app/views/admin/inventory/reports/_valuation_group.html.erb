<%# locals: title, count, subtotal, items, last_invoice_costs:, note: nil

    Native <details>, matching the balance-history section on the ingredient show
    page: individual expand/collapse needs no JS at all. Open by default so the
    report still shows everything on arrival; the bulk controls above collapse it.
    The header carries the subtotal, so a collapsed group is still the number you
    came to read. %>
<details open class="group rounded-2xl border border-gray-200 bg-white overflow-hidden"
         data-details-group-target="section">
  <summary class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex cursor-pointer list-none flex-wrap justify-between items-center gap-2 hover:bg-gray-100 transition-colors [&::-webkit-details-marker]:hidden">
    <div class="flex items-center gap-2.5 min-w-0">
      <%# Rotating a down-chevron by 180° stays correct in RTL, unlike -rotate-90. %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
           class="w-4 h-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180">
        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
      </svg>
      <div class="min-w-0">
        <h2 class="text-sm font-semibold text-gray-900"><%= title %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.reports.valuation.ingredients_count", count: count) %></p>
        <% if local_assigns[:note].present? %>
          <p class="text-xs text-amber-700 mt-1"><%= note %></p>
        <% end %>
      </div>
    </div>
    <p class="text-sm font-semibold text-gray-900 tabular-nums"><%= format_money(subtotal) %></p>
  </summary>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm min-w-[480px]">
      <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 pl-5 text-left"><%= t("inventory.reports.valuation.table.ingredient") %></th>
          <th class="p-3 text-right"><%= t("inventory.reports.valuation.table.on_hand") %></th>
          <th class="p-3 text-right"><%= t("inventory.reports.valuation.table.unit_cost") %></th>
          <th class="p-3 text-right"><%= t("inventory.reports.valuation.table.last_invoice_cost") %></th>
          <th class="p-3 pr-5 text-right"><%= t("inventory.reports.valuation.table.stock_value") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% items.each do |ingredient| %>
          <% negative = ingredient.quantity_on_hand.to_d.negative? %>
          <%# A zero or negative unit cost silently contributes nothing (or would
              contribute a credit) to the total, so flag the cost cell rather than
              letting the row read as a legitimate 0.00. %>
          <% cost_cents = ingredient.cost_per_unit_cents.to_i %>
          <% cost_issue = cost_cents <= 0 %>
          <% lic = last_invoice_costs[ingredient] %>
          <% invoiced_cents = lic&.unit_cost_cents.to_i %>
          <% cost_matches = lic && invoiced_cents == cost_cents %>
          <% cost_differs = lic && invoiced_cents != cost_cents %>
          <tr id="ingredient-<%= ingredient.id %>" class="hover:bg-gray-100 transition-colors <%= "bg-amber-50/60" if cost_issue %>">
            <td class="p-3 pl-5">
              <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                    class: "font-semibold text-amber-700 hover:text-amber-800" %>
            </td>
            <td class="p-3 text-right tabular-nums whitespace-nowrap <%= negative ? "text-red-700 font-semibold" : "text-gray-600" %>">
              <%= ingredient.quantity_on_hand %> <%= ingredient_unit_label(ingredient.unit) %>
            </td>
            <td class="p-3 text-right tabular-nums whitespace-nowrap <%= cost_issue ? "text-amber-900 font-semibold" : "text-gray-600" %>">
              <span class="inline-flex items-center gap-1.5 justify-end">
                <% if cost_issue %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                       class="w-4 h-4 shrink-0 text-amber-600">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                  </svg>
                <% end %>
                <%= format_money(cost_cents) %>
              </span>
              <% if cost_issue %>
                <span class="block text-xs font-normal text-amber-800">
                  <%= t(cost_cents.negative? ? "inventory.reports.valuation.negative_cost" : "inventory.reports.valuation.zero_cost") %>
                </span>
              <% end %>
            </td>
            <%# Last invoice cost column: in-sync ✓, differs → update button, no invoices → warning %>
            <td class="p-3 text-right tabular-nums whitespace-nowrap">
              <% if lic.nil? %>
                <span class="inline-flex items-center gap-1 text-xs text-gray-400">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 shrink-0 text-amber-400" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                  </svg>
                  <%= t("inventory.reports.valuation.no_invoice") %>
                </span>
              <% elsif cost_matches %>
                <span class="inline-flex items-center gap-1 text-xs text-emerald-700 font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 shrink-0" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  <%= format_money(invoiced_cents) %>
                </span>
              <% elsif cost_differs %>
                <span class="block text-xs text-amber-800 font-medium"><%= format_money(invoiced_cents) %></span>
                <%= button_to t("inventory.ingredients.cost_sync.action"),
                      sync_cost_from_last_invoice_admin_inventory_ingredient_path(ingredient),
                      method: :post,
                      params: { return_to: "#{admin_inventory_reports_valuation_path(group_by: @group_by)}#ingredient-#{ingredient.id}" },
                      form: { data: {
                        turbo: false,
                        turbo_confirm: t("inventory.ingredients.cost_sync.confirm",
                                         from: format_money(cost_cents),
                                         to: format_money(invoiced_cents),
                                         invoice: lic.invoice.invoice_number,
                                         count: lic.invoice_count)
                      } },
                      class: "mt-1 inline-flex text-xs font-semibold text-amber-800 hover:bg-amber-50 px-2 py-1 rounded-lg border border-amber-300 transition-colors" %>
              <% end %>
            </td>
            <td class="p-3 pr-5 text-right font-semibold text-gray-900 tabular-nums whitespace-nowrap">
              <%= format_money(ingredient.stock_value_cents) %>
              <% if negative %>
                <%# Value is floored at zero; the red quantity is the thing to fix. %>
                <span class="block text-xs font-normal text-red-700"><%= t("inventory.reports.valuation.negative_on_hand") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t border-gray-100 bg-gray-50/50">
        <tr>
          <td class="p-3 pl-5 font-semibold text-gray-700" colspan="4"><%= t("inventory.reports.valuation.category_subtotal") %></td>
          <td class="p-3 pr-5 text-right font-bold text-gray-900 tabular-nums"><%= format_money(subtotal) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</details>
