<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= render "admin/inventory/tools_nav" %>
<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("inventory.reports.variance.description") %>
      </p>
    </div>
    <%= link_to admin_inventory_reports_variance_path(format: :csv, start_date: @start_date, end_date: @end_date),
          class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors shrink-0" do %>
      <%= t("actions.export_csv") %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.shared.date_range") %></h2>
      <p class="text-xs text-gray-500 mt-0.5">
        <%= t("accounting.shared.date_range_value",
              start: l(@start_date, format: :long),
              end: l(@end_date, format: :long)) %>
      </p>
    </div>
    <div class="p-5">
      <%= form_with url: admin_inventory_reports_variance_path, method: :get, class: "flex flex-wrap items-end gap-4" do %>
        <div class="min-w-[10rem]">
          <%= label_tag :start_date, t("accounting.shared.start"), class: label_class %>
          <%= date_field_tag :start_date, @start_date, class: input_class %>
        </div>
        <div class="min-w-[10rem]">
          <%= label_tag :end_date, t("accounting.shared.end"), class: label_class %>
          <%= date_field_tag :end_date, @end_date, class: input_class %>
        </div>
        <%= submit_tag t("actions.apply_range"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </div>
  </section>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.reports.variance.stats.completed_orders") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @completed_orders_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.reports.variance.stats.in_range") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.reports.variance.stats.ingredients") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @ingredient_count %></p>
    </div>
    <div class="rounded-2xl border border-red-200 bg-red-50/40 p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.reports.variance.stats.high_variance") %></p>
      <p class="text-2xl font-bold mt-1 text-red-700 tabular-nums"><%= @high_variance_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.reports.variance.stats.high_variance_hint") %></p>
    </div>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.reports.variance.table_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.reports.variance.table_hint") %></p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm min-w-[640px]">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 pl-5 text-left"><%= t("inventory.reports.variance.table.ingredient") %></th>
            <th class="p-3 text-right"><%= t("inventory.reports.variance.table.theoretical") %></th>
            <th class="p-3 text-right"><%= t("inventory.reports.variance.table.actual") %></th>
            <th class="p-3 text-right"><%= t("inventory.reports.variance.table.variance") %></th>
            <th class="p-3 pr-5 text-right"><%= t("inventory.reports.variance.table.percent") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @variance_rows.each do |row| %>
            <% high_variance = row[:variance_pct].abs > 10 %>
            <tr class="hover:bg-gray-50/60 transition-colors <%= 'bg-red-50/50' if high_variance %>">
              <td class="p-3 pl-5">
                <%= link_to row[:ingredient].name, admin_inventory_ingredient_path(row[:ingredient]),
                      class: "font-semibold text-amber-700 hover:text-amber-800" %>
                <span class="text-xs text-gray-500 block"><%= ingredient_unit_label(row[:ingredient].unit) %></span>
              </td>
              <td class="p-3 text-right text-gray-600 tabular-nums"><%= row[:theoretical] %></td>
              <td class="p-3 text-right text-gray-600 tabular-nums"><%= row[:actual] %></td>
              <td class="p-3 text-right font-semibold tabular-nums <%= row[:variance].to_d.positive? ? 'text-amber-700' : (row[:variance].to_d.negative? ? 'text-red-700' : 'text-gray-700') %>">
                <%= row[:variance] %>
              </td>
              <td class="p-3 pr-5 text-right">
                <% if high_variance %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-red-100 text-red-800 border border-red-200 tabular-nums">
                    <%= row[:variance_pct] %>%
                  </span>
                <% else %>
                  <span class="text-gray-600 tabular-nums"><%= row[:variance_pct] %>%</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
