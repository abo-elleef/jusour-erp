<%= render "admin/inventory/tools_nav" %>

<% sort_opts = { sort: @sort, direction: @direction } %>
<% display_lines = @grouped_view ? group_preserving_line_order_by_ingredient_category(@lines) : [[nil, @lines]] %>
<% duplicate_ids = @duplicate_ingredient_ids.to_set %>

<div class="max-w-4xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @template.name %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("inventory.stock_transfer_templates.lines_count", count: @lines.size) %>
        ·
        <span class="<%= @template.active? ? "text-emerald-700" : "text-gray-500" %> font-medium">
          <%= @template.active? ? t("inventory.stock_transfer_templates.active") : t("inventory.stock_transfer_templates.inactive") %>
        </span>
        <% if duplicate_ids.any? %>
          ·
          <span class="text-amber-800 font-medium">
            <%= t("inventory.stock_transfer_templates.repeated_ingredients_count", count: duplicate_ids.size) %>
          </span>
        <% end %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @template.active? && @lines.any? %>
        <%= link_to t("inventory.stock_transfer_templates.use"),
              new_admin_inventory_stock_transfer_path(template_id: @template.id),
              class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-xl" %>
      <% end %>
      <%= button_to t("inventory.stock_transfer_templates.duplicate"),
            duplicate_admin_inventory_stock_transfer_template_path(@template),
            method: :post,
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-4 py-2 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("actions.edit"), edit_admin_inventory_stock_transfer_template_path(@template),
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-4 py-2 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("inventory.stock_transfer_templates.back"), admin_inventory_stock_transfer_templates_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
    </div>
  </div>

  <% if @template.notes.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("inventory.stock_transfer_templates.notes") %></p>
      <p class="text-sm text-gray-700 mt-1"><%= @template.notes %></p>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfer_templates.defaults") %></h2>
    </div>
    <dl class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-xs font-semibold text-gray-500 uppercase"><%= t("inventory.stock_transfers.from_location") %></dt>
        <dd class="mt-1 text-gray-900"><%= @template.default_from_location&.name || t("accounting.shared.em_dash") %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-gray-500 uppercase"><%= t("inventory.stock_transfers.to_location") %></dt>
        <dd class="mt-1 text-gray-900"><%= @template.default_to_location&.name || t("accounting.shared.em_dash") %></dd>
      </div>
    </dl>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfer_templates.line_items") %></h2>
      <div class="flex items-center gap-1">
        <%= link_to t("inventory.stock_transfers.flat_list"),
              admin_inventory_stock_transfer_template_path(@template, request.query_parameters.except("grouped")),
              class: "text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors #{@grouped_view ? 'border-gray-200 text-gray-600 hover:bg-gray-50' : 'border-amber-500 bg-amber-50 text-amber-800'}" %>
        <%= link_to t("inventory.stock_transfers.group_by_category"),
              admin_inventory_stock_transfer_template_path(@template, request.query_parameters.merge("grouped" => "1")),
              class: "text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors #{@grouped_view ? 'border-amber-500 bg-amber-50 text-amber-800' : 'border-gray-200 text-gray-600 hover:bg-gray-50'}" %>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase">
          <tr>
            <th class="p-3 ps-5 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
            <th class="p-3 text-start"><%= sort_header_link(t("inventory.stock_transfers.ingredient"), :ingredient, **sort_opts) %></th>
            <th class="p-3 text-end"><%= sort_header_link(t("inventory.stock_transfer_templates.order_limit"), :order_limit, **sort_opts) %></th>
            <th class="p-3 pe-5 text-start"><%= t("inventory.ingredients.alternate_units.unit") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% template_row_number = 0 %>
          <% display_lines.each do |category_name, lines| %>
            <%= render "admin/inventory/stock_transfers/category_header", name: category_name, count: lines.size, tag: :tr, colspan: 4 if category_name %>
            <% lines.each do |line| %>
              <% template_row_number += 1 %>
              <% repeated = duplicate_ids.include?(line.ingredient_id) %>
              <tr class="<%= 'bg-amber-50/80' if repeated %>">
                <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= template_row_number %></td>
                <td class="p-3 font-medium text-gray-900">
                  <%= link_to line.ingredient.name, admin_inventory_ingredient_path(line.ingredient),
                        class: "text-amber-700 hover:text-amber-800 font-semibold" %>
                  <% if repeated %>
                    <span class="inline-flex ms-1 align-middle text-[10px] font-semibold uppercase tracking-wide text-amber-900 bg-amber-100 border border-amber-300 rounded px-1.5 py-0.5">
                      <%= t("inventory.stock_transfer_templates.repeated") %>
                    </span>
                  <% end %>
                  <% unless category_name %>
                    <span class="block text-xs font-normal text-gray-500 mt-0.5"><%= line.ingredient.ingredient_category.name %></span>
                  <% end %>
                </td>
                <td class="p-3 text-end tabular-nums"><%= line.default_quantity %></td>
                <td class="p-3 pe-5 text-gray-600"><%= ingredient_unit_label(line.unit.presence || line.ingredient.unit) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%= button_to t("actions.delete"), admin_inventory_stock_transfer_template_path(@template),
        method: :delete,
        form: { data: { turbo_confirm: t("inventory.stock_transfer_templates.delete_confirm", name: @template.name) } },
        class: "text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2 rounded-xl border border-red-200" %>
</div>
