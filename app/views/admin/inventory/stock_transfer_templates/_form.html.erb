<%# locals: template %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% input_class = pos_input_class %>

<%= form_with model: [:admin, :inventory, template], class: "space-y-6" do |f| %>
  <% if template.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= template.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfer_templates.form_details") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.stock_transfer_templates.form_details_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("inventory.stock_transfer_templates.name"), class: label_class %>
        <%= f.text_field :name, class: input_class, required: true,
              placeholder: t("inventory.stock_transfer_templates.name_placeholder") %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :default_from_location_id, t("inventory.stock_transfers.from_location"), class: label_class %>
          <%= f.collection_select :default_from_location_id, @locations, :id, :name,
                { include_blank: t("inventory.stock_transfer_templates.optional_location") },
                class: "#{input_class} appearance-none" %>
        </div>
        <div>
          <%= f.label :default_to_location_id, t("inventory.stock_transfers.to_location"), class: label_class %>
          <%= f.collection_select :default_to_location_id, @locations, :id, :name,
                { include_blank: t("inventory.stock_transfer_templates.optional_location") },
                class: "#{input_class} appearance-none" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :position, t("inventory.stock_transfer_templates.position"), class: label_class %>
          <%= f.number_field :position, class: input_class, min: 0 %>
        </div>
        <div class="flex items-end pb-1">
          <label class="inline-flex items-start gap-2 text-sm text-gray-700">
            <%= f.check_box :active, class: "rounded border-gray-300 mt-0.5" %>
            <span>
              <%= t("inventory.stock_transfer_templates.active") %>
              <span class="block text-xs text-gray-500 font-normal mt-0.5"><%= t("inventory.stock_transfer_templates.active_hint") %></span>
            </span>
          </label>
        </div>
      </div>

      <div>
        <%= f.label :notes, t("inventory.stock_transfer_templates.notes"), class: label_class %>
        <%= f.text_area :notes, rows: 2, class: "#{input_class} resize-y min-h-[4rem]",
              placeholder: t("inventory.stock_transfer_templates.notes_placeholder") %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden"
           data-controller="stock-transfer-lines nested-line-sortable"
           data-searchable-select-options="<%= ingredient_search_options(@ingredients) %>"
           data-stock-transfer-lines-available-units-value="<%= @ingredient_available_units.to_json %>"
           data-stock-transfer-lines-ingredient-categories-value="<%= ingredient_categories_json(@ingredients) %>"
           data-stock-transfer-lines-uncategorized-value="<%= t('inventory.stock_transfers.uncategorized') %>">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_transfer_templates.line_items") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.stock_transfer_templates.line_items_hint") %></p>
        <p class="text-xs text-gray-400 mt-0.5"><%= t("inventory.shared.drag_to_reorder_hint") %></p>
      </div>
      <button type="button"
              class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-2 rounded-xl border border-amber-200 transition-colors shrink-0"
              data-action="stock-transfer-lines#add">
        <span aria-hidden="true">+</span> <%= t("inventory.stock_transfer_templates.add_line") %>
      </button>
    </div>
    <div class="hidden sm:grid sm:grid-cols-[auto_1fr_8rem_7rem_auto] gap-4 px-5 py-3 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-100">
      <div class="w-8" aria-hidden="true"></div>
      <div><%= t("inventory.stock_transfers.ingredient") %></div>
      <div><%= t("inventory.stock_transfer_templates.default_quantity") %></div>
      <div><%= t("inventory.ingredients.alternate_units.unit") %></div>
      <div></div>
    </div>
    <div class="divide-y divide-gray-100" data-stock-transfer-lines-target="list">
      <% group_records_by_ingredient_category(template.stock_transfer_template_lines).each do |category_name, lines| %>
        <% cat = lines.first&.ingredient&.ingredient_category %>
        <%= render "admin/inventory/stock_transfers/category_header",
              name: category_name,
              count: lines.size,
              category_id: cat&.id,
              category_position: cat&.position %>
        <% lines.each do |line| %>
          <%= f.fields_for :stock_transfer_template_lines, line do |line_form| %>
            <%= render "line_fields", f: line_form %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <template data-stock-transfer-lines-target="template">
      <%= f.fields_for :stock_transfer_template_lines, StockTransferTemplateLine.new, child_index: "NEW_RECORD" do |line_form| %>
        <%= render "line_fields", f: line_form %>
      <% end %>
    </template>
  </section>

  <div class="flex flex-wrap items-center gap-3 pb-8">
    <%= f.submit template.persisted? ? t("actions.save") : t("inventory.stock_transfer_templates.create"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"),
          template.persisted? ? admin_inventory_stock_transfer_template_path(template) : admin_inventory_stock_transfer_templates_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
