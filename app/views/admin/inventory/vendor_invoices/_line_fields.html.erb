<%# locals: f (vendor invoice line fields builder) %>
<% input_class = pos_input_class %>
<% line = f.object %>
<% ingredient = line.ingredient || @ingredients.find { |i| i.id == line.ingredient_id } %>
<% unit_text = ingredient ? ingredient_unit_label(ingredient.unit) : "—" %>

<div class="px-5 py-4 lg:grid lg:grid-cols-13 lg:gap-3 lg:items-end space-y-3 lg:space-y-0"
     data-vendor-invoice-lines-target="row">
  <%= f.hidden_field :_destroy, value: false, data: { vendor_invoice_lines_target: "destroy" } %>
  <%= f.hidden_field :id %>
  <div class="lg:col-span-3">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.ingredient") %></label>
    <%= render "shared/searchable_select",
          form: f,
          field: :ingredient_id,
          selected: line.ingredient_id,
          placeholder: t("inventory.vendor_invoices.search_ingredient"),
          input_class: input_class,
          html: { data: { action: "searchable-select:change->vendor-invoice-lines#ingredientChanged" } } %>
  </div>
  <div class="lg:col-span-1 flex items-end pb-2.5">
    <div>
      <span class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.unit") %></span>
      <span class="text-sm font-semibold text-gray-700 tabular-nums"
            data-vendor-invoice-lines-target="unitLabel"><%= unit_text %></span>
    </div>
  </div>
  <div class="lg:col-span-1">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.quantity") %></label>
    <%= f.number_field :quantity, step: 0.001, min: 0, placeholder: "0", class: input_class,
          data: { action: "input->vendor-invoice-lines#recalculate" } %>
    <p class="text-xs text-gray-500 mt-1 lg:hidden"><%= t("inventory.vendor_invoices.form.quantity_unit_hint") %></p>
  </div>
  <div class="lg:col-span-1 flex items-end pb-2.5">
    <div>
      <span class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.unit_price") %></span>
      <span class="text-sm font-medium text-gray-500 tabular-nums"
            data-vendor-invoice-lines-target="unitPriceDisplay">
        <%= vendor_invoice_line_unit_price_dollars(line)&.then { |v| "ج.م. #{v}" } || "—" %>
      </span>
    </div>
  </div>
  <div class="lg:col-span-1">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.line_total") %></label>
    <%= number_field_tag "#{f.object_name}[line_total_dollars]",
          vendor_invoice_line_line_total_dollars(line),
          step: 0.01, min: 0, placeholder: "0.00", class: input_class,
          data: { vendor_invoice_lines_target: "lineTotalDollars", action: "input->vendor-invoice-lines#recalculate" } %>
  </div>
  <div class="lg:col-span-2">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.expires_on") %></label>
    <%= f.date_field :expires_on, class: input_class, data: { vendor_invoice_lines_target: "expiresOn" } %>
  </div>
  <div class="lg:col-span-2">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.batch_reference") %></label>
    <%= f.text_field :batch_reference, class: input_class %>
  </div>
  <div class="lg:col-span-1">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.line_notes") %></label>
    <%= f.text_field :line_notes, class: input_class %>
  </div>
  <div class="lg:col-span-1 flex items-end">
    <button type="button"
            class="text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-2 rounded-xl border border-red-200 transition-colors w-full lg:w-auto"
            data-action="vendor-invoice-lines#remove">
      <%= t("actions.remove") %>
    </button>
  </div>
</div>
