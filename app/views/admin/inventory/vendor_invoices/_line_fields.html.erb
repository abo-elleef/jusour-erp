<%# locals: f (vendor invoice line fields builder) %>
<% input_class = pos_input_class %>
<% line = f.object %>
<% ingredient = line.ingredient || @ingredients.find { |i| i.id == line.ingredient_id } %>
<% unit_text = ingredient ? ingredient_unit_label(ingredient.unit) : "—" %>

<% has_details = line.batch_reference.present? || line.line_notes.present? %>
<div class="px-5 py-4 space-y-3"
     data-vendor-invoice-lines-target="row"
     data-nested-line-sortable-target="row">
  <%= f.hidden_field :_destroy, value: false, data: { vendor_invoice_lines_target: "destroy" } %>
  <%= f.hidden_field :id %>
  <div class="flex gap-2 lg:gap-3 items-start">
    <div class="pt-0.5 lg:pt-7 shrink-0 w-8 flex justify-center">
      <span class="text-xs font-semibold text-gray-400 tabular-nums"
            data-vendor-invoice-lines-row-index
            aria-hidden="true">—</span>
    </div>
    <div class="pt-0.5 lg:pt-7 shrink-0">
      <%= render "admin/inventory/shared/line_drag_handle", f: f %>
    </div>
    <div class="flex-1 min-w-0 lg:grid lg:grid-cols-12 lg:gap-3 lg:items-start space-y-3 lg:space-y-0">
  <div class="lg:col-span-4">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.ingredient") %></label>
    <%= render "shared/searchable_select",
          form: f,
          field: :ingredient_id,
          selected: line.ingredient_id,
          placeholder: t("inventory.vendor_invoices.search_ingredient"),
          input_class: input_class,
          html: { data: { action: "searchable-select:change->vendor-invoice-lines#ingredientChanged" } } %>
  </div>
  <div class="lg:col-span-1">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.unit") %></label>
    <% unit_opts = ingredient ? ingredient.available_units.map { |u| [ingredient_unit_label(u), u] } : [] %>
    <%= f.select :unit,
          options_for_select(unit_opts, line.unit.presence || ingredient&.unit),
          { include_blank: ingredient.nil? },
          class: "#{input_class} appearance-none px-2",
          data: { vendor_invoice_lines_target: "unitSelect" } %>
  </div>
  <div class="lg:col-span-2">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.quantity") %></label>
    <%= f.number_field :quantity, step: 0.001, min: 0, placeholder: "0", class: input_class,
          data: { action: "input->vendor-invoice-lines#recalculate" } %>
    <p class="text-xs text-gray-500 mt-1 lg:hidden"><%= t("inventory.vendor_invoices.form.quantity_unit_hint") %></p>
  </div>
  <div class="lg:col-span-2">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.line_total") %></label>
    <%= number_field_tag "#{f.object_name}[line_total_dollars]",
          vendor_invoice_line_line_total_dollars(line),
          step: 0.01, min: 0, placeholder: "0.00", class: input_class,
          data: { vendor_invoice_lines_target: "lineTotalDollars", action: "input->vendor-invoice-lines#recalculate" } %>
    <p class="text-xs text-gray-500 mt-1">
      <%= t("inventory.vendor_invoices.form.unit_price") %>:
      <span class="font-medium tabular-nums" data-vendor-invoice-lines-target="unitPriceDisplay"><%= vendor_invoice_line_unit_price_dollars(line)&.then { |v| "ج.م. #{v}" } || "—" %></span>
    </p>
  </div>
  <div class="lg:col-span-2">
    <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("inventory.vendor_invoices.form.expires_on") %></label>
    <%= f.date_field :expires_on, class: input_class, data: { vendor_invoice_lines_target: "expiresOn" } %>
  </div>
  <div class="lg:col-span-1 flex items-end lg:items-start justify-end lg:justify-center gap-2">
    <button type="button"
            class="relative inline-flex items-center justify-center w-9 h-9 text-gray-700 hover:bg-gray-100 rounded-xl border border-gray-200 transition-colors"
            data-action="vendor-invoice-lines#openDetails"
            title="<%= t("inventory.vendor_invoices.form.batch_and_notes") %>"
            aria-label="<%= t("inventory.vendor_invoices.form.batch_and_notes") %>">
      <span aria-hidden="true">✎</span>
      <span class="absolute -top-1 -end-1 w-2.5 h-2.5 rounded-full bg-amber-500 <%= "hidden" unless has_details %>"
            data-vendor-invoice-lines-target="detailsDot"></span>
    </button>
    <button type="button"
            class="inline-flex items-center justify-center w-9 h-9 text-red-700 hover:bg-red-50 rounded-xl border border-red-200 transition-colors"
            data-action="vendor-invoice-lines#remove"
            title="<%= t("actions.remove") %>"
            aria-label="<%= t("actions.remove") %>">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>
    </div>
  </div>

  <%# Batch reference & line notes modal — fields stay inside the form so they submit normally %>
  <div class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4"
       data-vendor-invoice-lines-target="detailsModal">
    <div class="absolute inset-0 bg-black/40" data-action="click->vendor-invoice-lines#closeDetails"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md p-5 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.form.batch_and_notes") %></h3>
        <button type="button" class="text-gray-400 hover:text-gray-700 text-xl leading-none"
                data-action="vendor-invoice-lines#closeDetails" aria-label="<%= t("actions.close") %>">×</button>
      </div>
      <div>
        <%= f.label :batch_reference, t("inventory.vendor_invoices.form.batch_reference"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= f.text_field :batch_reference, class: input_class %>
      </div>
      <div>
        <%= f.label :line_notes, t("inventory.vendor_invoices.form.line_notes"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= f.text_area :line_notes, rows: 3, class: "#{input_class} resize-y" %>
      </div>
      <div class="flex justify-end">
        <button type="button"
                class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2 rounded-xl transition-colors"
                data-action="vendor-invoice-lines#closeDetails">
          <%= t("actions.done") %>
        </button>
      </div>
    </div>
  </div>
</div>
