<% table_head = "border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide" %>
<% pay_label, pay_class = vendor_invoice_payment_badge(@vendor_invoice.payment_status) %>

<div class="max-w-5xl">
  <div class="mb-4">
    <%= link_to t("inventory.vendor_invoices.back_to_list"), admin_inventory_vendor_invoices_path,
          class: "text-sm text-gray-600 hover:text-gray-900 transition-colors" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @vendor_invoice.invoice_number %></h1>
        <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= pay_class %>"><%= pay_label %></span>
      </div>
      <p class="text-gray-600 text-sm mt-1">
        <%= link_to @vendor_invoice.supplier.name, admin_inventory_supplier_path(@vendor_invoice.supplier),
              class: "font-medium text-amber-700 hover:text-amber-800" %>
        · <%= t("inventory.vendor_invoices.invoice_date") %> <%= l(@vendor_invoice.invoice_date) %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <% if @vendor_invoice.amount_paid_cents.zero? && !@vendor_invoice.void? %>
        <%= button_to t("inventory.vendor_invoices.void"),
              void_admin_inventory_vendor_invoice_path(@vendor_invoice),
              method: :patch,
              form: { data: { turbo_confirm: t("inventory.vendor_invoices.void_confirm") } },
              class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors" %>
      <% end %>
    </div>
  </div>

  <%= render "admin/inventory/tools_nav" %>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@vendor_invoice.total_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.amount_paid") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@vendor_invoice.amount_paid_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.balance_due") %></p>
      <p class="text-2xl font-bold mt-1 <%= @vendor_invoice.payable? ? 'text-amber-700' : 'text-gray-900' %> tabular-nums">
        <%= format_money(@vendor_invoice.balance_due_cents) %>
      </p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.received_on") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= l(@vendor_invoice.received_on) %></p>
    </div>
  </div>

  <% if @vendor_invoice.payable? %>
    <section class="rounded-2xl border border-amber-200 bg-amber-50/40 overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-amber-100">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.record_payment_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.vendor_invoices.record_payment_hint") %></p>
      </div>
      <%= form_with url: record_payment_admin_inventory_vendor_invoice_path(@vendor_invoice), method: :post, class: "p-5 flex flex-wrap items-end gap-4" do %>
        <div class="min-w-[10rem]">
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.vendor_invoices.payment_amount") %></label>
          <%= number_field_tag :payment_amount_dollars,
                vendor_invoice_balance_due_dollars(@vendor_invoice),
                step: 0.01, min: 0.01,
                max: vendor_invoice_balance_due_dollars(@vendor_invoice),
                class: pos_input_class %>
        </div>
        <div class="min-w-[12rem]">
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.vendor_invoices.payment_date") %></label>
          <%= date_field_tag :payment_date, Date.current, class: pos_input_class %>
        </div>
        <div class="min-w-[12rem]">
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.vendor_invoices.pay_from_treasury") %></label>
          <%= select_tag :treasury_id, options_from_collection_for_select(@treasuries, :id, :name, Treasury.default_treasury&.id),
                class: "#{pos_input_class} appearance-none" %>
        </div>
        <%= submit_tag t("inventory.vendor_invoices.record_payment_button"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </section>
  <% end %>

  <% if @payments.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.payments_heading") %></h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[32rem]">
          <thead class="<%= table_head %>">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("inventory.vendor_invoices.payment_date") %></th>
              <th class="p-3 text-end"><%= t("inventory.vendor_invoices.payment_amount") %></th>
              <th class="p-3 text-start"><%= t("inventory.vendor_invoices.pay_from_treasury") %></th>
              <th class="p-3 pe-5 text-start"><%= t("inventory.vendor_invoices.recorded_by") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @payments.each do |payment| %>
              <tr class="hover:bg-gray-50/60 transition-colors">
                <td class="p-3 ps-5 tabular-nums"><%= l(payment.payment_date) %></td>
                <td class="p-3 text-end tabular-nums font-semibold"><%= format_money(payment.amount_cents) %></td>
                <td class="p-3 text-gray-700"><%= payment.treasury.name %></td>
                <td class="p-3 pe-5 text-gray-700"><%= payment.user.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @vendor_invoice.notes.present? %>
    <section class="rounded-2xl border border-gray-200 bg-white px-5 py-4 mb-6">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5"><%= t("inventory.vendor_invoices.notes") %></p>
      <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @vendor_invoice.notes %></p>
    </section>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.form.line_items") %></h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm min-w-[36rem]">
        <thead class="<%= table_head %>">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("inventory.vendor_invoices.form.ingredient") %></th>
            <th class="p-3 text-end"><%= t("inventory.vendor_invoices.form.quantity") %></th>
            <th class="p-3 text-end"><%= t("inventory.vendor_invoices.form.unit_price") %></th>
            <th class="p-3 text-end"><%= t("inventory.vendor_invoices.total") %></th>
            <th class="p-3 pe-5 text-start"><%= t("inventory.vendor_invoices.form.batch_reference") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @lines.each do |line| %>
            <tr class="hover:bg-gray-50/60 transition-colors">
              <td class="p-3 ps-5">
                <%= link_to line.ingredient.name, admin_inventory_ingredient_path(line.ingredient), class: "font-semibold text-amber-700 hover:text-amber-800" %>
              </td>
              <td class="p-3 text-end tabular-nums"><%= line.quantity %> <%= ingredient_unit_label(line.ingredient.unit) %></td>
              <td class="p-3 text-end tabular-nums"><%= format_money(line.unit_price_cents) %></td>
              <td class="p-3 text-end tabular-nums font-semibold"><%= format_money(line.line_total_cents) %></td>
              <td class="p-3 pe-5 text-gray-600"><%= line.batch_reference.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
