<% content_for :title, @vendor_invoice.invoice_number %>
<% table_head = "border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide" %>
<% pay_label, pay_class = vendor_invoice_payment_badge(@vendor_invoice.payment_status) %>

<%= render "admin/inventory/tools_nav" %>
<div class="max-w-7xl">

  <div class="print-only mb-6 pb-4 border-b border-gray-300">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-sm text-gray-600"><%= t("inventory.vendor_invoices.print_document_title") %> · <%= @vendor_invoice.invoice_number %></p>
    <p class="text-xs text-gray-500 mt-1"><%= t("inventory.vendor_invoices.printed_at", at: l(Time.current, format: :short)) %></p>
  </div>

  <%# ── 1. Header ────────────────────────────────────────────────────────── %>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @vendor_invoice.invoice_number %></h1>
        <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= pay_class %>"><%= pay_label %></span>
      </div>
      <p class="text-gray-600 text-sm mt-1 print-hide">
        <%= link_to @vendor_invoice.supplier.name, admin_inventory_supplier_path(@vendor_invoice.supplier),
              class: "font-medium text-amber-700 hover:text-amber-800" %>
        · <%= t("inventory.vendor_invoices.invoice_date") %> <%= l(@vendor_invoice.invoice_date) %>
        <% if @vendor_invoice.location %>
          · <%= t("inventory.vendor_invoices.received_at") %>
          <%= link_to @vendor_invoice.location.name, admin_location_path(@vendor_invoice.location),
                class: "font-medium text-amber-700 hover:text-amber-800" %>
        <% end %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0 print-hide">
      <div class="inline-flex items-stretch rounded-xl border border-gray-200 overflow-hidden">
        <% if @prev_invoice %>
          <%= link_to admin_inventory_vendor_invoice_path(@prev_invoice),
                class: "inline-flex items-center gap-1 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-3 py-2.5 transition-colors",
                title: @prev_invoice.invoice_number do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 rtl:-scale-x-100" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"/>
            </svg>
            <%= t("inventory.vendor_invoices.previous") %>
          <% end %>
        <% else %>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-gray-300 px-3 py-2.5 cursor-not-allowed">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 rtl:-scale-x-100" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"/>
            </svg>
            <%= t("inventory.vendor_invoices.previous") %>
          </span>
        <% end %>
        <span class="w-px bg-gray-200" aria-hidden="true"></span>
        <% if @next_invoice %>
          <%= link_to admin_inventory_vendor_invoice_path(@next_invoice),
                class: "inline-flex items-center gap-1 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-3 py-2.5 transition-colors",
                title: @next_invoice.invoice_number do %>
            <%= t("inventory.vendor_invoices.next") %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 rtl:-scale-x-100" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
            </svg>
          <% end %>
        <% else %>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-gray-300 px-3 py-2.5 cursor-not-allowed">
            <%= t("inventory.vendor_invoices.next") %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 rtl:-scale-x-100" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
            </svg>
          </span>
        <% end %>
      </div>
      <button type="button" onclick="window.print()"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0 1 18 8.653v4.097A2.25 2.25 0 0 1 15.75 15h-.241l.305 1.984A1.75 1.75 0 0 1 14.084 19H5.916a1.75 1.75 0 0 1-1.73-2.016L4.491 15H4.25A2.25 2.25 0 0 1 2 12.75V8.653c0-1.082.775-2.034 1.874-2.198.374-.056.75-.107 1.126-.153V2.75Zm8.5 3.397a41.533 41.533 0 0 0-7 0V2.75a.25.25 0 0 1 .25-.25h6.5a.25.25 0 0 1 .25.25v3.397ZM6.608 12.5a.25.25 0 0 0-.247.212l-.693 4.5a.25.25 0 0 0 .247.288h8.168a.25.25 0 0 0 .247-.288l-.693-4.5a.25.25 0 0 0-.247-.212H6.608Z" clip-rule="evenodd" />
        </svg>
        <%= t("inventory.vendor_invoices.print") %>
      </button>
      <%= link_to export_admin_inventory_vendor_invoice_path(@vendor_invoice, format: :csv),
            class: "inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:bg-emerald-50 px-4 py-2.5 rounded-xl border border-emerald-200 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z" />
          <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z" />
        </svg>
        <%= t("inventory.vendor_invoices.export") %>
      <% end %>
      <% if @vendor_invoice.fully_editable? %>
        <%= link_to t("actions.edit"), edit_admin_inventory_vendor_invoice_path(@vendor_invoice),
              class: "inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
      <% elsif @vendor_invoice.editable? && !@vendor_invoice.stock_intact_for_edit? %>
        <span class="inline-flex text-xs text-amber-800 bg-amber-50 border border-amber-200 px-3 py-2 rounded-xl">
          <%= t("inventory.vendor_invoices.errors.stock_consumed_blocked") %>
        </span>
      <% end %>
      <% if !@vendor_invoice.void? %>
        <%= button_to t("inventory.vendor_invoices.void"),
              void_admin_inventory_vendor_invoice_path(@vendor_invoice),
              method: :patch,
              form: { data: { turbo_confirm: t("inventory.vendor_invoices.void_confirm") } },
              class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors" %>
      <% end %>
    </div>
  </div>

  <%# ── 2. Stats grid ─────────────────────────────────────────────────────── %>
  <%# Print-only details table (cards don't print well). %>
  <div class="print-only mb-6">
    <table class="w-full text-sm border border-gray-300 border-collapse">
      <tbody>
        <% [
             [t("inventory.vendor_invoices.supplier"), @vendor_invoice.supplier.name],
             [t("inventory.vendor_invoices.invoice_date"), l(@vendor_invoice.invoice_date)],
             (@vendor_invoice.location ? [t("inventory.vendor_invoices.received_at"), @vendor_invoice.location.name] : nil),
             [t("inventory.vendor_invoices.received_on"), l(@vendor_invoice.received_on)],
             [t("inventory.vendor_invoices.subtotal"), format_money(@vendor_invoice.subtotal_cents)],
             [t("inventory.vendor_invoices.total"), format_money(@vendor_invoice.total_cents)]
           ].compact.each do |label, value| %>
          <tr class="border-b border-gray-200">
            <th class="text-start p-2 font-semibold text-gray-600 bg-gray-50 w-1/3"><%= label %></th>
            <td class="p-2 text-gray-900 tabular-nums"><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mb-6 print-hide">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.subtotal") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@vendor_invoice.subtotal_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@vendor_invoice.total_cents) %></p>
      <% if @vendor_invoice.discounted? %>
        <p class="text-xs text-emerald-700 mt-1">
          <%= vendor_invoice_discount_label(@vendor_invoice) %>
          · -<%= format_money(@vendor_invoice.discount_cents) %>
        </p>
      <% end %>
      <% if @vendor_invoice.adjusted? %>
        <p class="text-xs text-blue-700 mt-1">
          <%= t("inventory.vendor_invoices.adjustment_applied") %>
          · <%= @vendor_invoice.adjustment_cents.positive? ? "+" : "" %><%= format_money(@vendor_invoice.adjustment_cents) %>
        </p>
      <% end %>
    </div>
    <div class="rounded-2xl border border-violet-200 bg-violet-50/50 p-4">
      <p class="text-xs font-semibold text-violet-700 uppercase tracking-wide"><%= t("inventory.vendor_invoices.freight") %></p>
      <% if @freight_expense %>
        <p class="text-2xl font-bold mt-1 text-violet-900 tabular-nums"><%= format_money(@freight_expense.amount_cents) %></p>
        <p class="text-xs text-violet-800 mt-1">
          <%= @freight_expense.treasury.name %>
          <% if current_user.can?("accounting:transactions") %>
            · <%= link_to t("inventory.vendor_invoices.view_freight_expense"),
                  admin_accounting_expense_path(@freight_expense),
                  class: "font-medium underline underline-offset-2 hover:text-violet-950" %>
          <% end %>
        </p>
      <% else %>
        <p class="text-2xl font-bold mt-1 text-gray-400 tabular-nums"><%= format_money(0) %></p>
        <p class="text-xs text-gray-500 mt-1"><%= t("inventory.vendor_invoices.freight_none") %></p>
      <% end %>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4 print-hide">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.amount_paid") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@vendor_invoice.amount_paid_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4 print-hide">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.balance_due") %></p>
      <p class="text-2xl font-bold mt-1 <%= @vendor_invoice.payable? ? 'text-amber-700' : 'text-gray-900' %> tabular-nums">
        <%= format_money(@vendor_invoice.balance_due_cents) %>
      </p>
    </div>
  </div>

  <%# ── 3. Payment form ───────────────────────────────────────────────────── %>
  <% if @vendor_invoice.payable? %>
    <section class="rounded-2xl border border-amber-200 bg-amber-50/40 overflow-hidden mb-6 print-hide">
      <div class="px-5 py-4 border-b border-amber-100">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.record_payment_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.vendor_invoices.record_payment_hint") %></p>
      </div>
      <%= form_with url: record_payment_admin_inventory_vendor_invoice_path(@vendor_invoice), method: :post, class: "p-5 flex flex-wrap items-end gap-4" do %>
        <div class="min-w-[10rem]">
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.vendor_invoices.payment_amount") %></label>
          <%= number_field_tag :payment_amount_dollars,
                vendor_invoice_balance_due_dollars(@vendor_invoice),
                step: 0.01, min: 0.01,
                max: vendor_invoice_balance_due_dollars(@vendor_invoice),
                class: pos_input_class %>
        </div>
        <div class="min-w-[12rem]">
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.vendor_invoices.payment_date") %></label>
          <%= date_field_tag :payment_date, Date.current, class: pos_input_class %>
        </div>
        <div class="min-w-[12rem]">
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.vendor_invoices.pay_from_treasury") %></label>
          <%= select_tag :treasury_id, options_from_collection_for_select(@treasuries, :id, :name, Treasury.default_treasury&.id),
                class: "#{pos_input_class} appearance-none" %>
        </div>
        <%= submit_tag t("inventory.vendor_invoices.record_payment_button"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </section>
  <% end %>

  <%# ── 4. Line items — HERO ──────────────────────────────────────────────── %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.form.line_items") %></h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm min-w-[42rem]">
        <thead class="<%= table_head %>">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("inventory.vendor_invoices.form.ingredient") %></th>
            <th class="p-3 text-end"><%= t("inventory.vendor_invoices.form.quantity") %></th>
            <th class="p-3 text-start"><%= t("inventory.vendor_invoices.form.unit") %></th>
            <th class="p-3 text-end"><%= t("inventory.vendor_invoices.form.unit_price") %></th>
            <th class="p-3 text-end"><%= t("inventory.vendor_invoices.total") %></th>
            <th class="p-3 pe-5 text-start"><%= t("inventory.vendor_invoices.form.batch_reference") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @lines.each do |line| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="p-3 ps-5">
                <%= link_to line.ingredient.name, admin_inventory_ingredient_path(line.ingredient),
                      class: "font-semibold text-amber-700 hover:text-amber-800" %>
              </td>
              <% received_unit = line.unit.presence || line.ingredient.unit %>
              <% converted = line.unit.present? && line.unit != line.ingredient.unit %>
              <td class="p-3 text-end tabular-nums">
                <%= line.quantity %>
                <% if converted %>
                  <span class="block text-xs text-gray-500">= <%= number_with_precision(line.base_quantity, precision: 3, strip_insignificant_zeros: true) %></span>
                <% end %>
              </td>
              <td class="p-3 text-gray-700">
                <%= ingredient_unit_label(received_unit) %>
                <% if converted %>
                  <span class="block text-xs text-gray-500"><%= ingredient_unit_label(line.ingredient.unit) %></span>
                <% end %>
              </td>
              <td class="p-3 text-end tabular-nums"><%= format_money(line.unit_price_cents) %></td>
              <td class="p-3 text-end tabular-nums font-semibold"><%= format_money(line.line_total_cents) %></td>
              <td class="p-3 pe-5 text-gray-600"><%= line.batch_reference.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%# ── 5. Payments | Journal Entries ─────────────────────────────────────── %>
  <% show_payments = @payments.any? %>
  <% show_jes      = @invoice_je.present? || @payment_jes.any? %>
  <% if show_payments || show_jes %>
    <div class="<%= (show_payments && show_jes) ? 'grid grid-cols-1 lg:grid-cols-2 gap-6' : '' %> mb-6 print-hide">

      <% if show_payments %>
        <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
            <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.payments_heading") %></h2>
          </div>
          <table class="w-full text-sm">
            <thead class="<%= table_head %>">
              <tr>
                <th class="p-3 ps-5 text-start"><%= t("inventory.vendor_invoices.payment_date") %></th>
                <th class="p-3 text-end"><%= t("inventory.vendor_invoices.payment_amount") %></th>
                <th class="p-3 text-start"><%= t("inventory.vendor_invoices.pay_from_treasury") %></th>
                <th class="p-3 pe-5 text-start"><%= t("inventory.vendor_invoices.recorded_by") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @payments.each do |payment| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-3 ps-5 tabular-nums"><%= l(payment.payment_date) %></td>
                  <td class="p-3 text-end tabular-nums font-semibold"><%= format_money(payment.amount_cents) %></td>
                  <td class="p-3 text-gray-700"><%= payment.treasury.name %></td>
                  <td class="p-3 pe-5 text-gray-700"><%= payment.user.name %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      <% end %>

      <% if show_jes %>
        <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
            <h2 class="text-sm font-semibold text-gray-900"><%= t("accounting.shared.journal_entries_heading") %></h2>
          </div>
          <table class="w-full text-sm">
            <thead class="<%= table_head %>">
              <tr>
                <th class="p-3 ps-5 text-start"><%= t("accounting.journal_entries.col.type") %></th>
                <th class="p-3 text-start"><%= t("accounting.journal_entries.col.number") %></th>
                <th class="p-3 text-start"><%= t("accounting.journal_entries.col.date") %></th>
                <th class="p-3 pe-5 text-end"><%= t("accounting.shared.amount") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if @invoice_je %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-3 ps-5 text-xs text-gray-600"><%= t("accounting.shared.invoice_je_label") %></td>
                  <td class="p-3">
                    <%= link_to @invoice_je.entry_number, admin_accounting_journal_entry_path(@invoice_je),
                          class: "font-mono text-xs text-amber-700 hover:text-amber-800 hover:underline" %>
                  </td>
                  <td class="p-3 text-gray-600"><%= l(@invoice_je.date) %></td>
                  <td class="p-3 pe-5 text-end font-semibold tabular-nums"><%= format_money(@invoice_je.total_debits_cents) %></td>
                </tr>
              <% end %>
              <% @payments.each do |payment| %>
                <% je = @payment_jes[payment.id] %>
                <% next unless je %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-3 ps-5 text-xs text-gray-600"><%= t("accounting.shared.payment_je_label") %></td>
                  <td class="p-3">
                    <%= link_to je.entry_number, admin_accounting_journal_entry_path(je),
                          class: "font-mono text-xs text-amber-700 hover:text-amber-800 hover:underline" %>
                  </td>
                  <td class="p-3 text-gray-600"><%= l(je.date) %></td>
                  <td class="p-3 pe-5 text-end font-semibold tabular-nums"><%= format_money(je.total_debits_cents) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      <% end %>

    </div>
  <% end %>

  <%# ── 6. Notes | Invoice image ───────────────────────────────────────────── %>
  <% has_notes        = @vendor_invoice.notes.present? || @vendor_invoice.discount_notes.present? %>
  <% show_image       = !@vendor_invoice.void? || @vendor_invoice.invoice_image.attached? %>
  <% if has_notes || show_image %>
    <div class="<%= (has_notes && show_image) ? 'grid grid-cols-1 lg:grid-cols-2 gap-6' : '' %>">

      <% if has_notes %>
        <section class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2"><%= t("inventory.vendor_invoices.notes") %></p>
          <% if @vendor_invoice.notes.present? %>
            <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @vendor_invoice.notes %></p>
          <% end %>
          <% if @vendor_invoice.discount_notes.present? %>
            <p class="text-sm text-emerald-700 whitespace-pre-wrap <%= @vendor_invoice.notes.present? ? 'mt-2 pt-2 border-t border-gray-100' : '' %>">
              <%= t("inventory.vendor_invoices.discount_applied") %>: <%= @vendor_invoice.discount_notes %>
            </p>
          <% end %>
        </section>
      <% end %>

      <% if show_image %>
        <% if @vendor_invoice.void? %>
          <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden print-hide">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
              <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.invoice_image") %></h2>
            </div>
            <div class="p-5">
              <%= link_to url_for(@vendor_invoice.invoice_image), target: "_blank", rel: "noopener" do %>
                <%= image_tag @vendor_invoice.invoice_image, class: "max-h-96 w-full object-contain rounded-xl border border-gray-200" %>
              <% end %>
            </div>
          </section>
        <% else %>
          <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden print-hide">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
              <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.invoice_image") %></h2>
              <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.vendor_invoices.invoice_image_show_hint") %></p>
            </div>
            <div class="p-5 space-y-5">
              <% if @vendor_invoice.invoice_image.attached? %>
                <%= link_to url_for(@vendor_invoice.invoice_image), target: "_blank", rel: "noopener" do %>
                  <%= image_tag @vendor_invoice.invoice_image, class: "max-h-96 w-full object-contain rounded-xl border border-gray-200" %>
                <% end %>
              <% end %>
              <% submit_label = @vendor_invoice.invoice_image.attached? ? t("inventory.vendor_invoices.invoice_image_replace") : t("inventory.vendor_invoices.invoice_image_attach") %>
              <div data-controller="image-preview">
                <%= form_with url: attach_invoice_image_admin_inventory_vendor_invoice_path(@vendor_invoice),
                      method: :patch,
                      html: { multipart: true, class: "flex flex-wrap items-end gap-4" } do %>
                  <div class="min-w-[12rem] flex-1">
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("inventory.vendor_invoices.invoice_image") %></label>
                    <%= file_field_tag "vendor_invoice[invoice_image]", accept: "image/*", capture: "environment",
                          class: "text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200",
                          data: { image_preview_target: "input", action: "change->image-preview#preview" } %>
                    <div class="mt-3">
                      <img data-image-preview-target="preview"
                           alt="<%= t("inventory.vendor_invoices.invoice_image") %>"
                           class="hidden max-h-48 rounded-xl border border-gray-200 object-contain">
                    </div>
                  </div>
                  <%= submit_tag submit_label,
                        class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" %>
                <% end %>
              </div>
            </div>
          </section>
        <% end %>
      <% end %>

    </div>
  <% end %>

</div>
