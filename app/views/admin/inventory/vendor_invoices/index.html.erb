<% content_for :title, admin_page_title %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% table_head = "border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide" %>

<%= render "admin/inventory/tools_nav" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.vendor_invoices.index_description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to new_admin_inventory_vendor_invoice_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" do %>
        <span aria-hidden="true">+</span> <%= t("inventory.vendor_invoices.new_button") %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <%= link_to admin_inventory_vendor_invoices_path,
          class: orders_stat_card_class(@q.payment_status_eq.blank? && !@filtered) do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.stats.total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @total_count %></p>
    <% end %>
    <%= link_to admin_inventory_vendor_invoices_path(q: { payment_status_eq: "unpaid" }),
          class: orders_stat_card_class(@q.payment_status_eq == "unpaid") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.stats.unpaid") %></p>
      <p class="text-2xl font-bold mt-1 text-amber-700 tabular-nums"><%= @unpaid_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.vendor_invoices.stats.outstanding_balance", amount: format_money(@outstanding_total_cents)) %></p>
    <% end %>
    <%= link_to admin_inventory_vendor_invoices_path(q: { payment_status_eq: "partially_paid" }),
          class: orders_stat_card_class(@q.payment_status_eq == "partially_paid") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.stats.partially_paid") %></p>
      <p class="text-2xl font-bold mt-1 text-blue-700 tabular-nums"><%= @partially_paid_count %></p>
    <% end %>
    <%= link_to admin_inventory_vendor_invoices_path(q: { payment_status_eq: "paid" }),
          class: orders_stat_card_class(@q.payment_status_eq == "paid") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.vendor_invoices.stats.paid") %></p>
      <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= @paid_count %></p>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.filters") %></h2>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_inventory_vendor_invoices_path, method: :get,
            class: "flex flex-wrap items-end gap-4" do |f| %>
        <div class="flex-1 min-w-[10rem]">
          <%= f.label :invoice_number_cont, t("inventory.vendor_invoices.invoice_number"), class: label_class %>
          <%= f.search_field :invoice_number_cont, class: pos_input_class %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :supplier_id_eq, t("inventory.vendor_invoices.supplier"), class: label_class %>
          <%= f.collection_select :supplier_id_eq, @suppliers, :id, :name,
                { include_blank: t("inventory.vendor_invoices.all_suppliers") },
                class: "#{pos_input_class} appearance-none" %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :payment_status_eq, t("inventory.vendor_invoices.payment_status"), class: label_class %>
          <%= f.select :payment_status_eq,
                options_for_select(
                  [[t("inventory.vendor_invoices.all_statuses"), ""]] +
                    VendorInvoice::PAYMENT_STATUSES.map { |s| [t("inventory.vendor_invoices.payment_statuses.#{s}"), s] },
                  @q.payment_status_eq
                ), {}, class: "#{pos_input_class} appearance-none" %>
        </div>
        <%= f.submit t("actions.apply_filters"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </div>
  </section>

  <% if @vendor_invoices.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[40rem]">
          <thead class="<%= table_head %>">
            <tr>
              <th class="p-3 ps-5 text-start w-12 text-gray-400"><%= t("shared.row_index") %></th>
              <th class="p-3 text-start"><%= t("inventory.vendor_invoices.invoice_number") %></th>
              <th class="p-3 text-start"><%= t("inventory.vendor_invoices.supplier") %></th>
              <th class="p-3 text-start"><%= t("inventory.vendor_invoices.location") %></th>
              <th class="p-3 text-start"><%= t("inventory.vendor_invoices.invoice_date") %></th>
              <th class="p-3 text-start"><%= t("inventory.vendor_invoices.recorded_by") %></th>
              <th class="p-3 text-start"><%= t("inventory.vendor_invoices.payment_status") %></th>
              <th class="p-3 text-end"><%= t("inventory.vendor_invoices.total") %></th>
              <th class="p-3 pe-5 text-end"><%= t("customers.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @vendor_invoices.each_with_index do |invoice, index| %>
              <% pay_label, pay_class = vendor_invoice_payment_badge(invoice.payment_status) %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5 text-gray-400 tabular-nums"><%= table_row_number(index, pagy: @pagy) %></td>
                <td class="p-3">
                  <%= link_to invoice.invoice_number, admin_inventory_vendor_invoice_path(invoice),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                </td>
                <td class="p-3"><%= invoice.supplier.name %></td>
                <td class="p-3 text-gray-600"><%= invoice.location&.name || "—" %></td>
                <td class="p-3 tabular-nums text-gray-600"><%= l(invoice.invoice_date) %></td>
                <td class="p-3 text-gray-600"><%= invoice.user&.name || t("accounting.shared.em_dash") %></td>
                <td class="p-3">
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= pay_class %>"><%= pay_label %></span>
                </td>
                <td class="p-3 text-end font-semibold tabular-nums"><%= format_money(invoice.total_cents) %></td>
                <td class="p-3 pe-5 text-end">
                  <%= link_to t("actions.view"), admin_inventory_vendor_invoice_path(invoice),
                        class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.vendor_invoices.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("inventory.vendor_invoices.empty_description") %></p>
      <%= link_to t("inventory.vendor_invoices.new_button"), new_admin_inventory_vendor_invoice_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% end %>
</div>
