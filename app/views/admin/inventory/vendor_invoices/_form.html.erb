<%# locals: vendor_invoice %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% active_lines = vendor_invoice.vendor_invoice_lines.reject(&:marked_for_destruction?).select { |l| l.ingredient_id.present? } %>
<% estimated_cents = active_lines.sum { |l| l.line_total_cents.to_i } %>

<%= form_with model: [:admin, :inventory, vendor_invoice],
      class: "space-y-6",
      html: { multipart: true },
      data: {
        controller: "vendor-invoice-lines nested-line-sortable",
        searchable_select_options: ingredient_search_options(@ingredients, vendor_aliases: true),
        vendor_invoice_lines_available_units_value: @ingredient_available_units.to_json,
        vendor_invoice_lines_shelf_life_days_value: @ingredient_shelf_life_days.to_json,
        vendor_invoice_lines_unit_price_dollars_value: @ingredient_unit_price_dollars.to_json,
        vendor_invoice_lines_line_count_one_value: t("inventory.shared.visible_line_count.one", count: "__COUNT__").gsub("__COUNT__", "%{count}"),
        vendor_invoice_lines_line_count_other_value: t("inventory.shared.visible_line_count.other", count: "__COUNT__").gsub("__COUNT__", "%{count}")
      } do |f| %>
  <% if vendor_invoice.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= vendor_invoice.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.form.invoice_details") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.vendor_invoices.form.invoice_details_hint") %></p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :supplier_id, t("inventory.vendor_invoices.supplier"), class: label_class %>
        <%= f.collection_select :supplier_id, @suppliers, :id, :name, { prompt: t("inventory.vendor_invoices.select_supplier") }, class: "#{input_class} appearance-none" %>
      </div>
      <div>
        <%= f.label :location_id, t("inventory.vendor_invoices.location"), class: label_class %>
        <%= f.collection_select :location_id, @locations, :id, :name,
              { prompt: t("inventory.vendor_invoices.select_location") },
              class: "#{input_class} appearance-none", required: true %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.vendor_invoices.location_hint") %></p>
      </div>
      <div>
        <%= f.label :invoice_number, t("inventory.vendor_invoices.invoice_number"), class: label_class %>
        <%= f.text_field :invoice_number, class: input_class, placeholder: t("inventory.vendor_invoices.invoice_number_placeholder") %>
        <% if vendor_invoice.new_record? %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.vendor_invoices.invoice_number_auto_hint") %></p>
        <% end %>
      </div>
      <div>
        <%= f.label :invoice_date, t("inventory.vendor_invoices.invoice_date"), class: label_class %>
        <%= f.date_field :invoice_date, class: input_class %>
      </div>
      <div>
        <%= f.label :received_on, t("inventory.vendor_invoices.received_on"), class: label_class %>
        <%= f.date_field :received_on, class: input_class,
              data: { action: "change->vendor-invoice-lines#receivedOnChanged" } %>
      </div>
      <div>
        <%= f.label :notes, t("inventory.vendor_invoices.notes"), class: label_class %>
        <%= f.text_area :notes, rows: 2, class: "#{input_class} resize-y min-h-[4rem]" %>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden"
           data-controller="vendor-invoice-discount">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.form.discount") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.vendor_invoices.form.discount_hint") %></p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :discount_type, t("inventory.vendor_invoices.discount_type"), class: label_class %>
        <%= f.select :discount_type,
              options_for_select(
                [[t("inventory.vendor_invoices.discount_none"), ""]] +
                  VendorInvoice::DISCOUNT_TYPES.map { |type| [t("inventory.vendor_invoices.discount_types.#{type}"), type] },
                vendor_invoice.discount_type
              ),
              {},
              class: "#{input_class} appearance-none",
              data: { vendor_invoice_discount_target: "type", action: "change->vendor-invoice-discount#typeChanged change->vendor-invoice-lines#recalculate" } %>
      </div>
      <div data-vendor-invoice-discount-target="percentageWrap"
           class="<%= "hidden" unless vendor_invoice.discount_type == "percentage" %>">
        <%= f.label :discount_value, t("inventory.vendor_invoices.discount_percentage"), class: label_class %>
        <%= f.number_field :discount_value,
              value: vendor_invoice.discount_type == "percentage" ? vendor_invoice.discount_value : nil,
              step: 0.01, min: 0, max: 100,
              class: input_class,
              data: { vendor_invoice_discount_target: "percentageInput percentageField", action: "input->vendor-invoice-lines#recalculate" },
              disabled: vendor_invoice.discount_type != "percentage" %>
      </div>
      <div data-vendor-invoice-discount-target="fixedWrap"
           class="<%= "hidden" unless vendor_invoice.discount_type == "fixed_amount" %>">
        <%= label_tag :discount_amount_dollars, t("inventory.vendor_invoices.discount_amount"), class: label_class %>
        <%= number_field_tag "vendor_invoice[discount_amount_dollars]",
              vendor_invoice_discount_amount_dollars(vendor_invoice),
              step: 0.01, min: 0,
              class: input_class,
              data: { vendor_invoice_discount_target: "fixedInput fixedField", action: "input->vendor-invoice-lines#recalculate" },
              disabled: vendor_invoice.discount_type != "fixed_amount" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :discount_notes, t("inventory.vendor_invoices.discount_notes"), class: label_class %>
        <%= f.text_area :discount_notes, rows: 2,
              class: "#{input_class} resize-y min-h-[4rem]",
              placeholder: t("inventory.vendor_invoices.discount_notes_placeholder") %>
      </div>
      <div class="sm:col-span-2 rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3 text-sm text-gray-700 space-y-1 <%= "hidden" if estimated_cents.zero? %>"
           data-vendor-invoice-lines-target="discountPreviewWrap">
        <div class="flex justify-between gap-4">
          <span><%= t("inventory.vendor_invoices.subtotal") %></span>
          <span class="font-semibold tabular-nums"
                data-vendor-invoice-lines-target="subtotalDisplay"><%= format_money(estimated_cents) %></span>
        </div>
        <% if vendor_invoice.discounted? %>
          <div class="flex justify-between gap-4 text-emerald-700">
            <span><%= vendor_invoice_discount_label(vendor_invoice) %></span>
            <span class="font-semibold tabular-nums">-<%= format_money(vendor_invoice.discount_cents) %></span>
          </div>
        <% end %>
        <div class="flex justify-between gap-4 border-t border-gray-200 pt-2 font-semibold text-gray-900">
          <span><%= t("inventory.vendor_invoices.form.supplier_payable") %></span>
          <span class="tabular-nums"
                data-vendor-invoice-lines-target="grandTotalDisplay"><%= format_money(vendor_invoice.total_cents.positive? ? vendor_invoice.total_cents : [estimated_cents - vendor_invoice.discount_cents, 0].max) %></span>
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.form.freight") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.vendor_invoices.form.freight_hint") %></p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
      <% freight = @freight_expense %>
      <% freight_amount_dollars =
           if @freight_form_amount_cents.present?
             @freight_form_amount_cents.positive? ? (@freight_form_amount_cents.to_d / 100) : nil
           elsif freight&.amount_cents.to_i&.positive?
             freight.amount_cents.to_d / 100
           end %>
      <% freight_treasury_id = @freight_form_treasury_id.presence || freight&.treasury_id || Treasury.default_treasury&.id %>
      <div>
        <%= label_tag "vendor_invoice_freight_amount_dollars",
              t("inventory.vendor_invoices.form.freight_amount"), class: label_class %>
        <%= number_field_tag "vendor_invoice[freight_amount_dollars]",
              freight_amount_dollars,
              step: 0.01,
              min: 0,
              class: input_class,
              placeholder: "0",
              data: {
                vendor_invoice_lines_target: "freightAmount",
                action: "input->vendor-invoice-lines#recalculate"
              } %>
      </div>
      <div>
        <%= label_tag "vendor_invoice_freight_treasury_id",
              t("inventory.vendor_invoices.form.freight_treasury"), class: label_class %>
        <%= select_tag "vendor_invoice[freight_treasury_id]",
              options_from_collection_for_select(
                @treasuries,
                :id,
                :name,
                freight_treasury_id
              ),
              include_blank: t("inventory.vendor_invoices.form.freight_treasury_blank"),
              class: input_class %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.vendor_invoices.form.freight_treasury_hint") %></p>
      </div>
      <div class="sm:col-span-2 rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3 text-sm text-gray-700 space-y-1">
        <div class="flex justify-between gap-4 font-semibold text-gray-900">
          <span><%= t("inventory.vendor_invoices.form.supplier_payable") %></span>
          <span class="tabular-nums"
                data-vendor-invoice-lines-target="grandTotalDisplay"><%= format_money(vendor_invoice.total_cents.positive? ? vendor_invoice.total_cents : [estimated_cents - vendor_invoice.discount_cents, 0].max) %></span>
        </div>
        <div class="flex justify-between gap-4 text-violet-800 <%= "hidden" unless freight_amount_dollars.to_d.positive? %>"
             data-vendor-invoice-lines-target="freightPreviewWrap">
          <span><%= t("inventory.vendor_invoices.form.courier_freight") %></span>
          <span class="font-semibold tabular-nums"
                data-vendor-invoice-lines-target="freightDisplay"><%= freight_amount_dollars.to_d.positive? ? format_money((freight_amount_dollars.to_d * 100).round) : format_money(0) %></span>
        </div>
      </div>
    </div>
  </section>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
      <div>
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_invoices.form.line_items") %></h2>
          <span class="text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5 tabular-nums"
                data-vendor-invoice-lines-target="lineCount"></span>
        </div>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.vendor_invoices.form.line_items_hint") %></p>
        <p class="text-xs text-gray-400 mt-0.5"><%= t("inventory.shared.drag_to_reorder_hint") %></p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <p class="text-sm text-gray-600 <%= "hidden" if estimated_cents.zero? %>"
           data-vendor-invoice-lines-target="runningTotalWrap">
          <%= t("inventory.vendor_invoices.total") %>
          <span class="font-semibold text-gray-900"
                data-vendor-invoice-lines-target="runningTotal"><%= format_money(estimated_cents) %></span>
        </p>
        <button type="button"
                class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-2 rounded-xl border border-amber-200 transition-colors shrink-0"
                data-action="vendor-invoice-lines#add">
          <span aria-hidden="true">+</span> <%= t("inventory.vendor_invoices.form.add_line") %>
        </button>
      </div>
    </div>
    <div class="overflow-y-auto max-h-[min(70vh,52rem)] overscroll-y-contain">
      <div class="hidden lg:flex lg:items-center gap-3 px-5 py-3 bg-white/95 backdrop-blur-sm text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-100 sticky top-0 z-20">
        <div class="w-8 shrink-0 text-center"><%= t("shared.row_index") %></div>
        <div class="w-8 shrink-0" aria-hidden="true"></div>
        <div class="flex-1 min-w-0 lg:grid lg:grid-cols-12 lg:gap-3">
          <div class="lg:col-span-4"><%= t("inventory.vendor_invoices.form.ingredient") %></div>
          <div class="lg:col-span-1"><%= t("inventory.vendor_invoices.form.unit") %></div>
          <div class="lg:col-span-2"><%= t("inventory.vendor_invoices.form.quantity") %></div>
          <div class="lg:col-span-2"><%= t("inventory.vendor_invoices.form.line_total") %></div>
          <div class="lg:col-span-2"><%= t("inventory.vendor_invoices.form.expires_on") %></div>
          <div class="lg:col-span-1"></div>
        </div>
      </div>
      <div class="divide-y divide-gray-100" data-vendor-invoice-lines-target="list">
        <%= f.fields_for :vendor_invoice_lines do |line_f| %>
          <%= render "line_fields", f: line_f %>
        <% end %>
      </div>
    </div>
    <template data-vendor-invoice-lines-target="template">
      <%= f.fields_for :vendor_invoice_lines, VendorInvoiceLine.new, child_index: "NEW_RECORD" do |line_f| %>
        <%= render "line_fields", f: line_f %>
      <% end %>
    </template>
  </section>

  <div class="flex flex-wrap items-center gap-3 pb-8">
    <%= f.submit vendor_invoice.persisted? ? t("inventory.vendor_invoices.form.submit_update") : t("inventory.vendor_invoices.form.submit"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"), vendor_invoice.persisted? ? admin_inventory_vendor_invoice_path(vendor_invoice) : admin_inventory_vendor_invoices_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
