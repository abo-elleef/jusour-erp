<% content_for :title, t("inventory.stock_takes.index.start_heading") %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow resize-y min-h-[4rem]" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-1"><%= t("inventory.stock_takes.index.start_heading") %></h1>
  <p class="text-gray-600 text-sm mb-6"><%= t("inventory.stock_takes.index.start_hint") %></p>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="p-5">
      <% if @stock_locations.empty? %>
        <p class="text-sm text-gray-600"><%= t("inventory.stock_takes.index.no_locations") %></p>
      <% else %>
        <%= form_with url: admin_inventory_stock_takes_path, method: :post, class: "space-y-4" do %>
          <div>
            <%= label_tag :location_id, t("inventory.stock_takes.index.location"), class: label_class %>
            <%= select_tag :location_id,
                  options_for_select(
                    @stock_locations.map { |loc| [stock_location_option_label(loc), loc.id] },
                    disabled: @locations_in_progress
                  ),
                  include_blank: t("inventory.stock_takes.index.select_location"),
                  required: true,
                  class: "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 appearance-none focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_takes.index.location_hint") %></p>
          </div>
          <div>
            <%= label_tag :supplier_id, t("inventory.stock_takes.index.supplier"), class: label_class %>
            <%= select_tag :supplier_id,
                  options_from_collection_for_select(@suppliers, :id, :name),
                  include_blank: t("inventory.stock_takes.index.all_suppliers"),
                  class: "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 appearance-none focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_takes.index.supplier_hint") %></p>
          </div>
          <div>
            <%= label_tag :count_date, t("inventory.stock_takes.index.count_date"), class: label_class %>
            <%= date_field_tag :count_date, Date.current, max: Date.current,
                  class: "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_takes.index.count_date_hint") %></p>
          </div>
          <div>
            <%= label_tag :notes, t("inventory.stock_takes.index.notes"), class: label_class %>
            <%= text_area_tag :notes, nil, rows: 2, class: input_class, placeholder: t("inventory.stock_takes.index.notes_placeholder") %>
          </div>
          <div class="flex items-center gap-3">
            <%= submit_tag t("inventory.stock_takes.index.start_button"),
                  class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
            <%= link_to t("actions.cancel"), admin_inventory_stock_takes_path,
                  class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
