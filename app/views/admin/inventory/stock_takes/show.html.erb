<% content_for :title, "#{t('inventory.stock_takes.show.title')} — #{l((@stock_take.started_at || @stock_take.created_at).to_date, format: :long)}" %>
<% input_class = "w-36 min-w-[9rem] bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-base text-gray-900 tabular-nums focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% select_class = "w-full min-w-[5.5rem] max-w-[8rem] bg-gray-50 border border-gray-200 rounded-xl px-2 py-2 text-sm text-gray-900 appearance-none focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
<% sort_opts = { sort: @sort, direction: @direction } %>

<%# ── Grouping helpers ─────────────────────────────────────────────────────── %>
<% vendor_for_item = ->(item) {
  links = item.ingredient.supplier_ingredients
  return :no_vendor if links.empty?
  return links.first.supplier if links.size == 1
  preferred = links.select(&:preferred)
  preferred.size == 1 ? preferred.first.supplier : :multiple_vendors
} %>
<% vendor_label = ->(key) {
  case key
  when :no_vendor       then t("inventory.reports.valuation.no_vendor")
  when :multiple_vendors then t("inventory.reports.valuation.multiple_vendors")
  else key.name
  end
} %>
<% grouped_items = ->(items) {
  case @group_by
  when "category"
    items.group_by { |i| i.ingredient.ingredient_category.name }
         .sort_by { |name, _| name.to_s.downcase }
  when "vendor"
    items.group_by { |i| vendor_label.call(vendor_for_item.call(i)) }
         .sort_by { |name, _| name.to_s.downcase }
  else
    { nil => items }
  end
} %>

<div class="max-w-6xl">
  <div class="mb-4">
    <%= link_to t("inventory.stock_takes.show.back_to_list"), admin_inventory_stock_takes_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.stock_takes.show.title") %></h1>
      <% if @stock_take.location %>
        <p class="text-amber-700 text-sm font-semibold mt-1"><%= @stock_take.location.name %></p>
      <% end %>
      <% if @stock_take.supplier %>
        <p class="text-gray-600 text-sm mt-0.5"><%= t("inventory.stock_takes.show.supplier_filter", name: @stock_take.supplier.name) %></p>
      <% end %>
      <p class="text-gray-600 text-sm mt-1">
        <% started_at = @stock_take.started_at || @stock_take.created_at %>
        <%= l(started_at.to_date, format: :long) %>
        · <%= l(started_at, format: :short_time) %>
        · <%= @stock_take.user.name %>
      </p>
      <% if @stock_take.notes.present? %>
        <p class="text-gray-500 text-sm mt-1"><%= @stock_take.notes %></p>
      <% end %>
    </div>
    <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full border <%= stock_take_status_class(@stock_take.status) %> <%= stock_take_status_border_class(@stock_take.status) %>">
      <%= stock_take_status_label(@stock_take.status) %>
    </span>
  </div>

  <%= render "admin/inventory/tools_nav" %>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_takes.show.stats.ingredients") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @items.size %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_takes.show.stats.variances") %></p>
      <p class="text-2xl font-bold mt-1 <%= @variance_count.positive? ? 'text-amber-700' : 'text-gray-900' %> tabular-nums">
        <%= @variance_count %>
      </p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_takes.show.stats.variances_hint") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_takes.show.stats.counted_value") %></p>
      <p class="text-2xl font-bold mt-1 tabular-nums text-gray-900">
        <%= format_money(@counted_value_cents) %>
      </p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_takes.show.stats.counted_value_hint") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_takes.show.stats.variance_value") %></p>
      <p class="text-2xl font-bold mt-1 tabular-nums <%= @variance_value_cents.negative? ? 'text-red-700' : (@variance_value_cents.positive? ? 'text-amber-700' : 'text-gray-900') %>">
        <%= format_money(@variance_value_cents) %>
      </p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.stock_takes.show.stats.variance_value_hint") %></p>
    </div>
    <% if @stock_take.completed_at %>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.stock_takes.show.stats.completed") %></p>
        <p class="text-lg font-bold mt-1 text-gray-900"><%= l(@stock_take.completed_at.to_date, format: :long) %></p>
      </div>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <div class="flex flex-wrap justify-between items-start gap-3">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_takes.show.count_sheet_heading") %></h2>
          <%# Group-by toggle %>
          <div class="flex gap-1.5 mt-2 print:hidden">
            <% [["none", t("inventory.stock_takes.show.group_none")],
                ["category", t("inventory.reports.valuation.group_by.category")],
                ["vendor", t("inventory.reports.valuation.group_by.vendor")]].each do |val, label| %>
              <%= link_to label,
                    admin_inventory_stock_take_path(@stock_take, sort: @sort, dir: @direction, group_by: (val == "none" ? nil : val)),
                    data: { action: "click->stock-take-group#switchGroup" },
                    class: "text-xs font-semibold px-3 py-1 rounded-lg border transition-colors #{@group_by == val || (val == 'none' && @group_by == 'none') ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'}" %>
            <% end %>
          </div>
        </div>
        <%# Paper for the shelf walk: the same blind sheet the vendor and category
            pages print, scoped to this take's items. %>
        <%= link_to t("inventory.stock_takes.show.print_count_sheet"),
              count_sheet_admin_inventory_stock_take_path(@stock_take),
              class: "shrink-0 inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl border border-gray-200 transition-colors print:hidden" %>
      </div>
      <p class="text-xs text-gray-500 mt-0.5">
        <% if @stock_take.status == "in_progress" %>
          <%= t("inventory.stock_takes.show.count_sheet_hint_in_progress") %>
        <% else %>
          <%= t("inventory.stock_takes.show.count_sheet_hint_completed") %>
        <% end %>
      </p>
    </div>

    <% if @stock_take.status == "in_progress" %>
      <div data-controller="stock-take-group"
           data-stock-take-group-save-url-value="<%= admin_inventory_stock_take_path(@stock_take, sort: @sort, dir: @direction, group_by: (@group_by == 'none' ? nil : @group_by)) %>">
      <%= form_with url: admin_inventory_stock_take_path(@stock_take, sort: @sort, dir: @direction, group_by: (@group_by == "none" ? nil : @group_by)), method: :patch,
            data: { "stock-take-group-target": "form" } do %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm min-w-[980px]">
            <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 pl-5 text-left w-12"><%= t("inventory.stock_takes.show.table.index") %></th>
                <th class="p-3 text-left"><%= sort_header_link(t("inventory.stock_takes.show.table.category"), :category, **sort_opts) %></th>
                <th class="p-3 text-left"><%= sort_header_link(t("inventory.stock_takes.show.table.ingredient"), :name, **sort_opts) %></th>
                <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.expected"), :expected, **sort_opts) %></th>
                <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.expected_value"), :expected_value, **sort_opts) %></th>
                <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.counted"), :counted, **sort_opts) %></th>
                <th class="p-3 text-left"><%= t("inventory.stock_takes.show.table.unit") %></th>
                <th class="p-3 text-right"><%= t("inventory.stock_takes.show.table.variance") %></th>
                <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.counted_value"), :counted_value, **sort_opts) %></th>
                <th class="p-3 pr-5 text-right"><%= t("inventory.stock_takes.show.table.variance_value") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 table-zebra">
              <% index = 0 %>
              <% grouped_items.call(@items).each do |group_name, group_items| %>
                <% if group_name %>
                  <tr class="bg-gray-100/90">
                    <td colspan="10" class="px-3 py-2 text-xs font-semibold text-gray-600 uppercase tracking-wide">
                      <%= group_name %>
                      <span class="font-normal text-gray-400 normal-case tracking-normal ms-1">(<%= group_items.size %>)</span>
                    </td>
                  </tr>
                <% end %>
              <% group_items.each do |item| %>
                <% index += 1 %>
                <% has_variance = item.variance.present? && !item.variance.to_d.zero? %>
                <% base_unit = item.ingredient.unit %>
                <% available_units = item.ingredient.available_units %>
                <% selected_unit = item.counted_unit.presence || item.ingredient.purchase_unit_record&.unit || base_unit %>
                <% unit_opts = available_units.map { |u| [ingredient_unit_label(u), u] } %>
                <% location_cost = @unit_costs[item.ingredient_id] %>
                <% expected_value_cents = item.expected_value_cents(location_cost: location_cost) %>
                <% counted_value_cents = item.counted_value_cents(location_cost: location_cost) %>
                <% variance_value_cents = item.variance_value_cents(location_cost: location_cost) %>
                <tr class="hover:bg-gray-100 transition-colors <%= 'bg-amber-50/40' if has_variance %>">
                  <td class="p-3 pl-5 text-gray-400 tabular-nums"><%= index %></td>
                  <td class="p-3 text-gray-600"><%= item.ingredient.ingredient_category.name %></td>
                  <td class="p-3">
                    <span class="inline-flex items-center gap-1.5 font-semibold text-gray-900">
                      <%= item.ingredient.name %>
                      <% unless item.ingredient.active? %>
                        <span class="inline-flex text-gray-400" title="<%= t("inventory.stock_takes.show.inactive_ingredient") %>" aria-label="<%= t("inventory.stock_takes.show.inactive_ingredient") %>">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
                            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l8.5-8.5a.75.75 0 0 0-1.06-1.06l-8.5 8.5a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
                            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm0-1.5a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13Z" clip-rule="evenodd" />
                          </svg>
                        </span>
                      <% end %>
                    </span>
                  </td>
                  <td class="p-3 text-right text-gray-600 tabular-nums whitespace-nowrap">
                    <%= item.expected_quantity %>
                    <span class="text-xs text-gray-400 ms-1"><%= ingredient_unit_label(base_unit) %></span>
                  </td>
                  <td class="p-3 text-right tabular-nums whitespace-nowrap text-gray-700">
                    <%= format_money(expected_value_cents) %>
                  </td>
                  <td class="p-3 text-right">
                    <%# type="text", not "number": a native number input silently rejects
                        Arabic-Indic digits, forcing a keyboard-language switch just to
                        type a count while searching in Arabic. The controller below
                        converts those digits to ASCII as the user types. %>
                    <%= text_field_tag "stock_take_items[#{item.id}][counted_quantity]",
                          item.counted_quantity, inputmode: "decimal", autocomplete: "off",
                          data: { controller: "arabic-numerals", action: "input->arabic-numerals#normalize" },
                          class: "#{input_class} ml-auto" %>
                  </td>
                  <td class="p-3 text-left">
                    <% if available_units.size > 1 %>
                      <%= select_tag "stock_take_items[#{item.id}][counted_unit]",
                            options_for_select(unit_opts, selected_unit),
                            class: select_class %>
                    <% else %>
                      <%= hidden_field_tag "stock_take_items[#{item.id}][counted_unit]", selected_unit %>
                      <span class="text-sm text-gray-600 whitespace-nowrap"><%= ingredient_unit_label(selected_unit) %></span>
                    <% end %>
                  </td>
                  <td class="p-3 text-right font-semibold tabular-nums whitespace-nowrap <%= item.variance.to_d.negative? ? 'text-red-700' : (has_variance ? 'text-amber-700' : 'text-gray-500') %>">
                    <% if item.variance.present? %>
                      <%= item.variance %>
                      <span class="text-xs font-normal text-gray-400 ms-1"><%= ingredient_unit_label(base_unit) %></span>
                    <% else %>
                      <%= t("accounting.shared.em_dash") %>
                    <% end %>
                  </td>
                  <td class="p-3 text-right tabular-nums whitespace-nowrap text-gray-700">
                    <%= counted_value_cents ? format_money(counted_value_cents) : t("accounting.shared.em_dash") %>
                  </td>
                  <td class="p-3 pr-5 text-right tabular-nums whitespace-nowrap <%= variance_value_cents.to_i.negative? ? 'text-red-700' : (variance_value_cents.to_i.positive? ? 'text-amber-700' : 'text-gray-500') %>">
                    <%= variance_value_cents ? format_money(variance_value_cents) : t("accounting.shared.em_dash") %>
                  </td>
                </tr>
              <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="px-5 py-4 border-t border-gray-100 bg-gray-50/50 flex flex-wrap items-center gap-3">
          <%= submit_tag t("inventory.stock_takes.show.save_counts"),
                class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
          <span data-stock-take-group-target="status" class="text-xs font-semibold transition-colors"></span>
        </div>
      <% end %>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[980px]">
          <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 pl-5 text-left w-12"><%= t("inventory.stock_takes.show.table.index") %></th>
              <th class="p-3 text-left"><%= sort_header_link(t("inventory.stock_takes.show.table.category"), :category, **sort_opts) %></th>
              <th class="p-3 text-left"><%= sort_header_link(t("inventory.stock_takes.show.table.ingredient"), :name, **sort_opts) %></th>
              <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.expected"), :expected, **sort_opts) %></th>
              <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.expected_value"), :expected_value, **sort_opts) %></th>
              <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.counted"), :counted, **sort_opts) %></th>
              <th class="p-3 text-left"><%= t("inventory.stock_takes.show.table.unit") %></th>
              <th class="p-3 text-right"><%= t("inventory.stock_takes.show.table.variance") %></th>
              <th class="p-3 text-right"><%= sort_header_link(t("inventory.stock_takes.show.table.counted_value"), :counted_value, **sort_opts) %></th>
              <th class="p-3 pr-5 text-right"><%= t("inventory.stock_takes.show.table.variance_value") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% index = 0 %>
            <% grouped_items.call(@items).each do |group_name, group_items| %>
              <% if group_name %>
                <tr class="bg-gray-100/90">
                  <td colspan="10" class="px-3 py-2 text-xs font-semibold text-gray-600 uppercase tracking-wide">
                    <%= group_name %>
                    <span class="font-normal text-gray-400 normal-case tracking-normal ms-1">(<%= group_items.size %>)</span>
                  </td>
                </tr>
              <% end %>
            <% group_items.each do |item| %>
              <% index += 1 %>
              <% has_variance = item.variance.present? && !item.variance.to_d.zero? %>
              <% base_unit = item.ingredient.unit %>
              <% counted_unit = item.counted_unit.presence || item.ingredient.purchase_unit_record&.unit || base_unit %>
              <% location_cost = @unit_costs[item.ingredient_id] %>
              <% expected_value_cents = item.expected_value_cents(location_cost: location_cost) %>
              <% counted_value_cents = item.counted_value_cents(location_cost: location_cost) %>
              <% variance_value_cents = item.variance_value_cents(location_cost: location_cost) %>
              <tr class="hover:bg-gray-100 transition-colors <%= 'bg-amber-50/40' if has_variance %>">
                <td class="p-3 pl-5 text-gray-400 tabular-nums"><%= index %></td>
                <td class="p-3 text-gray-600"><%= item.ingredient.ingredient_category.name %></td>
                <td class="p-3">
                  <span class="inline-flex items-center gap-1.5">
                    <%= link_to item.ingredient.name, admin_inventory_ingredient_path(item.ingredient),
                          class: "font-semibold text-amber-700 hover:text-amber-800" %>
                    <% unless item.ingredient.active? %>
                      <span class="inline-flex text-gray-400" title="<%= t("inventory.stock_takes.show.inactive_ingredient") %>" aria-label="<%= t("inventory.stock_takes.show.inactive_ingredient") %>">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
                          <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l8.5-8.5a.75.75 0 0 0-1.06-1.06l-8.5 8.5a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
                          <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm0-1.5a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13Z" clip-rule="evenodd" />
                        </svg>
                      </span>
                    <% end %>
                  </span>
                </td>
                <td class="p-3 text-right text-gray-600 tabular-nums whitespace-nowrap">
                  <%= item.expected_quantity %>
                  <span class="text-xs text-gray-400 ms-1"><%= ingredient_unit_label(base_unit) %></span>
                </td>
                <td class="p-3 text-right tabular-nums whitespace-nowrap text-gray-700">
                  <%= format_money(expected_value_cents) %>
                </td>
                <td class="p-3 text-right text-gray-900 tabular-nums whitespace-nowrap">
                  <% if item.counted_quantity.present? %>
                    <%= item.counted_quantity %>
                    <% if counted_unit != base_unit %>
                      <span class="block text-xs text-gray-400 font-normal">
                        = <%= item.base_counted_quantity %> <%= ingredient_unit_label(base_unit) %>
                      </span>
                    <% end %>
                  <% else %>
                    <%= t("accounting.shared.em_dash") %>
                  <% end %>
                </td>
                <td class="p-3 text-left text-gray-600 whitespace-nowrap">
                  <%= ingredient_unit_label(counted_unit) %>
                </td>
                <td class="p-3 text-right font-semibold tabular-nums whitespace-nowrap <%= item.variance.to_d.negative? ? 'text-red-700' : (has_variance ? 'text-amber-700' : 'text-gray-500') %>">
                  <% if item.variance.present? %>
                    <%= item.variance %>
                    <span class="text-xs font-normal text-gray-400 ms-1"><%= ingredient_unit_label(base_unit) %></span>
                  <% else %>
                    <%= t("accounting.shared.em_dash") %>
                  <% end %>
                </td>
                <td class="p-3 text-right tabular-nums whitespace-nowrap text-gray-700">
                  <%= counted_value_cents ? format_money(counted_value_cents) : t("accounting.shared.em_dash") %>
                </td>
                <td class="p-3 pr-5 text-right tabular-nums whitespace-nowrap <%= variance_value_cents.to_i.negative? ? 'text-red-700' : (variance_value_cents.to_i.positive? ? 'text-amber-700' : 'text-gray-500') %>">
                  <%= variance_value_cents ? format_money(variance_value_cents) : t("accounting.shared.em_dash") %>
                </td>
              </tr>
            <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <% if @stock_take.status == "completing" %>
    <section class="rounded-2xl border border-blue-200 bg-blue-50/30 overflow-hidden">
      <div class="px-5 py-4 border-b border-blue-100 bg-blue-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_takes.show.completing_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.stock_takes.show.completing_hint") %></p>
      </div>
    </section>
  <% elsif @stock_take.status == "failed" %>
    <section class="rounded-2xl border border-red-200 bg-red-50/30 overflow-hidden">
      <div class="px-5 py-4 border-b border-red-100 bg-red-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_takes.show.failed_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.stock_takes.show.failed_hint") %></p>
      </div>
      <div class="p-5">
        <%= form_with url: complete_admin_inventory_stock_take_path(@stock_take), method: :post, class: "flex flex-wrap items-center gap-3" do %>
          <%= submit_tag t("inventory.stock_takes.show.retry_button"),
                class: "bg-red-700 hover:bg-red-800 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors",
                data: { turbo_confirm: t("inventory.stock_takes.show.retry_message") } %>
        <% end %>
      </div>
    </section>
  <% elsif @stock_take.status == "in_progress" %>
    <section class="rounded-2xl border border-green-200 bg-green-50/30 overflow-hidden">
      <div class="px-5 py-4 border-b border-green-100 bg-green-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_takes.show.complete_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.stock_takes.show.complete_hint") %></p>
      </div>
      <div class="p-5">
        <%= form_with url: complete_admin_inventory_stock_take_path(@stock_take), method: :post, class: "flex flex-wrap items-center gap-3" do %>
          <% @items.each do |item| %>
            <%= hidden_field_tag "stock_take_items[#{item.id}][counted_quantity]", item.counted_quantity %>
            <%= hidden_field_tag "stock_take_items[#{item.id}][counted_unit]",
                  item.counted_unit.presence || item.ingredient.purchase_unit_record&.unit || item.ingredient.unit %>
          <% end %>
          <%= submit_tag t("inventory.stock_takes.show.confirm_button"),
                class: "bg-green-700 hover:bg-green-800 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors",
                data: { turbo_confirm: t("inventory.stock_takes.show.confirm_message") } %>
          <p class="text-xs text-gray-600"><%= t("inventory.stock_takes.show.save_first_hint") %></p>
        <% end %>
      </div>
    </section>

    <section class="rounded-2xl border border-red-200 bg-red-50/30 overflow-hidden mt-6">
      <div class="px-5 py-4 border-b border-red-100 bg-red-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.stock_takes.show.cancel_heading") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.stock_takes.show.cancel_hint") %></p>
      </div>
      <div class="p-5">
        <%= button_to t("inventory.stock_takes.show.cancel_button"),
              cancel_admin_inventory_stock_take_path(@stock_take), method: :post,
              class: "bg-white hover:bg-red-50 text-red-700 text-sm font-semibold px-6 py-2.5 rounded-xl border border-red-300 shadow-sm transition-colors",
              form: { data: { turbo_confirm: t("inventory.stock_takes.show.cancel_message") } } %>
      </div>
    </section>
  <% end %>
</div>
