<% input_class = "w-full max-w-[8rem] bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 tabular-nums focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>

<div class="max-w-6xl">
  <div class="mb-4">
    <%= link_to "← Stock takes", admin_inventory_stock_takes_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">Stock take</h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= (@stock_take.started_at || @stock_take.created_at).strftime("%b %-d, %Y · %l:%M %p") %>
        · <%= @stock_take.user.name %>
      </p>
      <% if @stock_take.notes.present? %>
        <p class="text-gray-500 text-sm mt-1"><%= @stock_take.notes %></p>
      <% end %>
    </div>
    <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full border <%= stock_take_status_class(@stock_take.status) %> <%= stock_take_status_border_class(@stock_take.status) %>">
      <%= @stock_take.status.humanize %>
    </span>
  </div>

  <%= render "admin/inventory/tools_nav" %>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Ingredients</p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @items.size %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Variances</p>
      <p class="text-2xl font-bold mt-1 <%= @variance_count.positive? ? 'text-amber-700' : 'text-gray-900' %> tabular-nums">
        <%= @variance_count %>
      </p>
      <p class="text-xs text-gray-500 mt-1.5">Non-zero differences</p>
    </div>
    <% if @stock_take.completed_at %>
      <div class="rounded-2xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Completed</p>
        <p class="text-lg font-bold mt-1 text-gray-900"><%= @stock_take.completed_at.strftime("%b %-d, %Y") %></p>
      </div>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900">Count sheet</h2>
      <p class="text-xs text-gray-500 mt-0.5">
        <% if @stock_take.status == "in_progress" %>
          Enter physical counts, save, then confirm to apply adjustments
        <% else %>
          Final counts and variances for this stock take
        <% end %>
      </p>
    </div>

    <% if @stock_take.status == "in_progress" %>
      <%= form_with url: admin_inventory_stock_take_path(@stock_take), method: :patch do %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm min-w-[640px]">
            <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 pl-5 text-left">Ingredient</th>
                <th class="p-3 text-right">Expected</th>
                <th class="p-3 text-right">Counted</th>
                <th class="p-3 pr-5 text-right">Variance</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @items.each do |item| %>
                <% has_variance = item.variance.present? && !item.variance.to_d.zero? %>
                <tr class="hover:bg-gray-50/60 transition-colors <%= 'bg-amber-50/40' if has_variance %>">
                  <td class="p-3 pl-5">
                    <span class="font-semibold text-gray-900"><%= item.ingredient.name %></span>
                    <span class="text-xs text-gray-500 block"><%= item.ingredient.ingredient_category.name %></span>
                  </td>
                  <td class="p-3 text-right text-gray-600 tabular-nums whitespace-nowrap">
                    <%= item.expected_quantity %> <%= item.ingredient.unit %>
                  </td>
                  <td class="p-3 text-right">
                    <%= number_field_tag "stock_take_items[#{item.id}][counted_quantity]",
                          item.counted_quantity, step: 0.001, class: "#{input_class} ml-auto" %>
                  </td>
                  <td class="p-3 pr-5 text-right font-semibold tabular-nums whitespace-nowrap <%= item.variance.to_d.negative? ? 'text-red-700' : (has_variance ? 'text-amber-700' : 'text-gray-500') %>">
                    <%= item.variance.present? ? item.variance : "—" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="px-5 py-4 border-t border-gray-100 bg-gray-50/50 flex flex-wrap gap-3">
          <%= submit_tag "Save counts",
                class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
        </div>
      <% end %>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[640px]">
          <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 pl-5 text-left">Ingredient</th>
              <th class="p-3 text-right">Expected</th>
              <th class="p-3 text-right">Counted</th>
              <th class="p-3 pr-5 text-right">Variance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @items.each do |item| %>
              <% has_variance = item.variance.present? && !item.variance.to_d.zero? %>
              <tr class="hover:bg-gray-50/60 transition-colors <%= 'bg-amber-50/40' if has_variance %>">
                <td class="p-3 pl-5">
                  <%= link_to item.ingredient.name, admin_inventory_ingredient_path(item.ingredient),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                </td>
                <td class="p-3 text-right text-gray-600 tabular-nums whitespace-nowrap">
                  <%= item.expected_quantity %> <%= item.ingredient.unit %>
                </td>
                <td class="p-3 text-right text-gray-900 tabular-nums whitespace-nowrap">
                  <%= item.counted_quantity %> <%= item.ingredient.unit %>
                </td>
                <td class="p-3 pr-5 text-right font-semibold tabular-nums whitespace-nowrap <%= item.variance.to_d.negative? ? 'text-red-700' : (has_variance ? 'text-amber-700' : 'text-gray-500') %>">
                  <%= item.variance.present? ? item.variance : "—" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <% if @stock_take.status == "in_progress" %>
    <section class="rounded-2xl border border-green-200 bg-green-50/30 overflow-hidden">
      <div class="px-5 py-4 border-b border-green-100 bg-green-50/80">
        <h2 class="text-sm font-semibold text-gray-900">Complete stock take</h2>
        <p class="text-xs text-gray-600 mt-0.5">Applies non-zero variances as inventory adjustments</p>
      </div>
      <div class="p-5">
        <%= form_with url: complete_admin_inventory_stock_take_path(@stock_take), method: :post, class: "flex flex-wrap items-center gap-3" do %>
          <% @items.each do |item| %>
            <%= hidden_field_tag "stock_take_items[#{item.id}][counted_quantity]", item.counted_quantity %>
          <% end %>
          <%= submit_tag "Confirm & apply adjustments",
                class: "bg-green-700 hover:bg-green-800 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors",
                data: { turbo_confirm: "Apply variances to inventory? This cannot be undone." } %>
          <p class="text-xs text-gray-600">Save counts first if you just entered new values.</p>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
