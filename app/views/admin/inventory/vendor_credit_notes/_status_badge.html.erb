<% badge_class = case cn.status
                 when "draft"     then "border-gray-300 border-dashed bg-white text-gray-500"
                 when "confirmed" then "border-green-300 bg-green-50 text-green-700"
                 when "void"      then "border-red-200 bg-red-50 text-red-500"
                 end %>
<span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= badge_class %>">
  <%= t("inventory.vendor_credit_notes.statuses.#{cn.status}") %>
</span>
