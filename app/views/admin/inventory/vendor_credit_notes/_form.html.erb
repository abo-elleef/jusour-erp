<%# locals: vendor_credit_note %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, :inventory, vendor_credit_note],
      class: "space-y-6",
      data: {
        controller: "vendor-invoice-lines",
        searchable_select_options: ingredient_search_options(@ingredients),
        vendor_invoice_lines_available_units_value: @ingredient_available_units.to_json
      } do |f| %>
  <% if vendor_credit_note.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= vendor_credit_note.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_credit_notes.form.details") %></h2>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :supplier_id, t("inventory.vendor_credit_notes.supplier"), class: label_class %>
        <%= f.collection_select :supplier_id, @suppliers, :id, :name,
              { prompt: t("inventory.vendor_credit_notes.select_supplier") },
              class: "#{input_class} appearance-none", required: true %>
      </div>
      <div>
        <%= f.label :credit_note_date, t("inventory.vendor_credit_notes.date"), class: label_class %>
        <%= f.date_field :credit_note_date, class: input_class, required: true %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :notes, t("inventory.vendor_credit_notes.notes"), class: label_class %>
        <%= f.text_area :notes, rows: 2, class: "#{input_class} resize-y min-h-[4rem]" %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.vendor_credit_notes.form.lines") %></h2>
    </div>

    <div class="divide-y divide-gray-100" data-vendor-invoice-lines-target="lineContainer">
      <% if vendor_credit_note.vendor_credit_note_lines.empty? %>
        <% vendor_credit_note.vendor_credit_note_lines.build(position: 0) %>
      <% end %>
      <%= f.fields_for :vendor_credit_note_lines do |lf| %>
        <%= render "admin/inventory/vendor_credit_notes/line_fields", f: lf %>
      <% end %>
    </div>

    <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">
      <%= link_to t("inventory.vendor_invoices.form.add_line"),
            "#",
            class: "text-sm font-semibold text-amber-700 hover:text-amber-800",
            data: {
              action: "click->vendor-invoice-lines#addLine",
              vendor_invoice_lines_target: "addLineButton"
            } %>
      <div class="text-sm font-bold text-gray-900 tabular-nums">
        <%= t("inventory.vendor_credit_notes.form.total") %>:
        <span data-vendor-invoice-lines-target="grandTotal">—</span>
      </div>
    </div>
  </section>

  <div class="flex items-center gap-3">
    <%= f.submit t("actions.save"), class: "bg-amber-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-amber-700 transition-colors" %>
    <%= link_to t("actions.cancel"), admin_inventory_vendor_credit_notes_path,
          class: "text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
