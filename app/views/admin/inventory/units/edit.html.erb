<% content_for :title, t("inventory.units.edit_title") %>
<% input_class = pos_input_class %>
<div class="max-w-lg">
  <div class="mb-4">
    <%= link_to t("inventory.units.back"), admin_inventory_units_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-6"><%= t("inventory.units.edit_title") %></h1>

  <section class="rounded-2xl border border-gray-200 bg-white p-5">
    <% if @unit.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50/80 px-4 py-3 text-sm text-red-800 mb-4" role="alert">
        <%= @unit.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <%= form_with model: [:admin, :inventory, @unit], class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, t("inventory.units.name"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= f.text_field :name, class: input_class, required: true %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :active, class: "rounded border-gray-300" %>
        <%= f.label :active, t("inventory.units.active_label"), class: "text-sm text-gray-700" %>
      </div>
      <div class="flex gap-2 pt-2">
        <%= f.submit t("actions.save"), class: "bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm" %>
        <%= link_to t("actions.cancel"), admin_inventory_units_path, class: "border border-gray-200 text-gray-700 hover:bg-gray-50 px-5 py-2.5 rounded-xl text-sm font-semibold" %>
      </div>
    <% end %>
  </section>
</div>
