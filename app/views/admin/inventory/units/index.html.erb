<% content_for :title, t("inventory.units.title") %>
<%= render "admin/inventory/tools_nav" %>
<% input_class = pos_input_class %>
<div class="max-w-7xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.units.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("inventory.units.description") %></p>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.units.add_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.units.add_hint") %></p>
    </div>
    <div class="p-5">
      <% if @unit.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50/80 px-4 py-3 text-sm text-red-800 mb-4" role="alert">
          <%= @unit.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <%= form_with model: [:admin, :inventory, @unit], class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="flex-1 min-w-[12rem]">
          <%= f.label :name, t("inventory.units.name"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= f.text_field :name, class: input_class, required: true, placeholder: t("inventory.units.name_placeholder") %>
        </div>
        <%= f.submit t("inventory.units.add"), class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("inventory.units.name") %></th>
          <th class="p-3 text-start"><%= t("inventory.units.type") %></th>
          <th class="p-3 text-start"><%= t("inventory.units.status") %></th>
          <th class="p-3 pe-5 text-end"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @units.each do |unit| %>
          <% in_use = unit.in_use? %>
          <tr class="hover:bg-gray-50/60">
            <td class="p-3 ps-5 font-semibold text-gray-900"><%= ingredient_unit_label(unit.name) %></td>
            <td class="p-3 text-gray-600">
              <%= unit.system? ? t("inventory.units.built_in") : t("inventory.units.custom") %>
            </td>
            <td class="p-3">
              <span class="text-xs font-semibold <%= unit.active? ? 'text-emerald-700' : 'text-gray-500' %>">
                <%= unit.active? ? t("inventory.units.active") : t("inventory.units.inactive") %>
              </span>
            </td>
            <td class="p-3 pe-5 text-end whitespace-nowrap">
              <%= link_to t("actions.edit"), edit_admin_inventory_unit_path(unit), class: "text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-200 transition-colors" %>
              <% if in_use %>
                <span class="text-xs text-gray-400"><%= t("inventory.units.in_use") %></span>
              <% else %>
                <%= button_to t("actions.delete"), admin_inventory_unit_path(unit), method: :delete,
                      form: { data: { turbo_confirm: t("inventory.units.delete_confirm", name: unit.name) }, class: "inline" },
                      class: "text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
