<% content_for :title, t("inventory.ingredient_availabilities.title") %>
<%
  editable = can_manage_inventory_settings?
  input_class = "w-full border border-gray-300 rounded-xl px-3 py-2.5 text-sm bg-white"
  category_options_json = ([{ value: "", label: t("inventory.ingredient_availabilities.filter.all_categories") }] +
    @categories.map { |c| { value: c.id, label: c.name } }).to_json
  location_options_json = ([{ value: "", label: t("inventory.ingredient_availabilities.filter.all_locations") }] +
    @filter_locations.map { |loc| { value: loc.id, label: loc.name } }).to_json
  chip_class = "rounded-2xl border bg-white px-4 py-3 min-w-36 transition-colors"
%>

<div class="max-w-full">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.ingredient_availabilities.title") %></h1>
      <p class="text-gray-600 text-sm mt-1 max-w-3xl print-hide"><%= t("inventory.ingredient_availabilities.description") %></p>
      <p class="print-balances-only text-sm font-semibold text-gray-700 mt-1"><%= t("inventory.ingredient_availabilities.print_balances_title") %></p>
      <p class="print-only text-xs text-gray-500 mt-1"><%= l(Time.current, format: :short) %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0 print-hide">
      <%= link_to admin_inventory_ingredient_availabilities_path(filter_params.merge(format: :csv)),
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 transition-colors" do %>
        <span aria-hidden="true">↓</span> <%= t("actions.export_csv") %>
      <% end %>
      <button type="button" onclick="window.print()"
              class="inline-flex items-center text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 transition-colors">
        <%= t("inventory.ingredient_availabilities.print") %>
      </button>
      <button type="button"
              data-controller="print-mode"
              data-print-mode-mode-value="balances"
              data-action="print-mode#print"
              class="inline-flex items-center text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 transition-colors">
        <%= t("inventory.ingredient_availabilities.print_balances") %>
      </button>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 mb-5 print-hide">
    <% Admin::Inventory::IngredientAvailabilitiesController::AVAILABILITIES.each do |key| %>
      <%= link_to admin_inventory_ingredient_availabilities_path(filter_params.merge(availability: (key unless key == "all"))),
            class: "#{chip_class} #{@availability == key ? 'border-amber-400 ring-1 ring-amber-200' : 'border-gray-200 hover:border-gray-300'}" do %>
        <div class="text-2xl font-bold tabular-nums text-gray-900"><%= @counts[key] %></div>
        <div class="text-xs font-semibold text-gray-600 mt-0.5"><%= t("inventory.ingredient_availabilities.filter.availability_#{key}") %></div>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: admin_inventory_ingredient_availabilities_path, method: :get,
        class: "print-hide rounded-2xl border border-gray-200 bg-white p-4 mb-5 grid grid-cols-1 md:grid-cols-6 gap-3 items-end" do |f| %>
    <%= hidden_field_tag :sort, @sort if @sort != "name" %>
    <%= hidden_field_tag :dir, @direction if @direction != "asc" %>
    <div>
      <%= f.label :q, t("inventory.ingredient_availabilities.filter.search"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= f.text_field :q, value: @query, placeholder: t("inventory.ingredient_availabilities.filter.search_placeholder"), class: input_class %>
    </div>
    <div data-searchable-select-options="<%= category_options_json %>">
      <%= f.label :category_id, t("inventory.ingredient_availabilities.filter.category"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= render "shared/searchable_select", form: f, field: :category_id, selected: @category_id,
            placeholder: t("inventory.ingredient_availabilities.filter.all_categories"), input_class: input_class %>
    </div>
    <div data-searchable-select-options="<%= location_options_json %>">
      <%= f.label :location_id, t("inventory.ingredient_availabilities.filter.location"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= render "shared/searchable_select", form: f, field: :location_id, selected: @location_id,
            placeholder: t("inventory.ingredient_availabilities.filter.all_locations"), input_class: input_class %>
    </div>
    <div>
      <%= f.label :status, t("inventory.ingredient_availabilities.filter.status"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= f.select :status, options_for_select(
            Admin::Inventory::IngredientAvailabilitiesController::STATUSES.map { |s| [t("inventory.ingredient_availabilities.filter.status_#{s}"), s] }, @status
          ), {}, class: input_class %>
    </div>
    <div>
      <%= f.label :availability, t("inventory.ingredient_availabilities.filter.availability"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= f.select :availability, options_for_select(
            Admin::Inventory::IngredientAvailabilitiesController::AVAILABILITIES.map { |s| [t("inventory.ingredient_availabilities.filter.availability_#{s}"), s] }, @availability
          ), {}, class: input_class %>
    </div>
    <div>
      <%= f.submit t("inventory.ingredient_availabilities.filter.apply"),
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl cursor-pointer" %>
    </div>
  <% end %>

  <% if @locations.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-500 text-sm"><%= t("inventory.ingredient_availabilities.no_locations") %></p>
    </div>
  <% elsif @ingredients.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-400 text-sm"><%= t("inventory.ingredient_availabilities.empty") %></p>
    </div>
  <% elsif editable %>
    <%= form_with url: bulk_update_admin_inventory_ingredient_availabilities_path, method: :patch,
          data: { controller: "ingredient-availability" } do %>
      <% filter_params.each do |key, value| %>
        <%= hidden_field_tag key, value, id: nil %>
      <% end %>
      <%= render "grid", editable: true %>
      <div class="print-hide flex flex-wrap items-center justify-between gap-3 rounded-b-2xl border border-t-0 border-gray-200 bg-gray-50/80 px-5 py-4 -mt-px">
        <p class="text-xs text-gray-500 max-w-2xl"><%= t("inventory.ingredient_availabilities.save_hint") %></p>
        <%= submit_tag t("inventory.ingredient_availabilities.save"),
              class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl cursor-pointer" %>
      </div>
    <% end %>
  <% else %>
    <%= render "grid", editable: false %>
  <% end %>
</div>
