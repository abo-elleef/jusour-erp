<% editable = local_assigns.fetch(:editable) %>
<% sort_opts = { sort: @sort, direction: @direction,
                 path: admin_inventory_ingredient_availabilities_path, base_params: filter_params } %>
<% box_class = "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden <%= "rounded-b-none" if editable %>">
  <div class="overflow-auto max-h-[calc(100vh-18rem)]">
    <table class="w-full text-sm border-separate border-spacing-0">
      <thead class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="sticky top-0 start-0 z-40 bg-gray-50 p-3 ps-5 text-start min-w-56 border-b border-gray-100">
            <%= sort_header_link(t("inventory.ingredient_availabilities.col.ingredient"), :name, **sort_opts) %>
          </th>
          <th class="sticky top-0 z-30 bg-gray-50 p-3 text-center border-b border-gray-100 min-w-28 normal-case tracking-normal">
            <div class="text-[11px] font-semibold text-gray-700"><%= t("inventory.ingredient_availabilities.col.all") %></div>
            <% if editable %>
              <input type="checkbox"
                     class="<%= box_class %> mt-2"
                     data-ingredient-availability-target="allColumn"
                     data-action="change->ingredient-availability#toggleAllColumn"
                     aria-label="<%= t("inventory.ingredient_availabilities.toggle_all_column") %>">
            <% end %>
          </th>
          <% @locations.each do |loc| %>
            <th class="sticky top-0 z-30 bg-gray-50 p-3 text-center border-b border-gray-100 min-w-28 normal-case tracking-normal">
              <div class="text-[11px] font-semibold text-gray-800 leading-snug"><%= loc.name %></div>
              <div class="text-[10px] font-medium text-gray-400 mt-0.5"><%= t("admin.locations.type_#{loc.location_type}") %></div>
              <% if editable %>
                <input type="checkbox"
                       class="<%= box_class %> mt-2"
                       data-ingredient-availability-target="column"
                       data-location-id="<%= loc.id %>"
                       data-action="change->ingredient-availability#toggleColumn"
                       aria-label="<%= t("inventory.ingredient_availabilities.toggle_column", location: loc.name) %>">
              <% end %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @ingredients.each do |ingredient| %>
          <% restricted_ids = ingredient.restricted_locations.map(&:id) %>
          <tr class="group" <%= %(data-ingredient-availability-target="row").html_safe if editable %>>
            <td data-sticky class="sticky start-0 z-10 bg-white group-hover:bg-gray-50 p-3 ps-5 border-b border-gray-100">
              <%= link_to ingredient.name, edit_admin_inventory_ingredient_path(ingredient),
                    class: "font-semibold text-gray-900 hover:text-amber-700" %>
              <div class="text-xs text-gray-400 mt-0.5">
                <%= ingredient.code %>
                <%= " · #{ingredient.ingredient_category.name}" if ingredient.ingredient_category %>
                <% unless ingredient.active? %>
                  <span class="ms-1 font-semibold text-gray-400"><%= t("inventory.ingredient_availabilities.inactive") %></span>
                <% end %>
              </div>
            </td>
            <td class="p-3 text-center border-b border-gray-100 bg-white group-hover:bg-gray-50">
              <% if editable %>
                <%= hidden_field_tag "availabilities[#{ingredient.id}][all_locations]", "0", id: nil %>
                <%= check_box_tag "availabilities[#{ingredient.id}][all_locations]", "1", ingredient.all_locations?,
                      id: "availability_#{ingredient.id}_all",
                      class: box_class,
                      data: { role: "all", action: "change->ingredient-availability#toggleAll" } %>
                <%= hidden_field_tag "availabilities[#{ingredient.id}][location_ids][]", "", id: nil %>
              <% else %>
                <%= check_box_tag "availability_#{ingredient.id}_all", "1", ingredient.all_locations?,
                      id: "availability_#{ingredient.id}_all", disabled: true, class: box_class %>
              <% end %>
            </td>
            <% @locations.each do |loc| %>
              <% checked = ingredient.all_locations? || restricted_ids.include?(loc.id) %>
              <td class="p-3 text-center border-b border-gray-100">
                <% if editable %>
                  <%= check_box_tag "availabilities[#{ingredient.id}][location_ids][]", loc.id, checked,
                        id: "availability_#{ingredient.id}_#{loc.id}",
                        class: "#{box_class} #{"opacity-50" if ingredient.all_locations?}",
                        data: { role: "location", action: "change->ingredient-availability#toggleLocation" } %>
                <% else %>
                  <%= check_box_tag "availability_#{ingredient.id}_#{loc.id}", "1", checked,
                        id: "availability_#{ingredient.id}_#{loc.id}", disabled: true,
                        class: "#{box_class} #{"opacity-50" if ingredient.all_locations?}" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
