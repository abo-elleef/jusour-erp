<div class="rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-600 mb-4">
  <%= t("inventory.unit_conversions.missing.hint") %>
</div>

<% if @missing.blank? %>
  <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
    <p class="text-gray-400 text-sm"><%= t("inventory.unit_conversions.missing.empty") %></p>
  </div>
<% else %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("inventory.unit_conversions.col.ingredient") %></th>
          <th class="p-3 text-start"><%= t("inventory.unit_conversions.filter.category") %></th>
          <th class="p-3 text-start"><%= t("inventory.unit_conversions.col.base_unit") %></th>
          <th class="p-3 pe-5 text-end"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <% @missing.each do |ingredient| %>
          <tr class="hover:bg-gray-100">
            <td class="p-3 ps-5">
              <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                    class: "font-semibold text-gray-900 hover:text-amber-700" %>
              <div class="text-xs text-gray-400 mt-0.5"><%= ingredient.code %></div>
            </td>
            <td class="p-3 text-gray-600"><%= ingredient.ingredient_category&.name %></td>
            <td class="p-3 text-gray-600"><%= unit_name_tag(ingredient.unit) %></td>
            <td class="p-3 pe-5 text-end">
              <% if can_manage_inventory_settings? %>
                <%= link_to t("inventory.unit_conversions.missing.add_unit"),
                      edit_admin_inventory_ingredient_path(ingredient),
                      class: "text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-200 transition-colors" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
