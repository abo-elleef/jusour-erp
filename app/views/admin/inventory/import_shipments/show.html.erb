<% content_for :title, @shipment.shipment_number %>
<%= render "admin/inventory/tools_nav" %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-4xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 tabular-nums"><%= @shipment.shipment_number %></h1>
        <% if @shipment.finalized? %>
          <span class="text-xs font-semibold uppercase px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200"><%= t("inventory.import_shipments.statuses.finalized") %></span>
        <% else %>
          <span class="text-xs font-semibold uppercase px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200"><%= t("inventory.import_shipments.statuses.open") %></span>
        <% end %>
      </div>
      <p class="text-gray-600 text-sm mt-1">
        <%= @shipment.arrival_date ? l(@shipment.arrival_date, format: :long) : "—" %><% if @shipment.location %> · <%= @shipment.location.name %><% end %>
        · <%= t("inventory.import_shipments.total_costs") %>: <span class="font-semibold text-gray-900"><%= format_money(@shipment.total_costs_cents) %></span>
      </p>
    </div>
    <%= link_to t("inventory.import_shipments.back"), admin_inventory_import_shipments_path,
          class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
  </div>

  <%# ── Goods (linked vendor invoices) ─────────────────────────── %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.import_shipments.goods") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.import_shipments.goods_hint") %></p>
    </div>
    <div class="p-5 space-y-3">
      <% if @shipment.vendor_invoices.any? %>
        <% @shipment.vendor_invoices.each do |vi| %>
          <div class="flex items-center justify-between gap-3 rounded-xl border border-gray-100 px-4 py-2.5">
            <div class="text-sm">
              <%= link_to vi.invoice_number, admin_inventory_vendor_invoice_path(vi), class: "font-semibold text-amber-700 hover:text-amber-800 tabular-nums" %>
              <span class="text-gray-500">· <%= vi.supplier.name %> · <%= format_money(vi.total_cents) %></span>
            </div>
            <%= button_to t("actions.remove"), detach_invoice_admin_inventory_import_shipment_path(@shipment, vendor_invoice_id: vi.id),
                  method: :delete, class: "text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500"><%= t("inventory.import_shipments.no_goods") %></p>
      <% end %>

      <%= form_with url: attach_invoice_admin_inventory_import_shipment_path(@shipment), method: :post, class: "flex flex-wrap items-end gap-3 pt-2" do %>
        <div class="flex-1 min-w-[16rem]">
          <%= label_tag :vendor_invoice_id, t("inventory.import_shipments.attach_invoice"), class: label_class %>
          <%= select_tag :vendor_invoice_id,
                options_for_select(@linkable_invoices.map { |vi| ["#{vi.invoice_number} — #{vi.supplier.name} (#{format_money(vi.total_cents)})", vi.id] }),
                include_blank: t("inventory.import_shipments.select_invoice"), class: "#{input_class} appearance-none" %>
        </div>
        <%= submit_tag t("inventory.import_shipments.attach"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <% end %>
    </div>
  </section>

  <%# ── Landed cost lines ──────────────────────────────────────── %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.import_shipments.costs") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.import_shipments.costs_hint") %></p>
    </div>
    <div class="p-5 space-y-3">
      <% @shipment.shipment_costs.order(:incurred_on).each do |cost| %>
        <div class="flex items-center justify-between gap-3 rounded-xl border border-gray-100 px-4 py-2.5 text-sm">
          <div>
            <span class="font-medium text-gray-900"><%= t("inventory.import_shipments.cost_types.#{cost.cost_type}") %></span>
            <span class="text-gray-500">· <%= l(cost.incurred_on, format: :short) %><% if cost.description.present? %> · <%= cost.description %><% end %></span>
          </div>
          <div class="flex items-center gap-3">
            <span class="tabular-nums font-semibold text-gray-900"><%= format_money(cost.amount_cents) %></span>
            <%= button_to t("actions.remove"), remove_cost_admin_inventory_import_shipment_path(@shipment, cost_id: cost.id),
                  method: :delete, class: "text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200" %>
          </div>
        </div>
      <% end %>

      <%= form_with url: add_cost_admin_inventory_import_shipment_path(@shipment), method: :post, class: "flex flex-wrap items-end gap-3 pt-2" do %>
        <div class="min-w-[9rem]">
          <%= label_tag :cost_type, t("inventory.import_shipments.form.cost_type"), class: label_class %>
          <%= select_tag :cost_type,
                options_for_select(ShipmentCost::COST_TYPES.map { |t| [t("inventory.import_shipments.cost_types.#{t}"), t] }),
                class: "#{input_class} appearance-none" %>
        </div>
        <div class="min-w-[8rem]">
          <%= label_tag :amount, t("inventory.import_shipments.form.amount"), class: label_class %>
          <%= number_field_tag :amount, nil, step: 0.01, min: 0, required: true, class: input_class, placeholder: "0.00" %>
        </div>
        <div class="min-w-[10rem]">
          <%= label_tag :treasury_id, t("inventory.import_shipments.form.treasury"), class: label_class %>
          <%= select_tag :treasury_id, options_from_collection_for_select(@treasuries, :id, :name),
                include_blank: t("inventory.import_shipments.form.select_treasury"), required: true, class: "#{input_class} appearance-none" %>
        </div>
        <div class="min-w-[9rem]">
          <%= label_tag :incurred_on, t("inventory.import_shipments.form.incurred_on"), class: label_class %>
          <%= date_field_tag :incurred_on, Date.current, max: Date.current, class: input_class %>
        </div>
        <%= submit_tag t("inventory.import_shipments.add_cost"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <% end %>
    </div>
  </section>

  <%# ── Allocation preview + finalize ──────────────────────────── %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.import_shipments.allocation") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.import_shipments.allocation_hint") %></p>
    </div>
    <% if @preview.any? %>
      <%= form_with url: finalize_admin_inventory_import_shipment_path(@shipment), method: :post do %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm min-w-[40rem]">
            <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 ps-5 text-start"><%= t("inventory.import_shipments.alloc.product") %></th>
                <th class="p-3 text-end"><%= t("inventory.import_shipments.alloc.qty") %></th>
                <th class="p-3 text-end"><%= t("inventory.import_shipments.alloc.provisional") %></th>
                <th class="p-3 text-end"><%= t("inventory.import_shipments.alloc.allocated") %></th>
                <th class="p-3 text-end"><%= t("inventory.import_shipments.alloc.override") %></th>
                <th class="p-3 text-end pe-5"><%= t("inventory.import_shipments.alloc.final_cost") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @preview.each do |row| %>
                <tr>
                  <td class="p-3 ps-5 text-gray-800"><%= row.ingredient.name %></td>
                  <td class="p-3 text-end tabular-nums text-gray-600"><%= row.quantity %></td>
                  <td class="p-3 text-end tabular-nums text-gray-600"><%= format_money(row.provisional_cost_cents) %></td>
                  <td class="p-3 text-end tabular-nums text-gray-600">+<%= format_money(row.allocated_cents) %></td>
                  <td class="p-3 text-end">
                    <%= number_field_tag "overrides[#{row.batch.id}]", nil, step: 0.01, min: 0,
                          class: "#{input_class} text-end w-28", placeholder: t("inventory.import_shipments.alloc.auto") %>
                  </td>
                  <td class="p-3 pe-5 text-end tabular-nums font-semibold text-gray-900"><%= format_money(row.final_unit_cents) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="px-5 py-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs text-gray-500"><%= t("inventory.import_shipments.finalize_hint") %></p>
          <%= submit_tag @shipment.finalized? ? t("inventory.import_shipments.reallocate") : t("inventory.import_shipments.finalize"),
                class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm",
                data: { turbo_confirm: t("inventory.import_shipments.finalize_confirm") } %>
        </div>
      <% end %>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.import_shipments.no_products") %></p>
    <% end %>
  </section>
</div>
