<% content_for :title, t("inventory.import_shipments.title") %>

<div class="max-w-5xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.import_shipments.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.import_shipments.description") %></p>
    </div>
    <%= link_to new_admin_inventory_import_shipment_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("inventory.import_shipments.new_button") %>
    <% end %>
  </div>

  <% if @shipments.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5"><%= t("inventory.import_shipments.table.number") %></th>
            <th class="p-3"><%= t("inventory.import_shipments.table.arrival") %></th>
            <th class="p-3"><%= t("inventory.import_shipments.table.location") %></th>
            <th class="p-3"><%= t("inventory.import_shipments.table.status") %></th>
            <th class="p-3 text-end pe-5"><%= t("inventory.import_shipments.table.costs") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @shipments.each do |s| %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5"><%= link_to s.shipment_number, admin_inventory_import_shipment_path(s), class: "font-semibold text-amber-700 hover:text-amber-800 tabular-nums" %></td>
              <td class="p-3 text-gray-600 tabular-nums"><%= s.arrival_date ? l(s.arrival_date, format: :short) : "—" %></td>
              <td class="p-3 text-gray-700"><%= s.location&.name || "—" %></td>
              <td class="p-3">
                <% if s.finalized? %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200"><%= t("inventory.import_shipments.statuses.finalized") %></span>
                <% else %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200"><%= t("inventory.import_shipments.statuses.open") %></span>
                <% end %>
              </td>
              <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"><%= format_money(s.total_costs_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.import_shipments.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("inventory.import_shipments.empty_hint") %></p>
      <%= link_to t("inventory.import_shipments.new_button"), new_admin_inventory_import_shipment_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl" %>
    </section>
  <% end %>
</div>
