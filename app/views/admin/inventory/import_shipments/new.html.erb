<% content_for :title, t("inventory.import_shipments.new_title") %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-lg">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-1"><%= t("inventory.import_shipments.new_title") %></h1>
  <p class="text-gray-600 text-sm mb-6"><%= t("inventory.import_shipments.new_hint") %></p>

  <%= form_with model: [:admin, :inventory, @shipment], class: "space-y-6" do |f| %>
    <% if @shipment.errors.any? %>
      <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        <%= @shipment.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :arrival_date, t("inventory.import_shipments.form.arrival_date"), class: label_class %>
          <%= f.date_field :arrival_date, class: input_class %>
        </div>
        <div>
          <%= f.label :location_id, t("inventory.import_shipments.form.location"), class: label_class %>
          <%= f.collection_select :location_id, @locations, :id, :name,
                { include_blank: t("inventory.import_shipments.form.no_location") }, class: "#{input_class} appearance-none" %>
        </div>
        <div class="sm:col-span-2">
          <%= f.label :notes, t("inventory.import_shipments.form.notes"), class: label_class %>
          <%= f.text_field :notes, class: input_class %>
        </div>
      </div>
    </section>
    <div class="flex items-center gap-3">
      <%= f.submit t("inventory.import_shipments.form.create"),
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm" %>
      <%= link_to t("actions.cancel"), admin_inventory_import_shipments_path,
            class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl" %>
    </div>
  <% end %>
</div>
