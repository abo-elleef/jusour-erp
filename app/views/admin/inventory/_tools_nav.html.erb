<% visible_groups = inventory_sidebar_groups %>
<% current_group = inventory_current_group %>
<nav class="mb-6 border-b border-gray-200 print-hide" aria-label="<%= t("nav.inventory") %>">

  <%# ── Primary group pills ─────────────────────────────────────── %>
  <div class="flex flex-wrap gap-x-1 -mb-px">
    <% visible_groups.each do |group| %>
      <% landing = inventory_visible_tabs(group).first %>
      <% next unless landing %>
      <%= link_to public_send(landing[:path]), class: accounting_group_pill_class(current_group&.dig(:key) == group[:key]) do %>
        <%= admin_nav_icon(group[:icon], css: "w-4 h-4 shrink-0") %>
        <%= t(group[:label]) %>
        <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      <% end %>
    <% end %>
  </div>

  <%# ── Sub-tab row ─────────────────────────────────────────────── %>
  <% if current_group && inventory_visible_tabs(current_group).any? %>
    <div class="flex flex-wrap gap-x-1 bg-gray-50 border-b border-gray-200 -mb-px ps-2">
      <% inventory_visible_tabs(current_group).each do |tab| %>
        <%= link_to bt_t(tab[:label]), public_send(tab[:path]),
              class: admin_section_tab_class(inventory_tab_active?(tab)) %>
      <% end %>
    </div>
  <% end %>

</nav>
