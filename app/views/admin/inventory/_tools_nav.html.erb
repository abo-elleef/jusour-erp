<nav class="mb-6 border-b border-gray-200 print-hide" aria-label="<%= t("nav.inventory") %>">

  <%# ── Primary group pills ─────────────────────────────────────── %>
  <div class="flex flex-wrap gap-x-1 -mb-px">

    <%= link_to admin_inventory_vendor_invoices_path, class: accounting_group_pill_class(inventory_in_operations_group?) do %>
      <%= t("inventory.tools.groups.operations") %>
      <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
    <% end %>

    <%= link_to admin_inventory_suppliers_path, class: accounting_group_pill_class(inventory_in_setup_group?) do %>
      <%= t("inventory.tools.groups.setup") %>
      <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
    <% end %>

    <%= link_to admin_inventory_reports_valuation_path, class: accounting_group_pill_class(inventory_in_reports_group?) do %>
      <%= t("inventory.tools.groups.reports") %>
      <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
    <% end %>

  </div>

  <%# ── Sub-tab row ─────────────────────────────────────────────── %>
  <% if inventory_in_operations_group? || inventory_in_setup_group? || inventory_in_reports_group? %>
    <div class="flex flex-wrap gap-x-1 bg-gray-50 border-b border-gray-200 -mb-px ps-2">
      <% if inventory_in_operations_group? %>
        <%= link_to t("inventory.tools.vendor_invoices"), admin_inventory_vendor_invoices_path,
              class: admin_section_tab_class(controller_name == "vendor_invoices") %>
        <%= link_to t("inventory.tools.stock_transfers"), admin_inventory_stock_transfers_path,
              class: admin_section_tab_class(controller_name == "stock_transfers") %>
        <%= link_to t("inventory.tools.stock_takes"), admin_inventory_stock_takes_path,
              class: admin_section_tab_class(controller_name == "stock_takes") %>
        <%= link_to t("inventory.tools.manufacturing"), admin_inventory_manufacturing_templates_path,
              class: admin_section_tab_class(controller_name.in?(%w[manufacturing_templates manufacturing_runs manufacturing_template_lines])) %>
      <% elsif inventory_in_setup_group? %>
        <%= link_to t("inventory.tools.suppliers"), admin_inventory_suppliers_path,
              class: admin_section_tab_class(controller_name == "suppliers") %>
        <%= link_to t("inventory.tools.ingredients"), admin_inventory_ingredients_path,
              class: admin_section_tab_class(controller_name == "ingredients" && action_name == "index") %>
        <%= link_to t("inventory.tools.ingredient_categories"), admin_inventory_ingredient_categories_path,
              class: admin_section_tab_class(controller_name == "ingredient_categories") %>
        <%= link_to t("inventory.tools.units"), admin_inventory_units_path,
              class: admin_section_tab_class(controller_name == "units") %>
      <% elsif inventory_in_reports_group? %>
        <%= link_to t("inventory.tools.valuation"), admin_inventory_reports_valuation_path,
              class: admin_section_tab_class(controller_name == "reports" && action_name == "valuation") %>
        <%= link_to t("inventory.tools.variance"), admin_inventory_reports_variance_path,
              class: admin_section_tab_class(controller_name == "reports" && action_name == "variance") %>
      <% end %>
    </div>
  <% end %>

</nav>
