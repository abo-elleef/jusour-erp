
<% tab_base = "inline-flex text-sm font-semibold px-4 py-2 rounded-xl transition-colors" %>
<% tab_active = "#{tab_base} bg-amber-600 text-white" %>
<% tab_idle = "#{tab_base} text-gray-700 hover:bg-gray-100 border border-gray-200" %>

<div class="max-w-6xl">
  <%# Printing is offered on the daily view only, and the card carries everything
      the sheet needs, so the page chrome stays off the paper. %>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6 print:hidden">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.manufacturing.runs.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.manufacturing.runs.description") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% if current_user.can_access_production? %>
        <%= link_to t("production.bulk.title"), new_admin_inventory_manufacturing_run_path,
              class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-xl" %>
      <% end %>
      <%= link_to t("inventory.manufacturing.templates.back"), admin_inventory_manufacturing_templates_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
    </div>
  </div>

  <%= render "shared/manufacturing_batch_transfer_banner" %>

  <div class="flex flex-wrap gap-2 mb-4 print:hidden">
    <%= link_to t("inventory.manufacturing.runs.view_runs"),
          admin_inventory_manufacturing_runs_path(view: "runs"),
          class: @view == "runs" ? tab_active : tab_idle %>
    <%= link_to t("inventory.manufacturing.runs.view_daily"),
          admin_inventory_manufacturing_runs_path(view: "daily", date: (@day || Date.current)),
          class: @view == "daily" ? tab_active : tab_idle %>
  </div>

  <% if @view == "daily" %>
    <%= render "daily" %>
  <% else %>
    <%= render "runs_table" %>
  <% end %>
</div>
