<% content_for :title, @run.run_number %>
<%= render "admin/inventory/tools_nav" %>

<div class="max-w-3xl">
  <div class="print-only mb-6 pb-4 border-b border-gray-300">
    <p class="text-lg font-bold text-gray-900"><%= Current.company.name %></p>
    <p class="text-sm text-gray-600"><%= t("inventory.manufacturing.runs.print_document_title") %> · <span class="font-mono"><%= @run.run_number %></span></p>
    <p class="text-xs text-gray-500 mt-1"><%= t("inventory.manufacturing.runs.printed_at", at: l(Time.current, format: :short)) %></p>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <%= link_to t("inventory.manufacturing.runs.back"), admin_inventory_manufacturing_runs_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 print-hide" %>
      <div class="flex flex-wrap items-center gap-3 mt-2">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @run.manufacturing_template.name %></h1>
        <span class="font-mono text-sm font-semibold text-amber-700"><%= @run.run_number %></span>
      </div>
      <p class="text-gray-600 text-sm mt-1">
        <%= l(@run.occurred_on, format: :long) %> · <%= @run.user.name %>
        <% if @run.location %> · <span class="font-semibold text-amber-700"><%= @run.location.name %></span><% end %>
      </p>
    </div>
    <button type="button" onclick="window.print()"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors print-hide shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
        <path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0 1 18 8.653v4.097A2.25 2.25 0 0 1 15.75 15h-.241l.305 1.984A1.75 1.75 0 0 1 14.084 19H5.916a1.75 1.75 0 0 1-1.73-2.016L4.491 15H4.25A2.25 2.25 0 0 1 2 12.75V8.653c0-1.082.775-2.034 1.874-2.198.374-.056.75-.107 1.126-.153V2.75Zm8.5 3.397a41.533 41.533 0 0 0-7 0V2.75a.25.25 0 0 1 .25-.25h6.5a.25.25 0 0 1 .25.25v3.397ZM6.608 12.5a.25.25 0 0 0-.247.212l-.693 4.5a.25.25 0 0 0 .247.288h8.168a.25.25 0 0 0 .247-.288l-.693-4.5a.25.25 0 0 0-.247-.212H6.608Z" clip-rule="evenodd" />
      </svg>
      <%= t("inventory.manufacturing.runs.print") %>
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <% if @run.main_ingredient_driven? %>
      <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5">
        <p class="text-xs font-semibold text-amber-800 uppercase"><%= t("inventory.manufacturing.runs.main_input") %></p>
        <p class="text-sm font-semibold text-amber-900 mt-1"><%= @run.manufacturing_template.main_ingredient&.name %></p>
        <p class="text-2xl font-bold text-amber-950 tabular-nums mt-0.5">
          <%= @run.main_input_quantity %>
          <%= ingredient_unit_label(@run.main_input_unit.presence || @run.manufacturing_template.main_ingredient&.unit) %>
        </p>
      </div>
    <% end %>
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= @run.main_ingredient_driven? ? t("inventory.manufacturing.runs.batches_derived") : t("inventory.manufacturing.runs.runs_count") %></p>
      <p class="text-3xl font-bold text-gray-900 tabular-nums mt-1"><%= @run.runs_count %></p>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-5">
      <p class="text-xs font-semibold text-emerald-800 uppercase"><%= t("inventory.manufacturing.runs.output_produced") %></p>
      <p class="text-sm font-semibold text-emerald-900 mt-1"><%= @run.manufacturing_template.output_ingredient.name %></p>
      <p class="text-2xl font-bold text-emerald-950 tabular-nums mt-0.5">
        <%= @run.runs_count.to_d * @run.manufacturing_template.yield_quantity.to_d %>
        <%= ingredient_unit_label(@run.manufacturing_template.output_ingredient.unit) %>
      </p>
    </div>
    <div class="rounded-2xl border border-orange-200 bg-orange-50/60 p-5 sm:col-span-2">
      <p class="text-xs font-semibold text-orange-800 uppercase"><%= t("inventory.manufacturing.runs.shelf_life") %></p>
      <p class="text-lg font-bold text-orange-950 mt-1">
        <%= t("inventory.manufacturing.runs.shelf_life_days", count: @run.shelf_life_days) %>
        · <%= t("inventory.manufacturing.runs.expires_on", date: l(@run.output_expires_on, format: :long)) %>
      </p>
    </div>
  </div>

  <% if @run.notes.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("inventory.manufacturing.runs.notes") %></p>
      <p class="text-sm text-gray-700 mt-1"><%= @run.notes %></p>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.manufacturing.runs.inputs_used") %></h2>
    </div>
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("inventory.manufacturing.templates.ingredient") %></th>
          <th class="p-3 pe-5 text-end"><%= t("inventory.manufacturing.runs.quantity_used") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @run.manufacturing_template.manufacturing_template_lines.includes(:ingredient).each do |line| %>
          <tr>
            <td class="p-3 ps-5 font-medium text-gray-900"><%= line.ingredient.name %></td>
            <td class="p-3 pe-5 text-end tabular-nums">
              <%= line.quantity_used.to_d * @run.runs_count.to_d %>
              <%= ingredient_unit_label(line.ingredient.unit) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
