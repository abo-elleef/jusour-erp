<% content_for :title, @run.manufacturing_template.name %>
<%= render "admin/inventory/tools_nav" %>

<div class="max-w-3xl">
  <div class="mb-6">
    <%= link_to t("inventory.manufacturing.runs.back"), admin_inventory_manufacturing_runs_path,
          class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900 mt-2"><%= @run.manufacturing_template.name %></h1>
    <p class="text-gray-600 text-sm mt-1">
      <%= l(@run.occurred_on, format: :long) %> · <%= @run.user.name %>
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("inventory.manufacturing.runs.runs_count") %></p>
      <p class="text-3xl font-bold text-gray-900 tabular-nums mt-1"><%= @run.runs_count %></p>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-5">
      <p class="text-xs font-semibold text-emerald-800 uppercase"><%= t("inventory.manufacturing.runs.output_produced") %></p>
      <p class="text-2xl font-bold text-emerald-950 tabular-nums mt-1">
        <%= @run.runs_count.to_d * @run.manufacturing_template.yield_quantity.to_d %>
        <%= ingredient_unit_label(@run.manufacturing_template.output_ingredient.unit) %>
      </p>
    </div>
    <div class="rounded-2xl border border-orange-200 bg-orange-50/60 p-5 sm:col-span-2">
      <p class="text-xs font-semibold text-orange-800 uppercase"><%= t("inventory.manufacturing.runs.shelf_life") %></p>
      <p class="text-lg font-bold text-orange-950 mt-1">
        <%= t("inventory.manufacturing.runs.shelf_life_days", count: @run.shelf_life_days) %>
        · <%= t("inventory.manufacturing.runs.expires_on", date: l(@run.output_expires_on, format: :long)) %>
      </p>
    </div>
  </div>

  <% if @run.notes.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("inventory.manufacturing.runs.notes") %></p>
      <p class="text-sm text-gray-700 mt-1"><%= @run.notes %></p>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.manufacturing.runs.inputs_used") %></h2>
    </div>
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("inventory.manufacturing.templates.ingredient") %></th>
          <th class="p-3 pe-5 text-end"><%= t("inventory.manufacturing.runs.quantity_used") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @run.manufacturing_template.manufacturing_template_lines.includes(:ingredient).each do |line| %>
          <tr>
            <td class="p-3 ps-5 font-medium text-gray-900"><%= line.ingredient.name %></td>
            <td class="p-3 pe-5 text-end tabular-nums">
              <%= line.quantity_used.to_d * @run.runs_count.to_d %>
              <%= ingredient_unit_label(line.ingredient.unit) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
