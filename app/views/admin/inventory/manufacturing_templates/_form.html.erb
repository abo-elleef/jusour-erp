<%# locals: template %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% input_class = pos_input_class %>

<%= form_with model: template,
      url: template.persisted? ? admin_inventory_manufacturing_template_path(template) : admin_inventory_manufacturing_templates_path,
      scope: :manufacturing_template,
      class: "space-y-6",
      data: {
        controller: "manufacturing-units",
        manufacturing_units_units_value: @ingredient_available_units.to_json,
        searchable_select_options: ingredient_search_options(@ingredients)
      } do |f| %>

  <% if template.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= template.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.manufacturing.templates.form_details") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.manufacturing.templates.form_details_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, class: label_class %>
        <%= f.text_field :name, class: input_class, required: true,
              placeholder: t("inventory.manufacturing.templates.name_placeholder") %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :output_ingredient_id, t("inventory.manufacturing.templates.output"), class: label_class %>
          <%= render "shared/searchable_select",
                form: f,
                field: :output_ingredient_id,
                selected: template.output_ingredient_id,
                placeholder: t("inventory.manufacturing.templates.select_ingredient"),
                input_class: input_class,
                html: { data: { action: "searchable-select:change->manufacturing-units#outputChanged" } } %>
          <p class="text-xs text-gray-500 mt-1"><%= t("inventory.manufacturing.templates.output_hint") %></p>
        </div>
        <div>
          <%= f.label :yield_quantity, t("inventory.manufacturing.templates.yield_per_run"), class: label_class %>
          <% yield_units = template.output_ingredient ? template.output_ingredient.available_units : [] %>
          <div class="flex gap-2">
            <%= f.number_field :yield_quantity, step: 0.001, min: 0.001, class: "#{input_class} tabular-nums flex-1 min-w-0", required: true %>
            <%= f.select :yield_unit,
                  options_for_select(yield_units.map { |u| [ingredient_unit_label(u), u] }, template.yield_unit.presence || template.output_ingredient&.unit),
                  {},
                  class: "#{input_class} appearance-none flex-1 min-w-0",
                  data: { manufacturing_units_target: "yieldUnit" } %>
          </div>
          <p class="text-xs text-gray-500 mt-1"><%= t("inventory.manufacturing.templates.yield_hint") %></p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :position, t("inventory.manufacturing.templates.position"), class: label_class %>
          <%= f.number_field :position, class: input_class, min: 0 %>
        </div>
        <div class="flex items-end pb-1">
          <label class="inline-flex items-start gap-2 text-sm text-gray-700">
            <%= f.check_box :active, class: "rounded border-gray-300 mt-0.5" %>
            <span>
              <%= t("inventory.manufacturing.templates.active") %>
              <span class="block text-xs text-gray-500 font-normal mt-0.5"><%= t("inventory.manufacturing.templates.active_hint") %></span>
            </span>
          </label>
        </div>
      </div>

      <div>
        <%= f.label :notes, class: label_class %>
        <%= f.text_area :notes, rows: 3, class: "#{input_class} resize-y min-h-[5rem]",
              placeholder: t("inventory.manufacturing.templates.notes_placeholder") %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.manufacturing.templates.input_lines") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.manufacturing.templates.form_inputs_hint") %></p>
      </div>
      <button type="button"
              class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-2 rounded-xl border border-amber-200 transition-colors shrink-0"
              data-action="manufacturing-units#add">
        <span aria-hidden="true">+</span> <%= t("inventory.manufacturing.templates.add_line") %>
      </button>
    </div>

    <div class="hidden md:grid md:grid-cols-12 gap-3 px-5 py-3 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-100">
      <div class="md:col-span-5"><%= t("inventory.manufacturing.templates.ingredient") %></div>
      <div class="md:col-span-3"><%= t("inventory.manufacturing.templates.quantity") %></div>
      <div class="md:col-span-3"><%= t("inventory.ingredients.alternate_units.unit") %></div>
      <div class="md:col-span-1"></div>
    </div>

    <div class="divide-y divide-gray-100" data-manufacturing-units-target="list">
      <%= f.fields_for :manufacturing_template_lines do |line_f| %>
        <%= render "line_fields", f: line_f %>
      <% end %>
    </div>

    <template data-manufacturing-units-target="template">
      <%= f.fields_for :manufacturing_template_lines, ManufacturingTemplateLine.new, child_index: "NEW_RECORD" do |line_f| %>
        <%= render "line_fields", f: line_f %>
      <% end %>
    </template>
  </section>

  <div class="flex flex-wrap items-center gap-3 pt-2 pb-8">
    <%= f.submit template.persisted? ? t("actions.save") : t("inventory.manufacturing.templates.create"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to t("actions.cancel"),
          template.persisted? ? admin_inventory_manufacturing_template_path(template) : admin_inventory_manufacturing_templates_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
