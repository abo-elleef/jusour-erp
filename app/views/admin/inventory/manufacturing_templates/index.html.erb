<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<%= render "admin/inventory/tools_nav" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.manufacturing.templates.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.manufacturing.templates.description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to t("inventory.manufacturing.runs.history"),
            admin_inventory_manufacturing_runs_path,
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("inventory.manufacturing.templates.new_button"),
            new_admin_inventory_manufacturing_template_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </div>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("inventory.manufacturing.templates.name") %></th>
          <th class="p-3 text-start"><%= t("inventory.manufacturing.templates.output") %></th>
          <th class="p-3 text-end"><%= t("inventory.manufacturing.templates.yield_per_run") %></th>
          <th class="p-3 text-end"><%= t("inventory.manufacturing.templates.inputs") %></th>
          <th class="p-3 text-start"><%= t("inventory.manufacturing.templates.status") %></th>
          <th class="p-3 pe-5 text-end"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @templates.each do |template| %>
          <tr class="hover:bg-gray-50/60">
            <td class="p-3 ps-5 font-semibold text-gray-900">
              <%= link_to template.name, admin_inventory_manufacturing_template_path(template), class: "hover:text-amber-700" %>
            </td>
            <td class="p-3 text-gray-700"><%= template.output_ingredient.name %></td>
            <td class="p-3 text-end tabular-nums">
              <%= template.yield_quantity %>
              <%= ingredient_unit_label(template.output_ingredient.unit) %>
            </td>
            <td class="p-3 text-end tabular-nums"><%= template.manufacturing_template_lines.size %></td>
            <td class="p-3">
              <span class="text-xs font-semibold <%= template.active? ? 'text-emerald-700' : 'text-gray-500' %>">
                <%= template.active? ? t("inventory.manufacturing.templates.active") : t("inventory.manufacturing.templates.inactive") %>
              </span>
            </td>
            <td class="p-3 pe-5 text-end">
              <%= link_to t("actions.view"), admin_inventory_manufacturing_template_path(template),
                    class: "text-xs font-semibold text-amber-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @templates.empty? %>
      <p class="p-8 text-center text-sm text-gray-500"><%= t("inventory.manufacturing.templates.empty") %></p>
    <% end %>
  </section>
</div>
