<%# locals: f (manufacturing_template_line fields builder) %>
<% input_class = pos_input_class %>
<% line = f.object %>
<% line_units = line.ingredient ? line.ingredient.available_units : [] %>
<div class="px-5 py-4 md:py-3 md:grid md:grid-cols-12 md:gap-3 md:items-start space-y-3 md:space-y-0"
     data-mfg-line data-manufacturing-units-target="row">
  <%= f.hidden_field :_destroy, value: false, data: { manufacturing_units_target: "destroy" } %>
  <%= f.hidden_field :id %>
  <div class="md:col-span-5">
    <span class="md:hidden text-xs font-semibold text-gray-600 mb-1.5 block"><%= t("inventory.manufacturing.templates.ingredient") %></span>
    <%= render "shared/searchable_select",
          form: f,
          field: :ingredient_id,
          selected: line.ingredient_id,
          placeholder: t("inventory.manufacturing.templates.select_ingredient"),
          input_class: input_class,
          html: { data: { action: "searchable-select:change->manufacturing-units#lineChanged" } } %>
  </div>
  <div class="md:col-span-3">
    <span class="md:hidden text-xs font-semibold text-gray-600 mb-1.5 block"><%= t("inventory.manufacturing.templates.quantity") %></span>
    <%= f.number_field :quantity_used, step: 0.0001, min: 0.0001,
          placeholder: "0",
          class: "#{input_class} tabular-nums" %>
  </div>
  <div class="md:col-span-3">
    <span class="md:hidden text-xs font-semibold text-gray-600 mb-1.5 block"><%= t("inventory.ingredients.alternate_units.unit") %></span>
    <%= f.select :unit,
          options_for_select(line_units.map { |u| [ingredient_unit_label(u), u] }, line.unit.presence || line.ingredient&.unit),
          { include_blank: line.ingredient.nil? },
          class: "#{input_class} appearance-none px-2",
          data: { "mfg-line-unit": "" } %>
  </div>
  <div class="md:col-span-1 flex md:justify-end md:pt-1.5">
    <button type="button"
            class="inline-flex items-center justify-center w-9 h-9 text-red-700 hover:bg-red-50 rounded-xl border border-red-200 transition-colors"
            data-action="manufacturing-units#remove"
            title="<%= t("inventory.manufacturing.templates.remove_line") %>"
            aria-label="<%= t("inventory.manufacturing.templates.remove_line") %>">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>
</div>
