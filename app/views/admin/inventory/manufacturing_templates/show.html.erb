<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<%= render "admin/inventory/tools_nav" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @template.name %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("inventory.manufacturing.templates.output") %>:
        <%= link_to @template.output_ingredient.name, admin_inventory_ingredient_path(@template.output_ingredient),
              class: "font-semibold text-amber-700 hover:text-amber-800" %>
        · <%= @template.yield_quantity %> <%= ingredient_unit_label(@template.output_ingredient.unit) %>
        <%= t("inventory.manufacturing.templates.per_run") %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if current_user.can_access_production? && @template.active? && @lines.any? %>
        <%= link_to t("inventory.manufacturing.templates.open_production_screen"), production_path,
              class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-xl" %>
      <% end %>
      <%= link_to t("actions.edit"), edit_admin_inventory_manufacturing_template_path(@template),
            class: "border border-gray-200 text-gray-700 text-sm font-semibold px-4 py-2 rounded-xl hover:bg-gray-50" %>
      <%= link_to t("inventory.manufacturing.templates.back"), admin_inventory_manufacturing_templates_path,
            class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
    </div>
  </div>

  <% if current_user.can_access_production? && @template.active? && @lines.any? %>
    <section class="rounded-2xl border border-amber-200 bg-amber-50/40 overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-amber-100">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.manufacturing.templates.record_run") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.manufacturing.templates.record_run_hint") %></p>
      </div>
      <%= form_with url: run_admin_inventory_manufacturing_template_path(@template),
            method: :post,
            class: "p-5 flex flex-wrap items-end gap-4" do %>
        <div class="min-w-[10rem]">
          <%= label_tag :runs_count, t("production.runs_label"), class: label_class %>
          <%= number_field_tag :runs_count, 1, min: 0.001, step: 0.001, required: true, class: pos_input_class %>
        </div>
        <div class="min-w-[10rem]">
          <%= label_tag :shelf_life_days, t("production.shelf_life_label"), class: label_class %>
          <%= number_field_tag :shelf_life_days, nil, min: 1, step: 1, required: true, class: pos_input_class %>
          <p class="text-xs text-gray-500 mt-1"><%= t("production.shelf_life_hint") %></p>
        </div>
        <div class="flex-1 min-w-[12rem]">
          <%= label_tag :notes, t("production.notes_label"), class: label_class %>
          <%= text_field_tag :notes, nil, class: pos_input_class %>
        </div>
        <%= submit_tag t("production.record"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </section>
  <% elsif current_user.can_access_production? && !@template.active? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/40 px-5 py-4 mb-6 text-sm text-amber-900">
      <%= t("inventory.manufacturing.templates.inactive_run_hint") %>
    </div>
  <% end %>

  <% if @template.notes.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
      <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("inventory.manufacturing.templates.notes") %></p>
      <p class="text-sm text-gray-700 mt-1"><%= @template.notes %></p>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.manufacturing.templates.input_lines") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.manufacturing.templates.input_lines_hint") %></p>
      </div>
      <% if @lines.any? %>
        <ul class="divide-y divide-gray-100">
          <% @lines.each do |line| %>
            <li class="px-5 py-3 flex justify-between items-center gap-3">
              <div>
                <p class="font-semibold text-gray-900"><%= line.ingredient.name %></p>
                <p class="text-xs text-gray-500">
                  <%= line.quantity_used %> <%= ingredient_unit_label(line.ingredient.unit) %>
                  <%= t("inventory.manufacturing.templates.per_run") %>
                </p>
              </div>
              <%= button_to t("inventory.manufacturing.templates.remove_line"),
                    admin_inventory_manufacturing_template_line_path(@template, line),
                    method: :delete,
                    class: "text-xs font-semibold text-red-700 hover:text-red-800",
                    form: { data: { turbo_confirm: t("inventory.manufacturing.templates.remove_line_confirm") } } %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.manufacturing.templates.no_lines") %></p>
      <% end %>
      <div class="px-5 py-4 border-t border-gray-100 bg-gray-50/50">
        <%= form_with url: admin_inventory_manufacturing_template_lines_path(@template),
              class: "flex flex-wrap gap-3 items-end" do %>
          <div class="flex-1 min-w-[10rem]">
            <%= label_tag "manufacturing_template_line[ingredient_id]", t("inventory.manufacturing.templates.ingredient"), class: label_class %>
            <%= select_tag "manufacturing_template_line[ingredient_id]",
                  options_from_collection_for_select(Ingredient.active.order(:name), :id, :name),
                  include_blank: t("inventory.manufacturing.templates.select_ingredient"),
                  class: "w-full border border-gray-300 rounded-xl px-3 py-2.5 text-sm", required: true %>
          </div>
          <div class="w-28">
            <%= label_tag "manufacturing_template_line[quantity_used]", t("inventory.manufacturing.templates.quantity"), class: label_class %>
            <%= number_field_tag "manufacturing_template_line[quantity_used]", nil,
                  step: 0.0001, min: 0.0001, required: true,
                  class: "w-full border border-gray-300 rounded-xl px-3 py-2.5 text-sm" %>
          </div>
          <%= submit_tag t("inventory.manufacturing.templates.add_line"),
                class: "bg-gray-900 text-white text-sm font-semibold px-4 py-2.5 rounded-xl" %>
        <% end %>
      </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex justify-between items-center gap-3">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.manufacturing.runs.recent") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.manufacturing.runs.recent_hint") %></p>
        </div>
        <%= link_to t("inventory.manufacturing.runs.view_all"), admin_inventory_manufacturing_runs_path,
              class: "text-xs font-semibold text-amber-700" %>
      </div>
      <% if @recent_runs.any? %>
        <table class="w-full text-sm">
          <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("inventory.manufacturing.runs.date") %></th>
              <th class="p-3 text-end"><%= t("inventory.manufacturing.runs.runs_count") %></th>
              <th class="p-3 text-start"><%= t("inventory.manufacturing.runs.expires") %></th>
              <th class="p-3 pe-5 text-start"><%= t("inventory.manufacturing.runs.by") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @recent_runs.each do |run| %>
              <tr>
                <td class="p-3 ps-5">
                  <%= link_to l(run.occurred_on, format: :long), admin_inventory_manufacturing_run_path(run),
                        class: "font-medium text-amber-700 hover:text-amber-800" %>
                </td>
                <td class="p-3 text-end tabular-nums font-semibold"><%= run.runs_count %></td>
                <td class="p-3 text-gray-600 tabular-nums"><%= l(run.output_expires_on, format: :short) %></td>
                <td class="p-3 pe-5 text-gray-600"><%= run.user.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.manufacturing.runs.empty") %></p>
      <% end %>
    </section>
  </div>

  <div class="flex justify-end">
    <%= button_to t("inventory.manufacturing.templates.delete"),
          admin_inventory_manufacturing_template_path(@template),
          method: :delete,
          class: "text-sm font-semibold text-red-700 hover:text-red-800",
          form: { data: { turbo_confirm: t("inventory.manufacturing.templates.delete_confirm") } } %>
  </div>
</div>
