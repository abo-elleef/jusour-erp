<h1 class="text-2xl font-bold mb-4">Receive delivery — <%= @purchase_order.po_number %></h1>
<%= form_with url: admin_inventory_purchase_order_delivery_path(@purchase_order), class: "bg-white shadow rounded-lg p-6" do %>
  <table class="w-full text-sm">
    <thead class="border-b"><tr><th class="text-left p-2">Ingredient</th><th>Ordered</th><th>Received qty</th><th>Expires</th><th>Batch ref</th><th>Notes</th></tr></thead>
    <tbody>
      <% @items.each_with_index do |item, i| %>
        <% short = item.quantity_received.to_d < item.quantity_ordered.to_d %>
        <tr class="border-b <%= short ? 'bg-orange-50' : '' %>">
          <td class="p-2 font-medium"><%= item.ingredient.name %><%= hidden_field_tag "deliveries[#{i}][purchase_order_item_id]", item.id %></td>
          <td class="p-2"><%= item.quantity_ordered %> (got <%= item.quantity_received %>)</td>
          <td class="p-2"><%= number_field_tag "deliveries[#{i}][quantity_received]", item.remaining_to_receive, step: 0.001, class: "border rounded px-2 py-1 w-24" %></td>
          <td class="p-2"><%= date_field_tag "deliveries[#{i}][expires_on]", nil, class: "border rounded px-2 py-1" %></td>
          <td class="p-2"><%= text_field_tag "deliveries[#{i}][batch_reference]", nil, class: "border rounded px-2 py-1 w-28" %></td>
          <td class="p-2"><%= text_field_tag "deliveries[#{i}][discrepancy_notes]", nil, class: "border rounded px-2 py-1 w-32" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= submit_tag "Confirm receipt", class: "mt-4 bg-green-600 text-white px-4 py-2 rounded-lg" %>
<% end %>
