<% embedded = local_assigns[:embedded] %>
<%# The standalone page gets the full width of <main>, so its fields lay out in
    columns; embedded in the edit page's half-column they stay stacked. %>
<% wide = !embedded %>
<% form_class = embedded ? "space-y-5" : "bg-white rounded-lg shadow p-6 space-y-4" %>
<% pair_class = wide ? "grid grid-cols-1 lg:grid-cols-2 gap-4" : "space-y-4" %>

<%= form_with model: ingredient, url: ingredient.persisted? ? admin_inventory_ingredient_path(ingredient) : admin_inventory_ingredients_path, class: form_class do |f| %>
  <% if ingredient.errors.any? %>
    <div class="text-red-700 text-sm bg-red-50 border border-red-200 rounded-lg p-3">
      <%= ingredient.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="space-y-4">
    <div class="<%= pair_class %>">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :code, t("inventory.ingredients.form.code"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :code, class: "w-full border border-gray-300 rounded-lg px-3 py-2 font-mono",
              placeholder: t("inventory.ingredients.form.code_placeholder") %>
        <p class="text-xs text-gray-500 mt-1"><%= t("inventory.ingredients.form.code_hint") %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :ingredient_category_id, t("inventory.ingredients.form.category"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :ingredient_category_id, @categories, :id, :name,
              { include_blank: t("inventory.ingredients.form.select_category") },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :unit_id, t("inventory.ingredients.form.unit"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :unit_id,
              options_for_select(company_unit_options, ingredient.unit_id),
              { include_blank: t("inventory.ingredients.form.select_unit") },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        <% if ingredient.persisted? %>
          <p class="text-xs text-amber-700 mt-1.5"><%= t("inventory.ingredients.form.unit_change_hint") %></p>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 space-y-4">
      <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide"><%= t("inventory.ingredients.form.stock_cost_heading") %></p>
      <% unless ingredient.persisted? %>
        <% if @stock_locations&.any? %>
          <div class="<%= "lg:w-1/2 lg:pe-2" if wide %>">
            <%= label_tag :stock_location_id, t("inventory.ingredients.form.stock_location"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag :stock_location_id,
                  options_for_select(
                    @stock_locations.map { |location| [stock_location_option_label(location), location.id] },
                    @selected_stock_location_id
                  ),
                  class: "w-full border border-gray-300 rounded-lg px-3 py-2 appearance-none",
                  required: true %>
            <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.form.stock_location_hint") %></p>
          </div>
        <% else %>
          <p class="text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
            <%= t("inventory.ingredients.form.stock_location_empty") %>
          </p>
        <% end %>
      <% end %>
      <div class="grid grid-cols-1 sm:grid-cols-2 <%= wide ? "lg:grid-cols-3 xl:grid-cols-5" : "lg:grid-cols-4" %> gap-4">
        <div>
          <%= f.label :reorder_threshold, t("inventory.ingredients.form.reorder_at"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :reorder_threshold, step: 0.001, min: 0, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :max_quantity, t("inventory.ingredients.form.max_quantity"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :max_quantity, step: 0.001, min: 0, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :quantity_on_hand, t("inventory.ingredients.form.on_hand"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :quantity_on_hand, step: 0.001, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :cost_per_unit_dollars, t("inventory.ingredients.form.cost_per_unit"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :cost_per_unit_dollars,
                value: ingredient_cost_dollars(ingredient),
                step: 0.01,
                min: 0,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :selling_price_pounds, t("inventory.ingredients.form.selling_price"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :selling_price_pounds, step: 0.01, min: 0,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
          <p class="text-xs text-gray-500 mt-1"><%= t("inventory.ingredients.form.selling_price_hint") %></p>
        </div>
      </div>
      <p class="text-xs text-gray-500"><%= t("inventory.ingredients.form.stock_cost_hint",
            currency: money_symbol,
            unit: ingredient.unit.present? ? ingredient_unit_label(ingredient.unit) : t("inventory.ingredients.form.unit_fallback")) %></p>
    </div>

    <% unless ingredient.persisted? %>
      <%# Assigning the vendor here is what keeps creating an ingredient a single
          step. It is optional — further suppliers are managed on the edit page. %>
      <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 space-y-4">
        <div>
          <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide"><%= t("inventory.ingredients.form.supplier_heading") %></p>
          <p class="text-xs text-gray-500 mt-1"><%= t("inventory.ingredients.form.supplier_hint") %></p>
        </div>

        <% if @available_suppliers&.any? %>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
            <div class="sm:col-span-5">
              <%= label_tag "supplier_ingredient[supplier_id]", t("inventory.ingredients.supplier_links.supplier"), class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= select_tag "supplier_ingredient[supplier_id]",
                    options_from_collection_for_select(@available_suppliers, :id, :name, @supplier_link_values[:supplier_id]),
                    include_blank: t("inventory.ingredients.form.supplier_none"),
                    class: "w-full border border-gray-300 rounded-lg px-3 py-2 bg-white" %>
            </div>
            <div class="sm:col-span-4">
              <%= label_tag "supplier_ingredient[price_dollars]", t("inventory.ingredients.form.supplier_price"), class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= number_field_tag "supplier_ingredient[price_dollars]", @supplier_link_values[:price_dollars],
                    step: 0.01,
                    min: 0,
                    placeholder: "0.00",
                    class: "w-full border border-gray-300 rounded-lg px-3 py-2 bg-white" %>
              <p class="text-xs text-gray-500 mt-1"><%= t("inventory.ingredients.form.supplier_price_hint") %></p>
            </div>
            <div class="sm:col-span-3 flex items-center gap-2 sm:pt-7">
              <%= hidden_field_tag "supplier_ingredient[preferred]", "0", id: nil %>
              <%= check_box_tag "supplier_ingredient[preferred]", "1", @supplier_link_values.fetch(:preferred, "1") == "1",
                    id: "supplier_ingredient_preferred", class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
              <%= label_tag "supplier_ingredient_preferred", t("inventory.ingredients.form.supplier_preferred"), class: "text-sm text-gray-700" %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= label_tag "supplier_ingredient[vendor_product_name]", t("inventory.ingredients.supplier_links.vendor_product_name"), class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= text_field_tag "supplier_ingredient[vendor_product_name]", @supplier_link_values[:vendor_product_name],
                    placeholder: t("inventory.ingredients.supplier_links.vendor_product_name_placeholder"),
                    class: "w-full border border-gray-300 rounded-lg px-3 py-2 bg-white" %>
            </div>
            <div>
              <%= label_tag "supplier_ingredient[vendor_sku]", t("inventory.ingredients.supplier_links.vendor_sku"), class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= text_field_tag "supplier_ingredient[vendor_sku]", @supplier_link_values[:vendor_sku],
                    placeholder: t("inventory.ingredients.supplier_links.vendor_sku_placeholder"),
                    class: "w-full border border-gray-300 rounded-lg px-3 py-2 bg-white" %>
            </div>
          </div>
        <% else %>
          <p class="text-sm text-gray-500"><%= t("inventory.ingredients.form.supplier_empty") %></p>
        <% end %>
      </div>
    <% end %>

    <div class="<%= pair_class %>">
      <div>
        <%= f.label :shelf_life_days, t("inventory.ingredients.form.shelf_life_days"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :shelf_life_days, min: 1, step: 1,
              class: "w-full border border-gray-300 rounded-lg px-3 py-2",
              placeholder: t("inventory.ingredients.form.shelf_life_days_placeholder") %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.form.shelf_life_days_hint") %></p>
      </div>

      <div class="flex items-start gap-3 <%= "lg:pt-7" if wide %>">
        <%= f.check_box :active, class: "mt-1 rounded border-gray-300" %>
        <div>
          <%= f.label :active, t("inventory.ingredients.form.active_label"), class: "text-sm font-medium text-gray-700" %>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.form.active_hint") %></p>
        </div>
      </div>
    </div>

    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
      <%= f.label :all_locations, t("inventory.ingredients.form.locations_label"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <label class="flex items-center gap-2.5 text-sm text-gray-800 mt-1">
        <%= f.check_box :all_locations, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
        <%= t("inventory.ingredients.form.all_locations") %>
      </label>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.form.all_locations_hint") %></p>

      <%= hidden_field_tag "ingredient[restricted_location_ids][]", "" %>
      <div class="grid grid-cols-1 sm:grid-cols-2 <%= "lg:grid-cols-3" if wide %> gap-2 mt-3">
        <% Location.active.ordered.each do |loc| %>
          <label class="flex items-center gap-2.5 text-sm text-gray-800">
            <%= check_box_tag "ingredient[restricted_location_ids][]", loc.id, ingredient.restricted_location_ids.include?(loc.id),
                  class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
            <%= loc.name %>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-gray-500 mt-1.5">
        <%= t("inventory.ingredients.form.locations_hint") %>
        <%= link_to t("inventory.ingredient_availabilities.form_link"), admin_inventory_ingredient_availabilities_path,
              class: "font-semibold text-amber-700 hover:underline" %>
      </p>
    </div>
  </div>

  <div class="pt-4 border-t border-gray-100" data-controller="ingredient-units">
    <h3 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.alternate_units.heading") %></h3>
    <p class="text-xs text-gray-500 mt-0.5 mb-2"><%= t("inventory.ingredients.alternate_units.hint") %></p>
    <div data-ingredient-units-target="list">
      <%= f.fields_for :ingredient_units do |uf| %>
        <%= render "unit_fields", f: uf, base_unit: ingredient.unit %>
      <% end %>
    </div>
    <template data-ingredient-units-target="template">
      <%= f.fields_for :ingredient_units, IngredientUnit.new, child_index: "NEW_RECORD" do |uf| %>
        <%= render "unit_fields", f: uf, base_unit: ingredient.unit %>
      <% end %>
    </template>
    <button type="button" data-action="ingredient-units#add"
            class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-2 rounded-lg border border-amber-200">
      <span aria-hidden="true">+</span> <%= t("inventory.ingredients.alternate_units.add") %>
    </button>
  </div>

  <div class="flex gap-2 pt-2 border-t border-gray-100">
    <%= f.submit class: "bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg font-medium" %>
    <%= link_to t("actions.cancel"), ingredient.persisted? ? admin_inventory_ingredient_path(ingredient) : admin_inventory_ingredients_path,
          class: "text-gray-600 hover:underline px-2 py-2" %>
  </div>
<% end %>
