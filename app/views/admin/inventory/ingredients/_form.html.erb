<% embedded = local_assigns[:embedded] %>
<% form_class = embedded ? "space-y-5" : "bg-white rounded-lg shadow p-6 space-y-4 max-w-lg" %>

<%= form_with model: ingredient, url: ingredient.persisted? ? admin_inventory_ingredient_path(ingredient) : admin_inventory_ingredients_path, class: form_class do |f| %>
  <% if ingredient.errors.any? %>
    <div class="text-red-700 text-sm bg-red-50 border border-red-200 rounded-lg p-3">
      <%= ingredient.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="<%= embedded ? "space-y-4" : "space-y-4" %>">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :ingredient_category_id, "Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :ingredient_category_id, @categories, :id, :name,
              { include_blank: "Select category…" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :unit, Ingredient::UNITS, { include_blank: "Select unit…" }, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 space-y-4">
      <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Stock & cost</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :reorder_threshold, "Reorder at", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :reorder_threshold, step: 0.001, min: 0, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :quantity_on_hand, "On hand", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :quantity_on_hand, step: 0.001, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :cost_per_unit_dollars, "Cost / unit", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :cost_per_unit_dollars,
                value: ingredient_cost_dollars(ingredient),
                step: 0.01,
                min: 0,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
      </div>
      <p class="text-xs text-gray-500">Low-stock alerts use reorder level. Cost is in dollars per <%= ingredient.unit.presence || "unit" %>.</p>
    </div>

    <div class="flex items-start gap-3">
      <%= f.check_box :active, class: "mt-1 rounded border-gray-300" %>
      <div>
        <%= f.label :active, "Active ingredient", class: "text-sm font-medium text-gray-700" %>
        <p class="text-xs text-gray-500 mt-0.5">Inactive items are hidden from lists and PO suggestions.</p>
      </div>
    </div>
  </div>

  <div class="flex gap-2 pt-2 border-t border-gray-100">
    <%= f.submit class: "bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg font-medium" %>
    <%= link_to "Cancel", ingredient.persisted? ? admin_inventory_ingredient_path(ingredient) : admin_inventory_ingredients_path,
          class: "text-gray-600 hover:underline px-2 py-2" %>
  </div>
<% end %>
