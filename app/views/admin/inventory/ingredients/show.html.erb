<% content_for :title, @ingredient.name %>
<%# Material 3 — ingredient detail %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% section_head = "px-5 py-4 border-b border-gray-100 bg-gray-50/80" %>
<% table_head = "border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide" %>
<% chip_secondary = "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
<% chip_destructive = "inline-flex text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
<% status = @ingredient.stock_status %>
<% on_hand_stat_class = case status
                        when :out then "border-red-200 bg-red-50/40"
                        when :low then "border-amber-200 bg-amber-50/40"
                        when :near then "border-amber-100 bg-amber-50/30"
                        else "border-gray-200 bg-white"
                        end %>

<div class="max-w-7xl">
  <%= render "admin/inventory/tools_nav" %>

  <%# ── Header ──────────────────────────────────────────────────────────── %>
  <header class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @ingredient.name %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= @ingredient.ingredient_category.name %> · <%= ingredient_unit_label(@ingredient.unit) %>
        <% if @ingredient.shelf_life_days.present? %>
          · <%= t("inventory.ingredients.show.shelf_life_days", count: @ingredient.shelf_life_days) %>
        <% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <% label, badge_class = ingredient_status_badge(@ingredient) %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full <%= badge_class %>">
        <%= label %>
      </span>
      <%# Adjust stock opens a modal — rarely needed, shouldn't dominate the page layout %>
      <button type="button" onclick="document.getElementById('adjust-stock-modal').showModal()"
              class="inline-flex text-xs font-semibold text-amber-800 hover:bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-300 transition-colors">
        <%= t("inventory.ingredients.show.adjust_stock") %>
      </button>
      <% if can_manage_inventory_settings? %>
        <%= link_to t("inventory.ingredients.show.edit"), edit_admin_inventory_ingredient_path(@ingredient),
              class: chip_secondary %>
      <% end %>
      <%= link_to t("inventory.consolidations.action"), new_admin_inventory_ingredient_consolidation_path(@ingredient),
            class: chip_secondary %>
    </div>
  </header>

  <%# ── Key stats ───────────────────────────────────────────────────────── %>
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
    <div class="rounded-2xl border p-4 <%= on_hand_stat_class %>">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.ingredients.show.on_hand") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums">
        <%= @ingredient.quantity_on_hand %> <span class="text-base font-semibold text-gray-600"><%= ingredient_unit_label(@ingredient.unit) %></span>
      </p>
      <% hint = ingredient_alt_unit_hint(@ingredient, @ingredient.quantity_on_hand) %>
      <% if hint %>
        <p class="text-xs text-gray-500 mt-0.5 tabular-nums"><%= hint %></p>
      <% end %>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.show.on_hand_hint") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.ingredients.show.reorder_at") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @ingredient.reorder_threshold %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.show.reorder_hint") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.ingredients.show.max_quantity") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @ingredient.max_quantity %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.show.max_quantity_hint") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.ingredients.show.cost_per_unit") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@ingredient.cost_per_unit_cents) %></p>
      <% if @manufactured %>
        <% if @ingredient.cost_source == "derived" %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.show.cost_hint_manufactured") %></p>
          <p class="text-xs text-emerald-700 mt-2 font-medium">
            <%= t("inventory.ingredients.cost_derive.derived_badge") %>
            <% if @ingredient.cost_synced_at %>
              · <%= t("inventory.ingredients.cost_derive.synced_at", time: time_ago_in_words(@ingredient.cost_synced_at)) %>
            <% end %>
          </p>
          <% if @batch_cost_cents %>
            <% if can_manage_inventory_settings? %>
              <%= button_to t("inventory.ingredients.cost_derive.action_refresh"),
                    sync_cost_from_batches_admin_inventory_ingredient_path(@ingredient),
                    method: :post,
                    class: "mt-2 inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-lg border border-gray-200 transition-colors" %>
            <% end %>
          <% else %>
            <p class="text-xs text-gray-500 mt-2"><%= t("inventory.ingredients.cost_derive.no_batches_hint") %></p>
          <% end %>
        <% else %>
          <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.cost_derive.manual_badge") %></p>
          <% if @batch_cost_cents && @batch_cost_cents != @ingredient.cost_per_unit_cents.to_i %>
            <p class="text-xs text-amber-800 mt-2 font-medium">
              <%= t("inventory.ingredients.cost_derive.batches_say", amount: format_amount(@batch_cost_cents)) %>
            </p>
            <% if can_manage_inventory_settings? %>
              <%= button_to t("inventory.ingredients.cost_derive.action_switch"),
                    sync_cost_from_batches_admin_inventory_ingredient_path(@ingredient),
                    method: :post,
                    form: { data: { turbo_confirm: t("inventory.ingredients.cost_derive.confirm",
                                                     from: format_money(@ingredient.cost_per_unit_cents),
                                                     to: format_money(@batch_cost_cents)) } },
                    class: "mt-2 inline-flex text-xs font-semibold text-amber-800 hover:bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-300 transition-colors" %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.show.cost_hint") %></p>
      <% if @last_invoice_cost %>
        <% invoiced = @last_invoice_cost.unit_cost_cents %>
        <% source_invoice = @last_invoice_cost.invoice %>
        <% invoice_link = link_to source_invoice.invoice_number,
             admin_inventory_vendor_invoice_path(source_invoice),
             class: "font-semibold underline underline-offset-2 hover:no-underline" %>
        <% if invoiced.to_i == @ingredient.cost_per_unit_cents.to_i %>
          <p class="text-xs text-emerald-700 mt-2 font-medium">
            <%= t("inventory.ingredients.cost_sync.in_sync_html", invoice: invoice_link) %>
          </p>
        <% else %>
          <p class="text-xs text-amber-800 mt-2 font-medium">
            <%= t("inventory.ingredients.cost_sync.differs_html",
                  invoiced: format_money(invoiced), invoice: invoice_link) %>
          </p>
          <% if can_manage_inventory_settings? %>
            <%= button_to t("inventory.ingredients.cost_sync.action"),
                  sync_cost_from_last_invoice_admin_inventory_ingredient_path(@ingredient),
                  method: :post,
                  form: { data: { turbo_confirm: t("inventory.ingredients.cost_sync.confirm",
                                                   from: format_money(@ingredient.cost_per_unit_cents),
                                                   to: format_money(invoiced),
                                                   invoice: @last_invoice_cost.invoice.invoice_number,
                                                   count: @last_invoice_cost.invoice_count) } },
                  class: "mt-2 inline-flex text-xs font-semibold text-amber-800 hover:bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-300 transition-colors" %>
          <% end %>
        <% end %>
      <% end %>
      <% end %>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.ingredients.show.stock_value") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@ingredient.stock_value_cents) %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.show.stock_value_hint") %></p>
    </div>
  </div>

  <%# ── Branch stock ─────────────────────────────────────────────────────── %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="<%= section_head %>">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.show.branch_stock.title") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.show.branch_stock.hint") %></p>
    </div>
    <% if @stock_locations.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[520px]">
          <thead class="<%= table_head %>">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("inventory.ingredients.show.branch_stock.location") %></th>
              <th class="p-3 text-end"><%= t("inventory.ingredients.show.branch_stock.on_hand") %></th>
              <th class="p-3 text-end"><%= t("inventory.ingredients.show.branch_stock.reorder_at") %></th>
              <th class="p-3 text-end"><%= t("inventory.ingredients.show.branch_stock.max_quantity") %></th>
              <th class="p-3 text-start"><%= t("inventory.ingredients.show.branch_stock.status") %></th>
              <th class="p-3 pe-5 text-end"><%= t("inventory.ingredients.index.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @stock_locations.each do |location| %>
              <% il = @ingredient_locations_by_location_id[location.id] %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5">
                  <div class="flex flex-wrap items-center gap-2">
                    <%= link_to location.name, admin_location_path(location),
                          class: "font-semibold text-amber-700 hover:text-amber-800" %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full <%= location.central_kitchen? ? "bg-orange-100 text-orange-800 border border-orange-200" : "bg-blue-100 text-blue-800 border border-blue-200" %>">
                      <%= t("admin.locations.type_#{location.location_type}") %>
                    </span>
                  </div>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-900">
                  <% if il %>
                    <%= number_with_precision(il.quantity_on_hand, precision: 3) %>
                    <span class="text-gray-500 text-xs"><%= ingredient_unit_label(@ingredient.unit) %></span>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700">
                  <% if il %>
                    <%= number_with_precision(il.reorder_threshold, precision: 3) %>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700">
                  <% if il %>
                    <%= number_with_precision(il.max_quantity, precision: 3) %>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3">
                  <% if il %>
                    <% case il.stock_status
                       when :out %>
                      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-red-100 text-red-800"><%= t("admin.inventory.status_out") %></span>
                    <% when :low %>
                      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800"><%= t("admin.inventory.status_low") %></span>
                    <% else %>
                      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800"><%= t("admin.inventory.status_ok") %></span>
                    <% end %>
                  <% else %>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 border border-gray-200">
                      <%= t("inventory.ingredients.show.branch_stock.not_tracked") %>
                    </span>
                  <% end %>
                </td>
                <td class="p-3 pe-5 text-end">
                  <% if policy(location).show? %>
                    <%= link_to (il ? t("inventory.ingredients.show.branch_stock.manage") : t("inventory.ingredients.show.branch_stock.assign")),
                          admin_location_ingredients_path(location),
                          class: chip_secondary %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.ingredients.show.branch_stock.empty") %></p>
    <% end %>
  </section>

  <%# ── Balance & price chart — open by default ─────────────────────────── %>
  <details class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6 group" open>
    <summary class="<%= section_head %> flex cursor-pointer list-none flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.show.balance_history.title") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.show.balance_history.hint") %></p>
      </div>
      <div class="flex items-center gap-3 ms-auto">
        <%= form_with url: admin_inventory_ingredient_path(@ingredient), method: :get,
              class: "flex items-center gap-2",
              html: { onclick: "event.stopPropagation()" },
              data: { turbo_frame: "balance-chart" } do %>
          <%# Blank = every location. Sits in the same form as the range so one
              change submits both and the frame reloads once. %>
          <label class="text-xs font-semibold text-gray-500 whitespace-nowrap"><%= t("inventory.ingredients.show.balance_history.location") %></label>
          <%= select_tag :chart_location_id,
                options_from_collection_for_select(@stock_locations, :id, :name, @chart_location&.id),
                include_blank: t("inventory.ingredients.show.balance_history.all_locations"),
                class: "#{pos_input_class} appearance-none text-xs py-1.5",
                onchange: "this.form.requestSubmit()" %>
          <label class="text-xs font-semibold text-gray-500 whitespace-nowrap"><%= t("inventory.ingredients.show.balance_history.range") %></label>
          <%= select_tag :chart_days,
                options_for_select(
                  Inventory::IngredientBalanceHistoryService::ALLOWED_DAYS.map do |days|
                    [t("inventory.ingredients.show.balance_history.ranges.#{days}"), days]
                  end,
                  @chart_days
                ),
                class: "#{pos_input_class} appearance-none text-xs py-1.5",
                onchange: "this.form.requestSubmit()" %>
        <% end %>
        <span class="text-xs font-semibold text-amber-700 group-open:hidden"><%= t("inventory.ingredients.show.balance_history.show") %></span>
        <span class="text-xs font-semibold text-gray-500 hidden group-open:inline"><%= t("inventory.ingredients.show.balance_history.hide") %></span>
      </div>
    </summary>
    <turbo-frame id="balance-chart">
    <div class="p-5">

      <% if @balance_history.any? %>
        <%# The series says which location it covers, so a filtered chart cannot
            be mistaken for the company-wide one. %>
        <% balance_name = if @chart_location
                            t("inventory.ingredients.show.balance_history.series_balance_at",
                              location: @chart_location.name,
                              unit: ingredient_unit_label(@ingredient.unit))
                          else
                            t("inventory.ingredients.show.balance_history.series_balance",
                              unit: ingredient_unit_label(@ingredient.unit))
                          end %>
        <% series = [{
             name: balance_name,
             data: @balance_history,
             dataset: { yAxisID: "y", borderColor: "#d97706", backgroundColor: "#d97706" }
           }] %>
        <% if @price_history.any? %>
          <%# Purchase price does not vary by branch, so this line stays
              company-wide even when the balance is filtered. %>
          <% series << {
               name: t("inventory.ingredients.show.balance_history.series_price"),
               data: @price_history,
               dataset: { yAxisID: "y1", stepped: true, borderDash: [4, 3],
                          borderColor: "#0f766e", backgroundColor: "#0f766e" }
             } %>
        <% end %>
        <div class="mt-5">
          <%= line_chart series, height: "280px", curve: false, library: {
                interaction: { mode: "index", intersect: false },
                scales: {
                  x: { ticks: { maxTicksLimit: 10 } },
                  y: {
                    position: "left",
                    title: { display: true,
                             text: t("inventory.ingredients.show.balance_history.axis_balance",
                                     unit: ingredient_unit_label(@ingredient.unit)) }
                  },
                  y1: {
                    position: "right",
                    display: @price_history.any?,
                    grid: { drawOnChartArea: false },
                    title: { display: true,
                             text: t("inventory.ingredients.show.balance_history.axis_price",
                                     currency: money_symbol) }
                  }
                }
              } %>
        </div>
        <% if @chart_location %>
          <p class="mt-2 text-xs text-gray-500"><%= t("inventory.ingredients.show.balance_history.location_note") %></p>
        <% end %>
        <% if @price_history.empty? %>
          <p class="mt-2 text-xs text-gray-500"><%= t("inventory.ingredients.show.balance_history.no_price_data") %></p>
        <% end %>
      <% else %>
        <p class="mt-4 text-sm text-gray-500"><%= t("inventory.ingredients.show.balance_history.empty") %></p>
      <% end %>
    </div>
    </turbo-frame>
  </details>

  <%# ── Main two-column grid ─────────────────────────────────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

    <%# Left column: adjustments + recipes %>
    <div class="space-y-6">

      <%# Recent adjustments — with # index %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="<%= section_head %> flex flex-wrap justify-between items-center gap-2">
          <div>
            <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.show.recent_adjustments") %></h2>
            <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.show.adjustments_hint") %></p>
          </div>
          <%= link_to t("inventory.ingredients.adjustments.view_all"),
                adjustments_admin_inventory_ingredient_path(@ingredient),
                class: "text-xs font-semibold text-amber-700 hover:text-amber-800 whitespace-nowrap" %>
        </div>
        <% if @adjustments.any? %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[360px]">
              <thead class="<%= table_head %>">
                <tr>
                  <th class="p-3 ps-5 text-end w-8 text-gray-400">#</th>
                  <th class="p-3 text-start"><%= t("accounting.audit_log.time") %></th>
                  <th class="p-3 text-start"><%= t("inventory.ingredients.show.location") %></th>
                  <th class="p-3 text-start"><%= t("inventory.ingredients.show.adjustment_type") %></th>
                  <th class="p-3 pe-5 text-end"><%= t("inventory.ingredients.show.quantity_short") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 table-zebra">
                <% @adjustments.each_with_index do |adj, i| %>
                  <% source_path = stock_adjustment_source_path(adj) %>
                  <tr class="hover:bg-gray-100 transition-colors">
                    <td class="p-3 ps-5 text-end tabular-nums text-gray-400 text-xs"><%= i + 1 %></td>
                    <td class="p-3 whitespace-nowrap tabular-nums text-xs">
                      <% if source_path %>
                        <%= link_to l(adj.created_at, format: :short), source_path,
                              class: "text-amber-700 hover:text-amber-900 hover:underline font-medium" %>
                      <% else %>
                        <span class="text-gray-600"><%= l(adj.created_at, format: :short) %></span>
                      <% end %>
                    </td>
                    <td class="p-3 text-gray-700">
                      <%= adj.location&.name || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                    </td>
                    <td class="p-3 text-gray-900"><%= inventory_adjustment_type_label(adj.adjustment_type) %></td>
                    <td class="p-3 pe-5 text-end tabular-nums font-semibold <%= adj.quantity_delta.positive? ? "text-green-700" : "text-red-700" %>">
                      <%= stock_adjustment_quantity(adj) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.ingredients.show.adjustments_empty") %></p>
        <% end %>
      </section>

      <%# Recipes %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="<%= section_head %>">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.show.recipes") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.show.recipes_hint") %></p>
        </div>
        <% if @recipes.any? %>
          <ul class="divide-y divide-gray-100">
            <% @recipes.each do |recipe| %>
              <li class="px-5 py-3 flex flex-wrap justify-between items-center gap-3 hover:bg-gray-100 transition-colors">
                <div class="min-w-0">
                  <p class="font-semibold text-gray-900"><%= recipe.menu_item.name %></p>
                  <p class="text-xs text-gray-500 mt-0.5 tabular-nums">
                    <%= recipe.quantity_used %> <%= ingredient_unit_label(@ingredient.unit) %>
                  </p>
                </div>
                <% if can_manage_inventory_settings? %>
                  <%= button_to t("inventory.ingredients.show.remove_recipe"),
                        admin_inventory_ingredient_recipe_path(@ingredient, recipe),
                        method: :delete,
                        form: { class: "inline" },
                        class: chip_destructive %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.ingredients.show.recipes_empty") %></p>
        <% end %>
        <% if can_manage_inventory_settings? %>
        <div class="p-5 border-t border-gray-100 bg-gray-50/50">
          <%= form_with url: admin_inventory_ingredient_recipes_path(@ingredient), class: "flex flex-wrap gap-3 items-end" do %>
            <div class="flex-1 min-w-[12rem]">
              <%= label_tag "recipe[menu_item_id]", t("inventory.ingredients.show.menu_item"), class: label_class %>
              <%= select_tag "recipe[menu_item_id]",
                    options_from_collection_for_select(MenuItem.ordered, :id, :name),
                    class: "#{pos_input_class} appearance-none" %>
            </div>
            <div class="min-w-[6rem]">
              <%= label_tag "recipe[quantity_used]", t("inventory.ingredients.show.quantity_short"), class: label_class %>
              <%= number_field_tag "recipe[quantity_used]", nil, step: 0.0001, min: 0.0001, required: true,
                    class: "#{pos_input_class} tabular-nums" %>
            </div>
            <%= submit_tag t("actions.add"),
                  class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shrink-0" %>
          <% end %>
        </div>
        <% end %>
      </section>
    </div>

    <%# Right column: suppliers + FIFO batches (pushed down) %>
    <div class="space-y-6">

      <%# Suppliers %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="<%= section_head %>">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.show.suppliers") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.show.suppliers_hint") %></p>
        </div>
        <% if @supplier_links.any? %>
          <ul class="divide-y divide-gray-100">
            <% @supplier_links.each do |link| %>
              <li class="px-5 py-3 flex flex-wrap justify-between items-center gap-2 hover:bg-gray-100 transition-colors">
                <div class="min-w-0">
                  <%= link_to link.supplier.name, admin_inventory_supplier_path(link.supplier),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                  <% vendor_alias = [link.vendor_product_name, link.vendor_sku].compact_blank.join(" · ") %>
                  <% if vendor_alias.present? %>
                    <p class="text-xs text-gray-500 mt-0.5 truncate">
                      <span class="text-gray-400"><%= t("inventory.ingredients.show.vendor_calls_it") %></span>
                      <%= vendor_alias %>
                    </p>
                  <% end %>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-gray-900 tabular-nums"><%= format_money(link.price_cents) %></span>
                  <% if link.preferred? %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-200">
                      <%= t("inventory.ingredients.show.preferred") %>
                    </span>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.ingredients.show.suppliers_empty") %></p>
        <% end %>
      </section>

      <%# FIFO batches — pushed below suppliers, less frequently needed %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="<%= section_head %> flex flex-wrap justify-between items-center gap-2">
          <div>
            <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.show.fifo_batches") %></h2>
            <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.show.fifo_hint") %></p>
          </div>
          <%= link_to t("inventory.ingredients.batches.view_all"),
                batches_admin_inventory_ingredient_path(@ingredient),
                class: "text-xs font-semibold text-amber-700 hover:text-amber-800 whitespace-nowrap" %>
        </div>
        <% if @stock_batches.any? %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[300px]">
              <thead class="<%= table_head %>">
                <tr>
                  <th class="p-3 ps-5 text-start"><%= t("inventory.ingredients.show.received") %></th>
                  <th class="p-3 text-start"><%= t("inventory.ingredients.show.remaining") %></th>
                  <th class="p-3 pe-5 text-start"><%= t("inventory.ingredients.show.expires") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 table-zebra">
                <% @stock_batches.each do |batch| %>
                  <tr class="hover:bg-gray-100 transition-colors">
                    <td class="p-3 ps-5 tabular-nums text-gray-900"><%= l(batch.received_on) %></td>
                    <td class="p-3 tabular-nums text-gray-700">
                      <%= batch.quantity_remaining %> <%= ingredient_unit_label(@ingredient.unit) %>
                    </td>
                    <td class="p-3 pe-5 tabular-nums <%= batch.expired? ? "text-red-700 font-semibold" : "text-gray-700" %>">
                      <% if batch.expired? %>
                        <span class="inline-flex items-center gap-1.5">
                          <%= batch.expires_on ? l(batch.expires_on) : t("accounting.shared.em_dash") %>
                          <span class="text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-red-100 text-red-800 border border-red-200">
                            <%= t("inventory.ingredients.show.expired") %>
                          </span>
                        </span>
                      <% else %>
                        <%= batch.expires_on ? l(batch.expires_on) : t("accounting.shared.em_dash") %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @stock_batches_total > 20 %>
            <p class="px-5 py-3 text-xs text-gray-500 border-t border-gray-100 bg-gray-50/50">
              <%= t("inventory.ingredients.batches.truncated", shown: 20, total: @stock_batches_total) %>
              <%= link_to t("inventory.ingredients.batches.view_all"), batches_admin_inventory_ingredient_path(@ingredient),
                    class: "font-semibold text-amber-700 hover:text-amber-800 ms-1" %>
            </p>
          <% end %>
        <% else %>
          <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.ingredients.show.batches_empty") %></p>
        <% end %>
      </section>
    </div>
  </div>

  <%# ── Units — collapsed, rarely changes ──────────────────────────────────── %>
  <details class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6 group" data-ingredient-units>
    <summary class="<%= section_head %> flex cursor-pointer list-none flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.show.units.title") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.show.units.hint") %></p>
      </div>
      <span class="text-xs font-semibold text-amber-700 group-open:hidden"><%= t("actions.expand") %></span>
      <span class="text-xs font-semibold text-gray-500 hidden group-open:inline"><%= t("actions.collapse") %></span>
    </summary>
    <div class="overflow-x-auto">
      <table class="w-full text-sm min-w-[480px]">
        <thead class="<%= table_head %>">
          <tr>
            <th class="p-3 ps-5 text-start"><%= t("inventory.ingredients.show.units.unit") %></th>
            <th class="p-3 text-start"><%= t("inventory.ingredients.show.units.type") %></th>
            <th class="p-3 text-start"><%= t("inventory.ingredients.show.units.conversion") %></th>
            <th class="p-3 pe-5 text-end"><%= t("inventory.ingredients.show.units.on_hand") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% base_label = ingredient_unit_label(@ingredient.unit) %>
          <tr class="hover:bg-gray-100 transition-colors">
            <td class="p-3 ps-5 font-semibold text-gray-900"><%= base_label %></td>
            <td class="p-3">
              <% if @ingredient.purchase_unit_record.nil? %>
                <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-200">
                  <%= t("inventory.ingredients.show.units.purchase") %>
                </span>
              <% else %>
                <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-200">
                  <%= t("inventory.ingredients.show.units.base") %>
                </span>
              <% end %>
            </td>
            <td class="p-3 text-gray-500"><%= t("inventory.ingredients.show.units.base_kept") %></td>
            <td class="p-3 pe-5 text-end tabular-nums text-gray-900">
              <%= number_with_precision(@ingredient.quantity_on_hand, precision: 3, strip_insignificant_zeros: true) %>
              <span class="text-gray-500 text-xs"><%= base_label %></span>
            </td>
          </tr>
          <% @ingredient_units.each do |iu| %>
            <% alt_label = ingredient_unit_label(iu.unit) %>
            <% factor = number_with_precision(iu.base_units_per_unit, precision: 4, strip_insignificant_zeros: true) %>
            <% on_hand_alt = @ingredient.from_base(@ingredient.quantity_on_hand, iu.unit) %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5 font-medium text-gray-900"><%= alt_label %></td>
              <td class="p-3">
                <% if iu.purchase_unit? %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-200">
                    <%= t("inventory.ingredients.show.units.purchase") %>
                  </span>
                <% else %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                    <%= t("inventory.ingredients.show.units.alternate") %>
                  </span>
                <% end %>
              </td>
              <td class="p-3 text-gray-700 tabular-nums">
                <%= t("inventory.ingredients.show.units.conversion_eq", unit: alt_label, qty: factor, base: base_label) %>
              </td>
              <td class="p-3 pe-5 text-end tabular-nums text-gray-900">
                <%= number_with_precision(on_hand_alt, precision: 3, strip_insignificant_zeros: true) %>
                <span class="text-gray-500 text-xs"><%= alt_label %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>

  <%# ── Audit history — collapsed, sticky header ────────────────────────── %>
  <details class="rounded-2xl border border-gray-200 bg-white overflow-hidden mt-4 group">
    <summary class="px-5 py-4 flex cursor-pointer list-none flex-wrap items-center justify-between gap-3 border-b border-gray-100 bg-gray-50/80 sticky top-0 z-10">
      <div>
        <h2 class="text-sm font-semibold text-gray-900">
          <% if @audits_total > 50 %>
            <%= t("accounting.audit_history.title_truncated", shown: 50, total: @audits_total) %>
          <% else %>
            <%= t("accounting.audit_history.title") %>
          <% end %>
        </h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("accounting.audit_history.hint") %></p>
      </div>
      <span class="text-xs font-semibold text-amber-700 group-open:hidden"><%= t("actions.expand") %></span>
      <span class="text-xs font-semibold text-gray-500 hidden group-open:inline"><%= t("actions.collapse") %></span>
    </summary>
    <div class="overflow-x-auto">
      <table class="w-full text-sm min-w-[36rem]">
        <thead class="border-b border-gray-100 bg-gray-50/50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start w-36"><%= t("accounting.audit_history.time") %></th>
            <th class="p-3 text-start w-40"><%= t("accounting.audit_history.user") %></th>
            <th class="p-3 text-start w-44"><%= t("accounting.audit_history.action") %></th>
            <th class="p-3 pe-5 text-start"><%= t("accounting.audit_history.changes") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% if @audits.blank? %>
            <tr>
              <td colspan="4" class="p-8 text-center text-sm text-gray-500"><%= t("accounting.audit_history.empty") %></td>
            </tr>
          <% else %>
            <% @audits.each do |audit| %>
              <% rows = audit_history_rows(audit) %>
              <tr class="align-top">
                <td class="p-3 ps-5 whitespace-nowrap tabular-nums text-gray-700">
                  <%= audit.created_at ? l(audit.created_at, format: :short) : t("accounting.shared.em_dash") %>
                </td>
                <td class="p-3">
                  <% if audit.user %>
                    <%= link_to audit.user.try(:name), admin_user_path(audit.user),
                          class: "text-gray-900 hover:text-gray-700 hover:underline" %>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3">
                  <span class="inline-flex whitespace-nowrap text-xs font-semibold px-2 py-0.5 rounded-full border
                    <%= case audit.action.to_s
                        when "create", "supplier_linked", "unit_added" then "bg-emerald-50 text-emerald-700 border-emerald-200"
                        when "destroy", "supplier_unlinked", "unit_removed" then "bg-red-50 text-red-700 border-red-200"
                        when "unit_marked_purchase", "unit_unmarked_purchase" then "bg-blue-50 text-blue-700 border-blue-200"
                        else "bg-amber-50 text-amber-800 border-amber-200"
                        end %>">
                    <%= t("accounting.audit_history.actions.#{audit.action}", default: audit.action.to_s) %>
                  </span>
                </td>
                <td class="p-3 pe-5 text-sm text-gray-700">
                  <% if rows.empty? %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% else %>
                    <ul class="space-y-1.5">
                      <% rows.each do |row| %>
                        <li class="leading-snug">
                          <span class="font-medium text-gray-900"><%= row[:label] %></span>
                          <% if row[:kind] == :update %>
                            <span class="text-gray-500">:</span>
                            <span class="inline-flex flex-wrap items-baseline gap-x-1" dir="ltr">
                              <bdi class="text-gray-500 line-through decoration-gray-300"><%= row[:from] %></bdi>
                              <span class="text-gray-400" aria-hidden="true">→</span>
                              <bdi class="text-gray-900"><%= row[:to] %></bdi>
                            </span>
                          <% else %>
                            <span class="text-gray-500">:</span>
                            <bdi class="text-gray-800" dir="ltr"><%= row[:value] %></bdi>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>
</div>

<%# ── Adjust stock modal ───────────────────────────────────────────────────── %>
<dialog id="adjust-stock-modal"
        class="m-auto rounded-[28px] shadow-2xl border-0 p-0 w-[480px] max-w-[95vw] backdrop:bg-black/50 backdrop:backdrop-blur-sm"
        onclick="if(event.target===this)this.close()">
  <div class="px-6 pt-6 pb-4 border-b border-gray-100 flex items-center justify-between">
    <div>
      <h3 class="text-base font-semibold text-gray-900"><%= t("inventory.ingredients.show.adjust_stock") %></h3>
      <p class="text-xs text-gray-500 mt-0.5"><%= @ingredient.name %></p>
    </div>
    <button type="button" onclick="document.getElementById('adjust-stock-modal').close()"
            class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 text-gray-500 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <div class="px-6 py-5">
    <%= form_with url: adjust_admin_inventory_ingredient_path(@ingredient), method: :post, class: "space-y-4" do %>
      <div>
        <%= label_tag :location_id, t("inventory.ingredients.show.location"), class: label_class %>
        <%= select_tag :location_id,
              options_for_select(@stock_locations.to_a.map { |loc| [stock_location_option_label(loc), loc.id] }),
              include_blank: t("inventory.ingredients.show.select_location"),
              required: true,
              class: "#{pos_input_class} appearance-none" %>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.ingredients.show.location_hint") %></p>
      </div>
      <div>
        <%= label_tag :quantity_delta, t("inventory.ingredients.show.quantity_delta"), class: label_class %>
        <% adj_units = @ingredient.available_units %>
        <% if adj_units.size > 1 %>
          <div class="flex gap-2">
            <%= number_field_tag :quantity_delta, nil, step: 0.001, required: true, class: "#{pos_input_class} basis-2/3 min-w-0" %>
            <%= select_tag :unit,
                  options_for_select(adj_units.map { |u| [ingredient_unit_label(u), u] }, @ingredient.unit),
                  class: "#{pos_input_class} appearance-none basis-1/3 min-w-0" %>
          </div>
        <% else %>
          <%= number_field_tag :quantity_delta, nil, step: 0.001, required: true, class: pos_input_class %>
        <% end %>
      </div>
      <div>
        <%= label_tag :adjustment_type, t("inventory.ingredients.show.adjustment_type"), class: label_class %>
        <%= select_tag :adjustment_type,
              options_for_select(
                StockAdjustment::ADJUSTMENT_TYPES.map { |type| [inventory_adjustment_type_label(type), type] }
              ),
              class: "#{pos_input_class} appearance-none" %>
      </div>
      <%= text_field_tag :reason_notes, nil,
            placeholder: t("inventory.ingredients.show.notes_placeholder"),
            class: pos_input_class %>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('adjust-stock-modal').close()"
                class="rounded-full px-5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors">
          <%= t("actions.cancel") %>
        </button>
        <%= submit_tag t("inventory.ingredients.show.apply_adjustment"),
              class: "rounded-full px-5 py-2 text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</dialog>
