<% content_for :title, admin_page_title %>
<%= render "admin/inventory/tools_nav" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.ingredients.index.description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to admin_inventory_ingredients_path(request.query_parameters.merge(format: :csv)),
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 transition-colors" do %>
        <span aria-hidden="true">↓</span> <%= t("inventory.ingredients.index.export_csv") %>
      <% end %>
      <%= link_to t("inventory.tools.ingredient_categories"), admin_inventory_ingredient_categories_path,
            class: "inline-flex items-center text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 transition-colors" %>
      <%= link_to new_admin_inventory_ingredient_path,
            class: "inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg font-medium" do %>
        <span aria-hidden="true">+</span> <%= t("inventory.ingredients.index.new_button") %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <%= link_to admin_inventory_ingredients_path,
          class: "bg-white rounded-lg shadow p-4 border-2 transition-colors #{@stock_filter.blank? && !@filtered ? 'border-amber-400 ring-1 ring-amber-200' : 'border-transparent hover:border-gray-200'}" do %>
      <p class="text-sm text-gray-500"><%= t("inventory.ingredients.index.stats.active") %></p>
      <p class="text-2xl font-bold mt-1"><%= @total_ingredients %></p>
    <% end %>

    <%= link_to admin_inventory_ingredients_path(stock: "low", q: params[:q]&.to_unsafe_h),
          class: "bg-white rounded-lg shadow p-4 border-2 transition-colors #{@stock_filter == 'low' ? 'border-red-400 ring-1 ring-red-200' : 'border-transparent hover:border-red-200'}" do %>
      <p class="text-sm text-gray-500"><%= t("inventory.ingredients.index.stats.low_stock") %></p>
      <p class="text-2xl font-bold mt-1 text-red-600"><%= @low_stock_count %></p>
      <p class="text-xs text-amber-600 mt-1"><%= t("inventory.ingredients.index.stats.click_to_filter") %></p>
    <% end %>

    <%= link_to admin_inventory_ingredients_path(stock: "out", q: params[:q]&.to_unsafe_h),
          class: "bg-white rounded-lg shadow p-4 border-2 transition-colors #{@stock_filter == 'out' ? 'border-red-500 ring-1 ring-red-200' : 'border-transparent hover:border-red-200'}" do %>
      <p class="text-sm text-gray-500"><%= t("inventory.ingredients.index.stats.out_of_stock") %></p>
      <p class="text-2xl font-bold mt-1 text-red-700"><%= @out_of_stock_count %></p>
      <p class="text-xs text-amber-600 mt-1"><%= t("inventory.ingredients.index.stats.click_to_filter") %></p>
    <% end %>

    <%= link_to admin_inventory_ingredients_path(stock: "expiring", q: params[:q]&.to_unsafe_h),
          class: "bg-white rounded-lg shadow p-4 border-2 transition-colors #{@stock_filter == 'expiring' ? 'border-orange-400 ring-1 ring-orange-200' : 'border-transparent hover:border-orange-200'}" do %>
      <p class="text-sm text-gray-500"><%= t("inventory.ingredients.index.stats.expiring") %></p>
      <p class="text-2xl font-bold mt-1 text-orange-600"><%= @expiring_count %></p>
      <p class="text-xs text-amber-600 mt-1"><%= t("inventory.ingredients.index.stats.click_to_filter") %></p>
    <% end %>
  </div>

  <div class="flex items-center gap-1.5 mb-4 text-sm">
    <span class="text-gray-500 me-1"><%= t("inventory.ingredients.index.status_filter") %>:</span>
    <% [["active", "status_active"], ["inactive", "status_inactive"], ["all", "status_all"]].each do |val, key| %>
      <%= link_to t("inventory.ingredients.index.#{key}"),
            admin_inventory_ingredients_path(status: val, q: params[:q]&.to_unsafe_h, stock: @stock_filter),
            class: "px-3 py-1.5 rounded-lg font-medium border transition-colors #{@status == val ? 'bg-gray-900 text-white border-gray-900' : 'text-gray-700 border-gray-200 hover:bg-gray-100'}" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-4 mb-4">
    <%= search_form_for @q, url: admin_inventory_ingredients_path, method: :get, class: "space-y-3" do |f| %>
      <%= hidden_field_tag :stock, @stock_filter if @stock_filter.present? %>
      <%= hidden_field_tag :status, @status if @status != "active" %>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
        <div class="md:col-span-6">
          <%= f.label :name_or_code_cont, t("inventory.ingredients.index.search_label"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.search_field :name_or_code_cont,
                placeholder: t("inventory.ingredients.index.search_placeholder"),
                class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="md:col-span-4">
          <%= f.label :ingredient_category_id_eq, t("inventory.ingredients.index.category"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :ingredient_category_id_eq, IngredientCategory.ordered, :id, :name,
                { include_blank: t("inventory.ingredients.index.all_categories") },
                class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="md:col-span-2 flex gap-2">
          <%= f.submit t("actions.apply_filters"), class: "flex-1 bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <% if @filtered %>
          <%= link_to t("inventory.ingredients.index.clear_filters"), admin_inventory_ingredients_path, class: "text-amber-600 hover:underline font-medium" %>
        <% end %>
        <% if @stock_filter == "low" %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-100 text-red-800 text-xs font-medium">
            <%= t("inventory.ingredients.index.stats.low_stock") %>
            <%= link_to "×", admin_inventory_ingredients_path(q: params[:q]&.to_unsafe_h), class: "hover:text-red-900 ml-0.5", aria: { label: t("inventory.ingredients.index.remove_low_stock_filter") } %>
          </span>
        <% elsif @stock_filter == "out" %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-100 text-red-800 text-xs font-medium">
            <%= t("inventory.ingredients.index.stats.out_of_stock") %>
            <%= link_to "×", admin_inventory_ingredients_path(q: params[:q]&.to_unsafe_h), class: "hover:text-red-900 ml-0.5", aria: { label: t("inventory.ingredients.index.remove_out_of_stock_filter") } %>
          </span>
        <% elsif @stock_filter == "expiring" %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-orange-100 text-orange-800 text-xs font-medium">
            <%= t("inventory.ingredients.index.expiring_within_days", days: StockBatch::EXPIRING_SOON_DAYS) %>
            <%= link_to "×", admin_inventory_ingredients_path(q: params[:q]&.to_unsafe_h), class: "hover:text-orange-900 ml-0.5", aria: { label: t("inventory.ingredients.index.remove_expiring_filter") } %>
          </span>
        <% end %>
        <span class="text-gray-500">
          <%= t("inventory.ingredients.index.showing", count: @ingredients.size) %>
        </span>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left min-w-[900px]">
        <thead class="bg-gray-50 border-b text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 pl-4"><%= t("inventory.ingredients.index.table.code") %></th>
            <th class="p-3"><%= t("inventory.ingredients.index.table.ingredient") %></th>
            <th class="p-3"><%= t("inventory.ingredients.index.table.stock") %></th>
            <th class="p-3"><%= t("inventory.ingredients.index.table.suppliers") %></th>
            <th class="p-3"><%= t("inventory.ingredients.index.table.status") %></th>
            <th class="p-3 text-right"><%= t("inventory.ingredients.index.table.cost_per_unit") %></th>
            <th class="p-3 text-right"><%= t("inventory.ingredients.index.table.value") %></th>
            <th class="p-3 pr-4 text-right"><%= t("inventory.ingredients.index.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @ingredients.empty? %>
            <tr>
              <td colspan="8" class="p-12 text-center">
                <p class="text-gray-600 font-medium mb-1"><%= t("inventory.ingredients.index.empty_title") %></p>
                <p class="text-gray-500 text-sm mb-4">
                  <% if @filtered %>
                    <%= t("inventory.ingredients.index.empty_description_filtered") %>
                  <% else %>
                    <%= t("inventory.ingredients.index.empty_description") %>
                  <% end %>
                </p>
                <% if @filtered %>
                  <%= link_to t("inventory.ingredients.index.clear_filters"), admin_inventory_ingredients_path, class: "text-amber-600 hover:underline text-sm font-medium" %>
                <% else %>
                  <%= link_to t("inventory.ingredients.index.new_button"), new_admin_inventory_ingredient_path,
                        class: "inline-block bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% @ingredients.each do |ingredient| %>
            <% label, badge_class = ingredient_status_badge(ingredient) %>
            <% stock_pct = [ingredient_stock_level_percent(ingredient), 100].min %>
            <tr class="<%= ingredient_stock_row_class(ingredient) %> hover:bg-gray-50/80">
              <td class="p-3 pl-4 font-mono text-xs font-semibold text-amber-700 whitespace-nowrap"><%= ingredient.code %></td>
              <td class="p-3">
                <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                      class: "font-medium text-blue-600 hover:underline" %>
                <p class="text-xs text-gray-500 mt-0.5"><%= ingredient.ingredient_category.name %></p>
              </td>
              <td class="p-3 min-w-[140px]">
                <div class="font-medium text-gray-900">
                  <%= ingredient.quantity_on_hand %> <span class="text-gray-500 font-normal"><%= ingredient_unit_label(ingredient.unit) %></span>
                </div>
                <div class="mt-1.5 h-1.5 w-full max-w-[120px] bg-gray-200 rounded-full overflow-hidden" title="<%= t("inventory.ingredients.index.reorder_tooltip", threshold: ingredient.reorder_threshold, unit: ingredient_unit_label(ingredient.unit)) %>">
                  <div class="h-full rounded-full <%= ingredient_stock_bar_class(ingredient) %>" style="width: <%= stock_pct %>%"></div>
                </div>
                <% if @stock_filter == "expiring" && (expiry_label = ingredient_expiring_label(ingredient)) %>
                  <p class="text-xs text-orange-600 font-medium mt-0.5"><%= expiry_label %></p>
                <% else %>
                  <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.index.reorder_at", threshold: ingredient.reorder_threshold) %></p>
                <% end %>
              </td>
              <td class="p-3 text-gray-600 max-w-[200px]">
                <%= ingredient_suppliers_summary(ingredient) %>
                <% if ingredient.suppliers.empty? %>
                  <%= link_to t("inventory.ingredients.index.assign_supplier"), edit_admin_inventory_ingredient_path(ingredient, anchor: "suppliers"),
                        class: "text-xs text-amber-600 hover:underline block mt-0.5" %>
                <% end %>
              </td>
              <td class="p-3">
                <span class="text-xs uppercase font-medium px-2 py-0.5 rounded <%= badge_class %>"><%= label %></span>
              </td>
              <td class="p-3 text-right text-gray-700 whitespace-nowrap"><%= format_money(ingredient.cost_per_unit_cents) %></td>
              <td class="p-3 text-right font-medium whitespace-nowrap"><%= format_money(ingredient.stock_value_cents) %></td>
              <td class="p-3 pr-4 text-right whitespace-nowrap">
                <div class="inline-flex gap-1 text-xs">
                  <%= link_to t("actions.view"), admin_inventory_ingredient_path(ingredient), class: "px-2 py-1 rounded border border-gray-200 hover:bg-gray-100 text-gray-700" %>
                  <%= link_to t("actions.edit"), edit_admin_inventory_ingredient_path(ingredient), class: "px-2 py-1 rounded border border-gray-200 hover:bg-gray-100 text-gray-700" %>
                  <%= link_to t("inventory.ingredients.index.adjust"), admin_inventory_ingredient_path(ingredient, anchor: "adjust"), class: "px-2 py-1 rounded bg-amber-50 border border-amber-200 text-amber-800 hover:bg-amber-100" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
