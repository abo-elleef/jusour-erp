<div class="mb-4">
  <%= link_to t("inventory.ingredients.back_to_inventory"), admin_inventory_ingredients_path, class: "text-gray-600 hover:underline text-sm" %>
</div>

<div class="flex flex-wrap justify-between items-start gap-3 mb-6">
  <div>
    <h1 class="text-2xl font-bold"><%= t("inventory.ingredients.edit.title", name: @ingredient.name) %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= @ingredient.ingredient_category.name %> · <%= ingredient_unit_label(@ingredient.unit) %></p>
  </div>
  <% label, badge_class = ingredient_status_badge(@ingredient) %>
  <span class="text-xs uppercase px-2 py-1 rounded <%= badge_class %>"><%= label %></span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div>
    <div class="bg-white rounded-lg shadow p-6 h-full">
      <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4"><%= t("inventory.ingredients.edit.details") %></h2>
      <%= render "form", ingredient: @ingredient, embedded: true %>
    </div>
  </div>

  <div>
    <%= render "supplier_links" %>
  </div>
</div>
