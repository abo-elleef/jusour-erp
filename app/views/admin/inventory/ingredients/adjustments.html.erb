<% content_for :title, @ingredient.name %>

<div class="max-w-5xl pt-4">
  <div class="mb-6 flex flex-wrap justify-between items-start gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 mt-2"><%= t("inventory.ingredients.adjustments.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= @ingredient.name %></p>
    </div>
    <% if @adjustments.any? %>
      <%= link_to adjustments_admin_inventory_ingredient_path(@ingredient, request.query_parameters.except("page").merge(format: :csv)),
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 transition-colors shrink-0" do %>
        <span aria-hidden="true">&darr;</span> <%= t("inventory.ingredients.adjustments.export_csv") %>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: adjustments_admin_inventory_ingredient_path(@ingredient), method: :get,
        class: "rounded-2xl border border-gray-200 bg-white p-4 mb-6" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-[10rem]">
        <%= label_tag :location_id, t("inventory.ingredients.adjustments.filters.location"),
              class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= select_tag :location_id,
              options_for_select(
                [[t("inventory.ingredients.adjustments.filters.all_locations"), ""]] +
                  @locations.map { |loc| [loc.name, loc.id] },
                @location_id),
              class: pos_input_class %>
      </div>
      <div>
        <%= label_tag :start_date, t("inventory.ingredients.adjustments.filters.from"),
              class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= date_field_tag :start_date, @start_date, class: pos_input_class %>
      </div>
      <div>
        <%= label_tag :end_date, t("inventory.ingredients.adjustments.filters.to"),
              class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= date_field_tag :end_date, @end_date, class: pos_input_class %>
      </div>
      <%= submit_tag t("inventory.ingredients.adjustments.filters.apply"),
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
      <% if @location_id.present? || @start_date.present? || @end_date.present? %>
        <%= link_to t("inventory.ingredients.adjustments.filters.clear"),
              adjustments_admin_inventory_ingredient_path(@ingredient),
              class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50 flex flex-wrap justify-between items-center gap-2">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.adjustments.title") %></h2>
      <span class="text-xs text-gray-500 tabular-nums"><%= t("inventory.ingredients.adjustments.count", count: @pagy.count) %></span>
    </div>
    <% if @adjustments.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[560px]">
          <thead class="border-b border-gray-100 bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("accounting.audit_log.time") %></th>
              <th class="p-3 text-start"><%= t("inventory.ingredients.show.location") %></th>
              <th class="p-3 text-start"><%= t("inventory.ingredients.show.adjustment_type") %></th>
              <th class="p-3 text-end"><%= t("inventory.ingredients.show.quantity_short") %></th>
              <th class="p-3 text-start"><%= t("inventory.ingredients.adjustments.user") %></th>
              <th class="p-3 pe-5 text-start"><%= t("inventory.ingredients.adjustments.reason") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @adjustments.each do |adj| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5 text-gray-600 whitespace-nowrap tabular-nums text-xs">
                  <%= l(adj.created_at, format: :short) %>
                </td>
                <td class="p-3 text-gray-700">
                  <%= adj.location&.name || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                </td>
                <td class="p-3 text-gray-900"><%= inventory_adjustment_type_label(adj.adjustment_type) %></td>
                <td class="p-3 text-end tabular-nums font-semibold <%= adj.quantity_delta.positive? ? "text-green-700" : "text-red-700" %>">
                  <%= stock_adjustment_quantity(adj) %>
                </td>
                <td class="p-3 text-gray-700 whitespace-nowrap"><%= adj.user&.name || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %></td>
                <td class="p-3 text-gray-600"><%= adj.reason_notes.presence || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.ingredients.adjustments.empty") %></p>
    <% end %>
  </section>

  <% if @pagy.pages > 1 %>
    <div class="flex items-center justify-center gap-2 mt-6 text-sm">
      <% if @pagy.previous %>
        <%= link_to t("actions.previous"), url_for(request.query_parameters.merge(page: @pagy.previous)),
              class: "px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-100 transition-colors" %>
      <% end %>
      <span class="text-gray-600 px-2 tabular-nums"><%= t("accounting.shared.pagination", page: @pagy.page, pages: @pagy.pages) %></span>
      <% if @pagy.next %>
        <%= link_to t("actions.next"), url_for(request.query_parameters.merge(page: @pagy.next)),
              class: "px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-100 transition-colors" %>
      <% end %>
    </div>
  <% end %>
</div>
