<% content_for :title, @ingredient.name %>

<div class="max-w-5xl pt-4">
  <div class="mb-6 flex flex-wrap justify-between items-start gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 mt-2"><%= t("inventory.ingredients.adjustments.title") %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= link_to @ingredient.name, admin_inventory_ingredient_path(@ingredient),
              class: "hover:text-gray-900 hover:underline transition-colors" %>
      </p>
    </div>
    <% if @adjustments.any? %>
      <%= link_to adjustments_admin_inventory_ingredient_path(@ingredient, format: :csv, location_id: @location_id, start_date: @start_date, end_date: @end_date),
            class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 transition-colors shrink-0" do %>
        <span aria-hidden="true">&darr;</span> <%= t("inventory.ingredients.adjustments.export_csv") %>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: adjustments_admin_inventory_ingredient_path(@ingredient), method: :get,
        class: "rounded-2xl border border-gray-200 bg-white p-4 mb-6" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-[10rem]">
        <%= label_tag :location_id, t("inventory.ingredients.adjustments.filters.location"),
              class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= select_tag :location_id,
              options_for_select(
                [[t("inventory.ingredients.adjustments.filters.all_locations"), ""]] +
                  @locations.map { |loc| [loc.name, loc.id] },
                @location_id),
              class: pos_input_class %>
      </div>
      <div>
        <%= label_tag :start_date, t("inventory.ingredients.adjustments.filters.from"),
              class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= date_field_tag :start_date, @start_date, class: pos_input_class %>
      </div>
      <div>
        <%= label_tag :end_date, t("inventory.ingredients.adjustments.filters.to"),
              class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
        <%= date_field_tag :end_date, @end_date, class: pos_input_class %>
      </div>
      <%= submit_tag t("inventory.ingredients.adjustments.filters.apply"),
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
      <% if @location_id.present? || @start_date.present? || @end_date.present? %>
        <%= link_to t("inventory.ingredients.adjustments.filters.clear"),
              adjustments_admin_inventory_ingredient_path(@ingredient),
              class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </div>
  <% end %>

  <% group_by_day = params[:group] == "day" %>
  <% toggle_params = request.query_parameters.merge(group_by_day ? { group: nil } : { group: "day" }).compact_blank %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50 flex flex-wrap justify-between items-center gap-2">
      <div class="flex flex-wrap items-center gap-3">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.ingredients.adjustments.title") %></h2>
        <span class="text-xs text-gray-500 tabular-nums"><%= t("inventory.ingredients.adjustments.count", count: @pagy.count) %></span>
      </div>
      <%= link_to adjustments_admin_inventory_ingredient_path(@ingredient, toggle_params),
            class: "inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors #{group_by_day ? 'bg-amber-600 border-amber-600 text-white' : 'border-gray-200 text-gray-600 hover:bg-gray-100'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 shrink-0" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2Zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75Z" clip-rule="evenodd" />
        </svg>
        <%= t("inventory.ingredients.adjustments.group_by_day") %>
      <% end %>
    </div>
    <% if @adjustments.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[560px]">
          <thead class="border-b border-gray-100 bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("accounting.audit_log.time") %></th>
              <th class="p-3 text-start"><%= t("inventory.ingredients.show.location") %></th>
              <th class="p-3 text-start"><%= t("inventory.ingredients.show.adjustment_type") %></th>
              <th class="p-3 text-end"><%= t("inventory.ingredients.show.quantity_short") %></th>
              <th class="p-3 text-end"><%= t("inventory.ingredients.adjustments.balance_after") %></th>
              <th class="p-3 text-start"><%= t("inventory.ingredients.adjustments.user") %></th>
              <th class="p-3 pe-5 text-start"><%= t("inventory.ingredients.adjustments.reason") %></th>
            </tr>
          </thead>
          <tbody>
            <% if group_by_day %>
            <% @adjustments.group_by { |adj| adj.created_at.to_date }.each do |date, day_adjs| %>
              <%
                day_net   = day_adjs.sum { |a| a.quantity_delta.to_d }
                additions = day_adjs.select { |a| a.quantity_delta.to_d.positive? }.sum { |a| a.quantity_delta.to_d }
                removals  = day_adjs.select { |a| a.quantity_delta.to_d.negative? }.sum { |a| a.quantity_delta.to_d }
              %>
              <tr class="bg-gray-50 border-y border-gray-200">
                <td class="p-3 ps-5 font-semibold text-gray-900 whitespace-nowrap" colspan="2">
                  <%= l(date, format: :long) %>
                  <span class="ms-2 text-xs font-normal text-gray-500">(<%= t("inventory.ingredients.adjustments.count", count: day_adjs.size) %>)</span>
                </td>
                <td class="p-3 text-gray-500 text-xs" colspan="2"></td>
                <td class="p-3 text-end tabular-nums text-xs font-semibold whitespace-nowrap <%= day_net >= 0 ? 'text-green-700' : 'text-red-700' %>">
                  <%= day_net >= 0 ? "+" : "" %><%= number_with_precision(day_net, precision: 3, strip_insignificant_zeros: true) %>
                  <span class="font-normal text-gray-400 ms-0.5"><%= ingredient_unit_label(@ingredient.unit) %></span>
                  <% if additions > 0 && removals < 0 %>
                    <span class="block text-xs font-normal text-gray-400">
                      <span class="text-green-600">+<%= number_with_precision(additions, precision: 3, strip_insignificant_zeros: true) %></span>
                      /
                      <span class="text-red-600"><%= number_with_precision(removals, precision: 3, strip_insignificant_zeros: true) %></span>
                    </span>
                  <% end %>
                </td>
                <td colspan="2"></td>
              </tr>
              <% day_adjs.each do |adj| %>
                <% source_path = stock_adjustment_source_path(adj) %>
                <tr class="hover:bg-gray-100 transition-colors border-b border-gray-100">
                  <td class="p-3 ps-5 whitespace-nowrap tabular-nums text-xs">
                    <% if source_path %>
                      <%= link_to l(adj.created_at, format: :short), source_path,
                            class: "text-amber-700 hover:text-amber-900 hover:underline font-medium" %>
                    <% else %>
                      <span class="text-gray-600"><%= l(adj.created_at, format: :short) %></span>
                    <% end %>
                  </td>
                  <td class="p-3 text-gray-700">
                    <%= adj.location&.name || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                  </td>
                  <td class="p-3 text-gray-900"><%= inventory_adjustment_type_label(adj.adjustment_type) %></td>
                  <td class="p-3 text-end tabular-nums font-semibold <%= adj.quantity_delta.positive? ? "text-green-700" : "text-red-700" %>">
                    <%= stock_adjustment_quantity(adj) %>
                  </td>
                  <td class="p-3 text-end tabular-nums text-gray-700">
                    <% if adj.balance_after %>
                      <%= number_with_precision(adj.balance_after, precision: 3, strip_insignificant_zeros: true) %>
                      <span class="text-xs text-gray-400 ms-0.5"><%= ingredient_unit_label(@ingredient.unit) %></span>
                    <% else %>
                      <%= tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                    <% end %>
                  </td>
                  <td class="p-3 whitespace-nowrap">
                    <% if adj.user %>
                      <%= link_to adj.user.name, admin_user_path(adj.user), class: "text-gray-700 hover:text-gray-900 hover:underline" %>
                    <% else %>
                      <%= tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                    <% end %>
                  </td>
                  <td class="p-3 text-gray-600"><%= adj.reason_notes.presence || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %></td>
                </tr>
              <% end %>
            <% end %>
            <% else %>
              <% @adjustments.each do |adj| %>
                <% source_path = stock_adjustment_source_path(adj) %>
                <tr class="hover:bg-gray-100 transition-colors border-b border-gray-100">
                  <td class="p-3 ps-5 whitespace-nowrap tabular-nums text-xs">
                    <% if source_path %>
                      <%= link_to l(adj.created_at, format: :short), source_path,
                            class: "text-amber-700 hover:text-amber-900 hover:underline font-medium" %>
                    <% else %>
                      <span class="text-gray-600"><%= l(adj.created_at, format: :short) %></span>
                    <% end %>
                  </td>
                  <td class="p-3 text-gray-700">
                    <%= adj.location&.name || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                  </td>
                  <td class="p-3 text-gray-900"><%= inventory_adjustment_type_label(adj.adjustment_type) %></td>
                  <td class="p-3 text-end tabular-nums font-semibold <%= adj.quantity_delta.positive? ? "text-green-700" : "text-red-700" %>">
                    <%= stock_adjustment_quantity(adj) %>
                  </td>
                  <td class="p-3 text-end tabular-nums text-gray-700">
                    <% if adj.balance_after %>
                      <%= number_with_precision(adj.balance_after, precision: 3, strip_insignificant_zeros: true) %>
                      <span class="text-xs text-gray-400 ms-0.5"><%= ingredient_unit_label(@ingredient.unit) %></span>
                    <% else %>
                      <%= tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                    <% end %>
                  </td>
                  <td class="p-3 whitespace-nowrap">
                    <% if adj.user %>
                      <%= link_to adj.user.name, admin_user_path(adj.user), class: "text-gray-700 hover:text-gray-900 hover:underline" %>
                    <% else %>
                      <%= tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
                    <% end %>
                  </td>
                  <td class="p-3 text-gray-600"><%= adj.reason_notes.presence || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("inventory.ingredients.adjustments.empty") %></p>
    <% end %>
  </section>

  <% if @pagy.pages > 1 %>
    <div class="flex items-center justify-center gap-2 mt-6 text-sm">
      <% if @pagy.previous %>
        <%= link_to t("actions.previous"), url_for(request.query_parameters.merge(page: @pagy.previous)),
              class: "px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-100 transition-colors" %>
      <% end %>
      <span class="text-gray-600 px-2 tabular-nums"><%= t("accounting.shared.pagination", page: @pagy.page, pages: @pagy.pages) %></span>
      <% if @pagy.next %>
        <%= link_to t("actions.next"), url_for(request.query_parameters.merge(page: @pagy.next)),
              class: "px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-100 transition-colors" %>
      <% end %>
    </div>
  <% end %>
</div>
