<div id="suppliers" class="bg-white rounded-lg shadow p-6">
  <div class="flex flex-wrap justify-between items-start gap-2 mb-1">
    <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide"><%= t("inventory.ingredients.supplier_links.heading") %></h2>
    <span class="text-xs text-gray-500"><%= t("inventory.ingredients.supplier_links.assigned", count: @supplier_links.size) %></span>
  </div>
  <p class="text-sm text-gray-500 mb-5"><%= t("inventory.ingredients.supplier_links.description") %></p>

  <% if @supplier_links.any? %>
    <div class="hidden sm:grid grid-cols-12 gap-3 px-3 pb-2 text-xs font-medium text-gray-500 uppercase tracking-wide">
      <div class="col-span-4"><%= t("inventory.ingredients.supplier_links.supplier") %></div>
      <div class="col-span-3"><%= t("inventory.ingredients.supplier_links.price_per_unit") %></div>
      <div class="col-span-2 text-center"><%= t("inventory.ingredients.supplier_links.preferred") %></div>
      <div class="col-span-3 text-right"><%= t("inventory.ingredients.index.table.actions") %></div>
    </div>

    <div class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
      <% @supplier_links.each do |link| %>
        <div class="flex items-start gap-2 p-4 sm:px-3 bg-white hover:bg-gray-50/80">
        <%= form_with model: link,
              url: admin_inventory_ingredient_supplier_ingredient_path(@ingredient, link),
              method: :patch,
              class: "flex-1 min-w-0 space-y-3" do |f| %>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
          <div class="sm:col-span-4 flex items-center gap-2 min-w-0">
            <span class="sm:hidden text-xs font-medium text-gray-500 w-20 shrink-0"><%= t("inventory.ingredients.supplier_links.supplier") %></span>
            <div class="min-w-0">
              <%= link_to link.supplier.name, admin_inventory_supplier_path(link.supplier),
                    class: "font-medium text-blue-600 hover:underline truncate block" %>
              <% if link.preferred? %>
                <span class="inline-block mt-0.5 text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-amber-100 text-amber-800"><%= t("inventory.ingredients.supplier_links.preferred") %></span>
              <% end %>
            </div>
          </div>

          <div class="sm:col-span-3 flex sm:block items-center gap-2">
            <span class="sm:hidden text-xs font-medium text-gray-500 w-20 shrink-0"><%= t("inventory.ingredients.supplier_links.price") %></span>
            <div class="flex-1 sm:flex-none">
              <span class="sm:hidden text-xs text-gray-400">$</span>
              <%= f.number_field :price_dollars,
                    value: supplier_ingredient_price_dollars(link),
                    step: 0.01,
                    min: 0,
                    class: "w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm" %>
            </div>
          </div>

          <div class="sm:col-span-2 flex sm:justify-center items-center gap-2">
            <span class="sm:hidden text-xs font-medium text-gray-500 w-20 shrink-0"><%= t("inventory.ingredients.supplier_links.preferred") %></span>
            <%= f.check_box :preferred, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
          </div>

          <div class="sm:col-span-3 flex sm:justify-end items-center gap-2">
            <%= f.submit t("actions.save"), class: "bg-gray-800 hover:bg-gray-900 text-white px-3 py-1.5 rounded-lg text-sm" %>
          </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <%= f.label :vendor_product_name, t("inventory.ingredients.supplier_links.vendor_product_name"), class: "block text-xs font-medium text-gray-500 mb-1" %>
              <%= f.text_field :vendor_product_name,
                    placeholder: t("inventory.ingredients.supplier_links.vendor_product_name_placeholder"),
                    class: "w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm" %>
            </div>
            <div>
              <%= f.label :vendor_sku, t("inventory.ingredients.supplier_links.vendor_sku"), class: "block text-xs font-medium text-gray-500 mb-1" %>
              <%= f.text_field :vendor_sku,
                    placeholder: t("inventory.ingredients.supplier_links.vendor_sku_placeholder"),
                    class: "w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm" %>
            </div>
          </div>
        <% end %>
        <%= button_to t("actions.remove"),
              admin_inventory_ingredient_supplier_ingredient_path(@ingredient, link),
              method: :delete,
              form: { data: { turbo_confirm: t("inventory.ingredients.supplier_links.remove_confirm", name: link.supplier.name) }, class: "shrink-0 pt-1" },
              class: "text-red-600 hover:text-red-800 text-sm px-2 py-1.5" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="border border-dashed border-gray-300 rounded-lg p-8 text-center text-gray-500 text-sm mb-5">
      <%= t("inventory.ingredients.supplier_links.empty") %>
    </div>
  <% end %>

  <% if @available_suppliers.any? %>
    <div class="mt-6 pt-6 border-t border-gray-100">
      <h3 class="text-sm font-semibold text-gray-800 mb-3"><%= t("inventory.ingredients.supplier_links.add_heading") %></h3>
      <%= form_with url: admin_inventory_ingredient_supplier_ingredients_path(@ingredient),
            class: "space-y-3 bg-amber-50/50 border border-amber-200/60 rounded-lg p-4" do %>
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
        <div class="sm:col-span-4">
          <%= label_tag "supplier_ingredient[supplier_id]", t("inventory.ingredients.supplier_links.supplier"), class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= select_tag "supplier_ingredient[supplier_id]",
                options_from_collection_for_select(@available_suppliers, :id, :name),
                include_blank: t("inventory.ingredients.supplier_links.choose_supplier"),
                required: true,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white" %>
        </div>
        <div class="sm:col-span-3">
          <%= label_tag "supplier_ingredient[price_dollars]", t("inventory.ingredients.supplier_links.price_dollars"), class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= number_field_tag "supplier_ingredient[price_dollars]",
                ingredient_cost_dollars(@ingredient),
                step: 0.01,
                min: 0,
                placeholder: "0.00",
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white" %>
        </div>
        <div class="sm:col-span-2 flex items-center gap-2 sm:pb-2">
          <%= check_box_tag "supplier_ingredient[preferred]", "1", @supplier_links.none?,
                id: "supplier_ingredient_preferred", class: "rounded border-gray-300" %>
          <%= label_tag "supplier_ingredient_preferred", t("inventory.ingredients.supplier_links.preferred"), class: "text-sm text-gray-700" %>
        </div>
        <div class="sm:col-span-3 sm:text-right">
          <%= submit_tag t("inventory.ingredients.supplier_links.add_supplier"), class: "w-full sm:w-auto bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
        </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <%= label_tag "supplier_ingredient[vendor_product_name]", t("inventory.ingredients.supplier_links.vendor_product_name"), class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= text_field_tag "supplier_ingredient[vendor_product_name]", nil,
                  placeholder: t("inventory.ingredients.supplier_links.vendor_product_name_placeholder"),
                  class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white" %>
          </div>
          <div>
            <%= label_tag "supplier_ingredient[vendor_sku]", t("inventory.ingredients.supplier_links.vendor_sku"), class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= text_field_tag "supplier_ingredient[vendor_sku]", nil,
                  placeholder: t("inventory.ingredients.supplier_links.vendor_sku_placeholder"),
                  class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white" %>
          </div>
        </div>
      <% end %>
    </div>
  <% elsif @supplier_links.any? %>
    <p class="mt-4 text-sm text-gray-500">
      <%= t("inventory.ingredients.supplier_links.all_linked_html",
            link: link_to(t("inventory.ingredients.supplier_links.create_another_supplier"), new_admin_inventory_supplier_path, class: "text-amber-600 hover:underline")).html_safe %>
    </p>
  <% else %>
    <p class="mt-4 text-sm text-gray-500">
      <%= t("inventory.ingredients.supplier_links.no_suppliers_html",
            link: link_to(t("inventory.ingredients.supplier_links.create_supplier"), new_admin_inventory_supplier_path, class: "text-amber-600 hover:underline")).html_safe %>
    </p>
  <% end %>
</div>
