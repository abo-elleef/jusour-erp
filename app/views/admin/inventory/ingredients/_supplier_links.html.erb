<div id="suppliers" class="bg-white rounded-lg shadow p-6">
  <div class="flex flex-wrap justify-between items-start gap-2 mb-1">
    <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide">Suppliers</h2>
    <span class="text-xs text-gray-500"><%= @supplier_links.size %> assigned</span>
  </div>
  <p class="text-sm text-gray-500 mb-5">Link vendors and set their price. One preferred supplier is used for PO suggestions.</p>

  <% if @supplier_links.any? %>
    <div class="hidden sm:grid grid-cols-12 gap-3 px-3 pb-2 text-xs font-medium text-gray-500 uppercase tracking-wide">
      <div class="col-span-4">Supplier</div>
      <div class="col-span-3">Price / unit</div>
      <div class="col-span-2 text-center">Preferred</div>
      <div class="col-span-3 text-right">Actions</div>
    </div>

    <div class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
      <% @supplier_links.each do |link| %>
        <%= form_with model: link,
              url: admin_inventory_ingredient_supplier_ingredient_path(@ingredient, link),
              method: :patch,
              class: "grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-3 items-center p-4 sm:px-3 bg-white hover:bg-gray-50/80" do |f| %>
          <div class="sm:col-span-4 flex items-center gap-2 min-w-0">
            <span class="sm:hidden text-xs font-medium text-gray-500 w-20 shrink-0">Supplier</span>
            <div class="min-w-0">
              <%= link_to link.supplier.name, admin_inventory_supplier_path(link.supplier),
                    class: "font-medium text-blue-600 hover:underline truncate block" %>
              <% if link.preferred? %>
                <span class="inline-block mt-0.5 text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded bg-amber-100 text-amber-800">Preferred</span>
              <% end %>
            </div>
          </div>

          <div class="sm:col-span-3 flex sm:block items-center gap-2">
            <span class="sm:hidden text-xs font-medium text-gray-500 w-20 shrink-0">Price</span>
            <div class="flex-1 sm:flex-none">
              <span class="sm:hidden text-xs text-gray-400">$</span>
              <%= f.number_field :price_dollars,
                    value: supplier_ingredient_price_dollars(link),
                    step: 0.01,
                    min: 0,
                    class: "w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm" %>
            </div>
          </div>

          <div class="sm:col-span-2 flex sm:justify-center items-center gap-2">
            <span class="sm:hidden text-xs font-medium text-gray-500 w-20 shrink-0">Preferred</span>
            <%= f.check_box :preferred, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
          </div>

          <div class="sm:col-span-3 flex sm:justify-end items-center gap-2">
            <%= f.submit "Save", class: "bg-gray-800 hover:bg-gray-900 text-white px-3 py-1.5 rounded-lg text-sm" %>
            <%= button_to "Remove",
                  admin_inventory_ingredient_supplier_ingredient_path(@ingredient, link),
                  method: :delete,
                  form: { data: { turbo_confirm: "Remove #{link.supplier.name}?" }, class: "inline" },
                  class: "text-red-600 hover:text-red-800 text-sm px-2 py-1.5" %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="border border-dashed border-gray-300 rounded-lg p-8 text-center text-gray-500 text-sm mb-5">
      No suppliers assigned yet. Add one below.
    </div>
  <% end %>

  <% if @available_suppliers.any? %>
    <div class="mt-6 pt-6 border-t border-gray-100">
      <h3 class="text-sm font-semibold text-gray-800 mb-3">Add supplier</h3>
      <%= form_with url: admin_inventory_ingredient_supplier_ingredients_path(@ingredient),
            class: "grid grid-cols-1 sm:grid-cols-12 gap-3 items-end bg-amber-50/50 border border-amber-200/60 rounded-lg p-4" do %>
        <div class="sm:col-span-4">
          <%= label_tag "supplier_ingredient[supplier_id]", "Supplier", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= select_tag "supplier_ingredient[supplier_id]",
                options_from_collection_for_select(@available_suppliers, :id, :name),
                include_blank: "Choose supplier…",
                required: true,
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white" %>
        </div>
        <div class="sm:col-span-3">
          <%= label_tag "supplier_ingredient[price_dollars]", "Price ($)", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= number_field_tag "supplier_ingredient[price_dollars]",
                ingredient_cost_dollars(@ingredient),
                step: 0.01,
                min: 0,
                placeholder: "0.00",
                class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white" %>
        </div>
        <div class="sm:col-span-2 flex items-center gap-2 sm:pb-2">
          <%= check_box_tag "supplier_ingredient[preferred]", "1", @supplier_links.none?,
                id: "supplier_ingredient_preferred", class: "rounded border-gray-300" %>
          <%= label_tag "supplier_ingredient_preferred", "Preferred", class: "text-sm text-gray-700" %>
        </div>
        <div class="sm:col-span-3 sm:text-right">
          <%= submit_tag "Add supplier", class: "w-full sm:w-auto bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
        </div>
      <% end %>
    </div>
  <% elsif @supplier_links.any? %>
    <p class="mt-4 text-sm text-gray-500">
      All active suppliers are linked.
      <%= link_to "Create another supplier", new_admin_inventory_supplier_path, class: "text-amber-600 hover:underline" %>.
    </p>
  <% else %>
    <p class="mt-4 text-sm text-gray-500">
      No active suppliers available.
      <%= link_to "Create a supplier", new_admin_inventory_supplier_path, class: "text-amber-600 hover:underline" %> first.
    </p>
  <% end %>
</div>
