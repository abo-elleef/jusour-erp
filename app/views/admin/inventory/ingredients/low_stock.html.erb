<div class="max-w-5xl">
  <div class="mb-4">
    <%= link_to t("inventory.ingredients.back_to_inventory"), admin_inventory_ingredients_path, class: "text-gray-600 hover:underline text-sm" %>
  </div>
  <h1 class="text-2xl font-bold mb-1"><%= admin_page_title("low_stock") %></h1>
  <p class="text-gray-600 text-sm mb-6"><%= t("inventory.ingredients.low_stock.description") %></p>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @ingredients.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 text-left"><%= t("inventory.ingredients.low_stock.table.ingredient") %></th>
            <th class="p-3 text-left"><%= t("inventory.ingredients.low_stock.table.on_hand") %></th>
            <th class="p-3 text-left"><%= t("inventory.ingredients.low_stock.table.reorder_at") %></th>
            <th class="p-3 text-right"><%= t("inventory.ingredients.low_stock.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% @ingredients.each do |ingredient| %>
            <tr class="bg-red-50/50">
              <td class="p-3 font-medium">
                <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient), class: "text-blue-600 hover:underline" %>
                <span class="text-xs text-gray-500 block"><%= ingredient.ingredient_category.name %></span>
              </td>
              <td class="p-3 font-medium text-red-700"><%= ingredient.quantity_on_hand %> <%= ingredient_unit_label(ingredient.unit) %></td>
              <td class="p-3 text-gray-600"><%= ingredient.reorder_threshold %> <%= ingredient_unit_label(ingredient.unit) %></td>
              <td class="p-3 text-right">
                <% if can_manage_inventory_stock? %>
                  <%= link_to t("inventory.ingredients.low_stock.adjust_stock"), admin_inventory_ingredient_path(ingredient, anchor: "adjust"),
                        class: "text-amber-600 hover:underline text-sm font-medium" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="p-8 text-center text-gray-500"><%= t("inventory.ingredients.low_stock.empty") %></p>
    <% end %>
  </div>
</div>
