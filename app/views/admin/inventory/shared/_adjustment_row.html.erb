<%# locals: adjustment, show_ingredient: false
    One row of the stock adjustment ledger. Shared by the per-ingredient ledger
    (no item column — the whole page is one item) and the cross-item movements
    report (item column). %>
<% show_ingredient = local_assigns.fetch(:show_ingredient, false) %>
<% ingredient = adjustment.ingredient %>
<% source_path = stock_adjustment_source_path(adjustment) %>
<tr class="hover:bg-gray-100 transition-colors border-b border-gray-100">
  <td class="p-3 ps-5 whitespace-nowrap tabular-nums text-xs">
    <% if source_path %>
      <%= link_to l(adjustment.created_at, format: :short), source_path,
            class: "text-amber-700 hover:text-amber-900 hover:underline font-medium" %>
    <% else %>
      <span class="text-gray-600"><%= l(adjustment.created_at, format: :short) %></span>
    <% end %>
  </td>
  <% if show_ingredient %>
    <td class="p-3">
      <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
            class: "font-medium text-amber-700 hover:text-amber-900 hover:underline" %>
      <% if ingredient.code.present? %>
        <span class="block text-xs text-gray-400 tabular-nums"><%= ingredient.code %></span>
      <% end %>
    </td>
  <% end %>
  <td class="p-3 text-gray-700">
    <%= adjustment.location&.name || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
  </td>
  <td class="p-3 text-gray-900"><%= inventory_adjustment_type_label(adjustment.adjustment_type) %></td>
  <td class="p-3 text-end tabular-nums font-semibold <%= adjustment.quantity_delta.positive? ? "text-green-700" : "text-red-700" %>">
    <%= stock_adjustment_quantity(adjustment) %>
  </td>
  <td class="p-3 text-end tabular-nums text-gray-700">
    <% if adjustment.balance_after %>
      <%= number_with_precision(adjustment.balance_after, precision: 3, strip_insignificant_zeros: true) %>
      <span class="text-xs text-gray-400 ms-0.5"><%= ingredient_unit_label(ingredient.unit) %></span>
    <% else %>
      <%= tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
    <% end %>
  </td>
  <td class="p-3 whitespace-nowrap">
    <% if adjustment.user %>
      <%= link_to adjustment.user.name, admin_user_path(adjustment.user),
            class: "text-gray-700 hover:text-gray-900 hover:underline" %>
    <% else %>
      <%= tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
    <% end %>
  </td>
  <td class="p-3 text-gray-600">
    <%= adjustment.reason_notes.presence || tag.span(t("accounting.shared.em_dash"), class: "text-gray-400") %>
  </td>
</tr>
