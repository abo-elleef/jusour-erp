<%# Statement of account body, shared by the Statement tab (inside the tab
    frame) and the printable statement page.
    Locals: statement, form_url, hidden_params (extra query to keep on apply). %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% cell = "p-3 whitespace-nowrap" %>

<div class="print-hide rounded-2xl border border-gray-200 bg-white px-5 py-4 mb-6">
  <%= form_with url: form_url, method: :get, class: "flex flex-wrap items-end gap-4" do %>
    <% hidden_params.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <div class="min-w-[10rem]">
      <%= label_tag :start_date, t("accounting.shared.start"), class: label_class %>
      <%= date_field_tag :start_date, statement.start_date, class: input_class %>
    </div>
    <div class="min-w-[10rem]">
      <%= label_tag :end_date, t("accounting.shared.end"), class: label_class %>
      <%= date_field_tag :end_date, statement.end_date, class: input_class %>
    </div>
    <%= submit_tag t("actions.apply_range"),
          class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors cursor-pointer" %>
  <% end %>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="rounded-2xl border border-gray-200 bg-white p-4">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.statement.opening_balance") %></p>
    <p class="text-xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_amount(statement.opening_balance_cents) %></p>
    <p class="text-xs text-gray-500 mt-1"><%= t("inventory.suppliers.statement.as_of", date: l(statement.start_date, format: :long)) %></p>
  </div>
  <div class="rounded-2xl border border-gray-200 bg-white p-4">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.statement.increases") %></p>
    <p class="text-xl font-bold mt-1 text-amber-700 tabular-nums"><%= format_amount(statement.total_increase_cents) %></p>
    <p class="text-xs text-gray-500 mt-1"><%= t("inventory.suppliers.statement.increases_hint") %></p>
  </div>
  <div class="rounded-2xl border border-gray-200 bg-white p-4">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.statement.decreases") %></p>
    <p class="text-xl font-bold mt-1 text-green-700 tabular-nums"><%= format_amount(statement.total_decrease_cents) %></p>
    <p class="text-xs text-gray-500 mt-1"><%= t("inventory.suppliers.statement.decreases_hint") %></p>
  </div>
  <div class="rounded-2xl border border-gray-200 bg-white p-4">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.statement.closing_balance") %></p>
    <p class="text-xl font-bold mt-1 tabular-nums <%= statement.closing_balance_cents.positive? ? 'text-amber-700' : 'text-gray-900' %>"><%= format_amount(statement.closing_balance_cents) %></p>
    <p class="text-xs text-gray-500 mt-1"><%= t("inventory.suppliers.statement.as_of", date: l(statement.end_date, format: :long)) %></p>
  </div>
</div>

<%# Deliberately unsorted and unpaginated: a statement reads in date order with
    a running balance, and it has to print whole. The date range is the filter. %>
<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="<%= cell %> pl-5"><%= t("inventory.suppliers.statement.date") %></th>
          <th class="<%= cell %>"><%= t("inventory.suppliers.statement.type") %></th>
          <th class="<%= cell %>"><%= t("inventory.suppliers.statement.reference") %></th>
          <th class="p-3"><%= t("inventory.suppliers.statement.description") %></th>
          <th class="<%= cell %> text-right"><%= t("inventory.suppliers.statement.increase") %></th>
          <th class="<%= cell %> text-right"><%= t("inventory.suppliers.statement.decrease") %></th>
          <th class="<%= cell %> pr-5 text-right"><%= t("inventory.suppliers.statement.balance") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 table-zebra">
        <tr class="bg-gray-50 font-semibold">
          <td class="<%= cell %> pl-5 text-gray-600 tabular-nums"><%= l(statement.start_date) %></td>
          <td class="p-3 text-gray-900" colspan="5"><%= t("inventory.suppliers.statement.opening_balance") %></td>
          <td class="<%= cell %> pr-5 text-right tabular-nums text-gray-900"><%= format_amount(statement.opening_balance_cents) %></td>
        </tr>
        <% statement.rows.each do |row| %>
          <% reference = supplier_statement_reference(row.source) %>
          <tr class="hover:bg-gray-100 transition-colors">
            <td class="<%= cell %> pl-5 text-gray-600 tabular-nums"><%= l(row.occurred_on) %></td>
            <td class="<%= cell %> text-gray-700"><%= supplier_statement_kind_label(row.kind) %></td>
            <td class="<%= cell %>">
              <% if reference %>
                <%= link_to reference.first, reference.last, data: { turbo_frame: "_top" },
                      class: "font-semibold text-amber-700 hover:text-amber-800" %>
              <% else %>
                <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
              <% end %>
            </td>
            <td class="p-3 text-gray-900"><%= row.description %></td>
            <td class="<%= cell %> text-right tabular-nums text-amber-700"><%= format_amount(row.increase_cents) if row.increase_cents.positive? %></td>
            <td class="<%= cell %> text-right tabular-nums text-green-700"><%= format_amount(row.decrease_cents) if row.decrease_cents.positive? %></td>
            <td class="<%= cell %> pr-5 text-right tabular-nums text-gray-900"><%= format_amount(row.balance_cents) %></td>
          </tr>
        <% end %>
        <% if statement.rows.empty? %>
          <tr>
            <td class="p-5 text-center text-gray-500" colspan="7"><%= t("inventory.suppliers.statement.empty") %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-gray-200 font-semibold">
        <tr>
          <td class="<%= cell %> pl-5 text-gray-600 tabular-nums"><%= l(statement.end_date) %></td>
          <td class="p-3 text-gray-900" colspan="3"><%= t("inventory.suppliers.statement.closing_balance") %></td>
          <td class="<%= cell %> text-right tabular-nums text-amber-700"><%= format_amount(statement.total_increase_cents) %></td>
          <td class="<%= cell %> text-right tabular-nums text-green-700"><%= format_amount(statement.total_decrease_cents) %></td>
          <td class="<%= cell %> pr-5 text-right tabular-nums text-gray-900"><%= format_amount(statement.closing_balance_cents) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>
