<%# locals: supplier %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: supplier,
      url: supplier.persisted? ? admin_inventory_supplier_path(supplier) : admin_inventory_suppliers_path,
      class: "space-y-6 max-w-lg" do |f| %>
  <% if supplier.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= supplier.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900">Supplier details</h2>
      <p class="text-xs text-gray-500 mt-0.5">Company name and primary contact</p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, class: label_class %>
        <%= f.text_field :name, class: input_class, autofocus: true %>
      </div>

      <div>
        <%= f.label :contact_name, "Contact name", class: label_class %>
        <%= f.text_field :contact_name, class: input_class %>
        <p class="text-xs text-gray-500 mt-1.5">Primary person at this vendor (optional).</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :email, class: label_class %>
          <%= f.email_field :email, autocomplete: "email", class: input_class %>
        </div>
        <div>
          <%= f.label :phone, class: label_class %>
          <%= f.telephone_field :phone, autocomplete: "tel", class: input_class %>
        </div>
      </div>

      <div>
        <%= f.label :address, class: label_class %>
        <%= f.text_area :address, rows: 2, class: "#{input_class} resize-y min-h-[4rem]" %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900">Purchasing</h2>
      <p class="text-xs text-gray-500 mt-0.5">Lead time and visibility on new POs</p>
    </div>
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :lead_time_days, "Lead time (days)", class: label_class %>
        <%= f.number_field :lead_time_days, min: 0, class: input_class %>
        <p class="text-xs text-gray-500 mt-1.5">Typical days from placing a PO to receiving delivery.</p>
      </div>

      <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <%= f.check_box :active, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900">Active for purchase orders</span>
            <span class="block text-xs text-gray-500 mt-0.5">Inactive suppliers are hidden from new POs</span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit supplier.persisted? ? "Save changes" : "Create supplier",
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm transition-colors" %>
    <%= link_to "Cancel",
          supplier.persisted? ? admin_inventory_supplier_path(supplier) : admin_inventory_suppliers_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
