<% content_for :title, @supplier.name %>
<% secondary_button = "inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl border border-gray-200 transition-colors" %>
<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @supplier.name %></h1>
      <% contact_parts = [@supplier.contact_name, @supplier.email, @supplier.phone].compact_blank %>
      <% if contact_parts.any? %>
        <p class="text-gray-600 text-sm mt-1"><%= contact_parts.join(" · ") %></p>
      <% end %>
      <% if @supplier.address.present? %>
        <p class="text-gray-500 text-sm mt-1"><%= @supplier.address %></p>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <% if @supplier.active? %>
        <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
          <%= t("inventory.suppliers.index.status_active") %>
        </span>
      <% else %>
        <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
          <%= t("inventory.suppliers.index.status_inactive") %>
        </span>
      <% end %>
      <% if can_manage_inventory_settings? %>
        <%= link_to t("actions.edit"), edit_admin_inventory_supplier_path(@supplier), class: secondary_button %>
      <% end %>
      <% if @supplier.active? %>
        <%= link_to t("inventory.suppliers.show.new_invoice"), new_admin_inventory_vendor_invoice_path(supplier_id: @supplier.id),
              class: "inline-flex text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl transition-colors" %>
      <% end %>
      <% if @supplier.deletable? && InventoryPolicy.new(current_user, @supplier).manage_settings? %>
        <%= button_to t("inventory.suppliers.show.delete"), admin_inventory_supplier_path(@supplier),
              method: :delete,
              form: { data: { turbo_confirm: t("inventory.suppliers.show.delete_confirm", name: @supplier.name) }, class: "inline-flex" },
              class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2 rounded-xl border border-red-200 transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.lead_time") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @supplier.lead_time_days %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.days") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.ingredients") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @ingredient_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.linked_products") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.vendor_invoices") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @invoice_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.posted_invoices") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.ap_balance") %></p>
      <p class="text-2xl font-bold mt-1 <%= @supplier.ap_balance_cents.positive? ? 'text-amber-700' : 'text-gray-900' %> tabular-nums">
        <%= format_amount(@supplier.ap_balance_cents) %>
      </p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.ap_balance_hint") %></p>
    </div>
  </div>

  <%# The active tab loads lazily into this frame from the same URL — see
      SuppliersController#show. Until it arrives, the placeholder holds the
      space so the page doesn't jump. %>
  <%= turbo_frame_tag Admin::Inventory::SuppliersController::TAB_FRAME,
        src: admin_inventory_supplier_path(@supplier, request.query_parameters),
        data: { turbo_action: "advance" } do %>
    <%= render "tab_nav", supplier: @supplier, active_tab: @tab %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-12 mt-6 text-center text-sm text-gray-500 animate-pulse">
      <%= t("inventory.suppliers.show.tabs.loading") %>
    </div>
  <% end %>
</div>
