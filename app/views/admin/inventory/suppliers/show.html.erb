<% content_for :title, @supplier.name %>
<%= render "admin/inventory/tools_nav" %>
<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @supplier.name %></h1>
      <% contact_parts = [@supplier.contact_name, @supplier.email, @supplier.phone].compact_blank %>
      <% if contact_parts.any? %>
        <p class="text-gray-600 text-sm mt-1"><%= contact_parts.join(" · ") %></p>
      <% end %>
      <% if @supplier.address.present? %>
        <p class="text-gray-500 text-sm mt-1"><%= @supplier.address %></p>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <% if @supplier.active? %>
        <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
          <%= t("inventory.suppliers.index.status_active") %>
        </span>
      <% else %>
        <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
          <%= t("inventory.suppliers.index.status_inactive") %>
        </span>
      <% end %>
      <%= link_to t("actions.edit"), edit_admin_inventory_supplier_path(@supplier),
            class: "inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl border border-gray-200 transition-colors" %>
      <% if @supplier.active? %>
        <%= link_to t("inventory.suppliers.show.purchase_request"),
              purchase_request_admin_inventory_supplier_path(@supplier, location_id: @stock_location&.id),
              class: "inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl border border-gray-200 transition-colors" %>
        <%= link_to t("inventory.suppliers.show.new_invoice"), new_admin_inventory_vendor_invoice_path(supplier_id: @supplier.id),
              class: "inline-flex text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl transition-colors" %>
      <% end %>
      <% if @supplier.deletable? && InventoryPolicy.new(current_user, @supplier).destroy? %>
        <%= button_to t("inventory.suppliers.show.delete"), admin_inventory_supplier_path(@supplier),
              method: :delete,
              form: { data: { turbo_confirm: t("inventory.suppliers.show.delete_confirm", name: @supplier.name) }, class: "inline-flex" },
              class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2 rounded-xl border border-red-200 transition-colors" %>
      <% end %>
    </div>
  </div>

  

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.lead_time") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @supplier.lead_time_days %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.days") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.ingredients") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @supplier_ingredients.size %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.linked_products") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.vendor_invoices") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @vendor_invoices.size %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.recent_invoices") %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.show.stats.ap_balance") %></p>
      <p class="text-2xl font-bold mt-1 <%= @supplier.ap_balance_cents.positive? ? 'text-amber-700' : 'text-gray-900' %> tabular-nums">
        <%= format_money(@supplier.ap_balance_cents) %>
      </p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.show.stats.ap_balance_hint") %></p>
    </div>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-end gap-3">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.show.ingredients_heading") %></h2>
        <p class="text-xs text-gray-500 mt-0.5">
          <% if @stock_location %>
            <%= t("inventory.suppliers.show.ingredients_hint_location", location: @stock_location.name) %>
          <% else %>
            <%= t("inventory.suppliers.show.ingredients_hint") %>
          <% end %>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <% if @reorder_count.positive? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-red-100 text-red-800 text-xs font-semibold">
            <%= t("inventory.suppliers.show.reorder_count", count: @reorder_count) %>
          </span>
        <% end %>
        <% if @filter_locations.any? %>
          <%= form_with url: admin_inventory_supplier_path(@supplier), method: :get, class: "flex items-center gap-2" do %>
            <%= hidden_field_tag :sort, @sort if @sort.present? %>
            <%= hidden_field_tag :dir, @direction if @sort.present? %>
            <label for="location_id" class="text-xs font-semibold text-gray-600 whitespace-nowrap"><%= t("inventory.suppliers.show.balance_location") %></label>
            <%= select_tag :location_id,
                  options_for_select(
                    [[t("inventory.suppliers.show.all_locations"), ""]] + @filter_locations.map { |l| [l.name, l.id] },
                    @stock_location&.id
                  ),
                  class: "#{pos_input_class} appearance-none min-w-[10rem] py-1.5 text-sm",
                  id: "location_id",
                  onchange: "this.form.requestSubmit()" %>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if @supplier_ingredients.any? %>
      <div class="overflow-auto max-h-[60vh] relative">
        <table class="w-full text-left text-sm">
          <thead class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <% sort_opts = { sort: @sort, direction: @direction } %>
            <tr>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 pl-5 w-12 text-gray-400 border-b border-gray-200"><%= t("shared.row_index") %></th>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 border-b border-gray-200"><%= sort_header_link(t("inventory.suppliers.show.ingredient"), :ingredient, **sort_opts) %></th>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-right border-b border-gray-200">
                <span class="inline-flex justify-end w-full"><%= sort_header_link(t("inventory.suppliers.show.balance"), :balance, **sort_opts) %></span>
              </th>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-right border-b border-gray-200">
                <span class="inline-flex justify-end w-full"><%= sort_header_link(t("inventory.suppliers.show.reorder_at"), :reorder_at, **sort_opts) %></span>
              </th>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-right border-b border-gray-200">
                <span class="inline-flex justify-end w-full"><%= sort_header_link(t("inventory.suppliers.show.max_quantity"), :max_quantity, **sort_opts) %></span>
              </th>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 border-b border-gray-200"><%= sort_header_link(t("inventory.suppliers.show.vendor_product"), :vendor_product, **sort_opts) %></th>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 text-right border-b border-gray-200">
                <span class="inline-flex justify-end w-full"><%= sort_header_link(t("inventory.suppliers.show.unit_price"), :unit_price, **sort_opts) %></span>
              </th>
              <th class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm p-3 pr-5 border-b border-gray-200"><%= sort_header_link(t("inventory.suppliers.show.preferred"), :preferred, **sort_opts) %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @supplier_ingredients.each_with_index do |link, index| %>
              <% ing = link.ingredient %>
              <% balance = @ingredient_balances[ing.id] %>
              <% status = balance[:status] %>
              <% urgent = %i[out low].include?(status) %>
              <tr class="<%= ingredient_stock_row_class(status) %> hover:bg-gray-100 transition-colors">
                <td class="p-3 pl-5 text-gray-400 tabular-nums"><%= table_row_number(index) %></td>
                <td class="p-3">
                  <%= link_to ing.name, admin_inventory_ingredient_path(ing),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                  <% if status == :out %>
                    <span class="ms-2 text-[11px] font-semibold px-2 py-0.5 rounded-full bg-red-100 text-red-800"><%= t("inventory.ingredients.index.stats.out_of_stock") %></span>
                  <% elsif status == :low %>
                    <span class="ms-2 text-[11px] font-semibold px-2 py-0.5 rounded-full bg-red-100 text-red-800"><%= t("inventory.ingredients.index.stats.low_stock") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-right tabular-nums whitespace-nowrap <%= urgent ? 'text-red-700 font-bold' : 'text-gray-900 font-semibold' %>">
                  <%= number_with_precision(balance[:quantity], precision: 2, strip_insignificant_zeros: true) %>
                  <span class="text-xs font-normal text-gray-500"><%= ingredient_unit_label(ing.unit) %></span>
                </td>
                <td class="p-3 text-right tabular-nums text-gray-500 whitespace-nowrap">
                  <%= number_with_precision(balance[:reorder_at], precision: 2, strip_insignificant_zeros: true) %>
                </td>
                <td class="p-3 text-right tabular-nums text-gray-500 whitespace-nowrap">
                  <%= number_with_precision(balance[:max_quantity], precision: 2, strip_insignificant_zeros: true) %>
                </td>
                <td class="p-3 text-gray-700">
                  <% vendor_alias = [link.vendor_product_name, link.vendor_sku].compact_blank.join(" · ") %>
                  <% if vendor_alias.present? %>
                    <%= vendor_alias %>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-right font-semibold text-gray-900 tabular-nums">
                  <%= format_money(link.price_cents) %>
                </td>
                <td class="p-3 pr-5">
                  <% if link.preferred? %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-200">
                      <%= t("inventory.suppliers.show.preferred") %>
                    </span>
                  <% else %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="p-5 text-sm text-gray-500"><%= t("inventory.suppliers.show.ingredients_empty") %></p>
    <% end %>
  </section>

  <% if @vendor_invoices.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-2">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.show.vendor_invoices_heading") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.suppliers.show.vendor_invoices_hint") %></p>
        </div>
        <%= link_to t("inventory.suppliers.show.all_invoices"), admin_inventory_vendor_invoices_path(q: { supplier_id_eq: @supplier.id }),
              class: "text-sm font-medium text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl transition-colors" %>
      </div>
      <ul class="divide-y divide-gray-100">
        <% @vendor_invoices.each do |invoice| %>
          <% status_label, status_class = vendor_invoice_payment_badge(invoice.payment_status) %>
          <li class="px-5 py-3 flex flex-wrap justify-between items-center gap-2 hover:bg-gray-100 transition-colors">
            <%= link_to invoice.invoice_number, admin_inventory_vendor_invoice_path(invoice),
                  class: "font-semibold text-amber-700 hover:text-amber-800" %>
            <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= status_class %>">
              <%= status_label %>
            </span>
            <span class="text-sm text-gray-600 tabular-nums"><%= format_money(invoice.total_cents) %></span>
            <span class="text-xs text-gray-500"><%= l(invoice.invoice_date.to_date, format: :long) %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @supplier.ap_balance_cents > 0 && InventoryPolicy.new(current_user, @supplier).update? %>
    <section class="rounded-2xl border border-amber-200 bg-amber-50/40 overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-amber-100">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.show.direct_ap_payment.title") %></h2>
        <p class="text-xs text-gray-600 mt-0.5"><%= t("inventory.suppliers.show.direct_ap_payment.hint") %></p>
      </div>
      <%= form_with url: direct_ap_payment_admin_inventory_supplier_path(@supplier), method: :post,
            class: "px-5 py-4 grid sm:grid-cols-4 gap-4 items-start" do %>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.amount") %></label>
          <%= number_field_tag :amount_pounds, nil, step: "0.01", min: "0.01",
                max: (@supplier.ap_balance_cents / 100.0).round(2),
                placeholder: format("%g", @supplier.ap_balance_cents / 100.0),
                class: pos_input_class, required: true %>
          <p class="text-xs text-gray-500 mt-1">
            <%= t("inventory.suppliers.show.direct_ap_payment.balance_hint", balance: format_money(@supplier.ap_balance_cents)) %>
          </p>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.treasury") %></label>
          <% payable_treasuries = Treasury.active.payable.visible_to(current_user).ordered %>
          <%= select_tag :treasury_id,
                options_from_collection_for_select(payable_treasuries, :id, :name, Treasury.default_treasury&.id),
                class: pos_input_class, required: true %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.day") %></label>
          <%= date_field_tag :payment_date, Date.current, class: pos_input_class %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("accounting.shared.description") %></label>
          <%= text_field_tag :description, t("inventory.suppliers.show.direct_ap_payment.default_description", supplier: @supplier.name),
                class: pos_input_class %>
        </div>
        <div class="sm:col-span-4">
          <%= submit_tag t("inventory.suppliers.show.direct_ap_payment.submit"),
                class: "bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-xl text-sm font-semibold",
                data: { turbo_confirm: t("inventory.suppliers.show.direct_ap_payment.confirm",
                          supplier: @supplier.name,
                          balance: format_money(@supplier.ap_balance_cents)) } %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @ap_transactions.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.show.ap_ledger_heading") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.suppliers.show.ap_ledger_hint") %></p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 pl-5"><%= t("inventory.suppliers.show.ap_date") %></th>
              <th class="p-3"><%= t("inventory.suppliers.show.ap_description") %></th>
              <th class="p-3 text-right"><%= t("inventory.suppliers.show.ap_amount") %></th>
              <th class="p-3 pr-5 text-right"><%= t("inventory.suppliers.show.ap_running_balance") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @ap_transactions.each do |txn| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 pl-5 text-gray-600 tabular-nums whitespace-nowrap"><%= l(txn.occurred_on) %></td>
                <td class="p-3 text-gray-900">
                  <div class="flex items-center gap-2">
                    <% if txn.kind == "ap_invoice" %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-200 shrink-0">
                        <%= t("inventory.suppliers.show.ap_invoice_badge") %>
                      </span>
                    <% else %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200 shrink-0">
                        <%= t("inventory.suppliers.show.ap_payment_badge") %>
                      </span>
                    <% end %>
                    <span><%= txn.description %></span>
                  </div>
                </td>
                <td class="p-3 text-right tabular-nums font-semibold <%= txn.amount_cents.positive? ? 'text-amber-700' : 'text-green-700' %>">
                  <%= txn.amount_cents.positive? ? "+#{format_money(txn.amount_cents)}" : format_money(txn.amount_cents) %>
                </td>
                <td class="p-3 pr-5 text-right tabular-nums text-gray-700"><%= format_money(txn.balance_after_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.show.price_history_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.suppliers.show.price_history_hint") %></p>
    </div>
    <% if @price_histories.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 pl-5"><%= t("inventory.suppliers.show.ingredient") %></th>
              <th class="p-3 text-right"><%= t("inventory.suppliers.show.price") %></th>
              <th class="p-3 pr-5"><%= t("inventory.suppliers.show.effective") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @price_histories.each do |h| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 pl-5 text-gray-900"><%= h.ingredient.name %></td>
                <td class="p-3 text-right font-semibold tabular-nums"><%= format_money(h.price_cents) %></td>
                <td class="p-3 pr-5 text-gray-600 tabular-nums"><%= l(h.effective_date) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="p-5 text-sm text-gray-500"><%= t("inventory.suppliers.show.price_history_empty") %></p>
    <% end %>
  </section>
</div>
