<% content_for :title, admin_page_title %>
<% input_class = "w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition-shadow" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<%= render "admin/inventory/tools_nav" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.suppliers.index.description") %></p>
    </div>
    <% if can_manage_inventory_settings? %>
      <%= link_to new_admin_inventory_supplier_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
        <span aria-hidden="true">+</span> <%= t("inventory.suppliers.index.new_button") %>
      <% end %>
    <% end %>
  </div>

  <% search_q = params[:q]&.to_unsafe_h %>
  <% date_params = { start_date: params[:start_date], end_date: params[:end_date] }.compact_blank %>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
    <%= link_to admin_inventory_suppliers_path(status: "all", q: search_q),
          class: orders_stat_card_class(@status == "all") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.index.stats.total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @total_count %></p>
    <% end %>

    <%= link_to admin_inventory_suppliers_path(status: "active", q: search_q),
          class: orders_stat_card_class(@status == "active") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.index.stats.active") %></p>
      <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= @active_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.index.stats.active_hint") %></p>
    <% end %>

    <% if @inactive_count.positive? %>
      <%= link_to admin_inventory_suppliers_path(status: "inactive", q: search_q),
            class: orders_stat_card_class(@status == "inactive") do %>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.suppliers.index.stats.inactive") %></p>
        <p class="text-2xl font-bold mt-1 text-gray-600 tabular-nums"><%= @inactive_count %></p>
        <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.suppliers.index.stats.inactive_hint") %></p>
      <% end %>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2 text-sm mb-6">
    <span class="text-gray-500 me-1"><%= t("inventory.suppliers.index.status_filter") %>:</span>
    <% [["active", "status_active"], ["inactive", "status_inactive"], ["all", "status_all"]].each do |val, key| %>
      <%= link_to t("inventory.suppliers.index.#{key}"),
            admin_inventory_suppliers_path(status: val, q: search_q, sort: @sort, dir: @direction),
            class: "px-3 py-1.5 rounded-lg font-medium border transition-colors #{@status == val ? 'bg-gray-900 text-white border-gray-900' : 'text-gray-700 border-gray-200 hover:bg-gray-100'}" %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.index.search_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.suppliers.index.search_hint") %></p>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_inventory_suppliers_path, method: :get, class: "flex flex-wrap items-end gap-4" do |f| %>
        <%= hidden_field_tag :status, @status if @status != "active" %>
        <div class="flex-1 min-w-[12rem]">
          <%= f.label :name_cont, t("inventory.suppliers.index.name"), class: label_class %>
          <%= f.search_field :name_cont, placeholder: t("inventory.suppliers.index.name_placeholder"), class: input_class %>
        </div>
        <div>
          <%= label_tag :start_date, t("inventory.suppliers.index.from_date"), class: label_class %>
          <%= date_field_tag :start_date, params[:start_date], class: input_class %>
        </div>
        <div>
          <%= label_tag :end_date, t("inventory.suppliers.index.to_date"), class: label_class %>
          <%= date_field_tag :end_date, params[:end_date], class: input_class %>
        </div>
        <%= f.submit t("actions.apply_search"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
        <% if @filtered || @date_filtered %>
          <%= link_to t("actions.clear"), admin_inventory_suppliers_path,
                class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
        <span class="text-sm text-gray-500 ml-auto tabular-nums">
          <%= t("inventory.suppliers.index.showing", count: @suppliers.size) %>
        </span>
      <% end %>
    </div>
  </section>

  <% if @suppliers.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[52rem]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <% sort_opts = { sort: @sort, direction: @direction } %>
            <tr>
              <th class="p-3 pl-5 w-12 text-gray-400"><%= t("shared.row_index") %></th>
              <th class="p-3"><%= sort_header_link(t("inventory.suppliers.index.table.supplier"), :name, **sort_opts) %></th>
              <th class="p-3"><%= sort_header_link(t("inventory.suppliers.index.table.contact"), :contact, **sort_opts) %></th>
              <th class="p-3"><%= sort_header_link(t("inventory.suppliers.index.table.lead_time"), :lead_time, **sort_opts) %></th>
              <th class="p-3 text-right"><%= sort_header_link(t("inventory.suppliers.index.table.ingredients"), :ingredients, **sort_opts) %></th>
              <th class="p-3 text-right">
                <%= sort_header_link(t("inventory.suppliers.index.table.invoice_total"), :invoice_total, **sort_opts) %>
                <% if @date_filtered %>
                  <div class="text-xs font-normal text-amber-700 normal-case tracking-normal mt-0.5">
                    <% if @start_date && @end_date %>
                      <%= l(@start_date, format: :short) %> – <%= l(@end_date, format: :short) %>
                    <% elsif @start_date %>
                      <%= t("inventory.suppliers.index.from_date") %> <%= l(@start_date, format: :short) %>
                    <% else %>
                      <%= t("inventory.suppliers.index.to_date") %> <%= l(@end_date, format: :short) %>
                    <% end %>
                  </div>
                <% end %>
              </th>
              <th class="p-3 text-right"><%= sort_header_link(t("inventory.suppliers.index.table.outstanding"), :outstanding, **sort_opts) %></th>
              <th class="p-3"><%= sort_header_link(t("inventory.suppliers.index.table.status"), :status, **sort_opts) %></th>
              <th class="p-3 pr-5 text-right"><%= t("inventory.suppliers.index.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @suppliers.each_with_index do |s, index| %>
              <% invoice_total_cents = @invoice_total_cents_by_supplier[s.id] || 0 %>
              <% outstanding_cents = @outstanding_cents_by_supplier[s.id] || 0 %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 pl-5 text-gray-400 tabular-nums"><%= table_row_number(index) %></td>
                <td class="p-3">
                  <%= link_to s.name, admin_inventory_supplier_path(s),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                </td>
                <td class="p-3 text-gray-600">
                  <% if s.contact_name.present? %><div><%= s.contact_name %></div><% end %>
                  <% if s.email.present? %><div class="text-gray-500"><%= s.email %></div><% end %>
                  <% if s.contact_name.blank? && s.email.blank? && s.phone.present? %>
                    <div><%= s.phone %></div>
                  <% end %>
                  <% if s.contact_name.blank? && s.email.blank? && s.phone.blank? %>
                    <span class="text-gray-400"><%= t("accounting.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-gray-700 tabular-nums whitespace-nowrap">
                  <%= t("inventory.suppliers.lead_time_count", count: s.lead_time_days) %>
                </td>
                <td class="p-3 text-right text-gray-600 tabular-nums">
                  <%= s.supplier_ingredients.size %>
                </td>
                <td class="p-3 text-right text-gray-700 tabular-nums">
                  <%= format_money(invoice_total_cents) %>
                </td>
                <td class="p-3 text-right tabular-nums">
                  <% if outstanding_cents.positive? %>
                    <%= link_to format_money(outstanding_cents),
                          admin_inventory_supplier_path(s),
                          class: "font-semibold text-amber-700 hover:text-amber-800" %>
                  <% else %>
                    <span class="text-gray-400"><%= format_money(outstanding_cents) %></span>
                  <% end %>
                </td>
                <td class="p-3">
                  <% if s.active? %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200">
                      <%= t("inventory.suppliers.index.status_active") %>
                    </span>
                  <% else %>
                    <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                      <%= t("inventory.suppliers.index.status_inactive") %>
                    </span>
                  <% end %>
                </td>
                <td class="p-3 pr-5 text-right whitespace-nowrap">
                  <div class="inline-flex gap-2">
                    <%= link_to t("actions.view"), admin_inventory_supplier_path(s),
                          class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                    <% if can_manage_inventory_settings? %>
                      <%= link_to t("actions.edit"), edit_admin_inventory_supplier_path(s),
                            class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="border-t-2 border-gray-200 bg-gray-50/80">
              <td colspan="5" class="p-3 pl-5 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                <%= t("inventory.suppliers.index.table.total_row", count: @suppliers.size) %>
              </td>
              <td class="p-3 text-right tabular-nums font-bold text-gray-900">
                <%= format_money(@invoice_total_cents_by_supplier.values.sum) %>
              </td>
              <td class="p-3 text-right tabular-nums font-bold text-gray-900">
                <%= format_money(@outstanding_cents_by_supplier.values.sum) %>
              </td>
              <td colspan="2"></td>
            </tr>
            <% if @date_filtered && @hidden_suppliers_invoice_cents.to_i > 0 %>
              <tr class="border-t border-amber-200 bg-amber-50/60">
                <td colspan="5" class="p-3 pl-5 text-xs font-semibold text-amber-700">
                  <%= t("inventory.suppliers.index.table.hidden_suppliers_row") %>
                  <%= link_to t("inventory.suppliers.index.table.view_all"),
                        admin_inventory_suppliers_path(status: "all", start_date: @start_date, end_date: @end_date),
                        class: "ms-2 underline hover:text-amber-900" %>
                </td>
                <td class="p-3 text-right tabular-nums font-semibold text-amber-800">
                  <%= format_money(@hidden_suppliers_invoice_cents) %>
                </td>
                <td colspan="3"></td>
              </tr>
              <tr class="border-t-2 border-gray-400 bg-gray-100">
                <td colspan="5" class="p-3 pl-5 text-xs font-bold text-gray-700 uppercase tracking-wide">
                  <%= t("inventory.suppliers.index.table.grand_total_row") %>
                </td>
                <td class="p-3 text-right tabular-nums font-black text-gray-900">
                  <%= format_money(@invoice_total_cents_by_supplier.values.sum + @hidden_suppliers_invoice_cents) %>
                </td>
                <td colspan="3"></td>
              </tr>
            <% end %>
          </tfoot>
        </table>
      </div>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.suppliers.index.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5">
        <% if @filtered %>
          <%= t("inventory.suppliers.index.empty_description_filtered") %>
        <% else %>
          <%= t("inventory.suppliers.index.empty_description") %>
        <% end %>
      </p>
      <div class="flex flex-wrap justify-center gap-3 text-sm">
        <% if @filtered %>
          <%= link_to t("inventory.suppliers.index.clear_search"), admin_inventory_suppliers_path,
                class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
        <% if can_manage_inventory_settings? %>
          <%= link_to t("inventory.suppliers.index.new_button"), new_admin_inventory_supplier_path,
                class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
