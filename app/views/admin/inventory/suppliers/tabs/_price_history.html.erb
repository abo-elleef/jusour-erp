<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.show.price_history_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.suppliers.show.price_history_hint") %></p>
    </div>

    <% if @price_history_ingredients.any? %>
      <%# Searchable rather than a plain select: a busy supplier carries far too
          many ingredients to scroll. The hidden fields carry the current query
          (including tab=price_history) so the frame reloads this same tab. %>
      <%= form_with url: admin_inventory_supplier_path(@supplier), method: :get,
            class: "flex flex-wrap items-end gap-2", data: {
              searchable_select_options: ingredient_search_options(@price_history_ingredients)
            } do %>
        <% request.query_parameters.except("ph_ingredient_id", "page").each do |key, value| %>
          <%= hidden_field_tag key, value %>
        <% end %>
        <div class="min-w-[13rem]"
             data-controller="searchable-select"
             data-searchable-select-no-results="<%= t("shared.searchable_select.no_results") %>">
          <%= label_tag :ph_ingredient_id, t("inventory.suppliers.show.price_history_filter_ingredient"),
                class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
          <%= hidden_field_tag :ph_ingredient_id, @price_history_ingredient_id,
                data: { searchable_select_target: "hidden" } %>
          <input type="text"
                 autocomplete="off" spellcheck="false" role="combobox"
                 aria-expanded="false" aria-autocomplete="list"
                 placeholder="<%= t("inventory.suppliers.show.price_history_search_ingredient") %>"
                 class="<%= pos_input_class %>"
                 data-searchable-select-target="input"
                 data-action="input->searchable-select#filter focus->searchable-select#open keydown->searchable-select#keydown" />
          <ul data-searchable-select-target="menu" role="listbox"
              class="hidden overflow-auto rounded-xl border border-gray-200 bg-white shadow-lg py-1"></ul>
        </div>
        <%= submit_tag t("actions.apply"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors cursor-pointer" %>
        <% if @price_history_ingredient_id %>
          <%= link_to t("inventory.suppliers.show.price_history_clear_filter"),
                admin_inventory_supplier_path(@supplier, request.query_parameters.except("ph_ingredient_id", "page")),
                class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-3 py-2.5" %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @price_histories.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 pl-5"><%= t("inventory.suppliers.show.ingredient") %></th>
            <th class="p-3 text-right"><%= t("inventory.suppliers.show.price") %></th>
            <th class="p-3"><%= t("inventory.suppliers.show.effective") %></th>
            <th class="p-3"><%= t("inventory.suppliers.show.price_history_invoice") %></th>
            <th class="p-3 pr-5"><%= t("inventory.suppliers.show.price_history_recorded_by") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @price_histories.each do |h| %>
            <% invoice = h.vendor_invoice_line&.vendor_invoice %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 pl-5 text-gray-900"><%= h.ingredient.name %></td>
              <td class="p-3 text-right font-semibold tabular-nums"><%= format_amount(h.price_cents) %></td>
              <td class="p-3 text-gray-600 tabular-nums"><%= l(h.effective_date) %></td>
              <td class="p-3">
                <% if invoice %>
                  <%= link_to invoice.invoice_number, admin_inventory_vendor_invoice_path(invoice),
                        data: { turbo_frame: "_top" },
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="p-3 pr-5 text-gray-600">
                <%= h.recorded_by_user&.name || tag.span("—", class: "text-gray-400") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "admin/accounting/pagination", pagy: @price_history_pagy %>
  <% else %>
    <p class="p-5 text-sm text-gray-500">
      <%= t(@price_history_ingredient_id ? "inventory.suppliers.show.price_history_filtered_empty" : "inventory.suppliers.show.price_history_empty") %>
    </p>
  <% end %>
</section>
