<%= render "admin/inventory/suppliers/pay_supplier" %>

<section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-3">
    <div>
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.suppliers.show.invoices.heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.suppliers.show.invoices.hint") %></p>
    </div>
    <%= link_to t("inventory.suppliers.show.all_invoices"), admin_inventory_vendor_invoices_path(q: { supplier_id_eq: @supplier.id }),
          data: { turbo_frame: "_top" },
          class: "text-sm font-medium text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl transition-colors" %>
  </div>

  <%# Status filter. Sort is kept, page is dropped: page 3 of "all" is
      meaningless once the list narrows. %>
  <div class="px-5 py-3 border-b border-gray-100 flex flex-wrap gap-2">
    <% [nil, *Admin::Inventory::SuppliersController::INVOICE_STATUS_FILTERS].each do |status| %>
      <% active = @invoice_status == status %>
      <% query = request.query_parameters.except("status", "page").merge("tab" => "invoices") %>
      <% query["status"] = status if status %>
      <%= link_to admin_inventory_supplier_path(@supplier, query),
            class: "inline-flex items-center px-3 py-1.5 rounded-xl text-sm font-semibold border transition-colors #{active ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'}" do %>
        <%= t("inventory.suppliers.show.invoices.status_filter.#{status || 'all'}") %>
        <%= admin_tab_count(@invoice_status_counts[status], active: active) %>
      <% end %>
    <% end %>
  </div>

  <% if @invoices.any? %>
    <% sort_opts = { sort: @invoice_sort, direction: @invoice_direction } %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 bg-white text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 pl-5"><%= sort_header_link(t("inventory.suppliers.show.invoices.number"), :number, **sort_opts) %></th>
            <th class="p-3"><%= sort_header_link(t("inventory.suppliers.show.invoices.date"), :date, **sort_opts) %></th>
            <th class="p-3"><%= sort_header_link(t("inventory.suppliers.show.invoices.status"), :status, **sort_opts) %></th>
            <th class="p-3 text-right">
              <span class="inline-flex"><%= sort_header_link(t("inventory.suppliers.show.invoices.total"), :total, **sort_opts) %></span>
            </th>
            <th class="p-3 pr-5 text-right"><%= t("inventory.suppliers.show.invoices.balance_due") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% @invoices.each do |invoice| %>
            <% status_label, status_class = vendor_invoice_payment_badge(invoice.payment_status) %>
            <% due = invoice.payment_status == "void" ? 0 : invoice.balance_due_cents %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 pl-5">
                <%= link_to invoice.invoice_number, admin_inventory_vendor_invoice_path(invoice),
                      data: { turbo_frame: "_top" },
                      class: "font-semibold text-amber-700 hover:text-amber-800" %>
              </td>
              <td class="p-3 text-gray-600 tabular-nums whitespace-nowrap"><%= l(invoice.invoice_date.to_date, format: :long) %></td>
              <td class="p-3">
                <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= status_class %>"><%= status_label %></span>
              </td>
              <td class="p-3 text-right tabular-nums text-gray-900"><%= format_amount(invoice.total_cents) %></td>
              <td class="p-3 pr-5 text-right tabular-nums font-semibold <%= due.positive? ? 'text-amber-700' : 'text-gray-400' %>"><%= format_amount(due) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "admin/accounting/pagination", pagy: @invoice_pagy %>
  <% else %>
    <p class="p-5 text-sm text-gray-500"><%= t("inventory.suppliers.show.invoices.empty") %></p>
  <% end %>
</section>
