<div class="max-w-lg">
  <div class="mb-4">
    <%= link_to "← #{@supplier.name}", admin_inventory_supplier_path(@supplier), class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">Edit <%= @supplier.name %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= pluralize(@supplier.supplier_ingredients.count, "ingredient") %> · <%= pluralize(@supplier.lead_time_days, "day") %> lead time
      </p>
    </div>
    <% if @supplier.active? %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
        Active
      </span>
    <% else %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
        Inactive
      </span>
    <% end %>
  </div>

  <%= render "admin/inventory/tools_nav" %>
  <%= render "form", supplier: @supplier %>
</div>
