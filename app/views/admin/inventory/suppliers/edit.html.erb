<div class="max-w-lg">
  <div class="mb-4">
    <%= link_to t("inventory.suppliers.back_to_supplier", name: @supplier.name), admin_inventory_supplier_path(@supplier), class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("inventory.suppliers.edit.title", name: @supplier.name) %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("inventory.suppliers.edit.subtitle",
              ingredients: t("inventory.suppliers.ingredients_count", count: @supplier.supplier_ingredients.count),
              lead_time: t("inventory.suppliers.lead_time_count", count: @supplier.lead_time_days)) %>
      </p>
    </div>
    <% if @supplier.active? %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
        <%= t("inventory.suppliers.index.status_active") %>
      </span>
    <% else %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
        <%= t("inventory.suppliers.index.status_inactive") %>
      </span>
    <% end %>
  </div>

  <%= render "form", supplier: @supplier %>
</div>
