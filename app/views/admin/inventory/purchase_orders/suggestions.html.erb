<% table_head = "border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide" %>

<%= render "admin/inventory/tools_nav" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title("suggestions") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.purchase_orders.suggestions.description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to admin_inventory_purchase_orders_path,
            class: "inline-flex items-center text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <%= t("inventory.purchase_orders.suggestions.back_to_list") %>
      <% end %>
      <%= link_to new_admin_inventory_purchase_order_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" do %>
        <span aria-hidden="true">+</span> <%= t("inventory.purchase_orders.suggestions.new_manual") %>
      <% end %>
    </div>
  </div>

  <% if @grouped.blank? && @skipped_low_stock.empty? %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.purchase_orders.suggestions.empty.title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("inventory.purchase_orders.suggestions.empty.description") %></p>
      <%= link_to t("inventory.purchase_orders.suggestions.empty.view_inventory"), admin_inventory_ingredients_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% else %>
    <% if @grouped.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
        <div class="<%= orders_stat_card_class(false) %>">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.suggestions.stats.suppliers") %></p>
          <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @grouped.size %></p>
        </div>
        <div class="<%= orders_stat_card_class(false) %>">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.suggestions.stats.line_items") %></p>
          <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @line_count %></p>
        </div>
        <div class="<%= orders_stat_card_class(false) %> col-span-2 sm:col-span-1">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.suggestions.stats.estimated_total") %></p>
          <p class="text-2xl font-bold mt-1 text-amber-800 tabular-nums"><%= format_money(@estimated_total_cents) %></p>
        </div>
      </div>

      <div class="space-y-6 mb-8">
        <% @grouped.each do |supplier, lines| %>
          <% supplier_total = lines.sum { |line| (line[:suggested_quantity].to_d * line[:unit_price_cents]).round } %>
          <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80 flex flex-wrap justify-between items-center gap-3">
              <div>
                <h2 class="text-sm font-semibold text-gray-900">
                  <%= link_to supplier.name, admin_inventory_supplier_path(supplier),
                        class: "text-amber-700 hover:text-amber-800" %>
                </h2>
                <p class="text-xs text-gray-500 mt-0.5">
                  <%= t("inventory.purchase_orders.suggestions.supplier_summary",
                        items: t("inventory.purchase_orders.suggestions.items_count", count: lines.size),
                        lead_time: t("inventory.suppliers.lead_time_count", count: supplier.lead_time_days),
                        total: format_money(supplier_total)) %>
                </p>
              </div>
              <%= link_to t("inventory.purchase_orders.suggestions.create_po"),
                    new_admin_inventory_purchase_order_path(supplier_id: supplier.id, from: "suggestions"),
                    class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" %>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[36rem]">
                <thead class="<%= table_head %>">
                  <tr>
                    <th class="p-3 ps-5 text-start"><%= t("inventory.purchase_orders.suggestions.table.ingredient") %></th>
                    <th class="p-3 text-end"><%= t("inventory.purchase_orders.suggestions.table.on_hand") %></th>
                    <th class="p-3 text-end"><%= t("inventory.purchase_orders.suggestions.table.suggest_qty") %></th>
                    <th class="p-3 text-end"><%= t("inventory.purchase_orders.suggestions.table.unit_price") %></th>
                    <th class="p-3 pe-5 text-end"><%= t("inventory.purchase_orders.suggestions.table.line_total") %></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% lines.each do |line| %>
                    <% ingredient = line[:ingredient] %>
                    <% line_total = (line[:suggested_quantity].to_d * line[:unit_price_cents]).round %>
                    <tr class="hover:bg-gray-50/60 transition-colors">
                      <td class="p-3 ps-5">
                        <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                              class: "font-semibold text-amber-700 hover:text-amber-800" %>
                        <span class="text-xs text-gray-500 block mt-0.5"><%= ingredient.ingredient_category.name %></span>
                      </td>
                      <td class="p-3 text-end tabular-nums text-red-700 font-semibold whitespace-nowrap">
                        <%= ingredient.quantity_on_hand %> <%= ingredient_unit_label(ingredient.unit) %>
                      </td>
                      <td class="p-3 text-end tabular-nums whitespace-nowrap">
                        <%= line[:suggested_quantity] %> <%= ingredient_unit_label(ingredient.unit) %>
                      </td>
                      <td class="p-3 text-end tabular-nums text-gray-600 whitespace-nowrap">
                        <%= format_money(line[:unit_price_cents]) %>
                      </td>
                      <td class="p-3 pe-5 text-end font-semibold text-gray-900 tabular-nums whitespace-nowrap">
                        <%= format_money(line_total) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>

    <% if @skipped_low_stock.any? %>
      <section class="rounded-2xl border border-amber-200 bg-amber-50/60 overflow-hidden">
        <div class="px-5 py-4 border-b border-amber-200/80 bg-amber-50/80">
          <h2 class="text-sm font-semibold text-amber-950"><%= t("inventory.purchase_orders.suggestions.skipped.heading") %></h2>
          <p class="text-xs text-amber-900/80 mt-0.5"><%= t("inventory.purchase_orders.suggestions.skipped.description") %></p>
        </div>
        <ul class="divide-y divide-amber-200/60">
          <% @skipped_low_stock.each do |ingredient| %>
            <li class="px-5 py-3 flex flex-wrap justify-between items-center gap-3 hover:bg-amber-50/80 transition-colors">
              <div class="min-w-0">
                <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                      class: "font-semibold text-amber-900 hover:text-amber-950" %>
                <p class="text-xs text-amber-900/70 mt-0.5">
                  <%= t("inventory.purchase_orders.suggestions.skipped.stock_level",
                        on_hand: ingredient.quantity_on_hand,
                        reorder: ingredient.reorder_threshold,
                        unit: ingredient_unit_label(ingredient.unit)) %>
                </p>
              </div>
              <%= link_to t("inventory.purchase_orders.suggestions.skipped.assign_supplier"),
                    edit_admin_inventory_ingredient_path(ingredient, anchor: "suppliers"),
                    class: "inline-flex text-xs font-semibold text-amber-900 hover:bg-amber-100 px-3 py-1.5 rounded-xl border border-amber-300 transition-colors shrink-0" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% elsif @grouped.blank? %>
      <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
        <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.purchase_orders.suggestions.no_orderable.title") %></p>
        <p class="text-gray-500 text-sm"><%= t("inventory.purchase_orders.suggestions.no_orderable.description") %></p>
      </section>
    <% end %>
  <% end %>
</div>
