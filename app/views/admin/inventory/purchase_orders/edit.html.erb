<div class="max-w-4xl">
  <div class="mb-4">
    <%= link_to "← #{@purchase_order.po_number}", admin_inventory_purchase_order_path(@purchase_order),
          class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">Edit <%= @purchase_order.po_number %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= @purchase_order.supplier&.name %> · <%= @purchase_order.status.humanize %>
      </p>
    </div>
  </div>

  <%= render "admin/inventory/tools_nav" %>
  <%= render "form", purchase_order: @purchase_order %>
</div>
