<% table_head = "border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide" %>
<% status_label, status_class = purchase_order_status_badge(@purchase_order.status) %>
<% received_items = @items.count { |item| item.status == "received" } %>
<%= render "admin/inventory/tools_nav" %>
<div class="max-w-5xl">
  <div class="mb-4">
    <%= link_to t("inventory.purchase_orders.show.back_to_list"), admin_inventory_purchase_orders_path,
          class: "text-sm text-gray-600 hover:text-gray-900 transition-colors" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @purchase_order.po_number %></h1>
        <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= status_class %>">
          <%= status_label %>
        </span>
      </div>
      <p class="text-gray-600 text-sm mt-1">
        <%= link_to @purchase_order.supplier.name, admin_inventory_supplier_path(@purchase_order.supplier),
              class: "font-medium text-amber-700 hover:text-amber-800 transition-colors" %>
        <% if @purchase_order.ordered_on.present? %>
          · <%= t("inventory.purchase_orders.ordered_on") %> <%= l(@purchase_order.ordered_on) %>
        <% end %>
      </p>
    </div>

    <div class="flex flex-wrap gap-2 shrink-0">
      <% if @purchase_order.draft? %>
        <%= link_to t("inventory.purchase_orders.show.edit_po"), edit_admin_inventory_purchase_order_path(@purchase_order),
              class: "inline-flex items-center text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
      <% end %>
      <% if @purchase_order.may_send_to_supplier? %>
        <%= button_to t("inventory.purchase_orders.show.send_to_supplier"),
              send_to_supplier_admin_inventory_purchase_order_path(@purchase_order),
              method: :patch,
              class: "inline-flex items-center bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
      <% if %w[sent partially_received].include?(@purchase_order.status) %>
        <%= link_to t("inventory.purchase_orders.show.receive_delivery"),
              new_admin_inventory_purchase_order_delivery_path(@purchase_order),
              class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" %>
      <% end %>
      <% if @purchase_order.may_cancel? %>
        <%= button_to t("inventory.purchase_orders.show.cancel_po"),
              admin_inventory_purchase_order_path(@purchase_order),
              method: :delete,
              form: { data: { turbo_confirm: t("inventory.purchase_orders.show.cancel_confirm") } },
              class: "inline-flex items-center text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@purchase_order.total_cents) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.show.line_items_count") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @items.size %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.show.received_count") %></p>
      <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= received_items %><span class="text-base font-semibold text-gray-400">/<%= @items.size %></span></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.show.expected_on") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums">
        <%= @purchase_order.expected_on ? l(@purchase_order.expected_on) : t("inventory.purchase_orders.show.not_set") %>
      </p>
    </div>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.purchase_orders.show.details_heading") %></h2>
    </div>
    <dl class="grid sm:grid-cols-2 gap-4 p-5 text-sm">
      <div>
        <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.supplier") %></dt>
        <dd class="mt-1 font-medium text-gray-900">
          <%= link_to @purchase_order.supplier.name, admin_inventory_supplier_path(@purchase_order.supplier),
                class: "text-amber-700 hover:text-amber-800" %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.show.created_by") %></dt>
        <dd class="mt-1 text-gray-900"><%= @purchase_order.user.name %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.show.created_on") %></dt>
        <dd class="mt-1 text-gray-900 tabular-nums"><%= l(@purchase_order.created_at.to_date, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.ordered_on") %></dt>
        <dd class="mt-1 text-gray-900 tabular-nums">
          <%= @purchase_order.ordered_on ? l(@purchase_order.ordered_on) : t("inventory.purchase_orders.show.not_set") %>
        </dd>
      </div>
    </dl>
    <% if @purchase_order.notes.present? %>
      <div class="px-5 pb-5 border-t border-gray-100 pt-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5"><%= t("inventory.purchase_orders.show.notes_heading") %></p>
        <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @purchase_order.notes %></p>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.purchase_orders.show.line_items_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.purchase_orders.show.line_items_hint") %></p>
    </div>

    <% if @items.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[40rem]">
          <thead class="<%= table_head %>">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("inventory.purchase_orders.suggestions.table.ingredient") %></th>
              <th class="p-3 text-end"><%= t("inventory.purchase_orders.show.quantity_ordered") %></th>
              <th class="p-3 text-end"><%= t("inventory.purchase_orders.show.quantity_received") %></th>
              <th class="p-3 text-end"><%= t("inventory.purchase_orders.show.unit_price") %></th>
              <th class="p-3 text-end"><%= t("inventory.purchase_orders.show.line_total") %></th>
              <th class="p-3 pe-5 text-start"><%= t("inventory.purchase_orders.show.item_status") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @items.each do |item| %>
              <% item_label, item_class = purchase_order_item_status_badge(item.status) %>
              <% line_total = (item.quantity_ordered.to_d * item.unit_price_cents).round %>
              <tr class="hover:bg-gray-50/60 transition-colors">
                <td class="p-3 ps-5">
                  <%= link_to item.ingredient.name, admin_inventory_ingredient_path(item.ingredient),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                  <p class="text-xs text-gray-500 mt-0.5"><%= ingredient_unit_label(item.ingredient.unit) %></p>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-900"><%= item.quantity_ordered %></td>
                <td class="p-3 text-end tabular-nums <%= item.quantity_received.to_d.positive? ? 'text-green-700 font-semibold' : 'text-gray-500' %>">
                  <%= item.quantity_received %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-900"><%= format_money(item.unit_price_cents) %></td>
                <td class="p-3 text-end tabular-nums font-semibold text-gray-900"><%= format_money(line_total) %></td>
                <td class="p-3 pe-5">
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= item_class %>">
                    <%= item_label %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="border-t border-gray-200 bg-gray-50/60">
            <tr>
              <td colspan="4" class="p-3 ps-5 text-end text-xs font-semibold text-gray-500 uppercase tracking-wide">
                <%= t("inventory.purchase_orders.total") %>
              </td>
              <td class="p-3 text-end font-bold text-gray-900 tabular-nums"><%= format_money(@purchase_order.total_cents) %></td>
              <td class="p-3 pe-5"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.purchase_orders.show.empty_items_title") %></p>
        <p class="text-gray-500 text-sm mb-5"><%= t("inventory.purchase_orders.show.empty_items_description") %></p>
        <% if @purchase_order.draft? %>
          <%= link_to t("inventory.purchase_orders.show.edit_po"), edit_admin_inventory_purchase_order_path(@purchase_order),
                class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
