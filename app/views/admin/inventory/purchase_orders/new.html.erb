<div class="max-w-4xl">
  <div class="mb-4">
    <%= link_to "← Purchase orders", admin_inventory_purchase_orders_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title("new") %></h1>
      <p class="text-gray-600 text-sm mt-1">Draft a PO for your supplier. Line totals update when you save.</p>
    </div>
    <% if @prefilled_from_suggestions %>
      <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full bg-amber-100 text-amber-900 border border-amber-200">
        From suggestions
      </span>
    <% end %>
  </div>

  <%= render "admin/inventory/tools_nav" %>
  <%= render "form", purchase_order: @purchase_order %>
</div>
