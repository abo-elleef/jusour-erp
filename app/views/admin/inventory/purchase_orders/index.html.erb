<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% table_head = "border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide" %>

<%= render "admin/inventory/tools_nav" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("inventory.purchase_orders.index_description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <%= link_to suggestions_admin_inventory_purchase_orders_path,
            class: "inline-flex items-center text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" do %>
        <%= t("inventory.tools.po_suggestions") %>
      <% end %>
      <%= link_to new_admin_inventory_purchase_order_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" do %>
        <span aria-hidden="true">+</span> <%= t("inventory.purchase_orders.new_button") %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-6">
    <%= link_to admin_inventory_purchase_orders_path,
          class: orders_stat_card_class(@q.status_eq.blank? && !@filtered) do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.stats.total") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-900 tabular-nums"><%= @total_count %></p>
    <% end %>

    <%= link_to admin_inventory_purchase_orders_path(q: { status_eq: "draft" }),
          class: orders_stat_card_class(@q.status_eq == "draft") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.statuses.draft") %></p>
      <p class="text-2xl font-bold mt-1 text-gray-700 tabular-nums"><%= @draft_count %></p>
    <% end %>

    <%= link_to admin_inventory_purchase_orders_path(q: { status_eq: "sent" }),
          class: orders_stat_card_class(@q.status_eq == "sent") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.stats.open") %></p>
      <p class="text-2xl font-bold mt-1 text-blue-700 tabular-nums"><%= @open_count %></p>
      <p class="text-xs text-gray-500 mt-1.5"><%= t("inventory.purchase_orders.stats.open_hint") %></p>
    <% end %>

    <%= link_to admin_inventory_purchase_orders_path(q: { status_eq: "received" }),
          class: orders_stat_card_class(@q.status_eq == "received") do %>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.statuses.received") %></p>
      <p class="text-2xl font-bold mt-1 text-green-700 tabular-nums"><%= @received_count %></p>
    <% end %>

    <% if @cancelled_count.positive? %>
      <%= link_to admin_inventory_purchase_orders_path(q: { status_eq: "cancelled" }),
            class: orders_stat_card_class(@q.status_eq == "cancelled") do %>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("inventory.purchase_orders.statuses.cancelled") %></p>
        <p class="text-2xl font-bold mt-1 text-red-700 tabular-nums"><%= @cancelled_count %></p>
      <% end %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.purchase_orders.filters") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.purchase_orders.filters_hint") %></p>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_inventory_purchase_orders_path, method: :get,
            class: "flex flex-wrap items-end gap-4" do |f| %>
        <div class="flex-1 min-w-[10rem]">
          <%= f.label :po_number_cont, t("inventory.purchase_orders.po_number"), class: label_class %>
          <%= f.search_field :po_number_cont,
                placeholder: t("inventory.purchase_orders.po_search_placeholder"),
                class: pos_input_class %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :supplier_id_eq, t("inventory.purchase_orders.supplier"), class: label_class %>
          <%= f.collection_select :supplier_id_eq,
                @suppliers,
                :id,
                :name,
                { include_blank: t("inventory.purchase_orders.all_suppliers") },
                class: "#{pos_input_class} appearance-none" %>
        </div>
        <div class="min-w-[10rem]">
          <%= f.label :status_eq, t("inventory.purchase_orders.status"), class: label_class %>
          <%= f.select :status_eq,
                options_for_select(
                  [[t("inventory.purchase_orders.all_statuses"), ""]] +
                    PurchaseOrder.aasm.states.map { |s| [t("inventory.purchase_orders.statuses.#{s.name}"), s.name.to_s] },
                  @q.status_eq
                ),
                {},
                class: "#{pos_input_class} appearance-none" %>
        </div>
        <%= f.submit t("actions.apply_filters"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
        <% if @filtered %>
          <%= link_to t("actions.clear"), admin_inventory_purchase_orders_path,
                class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
        <% end %>
      <% end %>
    </div>
  </section>

  <% if @purchase_orders.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("inventory.purchase_orders.list_heading") %></h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[40rem]">
          <thead class="<%= table_head %>">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("inventory.purchase_orders.po_number") %></th>
              <th class="p-3 text-start"><%= t("inventory.purchase_orders.supplier") %></th>
              <th class="p-3 text-start"><%= t("inventory.purchase_orders.status") %></th>
              <th class="p-3 text-start"><%= t("inventory.purchase_orders.ordered_on") %></th>
              <th class="p-3 text-end"><%= t("inventory.purchase_orders.total") %></th>
              <th class="p-3 pe-5 text-end"><%= t("customers.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @purchase_orders.each do |po| %>
              <tr class="hover:bg-gray-50/60 transition-colors">
                <td class="p-3 ps-5">
                  <%= link_to po.po_number, admin_inventory_purchase_order_path(po),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                </td>
                <td class="p-3 text-gray-900"><%= po.supplier.name %></td>
                <td class="p-3">
                  <% label, badge_class = purchase_order_status_badge(po.status) %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border <%= badge_class %>">
                    <%= label %>
                  </span>
                </td>
                <td class="p-3 text-gray-600 tabular-nums whitespace-nowrap">
                  <%= po.ordered_on ? l(po.ordered_on) : "—" %>
                </td>
                <td class="p-3 text-end font-semibold text-gray-900 tabular-nums whitespace-nowrap">
                  <%= format_money(po.total_cents) %>
                </td>
                <td class="p-3 pe-5 text-end">
                  <%= link_to t("actions.view"), admin_inventory_purchase_order_path(po),
                        class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.purchase_orders.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("inventory.purchase_orders.empty_description") %></p>
      <div class="flex flex-wrap justify-center gap-3">
        <%= link_to t("inventory.purchase_orders.new_button"), new_admin_inventory_purchase_order_path,
              class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
        <%= link_to t("inventory.tools.po_suggestions"), suggestions_admin_inventory_purchase_orders_path,
              class: "font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-200 transition-colors" %>
      </div>
    </section>
  <% end %>
</div>
