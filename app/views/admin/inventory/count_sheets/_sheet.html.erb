<%# locals: groups, row_count, location, filter_locations, show_balance, sheet_url,
            back_url, back_label, subtitle, print_heading, empty_message,
            vendor_column (:vendor_product or :vendor), location_picker: true

    location_picker: false when the caller already fixes the location — a stock
    take is bound to one, so offering to re-pick it would build a sheet for a
    location the take does not cover.

    Shared by the vendor and category count sheets so the two can't drift — the
    printed artifact should be identical whichever way you scoped it. %>
<% cell = "border border-gray-400 p-2 align-middle" %>
<% location_picker = local_assigns.fetch(:location_picker, true) %>

<div class="flex flex-wrap justify-between items-start gap-4 mb-6 print:mb-3">
  <div>
    <p class="text-gray-600 text-sm">
      <%= location ? subtitle : t("inventory.count_sheet.pick_location") %>
    </p>
    <% if location %>
      <p class="text-gray-500 text-xs mt-1 print:block">
        <%= t("inventory.count_sheet.generated_at", at: l(Time.current, format: :long)) %>
        · <%= t("inventory.count_sheet.lines_count", count: row_count) %>
      </p>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2 shrink-0 print:hidden">
    <%= link_to back_label, back_url,
          class: "inline-flex text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2 rounded-xl border border-gray-200 transition-colors" %>
    <% if row_count.positive? %>
      <%# Opt-in only: a sheet showing the expected number gets confirmed rather
          than counted, so blind is the default. %>
      <%= link_to url_for(sheet_url.merge(show_balance: show_balance ? nil : 1)),
            class: "inline-flex text-sm font-semibold px-4 py-2 rounded-xl border transition-colors #{show_balance ? 'border-amber-500 bg-amber-50 text-amber-800' : 'border-gray-200 text-gray-700 hover:bg-gray-100'}" do %>
        <%= t(show_balance ? "inventory.count_sheet.hide_balance" : "inventory.count_sheet.show_balance") %>
      <% end %>
      <button type="button" onclick="window.print()"
              class="inline-flex text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 px-4 py-2 rounded-xl transition-colors cursor-pointer">
        <%= t("inventory.count_sheet.print") %>
      </button>
    <% end %>
  </div>
</div>

<%# A count only means something against one location's balances. %>
<% if location_picker %>
<section class="rounded-2xl border border-gray-200 bg-white p-5 mb-6 print:hidden">
  <%= form_with url: url_for(sheet_url), method: :get, class: "flex flex-wrap items-end gap-3" do %>
    <%= hidden_field_tag :show_balance, 1 if show_balance %>
    <div class="min-w-[14rem]">
      <%= label_tag :location_id, t("inventory.count_sheet.location"),
            class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
      <%= select_tag :location_id,
            options_from_collection_for_select(filter_locations, :id, :name, location&.id),
            include_blank: t("inventory.count_sheet.select_location"),
            class: "#{pos_input_class} appearance-none" %>
    </div>
    <%= submit_tag t("inventory.count_sheet.build"),
          class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors cursor-pointer" %>
  <% end %>
</section>
<% end %>

<% if location.blank? %>
  <section class="rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center print:hidden">
    <p class="text-gray-900 font-semibold mb-1"><%= t("inventory.count_sheet.pick_location") %></p>
    <p class="text-gray-500 text-sm"><%= t("inventory.count_sheet.pick_location_hint") %></p>
  </section>
<% elsif row_count.zero? %>
  <section class="rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center print:hidden">
    <p class="text-gray-500 text-sm"><%= empty_message %></p>
  </section>
<% else %>
  <%# The paper has to identify itself once it leaves the screen. %>
  <div class="hidden print:block mb-3">
    <p class="text-base font-bold"><%= Current.company.name %></p>
    <p class="text-sm font-semibold"><%= print_heading %></p>
    <div class="flex justify-between text-xs mt-2">
      <span><%= t("inventory.count_sheet.counted_by") %> ______________________</span>
      <span><%= t("inventory.count_sheet.count_date") %> ______________</span>
    </div>
  </div>

  <div class="space-y-6 print:space-y-3">
    <% groups.each do |group_label, rows| %>
      <%# print-flow, not print:break-inside-auto — the global print rule outscores
          a lone utility class, which is what stranded the table on page 2. %>
      <section class="print-flow rounded-2xl border border-gray-300 bg-white overflow-hidden print:rounded-none">
        <div class="px-5 py-3 border-b border-gray-200 bg-gray-100 print:bg-gray-200">
          <h2 class="text-sm font-semibold text-gray-900">
            <%= group_label %>
            <span class="font-normal text-gray-500">(<%= rows.size %>)</span>
          </h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse min-w-[640px]">
            <thead>
              <tr class="bg-gray-50 print:bg-gray-100 text-xs font-semibold text-gray-600 uppercase tracking-wide">
                <th class="<%= cell %> w-10 text-center"><%= t("shared.row_index") %></th>
                <th class="<%= cell %> text-start"><%= t("inventory.count_sheet.ingredient") %></th>
                <th class="<%= cell %> text-start w-[22%]"><%= t("inventory.count_sheet.#{vendor_column}") %></th>
                <th class="<%= cell %> text-start w-[12%]"><%= t("inventory.count_sheet.unit") %></th>
                <% if show_balance %>
                  <th class="<%= cell %> text-end w-[14%]"><%= t("inventory.count_sheet.system_balance") %></th>
                <% end %>
                <th class="<%= cell %> text-center w-[20%]"><%= t("inventory.count_sheet.actual_count") %></th>
              </tr>
            </thead>
            <tbody>
              <% rows.each_with_index do |row, index| %>
                <tr>
                  <td class="<%= cell %> text-center text-gray-500 tabular-nums"><%= index + 1 %></td>
                  <td class="<%= cell %> font-medium text-gray-900"><%= row.ingredient.name %></td>
                  <td class="<%= cell %> text-gray-700">
                    <% if vendor_column == :vendor %>
                      <%= row.supplier_names || "—" %>
                    <% else %>
                      <%= row.vendor_product_name || "—" %>
                      <% if row.vendor_sku %>
                        <span class="block text-xs text-gray-500"><%= row.vendor_sku %></span>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="<%= cell %> text-gray-700"><%= ingredient_unit_label(row.ingredient.purchase_unit) %></td>
                  <% if show_balance %>
                    <td class="<%= cell %> text-end tabular-nums text-gray-700">
                      <%= number_with_precision(row.expected_quantity, precision: 3, strip_insignificant_zeros: true) %>
                    </td>
                  <% end %>
                  <%# The write-in box: height, not content. This is what the pen fills. %>
                  <td class="<%= cell %> h-10 print:h-12"></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>

  <p class="text-xs text-gray-500 mt-4 print:mt-3"><%= t("inventory.count_sheet.footer_hint") %></p>
<% end %>
