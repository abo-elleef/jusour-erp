<%# Permission-driven admin navigation — every item gated by current_user.can?,
    section links land on the first accessible destination so a click never 403s. %>
<% section = "text-xs uppercase tracking-wide text-gray-400 mt-3 mb-1 px-2 block w-full" %>
<% in_settings = in_settings_section? %>
<% launch_pill = "inline-flex items-center gap-1.5 text-sm text-gray-300 border border-gray-700 rounded-lg px-3 py-2 hover:bg-gray-700 hover:text-white transition-colors" %>

<%# ── Overview ─────────────────────────────────────────────── %>
<% if current_user.can?("dashboard:view") %>
  <%= link_to admin_root_path, class: admin_nav_link_class(admin_nav_active?("admin/dashboard")) do %>
    <%= admin_nav_icon(:dashboard) %><span><%= t("nav.dashboard") %></span>
  <% end %>
<% end %>

<%# ── Sell & serve ─────────────────────────────────────────── %>
<% menu_selling = tab_feature_enabled?(feature: :menu) %>
<% if (menu_selling && (current_user.can?("orders:view") || current_user.can?("menu:manage"))) || current_user.can?("customers:manage") %>
  <span class="<%= section %>"><%= t("nav.groups.sell_serve") %></span>
  <% if menu_selling && current_user.can?("orders:view") %>
    <%= link_to admin_orders_path, class: admin_nav_link_class(admin_nav_active?("admin/orders")) do %>
      <%= admin_nav_icon(:orders) %><span><%= t("nav.orders") %></span>
    <% end %>
  <% end %>
  <% if menu_selling && current_user.can?("menu:manage") %>
    <%= link_to admin_menu_items_path, class: admin_nav_link_class(admin_nav_active?("admin/menu_items", "admin/categories", "admin/combos", "admin/menu_promos", "admin/modifiers", "admin/modifier_groups", "admin/tax_rates")) do %>
      <%= admin_nav_icon(:menu) %><span><%= t("nav.menu") %></span>
    <% end %>
  <% end %>
  <% if current_user.can?("customers:manage") %>
    <%= link_to admin_customers_path, class: admin_nav_link_class(admin_nav_active?("admin/customers")) do %>
      <%= admin_nav_icon(:customers) %><span><%= t("nav.customers") %></span>
    <% end %>
  <% end %>
  <% if current_user.can?("customers:manage") && Current.company&.feature_enabled?(:ar_credit_sales) %>
    <%= link_to admin_sales_customer_invoices_path, class: admin_nav_link_class(admin_nav_active?("admin/sales")) do %>
      <%= admin_nav_icon(:orders) %><span><%= t("nav.sales") %></span>
    <% end %>
  <% end %>
<% end %>

<%# ── Stock & finance ──────────────────────────────────────── %>
<% if inventory_any_access? || accounting_any_access? %>
  <span class="<%= section %>"><%= t("nav.groups.stock_finance") %></span>
  <% if inventory_any_access? %>
    <%= render "admin/nested_module_nav",
          module_key: "inventory",
          label: t("nav.inventory"),
          icon: :inventory,
          active: admin_nav_active?("admin/inventory"),
          groups: inventory_sidebar_groups,
          current_group: inventory_current_group,
          tab_active_proc: ->(tab) { inventory_tab_active?(tab) } %>
  <% end %>
  <% if accounting_any_access? %>
    <%= render "admin/nested_module_nav",
          module_key: "accounting",
          label: t("nav.accounting"),
          icon: :accounting,
          active: admin_nav_active?("admin/accounting") && !in_settings,
          groups: accounting_sidebar_groups,
          current_group: accounting_current_group,
          tab_active_proc: ->(tab) { accounting_tab_active?(tab) } %>
  <% end %>
<% end %>

<%# ── Settings (folds in Staff, Locations, Printers, Roles, Integrations, Online payments) %>
<% if settings_any_access? %>
  <div class="my-2 border-t border-gray-800"></div>
  <%= render "admin/settings_module_nav" %>
<% end %>

<%# ── Launch (operational apps — switch into a different workspace) %>
<% if Current.company.restaurant? && (current_user.can?("pos:access") || current_user.can?("kitchen:access") || current_user.can?("production:access")) %>
  <div class="my-2 border-t border-gray-800"></div>
  <span class="<%= section %>"><%= t("nav.groups.launch") %></span>
  <div class="flex flex-wrap gap-1.5 px-1 mt-1">
    <% if current_user.can?("pos:access") %>
      <%= link_to pos_path, class: launch_pill do %>
        <%= admin_nav_icon(:pos, css: "w-4 h-4 shrink-0") %><span><%= t("nav.pos") %></span>
      <% end %>
    <% end %>
    <% if current_user.can?("kitchen:access") %>
      <%= link_to kitchen_path, class: launch_pill do %>
        <%= admin_nav_icon(:kitchen, css: "w-4 h-4 shrink-0") %><span><%= t("nav.kitchen") %></span>
      <% end %>
    <% end %>
    <% if current_user.can?("production:access") %>
      <%= link_to production_path, class: launch_pill do %>
        <%= admin_nav_icon(:production, css: "w-4 h-4 shrink-0") %><span><%= t("nav.production") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
