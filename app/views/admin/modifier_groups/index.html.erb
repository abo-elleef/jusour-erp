<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= render "admin/menu_nav" %>

<div class="max-w-4xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= admin_page_title %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("menu.modifier_groups.description") %></p>
    </div>
    <%= link_to new_admin_modifier_group_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("menu.modifier_groups.new_button") %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("menu.modifier_groups.search") %></h2>
    </div>
    <div class="p-5">
      <%= search_form_for @q, url: admin_modifier_groups_path, method: :get,
            class: "flex flex-wrap items-end gap-4" do |f| %>
        <div class="flex-1 min-w-[12rem]">
          <%= f.label :name_cont, t("menu.modifier_groups.name"), class: label_class %>
          <%= f.search_field :name_cont,
                placeholder: t("menu.modifier_groups.search_placeholder"),
                class: pos_input_class %>
        </div>
        <%= f.submit t("actions.apply_filters"),
              class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </div>
  </section>

  <% if @modifier_groups.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("menu.modifier_groups.list_heading") %></h2>
      </div>
      <ul class="divide-y divide-gray-100">
        <% @modifier_groups.each do |group| %>
          <li class="px-5 py-4 flex flex-wrap justify-between items-center gap-3 hover:bg-gray-50/60 transition-colors">
            <div class="min-w-0">
              <%= link_to group.name, admin_modifier_group_path(group),
                    class: "font-semibold text-amber-700 hover:text-amber-800" %>
              <div class="flex flex-wrap gap-2 mt-1.5">
                <% if group.required? %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-200">
                    <%= t("menu.modifier_groups.required") %>
                  </span>
                <% end %>
                <% if group.multi_select? %>
                  <span class="text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 border border-blue-200">
                    <%= t("menu.modifier_groups.multi_select") %>
                  </span>
                <% end %>
              </div>
              <p class="text-xs text-gray-500 mt-1">
                <%= t("menu.modifier_groups.modifier_count", count: group.modifiers.size) %> ·
                <%= t("menu.modifier_groups.menu_item_count", count: group.menu_items.size) %>
              </p>
            </div>
            <div class="flex gap-2 shrink-0">
              <%= link_to t("actions.edit"), edit_admin_modifier_group_path(group),
                    class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
              <% if policy(group).destroy? && group.menu_items.none? && !group.modifiers.joins(:order_item_modifiers).exists? %>
                <%= button_to t("actions.delete"), admin_modifier_group_path(group), method: :delete,
                      form: { data: { turbo_confirm: t("menu.modifier_groups.confirm_delete", name: group.name) }, class: "inline" },
                      class: "inline-flex text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200 transition-colors" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("menu.modifier_groups.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("menu.modifier_groups.empty_description") %></p>
      <%= link_to t("menu.modifier_groups.new_button"), new_admin_modifier_group_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
    </section>
  <% end %>
</div>
