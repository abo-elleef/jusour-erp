<h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-4"><%= t("admin.dashboard.title") %></h1>
<p class="text-gray-600"><%= t("admin.dashboard.description") %></p>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
  <%= link_to t("nav.categories"), admin_categories_path, class: "p-6 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center font-semibold transition-colors" %>
  <%= link_to t("nav.menu"), admin_menu_items_path, class: "p-6 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center font-semibold transition-colors" %>
  <%= link_to t("nav.combos"), admin_combos_path, class: "p-6 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center font-semibold transition-colors" %>
  <%= link_to t("nav.customers"), admin_customers_path, class: "p-6 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center font-semibold transition-colors" %>
  <%= link_to t("nav.orders"), admin_orders_path, class: "p-6 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center font-semibold transition-colors" %>
  <%= link_to t("nav.staff"), admin_users_path, class: "p-6 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center font-semibold transition-colors" %>
  <%= link_to t("nav.inventory"), admin_inventory_ingredients_path, class: "p-6 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center font-semibold transition-colors" %>
</div>
