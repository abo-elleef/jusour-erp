<h1 class="text-2xl font-bold mb-4">Dashboard</h1>
<p class="text-gray-600">Manage menu, discounts, customers, and orders.</p>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
  <%= link_to "Categories", admin_categories_path, class: "p-6 bg-white rounded-lg shadow hover:shadow-md text-center font-medium" %>
  <%= link_to "Menu Items", admin_menu_items_path, class: "p-6 bg-white rounded-lg shadow hover:shadow-md text-center font-medium" %>
  <%= link_to "Combos", admin_combos_path, class: "p-6 bg-white rounded-lg shadow hover:shadow-md text-center font-medium" %>
  <%= link_to "Customers", admin_customers_path, class: "p-6 bg-white rounded-lg shadow hover:shadow-md text-center font-medium" %>
  <%= link_to "Orders", admin_orders_path, class: "p-6 bg-white rounded-lg shadow hover:shadow-md text-center font-medium" %>
  <%= link_to "Staff", admin_users_path, class: "p-6 bg-white rounded-lg shadow hover:shadow-md text-center font-medium" %>
</div>
