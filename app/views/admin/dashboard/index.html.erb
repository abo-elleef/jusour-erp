<% content_for :title, t("admin.dashboard.title") %>

<div class="max-w-7xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-6"><%= t("admin.dashboard.title") %></h1>

  <%# ── Today at a glance ──────────────────────────────────────── %>
  <%# POS ticket figures: shown only to companies that actually sell that way, since
      three zeros read as a bad day rather than as "not applicable here". %>
  <% if current_user.can?("orders:view") && tab_feature_enabled?(feature: :menu) %>
    <section class="mb-8">
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3"><%= t("dashboard.today_section") %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-2xl border border-gray-200 bg-white p-5">
          <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("dashboard.today_revenue") %></p>
          <p class="text-3xl font-bold text-gray-900 tabular-nums mt-1"><%= format_money(@today_revenue_cents) %></p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5">
          <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("dashboard.today_orders") %></p>
          <p class="text-3xl font-bold text-gray-900 tabular-nums mt-1"><%= @today_order_count %></p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5">
          <p class="text-xs font-semibold text-gray-500 uppercase"><%= t("dashboard.today_avg") %></p>
          <p class="text-3xl font-bold text-gray-900 tabular-nums mt-1"><%= format_money(@today_avg_cents) %></p>
        </div>
      </div>
    </section>
  <% end %>

<%# ── Treasury flow today ────────────────────────────────────── %>
  <% if accounting_any_access? %>
    <section class="mb-8">
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3"><%= t("dashboard.treasury_flow_section") %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-5">
          <p class="text-xs font-semibold text-emerald-800 uppercase"><%= t("dashboard.treasury_in_today") %></p>
          <p class="text-3xl font-bold text-emerald-900 tabular-nums mt-1">+<%= format_money(@treasury_in_cents) %></p>
        </div>
        <div class="rounded-2xl border border-red-200 bg-red-50/60 p-5">
          <p class="text-xs font-semibold text-red-800 uppercase"><%= t("dashboard.treasury_out_today") %></p>
          <p class="text-3xl font-bold text-red-900 tabular-nums mt-1">-<%= format_money(@treasury_out_cents) %></p>
        </div>
      </div>
    </section>
  <% end %>

  <%# ── Inventory alerts + Pending work ───────────────────────── %>
  <% if inventory_any_access? || current_user.can?("payroll:view") %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

      <%# Inventory alerts %>
      <% if inventory_any_access? %>
        <section>
          <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3"><%= t("dashboard.inventory_section") %></h2>
          <div class="rounded-2xl border border-gray-200 bg-white divide-y divide-gray-100 overflow-hidden">
            <%= link_to admin_inventory_ingredients_path(q: { low_stock_true: "1" }),
                  class: "flex items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors" do %>
              <span class="text-sm font-medium text-gray-700"><%= t("dashboard.low_stock") %></span>
              <span class="text-sm font-bold tabular-nums <%= @low_stock_count.positive? ? 'text-amber-700' : 'text-gray-400' %>">
                <%= @low_stock_count %>
              </span>
            <% end %>
            <%= link_to admin_inventory_ingredients_path(q: { out_of_stock_true: "1" }),
                  class: "flex items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors" do %>
              <span class="text-sm font-medium text-gray-700"><%= t("dashboard.out_of_stock") %></span>
              <span class="text-sm font-bold tabular-nums <%= @out_of_stock_count.positive? ? 'text-red-700' : 'text-gray-400' %>">
                <%= @out_of_stock_count %>
              </span>
            <% end %>
            <%= link_to admin_inventory_ingredients_path(q: { no_cost_true: "1" }),
                  class: "flex items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors" do %>
              <span class="text-sm font-medium text-gray-700"><%= t("dashboard.no_cost") %></span>
              <span class="text-sm font-bold tabular-nums <%= @no_cost_count.positive? ? 'text-orange-600' : 'text-gray-400' %>">
                <%= @no_cost_count %>
              </span>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# Pending work %>
      <section>
        <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3"><%= t("dashboard.pending_section") %></h2>
        <div class="rounded-2xl border border-gray-200 bg-white divide-y divide-gray-100 overflow-hidden">
          <% if @open_stock_takes %>
            <%= link_to admin_inventory_stock_takes_path,
                  class: "flex items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors" do %>
              <span class="text-sm font-medium text-gray-700"><%= t("dashboard.open_stock_takes") %></span>
              <span class="text-sm font-bold tabular-nums <%= @open_stock_takes.positive? ? 'text-amber-700' : 'text-gray-400' %>">
                <%= @open_stock_takes %>
              </span>
            <% end %>
          <% end %>
          <% if @outstanding_invoices %>
            <%= link_to admin_inventory_vendor_invoices_path(q: { payment_status_in: %w[unpaid partially_paid] }),
                  class: "flex items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors" do %>
              <span class="text-sm font-medium text-gray-700"><%= t("dashboard.outstanding_invoices") %></span>
              <span class="text-sm font-bold tabular-nums <%= @outstanding_invoices.positive? ? 'text-red-700' : 'text-gray-400' %>">
                <%= @outstanding_invoices %>
              </span>
            <% end %>
          <% end %>
          <% if !@payroll_finalized_this_month.nil? %>
            <%= link_to admin_accounting_monthly_payroll_path,
                  class: "flex items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors" do %>
              <span class="text-sm font-medium text-gray-700"><%= t("dashboard.payroll_this_month") %></span>
              <% if @payroll_finalized_this_month %>
                <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full"><%= t("dashboard.payroll_done") %></span>
              <% else %>
                <span class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full"><%= t("dashboard.payroll_pending") %></span>
              <% end %>
            <% end %>
          <% end %>
          <% if @open_stock_takes.nil? && @outstanding_invoices.nil? && @payroll_finalized_this_month.nil? %>
            <p class="px-5 py-4 text-sm text-gray-400"><%= t("dashboard.no_pending_access") %></p>
          <% end %>
        </div>
      </section>

    </div>
  <% end %>

  <%# ── Quick links ─────────────────────────────────────────────── %>
  <section class="mt-8">
    <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3"><%= t("dashboard.quick_links") %></h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <% if current_user.can?("orders:view") && tab_feature_enabled?(feature: :menu) %>
        <%= link_to t("nav.orders"), admin_orders_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
      <% end %>
      <% if current_user.can?("menu:manage") && tab_feature_enabled?(feature: :menu) %>
        <%= link_to t("nav.menu"), admin_menu_items_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
      <% end %>
      <% if current_user.can?("customers:manage") %>
        <%= link_to t("nav.customers"), admin_customers_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
      <% end %>
      <% if current_user.can?("customers:manage") && tab_feature_enabled?(feature: :ar_credit_sales) %>
        <%= link_to t("sales.reports.title"), admin_sales_reports_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
      <% end %>
      <% if current_user.can?("accounting:transactions") %>
        <%= link_to t("accounting.nav.expenses"), admin_accounting_expenses_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
        <%= link_to t("accounting.nav.incomes"), admin_accounting_incomes_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
      <% end %>
      <% if current_user.can?("accounting:ledgers") %>
        <% treasury_path = @default_treasury ? admin_accounting_treasury_path(@default_treasury) : admin_accounting_treasuries_path %>
        <%= link_to t("accounting.nav.treasuries"), treasury_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
      <% end %>
      <% if inventory_any_access? %>
        <%= link_to t("inventory.tools.vendor_invoices"), admin_inventory_vendor_invoices_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
        <%= link_to t("inventory.tools.vendor_credit_notes"), admin_inventory_vendor_credit_notes_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
        <%= link_to t("inventory.tools.stock_transfers"), admin_inventory_stock_transfers_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
        <%= link_to t("nav.inventory"), admin_inventory_ingredients_path, class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" %>
      <% end %>
      <% if @storefront_url %>
        <%= link_to @storefront_url, target: "_blank", rel: "noopener",
              class: "p-4 bg-white rounded-2xl border border-gray-200 hover:border-gray-300 text-center text-sm font-semibold transition-colors" do %>
          <%= t("dashboard.view_website") %> <span aria-hidden="true">↗</span>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
