<%# locals: module_key:, label:, icon:, active:, groups:, current_group:, tab_active_proc: %>
<% open_group_key = current_group&.dig(:key).to_s %>
<div class="flex flex-col gap-0.5"
     data-controller="nested-nav"
     data-nested-nav-key-value="<%= module_key %>"
     data-nested-nav-open-value="<%= active %>"
     data-nested-nav-open-group-value="<%= open_group_key %>">
  <button type="button"
          data-nested-nav-module-button
          data-action="nested-nav#toggleModule"
          aria-expanded="<%= active %>"
          class="<%= admin_nav_link_class(active) %> w-full text-start">
    <%= admin_nav_icon(icon) %>
    <span class="flex-1"><%= label %></span>
    <svg data-nested-nav-target="moduleChevron"
         class="w-3.5 h-3.5 shrink-0 opacity-60 transition-transform <%= active ? "rotate-90" : (rtl? ? "rotate-180" : nil) %>"
         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <div data-nested-nav-target="modulePanel" class="<%= "hidden" unless active %> ms-2 border-s border-gray-700 ps-2 flex flex-col gap-0.5">
    <% groups.each do |group| %>
      <% group_open = current_group && current_group[:key] == group[:key] %>
      <% group_dom_id = "#{module_key}-#{group[:key]}" %>
      <div class="flex flex-col gap-0.5">
        <button type="button"
                data-nested-nav-target="groupButton"
                data-action="nested-nav#toggleGroup"
                data-group-key="<%= group[:key] %>"
                aria-expanded="<%= group_open %>"
                aria-controls="<%= group_dom_id %>"
                class="flex items-center gap-2 w-full text-start py-1.5 px-2 rounded-lg text-xs uppercase tracking-wide text-gray-400 hover:text-gray-200 hover:bg-gray-800 transition-colors">
          <%= admin_nav_icon(group[:icon], css: "w-3.5 h-3.5 shrink-0 opacity-70") %>
          <span class="flex-1"><%= t(group[:label]) %></span>
          <svg data-nested-nav-target="groupChevron"
               data-group-key="<%= group[:key] %>"
               class="w-3 h-3 shrink-0 opacity-50 transition-transform <%= group_open ? "rotate-90" : (rtl? ? "rotate-180" : nil) %>"
               fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <div id="<%= group_dom_id %>"
             data-nested-nav-target="groupPanel"
             data-group-key="<%= group[:key] %>"
             class="<%= "hidden" unless group_open %> flex flex-col gap-0.5 pb-1">
          <% group[:tabs].each do |tab| %>
            <% tab_active = tab_active_proc.call(tab) %>
            <%= link_to bt_t(tab[:label]), public_send(tab[:path]),
                  class: "block py-1.5 px-2 rounded-lg text-sm transition-colors #{tab_active ? "bg-gray-700 text-white" : "text-gray-300 hover:bg-gray-800 hover:text-white"}" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
