<%# Every report across Inventory, Accounting and (for distribution companies)
    Sales in one place — see ApplicationHelper#reports_hub_sections. Avoids
    admin_page_title: it special-cases controller_name == "reports" for the
    Inventory reports controller (same controller_name, different namespace),
    which this page would otherwise collide with. %>
<% content_for :title, t("reports_hub.title") %>

<div class="max-w-full">
  <div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("reports_hub.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("reports_hub.subtitle") %></p>
  </div>

  <% @sections.each do |section| %>
    <section class="mb-10 last:mb-0">
      <div class="flex items-center gap-2 mb-4">
        <%= admin_nav_icon(section[:icon], css: "w-4 h-4 text-gray-400 shrink-0") %>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500"><%= section[:label] %></h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% section[:items].each do |item| %>
          <%= link_to item[:path],
                class: "group flex flex-col gap-2 p-5 rounded-2xl border border-gray-200 bg-white hover:border-amber-300 hover:shadow-md transition-all" do %>
            <div class="flex items-start justify-between gap-2">
              <span class="font-semibold text-gray-900 group-hover:text-amber-700"><%= item[:label] %></span>
              <svg class="w-4 h-4 text-gray-300 group-hover:text-amber-500 shrink-0 mt-0.5 transition-transform group-hover:translate-x-0.5 <%= "-scale-x-100" if rtl? %>"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            <% if item[:description].present? %>
              <p class="text-sm text-gray-500 leading-snug"><%= item[:description] %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
