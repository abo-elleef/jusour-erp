<div class="max-w-7xl">
  <%# ── Header ──────────────────────────────────────────────────────── %>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <p class="text-sm text-gray-500 mb-1">
        <%= link_to t("inventory.tools.ingredients"), admin_inventory_ingredients_path, class: "hover:underline" %> /
      </p>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">
        <%= @location.name %>
      </h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("admin.locations.ingredients_description") %></p>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <% if policy(@location).update? && @has_positive_stock && !@location.central_kitchen? %>
        <%= button_to t("admin.locations.clear_stock"),
              clear_stock_admin_location_ingredients_path(@location),
              method: :post,
              form: { data: { turbo_confirm: t("admin.locations.clear_stock_confirm", name: @location.name) }, class: "shrink-0" },
              class: "inline-flex items-center text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors" %>
      <% end %>
    </div>
  </div>

  <%# ── Stat tiles ──────────────────────────────────────────────────── %>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow p-4 border-2 border-transparent">
      <p class="text-sm text-gray-500"><%= t("inventory.ingredients.index.stats.active") %></p>
      <p class="text-2xl font-bold mt-1"><%= @ingredients.size %></p>
    </div>
    <%= link_to admin_location_ingredients_path(@location, stock: "low", sort: @sort, dir: @direction),
          class: "bg-white rounded-lg shadow p-4 border-2 transition-colors #{@stock_filter == 'low' ? 'border-amber-400 ring-1 ring-amber-200' : 'border-transparent hover:border-amber-200'}" do %>
      <p class="text-sm text-gray-500"><%= t("inventory.ingredients.index.stats.low_stock") %></p>
      <p class="text-2xl font-bold mt-1 text-red-600"><%= @low_stock_count %></p>
      <p class="text-xs text-amber-600 mt-1"><%= t("inventory.ingredients.index.stats.click_to_filter") %></p>
    <% end %>
    <%= link_to admin_location_ingredients_path(@location, stock: "out", sort: @sort, dir: @direction),
          class: "bg-white rounded-lg shadow p-4 border-2 transition-colors #{@stock_filter == 'out' ? 'border-red-500 ring-1 ring-red-200' : 'border-transparent hover:border-red-200'}" do %>
      <p class="text-sm text-gray-500"><%= t("inventory.ingredients.index.stats.out_of_stock") %></p>
      <p class="text-2xl font-bold mt-1 text-red-700"><%= @out_of_stock_count %></p>
      <p class="text-xs text-amber-600 mt-1"><%= t("inventory.ingredients.index.stats.click_to_filter") %></p>
    <% end %>
  </div>

  <%# ── Search + filter bar ─────────────────────────────────────────── %>
  <div class="bg-white rounded-lg shadow p-4 mb-4">
    <%= form_with url: admin_location_ingredients_path(@location), method: :get,
          class: "flex flex-wrap gap-3 items-end" do %>
      <%= hidden_field_tag :stock, @stock_filter if @stock_filter.present? %>
      <%= hidden_field_tag :sort, @sort %>
      <%= hidden_field_tag :dir, @direction %>
      <div class="flex-1 min-w-[200px]">
        <%= label_tag :search, t("inventory.ingredients.index.search_label"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_field_tag :search, @search,
              placeholder: t("inventory.ingredients.index.search_placeholder"),
              class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div class="flex gap-2">
        <%= submit_tag t("actions.apply_filters"),
              class: "bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" %>
        <% if @search.present? || @stock_filter.present? %>
          <%= link_to t("inventory.ingredients.index.clear_filters"),
                admin_location_ingredients_path(@location),
                class: "px-4 py-2 rounded-lg text-sm font-medium border border-gray-200 text-gray-700 hover:bg-gray-50" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Table ───────────────────────────────────────────────────────── %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left min-w-[900px]">
        <% sort_opts = { sort: @sort, direction: @direction } %>
        <thead class="bg-gray-50 border-b text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 pl-4 w-12 text-gray-400"><%= t("shared.row_index") %></th>
            <th class="p-3"><%= sort_header_link(t("inventory.ingredients.index.table.code"), :code, **sort_opts) %></th>
            <th class="p-3"><%= sort_header_link(t("inventory.ingredients.index.table.ingredient"), :name, **sort_opts) %></th>
            <th class="p-3"><%= t("inventory.ingredients.index.table.unit") %></th>
            <th class="p-3"><%= sort_header_link(t("admin.locations.branch_stock"), :branch_quantity, **sort_opts) %></th>
            <th class="p-3"><%= sort_header_link(t("inventory.ingredients.index.table.suppliers"), :suppliers, **sort_opts) %></th>
            <th class="p-3"><%= sort_header_link(t("inventory.ingredients.index.table.status"), :status, **sort_opts) %></th>
            <th class="p-3 pr-4 text-right"><%= t("inventory.ingredients.index.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 table-zebra">
          <% if @ingredients.empty? %>
            <tr>
              <td colspan="8" class="p-12 text-center">
                <p class="text-gray-600 font-medium mb-1"><%= t("inventory.ingredients.index.empty_title") %></p>
                <p class="text-gray-500 text-sm">
                  <%= @search.present? || @stock_filter.present? ?
                        t("inventory.ingredients.index.empty_description_filtered") :
                        t("inventory.ingredients.index.empty_description") %>
                </p>
              </td>
            </tr>
          <% end %>

          <% @ingredients.each_with_index do |ingredient, index| %>
            <% il = @ingredient_location_map[ingredient.id] %>
            <% branch_qty = il&.quantity_on_hand || 0 %>
            <% branch_status = il&.stock_status || :out %>
            <% reorder = (il&.reorder_threshold || ingredient.reorder_threshold).to_d %>
            <% max_qty = (il&.max_quantity || ingredient.max_quantity).to_d %>
            <% stock_pct = reorder.positive? ? [[(branch_qty.to_d / reorder * 100), 0].max, 100].min : (branch_qty.positive? ? 60 : 0) %>

            <tr class="hover:bg-gray-50/80 <%= branch_status == :out ? 'bg-red-50/30' : branch_status == :low ? 'bg-amber-50/30' : '' %>">
              <td class="p-3 pl-4 text-gray-400 tabular-nums"><%= index + 1 %></td>
              <td class="p-3 font-mono text-xs font-semibold text-amber-700 whitespace-nowrap"><%= ingredient.code %></td>
              <td class="p-3">
                <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient),
                      class: "font-medium text-blue-600 hover:underline" %>
                <p class="text-xs text-gray-500 mt-0.5"><%= ingredient.ingredient_category.name %></p>
              </td>
              <td class="p-3 text-gray-700 whitespace-nowrap"><%= ingredient_unit_label(ingredient.unit) %></td>

              <%# Branch stock + bar %>
              <td class="p-3 min-w-[150px]">
                <div class="font-medium text-gray-900 tabular-nums">
                  <%= number_with_precision(branch_qty, precision: 3, strip_insignificant_zeros: true) %>
                  <span class="text-xs text-gray-500 font-normal"><%= ingredient_unit_label(ingredient.unit) %></span>
                </div>
                <div class="mt-1.5 h-1.5 w-full max-w-[120px] bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full rounded-full <%= branch_status == :out ? 'bg-red-500' : branch_status == :low ? 'bg-amber-500' : 'bg-green-500' %>"
                       style="width: <%= stock_pct %>%"></div>
                </div>
                <p class="text-xs text-gray-500 mt-0.5">
                  <% if reorder.positive? %>
                    <%= t("inventory.ingredients.index.reorder_at", threshold: number_with_precision(reorder, precision: 3, strip_insignificant_zeros: true)) %>
                  <% end %>
                </p>
                <p class="text-xs text-gray-400">
                  <% if max_qty.positive? %>
                    <%= t("inventory.ingredients.index.max_at", quantity: number_with_precision(max_qty, precision: 3, strip_insignificant_zeros: true)) %>
                  <% end %>
                </p>
              </td>

              <td class="p-3 text-gray-600 max-w-[180px]">
                <%= ingredient_suppliers_summary(ingredient) %>
              </td>

              <td class="p-3">
                <% case branch_status
                   when :out %>
                  <span class="inline-flex text-xs font-semibold px-2.5 py-1 rounded-full bg-red-100 text-red-800"><%= t("admin.inventory.status_out") %></span>
                <% when :low %>
                  <span class="inline-flex text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800"><%= t("admin.inventory.status_low") %></span>
                <% else %>
                  <span class="inline-flex text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800"><%= t("admin.inventory.status_ok") %></span>
                <% end %>
              </td>

              <td class="p-3 pr-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to t("actions.view"), admin_inventory_ingredient_path(ingredient),
                        class: "text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200 transition-colors" %>
                  <% if policy(@location).update? %>
                    <button type="button"
                            class="text-xs font-semibold text-amber-700 hover:bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-200 transition-colors"
                            data-action="click->modal#open"
                            data-modal-id="adjust-modal-<%= ingredient.id %>">
                      <%= t("inventory.ingredients.index.adjust") %>
                    </button>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── Adjust modals (one per ingredient, hidden by default) ───────── %>
  <% if policy(@location).update? %>
    <% @ingredients.each do |ingredient| %>
      <dialog id="adjust-modal-<%= ingredient.id %>"
              class="rounded-2xl shadow-xl border border-gray-200 p-0 w-full max-w-md backdrop:bg-black/40 m-auto"
              style="position: fixed; inset: 0; margin: auto;"
              data-controller="modal"
              data-modal-id-value="adjust-modal-<%= ingredient.id %>">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
          <div>
            <h2 class="text-base font-bold text-gray-900"><%= ingredient.name %></h2>
            <p class="text-xs text-gray-500 mt-0.5"><%= t("inventory.ingredients.index.adjust") %> · <%= @location.name %></p>
          </div>
          <button type="button"
                  class="text-gray-400 hover:text-gray-700 p-1 rounded-lg hover:bg-gray-100 transition-colors"
                  data-action="click->modal#close"
                  aria-label="<%= t("actions.close") %>">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <%= form_with url: adjust_admin_location_ingredient_path(@location, ingredient),
              method: :post,
              class: "px-6 py-5 space-y-4" do %>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <%= label_tag :quantity_delta, t("inventory.ingredients.show.quantity_delta"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
              <%= number_field_tag :quantity_delta, nil,
                    step: 0.001, required: true,
                    placeholder: "+5 or −2",
                    class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
            </div>
            <div>
              <%= label_tag :unit, t("inventory.ingredients.alternate_units.unit"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
              <%= select_tag :unit,
                    options_for_select(ingredient.available_units.map { |u| [ingredient_unit_label(u), u] }, ingredient.unit),
                    class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm appearance-none" %>
            </div>
          </div>
          <div>
            <%= label_tag :adjustment_type, t("inventory.ingredients.show.adjustment_type"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <%= select_tag :adjustment_type,
                  options_for_select(
                    StockAdjustment::ADJUSTMENT_TYPES.map { |type| [inventory_adjustment_type_label(type), type] },
                    "manual_add"
                  ),
                  class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm appearance-none" %>
          </div>
          <div>
            <%= label_tag :reason_notes, t("inventory.ingredients.show.notes_placeholder"), class: "block text-xs font-semibold text-gray-600 mb-1.5" %>
            <%= text_field_tag :reason_notes, nil,
                  placeholder: t("inventory.ingredients.show.notes_placeholder"),
                  class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
          </div>
          <div class="flex gap-3 pt-1">
            <%= submit_tag t("inventory.ingredients.show.apply_adjustment"),
                  class: "flex-1 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer" %>
            <button type="button"
                    data-action="click->modal#close"
                    class="px-4 py-2.5 rounded-xl border border-gray-200 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors">
              <%= t("actions.cancel") %>
            </button>
          </div>
        <% end %>
      </dialog>
    <% end %>
  <% end %>
</div>

<script>
// Lightweight <dialog> controller — no Stimulus dependency needed.
// Opens the native <dialog> matching data-modal-id on the button.
document.addEventListener("click", function(e) {
  const openBtn = e.target.closest("[data-action='click->modal#open']");
  if (openBtn) {
    const id = openBtn.dataset.modalId;
    document.getElementById(id)?.showModal();
  }
  const closeBtn = e.target.closest("[data-action='click->modal#close']");
  if (closeBtn) {
    closeBtn.closest("dialog")?.close();
  }
});
// Click backdrop to close
document.addEventListener("click", function(e) {
  if (e.target.tagName === "DIALOG") e.target.close();
});
</script>
