<% input_class = "w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" %>
<% label_class = "block text-sm font-semibold text-gray-700 mb-1" %>
<%= form_with model: [:admin, location, delivery_area], class: "space-y-5" do |f| %>
  <% if delivery_area.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-200 p-4">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% delivery_area.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("admin.delivery_areas.fields.name"), class: label_class %>
    <%= f.text_field :name, required: true, class: input_class %>
  </div>

  <div>
    <%= f.label :name_ar, t("admin.delivery_areas.fields.name_ar"), class: label_class %>
    <%= f.text_field :name_ar, dir: "rtl", class: input_class %>
    <p class="text-xs text-gray-500 mt-1"><%= t("admin.delivery_areas.fields.name_ar_hint") %></p>
  </div>

  <div>
    <%= f.label :fee_pounds, t("admin.delivery_areas.fields.fee"), class: label_class %>
    <%# type="text", not "number": a native number input rejects Arabic-Indic digits. %>
    <%= f.text_field :fee_pounds, inputmode: "decimal", autocomplete: "off",
          data: { controller: "arabic-numerals", action: "input->arabic-numerals#normalize" },
          class: "w-40 rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" %>
    <p class="text-xs text-gray-500 mt-1"><%= t("admin.delivery_areas.fields.fee_hint") %></p>
  </div>

  <div>
    <%= f.label :position, t("admin.delivery_areas.fields.position"), class: label_class %>
    <%= f.text_field :position, inputmode: "numeric", autocomplete: "off",
          data: { controller: "arabic-numerals", action: "input->arabic-numerals#normalize" },
          class: "w-24 rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.check_box :active, class: "w-4 h-4 text-amber-600 border-gray-300 rounded" %>
    <%= f.label :active, t("admin.delivery_areas.fields.active"), class: "text-sm font-semibold text-gray-700" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit t("actions.save"), class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer" %>
    <%= link_to t("actions.cancel"), admin_location_delivery_areas_path(location),
          class: "inline-flex items-center text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
