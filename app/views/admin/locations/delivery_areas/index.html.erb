<% content_for :title, t("admin.delivery_areas.title") %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% field_class = "w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" %>
<% icon_btn_class = "inline-flex items-center justify-center px-3 h-8 rounded-lg text-sm font-semibold text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors" %>

<div class="max-w-5xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <p class="text-sm text-gray-500 mb-1">
        <%= link_to t("admin.locations.title"), admin_locations_path, class: "hover:underline" %> /
        <%= link_to @location.name, admin_location_path(@location), class: "hover:underline" %> /
      </p>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("admin.delivery_areas.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("admin.delivery_areas.description") %></p>
    </div>
    <% if policy(DeliveryArea).create? %>
      <%= link_to new_admin_location_delivery_area_path(@location),
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" do %>
        <span aria-hidden="true">+</span> <%= t("admin.delivery_areas.new_button") %>
      <% end %>
    <% end %>
  </div>

  <% unless @location.online_ordering_enabled? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 mb-6 text-sm text-amber-900">
      <%= t("admin.delivery_areas.online_ordering_off") %>
      <%= link_to t("admin.delivery_areas.turn_on"), edit_admin_location_path(@location), class: "font-semibold underline" %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white p-5 mb-6">
    <%= form_with url: admin_location_delivery_areas_path(@location), method: :get, class: "flex flex-wrap items-end gap-4" do %>
      <%= hidden_field_tag :sort, @sort %>
      <%= hidden_field_tag :dir, @direction %>
      <div class="flex-1 min-w-[12rem]">
        <%= label_tag :q, t("admin.delivery_areas.filters.search"), class: label_class %>
        <%= search_field_tag :q, @search, class: field_class, placeholder: t("admin.delivery_areas.filters.search_placeholder") %>
      </div>
      <div class="w-44">
        <%= label_tag :status, t("admin.delivery_areas.filters.status"), class: label_class %>
        <%= select_tag :status,
              options_for_select([[t("actions.all"), ""],
                                  [t("admin.delivery_areas.status.active"), "active"],
                                  [t("admin.delivery_areas.status.inactive"), "inactive"]], @status),
              class: field_class %>
      </div>
      <div class="flex gap-2">
        <%= submit_tag t("actions.apply"), name: nil, class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-4 py-2 rounded-xl cursor-pointer" %>
        <% if @filtered %>
          <%= link_to t("actions.clear"), admin_location_delivery_areas_path(@location),
                class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-3 py-2" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @delivery_areas.any? %>
    <% sort_opts = { sort: @sort, direction: @direction } %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[600px]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start w-16"><%= sort_header_link(t("admin.delivery_areas.fields.position"), :position, **sort_opts) %></th>
              <th class="p-3 text-start"><%= sort_header_link(t("admin.delivery_areas.fields.name"), :name, **sort_opts) %></th>
              <th class="p-3 text-end">
                <div class="flex justify-end"><%= sort_header_link(t("admin.delivery_areas.fields.fee"), :fee_cents, **sort_opts) %></div>
              </th>
              <th class="p-3 text-start"><%= sort_header_link(t("admin.delivery_areas.fields.active"), :active, **sort_opts) %></th>
              <th class="p-3 pe-5 text-end"><span class="sr-only"><%= t("customers.table.actions") %></span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 table-zebra">
            <% @delivery_areas.each do |area| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5 tabular-nums text-gray-500"><%= area.position %></td>
                <td class="p-3">
                  <%= link_to area.name, edit_admin_location_delivery_area_path(@location, area),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                  <% if area.name_ar.present? %>
                    <div class="text-xs text-gray-500" dir="rtl"><%= area.name_ar %></div>
                  <% end %>
                </td>
                <td class="p-3 text-end tabular-nums"><%= format_amount(area.fee_cents) %></td>
                <td class="p-3">
                  <% if area.active? %>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-green-50 text-green-800 border border-green-200"><%= t("admin.delivery_areas.status.active") %></span>
                  <% else %>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 border border-gray-200"><%= t("admin.delivery_areas.status.inactive") %></span>
                  <% end %>
                </td>
                <td class="p-3 pe-5">
                  <div class="flex justify-end gap-1">
                    <% if policy(area).update? %>
                      <%= link_to t("actions.edit"), edit_admin_location_delivery_area_path(@location, area), class: icon_btn_class %>
                    <% end %>
                    <% if policy(area).destroy? %>
                      <%= button_to t("actions.delete"), admin_location_delivery_area_path(@location, area), method: :delete,
                            form: { data: { turbo_confirm: t("admin.delivery_areas.delete_confirm", name: area.name) } },
                            class: "#{icon_btn_class} hover:bg-red-50 hover:text-red-700" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </section>
  <% else %>
    <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center text-sm text-gray-500">
      <%= @filtered ? t("admin.delivery_areas.empty_filtered") : t("admin.delivery_areas.empty") %>
    </div>
  <% end %>
</div>
