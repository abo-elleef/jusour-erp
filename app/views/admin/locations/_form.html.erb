<%= form_with model: [:admin, location], class: "space-y-5" do |f| %>
  <% if location.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-200 p-4">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% location.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("admin.locations.fields.name"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none", required: true %>
  </div>

  <div>
    <%= f.label :location_type, t("admin.locations.fields.location_type"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.select :location_type,
          Location::TYPES.map { |t_val| [I18n.t("admin.locations.type_#{t_val}"), t_val] },
          {},
          class: "w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" %>
  </div>

  <div>
    <%= f.label :address, t("admin.locations.fields.address"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_area :address, rows: 2, class: "w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none resize-none" %>
  </div>

  <div>
    <%= f.label :phone, t("admin.locations.fields.phone"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.telephone_field :phone, class: "w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.check_box :active, class: "w-4 h-4 text-amber-600 border-gray-300 rounded" %>
    <%= f.label :active, t("admin.locations.fields.active"), class: "text-sm font-semibold text-gray-700" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "inline-flex items-center bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer" %>
    <%= link_to t("actions.cancel"), admin_locations_path,
          class: "inline-flex items-center text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl transition-colors" %>
  </div>
<% end %>
