<div class="max-w-4xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <p class="text-sm text-gray-500 mb-1">
        <%= link_to t("admin.locations.title"), admin_locations_path, class: "hover:underline" %> /
        <%= link_to @location.name, admin_location_path(@location), class: "hover:underline" %> /
      </p>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("admin.locations.menu_items_title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("admin.locations.menu_items_description") %></p>
    </div>
    <%= form_with url: bulk_update_admin_location_menu_items_path(@location), method: :post, class: "inline-flex" do %>
      <%= hidden_field_tag :available, true %>
      <%= button_tag t("admin.locations.bulk_enable_all"), type: "submit",
            class: "inline-flex items-center bg-white border border-gray-200 text-gray-700 text-sm font-semibold px-4 py-2 rounded-xl hover:bg-gray-50 transition-colors" %>
    <% end %>
  </div>

  <% @categories.each do |category| %>
    <% next if category.menu_items.empty? %>
    <%= render "admin/locations/menu_items/category_section",
          location: @location,
          category: category,
          location_menu_items_map: @location_menu_items_map %>
  <% end %>
</div>
