<%# The "Most sold" row: where it shows (register, online menu — which the call
    center orders from too — both or neither) and the items pinned to its start.
    The rest of the row is filled from the last 14 days of sales
    (Menus::TopSellerRow). Pins are picked from what this branch sells. %>
<% pin_options = location.persisted? ? MenuItem.available_at_location(location).includes(:category).ordered.to_a : [] %>
<% pinned = MenuItem.where(id: location.top_seller_pinned_item_ids).index_by(&:id)
     .values_at(*location.top_seller_pinned_item_ids).compact %>
<% pickable_ids = pin_options.map(&:id) %>
<% pin_label = ->(item) { item.category ? "#{item.name} — #{item.category.name}" : item.name } %>
<fieldset class="rounded-xl border border-stone-200 p-4 space-y-3" id="top-sellers-settings">
  <legend class="px-1 text-sm font-bold text-gray-900"><%= t("admin.locations.top_sellers.heading") %></legend>
  <p class="text-xs text-gray-500"><%= t("admin.locations.top_sellers.hint", count: Location::TOP_SELLERS_ROW_SIZE) %></p>

  <div>
    <p class="text-sm font-semibold text-gray-700"><%= t("admin.locations.top_sellers.show_on") %></p>
    <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
      <label class="inline-flex items-center gap-2 text-sm text-gray-700">
        <%= f.check_box :pos_top_sellers_enabled, class: "w-4 h-4 text-amber-600 border-gray-300 rounded" %>
        <%= t("admin.locations.top_sellers.on_pos") %>
      </label>
      <label class="inline-flex items-center gap-2 text-sm text-gray-700">
        <%= f.check_box :online_top_sellers_enabled, class: "w-4 h-4 text-amber-600 border-gray-300 rounded" %>
        <%= t("admin.locations.top_sellers.on_online") %>
      </label>
    </div>
    <p class="text-xs text-gray-500 mt-1"><%= t("admin.locations.top_sellers.on_online_hint") %></p>
  </div>

  <div data-controller="top-seller-pins"
       data-top-seller-pins-max-value="<%= Location::TOP_SELLERS_ROW_SIZE %>"
       data-top-seller-pins-field-name-value="location[top_seller_pinned_item_ids][]"
       data-top-seller-pins-button-labels-value="<%= { up: t("admin.locations.top_sellers.move_up"), down: t("admin.locations.top_sellers.move_down"), remove: t("actions.remove") }.to_json %>"
       data-top-seller-pins-labels-value="<%= pin_options.to_h { |item| [item.id, pin_label.call(item)] }.to_json %>">
    <p class="text-sm font-semibold text-gray-700"><%= t("admin.locations.top_sellers.pinned") %></p>
    <p class="text-xs text-gray-500 mt-0.5"><%= t("admin.locations.top_sellers.pinned_hint") %></p>
    <%# Always sent, so removing every pin still saves an empty list. %>
    <%= hidden_field_tag "location[top_seller_pinned_item_ids][]", "", id: nil %>

    <ol class="mt-2 space-y-1.5" data-top-seller-pins-target="list">
      <% pinned.each do |item| %>
        <li class="flex items-center gap-2 rounded-lg border border-stone-200 bg-white px-3 py-2 text-sm" data-top-seller-pins-target="row">
          <%= hidden_field_tag "location[top_seller_pinned_item_ids][]", item.id, id: nil %>
          <span class="w-6 shrink-0 text-xs font-semibold text-gray-400 tabular-nums" data-position></span>
          <span class="flex-1 min-w-0 truncate text-gray-900"><%= pin_label.call(item) %></span>
          <% unless pickable_ids.include?(item.id) %>
            <span class="shrink-0 text-xs text-amber-700"><%= t("admin.locations.top_sellers.not_sold_here") %></span>
          <% end %>
          <button type="button" class="shrink-0 rounded px-1.5 text-gray-500 hover:bg-stone-100" data-action="top-seller-pins#up" aria-label="<%= t("admin.locations.top_sellers.move_up") %>">↑</button>
          <button type="button" class="shrink-0 rounded px-1.5 text-gray-500 hover:bg-stone-100" data-action="top-seller-pins#down" aria-label="<%= t("admin.locations.top_sellers.move_down") %>">↓</button>
          <button type="button" class="shrink-0 rounded px-1.5 text-red-600 hover:bg-red-50" data-action="top-seller-pins#remove" aria-label="<%= t("actions.remove") %>">✕</button>
        </li>
      <% end %>
    </ol>
    <p class="mt-2 text-xs text-gray-400 <%= "hidden" if pinned.any? %>" data-top-seller-pins-target="empty"><%= t("admin.locations.top_sellers.no_pins") %></p>

    <% if location.persisted? %>
      <div class="mt-2 max-w-md" data-top-seller-pins-target="picker"
           data-searchable-select-options="<%= pin_options.map { |item| { value: item.id, label: pin_label.call(item) } }.to_json %>">
        <div class="relative"
             data-controller="searchable-select"
             data-searchable-select-no-results="<%= t("shared.searchable_select.no_results") %>"
             data-action="searchable-select:change->top-seller-pins#add">
          <input type="hidden" data-searchable-select-target="hidden">
          <input type="text" autocomplete="off" spellcheck="false" role="combobox"
                 aria-expanded="false" aria-autocomplete="list"
                 placeholder="<%= t("admin.locations.top_sellers.add_placeholder") %>"
                 class="w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                 data-searchable-select-target="input"
                 data-action="input->searchable-select#filter focus->searchable-select#open keydown->searchable-select#keydown" />
          <ul data-searchable-select-target="menu" role="listbox"
              class="hidden overflow-auto rounded-xl border border-gray-200 bg-white shadow-lg py-1"></ul>
        </div>
      </div>
      <p class="mt-1 text-xs text-amber-700 hidden" data-top-seller-pins-target="full"><%= t("admin.locations.top_sellers.full", count: Location::TOP_SELLERS_ROW_SIZE) %></p>
    <% else %>
      <p class="mt-2 text-xs text-gray-500"><%= t("admin.locations.top_sellers.save_first") %></p>
    <% end %>
  </div>
</fieldset>
