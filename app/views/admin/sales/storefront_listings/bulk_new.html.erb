<% content_for :title, t("sales.storefront_listings.bulk_title") %>

<div class="max-w-5xl">
  <div class="mb-4">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("sales.storefront_listings.bulk_title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("sales.storefront_listings.bulk_description") %></p>
  </div>

  <%= form_with url: bulk_new_admin_sales_storefront_listings_path, method: :get, class: "flex flex-wrap items-center gap-3 mb-4" do %>
    <input type="search" name="q" value="<%= @query %>" placeholder="<%= t("sales.storefront_listings.search_placeholder") %>"
           class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 w-64">
    <select name="category_id" onchange="this.form.submit()" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5">
      <option value=""><%= t("sales.storefront_listings.all_categories") %></option>
      <% @categories.each do |category| %>
        <option value="<%= category.id %>" <%= "selected" if @category_id == category.id %>><%= category.name %></option>
      <% end %>
    </select>
    <button type="submit" class="text-sm font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-lg border border-gray-200"><%= t("actions.search") %></button>
  <% end %>

  <% if @ingredients.any? %>
    <%= form_with url: bulk_create_admin_sales_storefront_listings_path, method: :post do %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 w-10">
                <input type="checkbox" aria-label="<%= t("sales.storefront_listings.select_all") %>"
                       onchange="this.closest('table').querySelectorAll('input[name=\'ingredient_ids[]\']').forEach(cb => cb.checked = this.checked)"
                       class="rounded border-gray-300 text-amber-600">
              </th>
              <th class="p-3"><%= t("sales.storefront_listings.table.product") %></th>
              <th class="p-3"><%= t("sales.storefront_listings.table.category") %></th>
              <th class="p-3 pe-5 text-end"><%= t("sales.storefront_listings.table.price") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @ingredients.each do |ingredient| %>
              <tr class="hover:bg-gray-50">
                <td class="p-3 ps-5">
                  <%= check_box_tag "ingredient_ids[]", ingredient.id, false, id: "ingredient_#{ingredient.id}",
                        class: "rounded border-gray-300 text-amber-600" %>
                </td>
                <td class="p-3">
                  <label for="ingredient_<%= ingredient.id %>" class="cursor-pointer">
                    <span class="font-medium text-gray-900"><%= ingredient.name %></span>
                    <span class="text-xs text-gray-500">· <%= ingredient.code %></span>
                  </label>
                </td>
                <td class="p-3 text-gray-700"><%= ingredient.ingredient_category.name %></td>
                <td class="p-3 pe-5 text-end tabular-nums <%= ingredient.selling_price_cents.positive? ? 'text-gray-700' : 'text-gray-400' %>">
                  <%= ingredient.selling_price_cents.positive? ? format_amount(ingredient.selling_price_cents) : t("sales.storefront_listings.no_price") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @total_count > @ingredients.size %>
          <p class="px-5 py-3 border-t border-gray-100 text-xs text-gray-500">
            <%= t("sales.storefront_listings.bulk_truncated", shown: @ingredients.size, total: @total_count) %>
          </p>
        <% end %>
      </section>
      <div class="mt-4 flex items-center gap-3">
        <%= submit_tag t("sales.storefront_listings.bulk_submit"),
              class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm" %>
        <%= link_to t("actions.cancel"), admin_sales_storefront_listings_path,
              class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl" %>
      </div>
    <% end %>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.storefront_listings.all_listed_title") %></p>
      <p class="text-gray-500 text-sm"><%= t("sales.storefront_listings.all_listed_hint") %></p>
    </section>
  <% end %>
</div>
