<%# locals: listing, ingredient_options: nil %>
<% ingredient_options = local_assigns[:ingredient_options] %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% hint_class = "text-xs text-gray-500 mt-1" %>

<%= form_with model: [:admin, :sales, listing], class: "space-y-6",
      data: (ingredient_options ? { searchable_select_options: ingredient_options.to_json } : {}) do |f| %>
  <% if listing.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= listing.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.storefront_listings.form.product_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.storefront_listings.form.product_hint") %></p>
    </div>
    <div class="p-5 space-y-5">
      <% if listing.persisted? %>
        <% ingredient = listing.ingredient %>
        <div class="rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3 text-sm">
          <p class="font-semibold text-gray-900">
            <% if current_user.can?("inventory:view") %>
              <%= link_to ingredient.name, admin_inventory_ingredient_path(ingredient), class: "hover:text-amber-700" %>
            <% else %>
              <%= ingredient.name %>
            <% end %>
            <span class="font-normal text-gray-500">· <%= ingredient.code %> · <%= ingredient.ingredient_category.name %></span>
          </p>
          <p class="text-gray-600 mt-1 tabular-nums">
            <%= t("sales.storefront_listings.form.selling_price") %>:
            <%= format_amount(ingredient.selling_price_cents) %><% if listing.unit_label.present? %> / <%= listing.unit_label %><% end %>
          </p>
        </div>
      <% else %>
        <div>
          <%= f.label :ingredient_id, t("sales.storefront_listings.form.ingredient"), class: label_class %>
          <%= render "shared/searchable_select", form: f, field: :ingredient_id, selected: listing.ingredient_id,
                placeholder: t("sales.storefront_listings.form.ingredient_placeholder"), input_class: pos_input_class %>
          <p class="<%= hint_class %>"><%= t("sales.storefront_listings.form.ingredient_hint") %></p>
        </div>
      <% end %>
      <div>
        <%= f.label :title, t("sales.storefront_listings.form.title"), class: label_class %>
        <%= f.text_field :title, class: pos_input_class, maxlength: 160 %>
        <p class="<%= hint_class %>"><%= t("sales.storefront_listings.form.title_hint") %></p>
      </div>
      <div>
        <%= f.label :description, t("sales.storefront_listings.form.description"), class: label_class %>
        <%= f.text_area :description, rows: 6, class: pos_input_class %>
      </div>
      <% if listing.persisted? %>
        <div>
          <%= f.label :slug, t("sales.storefront_listings.form.slug"), class: label_class %>
          <%= f.text_field :slug, class: pos_input_class, spellcheck: false %>
          <p class="<%= hint_class %>"><%= t("sales.storefront_listings.form.slug_hint") %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.storefront_listings.form.photos_heading") %></h2>
      <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.storefront_listings.form.photos_hint", count: StorefrontListing::MAX_IMAGES) %></p>
    </div>
    <div class="p-5 space-y-4">
      <% if listing.persisted? && listing.images.attached? %>
        <ul class="flex flex-wrap gap-3">
          <% listing.images.select(&:persisted?).each_with_index do |image, index| %>
            <li class="relative">
              <%= image_tag image.variant(:thumb), alt: "", class: "h-24 w-24 rounded-xl border border-gray-200 object-cover" %>
              <% if index.zero? %>
                <span class="absolute start-1 top-1 rounded-md bg-gray-900/80 px-1.5 py-0.5 text-[10px] font-semibold text-white"><%= t("sales.storefront_listings.form.cover") %></span>
              <% end %>
              <%= button_tag t("actions.remove"), type: "submit", form: "remove-image-#{image.id}",
                    class: "mt-1 block w-full text-[11px] font-semibold text-red-700 hover:bg-red-50 rounded-lg py-1" %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <%= f.file_field :images, multiple: true, accept: Storefront::IMAGE_CONTENT_TYPES.join(","),
            class: "text-sm text-gray-600 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200" %>
    </div>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.storefront_listings.form.display_heading") %></h2>
    </div>
    <div class="p-5 space-y-5">
      <label class="flex items-start gap-3 cursor-pointer">
        <%= f.check_box :published, class: "mt-0.5 rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
        <span>
          <span class="block text-sm font-semibold text-gray-900"><%= t("sales.storefront_listings.form.published") %></span>
          <span class="block text-xs text-gray-500 mt-0.5"><%= t("sales.storefront_listings.form.published_hint") %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 cursor-pointer">
        <%= f.check_box :featured, class: "mt-0.5 rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
        <span>
          <span class="block text-sm font-semibold text-gray-900"><%= t("sales.storefront_listings.form.featured") %></span>
          <span class="block text-xs text-gray-500 mt-0.5"><%= t("sales.storefront_listings.form.featured_hint") %></span>
        </span>
      </label>
      <div class="max-w-[10rem]">
        <%= f.label :position, t("sales.storefront_listings.form.position"), class: label_class %>
        <%= f.text_field :position, inputmode: "numeric", class: pos_input_class,
              data: { controller: "arabic-numerals", action: "input->arabic-numerals#normalize" } %>
        <p class="<%= hint_class %>"><%= t("sales.storefront_listings.form.position_hint") %></p>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit listing.persisted? ? t("actions.save_changes") : t("sales.storefront_listings.new_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm" %>
    <%= link_to t("actions.cancel"), admin_sales_storefront_listings_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl" %>
  </div>
<% end %>

<%# Image-remove buttons above submit these, so they work from inside the main
    form without nesting forms. %>
<% if listing.persisted? %>
  <% listing.images.select(&:persisted?).each do |image| %>
    <%= form_with url: remove_image_admin_sales_storefront_listing_path(listing, attachment_id: image.id), method: :delete,
          id: "remove-image-#{image.id}", class: "hidden",
          data: { turbo_confirm: t("sales.storefront_listings.form.remove_photo_confirm") } do %>
    <% end %>
  <% end %>
<% end %>
