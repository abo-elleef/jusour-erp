<% content_for :title, t("sales.storefront_listings.new_title") %>

<div class="max-w-3xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-6"><%= t("sales.storefront_listings.new_title") %></h1>
  <% if @ingredient_options.empty? %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.storefront_listings.all_listed_title") %></p>
      <p class="text-gray-500 text-sm"><%= t("sales.storefront_listings.all_listed_hint") %></p>
    </section>
  <% else %>
    <%= render "form", listing: @listing, ingredient_options: @ingredient_options %>
  <% end %>
</div>
