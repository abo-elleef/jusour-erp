<% content_for :title, @listing.display_title %>

<div class="max-w-3xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @listing.display_title %></h1>
    <div class="flex flex-wrap gap-2">
      <% storefront = Storefront.first %>
      <% if storefront&.enabled? && @listing.published? && @listing.ingredient.active? %>
        <%= link_to t("sales.storefront_listings.view_on_site"),
              public_storefront_product_path(company_slug: Current.company.slug, listing_slug: @listing.slug),
              target: "_blank", rel: "noopener",
              class: "inline-flex text-sm font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2 rounded-xl border border-amber-200" %>
      <% end %>
      <%= button_to t("sales.storefront_listings.remove_button"), admin_sales_storefront_listing_path(@listing), method: :delete,
            class: "inline-flex text-sm font-semibold text-red-700 hover:bg-red-50 px-4 py-2 rounded-xl border border-red-200",
            form: { data: { turbo_confirm: t("sales.storefront_listings.remove_confirm") } } %>
    </div>
  </div>
  <%= render "form", listing: @listing %>
</div>
