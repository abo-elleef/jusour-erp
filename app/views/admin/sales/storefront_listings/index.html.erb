<% content_for :title, t("sales.storefront_listings.title") %>
<% filter_params = { category_id: @category_id, q: @query.presence, sort: params[:sort], dir: params[:dir] }.compact %>
<% inventory_links = current_user.can?("inventory:view") %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-gray-900"><%= t("sales.storefront_listings.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("sales.storefront_listings.description") %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("sales.storefront_listings.settings_button"), admin_sales_storefront_path,
            class: "inline-flex items-center bg-white hover:bg-gray-50 border border-gray-200 text-gray-800 text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <%= link_to t("sales.storefront_listings.bulk_button"), bulk_new_admin_sales_storefront_listings_path,
            class: "inline-flex items-center bg-white hover:bg-gray-50 border border-gray-200 text-gray-800 text-sm font-semibold px-4 py-2.5 rounded-xl" %>
      <%= link_to new_admin_sales_storefront_listing_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm" do %>
        <span aria-hidden="true">+</span> <%= t("sales.storefront_listings.new_button") %>
      <% end %>
    </div>
  </div>

  <% if @storefront.nil? || !@storefront.enabled? %>
    <div class="mb-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <%= t("sales.storefront_listings.site_off_html", link: link_to(t("sales.storefront_listings.site_off_link"), admin_sales_storefront_path, class: "font-semibold underline")) %>
    </div>
  <% end %>

  <div class="flex flex-wrap gap-1 mb-2 border-b border-gray-200">
    <% [[nil, t("actions.all"), @all_count], ["published", t("sales.storefront_listings.statuses.published"), @published_count],
        ["hidden", t("sales.storefront_listings.statuses.hidden"), @hidden_count]].each do |status, label, count| %>
      <%= link_to admin_sales_storefront_listings_path(**filter_params, status: status), class: admin_section_tab_class(@status == status) do %>
        <%= label %><%= admin_tab_count(count, active: @status == status) %>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: admin_sales_storefront_listings_path, method: :get, class: "flex flex-wrap items-center gap-3 mb-4" do %>
    <%= hidden_field_tag :status, @status if @status %>
    <input type="search" name="q" value="<%= @query %>" placeholder="<%= t("sales.storefront_listings.search_placeholder") %>"
           class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 w-64">
    <select name="category_id" onchange="this.form.submit()" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5">
      <option value=""><%= t("sales.storefront_listings.all_categories") %></option>
      <% @categories.each do |category| %>
        <option value="<%= category.id %>" <%= "selected" if @category_id == category.id %>><%= category.name %></option>
      <% end %>
    </select>
    <button type="submit" class="text-sm font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-lg border border-gray-200"><%= t("actions.search") %></button>
    <% if @query.present? || @category_id %>
      <%= link_to t("actions.clear"), admin_sales_storefront_listings_path(status: @status), class: "text-sm text-gray-500 hover:text-gray-900" %>
    <% end %>
  <% end %>

  <% if @listings.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[52rem]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 w-16"><span class="sr-only"><%= t("sales.storefront_listings.table.photo") %></span></th>
              <th class="p-3"><%= sort_header_link(t("sales.storefront_listings.table.product"), "name", sort: @sort, direction: @direction) %></th>
              <th class="p-3"><%= sort_header_link(t("sales.storefront_listings.table.category"), "category", sort: @sort, direction: @direction) %></th>
              <th class="p-3 text-end"><%= sort_header_link(t("sales.storefront_listings.table.price"), "price", sort: @sort, direction: @direction) %></th>
              <th class="p-3"><%= t("sales.storefront_listings.table.status") %></th>
              <th class="p-3 text-end"><%= sort_header_link(t("sales.storefront_listings.table.position"), "position", sort: @sort, direction: @direction) %></th>
              <th class="p-3"><%= sort_header_link(t("sales.storefront_listings.table.updated"), "updated_at", sort: @sort, direction: @direction) %></th>
              <th class="p-3 pe-5 text-end"><%= t("sales.storefront_listings.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @listings.each do |listing| %>
              <% ingredient = listing.ingredient %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5">
                  <% if (image = listing.cover_image) %>
                    <%= image_tag image.variant(:thumb), alt: "", loading: "lazy", class: "h-10 w-10 rounded-lg object-cover border border-gray-200" %>
                  <% else %>
                    <div class="h-10 w-10 rounded-lg bg-gray-100 border border-gray-200" title="<%= t("sales.storefront_listings.no_photo") %>"></div>
                  <% end %>
                </td>
                <td class="p-3">
                  <%= link_to listing.display_title, edit_admin_sales_storefront_listing_path(listing), class: "font-medium text-gray-900 hover:text-amber-700" %>
                  <p class="text-xs text-gray-500 mt-0.5">
                    <% if inventory_links %>
                      <%= link_to "#{ingredient.name} · #{ingredient.code}", admin_inventory_ingredient_path(ingredient), class: "hover:text-amber-700" %>
                    <% else %>
                      <%= ingredient.name %> · <%= ingredient.code %>
                    <% end %>
                    <% unless ingredient.active? %>
                      <span class="ms-1 text-red-700"><%= t("sales.storefront_listings.ingredient_inactive") %></span>
                    <% end %>
                  </p>
                </td>
                <td class="p-3 text-gray-700">
                  <% if inventory_links %>
                    <%= link_to ingredient.ingredient_category.name, admin_inventory_ingredient_category_path(ingredient.ingredient_category), class: "hover:text-amber-700" %>
                  <% else %>
                    <%= ingredient.ingredient_category.name %>
                  <% end %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700">
                  <%= format_amount(ingredient.selling_price_cents) %>
                  <% if listing.unit_label.present? %><span class="text-xs text-gray-400">/ <%= listing.unit_label %></span><% end %>
                </td>
                <td class="p-3">
                  <% if listing.published? %>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200"><%= t("sales.storefront_listings.statuses.published") %></span>
                  <% else %>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 border border-gray-200"><%= t("sales.storefront_listings.statuses.hidden") %></span>
                  <% end %>
                  <% if listing.featured? %>
                    <span class="ms-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-200"><%= t("sales.storefront_listings.featured") %></span>
                  <% end %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700"><%= listing.position %></td>
                <td class="p-3 text-gray-500 whitespace-nowrap"><%= l(listing.updated_at.to_date, format: :short) %></td>
                <td class="p-3 pe-5 text-end whitespace-nowrap">
                  <%= link_to t("actions.edit"), edit_admin_sales_storefront_listing_path(listing),
                        class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.storefront_listings.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("sales.storefront_listings.empty_hint") %></p>
      <%= link_to t("sales.storefront_listings.bulk_button"), bulk_new_admin_sales_storefront_listings_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl" %>
    </section>
  <% end %>
</div>
