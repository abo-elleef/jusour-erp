<% content_for :title, t("sales.credit_notes.title") %>

<div class="max-w-full">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("sales.credit_notes.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("sales.credit_notes.description") %></p>
    </div>
    <%= link_to new_admin_sales_credit_note_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("sales.credit_notes.new_button") %>
    <% end %>
  </div>

  <% if @credit_notes.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5"><%= t("sales.customer_invoices.table.number") %></th>
            <th class="p-3"><%= t("sales.customer_invoices.table.customer") %></th>
            <th class="p-3"><%= t("sales.customer_invoices.table.date") %></th>
            <th class="p-3"><%= t("sales.customer_invoices.table.status") %></th>
            <th class="p-3 text-end pe-5"><%= t("sales.customer_invoices.table.total") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @credit_notes.each do |cn| %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5"><%= link_to cn.credit_note_number, admin_sales_credit_note_path(cn), class: "font-semibold text-amber-700 hover:text-amber-800 tabular-nums" %></td>
              <td class="p-3 text-gray-700"><%= cn.customer.display_name %></td>
              <td class="p-3 text-gray-600 tabular-nums"><%= l(cn.credit_note_date, format: :long) %></td>
              <td class="p-3">
                <% if cn.historical? %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-300"><%= t("sales.customer_invoices.statuses.historical") %></span>
                <% elsif cn.confirmed? %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200"><%= t("sales.customer_invoices.statuses.confirmed") %></span>
                <% elsif cn.void? %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-red-50 text-red-700 border border-red-200"><%= t("sales.customer_invoices.statuses.void") %></span>
                <% else %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200"><%= t("sales.customer_invoices.statuses.draft") %></span>
                <% end %>
              </td>
              <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"><%= format_money(cn.total_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.credit_notes.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("sales.credit_notes.empty_hint") %></p>
      <%= link_to t("sales.credit_notes.new_button"), new_admin_sales_credit_note_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl" %>
    </section>
  <% end %>
</div>
