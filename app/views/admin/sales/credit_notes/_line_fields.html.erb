<%# locals: f (credit_note_lines fields builder) %>
<% input_class = pos_input_class %>
<% line = f.object %>
<% ingredient = line.ingredient || @ingredients.find { |i| i.id == line.ingredient_id } %>
<% unit_opts = ingredient ? ingredient.available_units.map { |u| [ingredient_unit_label(u), u] } : [] %>

<div class="px-5 py-4" data-customer-invoice-lines-target="row">
  <%= f.hidden_field :_destroy, value: false, data: { role: "destroy" } %>
  <%= f.hidden_field :id %>
  <div class="flex-1 min-w-0 lg:grid lg:grid-cols-12 lg:gap-3 lg:items-start space-y-3 lg:space-y-0">
    <div class="lg:col-span-5">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("sales.customer_invoices.form.product") %></label>
      <%= render "shared/searchable_select",
            form: f, field: :ingredient_id, selected: line.ingredient_id,
            placeholder: t("sales.customer_invoices.form.search_product"), input_class: input_class,
            html: { data: { action: "searchable-select:change->customer-invoice-lines#ingredientChanged" } } %>
    </div>
    <div class="lg:col-span-2">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("sales.customer_invoices.form.unit") %></label>
      <%= f.select :unit, options_for_select(unit_opts, line.unit.presence || ingredient&.unit),
            { include_blank: ingredient.nil? }, class: "#{input_class} appearance-none px-2", data: { role: "unit" } %>
    </div>
    <div class="lg:col-span-2">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("sales.customer_invoices.form.quantity") %></label>
      <%= f.number_field :quantity, step: 0.001, min: 0, placeholder: "0", class: input_class,
            data: { role: "qty", action: "input->customer-invoice-lines#recalc" } %>
    </div>
    <div class="lg:col-span-2">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5 lg:hidden"><%= t("sales.customer_invoices.form.unit_price") %></label>
      <%= f.number_field :unit_price_pounds, step: 0.01, min: 0, placeholder: "0.00", class: input_class,
            data: { role: "price", action: "input->customer-invoice-lines#recalc" } %>
    </div>
    <div class="lg:col-span-1 flex items-end lg:items-center justify-end lg:justify-between gap-2 lg:pt-2">
      <span class="hidden lg:inline text-sm tabular-nums text-gray-700 font-medium" data-role="line-total">0.00</span>
      <button type="button"
              class="inline-flex items-center justify-center w-9 h-9 text-red-700 hover:bg-red-50 rounded-xl border border-red-200 transition-colors"
              data-action="customer-invoice-lines#remove"
              title="<%= t("actions.remove") %>" aria-label="<%= t("actions.remove") %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>
</div>
