<%= turbo_frame_tag "report-leads_funnel" do %>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <%= t("sales.reports.leads.conversion_rate") %>
        <%= info_tooltip_icon(t("sales.reports.leads.conversion_rate_hint")) %>
      </p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= conversion_rate %>%</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <%= t("sales.reports.leads.avg_days_to_convert") %>
      </p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= average_days_to_convert %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.leads.total_created") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= total_created %></p>
    </div>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <p class="text-xs text-gray-500"><%= t("sales.reports.leads.funnel_hint") %></p>
    </div>
    <% if total_created.zero? %>
      <p class="p-8 text-center text-sm text-gray-500"><%= t("sales.reports.leads.empty") %></p>
    <% else %>
      <div class="p-5">
        <%= bar_chart rows.to_h { |r| [t("sales.leads.stages.#{r.stage}"), r.count] }, height: "220px", id: "leads-funnel-chart" %>
      </div>
    <% end %>
  </section>
<% end %>
