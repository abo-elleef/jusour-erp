<%= turbo_frame_tag "report-salesperson" do %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <p class="text-xs text-gray-500"><%= t("sales.reports.by_salesperson_hint") %></p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm" data-controller="sortable-table"
             data-sortable-table-storage-key-value="sales-reports-salesperson">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5 text-start w-10">#</th>
            <%= sortable_report_th t("sales.reports.salesperson"), "name", align: :start %>
            <%= sortable_report_th t("sales.reports.invoices"), "units", type: :number %>
            <%= sortable_report_th t("sales.reports.gross"), "revenue", type: :number, pe: true %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100" data-sortable-table-target="body">
          <% rows.each_with_index do |row, i| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="p-3 ps-5 text-gray-400" data-index-cell><%= i + 1 %></td>
              <td class="p-3 text-gray-800" data-sort-key="name">
                <%= row.name.presence || t("sales.reports.unattributed") %>
              </td>
              <td class="p-3 text-end tabular-nums text-gray-600" data-sort-key="units" data-sort-value="<%= row.units %>">
                <%= row.units %>
              </td>
              <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"
                  data-sort-key="revenue" data-sort-value="<%= row.revenue_cents %>">
                <%= format_money(row.revenue_cents) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
