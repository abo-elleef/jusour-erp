<% content_for :title, t("sales.reports.title") %>

<div class="max-w-7xl">
  <%= render "admin/sales/nav" %>

  <div class="mb-2">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("sales.reports.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("sales.reports.description") %></p>
  </div>

  <%# ── Audience: everyone / commercial-only / regular-only ─────────
      Every table below reads the same way for whichever lens is picked — a
      commercial account's bulk orders otherwise bury a doctor's own top spot. %>
  <div class="flex items-center gap-1 rounded-xl border border-gray-200 bg-white p-1 mb-6 w-fit">
    <% [[t("actions.all"), nil],
        [t("customers.form.types.commercial"), "commercial"],
        [t("customers.form.types.regular"), "regular"]].each do |label, value| %>
      <% active = @customer_type == value %>
      <%= link_to label, request.query_parameters.merge(customer_type: value).compact,
            class: "px-3.5 py-1.5 text-sm font-medium rounded-lg transition-colors " \
                   "#{active ? 'bg-amber-600 text-white' : 'text-gray-600 hover:bg-gray-50'}" %>
    <% end %>
  </div>

  <%= render "admin/accounting/date_range_form" %>

  <% s = @summary %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.net_sales") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= format_money(s[:net_sales_cents]) %></p>
      <p class="text-xs text-gray-500 mt-1">
        <%= t("sales.reports.gross_less_returns",
              gross: format_money(s[:gross_sales_cents]), returns: format_money(s[:returns_cents])) %>
      </p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.invoices") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= s[:invoice_count] %></p>
      <p class="text-xs text-gray-500 mt-1"><%= t("sales.reports.credit_notes_count", count: s[:credit_note_count]) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.customers") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= s[:customer_count] %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.average_invoice") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= format_money(s[:average_invoice_cents]) %></p>
    </div>
  </div>

  <% if s[:invoice_count].zero? && s[:credit_note_count].zero? %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.reports.empty_title") %></p>
      <p class="text-gray-500 text-sm"><%= t("sales.reports.empty_hint") %></p>
    </section>
  <% else %>
    <%# Each tab below is a lazy Turbo Frame (see reports_controller#render_section):
        its table is only computed and fetched once its panel is actually shown, not
        on every page load — by_product/by_customer alone can run into thousands of
        rows. Panels default to hidden in the raw HTML (except "product") so a lazy
        frame doesn't fire before the tabs controller has a chance to apply whichever
        tab was actually remembered; see tabs_controller.js. %>
    <div data-controller="tabs" data-tabs-storage-key-value="sales-reports">
      <div class="flex flex-wrap gap-1 mb-6 border-b border-gray-200">
        <button type="button" data-tabs-target="tab" data-action="tabs#switch" data-tabs-name-param="product"
                class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors">
          <%= t("sales.reports.by_product") %>
        </button>
        <button type="button" data-tabs-target="tab" data-action="tabs#switch" data-tabs-name-param="customer"
                class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors">
          <%= t("sales.reports.by_customer") %>
        </button>
        <button type="button" data-tabs-target="tab" data-action="tabs#switch" data-tabs-name-param="salesperson"
                class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors">
          <%= t("sales.reports.by_salesperson") %>
        </button>
        <% if @show_payment_method %>
          <button type="button" data-tabs-target="tab" data-action="tabs#switch" data-tabs-name-param="payment_method"
                  class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors">
            <%= t("sales.reports.by_payment_method") %>
          </button>
        <% end %>
        <button type="button" data-tabs-target="tab" data-action="tabs#switch" data-tabs-name-param="daily"
                class="px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors">
          <%= t("sales.reports.daily") %>
        </button>
      </div>

      <% sections = %w[product customer salesperson payment_method daily] %>
      <% sections.each do |section| %>
        <% next if section == "payment_method" && !@show_payment_method %>
        <div data-tabs-target="panel" data-tab-panel="<%= section %>" <%= "hidden" unless section == "product" %>>
          <%= turbo_frame_tag "report-#{section}",
                src: admin_sales_reports_path(request.query_parameters.merge(section: section)),
                loading: :lazy do %>
            <%= render "loading" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
