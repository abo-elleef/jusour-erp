<% content_for :title, t("sales.reports.title") %>

<div class="max-w-7xl">
  <%= render "admin/sales/nav" %>

  <div class="mb-2">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("sales.reports.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("sales.reports.description") %></p>
  </div>

  <%= render "admin/accounting/date_range_form" %>

  <% s = @report[:summary] %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.net_sales") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= format_money(s[:net_sales_cents]) %></p>
      <p class="text-xs text-gray-500 mt-1">
        <%= t("sales.reports.gross_less_returns",
              gross: format_money(s[:gross_sales_cents]), returns: format_money(s[:returns_cents])) %>
      </p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.invoices") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= s[:invoice_count] %></p>
      <p class="text-xs text-gray-500 mt-1"><%= t("sales.reports.credit_notes_count", count: s[:credit_note_count]) %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.customers") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= s[:customer_count] %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.reports.average_invoice") %></p>
      <p class="text-2xl font-bold tabular-nums mt-1 text-gray-900"><%= format_money(s[:average_invoice_cents]) %></p>
    </div>
  </div>

  <% if s[:invoice_count].zero? && s[:credit_note_count].zero? %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.reports.empty_title") %></p>
      <p class="text-gray-500 text-sm"><%= t("sales.reports.empty_hint") %></p>
    </section>
  <% else %>
    <%# ── By product ───────────────────────────────────────────── %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.reports.by_product") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.reports.by_product_hint") %></p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[36rem]">
          <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("sales.reports.product") %></th>
              <th class="p-3 text-end"><%= t("sales.reports.units") %></th>
              <th class="p-3 text-end"><%= t("sales.reports.gross") %></th>
              <th class="p-3 text-end"><%= t("sales.reports.returns") %></th>
              <th class="p-3 text-end pe-5"><%= t("sales.reports.net") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @report[:by_product].each do |row| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-3 ps-5">
                  <%= link_to row.name, admin_inventory_ingredient_path(row.key),
                        class: "text-gray-800 hover:text-amber-700 hover:underline" %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700"><%= number_with_precision(row.units, precision: 2, strip_insignificant_zeros: true) %></td>
                <td class="p-3 text-end tabular-nums text-gray-600"><%= format_money(row.revenue_cents) %></td>
                <td class="p-3 text-end tabular-nums <%= row.returns_cents.positive? ? 'text-red-600' : 'text-gray-300' %>">
                  <%= row.returns_cents.positive? ? "-#{format_money(row.returns_cents)}" : "—" %>
                </td>
                <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"><%= format_money(row.net_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <%# ── By customer ────────────────────────────────────────── %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.reports.by_customer") %></h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 ps-5 text-start"><%= t("sales.reports.customer") %></th>
                <th class="p-3 text-end"><%= t("sales.reports.invoices") %></th>
                <th class="p-3 text-end pe-5"><%= t("sales.reports.net") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @report[:by_customer].each do |row| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-3 ps-5">
                    <%= link_to row.name, admin_customer_path(row.key),
                          class: "text-gray-800 hover:text-amber-700 hover:underline" %>
                  </td>
                  <td class="p-3 text-end tabular-nums text-gray-600"><%= row.units %></td>
                  <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"><%= format_money(row.net_cents) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>

      <%# ── By salesperson ─────────────────────────────────────── %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.reports.by_salesperson") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.reports.by_salesperson_hint") %></p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 ps-5 text-start"><%= t("sales.reports.salesperson") %></th>
                <th class="p-3 text-end"><%= t("sales.reports.invoices") %></th>
                <th class="p-3 text-end pe-5"><%= t("sales.reports.gross") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @report[:by_salesperson].each do |row| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-3 ps-5 text-gray-800"><%= row.name.presence || t("sales.reports.unattributed") %></td>
                  <td class="p-3 text-end tabular-nums text-gray-600"><%= row.units %></td>
                  <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"><%= format_money(row.revenue_cents) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <%# ── By payment method ────────────────────────────────────── %>
    <% if @report[:by_payment_method].many? %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.reports.by_payment_method") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.reports.by_payment_method_hint") %></p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <tr>
                <th class="p-3 ps-5 text-start"><%= t("sales.reports.method") %></th>
                <th class="p-3 text-end"><%= t("sales.reports.invoices") %></th>
                <th class="p-3 text-end pe-5"><%= t("sales.reports.gross") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @report[:by_payment_method].each do |row| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-3 ps-5 text-gray-800"><%= t("sales.customer_invoices.payment_methods.#{row.name}") %></td>
                  <td class="p-3 text-end tabular-nums text-gray-600"><%= row.units %></td>
                  <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"><%= format_money(row.revenue_cents) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>

    <%# ── Day by day ───────────────────────────────────────────── %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.reports.daily") %></h2>
      </div>
      <% peak = @report[:daily].map { |d| d[:net_cents] }.max.to_i %>
      <div class="divide-y divide-gray-100">
        <% @report[:daily].reverse_each do |day| %>
          <div class="px-5 py-2.5 flex items-center gap-4">
            <span class="text-sm text-gray-600 tabular-nums w-28 shrink-0"><%= l(day[:date], format: :short) %></span>
            <div class="flex-1 bg-gray-100 rounded-full h-2 overflow-hidden">
              <div class="bg-amber-500 h-full rounded-full"
                   style="width: <%= peak.positive? ? ((day[:net_cents].to_f / peak) * 100).clamp(0, 100).round(1) : 0 %>%"></div>
            </div>
            <span class="text-sm font-semibold text-gray-900 tabular-nums w-32 text-end shrink-0"><%= format_money(day[:net_cents]) %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
