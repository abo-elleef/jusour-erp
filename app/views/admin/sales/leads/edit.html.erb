<% content_for :title, t("sales.leads.edit_title", name: @lead.name) %>

<div class="max-w-3xl">
  <%= link_to t("sales.leads.back"), admin_sales_lead_path(@lead), class: "text-sm text-gray-500 hover:text-gray-800 mb-4 inline-block" %>

  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("sales.leads.edit_title", name: @lead.name) %></h1>
    <%= render "pipeline_actions", lead: @lead %>
  </div>

  <%= render "form", lead: @lead %>
</div>
