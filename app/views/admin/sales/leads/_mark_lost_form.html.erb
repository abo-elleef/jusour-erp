<%# locals: lead %>
<details class="relative inline-block">
  <summary class="list-none px-4 py-2 text-sm font-semibold text-white bg-red-600 hover:bg-red-700 rounded-xl transition-colors cursor-pointer">
    <%= t("sales.leads.show.mark_lost") %>
  </summary>
  <div class="absolute z-10 mt-2 w-72 end-0 rounded-xl border border-gray-200 bg-white shadow-lg p-4">
    <%= form_with url: mark_lost_admin_sales_lead_path(lead), method: :post, class: "space-y-3" do %>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("sales.leads.show.lost_reason") %></label>
        <select name="lost_reason" required class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm">
          <% Lead::LOST_REASONS.each do |reason| %>
            <option value="<%= reason %>"><%= t("sales.leads.lost_reasons.#{reason}") %></option>
          <% end %>
        </select>
      </div>
      <div>
        <textarea name="lost_reason_note" rows="2" placeholder="<%= t("sales.leads.show.lost_reason_note_placeholder") %>"
                  class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm"></textarea>
      </div>
      <%= submit_tag t("sales.leads.show.mark_lost"),
            class: "w-full px-4 py-2 text-sm font-semibold text-white bg-red-600 hover:bg-red-700 rounded-xl transition-colors cursor-pointer" %>
    <% end %>
  </div>
</details>
