<% content_for :title, t("sales.leads.title") %>
<% tab_params = { assigned_user_id: @assigned_user_id, due_only: (1 if @due_only) } %>
<% all_active = @stage.nil? %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-4">
    <h1 class="text-xl font-bold tracking-tight text-gray-900" title="<%= t("sales.leads.description") %>">
      <%= t("sales.leads.title") %>
    </h1>
    <% if current_user.can?("leads:manage") %>
      <%= link_to new_admin_sales_lead_path,
            class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
        <span aria-hidden="true">+</span> <%= t("sales.leads.new_button") %>
      <% end %>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-1 mb-2 border-b border-gray-200">
    <%= link_to admin_sales_leads_path(**tab_params), class: admin_section_tab_class(all_active) do %>
      <%= t("actions.all") %><%= admin_tab_count(@all_count, active: all_active) %>
    <% end %>
    <% Lead::STAGES.each do |stage| %>
      <%= link_to admin_sales_leads_path(**tab_params, stage: stage), class: admin_section_tab_class(@stage == stage) do %>
        <%= t("sales.leads.stages.#{stage}") %><%= admin_tab_count(@stage_counts[stage], active: @stage == stage) %>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: admin_sales_leads_path, method: :get, class: "flex flex-wrap items-center justify-between gap-3 mb-4" do %>
    <%= hidden_field_tag :stage, @stage if @stage %>
    <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
      <%= check_box_tag :due_only, "1", @due_only, onchange: "this.form.submit()",
            class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
      <%= t("sales.leads.due_only_label") %>
      <%= admin_tab_count(@due_today_count, active: @due_only) %>
    </label>
    <select name="assigned_user_id" onchange="this.form.submit()"
            class="text-sm border border-gray-200 rounded-lg px-3 py-1.5">
      <option value=""><%= t("sales.leads.all_reps") %></option>
      <% @assignable_users.each do |user| %>
        <option value="<%= user.id %>" <%= "selected" if @assigned_user_id == user.id %>><%= user.name %></option>
      <% end %>
    </select>
  <% end %>

  <% if @leads.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[48rem]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5"><%= sort_header_link(t("sales.leads.table.name"), "name", sort: @sort, direction: @direction) %></th>
              <th class="p-3"><%= sort_header_link(t("sales.leads.table.stage"), "stage", sort: @sort, direction: @direction) %></th>
              <th class="p-3"><%= sort_header_link(t("sales.leads.table.assigned_to"), "assigned_user", sort: @sort, direction: @direction) %></th>
              <th class="p-3"><%= sort_header_link(t("sales.leads.table.follow_up"), "next_follow_up_at", sort: @sort, direction: @direction) %></th>
              <th class="p-3 pe-5"><%= sort_header_link(t("sales.leads.table.created"), "created_at", sort: @sort, direction: @direction) %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @leads.each do |lead| %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5">
                  <%= link_to lead.name, admin_sales_lead_path(lead),
                        class: "font-semibold text-amber-700 hover:text-amber-800" %>
                </td>
                <td class="p-3"><%= render "stage_badge", lead: lead %></td>
                <td class="p-3">
                  <%= link_to lead.assigned_user.name, admin_user_path(lead.assigned_user),
                        class: "text-gray-700 hover:text-gray-900 hover:underline" %>
                </td>
                <td class="p-3 text-gray-600 tabular-nums">
                  <% if lead.next_follow_up_at %>
                    <span class="<%= 'text-red-600 font-semibold' if lead.open? && lead.next_follow_up_at <= Date.current %>">
                      <%= l(lead.next_follow_up_at, format: :long) %>
                    </span>
                  <% else %>
                    <%= t("sales.leads.no_follow_up") %>
                  <% end %>
                </td>
                <td class="p-3 pe-5 text-gray-500 tabular-nums"><%= l(lead.created_at.to_date, format: :long) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "admin/accounting/pagination", pagy: @pagy %>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.leads.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("sales.leads.empty_hint") %></p>
      <% if current_user.can?("leads:manage") %>
        <%= link_to t("sales.leads.new_button"), new_admin_sales_lead_path,
              class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl transition-colors" %>
      <% end %>
    </section>
  <% end %>
</div>
