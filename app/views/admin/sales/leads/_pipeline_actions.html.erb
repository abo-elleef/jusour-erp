<%# locals: lead %>
<% if current_user.can?("leads:manage") && lead.open? %>
  <div class="flex flex-wrap gap-2 shrink-0">
    <%= button_to t("sales.leads.show.convert"), convert_admin_sales_lead_path(lead), method: :post,
          form: { data: { turbo_confirm: t("sales.leads.show.convert_confirm") } },
          class: "px-4 py-2 text-sm font-semibold text-white bg-green-600 hover:bg-green-700 rounded-xl transition-colors" %>
    <%= render "mark_lost_form", lead: lead %>
  </div>
<% end %>
