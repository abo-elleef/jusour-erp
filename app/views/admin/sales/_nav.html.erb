<% tabs = [
     [t("sales.nav.invoices"),     admin_sales_customer_invoices_path,   %w[customer_invoices]],
     [t("sales.nav.statements"),   admin_sales_customer_statements_path, %w[customer_statements]],
     [t("sales.nav.credit_notes"), admin_sales_credit_notes_path,        %w[credit_notes]],
     [t("sales.nav.price_tiers"),  admin_sales_price_tiers_path,         %w[price_tiers]]
   ] %>
<% if Current.company.feature_enabled?(:leads) && current_user.can?("leads:view") %>
  <% tabs << [t("sales.nav.leads"), admin_sales_leads_path, %w[leads]] %>
<% end %>
<% if Current.company.feature_enabled?(:leads) && current_user.can?("leads:reports") %>
  <% tabs << [t("sales.nav.lead_reports"), admin_sales_lead_reports_path, %w[lead_reports]] %>
<% end %>
<% tabs << [t("sales.nav.reports"), admin_sales_reports_path, %w[reports]] %>
<div class="flex flex-wrap gap-1 mb-6 border-b border-gray-200">
  <% tabs.each do |label, path, controllers| %>
    <% active = controllers.include?(controller_name) %>
    <%= link_to label, path,
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors #{active ? 'border-amber-600 text-amber-700' : 'border-transparent text-gray-500 hover:text-gray-800'}" %>
  <% end %>
</div>
