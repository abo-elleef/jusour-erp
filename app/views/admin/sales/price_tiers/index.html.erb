<% content_for :title, t("sales.price_tiers.title") %>

<div class="max-w-3xl">
  <%= render "admin/sales/nav" %>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t("sales.price_tiers.title") %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("sales.price_tiers.description") %></p>
    </div>
    <%= link_to new_admin_sales_price_tier_path,
          class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors shrink-0" do %>
      <span aria-hidden="true">+</span> <%= t("sales.price_tiers.new_button") %>
    <% end %>
  </div>

  <% if @tiers.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5"><%= t("sales.price_tiers.table.name") %></th>
            <th class="p-3 text-end"><%= t("sales.price_tiers.table.discount") %></th>
            <th class="p-3"><%= t("sales.price_tiers.table.status") %></th>
            <th class="p-3 pe-5 text-end"><%= t("sales.price_tiers.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @tiers.each do |tier| %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5 font-medium text-gray-900"><%= tier.name %></td>
              <td class="p-3 text-end tabular-nums text-gray-700"><%= tier.discount_percent %>%</td>
              <td class="p-3">
                <% if tier.active? %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200"><%= t("sales.price_tiers.active") %></span>
                <% else %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 border border-gray-200"><%= t("sales.price_tiers.inactive") %></span>
                <% end %>
              </td>
              <td class="p-3 pe-5 text-end whitespace-nowrap">
                <%= link_to t("actions.edit"), edit_admin_sales_price_tier_path(tier),
                      class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200" %>
                <%= button_to t("actions.remove"), admin_sales_price_tier_path(tier), method: :delete,
                      class: "inline-flex text-xs font-semibold text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-xl border border-red-200",
                      form: { class: "inline-block", data: { turbo_confirm: t("sales.price_tiers.delete_confirm") } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold mb-1"><%= t("sales.price_tiers.empty_title") %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t("sales.price_tiers.empty_hint") %></p>
      <%= link_to t("sales.price_tiers.new_button"), new_admin_sales_price_tier_path,
            class: "font-semibold text-amber-700 hover:bg-amber-50 px-4 py-2.5 rounded-xl" %>
    </section>
  <% end %>
</div>
