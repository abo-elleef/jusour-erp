<%# locals: tier %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<%= form_with model: [:admin, :sales, tier], class: "space-y-5 max-w-md" do |f| %>
  <% if tier.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <%= tier.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="p-5 space-y-5">
      <div>
        <%= f.label :name, t("sales.price_tiers.form.name"), class: label_class %>
        <%= f.text_field :name, class: pos_input_class, autofocus: true %>
      </div>
      <div>
        <%= f.label :discount_percent, t("sales.price_tiers.form.discount"), class: label_class %>
        <%= f.number_field :discount_percent, step: 0.01, min: 0, max: 100, class: pos_input_class %>
        <p class="text-xs text-gray-500 mt-1"><%= t("sales.price_tiers.form.discount_hint") %></p>
      </div>
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :active, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
        <span class="text-sm font-medium text-gray-900"><%= t("sales.price_tiers.form.active") %></span>
      </label>
    </div>
  </section>

  <div class="flex items-center gap-3">
    <%= f.submit tier.persisted? ? t("actions.save_changes") : t("sales.price_tiers.new_button"),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm" %>
    <%= link_to t("actions.cancel"), admin_sales_price_tiers_path,
          class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl" %>
  </div>
<% end %>
