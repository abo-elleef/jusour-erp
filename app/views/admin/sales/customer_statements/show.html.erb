<% content_for :title, @customer.display_name %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% bucket_labels = { not_due: t("sales.statements.buckets.not_due"),
                     days_1_30: t("sales.statements.buckets.days_1_30"),
                     days_31_60: t("sales.statements.buckets.days_31_60"),
                     days_61_90: t("sales.statements.buckets.days_61_90"),
                     days_90_plus: t("sales.statements.buckets.days_90_plus") } %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @customer.display_name %></h1>
      <p class="text-gray-600 text-sm mt-1">
        <%= t("sales.statements.balance_owed") %>:
        <span class="font-semibold text-amber-700 tabular-nums"><%= format_money(@statement.ledger_balance_cents) %></span>
        <% if @customer.price_tier %> · <%= @customer.price_tier.name %> (<%= @customer.effective_discount_percent %>%)<% end %>
      </p>
    </div>
    <%= link_to t("sales.statements.back"), admin_sales_customer_statements_path,
          class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
  </div>

  <%# Credit limits — the same rule that flags / blocks a sale at confirmation. %>
  <% balance = @statement.ledger_balance_cents %>
  <% credit_status = @customer.credit_status_for(balance) %>
  <% no_limit = t("sales.statements.credit.no_limit") %>
  <section class="rounded-2xl border bg-white mb-6 <%= { blocked: 'border-red-200', warning: 'border-amber-200' }.fetch(credit_status, 'border-gray-200') %>">
    <div class="px-5 py-3 border-b border-gray-100 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.statements.credit.heading") %></h2>
        <% if credit_status == :blocked %>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-lg border bg-red-50 text-red-700 border-red-200"><%= t("sales.statements.over_hard_limit") %></span>
        <% elsif credit_status == :warning %>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-lg border bg-amber-50 text-amber-700 border-amber-200"><%= t("sales.statements.over_warning_limit") %></span>
        <% end %>
      </div>
      <% if policy(@customer).update? %>
        <%= link_to t("sales.statements.credit.edit"), edit_admin_customer_path(@customer),
              class: "text-xs font-semibold text-amber-700 hover:text-amber-800 hover:underline" %>
      <% end %>
    </div>
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 px-5 py-4 text-sm">
      <div>
        <dt class="text-xs font-semibold text-gray-500"><%= t("customers.form.warning_limit") %></dt>
        <dd class="mt-1 font-semibold tabular-nums text-gray-900">
          <%= @customer.credit_warning_limit_cents ? format_money(@customer.credit_warning_limit_cents) : no_limit %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-gray-500"><%= t("customers.form.hard_limit") %></dt>
        <dd class="mt-1 font-semibold tabular-nums text-gray-900">
          <%= @customer.credit_hard_limit_cents ? format_money(@customer.credit_hard_limit_cents) : no_limit %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-gray-500"><%= t("sales.statements.credit.available") %></dt>
        <dd class="mt-1 font-semibold tabular-nums <%= credit_status == :blocked ? 'text-red-700' : 'text-gray-900' %>">
          <%= @customer.credit_hard_limit_cents ? format_money(@customer.credit_hard_limit_cents - balance) : no_limit %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-gray-500"><%= t("customers.form.terms_days") %></dt>
        <dd class="mt-1 font-semibold tabular-nums text-gray-900">
          <%= @customer.credit_terms_days.to_i.positive? ? t("sales.statements.credit.days", count: @customer.credit_terms_days) : t("sales.statements.credit.on_receipt") %>
        </dd>
      </div>
    </dl>
  </section>

  <%# Aging buckets %>
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6">
    <% @statement.buckets.each do |bucket, cents| %>
      <div class="bg-white rounded-2xl border border-gray-200 p-3">
        <p class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide"><%= bucket_labels[bucket] %></p>
        <p class="text-lg font-bold mt-1 tabular-nums <%= cents.positive? && bucket != :not_due ? 'text-red-700' : 'text-gray-900' %>"><%= format_money(cents) %></p>
      </div>
    <% end %>
  </div>

  <%# Payments are taken only by receipt voucher — oldest invoices first. %>
  <% if policy(Voucher).create? %>
    <section class="rounded-2xl border border-gray-200 bg-white mb-6 px-5 py-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.customer_invoices.show.record_payment") %></h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.customer_invoices.show.record_payment_hint") %></p>
      </div>
      <%= link_to t("sales.customer_invoices.show.receive_by_voucher_button"),
            new_admin_accounting_voucher_path(direction: Voucher::RECEIPT, party: "Customer:#{@customer.id}",
                                              settles: Admin::Accounting::VouchersController::OLDEST_FIRST),
            class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
    </section>
  <% end %>

  <%# Invoices %>
  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.statements.invoices") %></h2>
    </div>
    <% if @invoices.any? %>
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="p-3 ps-5"><%= t("sales.customer_invoices.table.number") %></th>
            <th class="p-3"><%= t("sales.customer_invoices.table.date") %></th>
            <th class="p-3"><%= t("sales.customer_invoices.table.status") %></th>
            <th class="p-3 text-end"><%= t("sales.customer_invoices.table.total") %></th>
            <th class="p-3 text-end pe-5"><%= t("sales.customer_invoices.table.balance") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @invoices.each do |inv| %>
            <tr class="hover:bg-gray-100 transition-colors">
              <td class="p-3 ps-5"><%= link_to inv.invoice_number, admin_sales_customer_invoice_path(inv), class: "font-semibold text-amber-700 hover:text-amber-800 tabular-nums" %></td>
              <td class="p-3 text-gray-600 tabular-nums"><%= l(inv.invoice_date, format: :long) %></td>
              <td class="p-3"><%= render "admin/sales/customer_invoices/status_badge", invoice: inv %></td>
              <td class="p-3 text-end tabular-nums text-gray-700"><%= format_money(inv.total_cents) %></td>
              <td class="p-3 text-end pe-5 tabular-nums font-semibold <%= inv.balance_due_cents.positive? ? 'text-amber-700' : 'text-gray-400' %>"><%= format_money(inv.balance_due_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-gray-500"><%= t("sales.statements.no_invoices") %></p>
    <% end %>
  </section>
</div>
