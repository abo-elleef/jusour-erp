<% content_for :title, t("sales.storefront_categories.title") %>
<% inventory_links = current_user.can?("inventory:view") %>

<div class="max-w-full">
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight text-gray-900"><%= t("sales.storefront_categories.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("sales.storefront_categories.description") %></p>
  </div>

  <% if @categories.any? %>
    <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[40rem]">
          <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 w-20"><span class="sr-only"><%= t("sales.storefront_categories.table.photo") %></span></th>
              <th class="p-3"><%= t("sales.storefront_categories.table.website_name") %></th>
              <th class="p-3"><%= t("sales.storefront_categories.table.inventory_category") %></th>
              <th class="p-3 text-end"><%= t("sales.storefront_categories.table.products") %></th>
              <th class="p-3 pe-5 text-end"><%= t("sales.storefront_categories.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @categories.each do |category| %>
              <% meta = @storefront_categories[category.id] %>
              <tr class="hover:bg-gray-100 transition-colors">
                <td class="p-3 ps-5">
                  <% if meta&.image&.attached? %>
                    <%= image_tag meta.image.variant(:tile), alt: "", loading: "lazy", class: "h-10 w-14 rounded-lg object-cover border border-gray-200" %>
                  <% else %>
                    <div class="h-10 w-14 rounded-lg bg-gray-100 border border-gray-200" title="<%= t("sales.storefront_listings.no_photo") %>"></div>
                  <% end %>
                </td>
                <td class="p-3">
                  <%= link_to StorefrontCategory.display_name(category, meta, locale: :en), edit_admin_sales_storefront_category_path(category),
                        class: "font-medium text-gray-900 hover:text-amber-700" %>
                  <% arabic = StorefrontCategory.display_name(category, meta, locale: :ar) %>
                  <% if meta&.title_ar.present? %>
                    <p class="text-xs text-gray-500 mt-0.5" dir="rtl" lang="ar"><%= arabic %></p>
                  <% end %>
                </td>
                <td class="p-3 text-gray-700">
                  <% if inventory_links %>
                    <%= link_to category.name, admin_inventory_ingredient_category_path(category), class: "hover:text-amber-700" %>
                  <% else %>
                    <%= category.name %>
                  <% end %>
                </td>
                <td class="p-3 text-end tabular-nums text-gray-700"><%= @listing_counts[category.id].to_i %></td>
                <td class="p-3 pe-5 text-end">
                  <%= link_to t("actions.edit"), edit_admin_sales_storefront_category_path(category),
                        class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% else %>
    <section class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
      <p class="text-gray-900 font-semibold"><%= t("sales.storefront_categories.empty") %></p>
    </section>
  <% end %>
</div>
