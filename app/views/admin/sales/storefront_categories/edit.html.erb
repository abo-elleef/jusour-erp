<% content_for :title, @category.name %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-3xl">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-1"><%= @category.name %></h1>
  <p class="text-gray-600 text-sm mb-6"><%= t("sales.storefront_categories.edit_hint") %></p>

  <%= form_with model: @storefront_category, url: admin_sales_storefront_category_path(@category), method: :patch, class: "space-y-6" do |f| %>
    <% if @storefront_category.errors.any? %>
      <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        <%= @storefront_category.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 space-y-5">
      <%= render "admin/sales/storefronts/bilingual_field", form: f, field: :title, maxlength: 80,
            label: t("sales.storefront_categories.form.title"), hint: t("sales.storefront_categories.form.title_hint") %>
      <%= render "admin/sales/storefronts/bilingual_field", form: f, field: :description, rows: 3,
            label: t("sales.storefront_categories.form.description") %>
      <div>
        <%= f.label :image, t("sales.storefront_categories.form.image"), class: label_class %>
        <%= f.file_field :image, accept: Storefront::IMAGE_CONTENT_TYPES.join(","),
              class: "text-sm text-gray-600 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200" %>
        <p class="text-xs text-gray-500 mt-1"><%= storefront_image_hint(:category) %></p>
        <% if @storefront_category.persisted? && @storefront_category.image.attached? && @storefront_category.image.blob.persisted? %>
          <div class="mt-3 flex items-center gap-4">
            <%= image_tag @storefront_category.image.variant(:tile), class: "h-20 rounded-xl border border-gray-200 object-cover" %>
            <label class="inline-flex items-center gap-2 text-xs text-gray-600 cursor-pointer">
              <%= check_box_tag "storefront_category[remove_image]", "1", false, class: "rounded border-gray-300 text-red-600" %>
              <%= t("sales.storefront.form.remove_image") %>
            </label>
          </div>
        <% end %>
      </div>
    </section>

    <div class="flex items-center gap-3">
      <%= f.submit t("actions.save_changes"), class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm" %>
      <%= link_to t("actions.cancel"), admin_sales_storefront_categories_path, class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl" %>
    </div>
  <% end %>
</div>
