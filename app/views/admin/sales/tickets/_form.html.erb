<% input_class = "w-full rounded-xl border border-gray-200 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-amber-500" %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<%= form_with model: ticket, url: (ticket.new_record? ? admin_sales_tickets_path : admin_sales_ticket_path(ticket)),
      class: "space-y-5", data: { testid: "ticket-form" } do |f| %>
  <% if ticket.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-disc ps-5 space-y-0.5">
        <% ticket.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :customer_id if ticket.new_record? %>
  <div class="rounded-xl bg-gray-50 border border-gray-100 px-4 py-3 text-sm">
    <span class="text-gray-500"><%= t("tickets.table.customer") %>:</span>
    <% if ticket.customer %>
      <%= link_to ticket.customer.display_name, admin_customer_path(ticket.customer), class: "font-semibold text-amber-700 hover:underline" %>
    <% end %>
  </div>

  <div>
    <%= f.label :subject, t("tickets.form.subject"), class: label_class %>
    <%= f.text_field :subject, required: true, maxlength: 200, class: input_class, placeholder: t("tickets.form.subject_placeholder") %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :ticket_category_id, t("tickets.table.category"), class: label_class %>
      <%= f.select :ticket_category_id, @categories.map { |c| [c.display_name, c.id] },
            { include_blank: t("tickets.form.no_category") }, class: input_class %>
    </div>
    <div>
      <%= f.label :priority, t("tickets.table.priority"), class: label_class %>
      <%= f.select :priority, Ticket::PRIORITIES.map { |p| [t("tickets.priorities.#{p}"), p] }, {}, class: input_class %>
    </div>
    <div>
      <%= f.label :customer_invoice_id, t("tickets.form.invoice"), class: label_class %>
      <%= f.select :customer_invoice_id, @invoices.map { |i| ["#{i.invoice_number} · #{l(i.invoice_date.to_date, format: :long)}", i.id] },
            { include_blank: t("tickets.form.no_invoice") }, class: input_class %>
    </div>
    <div>
      <%= f.label :credit_note_id, t("tickets.form.credit_note"), class: label_class %>
      <%= f.select :credit_note_id, @credit_notes.map { |c| ["#{c.credit_note_number} · #{format_amount(c.total_cents)}", c.id] },
            { include_blank: t("tickets.form.no_credit_note") }, class: input_class %>
      <p class="text-xs text-gray-400 mt-1"><%= t("tickets.form.credit_note_hint") %></p>
    </div>
    <% if @assignees %>
      <div>
        <%= f.label :assigned_user_id, t("tickets.table.assignee"), class: label_class %>
        <%= f.select :assigned_user_id, @assignees.map { |u| [u.name, u.id] },
              { include_blank: t("tickets.form.default_handler") }, class: input_class %>
      </div>
    <% end %>
  </div>

  <div>
    <%= f.label :description, t("tickets.form.description"), class: label_class %>
    <%= f.text_area :description, rows: 5, class: input_class, placeholder: t("tickets.form.description_placeholder") %>
  </div>

  <div>
    <%= f.label :images, t("tickets.form.images"), class: label_class %>
    <%= f.file_field :images, multiple: true, accept: "image/*",
          class: "text-sm text-gray-600 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200" %>
    <p class="text-xs text-gray-400 mt-1"><%= t("tickets.form.images_hint") %></p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit (ticket.new_record? ? t("tickets.form.create") : t("tickets.form.save")),
          class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer" %>
    <%= link_to t("actions.cancel"), (ticket.new_record? ? admin_customer_path(ticket.customer) : admin_sales_ticket_path(ticket)),
          class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
  </div>
<% end %>
