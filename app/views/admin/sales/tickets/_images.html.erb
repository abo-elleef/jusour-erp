<% if images.attached? %>
  <div class="flex flex-wrap gap-2 mt-2">
    <% images.each do |image| %>
      <%= link_to rails_blob_path(image, disposition: "inline"), target: "_blank", rel: "noopener",
            class: "block rounded-xl border border-gray-200 overflow-hidden hover:opacity-90" do %>
        <% if image.variable? %>
          <%= image_tag image.variant(resize_to_limit: [240, 240]), alt: image.filename.to_s, class: "h-24 w-24 object-cover" %>
        <% else %>
          <span class="block px-3 py-2 text-xs text-gray-600"><%= image.filename %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
