<% content_for :title, t("sales.storefront_pages.title") %>

<div class="max-w-4xl">
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight text-gray-900"><%= t("sales.storefront_pages.title") %></h1>
    <p class="text-gray-600 text-sm mt-1"><%= t("sales.storefront_pages.description") %></p>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5"><%= t("sales.storefront_pages.table.page") %></th>
          <th class="p-3"><%= t("sales.storefront_pages.table.languages") %></th>
          <th class="p-3"><%= t("sales.storefront_pages.table.status") %></th>
          <th class="p-3 pe-5 text-end"><%= t("sales.storefront_pages.table.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% StorefrontPage::SLOTS.each do |slot| %>
          <% page = @pages[slot] %>
          <% edit_path = edit_admin_sales_storefront_page_path(slot.dasherize) %>
          <tr class="hover:bg-gray-100 transition-colors">
            <td class="p-3 ps-5">
              <%= link_to (page&.display_title(locale: :en) || t("public.storefront.pages.#{slot}", locale: :en)), edit_path,
                    class: "font-medium text-gray-900 hover:text-amber-700" %>
              <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.storefront_pages.hints.#{slot}") %></p>
            </td>
            <td class="p-3 text-xs text-gray-600">
              <% filled = { "EN" => page&.body&.to_plain_text.to_s.strip.present?, "عربي" => page&.body_ar&.to_plain_text.to_s.strip.present? } %>
              <% filled.each do |label, ok| %>
                <span class="me-1 rounded-md px-1.5 py-0.5 font-semibold <%= ok ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-400' %>"><%= label %></span>
              <% end %>
            </td>
            <td class="p-3">
              <% if page&.live? %>
                <span class="whitespace-nowrap text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-800 border border-green-200"><%= t("sales.storefront_pages.statuses.live") %></span>
              <% elsif page&.enabled? %>
                <span class="whitespace-nowrap text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-200"><%= t("sales.storefront_pages.statuses.empty") %></span>
              <% else %>
                <span class="whitespace-nowrap text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 border border-gray-200"><%= t("sales.storefront_pages.statuses.off") %></span>
              <% end %>
            </td>
            <td class="p-3 pe-5 text-end">
              <%= link_to t("actions.edit"), edit_path,
                    class: "inline-flex text-xs font-semibold text-gray-700 hover:bg-gray-100 px-3 py-1.5 rounded-xl border border-gray-200" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
