  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <p class="text-xs text-gray-500"><%= t("sales.reports.leads.drop_reasons_hint") %></p>
    </div>
    <% if rows.empty? %>
      <p class="p-8 text-center text-sm text-gray-500"><%= t("sales.reports.leads.no_losses") %></p>
    <% else %>
      <div class="p-5">
        <%= bar_chart rows.to_h { |r| [t("sales.leads.lost_reasons.#{r.reason}"), r.count] }, height: "220px", id: "leads-drop-reasons-chart" %>
      </div>
      <div class="overflow-x-auto border-t border-gray-100">
        <table class="w-full text-sm">
          <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start"><%= t("sales.reports.leads.reason") %></th>
              <th class="p-3 text-end"><%= t("sales.reports.leads.lost_count") %></th>
              <th class="p-3 text-end pe-5"><%= t("sales.reports.leads.percent_of_losses") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% rows.each do |row| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-3 ps-5 text-gray-800"><%= t("sales.leads.lost_reasons.#{row.reason}") %></td>
                <td class="p-3 text-end tabular-nums text-gray-600"><%= row.count %></td>
                <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900"><%= row.percent %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
