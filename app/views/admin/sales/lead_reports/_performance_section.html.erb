  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
      <p class="text-xs text-gray-500"><%= t("sales.reports.leads.performance_hint") %></p>
    </div>
    <% if rows.empty? %>
      <p class="p-8 text-center text-sm text-gray-500"><%= t("sales.reports.leads.empty") %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-controller="sortable-table"
               data-sortable-table-storage-key-value="sales-reports-leads-performance">
          <thead class="border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="p-3 ps-5 text-start w-10">#</th>
              <%= sortable_report_th t("sales.reports.leads.rep"), "name", align: :start %>
              <%= sortable_report_th t("sales.reports.leads.assigned"), "assigned", type: :number %>
              <%= sortable_report_th t("sales.reports.leads.converted"), "converted", type: :number %>
              <%= sortable_report_th t("sales.reports.leads.lost_count"), "lost", type: :number %>
              <%= sortable_report_th t("sales.reports.leads.conversion_rate"), "rate", type: :number, pe: true %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100" data-sortable-table-target="body">
            <% rows.each_with_index do |row, i| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-3 ps-5 text-gray-400" data-index-cell><%= i + 1 %></td>
                <td class="p-3 text-gray-800" data-sort-key="name"><%= row.name.presence || t("sales.leads.activity.nobody") %></td>
                <td class="p-3 text-end tabular-nums text-gray-600" data-sort-key="assigned" data-sort-value="<%= row.assigned %>">
                  <%= row.assigned %>
                </td>
                <td class="p-3 text-end tabular-nums text-green-700" data-sort-key="converted" data-sort-value="<%= row.converted %>">
                  <%= row.converted %>
                </td>
                <td class="p-3 text-end tabular-nums text-red-600" data-sort-key="lost" data-sort-value="<%= row.lost %>">
                  <%= row.lost %>
                </td>
                <td class="p-3 text-end pe-5 tabular-nums font-semibold text-gray-900" data-sort-key="rate" data-sort-value="<%= row.conversion_rate %>">
                  <%= row.conversion_rate %>%
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
