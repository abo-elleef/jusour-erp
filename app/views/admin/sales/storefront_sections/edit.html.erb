<% type_name = t("sales.storefront_sections.types.#{@section.section_type}.name") %>
<% content_for :title, type_name %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>
<% input_class = pos_input_class %>
<% file_class = "text-sm text-gray-600 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200" %>

<div class="max-w-3xl">
  <%= link_to "← #{t("sales.storefront_sections.title")}", admin_sales_storefront_sections_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight text-gray-900"><%= type_name %></h1>
  <p class="text-gray-600 text-sm mt-1 mb-6"><%= t("sales.storefront_sections.types.#{@section.section_type}.hint") %></p>

  <%= form_with url: admin_sales_storefront_section_path(@section), method: :patch, multipart: true, class: "space-y-6" do %>
    <% if @section.errors.any? %>
      <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        <%= @section.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <section class="rounded-2xl border border-gray-200 bg-white p-5 space-y-5">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= hidden_field_tag :enabled, "0", id: nil %>
        <%= check_box_tag :enabled, "1", @section.enabled?, class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
        <span class="text-sm font-semibold text-gray-900"><%= t("sales.storefront_sections.form.enabled") %></span>
      </label>

      <% @section.fields.each do |field| %>
        <% name = field[:name] %>
        <% label = t("sales.storefront_sections.fields.#{name}") %>
        <% case field[:kind] %>
        <% when :text, :long_text %>
          <div>
            <p class="<%= label_class %>"><%= label %></p>
            <div class="grid gap-3 sm:grid-cols-2">
              <% [[name, "en", "ltr", t("sales.storefront.form.english")], ["#{name}_ar", "ar", "rtl", t("sales.storefront.form.arabic")]].each do |key, lang, dir, lang_label| %>
                <div>
                  <label for="settings_<%= key %>" class="block text-[11px] font-medium text-gray-500 mb-1"><%= lang_label %></label>
                  <% if field[:kind] == :long_text %>
                    <%= text_area_tag "settings[#{key}]", @section.settings.to_h[key], id: "settings_#{key}", rows: 6, dir: dir, lang: lang,
                          maxlength: StorefrontSection::LONG_TEXT_LIMIT, class: input_class %>
                  <% else %>
                    <%= text_field_tag "settings[#{key}]", @section.settings.to_h[key], id: "settings_#{key}", dir: dir, lang: lang,
                          maxlength: StorefrontSection::TEXT_LIMIT, class: input_class %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% hint = t("sales.storefront_sections.field_hints.#{@section.section_type}.#{name}", default: "") %>
            <% if hint.present? %><p class="text-xs text-gray-500 mt-1"><%= hint %></p><% end %>
          </div>
        <% when :boolean %>
          <label class="flex items-center gap-3 cursor-pointer">
            <%= hidden_field_tag "settings[#{name}]", "0", id: nil %>
            <%= check_box_tag "settings[#{name}]", "1", @section.setting(name), id: "settings_#{name}",
                  class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500/40" %>
            <span class="text-sm text-gray-900"><%= label %></span>
          </label>
        <% when :limit %>
          <div class="max-w-[12rem]">
            <label for="settings_<%= name %>" class="<%= label_class %>"><%= label %></label>
            <%= select_tag "settings[#{name}]", options_for_select(StorefrontSection::LIMITS, @section.setting(name)), id: "settings_#{name}", class: input_class %>
          </div>
        <% when :category %>
          <div>
            <label for="settings_<%= name %>" class="<%= label_class %>"><%= label %></label>
            <%= select_tag "settings[#{name}]", options_for_select(@categories.map { |c| [c.name, c.id] }, @section.setting(name)),
                  id: "settings_#{name}", include_blank: t("sales.storefront_sections.form.pick_category"), class: input_class %>
          </div>
        <% when :choice %>
          <div class="max-w-xs">
            <label for="settings_<%= name %>" class="<%= label_class %>"><%= label %></label>
            <%= select_tag "settings[#{name}]",
                  options_for_select(field[:options].map { |o| [t("sales.storefront_sections.choices.#{name}.#{o}"), o] }, @section.setting(name)),
                  id: "settings_#{name}", class: input_class %>
          </div>
        <% when :link, :map_link %>
          <div>
            <label for="settings_<%= name %>" class="<%= label_class %>"><%= label %></label>
            <%= text_field_tag "settings[#{name}]", @section.setting(name), id: "settings_#{name}", dir: "ltr", spellcheck: false,
                  placeholder: (field[:kind] == :map_link ? "https://maps.app.goo.gl/…" : "https://… or /?category=…"), class: input_class %>
            <p class="text-xs text-gray-500 mt-1"><%= t("sales.storefront_sections.field_hints.#{field[:kind]}") %></p>
          </div>
        <% end %>
      <% end %>

      <% if @section.image? %>
        <div>
          <label for="image" class="<%= label_class %>"><%= t("sales.storefront_sections.form.image") %></label>
          <%= file_field_tag :image, accept: Storefront::IMAGE_CONTENT_TYPES.join(","), class: file_class %>
          <% if @section.image.attached? && @section.image.blob.persisted? %>
            <div class="mt-3 flex items-center gap-4">
              <%= image_tag @section.image.variant(:half), class: "h-20 rounded-xl border border-gray-200 object-cover" %>
              <label class="inline-flex items-center gap-2 text-xs text-gray-600 cursor-pointer">
                <%= check_box_tag :remove_image, "1", false, class: "rounded border-gray-300 text-red-600" %>
                <%= t("sales.storefront.form.remove_image") %>
              </label>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @section.logos? %>
        <div>
          <label for="logos" class="<%= label_class %>"><%= t("sales.storefront_sections.form.logos") %></label>
          <% saved = @section.ordered_logos.select(&:persisted?) %>
          <% if saved.any? %>
            <ul class="mb-3 flex flex-wrap gap-3">
              <% saved.each do |logo| %>
                <li class="rounded-xl border border-gray-200 p-2 text-center">
                  <%= image_tag logo.variant(:logo), class: "h-10 w-auto max-w-[7rem] object-contain" %>
                  <%= button_tag t("actions.remove"), type: "submit", form: "remove-logo-#{logo.id}",
                        class: "mt-1 block w-full text-[11px] font-semibold text-red-700 hover:bg-red-50 rounded-lg py-0.5" %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <%= file_field_tag "logos[]", multiple: true, id: "logos", accept: Storefront::IMAGE_CONTENT_TYPES.join(","), class: file_class %>
          <p class="text-xs text-gray-500 mt-1"><%= t("sales.storefront_sections.form.logos_hint", count: StorefrontSection::MAX_LOGOS) %></p>
        </div>
      <% end %>
    </section>

    <div class="flex items-center gap-3">
      <%= submit_tag t("actions.save_changes"), class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-sm" %>
      <%= link_to t("actions.cancel"), admin_sales_storefront_sections_path, class: "text-sm font-medium text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl" %>
    </div>
  <% end %>

  <% if @section.logos? %>
    <% @section.ordered_logos.select(&:persisted?).each do |logo| %>
      <%= form_with url: remove_logo_admin_sales_storefront_section_path(@section, attachment_id: logo.id), method: :delete,
            id: "remove-logo-#{logo.id}", class: "hidden", data: { turbo_confirm: t("sales.storefront_sections.form.remove_logo_confirm") } do %>
      <% end %>
    <% end %>
  <% end %>
</div>
