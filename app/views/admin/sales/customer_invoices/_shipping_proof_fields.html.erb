<%# locals: invoice — the two optional shipping-proof inputs, shared by the
    dispatch form and the later add/change form. %>
<div class="min-w-[12rem] flex-1">
  <label for="customer_invoice_shipping_tracking_number" class="block text-xs font-semibold text-gray-600 mb-1.5">
    <%= t("sales.customer_invoices.shipping_proof.tracking_number") %>
    <span class="font-normal text-gray-400">(<%= t("sales.customer_invoices.shipping_proof.optional") %>)</span>
  </label>
  <%= text_field_tag "customer_invoice[shipping_tracking_number]", invoice.shipping_tracking_number,
        id: "customer_invoice_shipping_tracking_number", maxlength: 100, dir: "ltr", autocomplete: "off",
        class: pos_input_class %>
</div>
<div class="min-w-[12rem] flex-1" data-controller="image-preview">
  <label for="customer_invoice_waybill_image" class="block text-xs font-semibold text-gray-600 mb-1.5">
    <%= t("sales.customer_invoices.shipping_proof.waybill_image") %>
    <span class="font-normal text-gray-400">(<%= t("sales.customer_invoices.shipping_proof.optional") %>)</span>
  </label>
  <%= file_field_tag "customer_invoice[waybill_image]", id: "customer_invoice_waybill_image",
        accept: CustomerInvoice::WAYBILL_IMAGE_CONTENT_TYPES.join(","), capture: "environment",
        class: "text-sm text-gray-600 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200",
        data: { image_preview_target: "input", action: "change->image-preview#preview" } %>
  <img data-image-preview-target="preview" alt="<%= t("sales.customer_invoices.shipping_proof.waybill_image") %>"
       class="hidden mt-2 max-h-32 rounded-xl border border-gray-200 object-contain">
</div>
