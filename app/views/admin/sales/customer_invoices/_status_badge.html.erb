<%# locals: invoice %>
<% chip = "text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full border" %>
<% if invoice.void? %>
  <span class="<%= chip %> bg-gray-100 text-gray-600 border-gray-200"><%= t("sales.customer_invoices.statuses.void") %></span>
<% elsif invoice.draft? %>
  <span class="<%= chip %> bg-amber-50 text-amber-800 border-amber-200"><%= t("sales.customer_invoices.statuses.draft") %></span>
<% elsif invoice.pending_payment_confirmation? %>
  <span class="<%= chip %> bg-blue-50 text-blue-800 border-blue-200"><%= t("sales.customer_invoices.statuses.pending_payment_confirmation") %></span>
<% elsif invoice.confirmed? && invoice.cash_on_delivery? && !invoice.dispatched? %>
  <span class="<%= chip %> bg-amber-50 text-amber-800 border-amber-200"><%= t("sales.customer_invoices.payment_methods.cash_on_delivery") %></span>
<% elsif invoice.confirmed? && invoice.paid_on_issue? %>
  <span class="<%= chip %> bg-green-100 text-green-800 border-green-200"><%= t("sales.customer_invoices.payment_methods.#{invoice.payment_method}") %></span>
<% elsif invoice.historical? %>
  <%# Imported from the previous system: it has no payment status of its own. %>
  <span class="<%= chip %> bg-slate-100 text-slate-700 border-slate-300"><%= t("sales.customer_invoices.statuses.historical") %></span>
<% else %>
  <% classes = { "unpaid" => "bg-red-50 text-red-700 border-red-200",
                 "partially_paid" => "bg-blue-50 text-blue-700 border-blue-200",
                 "paid" => "bg-green-100 text-green-800 border-green-200" } %>
  <span class="<%= chip %> <%= classes[invoice.payment_status] %>">
    <%= t("sales.customer_invoices.payment_statuses.#{invoice.payment_status}") %>
  </span>
<% end %>
