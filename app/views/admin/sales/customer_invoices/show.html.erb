<% content_for :title, @invoice.invoice_number %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 tabular-nums"><%= @invoice.invoice_number %></h1>
        <%= render "status_badge", invoice: @invoice %>
      </div>
      <p class="text-gray-600 text-sm mt-1">
        <%= @invoice.customer.display_name %> · <%= l(@invoice.invoice_date, format: :long) %> · <%= @invoice.location&.name %>
      </p>
      <p class="text-gray-500 text-xs mt-0.5">
        <%= t("sales.customer_invoices.show.salesperson") %>: <span class="font-medium text-gray-700"><%= @invoice.salesperson&.name || @invoice.user.name %></span>
        <% if @invoice.delivery? %>
          · <%= t("sales.customer_invoices.show.shipping_company") %>:
          <span class="font-medium text-gray-700"><%= @invoice.shipping_company&.name %></span>
          <% if @invoice.cash_on_delivery? %>
            — <%= @invoice.dispatched? ? t("sales.customer_invoices.show.dispatched_at", date: l(@invoice.dispatched_at, format: :long)) : t("sales.customer_invoices.show.not_dispatched") %>
          <% end %>
        <% end %>
      </p>
    </div>
    <%= link_to t("sales.customer_invoices.back"), admin_sales_customer_invoices_path,
          class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
  </div>

  <%# Draft: confirm either settles now, waits for payment approval, or (COD)
      deducts stock and leaves the shipping company to be charged at dispatch. %>
  <% if @invoice.draft? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/50 px-5 py-4 mb-6 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-amber-900">
        <% if @invoice.cash_on_delivery? %>
          <%= t("sales.customer_invoices.show.draft_hint_cod") %>
        <% elsif @invoice.online? %>
          <%= t("sales.customer_invoices.show.draft_hint_online") %>
        <% elsif @invoice.paid_on_issue? %>
          <%= t("sales.customer_invoices.show.draft_hint_paid_now",
                method: t("sales.customer_invoices.payment_methods.#{@invoice.payment_method}")) %>
        <% else %>
          <%= t("sales.customer_invoices.show.draft_hint") %>
        <% end %>
      </p>
      <div class="flex items-center gap-2">
        <%= link_to t("actions.edit"), edit_admin_sales_customer_invoice_path(@invoice),
              class: "text-sm font-semibold text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl border border-gray-300 transition-colors" %>
        <%= button_to t("actions.void"), void_admin_sales_customer_invoice_path(@invoice),
              method: :patch,
              class: "text-sm font-semibold text-red-600 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors",
              form: { data: { turbo_confirm: t("sales.customer_invoices.show.void_prompt") } } %>
        <%= button_to t("sales.customer_invoices.show.confirm"), confirm_admin_sales_customer_invoice_path(@invoice),
              method: :post,
              class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm",
              form: { data: { turbo_confirm: t("sales.customer_invoices.show.confirm_prompt") } } %>
      </div>
    </div>
  <%# Online payment, awaiting someone with sales:confirm_payments. %>
  <% elsif @invoice.pending_payment_confirmation? %>
    <div class="rounded-2xl border border-blue-200 bg-blue-50/50 px-5 py-4 mb-6 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-blue-900"><%= t("sales.customer_invoices.show.pending_hint") %></p>
      <div class="flex items-center gap-2">
        <%= button_to t("actions.void"), void_admin_sales_customer_invoice_path(@invoice),
              method: :patch,
              class: "text-sm font-semibold text-red-600 hover:bg-red-50 px-4 py-2.5 rounded-xl border border-red-200 transition-colors",
              form: { data: { turbo_confirm: t("sales.customer_invoices.show.void_prompt") } } %>
        <% if current_user.can?("sales:confirm_payments") %>
          <%= button_to t("sales.customer_invoices.show.reject"), reject_payment_admin_sales_customer_invoice_path(@invoice),
                method: :post,
                class: "bg-white hover:bg-gray-50 text-gray-700 text-sm font-semibold px-4 py-2.5 rounded-xl border border-gray-300",
                form: { data: { turbo_confirm: t("sales.customer_invoices.show.reject_prompt") } } %>
          <%= button_to t("sales.customer_invoices.show.approve"), approve_payment_admin_sales_customer_invoice_path(@invoice),
                method: :post,
                class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm",
                form: { data: { turbo_confirm: t("sales.customer_invoices.show.approve_prompt") } } %>
        <% end %>
      </div>
    </div>
  <%# Confirmed delivery, not yet handed to the shipping company. COD charges
      their balance here; anything else is just a fulfillment stamp. %>
  <% elsif @invoice.confirmed? && @invoice.delivery? && !@invoice.dispatched? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/50 px-5 py-4 mb-6 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-amber-900">
        <%= @invoice.cash_on_delivery? ?
              t("sales.customer_invoices.show.cod_awaiting_dispatch_hint", amount: format_money(@invoice.total_cents)) :
              t("sales.customer_invoices.show.not_dispatched") %>
      </p>
      <%= button_to t("sales.customer_invoices.show.dispatch"), mark_dispatched_admin_sales_customer_invoice_path(@invoice),
            method: :post,
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm",
            form: { data: { turbo_confirm: t("sales.customer_invoices.show.dispatch_prompt") } } %>
    </div>
  <%# Imported history: a completed sale from the previous system, with no balance
      of its own to settle here. %>
  <% elsif @invoice.historical? %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 mb-6">
      <p class="text-sm text-slate-700"><%= t("sales.customer_invoices.show.historical_hint") %></p>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("sales.customer_invoices.form.product") %></th>
          <th class="p-3 text-end"><%= t("sales.customer_invoices.form.quantity") %></th>
          <th class="p-3 text-end"><%= t("sales.customer_invoices.form.unit_price") %></th>
          <th class="p-3 text-end pe-5"><%= t("sales.customer_invoices.form.line_total") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @invoice.customer_invoice_lines.each do |line| %>
          <tr>
            <td class="p-3 ps-5 text-gray-800">
              <%= link_to line.ingredient.name, admin_inventory_ingredient_path(line.ingredient),
                    class: "font-semibold text-amber-700 hover:text-amber-800" %>
            </td>
            <td class="p-3 text-end tabular-nums text-gray-700"><%= line.quantity %> <%= ingredient_unit_label(line.unit.presence || line.ingredient.unit) %></td>
            <td class="p-3 text-end tabular-nums text-gray-700"><%= format_money(line.unit_price_cents) %></td>
            <td class="p-3 text-end pe-5 tabular-nums font-medium text-gray-900"><%= format_money(line.line_total_cents) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t border-gray-100 bg-gray-50/60">
        <% if @invoice.delivery? && @invoice.standard_delivery_fee_cents.positive? %>
          <tr>
            <td class="p-3 ps-5 text-gray-600" colspan="3"><%= t("sales.customer_invoices.form.subtotal") %></td>
            <td class="p-3 pe-5 text-end text-gray-700 tabular-nums"><%= format_money(@invoice.subtotal_cents) %></td>
          </tr>
          <tr>
            <td class="p-3 ps-5 text-gray-600" colspan="3">
              <%= t("sales.customer_invoices.form.delivery_fee") %>
              <% if @invoice.waived_delivery_fee_cents.positive? %>
                <span class="text-xs text-amber-700 font-medium">(<%= t("sales.customer_invoices.show.delivery_fee_waived", amount: format_money(@invoice.waived_delivery_fee_cents)) %>)</span>
              <% end %>
            </td>
            <td class="p-3 pe-5 text-end text-gray-700 tabular-nums"><%= format_money(@invoice.delivery_fee_cents) %></td>
          </tr>
        <% end %>
        <tr>
          <td class="p-3 ps-5 font-semibold text-gray-900" colspan="3"><%= t("sales.customer_invoices.form.total") %></td>
          <td class="p-3 pe-5 text-end font-bold text-gray-900 tabular-nums"><%= format_money(@invoice.total_cents) %></td>
        </tr>
      </tfoot>
    </table>
  </section>

  <% if @invoice.confirmed? && @invoice.cash_on_delivery? %>
    <% if @invoice.dispatched? %>
      <div class="rounded-2xl border border-green-200 bg-green-50/60 px-5 py-4 mb-6">
        <p class="text-sm text-green-900">
          <%= t("sales.customer_invoices.show.settled_hint_cod",
                amount: format_money(@invoice.total_cents),
                shipping_company: @invoice.shipping_company.name) %>
        </p>
        <% if @invoice.standard_delivery_fee_cents.positive? %>
          <p class="text-xs text-green-800 mt-1">
            <%= t("sales.customer_invoices.show.settled_hint_cod_fee_netted",
                  fee: format_money(@invoice.standard_delivery_fee_cents)) %>
          </p>
        <% end %>
      </div>
    <% end %>
    <%# Not yet dispatched: the amber banner above already covers it — nothing
        more to show (no treasury, no AR, no record-payment form applies). %>
  <% elsif @invoice.confirmed? && @invoice.paid_on_issue? %>
    <div class="rounded-2xl border border-green-200 bg-green-50/60 px-5 py-4 mb-6">
      <p class="text-sm text-green-900">
        <%= t("sales.customer_invoices.show.settled_hint",
              amount: format_money(@invoice.total_cents),
              method: t("sales.customer_invoices.payment_methods.#{@invoice.payment_method}"),
              treasury: @invoice.treasury&.name) %>
      </p>
    </div>
  <% elsif @invoice.confirmed? %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded-2xl border border-gray-200 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.customer_invoices.show.invoice_total") %></p>
        <p class="text-xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@invoice.total_cents) %></p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.customer_invoices.show.invoice_balance") %></p>
        <p class="text-xl font-bold mt-1 text-amber-700 tabular-nums"><%= format_money(@invoice.balance_due_cents) %></p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.customer_invoices.show.customer_balance") %></p>
        <p class="text-xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@invoice.customer.ar_balance_cents) %></p>
      </div>
    </div>

    <% if @invoice.balance_due_cents.positive? %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.customer_invoices.show.record_payment") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.customer_invoices.show.record_payment_hint") %></p>
        </div>
        <%= form_with url: record_payment_admin_sales_customer_invoice_path(@invoice), method: :post,
              class: "p-5 flex flex-wrap items-end gap-4" do %>
          <div class="min-w-[10rem]">
            <%= label_tag :amount, t("sales.customer_invoices.show.amount"), class: label_class %>
            <%= number_field_tag :amount, nil, step: 0.01, min: 0, required: true, class: input_class, placeholder: "0.00" %>
          </div>
          <div class="min-w-[12rem]">
            <%= label_tag :treasury_id, t("sales.customer_invoices.show.treasury"), class: label_class %>
            <%= select_tag :treasury_id,
                  options_from_collection_for_select(@treasuries, :id, :name),
                  include_blank: t("sales.customer_invoices.show.select_treasury"),
                  required: true, class: "#{input_class} appearance-none" %>
          </div>
          <div class="min-w-[10rem]">
            <%= label_tag :payment_date, t("sales.customer_invoices.show.payment_date"), class: label_class %>
            <%= date_field_tag :payment_date, Date.current, max: Date.current, class: input_class %>
          </div>
          <%= submit_tag t("sales.customer_invoices.show.record"),
                class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <%# ── Payment proof — mainly an InstaPay/bank-transfer screenshot ────────── %>
  <% show_payment_proof = !@invoice.void? || @invoice.payment_proof_image.attached? %>
  <% if show_payment_proof %>
    <% if @invoice.void? %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mt-6 print-hide">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.customer_invoices.show.payment_proof") %></h2>
        </div>
        <div class="p-5">
          <%= link_to url_for(@invoice.payment_proof_image), target: "_blank", rel: "noopener" do %>
            <%= image_tag @invoice.payment_proof_image, class: "max-h-96 w-full object-contain rounded-xl border border-gray-200" %>
          <% end %>
        </div>
      </section>
    <% else %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mt-6 print-hide">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.customer_invoices.show.payment_proof") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.customer_invoices.show.payment_proof_hint") %></p>
        </div>
        <div class="p-5 space-y-5">
          <% if @invoice.payment_proof_image.attached? %>
            <%= link_to url_for(@invoice.payment_proof_image), target: "_blank", rel: "noopener" do %>
              <%= image_tag @invoice.payment_proof_image, class: "max-h-96 w-full object-contain rounded-xl border border-gray-200" %>
            <% end %>
          <% end %>
          <% submit_label = @invoice.payment_proof_image.attached? ? t("sales.customer_invoices.form.payment_proof_replace") : t("sales.customer_invoices.form.payment_proof_attach") %>
          <div data-controller="image-preview">
            <%= form_with url: attach_payment_proof_image_admin_sales_customer_invoice_path(@invoice),
                  method: :patch,
                  html: { multipart: true, class: "flex flex-wrap items-end gap-4" } do %>
              <div class="min-w-[12rem] flex-1">
                <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= t("sales.customer_invoices.show.payment_proof") %></label>
                <%= file_field_tag "customer_invoice[payment_proof_image]", accept: "image/*", capture: "environment",
                      class: "text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-gray-100 file:font-semibold file:text-gray-700 hover:file:bg-gray-200",
                      data: { image_preview_target: "input", action: "change->image-preview#preview" } %>
                <div class="mt-3">
                  <img data-image-preview-target="preview"
                       alt="<%= t("sales.customer_invoices.show.payment_proof") %>"
                       class="hidden max-h-48 rounded-xl border border-gray-200 object-contain">
                </div>
              </div>
              <%= submit_tag submit_label,
                    class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-colors" %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
