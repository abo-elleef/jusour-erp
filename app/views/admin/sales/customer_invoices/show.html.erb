<% content_for :title, @invoice.invoice_number %>
<% input_class = pos_input_class %>
<% label_class = "block text-xs font-semibold text-gray-600 mb-1.5" %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 tabular-nums"><%= @invoice.invoice_number %></h1>
        <%= render "status_badge", invoice: @invoice %>
      </div>
      <p class="text-gray-600 text-sm mt-1">
        <%= @invoice.customer.display_name %> · <%= l(@invoice.invoice_date, format: :long) %> · <%= @invoice.location&.name %>
      </p>
      <p class="text-gray-500 text-xs mt-0.5">
        <%= t("sales.customer_invoices.show.salesperson") %>: <span class="font-medium text-gray-700"><%= @invoice.salesperson&.name || @invoice.user.name %></span>
      </p>
    </div>
    <%= link_to t("sales.customer_invoices.back"), admin_sales_customer_invoices_path,
          class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
  </div>

  <%# Draft: confirm raises AR + deducts stock. %>
  <% if @invoice.draft? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/50 px-5 py-4 mb-6 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-amber-900">
        <%= @invoice.paid_on_issue? ?
              t("sales.customer_invoices.show.draft_hint_paid_now",
                method: t("sales.customer_invoices.payment_methods.#{@invoice.payment_method}")) :
              t("sales.customer_invoices.show.draft_hint") %>
      </p>
      <%= button_to t("sales.customer_invoices.show.confirm"), confirm_admin_sales_customer_invoice_path(@invoice),
            method: :post,
            class: "bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm",
            form: { data: { turbo_confirm: t("sales.customer_invoices.show.confirm_prompt") } } %>
    </div>
  <%# Imported history: a completed sale from the previous system, with no balance
      of its own to settle here. %>
  <% elsif @invoice.historical? %>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 mb-6">
      <p class="text-sm text-slate-700"><%= t("sales.customer_invoices.show.historical_hint") %></p>
    </div>
  <% end %>

  <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden mb-6">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-100 bg-gray-50/80 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="p-3 ps-5 text-start"><%= t("sales.customer_invoices.form.product") %></th>
          <th class="p-3 text-end"><%= t("sales.customer_invoices.form.quantity") %></th>
          <th class="p-3 text-end"><%= t("sales.customer_invoices.form.unit_price") %></th>
          <th class="p-3 text-end pe-5"><%= t("sales.customer_invoices.form.line_total") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @invoice.customer_invoice_lines.each do |line| %>
          <tr>
            <td class="p-3 ps-5 text-gray-800"><%= line.ingredient.name %></td>
            <td class="p-3 text-end tabular-nums text-gray-700"><%= line.quantity %> <%= ingredient_unit_label(line.unit.presence || line.ingredient.unit) %></td>
            <td class="p-3 text-end tabular-nums text-gray-700"><%= format_money(line.unit_price_cents) %></td>
            <td class="p-3 text-end pe-5 tabular-nums font-medium text-gray-900"><%= format_money(line.line_total_cents) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t border-gray-100 bg-gray-50/60">
        <tr>
          <td class="p-3 ps-5 font-semibold text-gray-900" colspan="3"><%= t("sales.customer_invoices.form.total") %></td>
          <td class="p-3 pe-5 text-end font-bold text-gray-900 tabular-nums"><%= format_money(@invoice.total_cents) %></td>
        </tr>
      </tfoot>
    </table>
  </section>

  <% if @invoice.confirmed? && @invoice.paid_on_issue? %>
    <div class="rounded-2xl border border-green-200 bg-green-50/60 px-5 py-4 mb-6">
      <p class="text-sm text-green-900">
        <%= t("sales.customer_invoices.show.settled_hint",
              amount: format_money(@invoice.total_cents),
              method: t("sales.customer_invoices.payment_methods.#{@invoice.payment_method}"),
              treasury: @invoice.treasury&.name) %>
      </p>
    </div>
  <% elsif @invoice.confirmed? %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded-2xl border border-gray-200 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.customer_invoices.show.invoice_total") %></p>
        <p class="text-xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@invoice.total_cents) %></p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.customer_invoices.show.invoice_balance") %></p>
        <p class="text-xl font-bold mt-1 text-amber-700 tabular-nums"><%= format_money(@invoice.balance_due_cents) %></p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= t("sales.customer_invoices.show.customer_balance") %></p>
        <p class="text-xl font-bold mt-1 text-gray-900 tabular-nums"><%= format_money(@invoice.customer.ar_balance_cents) %></p>
      </div>
    </div>

    <% if @invoice.balance_due_cents.positive? %>
      <section class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/80">
          <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.customer_invoices.show.record_payment") %></h2>
          <p class="text-xs text-gray-500 mt-0.5"><%= t("sales.customer_invoices.show.record_payment_hint") %></p>
        </div>
        <%= form_with url: record_payment_admin_sales_customer_invoice_path(@invoice), method: :post,
              class: "p-5 flex flex-wrap items-end gap-4" do %>
          <div class="min-w-[10rem]">
            <%= label_tag :amount, t("sales.customer_invoices.show.amount"), class: label_class %>
            <%= number_field_tag :amount, nil, step: 0.01, min: 0, required: true, class: input_class, placeholder: "0.00" %>
          </div>
          <div class="min-w-[12rem]">
            <%= label_tag :treasury_id, t("sales.customer_invoices.show.treasury"), class: label_class %>
            <%= select_tag :treasury_id,
                  options_from_collection_for_select(@treasuries, :id, :name),
                  include_blank: t("sales.customer_invoices.show.select_treasury"),
                  required: true, class: "#{input_class} appearance-none" %>
          </div>
          <div class="min-w-[10rem]">
            <%= label_tag :payment_date, t("sales.customer_invoices.show.payment_date"), class: label_class %>
            <%= date_field_tag :payment_date, Date.current, max: Date.current, class: input_class %>
          </div>
          <%= submit_tag t("sales.customer_invoices.show.record"),
                class: "bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl" %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
