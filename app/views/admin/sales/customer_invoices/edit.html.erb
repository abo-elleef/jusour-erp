<% content_for :title, @invoice.invoice_number %>

<div class="max-w-7xl">
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @invoice.invoice_number %></h1>
      <p class="text-gray-600 text-sm mt-1"><%= t("sales.customer_invoices.new_hint") %></p>
    </div>
    <%= link_to t("sales.customer_invoices.back"), admin_sales_customer_invoice_path(@invoice),
          class: "text-sm font-semibold text-gray-600 hover:text-gray-900 px-4 py-2" %>
  </div>

  <%= render "form", invoice: @invoice %>
</div>
