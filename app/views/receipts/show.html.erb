<h1 class="text-center text-lg font-bold mb-2">Saqr Chicken & Burgers</h1>
<p class="text-center text-gray-600 mb-1"><%= @order.order_number %> · <%= @order.created_at.strftime("%b %d, %Y %l:%M %p") %></p>
<p class="text-center text-gray-600 mb-4"><%= @order.fulfillment_summary %></p>
<hr class="mb-4">
<% @order.order_items.each do |item| %>
  <div class="flex justify-between mb-1">
    <span><%= item.quantity %> <%= item.display_name %></span>
    <span><%= format_money(item.line_total_cents) %></span>
  </div>
  <% item.order_item_modifiers.each do |m| %>
    <p class="text-gray-500 pl-4">+ <%= m.name %></p>
  <% end %>
<% end %>
<hr class="my-4">
<div class="flex justify-between"><span>Subtotal</span><span><%= format_money(@order.subtotal_cents) %></span></div>
<div class="flex justify-between"><span>Tax</span><span><%= format_money(@order.tax_cents) %></span></div>
<div class="flex justify-between"><span>Tip</span><span><%= format_money(@order.tip_cents) %></span></div>
<div class="flex justify-between font-bold text-lg mt-2"><span>Total</span><span><%= format_money(@order.total_cents) %></span></div>
<% if @order.customer %>
  <p class="text-center mt-4 text-gray-600">Loyalty balance: <%= @order.customer.loyalty_points %> pts</p>
<% end %>
