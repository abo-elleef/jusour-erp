<% logo = Printing::ReceiptLogo.attachment_for(location: @order.location, company: @order.company) %>
<% if logo %>
  <%= image_tag url_for(logo), alt: "", class: "mx-auto mb-3 max-h-24 max-w-full" %>
<% end %>
<h1 class="text-center text-lg font-bold mb-2"><%= @order.company.receipt_name %></h1>
<p class="text-center text-gray-600 mb-1"><%= @order.order_number %> · <%= @order.created_at.strftime("%d/%m/%Y %I:%M %p") %></p>
<p class="text-center text-gray-600 mb-1"><%= t("order.labels.order_type") %>: <%= @order.fulfillment_summary %></p>
<hr class="mb-4">
<% @order.order_items.each do |item| %>
  <div class="flex justify-between mb-1">
    <span><%= item.quantity %> <%= item.display_name %></span>
    <span><%= format_money(item.line_total_cents) %></span>
  </div>
  <% item.order_item_modifiers.each do |m| %>
    <p class="text-gray-500 pl-4">+ <%= m.name %></p>
  <% end %>
<% end %>
<hr class="my-4">
<div class="flex justify-between"><span><%= t("order.labels.subtotal") %></span><span><%= format_money(@order.subtotal_cents) %></span></div>
<% if @order.discount_cents.positive? %>
  <div class="flex justify-between"><span><%= t("order.labels.discount") %></span><span>-<%= format_money(@order.discount_cents) %></span></div>
<% end %>
<div class="flex justify-between"><span><%= t("order.labels.tax") %></span><span><%= format_money(@order.tax_cents) %></span></div>
<% if @order.tip_cents.positive? %>
  <div class="flex justify-between"><span><%= t("order.labels.tip") %></span><span><%= format_money(@order.tip_cents) %></span></div>
<% end %>
<div class="flex justify-between font-bold text-lg mt-2"><span><%= t("order.labels.total") %></span><span><%= format_money(@order.total_cents) %></span></div>
<% completed_payments = @order.payments.where(status: "completed").order(:created_at) %>
<% if completed_payments.any? %>
  <hr class="my-4">
  <p class="font-medium mb-1"><%= t("printing.receipt.payments") %></p>
  <% completed_payments.each do |payment| %>
    <div class="flex justify-between mb-1">
      <span><%= payment_method_label(payment.payment_method) %></span>
      <span><%= format_money(payment.amount_cents) %></span>
    </div>
  <% end %>
<% end %>
<% if @order.customer %>
  <p class="text-center mt-4 text-gray-600"><%= t("printing.receipt.loyalty", points: @order.customer.loyalty_points) %></p>
<% end %>
