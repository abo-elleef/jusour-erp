{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Rails",
      "runtimeExecutable": "bin/rails",
      "runtimeArgs": [
        "server"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Rails (dev db)",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgres:///saqr_pos_development",
        "bin/rails",
        "server",
        "-p",
        "3002",
        "--pid",
        "tmp/pids/server-dev-db.pid"
      ],
      "port": 3002,
      "autoPort": false
    },
    {
      "name": "Rails (prod copy)",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgres:///saqr_pos_prod_copy",
        "bin/rails",
        "server",
        "-p",
        "3001",
        "--pid",
        "tmp/pids/server-prod-copy.pid"
      ],
      "port": 3001,
      "autoPort": false
    }
  ]
}
